{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "pctl_api_key": {
          "type": "string",
          "description": "PCTL API Key (obtained from UI). Either this and api_secret must be set config_json set",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "pctl_api_secret": {
          "type": "string",
          "description": "PCTL API Secret (obtained from UI). Either this and api_key must be set config_json set",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "pctl_config_json": {
          "type": "string",
          "description": "Config JSON (obtained from UI). Either this must be set or api_key/api_secret set",
          "description_kind": "markdown",
          "optional": true
        },
        "pctl_ops_endpoint": {
          "type": "string",
          "description": "OPS Endpoint",
          "description_kind": "markdown",
          "optional": true
        },
        "pctl_organization": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "pctl_partner": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "pctl_profile": {
          "type": "string",
          "description": "PCTL Profile",
          "description_kind": "markdown",
          "optional": true
        },
        "pctl_rest_endpoint": {
          "type": "string",
          "description": "PCTL Profile",
          "description_kind": "markdown",
          "optional": true
        },
        "pctl_skip_server_cert_valid": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "paralus_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "annotations": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map of annotations to include for cluster",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "bootstrap_files": {
            "type": [
              "list",
              "string"
            ],
            "description": "YAML files used to deploy paralus agent to the cluster stored as a list of files",
            "description_kind": "markdown",
            "computed": true
          },
          "bootstrap_files_combined": {
            "type": "string",
            "description": "YAML files used to deploy paralus agent to the cluster stored as a single massive file",
            "description_kind": "markdown",
            "computed": true
          },
          "cluster_type": {
            "type": "string",
            "description": "Type of cluster being created. For example, \"imported\"",
            "description_kind": "markdown",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Cluster description. Paralus API sets it the same as cluster name",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Cluster ID in the format \"PROJECT_NAME:CLUSTER_NAME\"",
            "description_kind": "markdown",
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map of lables to include for cluster",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Cluster name",
            "description_kind": "markdown",
            "required": true
          },
          "project": {
            "type": "string",
            "description": "Project containing cluster",
            "description_kind": "markdown",
            "required": true
          },
          "relays": {
            "type": "string",
            "description": "Relays information",
            "description_kind": "markdown",
            "computed": true
          },
          "uuid": {
            "type": "string",
            "description": "Cluster UUID",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "params": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "environment_provider": {
                  "type": "string",
                  "description": "Provision Type. For example, \"GCP\"",
                  "description_kind": "markdown",
                  "optional": true
                },
                "kubernetes_provider": {
                  "type": "string",
                  "description": "Provision Type. For example, \"EKS\"",
                  "description_kind": "markdown",
                  "required": true
                },
                "provision_environment": {
                  "type": "string",
                  "description": "Provision Environment. For example, \"CLOUD\"",
                  "description_kind": "markdown",
                  "required": true
                },
                "provision_package_type": {
                  "type": "string",
                  "description": "Provision Type. For example, \"LINUX\"",
                  "description_kind": "markdown",
                  "optional": true
                },
                "provision_type": {
                  "type": "string",
                  "description": "Provision Type. For example, \"IMPORT\"",
                  "description_kind": "markdown",
                  "required": true
                },
                "state": {
                  "type": "string",
                  "description": "Provision Type. For example, \"PROVISION\"",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "Import parameters",
              "description_kind": "markdown"
            }
          }
        },
        "description": "Resource containing paralus cluster information. Uses the [pctl](https://github.com/paralus/cli) library",
        "description_kind": "markdown"
      }
    },
    "paralus_group": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Group description.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Group ID in the format \"GROUP_NAME\"",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Group name",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of group",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "users": {
            "type": [
              "list",
              "string"
            ],
            "description": "User roles attached to group",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "project_roles": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "group": {
                  "type": "string",
                  "description": "Authorized group. This will always be the same as the resource group name.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "namespace": {
                  "type": "string",
                  "description": "Authorized namespace",
                  "description_kind": "markdown",
                  "optional": true
                },
                "project": {
                  "type": "string",
                  "description": "Project name",
                  "description_kind": "markdown",
                  "optional": true
                },
                "role": {
                  "type": "string",
                  "description": "Role name",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "Project namespace roles to attach to the group",
              "description_kind": "markdown"
            }
          }
        },
        "description": "Resource containing paralus group information. Uses the [pctl](https://github.com/paralus/cli) library",
        "description_kind": "markdown"
      }
    },
    "paralus_project": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Project description.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Project ID in the format \"PROJECT_NAME\"",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Project name",
            "description_kind": "markdown",
            "required": true
          },
          "uuid": {
            "type": "string",
            "description": "Project UUID",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "project_roles": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "group": {
                  "type": "string",
                  "description": "Authorized group",
                  "description_kind": "markdown",
                  "required": true
                },
                "namespace": {
                  "type": "string",
                  "description": "Authorized namespace",
                  "description_kind": "markdown",
                  "optional": true
                },
                "project": {
                  "type": "string",
                  "description": "Project name. This will always be the same as the resource project name.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "role": {
                  "type": "string",
                  "description": "Role name",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "Project roles attached to project, containing group or namespace",
              "description_kind": "markdown"
            }
          },
          "user_roles": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "namespace": {
                  "type": "string",
                  "description": "Authorized namespace",
                  "description_kind": "markdown",
                  "optional": true
                },
                "role": {
                  "type": "string",
                  "description": "Authorized role",
                  "description_kind": "markdown",
                  "required": true
                },
                "user": {
                  "type": "string",
                  "description": "Authorized user",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "User roles attached to project",
              "description_kind": "markdown"
            }
          }
        },
        "description": "Resource containing paralus project information. Uses the [pctl](https://github.com/paralus/cli) library",
        "description_kind": "markdown"
      }
    }
  },
