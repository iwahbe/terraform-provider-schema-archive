    "paralus_users": {
      "version": 0,
      "block": {
        "attributes": {
          "limit": {
            "type": "number",
            "description": "Number of users to return. Specify -1 for all (Default: 10)",
            "description_kind": "markdown",
            "optional": true
          },
          "offset": {
            "type": "number",
            "description": "Where to begin the return based on the total number of users (Default: 0)",
            "description_kind": "markdown",
            "optional": true
          },
          "users_info": {
            "nested_type": {
              "attributes": {
                "email": {
                  "type": "string",
                  "description": "User's email",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "first_name": {
                  "type": "string",
                  "description": "User's first name",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "groups": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of groups user belong's to",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "User's ID",
                  "description_kind": "markdown",
                  "computed": true
                },
                "last_name": {
                  "type": "string",
                  "description": "User's last name",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "project_roles": {
                  "nested_type": {
                    "attributes": {
                      "group": {
                        "type": "string",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "namespace": {
                        "type": "string",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "project": {
                        "type": "string",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "role": {
                        "type": "string",
                        "description_kind": "plain",
                        "computed": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "Project roles attached to user, containing group or namespace",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Users information",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "filters": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "allow_more_than_one": {
                  "type": "bool",
                  "description": "Whether to allow more than one record to return when filtering. (Default: false)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "case_sensitive": {
                  "type": "bool",
                  "description": "Whether to make the filter on first_name, last_name, or email address case-sensitive. (Default: false)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "email": {
                  "type": "string",
                  "description": "Filter by the user's email address, as defined under metadata.name",
                  "description_kind": "markdown",
                  "optional": true
                },
                "first_name": {
                  "type": "string",
                  "description": "Filter by the user's first name, as defined under spec.firstName",
                  "description_kind": "markdown",
                  "optional": true
                },
                "group": {
                  "type": "string",
                  "description": "Name of one of the groups to filter against, as defined within the spec.groups list",
                  "description_kind": "markdown",
                  "optional": true
                },
                "last_name": {
                  "type": "string",
                  "description": "Filter by the user's last name, as defined under spec.lastName",
                  "description_kind": "markdown",
                  "optional": true
                },
                "project": {
                  "type": "string",
