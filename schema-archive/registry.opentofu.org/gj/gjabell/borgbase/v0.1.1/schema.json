{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "BorgBase API token",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "borgbase_borg_repo": {
      "version": 0,
      "block": {
        "attributes": {
          "alert_days": {
            "type": "number",
            "description": "Number of days after which an alert should be triggered if no new backups are made.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "append_only": {
            "type": "bool",
            "description": "Whether the repository should allow old data to be deleted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "append_only_keys": {
            "type": [
              "list",
              "string"
            ],
            "description": "IDs of SSH keys which are only allowed to append data to the repository.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "borg_version": {
            "type": "string",
            "description": "Borg version to use for the repository (defaults to latest stable version).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "compaction": {
            "nested_type": {
              "attributes": {
                "enabled": {
                  "type": "bool",
                  "description": "Whether to enable repository compaction.",
                  "description_kind": "markdown",
                  "required": true
                },
                "hour": {
                  "type": "number",
                  "description": "Hour of the day when the repository should be compacted.",
                  "description_kind": "markdown",
                  "required": true
                },
                "hour_timezone": {
                  "type": "string",
                  "description": "Timezone of repository compaction hour.",
                  "description_kind": "markdown",
                  "required": true
                },
                "interval": {
                  "type": "number",
                  "description": "Repository compaction interval value (1-24).",
                  "description_kind": "markdown",
                  "required": true
                },
                "interval_unit": {
                  "type": "string",
                  "description": "Repository compaction interval unit (days, weeks, or months).",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Settings for repository compaction.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "Date when the repository was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "current_usage": {
            "type": "number",
            "description": "Current usage of the repository in megabytes.",
            "description_kind": "markdown",
            "computed": true
          },
          "encryption": {
            "type": "string",
            "description": "Whether the repository is encrypted.",
            "description_kind": "markdown",
            "computed": true
          },
          "format": {
            "type": "string",
            "description": "Format of the repository.",
            "description_kind": "markdown",
            "computed": true
          },
          "full_access_keys": {
            "type": [
              "list",
              "string"
            ],
            "description": "IDs of SSH keys which have full access to the repository.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Internal BorgBase repository identifier.",
            "description_kind": "markdown",
            "computed": true
          },
          "last_modified": {
            "type": "string",
            "description": "Date when the repository was last modified.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "User-defined repository identifier.",
            "description_kind": "markdown",
            "required": true
          },
          "quota": {
            "type": "number",
            "description": "Max allowed size of the repository in megabytes.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "quota_enabled": {
            "type": "bool",
            "description": "Whether the repository quota should be enabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Region where the repository is hosted (eu or us).",
            "description_kind": "markdown",
            "required": true
          },
          "repo_path": {
            "type": "string",
            "description": "SSH path where the repository can be accessed.",
            "description_kind": "markdown",
            "computed": true
          },
          "rsync_keys": {
            "type": [
              "list",
              "string"
            ],
            "description": "IDs of SSH keys which can access the repository via rsync.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "server": {
            "nested_type": {
              "attributes": {
                "fingerprint_ecdsa": {
                  "type": "string",
                  "description": "Fingerprint of the server's ECDSA SSH key.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "fingerprint_ed25519": {
                  "type": "string",
                  "description": "Fingerprint of the server's ED25519 SSH key.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "fingerprint_rsa": {
                  "type": "string",
                  "description": "Fingerprint of the server's RSA SSH key.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "hostname": {
                  "type": "string",
                  "description": "Hostname of the server.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Internal ID of the server.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "location": {
                  "type": "string",
                  "description": "Location of the server.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "public": {
                  "type": "bool",
                  "description": "Whether the server is public.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "region": {
                  "type": "string",
                  "description": "Region in which the server is located.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Information about the server where the repository is hosted.",
            "description_kind": "markdown",
            "computed": true
          },
          "sftp_enabled": {
            "type": "bool",
            "description": "Whether SFTP access to the repository should be enabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "BorgBase borg repository.",
        "description_kind": "markdown"
      }
    },
    "borgbase_ssh_key": {
      "version": 0,
      "block": {
        "attributes": {
          "added_at": {
            "type": "string",
            "description": "Date when the key was added to BorgBase.",
            "description_kind": "markdown",
            "computed": true
          },
          "bits": {
            "type": "number",
            "description": "Number of bits in the key.",
            "description_kind": "markdown",
            "computed": true
          },
          "hash_md5": {
            "type": "string",
            "description": "MD5 hash of the SSH key.",
            "description_kind": "markdown",
            "computed": true
          },
          "hash_sha256": {
            "type": "string",
            "description": "SHA256 hash of the SSH key.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Internal BorgBase key identifier.",
            "description_kind": "markdown",
            "computed": true
          },
          "last_used_at": {
            "type": "string",
            "description": "Date when the key was last used to access BorgBase.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "User-defined key identifier.",
            "description_kind": "markdown",
            "required": true
          },
          "public_key": {
            "type": "string",
            "description": "Public SSH key.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of the SSH key.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Public SSH key for accessing repositories.",
        "description_kind": "markdown"
      }
    }
  },
