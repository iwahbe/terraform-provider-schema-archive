                  "description_kind": "markdown",
                  "required": true
                },
                "description": {
                  "type": "string",
                  "description": "A description of this Access Rule",
                  "description_kind": "markdown",
                  "required": true
                },
                "permissions": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "List of permissions to grant on this Access Rule",
                  "description_kind": "markdown",
                  "required": true
                },
                "priority": {
                  "type": "number",
