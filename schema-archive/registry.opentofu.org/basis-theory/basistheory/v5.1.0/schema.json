          },
          "type": {
            "type": "string",
            "description": "Type for the Application",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "rule": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "container": {
                  "type": "string",
