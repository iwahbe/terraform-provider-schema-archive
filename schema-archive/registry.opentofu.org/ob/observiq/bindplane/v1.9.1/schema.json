{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API used to connect to the Bindplane instance.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The password used for authenticating to the Bindplane instance.",
          "description_kind": "plain",
          "optional": true
        },
        "remote_url": {
          "type": "string",
          "description": "The endpoint used to connect to the Bindplane instance.",
          "description_kind": "plain",
          "optional": true
        },
        "tls_certificate": {
          "type": "string",
          "description": "File path to the x509 PEM client TLS certificate, required when the Bindplane instance is configured for mutual TLS.",
          "description_kind": "plain",
          "optional": true
        },
        "tls_certificate_authority": {
          "type": "string",
          "description": "File path to the x509 PEM certificate authority file used for verifying the Bindplane instance's TLS certificate. Not required if your workstation already trusts the certificate authority through your operating system's trust store.",
          "description_kind": "plain",
          "optional": true
        },
        "tls_private_key": {
          "type": "string",
          "description": "File path to the x509 PEM client private key, required when the Bindplane instance is configured for mutual TLS.",
          "description_kind": "plain",
          "optional": true
        },
        "tls_skip_verify": {
          "type": "bool",
          "description": "Disables TLS certificate verification. Should only be used for testing.",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "The username used for authenticating to the Bindplane instance.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "bindplane_configuration": {
      "version": 0,
      "block": {
        "attributes": {
          "extensions": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of extensions names to attach to the configuration.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Key value pairs which will be added to the configuration as labels.",
            "description_kind": "plain",
            "optional": true
          },
          "match_labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Labels that Bindplane uses to determine which agents the configuration should apply to. This value is computed by Terraform and is not user configurable.",
            "description_kind": "plain",
            "computed": true
          },
          "measurement_interval": {
            "type": "string",
            "description": "The interval at which the agent will push throughput measurements to Bindplane. Valid values include 10s, 1m, and 15m. Relaxing the interval will reduce BindPlane's measurement processing overhead at the expense of granularity. Generally, configurations with thousands of agents can justify using an interval of 1m or 15m.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the configuration.",
            "description_kind": "plain",
            "required": true
          },
          "platform": {
            "type": "string",
            "description": "The platform the configuration is for.",
            "description_kind": "plain",
            "required": true
          },
          "rollout": {
            "type": "bool",
            "description": "Whether or not to trigger a rollout automatically when a configuration is updated. When set to true, Bindplane will automatically roll out the configuration change to managed agents.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "advanced": {
            "nesting_mode": "list",
            "block": {
              "block_types": {
                "metrics": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "level": {
                        "type": "string",
                        "description": "The advanced metrics level for the configuration.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "port": {
                        "type": "number",
                        "description": "The advanced metrics port for the configuration.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "destination": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Name of the destination to attach.",
                  "description_kind": "plain",
                  "required": true
                },
                "processors": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of processor names to attach to the destination.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Destination name and list of processor names to attach to the configuration. This option can be configured one or many times.",
              "description_kind": "plain"
            }
          },
          "rollout_options": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "type": {
                  "type": "string",
                  "description": "The type of rollout to perform. Valid values are 'standard' and 'progressive'.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "parameters": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "Name of the parameter.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "block_types": {
                      "value": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "labels": {
                              "type": [
                                "map",
                                "string"
                              ],
                              "description": "Labels for the parameter.",
                              "description_kind": "plain",
                              "required": true
                            },
                            "name": {
                              "type": "string",
                              "description": "Name of the stage.",
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "description": "Value of the parameter, which is a list of stages.",
                          "description_kind": "plain"
                        },
                        "min_items": 1
                      }
                    },
                    "description": "List of parameters for the rollout options.",
                    "description_kind": "plain"
                  }
                }
              },
              "description": "Options for configuring the rollout behavior of the configuration.",
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "source": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Name of the source to attach.",
                  "description_kind": "plain",
                  "required": true
                },
                "processors": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of processor names to attach to the source.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Source name and list of processor names to attach to the configuration. This option can be configured one or many times.",
              "description_kind": "plain"
            }
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "read": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
