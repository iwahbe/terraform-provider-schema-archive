{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "application_key": {
          "type": "string",
          "description": "Application key for Longship API. May also be provided via LONGSHIP_APPLICATION_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "host": {
          "type": "string",
          "description": "URI for Longship API. May also be provided via LONGSHIP_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "tenant_key": {
          "type": "string",
          "description": "Tenant key for Longship API. May also be provided via LONGSHIP_TENANT_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "longship_webhook": {
      "version": 0,
      "block": {
        "attributes": {
          "created": {
            "type": "string",
            "description": "The timestamp associated with when the webhook was first created.",
            "description_kind": "plain",
            "computed": true
          },
          "enabled": {
            "type": "bool",
            "description": "Should the webhook be enabled? Defaults to `true`.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "event_types": {
            "type": [
              "list",
              "string"
            ],
            "description": "The event types for which to configure this webhook. Possible values are `SESSION_START`, `SESSION_UPDATE`, `SESSION_STOP`, `OPERATIONAL_STATUS`, `CONNECTIVITY_STATUS`, `CHARGEPOINT_BOOTED`, and `CDR_CREATED`",
            "description_kind": "plain",
            "required": true
          },
          "headers": {
            "type": [
              "map",
              "string"
            ],
            "description": "The HTTP headers to be used by the webhook.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name which should be used for this webhook.",
            "description_kind": "plain",
            "required": true
          },
          "ou_code": {
            "type": "string",
            "description": "The Organizational Unit (OU) code associated with this webhook.",
            "description_kind": "plain",
            "required": true
          },
          "updated": {
            "type": "string",
            "description": "The timestamp associated with when the webhook was last updated.",
            "description_kind": "plain",
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "The URL associated with the webhook.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
