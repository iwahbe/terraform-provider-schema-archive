{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "meltwater_recurring_export": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "search_id": {
            "type": "number",
            "description": "The ID of the search",
            "description_kind": "plain",
            "required": true
          },
          "timezone": {
            "type": "string",
            "description": "The timezone for the window to be based on",
            "description_kind": "plain",
            "required": true
          },
          "window_monthday": {
            "type": "number",
            "description": "Representation of what day of the month the export window starts. Integer values 1-28 represent the day of the month e.g. 1 represents 1st, 2 represents the 2nd, etc. Integer value 0 represents the last day of the month. Defaults to 1",
            "description_kind": "plain",
            "optional": true
          },
          "window_size": {
            "type": "number",
            "description": "The number of 'window_time_unit's the export window covers Defaults to 1",
            "description_kind": "plain",
            "optional": true
          },
          "window_time": {
            "type": "string",
            "description": "The time of day the export window begins. Defaults to '00:00:00'",
            "description_kind": "plain",
            "optional": true
          },
          "window_time_unit": {
            "type": "string",
            "description": "A window time unit must be one of: day,week,month",
            "description_kind": "plain",
            "required": true
          },
          "window_weekday": {
            "type": "number",
            "description": "Representation of what day of the week the export window starts. Integer values are: Monday=1, Tuesday=2, Wednesday=3, Thursday=4, Friday=5, Saturday=6, Sunday=7 Defaults to 1",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "meltwater_search": {
      "version": 0,
      "block": {
        "attributes": {
          "category": {
            "type": "string",
            "description": "A search category must be one of: mi,explore",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "A name for the search",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "A search type must be one of: news,social,broadcast",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "query": {
            "nesting_mode": "list",
            "block": {
              "block_types": {
                "boolean": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "boolean": {
                        "type": "string",
                        "description": "A boolean query as a string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "case_sensitivity": {
                        "type": "string",
                        "description": "Set the type of case sensitivity",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "max_items": 1
                },
                "combined": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "all_searches": {
                        "type": [
                          "list",
                          "number"
                        ],
                        "description": "A list of searches that should all match",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "any_searches": {
                        "type": [
                          "list",
                          "number"
                        ],
                        "description": "A list of searches where at least one should match",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "not_searches": {
                        "type": [
                          "list",
                          "number"
                        ],
                        "description": "A list of searches that shouldn't match",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "max_items": 1
                },
                "keyword": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "all_keywords": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "A list of keywords that should all be present",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "any_keywords": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "A list of keywords where at least one is present",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "case_sensitivity": {
                        "type": "string",
                        "description": "Set the type of case sensitivity",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "not_keywords": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "A list of keywords that shouldn't be present",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
