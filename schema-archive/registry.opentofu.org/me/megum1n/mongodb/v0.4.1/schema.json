{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "auth_mechanism": {
          "type": "string",
          "description": "Authentication mechanism (e.g., MONGODB-AWS, SCRAM-SHA-256)",
          "description_kind": "markdown",
          "optional": true
        },
        "auth_source": {
          "type": "string",
          "description": "AuthSource database",
          "description_kind": "markdown",
          "optional": true
        },
        "certificate": {
          "type": "string",
          "description": "Certificate PEM string",
          "description_kind": "markdown",
          "optional": true
        },
        "connection_string": {
          "type": "string",
          "description": "MongoDB connection string",
          "description_kind": "markdown",
          "optional": true
        },
        "direct_connection": {
          "type": "bool",
          "description": "Direct connection to MongoDB",
          "description_kind": "markdown",
          "optional": true
        },
        "hosts": {
          "type": [
            "list",
            "string"
          ],
          "description": "MongoDB hosts",
          "description_kind": "markdown",
          "optional": true
        },
        "insecure_skip_verify": {
          "type": "bool",
          "description": "Insecure TLS",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "replica_set": {
          "type": "string",
          "description": "Replica set name",
          "description_kind": "markdown",
          "optional": true
        },
        "tls": {
          "type": "bool",
          "description": "Enable TLS",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "MongoDB resources management.<br>\n**You must provide either `connection_string` or `hosts` to connect to.**",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "mongodb_index": {
      "version": 0,
      "block": {
        "attributes": {
          "bits": {
            "type": "number",
            "description": "Number of bits for geospatial index precision",
            "description_kind": "plain",
            "optional": true
          },
          "collation": {
            "nested_type": {
              "attributes": {
                "alternate": {
                  "type": "string",
                  "description": "Whether spaces and punctuation are considered base characters",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "backwards": {
                  "type": "bool",
                  "description": "Whether to reverse secondary differences",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "case_first": {
                  "type": "string",
                  "description": "Whether uppercase or lowercase should sort first",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "case_level": {
                  "type": "bool",
                  "description": "Whether to consider case in the 'Level=1' comparison",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "locale": {
                  "type": "string",
                  "description": "The locale for string comparison",
                  "description_kind": "plain",
                  "required": true
                },
                "max_variable": {
                  "type": "string",
                  "description": "Which characters are affected by 'alternate'",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "numeric_ordering": {
                  "type": "bool",
                  "description": "Whether to compare numeric strings as numbers",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "strength": {
                  "type": "number",
                  "description": "Comparison level (1-5)",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Collation settings for string comparison",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "collection": {
            "type": "string",
            "description": "Collection name",
            "description_kind": "plain",
            "required": true
          },
          "database": {
            "type": "string",
            "description": "Database name",
            "description_kind": "plain",
            "required": true
          },
          "default_language": {
            "type": "string",
            "description": "Default language for text index",
            "description_kind": "plain",
            "optional": true
          },
          "expire_after_seconds": {
            "type": "number",
            "description": "TTL in seconds for TTL indexes",
            "description_kind": "plain",
            "optional": true
          },
          "hidden": {
            "type": "bool",
            "description": "Whether the index should be hidden from the query planner",
            "description_kind": "plain",
            "optional": true
          },
          "keys": {
            "type": [
              "map",
              "string"
            ],
            "description": "Index key fields",
            "description_kind": "plain",
            "required": true
          },
          "language_override": {
            "type": "string",
            "description": "Field name that contains document language",
            "description_kind": "plain",
            "optional": true
          },
          "max": {
            "type": "number",
            "description": "Maximum value for 2d index",
            "description_kind": "plain",
            "optional": true
          },
          "min": {
            "type": "number",
            "description": "Minimum value for 2d index",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Index name",
            "description_kind": "plain",
            "required": true
          },
          "partial_filter_expression": {
            "type": "string",
            "description": "JSON encoded filter expression that limits indexed documents.",
            "description_kind": "plain",
            "optional": true
          },
          "sparse": {
            "type": "bool",
            "description": "Whether the index should be sparse",
            "description_kind": "plain",
            "optional": true
          },
          "sphere_index_version": {
            "type": "number",
            "description": "The index version number for a 2dsphere index",
            "description_kind": "plain",
            "optional": true
          },
          "text_index_version": {
            "type": "number",
            "description": "Text index version number",
            "description_kind": "plain",
            "optional": true
          },
          "unique": {
            "type": "bool",
            "description": "Whether the index enforces unique values",
            "description_kind": "plain",
            "optional": true
          },
          "weights": {
            "type": [
              "map",
              "number"
            ],
            "description": "Field weights for text index",
            "description_kind": "plain",
            "optional": true
          },
          "wildcard_projection": {
            "type": [
              "map",
              "number"
            ],
            "description": "Field inclusion/exclusion for wildcard index (1=include, 0=exclude)",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages MongoDB indexes",
        "description_kind": "plain"
      }
    },
    "mongodb_role": {
      "version": 0,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description": "Target database name. \"admin\" is used by default",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the new role",
            "description_kind": "markdown",
            "required": true
          },
          "privileges": {
            "nested_type": {
              "attributes": {
                "actions": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "An array of actions permitted on the resource",
                  "description_kind": "markdown",
                  "required": true
                },
                "resource": {
                  "type": [
                    "object",
                    {
                      "collection": "string",
                      "db": "string"
                    }
                  ],
                  "description": "A document that specifies the resources upon which the privilege actions apply",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "Set of the privileges to grant the role",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "roles": {
            "nested_type": {
              "attributes": {
                "db": {
                  "type": "string",
                  "description": "Target database name. \"admin\" is used by default",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "role": {
                  "type": "string",
                  "description": "Role name",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "Set of roles from which this role inherits privileges",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "MongoDB Role resource",
        "description_kind": "markdown"
      }
    },
    "mongodb_user": {
      "version": 0,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description": "Auth database name (auth source). \"admin\" is used by default",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "mechanisms": {
            "type": [
              "set",
              "string"
            ],
            "description": "Specify the specific SCRAM mechanism or mechanisms for creating SCRAM user credentials.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "The user's password. Must be empty for \"$external\" database",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "roles": {
            "nested_type": {
              "attributes": {
                "db": {
                  "type": "string",
                  "description": "Target database name. \"admin\" is used by default",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "role": {
                  "type": "string",
                  "description": "Role name",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "The roles granted to the user",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "The name of the new user",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "MongoDB User resource",
        "description_kind": "markdown"
      }
    }
  }
}
