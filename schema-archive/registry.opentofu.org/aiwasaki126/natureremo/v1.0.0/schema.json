{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_token": {
          "type": "string",
          "description": "Access token for Nature Remo. May also be provided via NATURE_REMO_ACCESS_TOKEN environment variable.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "description": "Management of Nature Remo settings including device, user profile, home and more through Nature Remo Cloud API.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "natureremo_device": {
      "version": 0,
      "block": {
        "attributes": {
          "bt_mac_address": {
            "type": "string",
            "description": "Bluetooth MAC address for the device.",
            "description_kind": "plain",
            "computed": true
          },
          "firmware_version": {
            "type": "string",
            "description": "Firmware version for the device.",
            "description_kind": "plain",
            "computed": true
          },
          "humidity_offset": {
            "type": "number",
            "description": "Humidity offset value. This value ranges from -20 to 20 in 1 increments in unit of %.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Device identifier attribute.",
            "description_kind": "plain",
            "computed": true
          },
          "mac_address": {
            "type": "string",
            "description": "MAC address for the device.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Device name.",
            "description_kind": "plain",
            "required": true
          },
          "serial_number": {
            "type": "string",
            "description": "Serial number for the device.",
            "description_kind": "plain",
            "computed": true
          },
          "temperature_offset": {
            "type": "number",
            "description": "Temperature offset value. This value ranges from -5 to 5 in 0.5 increments in unit of Celsius.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Device manages the Nature Remo device settings.",
        "description_kind": "plain"
      }
    },
    "natureremo_user": {
      "version": 0,
      "block": {
        "attributes": {
          "country": {
            "type": "string",
            "description": "Country. Country must be one of the following: `JP`, `US`, `CA`, `SG`, `AU`, `NZ`, `OTHERS`.",
            "description_kind": "markdown",
            "optional": true
          },
          "distance_unit": {
            "type": "string",
            "description": "Distance unit. Distance unit must be one of the following: `metric`, `imperial`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of user.",
            "description_kind": "plain",
            "computed": true
          },
          "nickname": {
            "type": "string",
            "description": "Nickname of user. This value must not be empty.",
            "description_kind": "plain",
            "required": true
          },
          "temp_unit": {
            "type": "string",
            "description": "Temperature unit. Temperature unit must be one of the following: `c`, `f`.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "User manages the user profile, mainly preference.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "natureremo_devices": {
      "version": 0,
      "block": {
        "attributes": {
          "devices": {
            "nested_type": {
              "attributes": {
                "bt_mac_address": {
                  "type": "string",
                  "description": "Bluetooth MAC address for the device.",
                  "description_kind": "plain",
                  "computed": true
                },
                "firmware_version": {
                  "type": "string",
                  "description": "Firmware version for the device.",
                  "description_kind": "plain",
                  "computed": true
                },
                "humidity_offset": {
                  "type": "number",
                  "description": "Humidity offset value.",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Device identifier attribute.",
                  "description_kind": "plain",
                  "computed": true
                },
                "mac_address": {
                  "type": "string",
                  "description": "MAC address for the device.",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Device name.",
                  "description_kind": "plain",
                  "computed": true
                },
                "serial_number": {
                  "type": "string",
                  "description": "Serial number for the device.",
                  "description_kind": "plain",
                  "computed": true
                },
                "temperature_offset": {
                  "type": "number",
                  "description": "Temperature offset value.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetch the list of Nature Remo devices.",
        "description_kind": "plain"
      }
    },
    "natureremo_user": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Identifier of user.",
            "description_kind": "plain",
            "computed": true
          },
          "nickname": {
            "type": "string",
            "description": "Nickname of user.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetch the Nature Remo user profile.",
        "description_kind": "plain"
      }
    }
  }
}
