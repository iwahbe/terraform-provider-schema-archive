{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key": {
          "type": "string",
          "description": "RGW Access Key. Should be set via env 'TF_PROVIDER_RGW_ACCESS_KEY'",
          "description_kind": "markdown",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "RGW Endpoint URL. Can be set via env 'TF_PROVIDER_RGW_ENDPOINT'",
          "description_kind": "markdown",
          "required": true
        },
        "secret_key": {
          "type": "string",
          "description": "RGW Secret Key. Should be set via env 'TF_PROVIDER_RGW_SECRET_KEY'",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "rgw_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Example identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Bucket Name",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Bucket in Ceph RGW",
        "description_kind": "markdown"
      }
    },
    "rgw_bucket_link": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "The bucket name to link with a user",
            "description_kind": "markdown",
            "required": true
          },
          "uid": {
            "type": "string",
            "description": "The user ID to be linked with a bucket",
            "description_kind": "markdown",
            "required": true
          },
          "unlink_to_uid": {
            "type": "string",
            "description": "The UID of a user to link bucket to when resource is destroyed",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Ceph RGW Bucket Link. This resource allow to change bucket ownership in Ceph. It supports reverting ownership upon resource destruction",
        "description_kind": "markdown"
      }
    },
    "rgw_bucket_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "Bucket Name",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "policy": {
            "type": "string",
            "description": "Bucket Policy",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Bucket Policy in Ceph RGW",
        "description_kind": "markdown"
      }
    },
    "rgw_bucket_quota": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "The name of the bucket set the quota for.",
            "description_kind": "markdown",
            "required": true
          },
          "check_on_raw": {
            "type": "bool",
            "description": "???",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "enabled": {
            "type": "bool",
            "description": "Enable or disable the quota",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "max_objects": {
            "type": "number",
            "description": "The maximum number of objects in the quota",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "max_size": {
            "type": "number",
            "description": "The maximum size of the quota",
            "description_kind": "markdown",
            "computed": true
          },
          "max_size_kb": {
            "type": "number",
            "description": "The maximum size of the quota in kilobytes",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "uid": {
            "type": "string",
            "description": "The UID of the user to set the quota for.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "This resource can be used to set individual quota for bucket. Refer to the Ceph RGW Admin Ops API documentation for values documentation. Upon deletion, quota is disabled.",
        "description_kind": "markdown"
      }
    },
    "rgw_quota": {
      "version": 0,
      "block": {
        "attributes": {
          "check_on_raw": {
            "type": "bool",
            "description": "???",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "enabled": {
            "type": "bool",
            "description": "Enable or disable the quota",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "max_objects": {
            "type": "number",
            "description": "The maximum number of objects in the quota",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "max_size": {
            "type": "number",
            "description": "The maximum size of the quota",
            "description_kind": "markdown",
            "computed": true
          },
          "max_size_kb": {
            "type": "number",
            "description": "The maximum size of the quota in kilobytes",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Quota type - can be either `user` or `bucket` (for buckets owned by user).",
            "description_kind": "markdown",
            "required": true
          },
          "uid": {
            "type": "string",
            "description": "The UID of the user to set the quota for.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "This resource can be used to set the quota for a rgw user. Refer to the Ceph RGW Admin Ops API documentation for values documentation. Upon deletion, quota is disabled.",
        "description_kind": "markdown"
      }
    },
    "rgw_user": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key": {
            "type": "string",
            "description": "The generated access key",
            "description_kind": "markdown",
            "computed": true
          },
          "caps": {
            "nested_type": {
              "attributes": {
                "perm": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description_kind": "plain",
            "optional": true
          },
          "display_name": {
            "type": "string",
            "description": "Display Name of user",
            "description_kind": "markdown",
            "required": true
          },
          "email": {
            "type": "string",
            "description": "The email address associated with the user.",
            "description_kind": "markdown",
            "optional": true
          },
          "exclusive_s3_credentials": {
            "type": "bool",
            "description": "Specify how to deal with s3 credentials for this user not managed by this resource. Set to `true` to delete all other s3 credentials. Set to `false` to ignore other credentials.",
            "description_kind": "markdown",
            "optional": true
          },
          "generate_s3_credentials": {
            "type": "bool",
            "description": "Specify whether to generate S3 Credentials for the user. Set to false to generate swift keys via rgw_subuser.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "max_buckets": {
            "type": "number",
            "description": "Specify the maximum number of buckets the user can own.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "op_mask": {
            "type": "string",
            "description": "The op-mask of the user",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "principal": {
            "type": "string",
            "description": "Computed principal to be used in policies",
            "description_kind": "markdown",
            "computed": true
          },
          "purge_data_on_delete": {
            "type": "bool",
            "description": "Purge user data on deletion",
            "description_kind": "markdown",
            "optional": true
          },
          "secret_key": {
            "type": "string",
            "description": "The generated secret key",
            "description_kind": "markdown",
            "computed": true
          },
          "suspended": {
            "type": "bool",
            "description": "Specify whether the user should be suspended.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "tenant": {
            "type": "string",
            "description": "The tenant under which a user is a part of.",
            "description_kind": "markdown",
            "optional": true
          },
          "username": {
            "type": "string",
            "description": "The user ID to be created (without tenant).",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Ceph RGW User",
        "description_kind": "markdown"
      }
    }
  }
}
