          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "is_enabled": {
            "type": "bool",
            "description": "Whether to enable to disable this alias.",
            "description_kind": "plain",
            "optional": true
          },
          "labels": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of labels.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Alias name.",
            "description_kind": "plain",
            "required": true
          },
          "recipients": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of recipients as valid email addresses, fully-qualified domain names (FQDN), IP addresses, or webhook URL's.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "forwardemail_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "has_adult_content_protection": {
            "type": "bool",
            "description": "Whether to enable Spam Scanner adult content protection on this domain.",
            "description_kind": "plain",
            "optional": true
          },
          "has_executable_protection": {
            "type": "bool",
            "description": "Whether to enable Spam Scanner executable protection on this domain.",
            "description_kind": "plain",
            "optional": true
          },
          "has_phishing_protection": {
            "type": "bool",
            "description": "Whether to enable Spam Scanner phishing protection on this domain.",
            "description_kind": "plain",
            "optional": true
          },
          "has_recipient_verification": {
            "type": "bool",
            "description": "Global domain default for whether to require alias recipients to click an email verification link for emails to flow through.",
            "description_kind": "plain",
            "optional": true
          },
          "has_virus_protection": {
            "type": "bool",
            "description": "Whether to enable Spam Scanner virus protection on this domain.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Fully qualified domain name (FQDN) or IP address.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
