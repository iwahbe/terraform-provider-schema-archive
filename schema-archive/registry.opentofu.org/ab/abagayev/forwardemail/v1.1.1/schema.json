{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API key for API operations.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "forwardemail_alias": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Fully qualified domain name (FQDN).",
            "description_kind": "plain",
            "required": true
          },
          "has_recipient_verification": {
            "type": "bool",
            "description": "Whether to enable to require recipients to click an email verification link for emails to flow through.",
            "description_kind": "plain",
