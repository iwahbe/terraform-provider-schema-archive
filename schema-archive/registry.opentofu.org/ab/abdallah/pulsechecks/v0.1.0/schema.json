{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "Bearer token for API authentication. Can also be set via PULSECHECKS_API_TOKEN env var.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "api_url": {
          "type": "string",
          "description": "PulseChecks API base URL. Defaults to the production URL.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "pulsechecks_check": {
      "version": 0,
      "block": {
        "attributes": {
          "check_id": {
            "type": "string",
            "description": "Check identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "check_type": {
            "type": "string",
            "description": "Check type: `heartbeat`, `cron`, or `http`",
            "description_kind": "markdown",
            "required": true
          },
          "created_at": {
            "type": "string",
            "description": "Creation timestamp",
            "description_kind": "markdown",
            "computed": true
          },
          "expected_status_code": {
            "type": "number",
            "description": "Expected HTTP status code (default 200).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "expected_string": {
            "type": "string",
            "description": "Expected string in response body.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "failure_threshold": {
            "type": "number",
            "description": "Alert after N consecutive failures (default 1).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "grace_seconds": {
            "type": "number",
            "description": "Grace period in seconds before alerting",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Check name",
            "description_kind": "markdown",
            "required": true
          },
          "period_seconds": {
            "type": "number",
            "description": "Check period in seconds. Required for `heartbeat` and `http` types.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "schedule": {
            "type": "string",
            "description": "Cron expression (e.g. `0 2 * * *`). Required for `cron` type.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Check status",
            "description_kind": "markdown",
            "computed": true
          },
          "team_id": {
            "type": "string",
            "description": "Team identifier",
            "description_kind": "markdown",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "Check ping token",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "url": {
            "type": "string",
            "description": "Target URL for http checks.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Pulsechecks check resource. Use `check_type` to select the monitoring mode:\n- `heartbeat` \u2014 your service pings PulseChecks every `period_seconds`\n- `cron` \u2014 your cron job pings PulseChecks; next due time is derived from `schedule`\n- `http` \u2014 PulseChecks actively fetches a URL every `period_seconds`",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "pulsechecks_check": {
      "version": 0,
      "block": {
        "attributes": {
          "check_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "check_type": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "grace_seconds": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "period_seconds": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "schedule": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "team_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "token": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Fetches a PulseChecks check by ID.",
        "description_kind": "plain"
      }
    }
  }
}
