  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_version": {
          "type": "string",
          "description": "The API Version of the TeamCity server to connect to. If not set, the default\nprovided by the sdk `latest` will be used.",
          "description_kind": "plain",
          "optional": true
        },
        "insecure": {
          "type": "bool",
          "description": "Explicitly allow the provider to perform \"insecure\" SSL requests. If omitted,default value is `false`",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password of the TeamCity user. The password for the user \nspecified in the user option.",
          "description_kind": "plain",
          "optional": true
        },
        "skip_credentials_validation": {
          "type": "bool",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "URL of the TeamCity server to connect to. If not set, the default profile\ncreated with `aws configure` will be used.",
          "description_kind": "plain",
          "optional": true
        },
        "user": {
          "type": "string",
          "description": "The username used for API operations. This must be \nan admin user created on the TeamCity Server.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
