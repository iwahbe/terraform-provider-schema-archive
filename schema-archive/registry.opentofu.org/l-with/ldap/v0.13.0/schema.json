{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "bind_password": {
          "type": "string",
          "description": "LDAP password, can optionally be passed as `LDAP_BIND_PASSWORD`environment variable",
          "description_kind": "plain",
          "required": true
        },
        "bind_user": {
          "type": "string",
          "description": "LDAP username, can optionally be passed as `LDAP_BIND_USER`environment variable",
          "description_kind": "plain",
          "required": true
        },
        "entry_attribute_names_case_sensitive": {
          "type": "bool",
          "description": "if the entry attribute names should be handeled case sensitive (for state handling in resource ldap_entry)",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "LDAP host, can optionally be passed as `LDAP_HOST`environment variable",
          "description_kind": "plain",
          "required": true
        },
        "port": {
          "type": "number",
          "description": "LDAP port, can optionally be passed as `LDAP_PORT`environment variable",
          "description_kind": "plain",
          "required": true
        },
        "tls": {
          "type": "bool",
          "description": "Enable the TLS encryption for LDAP (LDAPS). Default, is `false`.",
          "description_kind": "plain",
          "optional": true
        },
        "tls_insecure": {
          "type": "bool",
          "description": "Don't verify the server TLS certificate. Default is `false`.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ldap_entry": {
      "version": 0,
      "block": {
        "attributes": {
          "base64encode_attribute_patterns": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attribute patterns for base64 encoded attributes",
            "description_kind": "plain",
            "optional": true
          },
          "base64encode_attributes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of base64 encoded attributes",
            "description_kind": "plain",
            "optional": true
          },
          "case_sensitive_attribute_names": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attributes with case-sensitive names",
            "description_kind": "plain",
            "optional": true
          },
          "data_json": {
            "type": "string",
            "description": "JSON-encoded string with the values of the attributes of the entry (s. https://pkg.go.dev/github.com/go-ldap/ldap/v3#EntryAttribute)",
            "description_kind": "plain",
            "required": true
          },
          "data_json_create_defaults": {
            "type": "string",
            "description": "JSON-encoded attribute values (same shape as data_json: attribute name -> list of values) injected on Create if the attribute is absent from data_json. Keys are also treated as ignore_attributes on Read and Update, so the attribute is never surfaced to state nor modified after initial creation. Intended for fields owned by an external system (e.g. a userPassword reset by Keycloak after the entry is created).",
            "description_kind": "plain",
            "optional": true
          },
          "dn": {
            "type": "string",
            "description": "DN of the LDAP entry",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ignore_attribute_patterns": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attribute patterns to ignore",
            "description_kind": "plain",
            "optional": true
          },
          "ignore_attributes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attributes to ignore",
            "description_kind": "plain",
            "optional": true
          },
          "restrict_attributes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attributes to which operating is restricted. Defaults to '*', which means 'all user attributes'. It can also contain operational attributes.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "ldap_entries": {
      "version": 0,
      "block": {
        "attributes": {
          "base64encode_attribute_patterns": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attribute patterns to be encoded to base64",
            "description_kind": "plain",
            "optional": true
          },
          "base64encode_attributes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attributes to be encoded to base64",
            "description_kind": "plain",
            "optional": true
          },
          "entries": {
            "type": [
              "list",
              [
                "object",
                {
                  "data_json": "string",
                  "dn": "string"
                }
              ]
            ],
            "description": "list of entries",
            "description_kind": "plain",
            "computed": true
          },
          "filter": {
            "type": "string",
            "description": "filter for selecting the LDAP entry",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ignore_attribute_patterns": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attribute patterns to ignore",
            "description_kind": "plain",
            "optional": true
          },
          "ignore_attributes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attributes to ignore",
            "description_kind": "plain",
            "optional": true
          },
          "ou": {
            "type": "string",
            "description": "OU where LDAP entry will be searched",
            "description_kind": "plain",
            "required": true
          },
          "paging_size": {
            "type": "number",
            "description": "Desired page size for the search request. Use 0 to retrieve all results without pagination, or a value greater than 0 to enable paginated queries. Defaults to 0.",
            "description_kind": "plain",
            "optional": true
          },
          "restrict_attributes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attributes to which reading from the LDAP server is restricted",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "ldap_entry": {
      "version": 0,
      "block": {
        "attributes": {
          "base64encode_attribute_patterns": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attribute patterns to be encoded to base64",
            "description_kind": "plain",
            "optional": true
          },
          "base64encode_attributes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attributes to be encoded to base64",
            "description_kind": "plain",
            "optional": true
          },
          "data_json": {
            "type": "string",
            "description": "JSON-encoded string that is read as the values of the attributes of the entry (s. https://pkg.go.dev/github.com/go-ldap/ldap/v3#EntryAttribute)",
            "description_kind": "plain",
            "computed": true
          },
          "dn": {
            "type": "string",
            "description": "DN of the LDAP entry",
            "description_kind": "plain",
            "optional": true
          },
          "filter": {
            "type": "string",
            "description": "filter for selecting the LDAP entry, ignored if 'dn' is used",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ignore_attribute_patterns": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attribute patterns to ignore",
            "description_kind": "plain",
            "optional": true
          },
          "ignore_attributes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attributes to ignore",
            "description_kind": "plain",
            "optional": true
          },
          "ou": {
            "type": "string",
            "description": "OU where LDAP entry will be searched",
            "description_kind": "plain",
            "optional": true
          },
          "restrict_attributes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of attributes to which reading is restricted",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
