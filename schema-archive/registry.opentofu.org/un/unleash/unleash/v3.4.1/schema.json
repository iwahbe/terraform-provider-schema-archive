    "unleash_group": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "A description of the group's purpose.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Group ID to look up. If name is also provided, it must match the returned group name.",
            "description_kind": "plain",
