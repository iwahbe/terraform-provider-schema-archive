    "securecn_k8s_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "api_intelligence_dast": {
            "type": "bool",
            "description": "Enable API Intelligence DAST integration",
            "description_kind": "plain",
            "optional": true
          },
          "auto_labeling": {
            "type": "bool",
            "description": "Enable auto labeling of Kubernetes namespaces",
            "description_kind": "plain",
            "optional": true
          },
          "auto_upgrade_controller_version": {
            "type": "bool",
            "description": "indicates whether upgrade the controller automatically",
            "description_kind": "plain",
            "optional": true
          },
          "cd_pod_template": {
            "type": "bool",
            "description": "Identify pod templates only originating from SecureCN CD plugin",
            "description_kind": "plain",
            "optional": true
          },
          "ci_image_signer_validation_enabled": {
            "type": "bool",
            "description": "indicates whether ci image signer validation is Enabled",
            "description_kind": "plain",
            "optional": true
          },
          "ci_image_validation": {
            "type": "bool",
            "description": "Identify pods only if the image hash matches the value generated by the CI plugin or entered manually in the UI",
            "description_kind": "plain",
            "optional": true
          },
          "connections_control": {
            "type": "bool",
            "description": "Enable connections control",
            "description_kind": "plain",
            "optional": true
          },
          "disable_ssh_probing": {
            "type": "bool",
            "description": "indicates whether SSH monitoring is disabled",
            "description_kind": "plain",
            "optional": true
          },
          "enable_external_ca": {
            "type": "bool",
            "description": "Indicates whether to use external CA for this cluster",
            "description_kind": "plain",
            "optional": true
          },
          "enable_k8s_events": {
            "type": "bool",
            "description": "indicates whether kubernetes events sending is enabled",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "external_https_proxy": {
            "type": "string",
            "description": "Proxy definitions for outgoing HTTPS traffic from the cluster, if needed",
            "description_kind": "plain",
            "optional": true
          },
          "fail_close": {
            "type": "bool",
            "description": "When enabled, workloads and connections will be blocked in case SecureCN agent is not responding",
            "description_kind": "plain",
            "optional": true
          },
          "force_remove_vault_on_delete": {
            "type": "bool",
            "description": "delete the vault namespace (that was created for token injection) on delete. default = false",
            "description_kind": "plain",
            "optional": true
          },
          "hold_application_until_proxy_starts": {
            "type": "bool",
            "description": "Indicates whether the controller should hold the application until the proxy starts",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "inspect_incoming_cluster_connections": {
            "type": "bool",
            "description": "Enable enforcement and visibility of connections from external IP sources",
            "description_kind": "plain",
            "optional": true
          },
          "install_envoy_tracing_support": {
            "type": "bool",
            "description": "Indicates whether to install Envoy tracing support, available when install tracing support is true",
            "description_kind": "plain",
            "optional": true
          },
          "install_tracing_support": {
            "type": "bool",
            "description": "Indicates whether to install tracing support, enable for apiSecurity accounts",
            "description_kind": "plain",
            "optional": true
          },
          "istio_already_installed": {
            "type": "bool",
            "description": "if false, istio will be installed, otherwise the controller will use the previously installed istio",
            "description_kind": "plain",
            "optional": true
          },
          "istio_ingress_annotations": {
            "type": [
              "map",
              "string"
            ],
            "description": "when enabling Istio ingress, use these Istio ingress annotations",
            "description_kind": "plain",
            "optional": true
          },
          "istio_ingress_enabled": {
            "type": "bool",
            "description": "If installing Istio, use Istio ingress",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "istio_version": {
            "type": "string",
            "description": "if istio already installed, this specifies its version",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "kubernetes_cluster_context": {
            "type": "string",
            "description": "The k8s context name of the cluster",
            "description_kind": "plain",
            "required": true
          },
          "kubernetes_security": {
            "type": "bool",
            "description": "Enable kubernetes security",
            "description_kind": "plain",
            "optional": true
          },
          "minimum_replicas": {
            "type": "number",
            "description": "minimum number of controller replicas",
            "description_kind": "plain",
            "optional": true
          },
          "multi_cluster_communication_support": {
            "type": "bool",
            "description": "Enable multi cluster communication",
            "description_kind": "plain",
            "optional": true
          },
          "multi_cluster_communication_support_certs_path": {
            "type": "string",
            "description": "Multi cluster certs path. Only valid if multi_cluster_communication_support is true",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of cluster in SecureCN",
            "description_kind": "plain",
            "required": true
          },
          "orchestration_type": {
            "type": "string",
            "description": "Orchestration type of the kubernetes cluster optional values: GKE, OPENSHIFT, RANCHER, AKS, EKS, KUBERNETES, IKS.",
            "description_kind": "plain",
            "optional": true
          },
          "persistent_storage": {
            "type": "bool",
