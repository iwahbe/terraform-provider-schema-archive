                    "map",
                    "string"
                  ],
                  "description_kind": "plain",
                  "required": true
                },
                "vulnerability_severity_level": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "The destination will match using pod labels",
