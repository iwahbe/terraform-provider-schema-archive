{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "apikey": {
          "type": "string",
          "description": "ApiKey for use with InsightCloudSec API calls",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "url": {
          "type": "string",
          "description": "An instance of InsightCloudSec to point at",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "insightcloudsec_cloud": {
      "version": 0,
      "block": {
        "attributes": {
          "account": {
            "type": "string",
            "description": "The account number associated with the cloud for AWS cloud types",
            "description_kind": "plain",
            "optional": true
          },
          "api_key": {
            "type": "string",
            "description": "The api key to utilize in accessing information for the cloud",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "app_id": {
            "type": "string",
            "description": "The application id assigned to the cloud for AZURE_ARM cloud types",
            "description_kind": "plain",
            "optional": true
          },
          "authentication_type": {
            "type": "string",
            "description": "The authentication type for use with AWS cloud types.  Supportred Options: assume_role or instance_assume_role",
            "description_kind": "plain",
            "optional": true
          },
          "cloud_type": {
            "type": "string",
            "description": "The type of cloud being provisioned.  Supported Options: AWS, AZURE_ARM, GCE",
            "description_kind": "plain",
            "required": true
          },
          "creation_time": {
            "type": "string",
            "description": "The time of creation for the cloud",
            "description_kind": "plain",
            "computed": true
          },
          "duration": {
            "type": "number",
            "description": "The duration associated with the authentication for AWS cloud types",
            "description_kind": "plain",
            "optional": true
          },
          "external_id": {
            "type": "string",
            "description": "An optional unique identifier to include as part of the assume role handshake for AWS cloud types",
            "description_kind": "plain",
            "optional": true
          },
          "group_resource_id": {
            "type": "string",
            "description": "The group resource ID for the cloud",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "The last time the cloud was updated via terraform",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the cloud for display in InsightCloudSec",
            "description_kind": "plain",
            "required": true
          },
          "org_resource_id": {
            "type": "string",
            "description": "The organization ID for the cloud",
            "description_kind": "plain",
            "computed": true
          },
          "project": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "resource_id": {
            "type": "string",
            "description": "The resource_id provided by the console for the cloud",
            "description_kind": "plain",
            "computed": true
          },
          "role_arn": {
            "type": "string",
            "description": "The ARN of the role to assume for AWS cloud types",
            "description_kind": "plain",
            "optional": true
          },
          "secret_key": {
            "type": "string",
            "description": "The secret key used in accessing the AWS cloud type when authenticating via instance_assume_role",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "session_name": {
            "type": "string",
            "description": "A name to give the session for accessing AWS cloud types.  This name will be used when logging with CloudTrail",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "The status of the cloud",
            "description_kind": "plain",
            "computed": true
          },
          "strategy_id": {
            "type": "number",
            "description": "The harvesting strategy ID for the cloud",
            "description_kind": "plain",
            "computed": true
          },
          "subscription_id": {
            "type": "string",
            "description": "The subscription id assigned to the cloud for AZURE_ARM cloud types",
            "description_kind": "plain",
            "optional": true
          },
          "tenant_id": {
            "type": "string",
            "description": "The tenant id for the cloud for AZURE_ARM cloud types",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "api_credentials": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "auth_provider_x509_cert_url": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "auth_uri": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "client_email": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "client_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "client_x509_cert_url": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "private_key": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "private_key_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "project_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "token_uri": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "insightcloudsec_custom_insight": {
      "version": 0,
      "block": {
        "attributes": {
          "badge_filter_operator": {
            "type": "string",
            "description": "The badge filter operator for the insight",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description to assign to the insight",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The ID assigned to the insight.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the insight for display in InsightCloudSec",
            "description_kind": "plain",
            "required": true
          },
          "resource_types": {
            "type": [
              "list",
              "string"
            ],
            "description": "Resource types the insight applies to",
            "description_kind": "plain",
            "required": true
          },
          "scopes": {
            "type": [
              "list",
              "string"
            ],
            "description": "The scope for the insight",
            "description_kind": "plain",
            "optional": true
          },
          "severity": {
            "type": "number",
            "description": "The severity associated with the insight represented by an int",
            "description_kind": "plain",
            "required": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "Tags to associate with the insight",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "badge": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "Key for the badge",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "Value for the badge",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Badges used to limit the insight",
              "description_kind": "plain"
            }
          },
          "filter": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "collections": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "The collections associated with the filter",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "config": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "The configuration of the filter",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the filter",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Filter used with the insight to determine resources",
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "insightcloudsec_user": {
      "version": 0,
      "block": {
        "attributes": {
          "access_level": {
            "type": "string",
            "description": "The access level to associate with the user",
            "description_kind": "plain",
            "required": true
          },
          "console_access_denied": {
            "type": "bool",
            "description": "Boolean representing if a user's console access is currently denied",
            "description_kind": "plain",
            "optional": true
          },
          "email_address": {
            "type": "string",
            "description": "The email for the user",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the user",
            "description_kind": "plain",
            "required": true
          },
          "organization_id": {
            "type": "number",
            "description": "The organization id to which the user belongs",
            "description_kind": "plain",
            "computed": true
          },
          "organization_name": {
            "type": "string",
            "description": "The organization name to which the user belongs",
            "description_kind": "plain",
            "computed": true
          },
          "temp_pw_expiration": {
            "type": "string",
            "description": "Time and date of temporary password expiration",
            "description_kind": "plain",
            "computed": true
          },
          "temporary_pw": {
            "type": "string",
            "description": "Temporary password returned for resets or intial creation",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "username": {
            "type": "string",
            "description": "The username for the user",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "insightcloudsec_cloud": {
      "version": 0,
      "block": {
        "attributes": {
          "account_id": {
            "type": "string",
            "description": "The identifier for the account associated with the cloud.  In the case of AWS, this is the account ID.  In Azure, this is the subscription ID",
            "description_kind": "plain",
            "computed": true
          },
          "cloud_organization_id": {
            "type": "string",
            "description": "The organization ID for the cloud",
            "description_kind": "plain",
            "computed": true
          },
          "cloud_type": {
            "type": "string",
            "description": "The identifier for the type of cloud utilized.  Examples:  AWS, AZURE_ARM, etc.",
            "description_kind": "plain",
            "computed": true
          },
          "group_resource_id": {
            "type": "string",
            "description": "The group resource ID for the cloud",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "The ID associated the the data source for this cloud",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the cloud to retrieve",
            "description_kind": "plain",
            "required": true
          },
          "resource_id": {
            "type": "string",
            "description": "The resource ID provided by the console for the cloud",
            "description_kind": "plain",
            "computed": true
          },
          "strategy_id": {
            "type": "number",
            "description": "The harvesting strategy ID for the cloud",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "insightcloudsec_cloud_types": {
      "version": 0,
      "block": {
        "attributes": {
          "clouds": {
            "type": [
              "list",
              [
                "object",
                {
                  "cloud_access": "string",
                  "cloud_type": "string",
                  "name": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "insightcloudsec_users": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "total_count": {
            "type": "number",
            "description": "The total count of users returned",
            "description_kind": "plain",
            "computed": true
          },
          "users": {
            "type": [
              "list",
              [
                "object",
                {
                  "active_api_key_present": "bool",
                  "consecutive_failed_login_attempts": "number",
                  "console_access_denied": "bool",
                  "create_date": "string",
                  "domain_admin": "bool",
                  "domain_viewer": "bool",
                  "email_address": "string",
                  "groups": "number",
                  "last_login_time": "string",
                  "name": "string",
                  "navigation_blacklist": [
                    "list",
                    "string"
                  ],
                  "organization_admin": "bool",
                  "organization_id": "number",
                  "organization_name": "string",
                  "owned_resources": "number",
                  "require_pw_reset": "bool",
                  "resource_id": "string",
                  "suspended": "bool",
                  "two_factor_enabled": "bool",
                  "two_factor_required": "bool",
                  "user_id": "number",
                  "username": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
