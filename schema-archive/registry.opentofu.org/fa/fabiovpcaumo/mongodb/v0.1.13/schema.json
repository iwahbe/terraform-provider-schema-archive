{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "auth_database": {
          "type": "string",
          "description": "The mongodb auth database",
          "description_kind": "plain",
          "optional": true
        },
        "certificate": {
          "type": "string",
          "description": "PEM-encoded content of Mongodb host CA certificate",
          "description_kind": "plain",
          "optional": true
        },
        "connect_timeout": {
          "type": "number",
          "description": "Specifies the time in milliseconds to attempt a connection before timing out.",
          "description_kind": "plain",
          "optional": true
        },
        "direct": {
          "type": "bool",
          "description": "enforces a direct connection instead of discovery",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "The mongodb server address",
          "description_kind": "plain",
          "optional": true
        },
        "insecure_skip_verify": {
          "type": "bool",
          "description": "ignore hostname verification",
          "description_kind": "plain",
          "optional": true
        },
        "max_connecting": {
          "type": "number",
          "description": "Specifies the maximum number of connections that can be in the process of being established concurrently. The default is 2.",
          "description_kind": "plain",
          "optional": true
        },
        "max_pool_size": {
          "type": "number",
          "description": "Specifies the maximum number of connections in the connection pool. The default is 100.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The mongodb password",
          "description_kind": "plain",
          "required": true
        },
        "port": {
          "type": "string",
          "description": "The mongodb server port",
          "description_kind": "plain",
          "optional": true
        },
        "proxy": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "read_preference": {
          "type": "string",
          "description": "Specifies the read preference mode to use for operations. The default is primary.",
          "description_kind": "plain",
          "optional": true
        },
        "replica_set": {
          "type": "string",
          "description": "The mongodb replica set",
          "description_kind": "plain",
          "optional": true
        },
        "replica_set_hosts": {
          "type": "string",
          "description": "Comma separated list of hosts for the replica set",
          "description_kind": "plain",
          "optional": true
        },
        "retrywrites": {
          "type": "bool",
          "description": "Retryable Writes",
          "description_kind": "plain",
          "optional": true
        },
        "server_selection_timeout": {
          "type": "number",
          "description": "Specifies the time in milliseconds to wait to find an available, suitable server to execute an operation.",
          "description_kind": "plain",
          "optional": true
        },
        "ssl": {
          "type": "bool",
          "description": "ssl activation",
          "description_kind": "plain",
          "optional": true
        },
        "timeout": {
          "type": "number",
          "description": "Specifies the number of milliseconds that a single operation run on the Client can take before returning a timeout error. Operations honor this setting only if there is no deadline on the operation Context.",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "The mongodb user",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "mongodb_db_role": {
      "version": 0,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "inherited_role": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "db": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "role": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 2
          },
          "privilege": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "actions": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "collection": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "db": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 50
          }
        },
        "description_kind": "plain"
      }
    },
    "mongodb_db_user": {
      "version": 0,
      "block": {
        "attributes": {
          "auth_database": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "password": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "role": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "db": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "role": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 25
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
