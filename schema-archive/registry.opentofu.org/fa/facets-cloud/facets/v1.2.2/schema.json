{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "aws": {
          "nested_type": {
            "attributes": {
              "assume_role": {
                "nested_type": {
                  "attributes": {
                    "external_id": {
                      "type": "string",
                      "description": "External ID for assuming the role. Required when the role's trust policy specifies an external ID condition. This provides additional security against the confused deputy problem.",
                      "description_kind": "plain",
                      "optional": true
                    },
                    "role_arn": {
                      "type": "string",
                      "description": "ARN of the IAM role to assume (e.g., arn:aws:iam::123456789012:role/my-role). This role's trust policy must allow the pod's IRSA role to assume it.",
                      "description_kind": "plain",
                      "required": true
                    },
                    "session_name": {
                      "type": "string",
                      "description": "Session name to use when assuming the role. If not provided, a random session name will be generated. This appears in CloudTrail logs and can be used for tracking and auditing purposes.",
                      "description_kind": "plain",
                      "optional": true
                    }
                  },
                  "nesting_mode": "single"
                },
                "description": "Configuration for assuming an IAM role using IRSA. The pod's service account must have permissions to assume the specified role. At runtime, the AWS SDK will use the pod's IRSA credentials to assume this role via AWS STS AssumeRole.",
                "description_kind": "plain",
                "required": true
              },
              "region": {
                "type": "string",
                "description": "AWS region (e.g., us-west-2)",
                "description_kind": "plain",
                "required": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "AWS configuration for facets_tekton_action_aws resources. This block is optional and only required when using AWS actions. Uses IRSA (IAM Roles for Service Accounts) for authentication - the pod's service account must be configured with IAM role annotation. The AWS CLI will use the pod's IRSA credentials to assume the target role specified in assume_role configuration.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Facets Terraform Provider for creating Tekton actions and other Facets resources",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "facets_tekton_action_aws": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the Tekton Task",
            "description_kind": "plain",
            "optional": true
          },
          "facets_environment": {
            "nested_type": {
              "attributes": {
                "unique_name": {
                  "type": "string",
                  "description": "Unique name of the Facets-managed environment",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Facets-managed environment configuration. Specifies which environment this action runs in.",
            "description_kind": "plain",
            "required": true
          },
          "facets_resource": {
            "nested_type": {
              "attributes": {
                "kind": {
                  "type": "string",
                  "description": "Resource kind (used in resource labels)",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Resource definition as specified in the Facets blueprint. Only the 'kind' field is used by the provider (in resource labels). Other fields like 'flavor', 'version', and 'spec' can be provided but are silently ignored.",
            "description_kind": "plain",
            "required": true
          },
          "facets_resource_name": {
            "type": "string",
            "description": "Resource name as defined in the Facets blueprint. Used to map the Tekton task back to the blueprint resource in Facets.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Resource identifier",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the Tekton Task",
            "description_kind": "plain",
            "required": true
          },
          "params": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Parameter name",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description": "Parameter type (e.g., string, array)",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of params for the Tekton Task",
            "description_kind": "plain",
            "optional": true
          },
          "step_action_name": {
            "type": "string",
            "description": "Generated StepAction name for AWS credential setup (computed from hash). This StepAction automatically configures AWS access for the workflow steps.",
            "description_kind": "plain",
            "computed": true
          },
          "steps": {
            "nested_type": {
              "attributes": {
                "env": {
                  "nested_type": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "Environment variable name",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value": {
                        "type": "string",
                        "description": "Environment variable value",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "Environment variables for the step",
                  "description_kind": "plain",
                  "optional": true
                },
                "image": {
                  "type": "string",
                  "description": "Container image for the step",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "Step name",
                  "description_kind": "plain",
                  "required": true
                },
                "resources": {
                  "nested_type": {
                    "attributes": {
                      "limits": {
                        "type": [
                          "map",
                          "string"
                        ],
                        "description": "Maximum compute resources allowed (e.g., cpu, memory)",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "requests": {
                        "type": [
                          "map",
                          "string"
                        ],
                        "description": "Minimum compute resources required (e.g., cpu, memory)",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Compute resources (requests and limits) for the step",
                  "description_kind": "plain",
                  "optional": true
                },
                "script": {
                  "type": "string",
                  "description": "Script to execute in the step",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of steps for the Tekton Task",
            "description_kind": "plain",
            "required": true
          },
          "task_name": {
            "type": "string",
            "description": "Generated Tekton Task name (computed from hash of resource_name, environment, and name). This is the actual Kubernetes resource name and may be truncated to 63 characters.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a Tekton Task and StepAction for AWS-based workflows. This resource automatically injects AWS credentials (configured at provider level) via a setup-credentials step, which creates ~/.aws/credentials and ~/.aws/config files. The credentials are scoped to the AWS account configured in the provider.",
        "description_kind": "plain"
      }
    },
