          }
        },
        "description": "Manages a Tekton Task and StepAction for Kubernetes-based workflows. This resource automatically injects Kubernetes credentials (FACETS_USER_KUBECONFIG) via a setup-credentials step, which is populated by the Facets UI when users run actions. The kubeconfig is scoped to the user's RBAC permissions.",
        "description_kind": "plain"
      }
    }
  }
