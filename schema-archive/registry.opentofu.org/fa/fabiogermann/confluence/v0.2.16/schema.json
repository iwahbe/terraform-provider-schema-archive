{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "context": {
          "type": "string",
          "description": "Confluence path context (Will default to /wiki if using an atlassian.net hostname)",
          "description_kind": "markdown",
          "optional": true
        },
        "public_site": {
          "type": "string",
          "description": "Optional public Confluence Server hostname if different than API hostname",
          "description_kind": "markdown",
          "optional": true
        },
        "public_site_tls": {
          "type": "bool",
          "description": "Use https for public site URLs",
          "description_kind": "markdown",
          "optional": true
        },
        "site": {
          "type": "string",
          "description": "Confluence hostname (<name>.atlassian.net if using Cloud Confluence, otherwise hostname)",
          "description_kind": "markdown",
          "required": true
        },
        "site_tls": {
          "type": "bool",
          "description": "Use https for API calls",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Confluence API Token for Cloud Confluence or password for Confluence Server/Cloud",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "user": {
          "type": "string",
          "description": "User's email address for Cloud Confluence or username for Confluence Server",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "confluence_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Group identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the group",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Group resource",
        "description_kind": "markdown"
      }
    },
    "confluence_group_membership": {
      "version": 0,
      "block": {
        "attributes": {
          "account_id": {
            "type": "string",
            "description": "The account id to add to the group",
            "description_kind": "markdown",
            "required": true
          },
          "group_id": {
            "type": "string",
            "description": "The group id where the user is added to",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Resource identifier",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Group membership resource",
        "description_kind": "markdown"
      }
    },
    "confluence_space": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Resource identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The space key of the confluence space (all caps)",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the confluence space",
            "description_kind": "markdown",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "The URL for the space",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Space resource",
        "description_kind": "markdown"
      }
    },
    "confluence_space_permission": {
      "version": 0,
      "block": {
        "attributes": {
          "group": {
            "type": "string",
            "description": "The group that is allowed",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Resource identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The space key of the confluence space (all caps)",
            "description_kind": "markdown",
            "required": true
          },
          "operation_ids": {
            "type": [
              "map",
              "string"
            ],
            "description": "The operation's ids for the group",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "operations": {
            "type": [
              "list",
              "string"
            ],
            "description": "The operations allowed for the group",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Space permission resource",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "confluence_group_membership": {
      "version": 0,
      "block": {
        "attributes": {
          "group_id": {
            "type": "string",
            "description": "The Id of the group",
            "description_kind": "markdown",
            "optional": true
          },
          "group_members": {
            "type": [
              "map",
              "string"
            ],
            "description": "The members of the group",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "group_name": {
            "type": "string",
            "description": "The name of the group",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Privileges identifier",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Group membership data source",
        "description_kind": "markdown"
      }
    }
  }
}
