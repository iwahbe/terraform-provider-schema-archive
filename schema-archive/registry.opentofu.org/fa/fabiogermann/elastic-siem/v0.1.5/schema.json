{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "hostname": {
          "type": "string",
          "description": "The Kibana host name",
          "description_kind": "markdown",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "The password to authenticate to Kiaba and interact with the SIEM",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "port": {
          "type": "number",
          "description": "Connect to host on a custom port",
          "description_kind": "markdown",
          "optional": true
        },
        "tls": {
          "type": "bool",
          "description": "Connect to host using TLS or unencrypted",
          "description_kind": "markdown",
          "optional": true
        },
        "user": {
          "type": "string",
          "description": "The username to authenticate to Kiaba and interact with the SIEM",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "elastic-siem_detection_rule": {
      "version": 0,
      "block": {
        "attributes": {
          "exception_container_id": {
            "type": "string",
            "description": "The container ID that should be used for exceptions for this item (overrides id in rule_content)",
            "description_kind": "markdown",
            "optional": true
          },
          "exception_container_list_id": {
            "type": "string",
            "description": "The container list ID that should be used for exceptions for this item (overrides id in rule_content)",
            "description_kind": "markdown",
            "optional": true
          },
          "exception_type": {
            "type": "string",
            "description": "The type that should be used for exceptions for this item (defaults to `detection`)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Rule identifier (in UUID format)",
            "description_kind": "markdown",
            "computed": true
          },
          "rule_content": {
            "type": "string",
            "description": "The content of the rule (JSON encoded string)",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Detection rule resource",
        "description_kind": "markdown"
      }
    },
    "elastic-siem_exception_container": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "The description of the exception container",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Exception container identifier (in UUID format)",
            "description_kind": "markdown",
            "computed": true
          },
          "list_id": {
            "type": "string",
            "description": "The list id of the exception container (referenced in rule and item)",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the exception container",
            "description_kind": "markdown",
            "required": true
          },
          "namespace_type": {
            "type": "string",
            "description": "The namespace type of the exception container",
            "description_kind": "markdown",
            "required": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "The tags of the exception container",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "The type of the exception container",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Exception container resource",
        "description_kind": "markdown"
      }
    },
    "elastic-siem_exception_item": {
      "version": 0,
      "block": {
        "attributes": {
          "exception_item_content": {
            "type": "string",
            "description": "The content of the exception item (JSON encoded string)",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Exception item identifier (in UUID format)",
            "description_kind": "markdown",
            "computed": true
          },
          "list_id_override": {
            "type": "string",
            "description": "The list ID that should be used for the item (overrides id in exception_item_content)",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Exception item resource",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "elastic-siem_privileges": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Privileges identifier",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Privileges data source",
        "description_kind": "markdown"
      }
    }
  }
}
