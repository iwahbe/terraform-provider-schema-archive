{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "github_token": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "git_commit": {
      "version": 0,
      "block": {
        "attributes": {
          "branch": {
            "type": "string",
            "description": "The git branch to commit to.",
            "description_kind": "plain",
            "required": true
          },
          "delete_message": {
            "type": "string",
            "description": "The commit message to use on delete.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "message": {
            "type": "string",
            "description": "The git commit message.",
            "description_kind": "plain",
            "optional": true
          },
          "new": {
            "type": "bool",
            "description": "A boolean to indicate if the commit is newly created.",
            "description_kind": "plain",
            "computed": true
          },
          "prune": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "sha": {
            "type": "string",
            "description": "The git sha of the commit.",
            "description_kind": "plain",
            "computed": true
          },
          "update_message": {
            "type": "string",
            "description": "The commit message to use on update.",
            "description_kind": "plain",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "The URL of the git repository. Must be http, https, or ssh.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "add": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "content": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "path": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "A file to add. Contains a path and the file content.",
              "description_kind": "plain"
            }
          },
          "remove": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "path": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "A file to remove. Contains the file path.",
              "description_kind": "plain"
            }
          }
        },
        "description": "A resource to create a git commit with one or more files or removals.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "git_file": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "path": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "ref": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "url": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A file in a remote repository.",
        "description_kind": "plain"
      }
    },
    "git_repository": {
      "version": 0,
      "block": {
        "attributes": {
          "branches": {
            "type": [
              "list",
              [
                "object",
                {
                  "name": "string",
                  "sha": "string"
                }
              ]
            ],
            "description": "A list of branches in the remote repository.",
            "description_kind": "plain",
            "computed": true
          },
          "head": {
            "type": [
              "list",
              [
                "object",
                {
                  "sha": "string"
                }
              ]
            ],
            "description": "The head of the git repository.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tags": {
            "type": [
              "list",
              [
                "object",
                {
                  "name": "string",
                  "sha": "string"
                }
              ]
            ],
            "description": "A list of tags in the remote repository.",
            "description_kind": "plain",
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "The URL of the git repository. Must be http, https, or ssh.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A remote git repository.",
        "description_kind": "plain"
      }
    }
  }
}
