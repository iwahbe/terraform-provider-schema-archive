{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "profile": {
          "type": "string",
          "description": "The profile for API operations. If not set, the default profile\ncreated with `aws configure` will be used.",
          "description_kind": "markdown",
          "optional": true
        },
        "region": {
          "type": "string",
          "description": "The region where AWS operations will take place. Examples\nare us-east-1, us-west-2, etc.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "csd_record": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the DNS record as FQDN",
            "description_kind": "markdown",
            "required": true
          },
          "rrtype": {
            "type": "string",
            "description": "The type of DNS record",
            "description_kind": "markdown",
            "required": true
          },
          "ttl": {
            "type": "number",
            "description": "Time to life for the record in seconds",
            "description_kind": "markdown",
            "optional": true
          },
          "value": {
            "type": "string",
            "description": "Value of the DNS record (FQDN of Akamai Edgekey Hostname in case of CNAME)",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "csd_zone_delegation": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "FQDN of the DNS zone",
            "description_kind": "markdown",
            "required": true
          },
          "name_servers": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of authoritative name servers for the zone",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
