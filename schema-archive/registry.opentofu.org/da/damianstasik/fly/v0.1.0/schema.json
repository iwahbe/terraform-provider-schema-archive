{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "fly_api_token": {
          "type": "string",
          "description": "fly.io api token. If not set checks env for FLY_API_TOKEN",
          "description_kind": "markdown",
          "optional": true
        },
        "fly_http_endpoint": {
          "type": "string",
          "description": "Where the clients should look to find the fly http endpoint",
          "description_kind": "markdown",
          "optional": true
        },
        "internaltunnelorg": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "internaltunnelregion": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "useinternaltunnel": {
          "type": "bool",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "fly_app": {
      "version": 0,
      "block": {
        "attributes": {
          "appurl": {
            "type": "string",
            "description": "readonly appUrl",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "readonly app id",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of application",
            "description_kind": "markdown",
            "required": true
          },
          "org": {
            "type": "string",
            "description": "Optional org slug to operate upon",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "orgid": {
            "type": "string",
            "description": "readonly orgid",
            "description_kind": "markdown",
            "computed": true
          },
          "secrets": {
            "nested_type": {
              "attributes": {
                "created_at": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "digest": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "map"
            },
            "description": "Secret environment variables. Keys are case sensitive and are used as environment variable names. Does not override existing secrets added outside of Terraform.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Fly app resource",
        "description_kind": "markdown"
      }
    },
    "fly_cert": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "Name of app to attach",
            "description_kind": "markdown",
            "required": true
          },
          "check": {
            "type": "bool",
            "description": "check",
            "description_kind": "markdown",
            "computed": true
          },
          "dnsvalidationhostname": {
            "type": "string",
            "description": "DnsValidationHostname",
            "description_kind": "markdown",
            "computed": true
          },
          "dnsvalidationinstructions": {
            "type": "string",
            "description": "DnsValidationHostname",
            "description_kind": "markdown",
            "computed": true
          },
          "dnsvalidationtarget": {
            "type": "string",
            "description": "DnsValidationTarget",
            "description_kind": "markdown",
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description": "hostname",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of address",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Fly certificate resource",
        "description_kind": "markdown"
      }
    },
    "fly_ip": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "ID of volume",
            "description_kind": "markdown",
            "computed": true
          },
          "app": {
            "type": "string",
            "description": "Name of app to attach",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of address",
            "description_kind": "markdown",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "region",
            "description_kind": "markdown",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "v4 or v6",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Fly ip resource",
        "description_kind": "markdown"
      }
    },
    "fly_machine": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "fly app",
            "description_kind": "markdown",
            "optional": true
          },
          "cmd": {
            "type": [
              "list",
              "string"
            ],
            "description": "cmd",
            "description_kind": "markdown",
            "optional": true
          },
          "cpus": {
            "type": "number",
            "description": "cpu count",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "cputype": {
            "type": "string",
            "description": "cpu type",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "entrypoint": {
            "type": [
              "list",
              "string"
            ],
            "description": "image entrypoint",
            "description_kind": "markdown",
            "optional": true
          },
          "env": {
            "type": [
              "map",
              "string"
            ],
            "description": "Optional environment variables, keys and values must be strings",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "exec": {
            "type": [
              "list",
              "string"
            ],
            "description": "exec command",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "machine id",
            "description_kind": "markdown",
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "docker image",
            "description_kind": "markdown",
            "required": true
          },
          "memorymb": {
            "type": "number",
            "description": "memory mb",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "mounts": {
            "nested_type": {
              "attributes": {
                "encrypted": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "path": {
                  "type": "string",
                  "description": "Path for volume to be mounted on vm",
                  "description_kind": "markdown",
                  "required": true
                },
                "size_gb": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "volume": {
                  "type": "string",
                  "description": "Name or ID of volume",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Volume mounts",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "machine name",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "privateip": {
            "type": "string",
            "description": "Private IP",
            "description_kind": "markdown",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "machine region",
            "description_kind": "markdown",
            "required": true
          },
          "services": {
            "nested_type": {
              "attributes": {
                "internal_port": {
                  "type": "number",
                  "description": "Port application listens on internally",
                  "description_kind": "markdown",
                  "required": true
                },
                "ports": {
                  "nested_type": {
                    "attributes": {
                      "handlers": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "How the edge should process requests",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "port": {
                        "type": "number",
                        "description": "External port",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "External ports and handlers",
                  "description_kind": "markdown",
                  "required": true
                },
                "protocol": {
                  "type": "string",
                  "description": "network protocol",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "services",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Fly machine resource",
        "description_kind": "markdown"
      }
    },
    "fly_volume": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "Name of app to attach",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of volume",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "internalid": {
            "type": "string",
            "description": "Internal ID",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "name",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "region",
            "description_kind": "markdown",
            "required": true
          },
          "size": {
            "type": "number",
            "description": "Size of volume in gb",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Fly volume resource",
        "description_kind": "markdown"
      }
    }
  },
