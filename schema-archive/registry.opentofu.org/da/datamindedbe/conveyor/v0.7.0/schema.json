          "description_kind": "plain",
          "optional": true
        },
        "auth_key": {
          "type": "string",
          "description": "The key of the cicd token for a given tenant.",
          "description_kind": "plain",
          "optional": true
        },
        "auth_secret": {
          "type": "string",
          "description": "The secret of the cicd token for a given tenant.",
          "description_kind": "plain",
          "optional": true
        },
        "profile": {
          "type": "string",
          "description": "The conveyor profile to use for credentials.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "conveyor_alert_config": {
      "version": 0,
      "block": {
        "attributes": {
          "dag_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of DAG IDs to send alerts for when they fail. You can use '\\*' as a wildcard, like 'dag-\\*' to match all DAGs starting with 'dag-' or '\\*' to match all DAGs.",
            "description_kind": "plain",
            "required": true
          },
          "emails": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of emails to send alerts to.",
            "description_kind": "plain",
            "required": true
          },
          "environment_id": {
            "type": "string",
            "description": "The ID of the environment that the alert config belongs to.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The unique ID of the alert config.",
            "description_kind": "plain",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "The ID of the project that the alert config belongs to.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "The alert config resource allows you to create, update, and delete alert configs.\nAlert configs are used to send alerts to a list of email addresses when an Airflow task fails.",
        "description_kind": "markdown"
      }
    },
    "conveyor_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "airflow_version": {
            "type": "string",
            "description": "The Airflow version of the environment. Defaults to `3`.",
            "description_kind": "plain",
            "optional": true
          },
          "cluster_id": {
            "type": "string",
            "description": "The cluster id of the environment.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "deletion_protection": {
            "type": "bool",
            "description": "Whether to protect your environment from deletion. Defaults to `false`.",
            "description_kind": "plain",
            "optional": true
          },
          "iam_identity": {
            "type": "string",
            "description": "The IAM identity attached to the airflow processes. This is required when configuring secrets in the airflow_configuration.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The id of the environment.",
            "description_kind": "plain",
            "computed": true
          },
          "instance_lifecycle": {
            "type": "string",
            "description": "The instance lifecycle for the environment, either spot or on-demand. Defaults to `spot`.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the environment.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "airflow_configuration": {
            "nesting_mode": "list",
            "block": {
              "block_types": {
                "core": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "max_active_task_per_dag": {
                        "type": "number",
                        "description": "Sets the parallelism configuration in Airflow. Defaults to `32`.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "parallelism": {
                        "type": "number",
                        "description": "Sets the parallelism configuration in Airflow. Defaults to `128`.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description": "Allows you to configure the core Airflow settings.",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                },
                "secret": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "enabled": {
                        "type": "bool",
                        "description": "Enables the Airflow secrets backend integration.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "block_types": {
                      "connection": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "keyvault": {
                              "type": "string",
                              "description": "The name of the Azure keyvault in which the secret is stored.",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "name": {
                              "type": "string",
                              "description": "The name of the secret containing the connection information.",
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "description": "Allows you to configure the Airflow connections using a secret.",
                          "description_kind": "plain"
                        },
                        "max_items": 1
                      },
                      "variable": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "keyvault": {
                              "type": "string",
                              "description": "The name of the Azure keyvault in which the secret is stored.",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "name": {
                              "type": "string",
                              "description": "The name of the secret containing the Airflow variables.",
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "description": "Allows you to configure the Airflow variables using a secret.",
                          "description_kind": "plain"
                        },
                        "max_items": 1
                      }
                    },
                    "description": "Allows you to configure the Airflow secrets backend.",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                },
                "webserver": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "navbar_color": {
                        "type": "string",
                        "description": "Sets the color of the navbar in Airflow. Defaults to `#fff`.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description": "Allows you to configure the core webserver settings.",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description": "Allows you to configure Airflow.",
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "datahub_integration": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "capture_ownership_info": {
                  "type": "bool",
                  "description": "(Deprecated) Configures capture ownership info for the Airflow DataHub integration. Defaults to `true`.",
                  "description_kind": "plain",
                  "optional": true
                },
                "capture_tags_info": {
                  "type": "bool",
                  "description": "(Deprecated) Configures capture tags info for the Airflow DataHub integration. Defaults to `true`.",
                  "description_kind": "plain",
                  "optional": true
                },
                "cluster": {
                  "type": "string",
                  "description": "Sets the cluster used by the Airflow DataHub integration. Defaults to `prod`.",
                  "description_kind": "plain",
                  "optional": true
                },
                "conn_id": {
                  "type": "string",
                  "description": "Sets the connection used by the Airflow DataHub integration. Defaults to `datahub_rest_default`.",
                  "description_kind": "plain",
                  "optional": true
                },
                "enabled": {
                  "type": "bool",
                  "description": "Enables the Airflow DataHub integration.",
                  "description_kind": "plain",
                  "required": true
                },
                "graceful_exceptions": {
                  "type": "bool",
                  "description": "(Deprecated) When graceful exceptions is set for the Airflow DataHub integration, exceptions will not result in failures in Airflow. Defaults to `true`.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Allows you to configure the Airflow DataHub integration.",
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description": "Provides a Conveyor environment.",
        "description_kind": "plain"
      }
    },
