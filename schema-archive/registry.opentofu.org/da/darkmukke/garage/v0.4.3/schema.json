{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key": {
          "type": "string",
          "description": "S3 access key for object operations. Can also be set via GARAGE_ACCESS_KEY environment variable",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "(Deprecated) Admin API endpoint. Use 'endpoints.admin' instead.",
          "description_kind": "plain",
          "deprecated": true,
          "optional": true
        },
        "endpoints": {
          "nested_type": {
            "attributes": {
              "admin": {
                "type": "string",
                "description": "Admin API endpoint (e.g., 'http://localhost:3903')",
                "description_kind": "plain",
                "optional": true
              },
              "s3": {
                "type": "string",
                "description": "S3 API endpoint (e.g., 'http://localhost:3900')",
                "description_kind": "plain",
                "optional": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "Garage API endpoints configuration",
          "description_kind": "plain",
          "optional": true
        },
        "secret_key": {
          "type": "string",
          "description": "S3 secret key for object operations. Can also be set via GARAGE_SECRET_KEY environment variable",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "token": {
          "type": "string",
          "description": "Admin API token for Garage cluster management",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Terraform provider for managing Garage S3 buckets and objects",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "garage_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "global_alias": {
            "type": "string",
            "description": "The global alias (name) for the bucket.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the bucket.",
            "description_kind": "markdown",
            "computed": true
          },
          "max_objects": {
            "type": "number",
            "description": "Maximum number of objects in the bucket. Leave unset for unlimited.",
            "description_kind": "markdown",
            "optional": true
          },
          "max_size": {
            "type": "number",
            "description": "Maximum size of the bucket in bytes. Leave unset for unlimited.",
            "description_kind": "markdown",
            "optional": true
          },
          "website_enabled": {
            "type": "bool",
            "description": "Enable website hosting for this bucket.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "website_error_document": {
            "type": "string",
            "description": "The error document for website hosting (e.g., 'error.html').",
            "description_kind": "markdown",
            "optional": true
          },
          "website_index_document": {
            "type": "string",
            "description": "The index document for website hosting (e.g., 'index.html').",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages a Garage S3 bucket.",
        "description_kind": "markdown"
      }
    },
    "garage_bucket_permission": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key_id": {
            "type": "string",
            "description": "The ID of the access key.",
            "description_kind": "markdown",
            "required": true
          },
          "bucket_id": {
            "type": "string",
            "description": "The ID of the bucket.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the permission (format: bucket_id/access_key_id).",
            "description_kind": "markdown",
            "computed": true
          },
          "owner": {
            "type": "bool",
            "description": "Grant owner permission to the access key.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "read": {
            "type": "bool",
            "description": "Grant read permission to the access key.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "write": {
            "type": "bool",
            "description": "Grant write permission to the access key.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages permissions for an access key on a Garage S3 bucket.",
        "description_kind": "markdown"
      }
    },
    "garage_key": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The access key ID. If not provided, one will be generated.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "A human-friendly name for the access key.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "secret_access_key": {
            "type": "string",
            "description": "The secret access key. If not provided, one will be generated (only available on creation).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manages a Garage access key.",
        "description_kind": "markdown"
      }
    },
    "garage_object": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "Name of the bucket to store the object",
            "description_kind": "plain",
            "required": true
          },
          "content": {
            "type": "string",
            "description": "Literal string value to use as object content",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "content_type": {
            "type": "string",
            "description": "MIME type of the object",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "etag": {
            "type": "string",
            "description": "ETag of the object",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier (bucket/key)",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Name of the object in the bucket",
            "description_kind": "plain",
            "required": true
          },
          "source": {
            "type": "string",
            "description": "Path to a file that will be uploaded",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages an object in a Garage bucket",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "garage_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "bytes": {
            "type": "number",
            "description": "Current size of the bucket in bytes.",
            "description_kind": "markdown",
            "computed": true
          },
          "global_alias": {
            "type": "string",
            "description": "The primary global alias (name) of the bucket. Either id or global_alias must be specified.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "global_aliases": {
            "type": [
              "list",
              "string"
            ],
            "description": "All global aliases for this bucket.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the bucket. Either id or global_alias must be specified.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "max_objects": {
            "type": "number",
            "description": "Maximum number of objects in the bucket.",
            "description_kind": "markdown",
            "computed": true
          },
          "max_size": {
            "type": "number",
            "description": "Maximum size of the bucket in bytes.",
            "description_kind": "markdown",
            "computed": true
          },
          "objects": {
            "type": "number",
            "description": "Current number of objects in the bucket.",
            "description_kind": "markdown",
            "computed": true
          },
          "unfinished_uploads": {
            "type": "number",
            "description": "Number of unfinished multipart uploads.",
            "description_kind": "markdown",
            "computed": true
          },
          "website_enabled": {
            "type": "bool",
            "description": "Whether website hosting is enabled for this bucket.",
            "description_kind": "markdown",
            "computed": true
          },
          "website_error_document": {
            "type": "string",
            "description": "The error document for website hosting.",
            "description_kind": "markdown",
            "computed": true
          },
          "website_index_document": {
            "type": "string",
            "description": "The index document for website hosting.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieves information about a Garage S3 bucket.",
        "description_kind": "markdown"
      }
    },
    "garage_object": {
      "version": 0,
      "block": {
        "attributes": {
          "body": {
            "type": "string",
            "description": "Object content as a string (use for text files)",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "bucket": {
            "type": "string",
            "description": "Name of the bucket containing the object",
            "description_kind": "plain",
            "required": true
          },
          "content_length": {
            "type": "number",
            "description": "Size of the object in bytes",
            "description_kind": "plain",
            "computed": true
          },
          "content_type": {
            "type": "string",
            "description": "MIME type of the object",
            "description_kind": "plain",
            "computed": true
          },
          "etag": {
            "type": "string",
            "description": "ETag of the object",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier (bucket/key)",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Key (name) of the object in the bucket",
            "description_kind": "plain",
            "required": true
          },
          "last_modified": {
            "type": "string",
            "description": "Last modification time of the object",
            "description_kind": "plain",
            "computed": true
          },
          "metadata": {
            "type": [
              "map",
              "string"
            ],
            "description": "User-defined metadata for the object",
            "description_kind": "plain",
            "computed": true
          },
          "version_id": {
            "type": "string",
            "description": "Version ID of the object (if versioning is enabled)",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieves an object from a Garage bucket",
        "description_kind": "plain"
      }
    }
  }
}
