{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "controller_name": {
          "type": "string",
          "description": "The name of k8s service for the sealed-secret-controller.",
          "description_kind": "plain",
          "optional": true
        },
        "controller_namespace": {
          "type": "string",
          "description": "The namespace the controller is running in.",
          "description_kind": "plain",
          "optional": true
        },
        "pem": {
          "type": "string",
          "description": "The content of the pem file of the sealed-secret-controller.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "sealed_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "binary_data": {
            "type": [
              "map",
              "string"
            ],
            "description": "Base64 encoded key/value pairs to populate the secret.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "data": {
            "type": [
              "map",
              "string"
            ],
            "description": "Key/value pairs to populate the secret.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the secret, must be unique.",
            "description_kind": "plain",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "Namespace of the secret.",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "The secret type (ex. Opaque). Default type is Opaque.",
            "description_kind": "plain",
            "optional": true
          },
          "yaml_content": {
            "type": "string",
            "description": "The produced sealed secret yaml file.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Creates a sealed secret and stores it in yaml_content.",
        "description_kind": "plain"
      }
    }
  }
}
