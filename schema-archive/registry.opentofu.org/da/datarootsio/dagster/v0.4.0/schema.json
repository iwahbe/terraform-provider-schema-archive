{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "Dagster Cloud API Token. Can also be set via the `DAGSTER_CLOUD_API_TOKEN` environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "deployment": {
          "type": "string",
          "description": "Dagster Deployment. Can also be set via the `DAGSTER_CLOUD_DEPLOYMENT` environment variable. Defaults to `https://api.dagster.cloud`",
          "description_kind": "plain",
          "optional": true
        },
        "organization": {
          "type": "string",
          "description": "Dagster Organization. Can also be set via the `DAGSTER_CLOUD_ORGANIZATION` environment variable. Defaults to `https://api.dagster.cloud`",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dagster_code_location": {
      "version": 0,
      "block": {
        "attributes": {
          "agent_queue": {
            "type": "string",
            "description": "Code Location agent queue",
            "description_kind": "markdown",
            "optional": true
          },
          "attribute": {
            "type": "string",
            "description": "Code Location attribute",
            "description_kind": "markdown",
            "optional": true
          },
          "code_source": {
            "nested_type": {
              "attributes": {
                "module_name": {
                  "type": "string",
                  "description": "Name of the Python module from which to load definitions. Exactly one of `module_name`, `package_name` or `python_file` is required.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "package_name": {
                  "type": "string",
                  "description": "Name of the Python package from which to load definitions. Exactly one of `module_name`, `package_name` or `python_file` is required.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "python_file": {
                  "type": "string",
                  "description": "Name of the Python file from which to load definitions. Exactly one of `module_name`, `package_name` or `python_file` is required.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Code Location code source",
            "description_kind": "markdown",
            "required": true
          },
          "executable_path": {
            "type": "string",
            "description": "Code Location executable path",
            "description_kind": "markdown",
            "optional": true
          },
          "git": {
            "nested_type": {
              "attributes": {
                "commit_hash": {
                  "type": "string",
                  "description": "Code Location git commit hash. If git is specified, `commit_hash` is required.",
                  "description_kind": "markdown",
                  "required": true
                },
                "url": {
                  "type": "string",
                  "description": "Code Location git URL. If git is specified, `url` is required.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Code Location git. Git or Image is a required field (mutually exclusive).",
            "description_kind": "markdown",
            "optional": true
          },
          "image": {
            "type": "string",
            "description": "Docker image URL to use. Must be specified if `git` is not defined.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Code Location name. ",
            "description_kind": "markdown",
            "required": true
          },
          "working_directory": {
            "type": "string",
            "description": "Code Location working directory",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Creates a code location.",
        "description_kind": "markdown"
      }
    },
    "dagster_code_location_from_document": {
      "version": 0,
      "block": {
        "attributes": {
          "document": {
            "type": "string",
            "description": "Code location as a JSON document. We recommend using a `dagster_configuration_document` to generate this instead of composing a JSON document yourself.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Code location name",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Creates a code location from a dagster configuration document.",
        "description_kind": "markdown"
      }
    },
    "dagster_deployment": {
      "version": 0,
      "block": {
        "attributes": {
          "force_destroy": {
            "type": "bool",
            "description": "When `false`, will check if there are code locations associated with the deployment, if there are, it will block the delete of the deployment. When `true` ignore the code locations check. This is done because when you delete a deployment, you delete all the resources/metadata of that deployment and this is not recoverable. DEFAULT `false`",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Deployment id",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Deployment name",
            "description_kind": "markdown",
            "required": true
          },
          "settings_document": {
            "type": "string",
            "description": "Deployment settings as a JSON document. We recommend using a `dagster_configuration_document` to generate this instead of composing a JSON document yourself. Leaving this attribute empty or partially filled in, will result in Dagster (partially) applying default settings to your deployment. This leads to perpetual changes in this resource.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Deployment status (`ACTIVE` or `PENDNG_DELETION`)",
            "description_kind": "markdown",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Deployment type (`PRODUCTION`, `DEV` or `BRANCH`)",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Creates a deployment.",
        "description_kind": "markdown"
      }
    },
    "dagster_team": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Team id",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Team name",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Creates a team.",
        "description_kind": "markdown"
      }
    },
    "dagster_team_deployment_grant": {
      "version": 0,
      "block": {
        "attributes": {
          "code_location_grants": {
            "nested_type": {
              "attributes": {
                "grant": {
                  "type": "string",
                  "description": "Code location Grant",
                  "description_kind": "markdown",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "Code location Name",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description_kind": "plain",
            "optional": true
          },
          "deployment_id": {
            "type": "number",
            "description": "Team Deployment Grant DeploymentId",
            "description_kind": "markdown",
            "required": true
          },
          "grant": {
            "type": "string",
            "description": "Team Deployment Grant Grant",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "Team Deployment Grant Id",
            "description_kind": "markdown",
            "computed": true
          },
          "team_id": {
            "type": "string",
            "description": "Team Deployment Grant TeamId",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Creates a team deployment grants, which grants a team permissions on a deployment and its code locations.",
        "description_kind": "markdown"
      }
    },
    "dagster_team_membership": {
      "version": 0,
      "block": {
        "attributes": {
          "team_id": {
            "type": "string",
            "description": "Team id",
            "description_kind": "plain",
            "required": true
          },
          "user_id": {
            "type": "number",
            "description": "User id",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Adds a user to a team.",
        "description_kind": "plain"
      }
    },
    "dagster_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "Email address used to register the Dagster Cloud user",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "User id",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name the Dagster Cloud user",
            "description_kind": "plain",
            "computed": true
          },
          "picture": {
            "type": "string",
            "description": "URL to user's profile picture",
            "description_kind": "plain",
            "computed": true
          },
          "remove_default_permissions": {
            "type": "bool",
            "description": "Remove the default Viewer permissions on creation",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Registers a new user.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "dagster_configuration_document": {
      "version": 0,
      "block": {
        "attributes": {
          "json": {
            "type": "string",
            "description": "Settings document as JSON document",
            "description_kind": "plain",
            "computed": true
          },
          "yaml_body": {
            "type": "string",
            "description": "Settings document as YAML document",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Translates a YAML configuration document to a JSON document for the Dagster API.",
        "description_kind": "plain"
      }
    },
    "dagster_current_deployment": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "number",
            "description": "CurrentDeployment ID",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of CurrentDeployment",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieve information about the deployment used to configure this provider.",
        "description_kind": "plain"
      }
    },
    "dagster_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "account_review": {
            "type": "string",
            "description": "Account review status of the Dagster Organization",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Organization id",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name the Dagster Organization",
            "description_kind": "plain",
            "computed": true
          },
          "public_id": {
            "type": "string",
            "description": "Public ID of the Dagster Organization",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Status of the Dagster Organization",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieve information about a Dagster Organization.",
        "description_kind": "plain"
      }
    },
    "dagster_team": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Team id",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Dagster Cloud team",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Retrieve information about a Dagster Cloud team.",
        "description_kind": "plain"
      }
    },
    "dagster_teams": {
      "version": 0,
      "block": {
        "attributes": {
          "regex_filter": {
            "type": "string",
            "description": "Regex filter to select the Dagster Cloud teams based on the name of the team. Regex matching is done using `https://pkg.go.dev/regexp`.",
            "description_kind": "plain",
            "required": true
          },
          "teams": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Team id",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the Dagster Cloud team",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Teams",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieve information about a Dagster Cloud teams.",
        "description_kind": "plain"
      }
    },
    "dagster_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "Email address used to register the Dagster Cloud user",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "User id",
            "description_kind": "plain",
            "computed": true
          },
          "is_scim_provisioned": {
            "type": "bool",
            "description": "Whether this user was provisioned through SCIM",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name the Dagster Cloud user",
            "description_kind": "plain",
            "computed": true
          },
          "picture": {
            "type": "string",
            "description": "URL to user's profile picture",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieve information about a Dagster Cloud user.",
        "description_kind": "plain"
      }
    },
    "dagster_users": {
      "version": 0,
      "block": {
        "attributes": {
          "email_regex": {
            "type": "string",
            "description": "Regex filter to select the Dagster Cloud users based on the email id of the user. Regex matching is done using `https://pkg.go.dev/regexp`.",
            "description_kind": "plain",
            "required": true
          },
          "users": {
            "nested_type": {
              "attributes": {
                "email": {
                  "type": "string",
                  "description": "Email address used to register the Dagster Cloud user",
                  "description_kind": "plain",
                  "required": true
                },
                "id": {
                  "type": "number",
                  "description": "User id",
                  "description_kind": "plain",
                  "computed": true
                },
                "is_scim_provisioned": {
                  "type": "bool",
                  "description": "Whether this user was provisioned through SCIM",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name the Dagster Cloud user",
                  "description_kind": "plain",
                  "computed": true
                },
                "picture": {
                  "type": "string",
                  "description": "URL to user's profile picture",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Users",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieve information about the Dagster Cloud users.",
        "description_kind": "plain"
      }
    },
    "dagster_version": {
      "version": 0,
      "block": {
        "attributes": {
          "version": {
            "type": "string",
            "description": "Version of the Dagster Cloud instance",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieves the version of the Dagster Cloud instance.",
        "description_kind": "plain"
      }
    }
  }
}
