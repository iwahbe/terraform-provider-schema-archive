                "archive_handling_max_size_files": "number",
                "archive_handling_timeout": "number",
                "filetype_analysis_timeout": "number",
                "process_info_global_timeout": "bool",
                "process_info_global_timeout_value": "number",
                "process_info_max_download_size": "number",
                "process_info_max_file_size": "number",
                "process_info_quarantine": "bool",
                "process_info_skip_hash": "bool",
                "process_info_skip_processing_fast_symlink": "bool",
                "process_info_workflow_priority": "number",
                "scan_filescan_check_av_engine": "bool",
                "scan_filescan_download_timeout": "number",
                "scan_filescan_global_scan_timeout": "number",
                "scan_filescan_per_engine_scan_timeout": "number",
                "vul_filescan_timeout_vulnerability_scanning": "number"
