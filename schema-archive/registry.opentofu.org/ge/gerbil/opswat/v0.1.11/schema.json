{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "apikey": {
          "type": "string",
          "description": "API KEY for OPSWAT API. May also be provided via OPSWAT_APIKEY environment variable.",
          "description_kind": "plain",
          "required": true
        },
        "host": {
          "type": "string",
          "description": "URI for OPSWAT API. May also be provided via OPSWAT_HOST environment variable.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description": "Interact with OPSWAT.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "opswat_file_sync": {
      "version": 0,
      "block": {
        "attributes": {
          "timeout": {
            "type": "number",
            "description": "Global file sync can timeout.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Global file sync timeout resource.",
        "description_kind": "plain"
      }
    },
    "opswat_quarantine": {
      "version": 0,
      "block": {
        "attributes": {
          "cleanup_range": {
            "type": "number",
            "description": "Setting quarantine clean up time (clean up records older than). Note:The clean up range is defined in hours.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Global file sync can timeout resource.",
        "description_kind": "plain"
      }
    },
    "opswat_queue": {
      "version": 0,
      "block": {
        "attributes": {
