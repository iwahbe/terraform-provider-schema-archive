            "required": true
          }
        },
        "description": "Scan agent queue resource.",
        "description_kind": "plain"
      }
    },
    "opswat_scan_history": {
      "version": 0,
      "block": {
        "attributes": {
          "cleanuprange": {
            "type": "number",
            "description": "Setting processing history clean up time (clean up records older than).\n\nNote:The clean up range is defined in hours.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Processing history clean up time resource.",
        "description_kind": "plain"
      }
    },
    "opswat_session": {
      "version": 0,
      "block": {
        "attributes": {
          "absolute_session_timeout": {
            "type": "number",
            "description": "The interval (in milliseconds) for overall session length timeout (regardless of activity). minimal 300000. 0 - for infinity sessions.",
            "description_kind": "plain",
            "required": true
          },
          "allow_crossip_sessions": {
            "type": "bool",
            "description": "Allow requests from the same user to come from different IPs.",
            "description_kind": "plain",
            "required": true
          },
          "allow_duplicate_session": {
            "type": "bool",
            "description": "Allow same user to have multiple active sessions.",
            "description_kind": "plain",
            "required": true
          },
          "session_timeout": {
            "type": "number",
            "description": "The interval (in milliseconds) for the user's session timeout, based on last activity. Timer starts after the last activity for the apikey. minimal - 60000. 0 - for infinity sessions.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Global session timeouts resource.",
        "description_kind": "plain"
      }
    },
    "opswat_user": {
      "version": 0,
      "block": {
        "attributes": {
          "api_key": {
            "type": "string",
            "description": "Apikey; This function generates valid api key for Metadefender core based on following rules:\n APIKEY validation criteria\n The length of the API key must be exactly 36 characters.\n It must contain numeric and lower case a, b, c, d, e and f letter characters only\n It must contain at least 10 lower case a, b, c, d, e or f letter characters.\n It must contain at least 10 numeric characters.\n It is allowed to contain at most 3 consecutive lower case letter characters (e.g. \"abcd1a2b3c...\" is invalid because of the four consecutive letters).\n It is allowed to contain at most 3 consecutive numeric characters (e.g. \"1234a1b2c3...\" is invalid because of the four consecutive numeric characters).",
            "description_kind": "plain",
            "optional": true
          },
          "directory_id": {
            "type": "number",
            "description": "User dir ID to map user to.",
            "description_kind": "plain",
            "optional": true
          },
          "display_name": {
            "type": "string",
            "description": "User display name.",
            "description_kind": "plain",
            "optional": true
          },
          "email": {
            "type": "string",
            "description": "User email.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "User id.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "User name.",
            "description_kind": "plain",
            "optional": true
          },
          "password": {
            "type": "string",
            "description": "User password.",
            "description_kind": "plain",
            "optional": true
          },
          "roles": {
            "type": [
              "list",
              "string"
            ],
            "description": "User role to map user to.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "User resource.",
        "description_kind": "plain"
      }
    },
    "opswat_user_role": {
