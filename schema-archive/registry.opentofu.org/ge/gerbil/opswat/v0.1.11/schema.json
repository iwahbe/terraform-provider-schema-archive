            ],
            "description": "Options",
            "description_kind": "plain",
            "optional": true
          },
          "result_allowed": {
            "nested_type": {
              "attributes": {
                "role": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                },
                "visibility": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
