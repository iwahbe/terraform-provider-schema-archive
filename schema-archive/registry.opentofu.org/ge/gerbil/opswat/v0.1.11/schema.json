                                "string"
                              ],
                              "description_kind": "plain",
                              "required": true
                            },
                            "type": {
                              "type": "string",
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description_kind": "plain",
                  "required": true
                },
