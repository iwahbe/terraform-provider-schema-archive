{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "ca_file": {
          "type": "string",
          "description": "Path to a CA certificate file for TLS verification",
          "description_kind": "plain",
          "optional": true
        },
        "insecure_skip_verify": {
          "type": "bool",
          "description": "Skip TLS certificate verification. WARNING: This is insecure and should only be used for testing or in trusted networks with self-signed certificates.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The admin password used to login to the admin dashboard.",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "URL where Pi-hole is deployed",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "pihole_client": {
      "version": 0,
      "block": {
        "attributes": {
          "client": {
            "type": "string",
            "description": "Client identifier (IP address, MAC address, hostname, CIDR range, or interface name)",
            "description_kind": "plain",
            "required": true
          },
          "comment": {
            "type": "string",
            "description": "Optional comment for the client",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a Pi-hole client configuration. Clients can be IP addresses, MAC addresses, hostnames, CIDR ranges, or interface names.",
        "description_kind": "plain"
      }
    },
    "pihole_cname_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain to create a CNAME record for",
            "description_kind": "plain",
            "required": true
          },
          "force": {
            "type": "bool",
            "description": "Attempt to force record creation. Note: Pi-hole v6 API currently does not implement this for CNAME endpoints, but it is included for forward compatibility with future Pi-hole versions.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "target": {
            "type": "string",
            "description": "Value of the CNAME record where traffic will be directed to from the configured domain value",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Pi-hole CNAME record",
        "description_kind": "plain"
      }
    },
    "pihole_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "DNS record domain",
            "description_kind": "plain",
            "required": true
          },
          "force": {
            "type": "bool",
            "description": "If true and the record already exists, delete it before creating the new record. Enables upsert/overwrite behavior.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ip": {
            "type": "string",
            "description": "IP address to route traffic to from the DNS record domain",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Pi-hole DNS record",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "pihole_clients": {
      "version": 0,
      "block": {
        "attributes": {
          "clients": {
            "type": [
              "set",
              [
                "object",
                {
                  "client": "string",
                  "comment": "string"
                }
              ]
            ],
            "description": "List of Pi-hole client configurations",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "List all Pi-hole client configurations",
        "description_kind": "plain"
      }
    },
    "pihole_cname_records": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "records": {
            "type": [
              "set",
              [
                "object",
                {
                  "domain": "string",
                  "target": "string"
                }
              ]
            ],
            "description": "List of CNAME Pi-hole records",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "pihole_dns_records": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "records": {
            "type": [
              "set",
              [
                "object",
                {
                  "domain": "string",
                  "ip": "string"
                }
              ]
            ],
            "description": "List of Pi-hole DNS records",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
