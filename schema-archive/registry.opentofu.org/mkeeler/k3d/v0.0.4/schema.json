{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "k3d_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "agents": {
            "type": "number",
            "description": "Number of agents to create",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the cluster",
            "description_kind": "markdown",
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "Name of the K3s node image",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "image_sha": {
            "type": "string",
            "description": "SHA of the docker image that was used",
            "description_kind": "markdown",
            "computed": true
          },
          "k8s_api_host": {
            "type": "string",
            "description": "The hostname to serve the Kubernetes APIs with",
            "description_kind": "markdown",
            "optional": true
          },
          "k8s_api_host_ip": {
            "type": "string",
            "description": "The IP to bind the Kubernetes API",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "k8s_api_host_port": {
            "type": "number",
            "description": "The port to bind the Kubernetes API",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name that you want to give to your cluster (will still be prefixed with `k3d-`)",
            "description_kind": "markdown",
            "required": true
          },
          "network": {
            "type": "string",
            "description": "Name of the network the K3s nodes get attached to. If unset, a new network will be created.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "servers": {
            "type": "number",
            "description": "Number of servers to create",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "K3D Cluster",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "k3d_nodes": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_name": {
            "type": "string",
            "description": "Name of the K3D cluster for which to retrieve node information",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique cluster identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "nodes": {
            "nested_type": {
              "attributes": {
                "ip": {
                  "type": "string",
                  "description": "The IP address of the node's container",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the nodes docker container",
                  "description_kind": "markdown",
                  "computed": true
                },
                "networks": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "The list of docker networks to which the node is attached ",
                  "description_kind": "markdown",
                  "computed": true
                },
                "node_labels": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "A map of K3s node labels to their values",
                  "description_kind": "markdown",
                  "computed": true
                },
                "ports": {
                  "type": [
                    "set",
                    [
                      "object",
                      {
                        "host_ip": "string",
                        "host_port": "number",
                        "port": "number"
                      }
                    ]
                  ],
                  "description": "Node port binding set",
                  "description_kind": "markdown",
                  "computed": true
                },
                "role": {
                  "type": "string",
                  "description": "The K3d cluster role of the node",
                  "description_kind": "markdown",
                  "computed": true
                },
                "runtime_labels": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "A map of runtime labels to their values",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "map"
            },
            "description": "Map of node names to node information",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "K3d Cluster Node Listing Data Source",
        "description_kind": "markdown"
      }
    }
  }
}
