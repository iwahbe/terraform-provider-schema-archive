{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "dsn": {
          "type": "string",
          "description": "The data source name (DSN) for connecting to the database.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "timeout": {
          "type": "number",
          "description": "The maximum amount of time (in seconds) a database connection may be reused; zero means connections are reused forever.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "sql": {
      "version": 1,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description": "The database to run the migration against.",
            "description_kind": "plain",
            "required": true
          },
          "down": {
            "type": "string",
            "description": "The SQL command to run when migrating down.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "up": {
            "type": "string",
            "description": "The SQL command to run when migrating up.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
