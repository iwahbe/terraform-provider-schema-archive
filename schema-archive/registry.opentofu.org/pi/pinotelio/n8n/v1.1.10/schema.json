{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The n8n API key for authentication. May also be provided via N8N_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "The n8n API endpoint URL. May also be provided via N8N_ENDPOINT environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with n8n self-hosted cluster.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "n8n_credential": {
      "version": 0,
      "block": {
        "attributes": {
          "data": {
            "type": "string",
            "description": "JSON string representing the credential data. Changing this forces a new credential, since the n8n API cannot update credential data in place.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description": "Credential identifier",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the credential. Changing this forces a new credential.",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of the credential (e.g., 'httpBasicAuth', 'slackApi', etc.). Changing this forces a new credential.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages an n8n credential.",
        "description_kind": "plain"
      }
    },
    "n8n_user": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Timestamp when the user was created",
            "description_kind": "plain",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "Email address of the user (cannot be changed after creation)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "User identifier",
            "description_kind": "plain",
            "computed": true
          },
          "invite_accept_url": {
            "type": "string",
            "description": "URL for the user to accept the invitation (only available after user creation)",
            "description_kind": "plain",
            "computed": true
          },
          "is_owner": {
            "type": "bool",
            "description": "Whether the user is an owner",
            "description_kind": "plain",
            "computed": true
          },
          "is_pending": {
            "type": "bool",
            "description": "Whether the user account is pending activation",
            "description_kind": "plain",
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "Role of the user (e.g., 'global:owner', 'global:admin', 'global:member'). Changing it requires the n8n enterprise advancedPermissions feature.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "Timestamp when the user was last updated",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages an n8n user.",
        "description_kind": "plain"
      }
    },
    "n8n_workflow": {
      "version": 0,
      "block": {
        "attributes": {
          "connections": {
            "type": "string",
            "description": "JSON string representing the workflow connections. Optional if workflow_json is provided.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp when the workflow was created",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Workflow identifier",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the workflow. Optional if workflow_json is provided.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "nodes": {
            "type": "string",
            "description": "JSON string representing the workflow nodes. Optional if workflow_json is provided.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "settings": {
            "type": "string",
            "description": "JSON string representing the workflow settings",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tags": {
            "type": "string",
            "description": "JSON string representing the workflow tags",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "Timestamp when the workflow was last updated",
            "description_kind": "plain",
            "computed": true
          },
          "workflow_json": {
            "type": "string",
            "description": "Complete workflow JSON. When provided, individual attributes (name, nodes, connections, etc.) are extracted from this JSON. This allows you to paste an entire n8n workflow export directly.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages an n8n workflow. You can either specify individual attributes (name, nodes, connections, etc.) or provide a complete workflow JSON using the workflow_json attribute.",
        "description_kind": "plain"
      }
    },
    "n8n_workflow_activation": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Whether the workflow should be active. Note: Workflows must have at least one trigger, poller, or webhook node to be activated.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Internal identifier (same as workflow_id)",
            "description_kind": "plain",
            "computed": true
          },
          "workflow_id": {
            "type": "string",
            "description": "The ID of the workflow to manage activation for",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages the activation state of an n8n workflow. This resource controls whether a workflow is active (running) or inactive. Workflows must have at least one trigger node to be activated.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "n8n_user": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Timestamp when the user was created",
            "description_kind": "plain",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "Email address of the user",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "User identifier",
            "description_kind": "plain",
            "required": true
          },
          "is_owner": {
            "type": "bool",
            "description": "Whether the user is an owner",
            "description_kind": "plain",
            "computed": true
          },
          "is_pending": {
            "type": "bool",
            "description": "Whether the user account is pending activation",
            "description_kind": "plain",
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "Role of the user",
            "description_kind": "plain",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "Timestamp when the user was last updated",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches an n8n user.",
        "description_kind": "plain"
      }
    },
    "n8n_workflow": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Whether the workflow is active",
            "description_kind": "plain",
            "computed": true
          },
          "connections": {
            "type": "string",
            "description": "JSON string representing the workflow connections",
            "description_kind": "plain",
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp when the workflow was created",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Workflow identifier",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the workflow",
            "description_kind": "plain",
            "computed": true
          },
          "nodes": {
            "type": "string",
            "description": "JSON string representing the workflow nodes",
            "description_kind": "plain",
            "computed": true
          },
          "settings": {
            "type": "string",
            "description": "JSON string representing the workflow settings",
            "description_kind": "plain",
            "computed": true
          },
          "tags": {
            "type": "string",
            "description": "JSON string representing the workflow tags",
            "description_kind": "plain",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "Timestamp when the workflow was last updated",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches an n8n workflow.",
        "description_kind": "plain"
      }
    }
  }
}
