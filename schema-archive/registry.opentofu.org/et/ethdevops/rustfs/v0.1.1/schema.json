{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key": {
          "type": "string",
          "description": "Username or access key",
          "description_kind": "plain",
          "required": true
        },
        "access_secret": {
          "type": "string",
          "description": "Secret to be used as pass",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "RUSTFS server endpoint in the format host:port",
          "description_kind": "plain",
          "required": true
        },
        "insecure": {
          "type": "bool",
          "description": "Insecure skip SSL validation",
          "description_kind": "plain",
          "optional": true
        },
        "ssl": {
          "type": "bool",
          "description": "Use SSL transport",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Provider to access with RustFS",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "rustfs_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "name": {
            "type": "string",
            "description": "Name of the bucket",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage S3 buckets in rustfs",
        "description_kind": "markdown"
      }
    },
    "rustfs_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "name": {
            "type": "string",
            "description": "Name of the policy",
            "description_kind": "plain",
            "required": true
          },
          "statement": {
            "nested_type": {
              "attributes": {
                "action": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "required": true
                },
                "effect": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "ressource": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "required": true
          },
          "version": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manage S3 policies",
        "description_kind": "markdown"
      }
    },
    "rustfs_quota": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "Name of the bucket",
            "description_kind": "plain",
            "required": true
          },
          "quota": {
            "type": "number",
            "description": "Bytes of the quota",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage bucket quota in rustfs",
        "description_kind": "markdown"
      }
    },
    "rustfs_serviceaccount": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key": {
            "type": "string",
            "description": "Access Key",
            "description_kind": "markdown",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Short description of the scope we plan to use this token",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Visible name, only for viewing",
            "description_kind": "markdown",
            "required": true
          },
          "secret_key": {
            "type": "string",
            "description": "Secret Key",
            "description_kind": "markdown",
            "required": true
          },
          "user": {
            "type": "string",
            "description": "Optional user the token should be scoped to",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manage ServiceUser/API Keys",
        "description_kind": "markdown"
      }
    },
    "rustfs_user": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key": {
            "type": "string",
            "description": "Access Key",
            "description_kind": "markdown",
            "required": true
          },
          "policy": {
            "type": "string",
            "description": "User policy. Changing this forces a new user to be created (the underlying API does not support updating a user's policy in-place).",
            "description_kind": "markdown",
            "required": true
          },
          "secret_key": {
            "type": "string",
            "description": "Secret Key",
            "description_kind": "markdown",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Status",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manage RustFS user",
        "description_kind": "markdown"
      }
    }
  }
}
