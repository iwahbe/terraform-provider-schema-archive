{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "ca_cert": {
          "type": "string",
          "description": "CA certificate to use if you are authenticating with a server that is using a self signed cert.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "password": {
          "type": "string",
          "description": "Password to authenticate to the Jenkins Server",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "url": {
          "type": "string",
          "description": "URL to the Jenkins Server to configure",
          "description_kind": "markdown",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "Username to authenticate to the Jenkins Server",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "jenkins_node": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Node description",
            "description_kind": "markdown",
            "optional": true
          },
          "disable_deferred_wipeout": {
            "type": "bool",
            "description": "Disables deferred workspace wipeout. Requires ws-cleanup plugin.",
            "description_kind": "markdown",
            "optional": true
          },
          "environment_variables": {
            "type": [
              "map",
              "string"
            ],
            "description": "Environment variables to set on the node. Map of variable names to values.",
            "description_kind": "markdown",
            "optional": true
          },
          "executors": {
            "type": "number",
            "description": "Number of executors",
            "description_kind": "markdown",
            "optional": true
          },
          "free_disk_space_threshold": {
            "type": "string",
            "description": "Free disk space threshold for monitoring (e.g., '1GiB', '500MB'). Sets both disk and temp thresholds if free_temp_space_threshold is not specified.",
            "description_kind": "markdown",
            "optional": true
          },
          "free_disk_space_warning_threshold": {
            "type": "string",
            "description": "Warning threshold for free disk space (e.g., '800MB'). Optional.",
            "description_kind": "markdown",
            "optional": true
          },
          "free_temp_space_threshold": {
            "type": "string",
            "description": "Free temp space threshold for monitoring (e.g., '500MB'). If not specified, uses free_disk_space_threshold value.",
            "description_kind": "markdown",
            "optional": true
          },
          "free_temp_space_warning_threshold": {
            "type": "string",
            "description": "Warning threshold for free temp space (e.g., '400MB'). Optional.",
            "description_kind": "markdown",
            "optional": true
          },
          "jnlp_secret": {
            "type": "string",
            "description": "computed value that is set for jnlp nodes.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "labels": {
            "type": [
              "list",
              "string"
            ],
            "description": "labels to apply to the Jenkins node.",
            "description_kind": "markdown",
            "optional": true
          },
          "launcher_configuration": {
            "nested_type": {
              "attributes": {
                "jnlp_options": {
                  "nested_type": {
                    "attributes": {
                      "fail_if_workdir_missing": {
                        "type": "bool",
                        "description": "Fails to build if work directory is missing.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "remoting_dir": {
                        "type": "string",
                        "description": "Directory where Jenkins stores agent data.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "use_web_socket": {
                        "type": "bool",
                        "description": "Uses a websocket to connect.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "workdir_disabled": {
                        "type": "bool",
                        "description": "Doesn't save data to the workspace.",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Options for configuring a JNLP agent.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "ssh_options": {
                  "nested_type": {
                    "attributes": {
                      "credentials_id": {
                        "type": "string",
                        "description": "Credential to use to connect to Jenkins",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "host": {
                        "type": "string",
                        "description": "IP address or DNS name of the machine to connect to.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "java_path": {
                        "type": "string",
                        "description": "Path to Java bin to connect with.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "jvm_options": {
                        "type": "string",
                        "description": "Additional flags to pass to Java",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "launch_timeout_seconds": {
                        "type": "number",
                        "description": "How long to wait before timing out a connection attempt.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "max_num_retries": {
                        "type": "number",
                        "description": "Max number of retries before the SSH agent stops attempting connection.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "port": {
                        "type": "number",
                        "description": "Port to connect via SSH.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "prefix_start_slave_cmd": {
                        "type": "string",
                        "description": "Command that runs before the agent connects to Jenkins.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "retry_wait_time": {
                        "type": "number",
                        "description": "How long to wait between attempted SSH connections.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "suffix_start_slave_cmd": {
                        "type": "string",
                        "description": "Command that runs after the agent connects to Jenkins.",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Options for configuring an SSH agent.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "Type of launcher to connect to. Should be ssh or jnlp",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Defines launcher options for the node.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Jenkins node",
            "description_kind": "markdown",
            "required": true
          },
          "remote_fs": {
            "type": "string",
            "description": "Where agent will store info/workspace",
            "description_kind": "markdown",
            "required": true
          },
          "tool_locations": {
            "type": [
              "map",
              "string"
            ],
            "description": "Tool locations on the node. Map keys should be in format 'tool_type:tool_name', e.g., 'hudson.plugins.git.GitTool$DescriptorImpl:Default'. Values are the paths to the tools.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Creates a Jenkins Node.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "jenkins_node": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
