          },
          "free_disk_space_warning_threshold": {
            "type": "string",
            "description": "Free disk space warning threshold",
            "description_kind": "markdown",
            "computed": true
          },
          "free_temp_space_threshold": {
            "type": "string",
            "description": "Free temp space threshold",
            "description_kind": "markdown",
            "computed": true
          },
          "free_temp_space_warning_threshold": {
            "type": "string",
