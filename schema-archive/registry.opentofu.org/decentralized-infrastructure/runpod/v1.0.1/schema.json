{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The RunPod API key. Can also be set via the RUNPOD_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "runpod_endpoint": {
      "version": 0,
      "block": {
        "attributes": {
          "allowed_cuda_versions": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of acceptable CUDA versions on the workers.",
            "description_kind": "markdown",
            "optional": true
          },
          "compute_type": {
            "type": "string",
            "description": "Set to GPU for GPU workers or CPU for CPU workers.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "cpu_flavor_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of RunPod CPU flavors which can be attached to workers.",
            "description_kind": "markdown",
            "optional": true
          },
          "created_at": {
            "type": "string",
            "description": "The UTC timestamp when the Endpoint was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "data_center_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of RunPod data center IDs where workers can be located.",
            "description_kind": "markdown",
            "optional": true
          },
          "execution_timeout_ms": {
            "type": "number",
            "description": "The maximum number of milliseconds a request can run before the worker is stopped.",
            "description_kind": "markdown",
            "optional": true
          },
          "flashboot": {
            "type": "bool",
            "description": "Whether to use flash boot for the Endpoint.",
            "description_kind": "markdown",
            "optional": true
          },
          "gpu_count": {
            "type": "number",
            "description": "The number of GPUs attached to each worker on the Endpoint.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "gpu_type_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of RunPod GPU types which can be attached to workers.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the Endpoint.",
            "description_kind": "markdown",
            "computed": true
          },
          "idle_timeout": {
            "type": "number",
            "description": "The number of seconds a worker can run without taking a job before the worker is scaled down.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "A user-defined name for the Endpoint.",
            "description_kind": "markdown",
            "optional": true
          },
          "network_volume_id": {
            "type": "string",
            "description": "The unique identifier of the network volume to attach to the Endpoint.",
            "description_kind": "markdown",
            "optional": true
          },
          "scaler_type": {
            "type": "string",
            "description": "The method used to scale up workers. QUEUE_DELAY or REQUEST_COUNT.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "scaler_value": {
            "type": "number",
            "description": "For QUEUE_DELAY: seconds a request can remain in queue. For REQUEST_COUNT: target requests per worker.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "template_id": {
            "type": "string",
            "description": "The unique identifier of the template used to create the Endpoint.",
            "description_kind": "markdown",
            "required": true
          },
          "user_id": {
            "type": "string",
            "description": "The unique identifier of the user who created the Endpoint.",
            "description_kind": "markdown",
            "computed": true
          },
          "vcpu_count": {
            "type": "number",
            "description": "If the Endpoint is a CPU endpoint, the number of vCPUs allocated to each worker.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "version": {
            "type": "number",
            "description": "The version number of the Endpoint.",
            "description_kind": "markdown",
            "computed": true
          },
          "workers_max": {
            "type": "number",
            "description": "The maximum number of workers that can be running at the same time.",
            "description_kind": "markdown",
            "optional": true
          },
          "workers_min": {
            "type": "number",
            "description": "The minimum number of workers that will run at the same time.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "RunPod Serverless Endpoint resource. An Endpoint is a serverless deployment that auto-scales based on demand.",
        "description_kind": "markdown"
      }
    },
    "runpod_network_volume": {
      "version": 0,
      "block": {
        "attributes": {
          "data_center_id": {
            "type": "string",
            "description": "The RunPod data center ID where the Network Volume is located.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the Network Volume.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "A user-defined name for the Network Volume. The name does not need to be unique.",
            "description_kind": "markdown",
            "required": true
          },
          "size": {
            "type": "number",
            "description": "The amount of disk space, in gigabytes (GB), allocated to the Network Volume. Must be between 0 and 4000.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "RunPod Network Volume resource. A Network Volume is persistent storage that can be attached to Pods and Endpoints.",
        "description_kind": "markdown"
      }
    },
    "runpod_pod": {
      "version": 0,
      "block": {
        "attributes": {
          "actual_data_center": {
            "type": "string",
            "description": "The actual data center where the Pod was deployed.",
            "description_kind": "markdown",
            "computed": true
          },
          "adjusted_cost_per_hr": {
            "type": "number",
            "description": "The effective cost in RunPod credits per hour of running the Pod, adjusted by active Savings Plans.",
            "description_kind": "markdown",
            "computed": true
          },
          "allowed_cuda_versions": {
            "type": [
              "list",
              "string"
            ],
            "description": "If the Pod is a GPU Pod, a list of acceptable CUDA versions on the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "cloud_type": {
            "type": "string",
            "description": "Set to SECURE to create the Pod in Secure Cloud. Set to COMMUNITY to create the Pod in Community Cloud.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "compute_type": {
            "type": "string",
            "description": "Set to GPU to create a GPU Pod. Set to CPU to create a CPU Pod.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "container_disk_in_gb": {
            "type": "number",
            "description": "The amount of disk space, in gigabytes (GB), to allocate on the container disk. Data is wiped when the Pod restarts.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "container_registry_auth_id": {
            "type": "string",
            "description": "Registry credentials ID.",
            "description_kind": "markdown",
            "optional": true
          },
          "cost_per_hr": {
            "type": "number",
            "description": "The cost in RunPod credits per hour of running the Pod.",
            "description_kind": "markdown",
            "computed": true
          },
          "country_codes": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of country codes where the Pod can be located.",
            "description_kind": "markdown",
            "optional": true
          },
          "cpu_flavor_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "If the Pod is a CPU Pod, a list of RunPod CPU flavors which can be attached to the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "cpu_flavor_priority": {
            "type": "string",
            "description": "If the Pod is a CPU Pod, set to availability to respond to current CPU flavor availability. Set to custom to always try to rent CPU flavors in the order specified.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "data_center_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of RunPod data center IDs where the Pod can be located.",
            "description_kind": "markdown",
            "optional": true
          },
          "data_center_priority": {
            "type": "string",
            "description": "Set to availability to respond to current machine availability. Set to custom to always try to rent machines from data centers in the order specified.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "desired_status": {
            "type": "string",
            "description": "The current expected status of the Pod.",
            "description_kind": "markdown",
            "computed": true
          },
          "docker_entrypoint": {
            "type": [
              "list",
              "string"
            ],
            "description": "If specified, overrides the ENTRYPOINT for the Docker image run on the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "docker_start_cmd": {
            "type": [
              "list",
              "string"
            ],
            "description": "If specified, overrides the start CMD for the Docker image run on the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "env": {
            "type": [
              "map",
              "string"
            ],
            "description": "Environment variables for the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "global_networking": {
            "type": "bool",
            "description": "Set to true to enable global networking for the Pod.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "gpu_count": {
            "type": "number",
            "description": "If the Pod is a GPU Pod, the number of GPUs attached to the Pod.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "gpu_type_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "If the Pod is a GPU Pod, a list of RunPod GPU types which can be attached to the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "gpu_type_priority": {
            "type": "string",
            "description": "If the Pod is a GPU Pod, set to availability to respond to current GPU type availability. Set to custom to always try to rent GPU types in the order specified.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the Pod.",
            "description_kind": "markdown",
            "computed": true
          },
          "image_name": {
            "type": "string",
            "description": "The Docker image tag for the container run on the Pod.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "interruptible": {
            "type": "bool",
            "description": "Set to true to create an interruptible or spot Pod. Can be rented at a lower cost but can be stopped at any time.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "last_started_at": {
            "type": "string",
            "description": "The UTC timestamp when the Pod was last started.",
            "description_kind": "markdown",
            "computed": true
          },
          "locked": {
            "type": "bool",
            "description": "Set to true to lock a Pod. Locking a Pod disables stopping or resetting the Pod.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "machine_id": {
            "type": "string",
            "description": "The unique identifier of the host machine the Pod is running on.",
            "description_kind": "markdown",
            "computed": true
          },
          "memory_in_gb": {
            "type": "number",
            "description": "The amount of RAM, in gigabytes (GB), attached to the Pod.",
            "description_kind": "markdown",
            "computed": true
          },
          "min_disk_bandwidth_mbps": {
            "type": "number",
            "description": "The minimum disk bandwidth, in megabytes per second (MBps), for the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "min_download_mbps": {
            "type": "number",
            "description": "The minimum download speed, in megabits per second (Mbps), for the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "min_ram_per_gpu": {
            "type": "number",
            "description": "If the Pod is a GPU Pod, the minimum amount of RAM, in gigabytes (GB), allocated to the Pod for each GPU.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "min_upload_mbps": {
            "type": "number",
            "description": "The minimum upload speed, in megabits per second (Mbps), for the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "min_vcpu_per_gpu": {
            "type": "number",
            "description": "If the Pod is a GPU Pod, the minimum number of virtual CPUs allocated to the Pod for each GPU.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "A user-defined name for the Pod. The name does not need to be unique.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "network_volume_id": {
            "type": "string",
            "description": "The unique string identifying the network volume to attach to the Pod.",
            "description_kind": "markdown",
            "optional": true
          },
          "ports": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of ports exposed on the Pod. Each port is formatted as [port number]/[protocol].",
            "description_kind": "markdown",
            "optional": true
          },
          "public_ip": {
            "type": "string",
            "description": "The public IP address of the Pod.",
            "description_kind": "markdown",
            "computed": true
          },
          "support_public_ip": {
            "type": "bool",
            "description": "If the Pod is on Community Cloud, set to true if you need the Pod to expose a public IP address.",
            "description_kind": "markdown",
            "optional": true
          },
          "template_id": {
            "type": "string",
            "description": "If the Pod is created with a template, the unique string identifying that template.",
            "description_kind": "markdown",
            "optional": true
          },
          "vcpu_count": {
            "type": "number",
            "description": "If the Pod is a CPU Pod, the number of vCPUs allocated to the Pod.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "volume_in_gb": {
            "type": "number",
            "description": "The amount of disk space, in gigabytes (GB), to allocate on the Pod volume. Data is persisted across Pod restarts.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "volume_mount_path": {
            "type": "string",
            "description": "The absolute path where the network volume will be mounted in the filesystem.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "RunPod Pod resource. A Pod is a container instance that can be either GPU-based or CPU-based.",
        "description_kind": "markdown"
      }
    }
  },
