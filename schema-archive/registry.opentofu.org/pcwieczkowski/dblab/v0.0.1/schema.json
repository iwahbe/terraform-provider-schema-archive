{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "The full URL of the DBLab API server.",
          "description_kind": "markdown",
          "required": true
        },
        "verification_token": {
          "type": "string",
          "description": "Verification token for the DBLab API.",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dblab_clone": {
      "version": 0,
      "block": {
        "attributes": {
          "database_name": {
            "type": "string",
            "description": "The name of the database in the clone.",
            "description_kind": "markdown",
            "computed": true
          },
          "database_password": {
            "type": "string",
            "description": "Custom credentials for the database clone.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "database_username": {
            "type": "string",
            "description": "Custom credentials for the database clone.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the clone, can be provided by user or generated by the server.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "port": {
            "type": "string",
            "description": "The port to acces clone's PostgreSQL instance.",
            "description_kind": "markdown",
            "computed": true
          },
          "protected": {
            "type": "bool",
            "description": "When enabled no one can delete this clone via API & UI and automated deletion is also disabled. Note that destroy operation will unset it first.",
            "description_kind": "markdown",
            "required": true
          },
          "snapshot_id": {
            "type": "string",
            "description": "Snapshot identifier to use for the clone. If unset the latest snapshot will be used.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Database clone",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "dblab_snapshots": {
      "version": 0,
      "block": {
        "attributes": {
          "snapshots": {
            "type": [
              "list",
              [
                "object",
                {
                  "id": "string",
                  "pool": "string"
                }
              ]
            ],
            "description": "Returned snapshots",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Snapshots data source",
        "description_kind": "markdown"
      }
    }
  }
}
