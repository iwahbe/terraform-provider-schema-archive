{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_url": {
          "type": "string",
          "description": "Synthetics API server URL (optional). Can also be specified with KTAPI_URL environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "email": {
          "type": "string",
          "description": "Authorization email (required). Can also be specified with KTAPI_AUTH_EMAIL environment variable.",
          "description_kind": "plain",
          "required": true
        },
        "log_payloads": {
          "type": "bool",
          "description": "Log payloads flag enables verbose debug logs of requests and responses (optional). Can also be specified with KTAPI_LOG_PAYLOADS environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Authorization token (required). Can also be specified with KTAPI_AUTH_TOKEN environment variable.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "block_types": {
        "retry": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "max_attempts": {
                "type": "number",
                "description": "Maximum number of request retry attempts. Minimum valid value: 1 (0 fallbacks to default). Default: 100. Can also be specified with KTAPI_RETRY_MAX_ATTEMPTS environment variable.",
                "description_kind": "plain",
                "optional": true
              },
              "max_delay": {
                "type": "string",
                "description": "Maximum delay before request retry. Expected Go time duration format, e.g. 1s (see: <https://pkg.go.dev/time#ParseDuration>). Default: 5m (5 minutes). Can also be specified with KTAPI_RETRY_MAX_DELAY environment variable.",
                "description_kind": "plain",
                "optional": true
              },
              "min_delay": {
                "type": "string",
                "description": "Minimum delay before request retry. Expected Go time duration format, e.g. 1s (see: <https://pkg.go.dev/time#ParseDuration>). Default: 1s (1 second). Can also be specified with KTAPI_RETRY_MIN_DELAY environment variable.",
                "description_kind": "plain",
                "optional": true
              }
            },
            "description": "Configuration for API client retry mechanism",
            "description_kind": "plain"
          },
          "max_items": 1
        }
      },
      "description_kind": "plain"
    }
  },
