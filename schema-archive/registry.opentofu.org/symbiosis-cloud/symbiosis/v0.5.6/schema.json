{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The ApiKey used to authenticate requests towards Symbiosis.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "Endpoint for reaching the symbiosis API. Used for debugging or when accessed through a proxy.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "symbiosis_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "ca_certificate": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "certificate": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "endpoint": {
            "type": "string",
            "description": "Cluster API server endpoint",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "is_highly_available": {
            "type": "bool",
            "description": "When set to true it will deploy a highly available control plane with multiple replicas for redundancy.",
            "description_kind": "plain",
            "optional": true
          },
          "kube_version": {
            "type": "string",
            "description": "Kubernetes version, see symbiosis.host for valid values or \"latest\" for the most recent supported version.",
            "description_kind": "plain",
            "optional": true
          },
          "kubeconfig": {
            "type": "string",
            "description": "The raw kubeconfig file.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "Cluster name. Changing the name forces re-creation.",
            "description_kind": "plain",
            "required": true
          },
          "private_key": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "region": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "state": {
            "type": "string",
            "description": "Cluster state [PENDING, DELETE_IN_PROGRESS, ACTIVE, FAILED]",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "\n    Manages Kubernetes clusters.\n    ",
        "description_kind": "plain"
      }
    },
    "symbiosis_cluster_service_account": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_ca_certificate": {
            "type": "string",
            "description": "Cluster CA certificate",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "cluster_name": {
            "type": "string",
            "description": "Cluster name. Changing the name forces re-creation.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "token": {
            "type": "string",
            "description": "Service account token",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "\n    Manages Kubernetes clusters service accounts.\n    ",
        "description_kind": "plain"
      }
    },
    "symbiosis_node_pool": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster": {
            "type": "string",
            "description": "Name of cluster to create node pool in.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of node pool.",
            "description_kind": "plain",
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Node labels to be applied to the nodes",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of node pool",
            "description_kind": "plain",
            "required": true
          },
          "node_type": {
            "type": "string",
            "description": "Type of nodes for this specific pool, see docs.",
            "description_kind": "plain",
            "required": true
          },
          "quantity": {
            "type": "number",
            "description": "Desired number of nodes for specific pool. Optional if autoscaling is enabled.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "autoscaling": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "enabled": {
                  "type": "bool",
                  "description_kind": "plain",
                  "required": true
                },
                "max_size": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "min_size": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "taint": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "effect": {
                  "type": "string",
                  "description": "Taint effect. Can be either NoSchedule, PreferNoSchedule or NoExecute. See: https://kubernetes.io/docs/concepts/scheduling-eviction/taint-and-toleration/",
                  "description_kind": "plain",
                  "required": true
                },
                "key": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Node taints to be applied to the nodes",
              "description_kind": "plain"
            }
          }
        },
        "description": "Creates node pools for Kubernetes clusters in Symbiosis.",
        "description_kind": "plain"
      }
    },
    "symbiosis_team_member": {
      "version": 0,
      "block": {
        "attributes": {
          "accepted_invitation": {
            "type": "string",
            "description": "Whether the user has accepted the invitation to the team.",
            "description_kind": "plain",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "User email to invite. Adding an team member will send the user an invitation. Deleting a team member will either delete the invitation or the user depending on whether the user has accepted the invitation.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "User role. Valid values include [MEMBER, ADMIN].",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "\n    Manages team membership and invitations.\n    ",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "symbiosis_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "ca_certificate": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "certificate": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "endpoint": {
            "type": "string",
            "description": "Cluster API server endpoint",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "is_highly_available": {
            "type": "bool",
            "description": "If set to true, control plane is deployed with multiple replicas for redundancy.",
            "description_kind": "plain",
            "computed": true
          },
          "kube_version": {
            "type": "string",
            "description": "Kubernetes version.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Cluster name.",
            "description_kind": "plain",
            "required": true
          },
          "private_key": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "state": {
            "type": "string",
            "description": "Cluster state.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "\n    Describes a Kubernetes cluster.\n    ",
        "description_kind": "plain"
      }
    }
  }
}
