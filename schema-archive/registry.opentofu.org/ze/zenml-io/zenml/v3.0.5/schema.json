            "description_kind": "markdown",
            "computed": true
          },
          "flavor": {
            "type": "string",
            "description": "Flavor of the stack component",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Stack component identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Labels for the stack component",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the stack component",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of the stack component",
            "description_kind": "markdown",
            "required": true
          },
          "updated": {
            "type": "string",
            "description": "The timestamp when the stack component was last updated",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Stack component resource",
        "description_kind": "markdown"
      }
    }
