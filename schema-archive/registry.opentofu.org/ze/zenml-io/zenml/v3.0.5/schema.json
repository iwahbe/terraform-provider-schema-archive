{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API key for authentication with the ZenML server",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "api_token": {
          "type": "string",
          "description": "The API token for authentication with the ZenML server",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "server_url": {
          "type": "string",
          "description": "The URL of the ZenML server",
          "description_kind": "markdown",
          "optional": true
        },
        "skip_version_check": {
          "type": "bool",
          "description": "Skip the ZenML server version compatibility check. Use with caution as it may lead to unexpected behavior.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "zenml_project": {
      "version": 0,
      "block": {
        "attributes": {
          "created": {
            "type": "string",
            "description": "The timestamp when the project was created",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "A description of the project",
            "description_kind": "markdown",
            "optional": true
          },
          "display_name": {
            "type": "string",
            "description": "The display name of the project",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Project identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The unique name of the project",
            "description_kind": "markdown",
            "required": true
          },
          "updated": {
            "type": "string",
            "description": "The timestamp when the project was last updated",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Project resource",
        "description_kind": "markdown"
      }
    },
    "zenml_service_connector": {
      "version": 0,
      "block": {
        "attributes": {
          "auth_method": {
            "type": "string",
            "description": "Authentication method for the service connector",
            "description_kind": "markdown",
            "required": true
          },
          "configuration": {
            "type": [
              "map",
              "string"
            ],
            "description": "Configuration for the service connector",
            "description_kind": "markdown",
            "optional": true
          },
          "created": {
            "type": "string",
            "description": "The timestamp when the service connector was created",
            "description_kind": "markdown",
            "computed": true
          },
          "expires_at": {
            "type": "string",
            "description": "Expiration time for the service connector (RFC3339 format)",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Service connector identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Labels for the service connector",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the service connector",
            "description_kind": "markdown",
            "required": true
          },
          "resource_id": {
            "type": "string",
            "description": "Resource ID for the service connector",
            "description_kind": "markdown",
            "optional": true
          },
          "resource_type": {
            "type": "string",
            "description": "Resource type for the service connector",
            "description_kind": "markdown",
            "optional": true
          },
          "timeouts": {
            "nested_type": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Type of the service connector",
            "description_kind": "markdown",
            "required": true
          },
          "updated": {
            "type": "string",
            "description": "The timestamp when the service connector was last updated",
            "description_kind": "markdown",
            "computed": true
          },
          "user": {
            "type": "string",
            "description": "The owner of the service connector",
            "description_kind": "markdown",
            "computed": true
          },
          "verify": {
            "type": "bool",
            "description": "Whether to verify the service connector configuration before creating or updating it",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Service connector resource",
        "description_kind": "markdown"
      }
    },
    "zenml_stack": {
      "version": 0,
      "block": {
        "attributes": {
          "components": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map of component types to component IDs. Changing the orchestrator or artifact_store will force stack replacement since these are required components.",
