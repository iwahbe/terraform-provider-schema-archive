            "required": true
          },
          "id": {
            "type": "string",
            "description": "Stack identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Labels for the stack",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the stack",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Stack resource",
        "description_kind": "markdown"
