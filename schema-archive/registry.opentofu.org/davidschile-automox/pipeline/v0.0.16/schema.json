            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "environments": {
            "type": [
              "set",
              "string"
            ],
            "description": "In a project, an array of environment names in which this pipeline source will be.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "is_internal": {
            "type": "bool",
            "description": "Set this as false to create a Pipelines integration.",
            "description_kind": "plain",
            "optional": true
          },
          "master_integration_id": {
            "type": "number",
            "description": "The Id of the master integration.",
            "description_kind": "plain",
            "optional": true
          },
          "master_integration_name": {
            "type": "string",
            "description": "The name of the master integration.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the project integration. Should be prefixed with the project key",
            "description_kind": "plain",
            "required": true
          },
          "project": {
            "type": [
              "map",
              "string"
            ],
            "description": "An object containing a project name as an alternative to projectId.",
            "description_kind": "plain",
            "optional": true
          },
          "project_id": {
            "type": "number",
            "description": "Id of the project.",
            "description_kind": "plain",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "URL to Artifactory instance",
            "description_kind": "plain",
            "required": true
          },
          "user": {
            "type": "string",
            "description": "User for Artifactory access",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Provides an Jfrog Pipelines Artifactory Project Integration resource.",
        "description_kind": "plain"
      }
