{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "config": {
          "type": "string",
          "description": "Location of the ztctl configuration file, will default to `~/.ztctl/config.json`",
          "description_kind": "markdown",
          "optional": true
        },
        "name": {
          "type": "string",
          "description": "The alias in the ztctl configuration file, this takes precedence over the url and token attributes",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The token to access the API",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "url": {
          "type": "string",
          "description": "The URL of the Auxo API",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "auxo_location": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Computed unique ID of the resource location",
            "description_kind": "markdown",
            "computed": true
          },
          "latitude": {
            "type": "number",
            "description": "Latitude of the resource location",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "longitude": {
            "type": "number",
            "description": "Longitude of the resource location",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the resource location",
            "description_kind": "markdown",
            "required": true
          },
          "uniqueness_key": {
            "type": "string",
            "description": "Custom and optinal uniqueness key to identify the resource location",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "A location which can be used in a state to reflect where resources are located.",
        "description_kind": "markdown"
      }
    },
    "auxo_measure": {
      "version": 0,
      "block": {
        "attributes": {
          "measures": {
            "nested_type": {
              "attributes": {
                "assigned": {
                  "type": "bool",
                  "description": "Measure assigned to the protectsurface",
                  "description_kind": "markdown",
                  "required": true
                },
                "assigned_by": {
                  "type": "string",
                  "description": "Who assigned this measure to the protectsurface",
                  "description_kind": "markdown",
                  "optional": true
