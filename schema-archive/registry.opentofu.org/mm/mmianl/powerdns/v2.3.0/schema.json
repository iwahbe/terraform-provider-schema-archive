{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "REST API authentication API key. Can also be set via PDNS_API_KEY.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "ca_certificate": {
          "type": "string",
          "description": "Content or path of a Root CA to verify the server certificate. Also via PDNS_CACERT.",
          "description_kind": "plain",
          "optional": true
        },
        "cache_mem_size": {
          "type": "string",
          "description": "Cache memory size in MB. Also via PDNS_CACHE_MEM_SIZE.",
          "description_kind": "plain",
          "optional": true
        },
        "cache_requests": {
          "type": "bool",
          "description": "Enable caching of REST API requests. Also via PDNS_CACHE_REQUESTS.",
          "description_kind": "plain",
          "optional": true
        },
        "cache_ttl": {
          "type": "number",
          "description": "Cache TTL in seconds. Also via PDNS_CACHE_TTL.",
          "description_kind": "plain",
          "optional": true
        },
        "client_cert_file": {
          "type": "string",
          "description": "REST API authentication client certificate file path (.crt). Can also be set via PDNS_CLIENT_CERT_FILE.",
          "description_kind": "plain",
          "optional": true
        },
        "client_cert_key_file": {
          "type": "string",
          "description": "REST API authentication client certificate key file path (.key). Can also be set via PDNS_CLIENT_CERT_KEY_FILE.",
          "description_kind": "plain",
          "optional": true
        },
        "insecure_https": {
          "type": "bool",
          "description": "Disable verification of the PowerDNS server's TLS certificate. Also via PDNS_INSECURE_HTTPS.",
          "description_kind": "plain",
          "optional": true
        },
        "recursor_server_url": {
          "type": "string",
          "description": "Base URL of the PowerDNS recursor server. Also via PDNS_RECURSOR_SERVER_URL.",
          "description_kind": "plain",
          "optional": true
        },
        "server_url": {
          "type": "string",
          "description": "Base URL of the PowerDNS server (e.g., https://pdns.example.com). Can also be set via PDNS_SERVER_URL.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "powerdns_network": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "network": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "view": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_ptr_record": {
      "version": 0,
      "block": {
        "attributes": {
          "hostname": {
            "type": "string",
            "description": "The hostname to point to. Must be a fully qualified domain name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ip_address": {
            "type": "string",
            "description": "The IP address to create a PTR record for (IPv4 or IPv6).",
            "description_kind": "plain",
            "required": true
          },
          "reverse_zone": {
            "type": "string",
            "description": "The name of the reverse zone (e.g., '16.172.in-addr.arpa.' or '8.b.d.0.1.0.0.2.ip6.arpa.'). Must be a fully qualified domain name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          },
          "ttl": {
            "type": "number",
            "description": "The TTL of the PTR record.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "comments": {
            "type": [
              "list",
              "string"
            ],
            "description": "Ordered list of RRset comments stored in PowerDNS.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "disabled": {
            "type": "bool",
            "description": "Whether all records in this RRset are disabled in PowerDNS.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "records": {
            "type": [
              "set",
              "string"
            ],
            "description_kind": "plain",
            "required": true
          },
          "set_ptr": {
            "type": "bool",
            "description": "For A and AAAA records, if true, create corresponding PTR.",
            "description_kind": "plain",
            "optional": true
          },
          "ttl": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "zone": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_record_soa": {
      "version": 0,
      "block": {
        "attributes": {
          "disabled": {
            "type": "bool",
            "description": "Whether the SOA record is disabled in PowerDNS.",
            "description_kind": "plain",
            "optional": true
          },
          "expire": {
            "type": "number",
            "description": "Expire time in seconds.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "minimum": {
            "type": "number",
            "description": "Minimum TTL (negative caching) in seconds.",
            "description_kind": "plain",
            "required": true
          },
          "mname": {
            "type": "string",
            "description": "Primary nameserver (MNAME). Must be a fully qualified domain name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "refresh": {
            "type": "number",
            "description": "Refresh interval in seconds.",
            "description_kind": "plain",
            "required": true
          },
          "retry": {
            "type": "number",
            "description": "Retry interval in seconds.",
            "description_kind": "plain",
            "required": true
          },
          "rname": {
            "type": "string",
            "description": "Responsible person email in DNS format (RNAME). Must be a fully qualified domain name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          },
          "serial": {
            "type": "number",
            "description": "SOA serial number. If omitted or 0, PowerDNS manages it via soa_edit_api.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ttl": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          },
          "zone": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_recursor_config": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the recursor config setting",
            "description_kind": "plain",
            "required": true
          },
          "value": {
            "type": [
              "set",
              "string"
            ],
            "description": "The value of the recursor config setting (list of CIDRs, etc.)",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_recursor_forward_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "servers": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of DNS servers to forward queries to",
            "description_kind": "plain",
            "required": true
          },
          "zone": {
            "type": "string",
            "description": "The zone name to forward. Must be a fully qualified domain name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_reverse_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "cidr": {
            "type": "string",
            "description": "The CIDR block for the reverse zone (e.g., '172.16.0.0/16')",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "The kind of zone (Master or Slave)",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The computed zone name (e.g., '16.172.in-addr.arpa.')",
            "description_kind": "plain",
            "computed": true
          },
          "nameservers": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of nameservers for this zone. Each nameserver must be a fully qualified domain name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_view_zone_association": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "view": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "zone": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "account": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "catalog": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "kind": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "masters": {
            "type": [
              "set",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "soa_edit_api": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_zone_metadata": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "Metadata kind as used by PowerDNS, for example \"ALSO-NOTIFY\" or \"ALLOW-AXFR-FROM\".",
            "description_kind": "plain",
            "required": true
          },
          "metadata": {
            "type": [
              "set",
              "string"
            ],
            "description": "Set of values for this metadata kind.",
            "description_kind": "plain",
            "required": true
          },
          "zone": {
            "type": "string",
            "description": "Zone name, for example \"example.com.\".",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "powerdns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "comments": {
            "type": [
              "list",
              "string"
            ],
            "description": "Ordered list of RRset comments stored in PowerDNS.",
            "description_kind": "plain",
            "computed": true
          },
          "disabled": {
            "type": "bool",
            "description": "Whether all records in the RRset are disabled in PowerDNS.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The fully qualified record name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          },
          "records": {
            "type": [
              "set",
              "string"
            ],
            "description": "Set of record contents in the RRset.",
            "description_kind": "plain",
            "computed": true
          },
          "ttl": {
            "type": "number",
            "description": "The TTL of the RRset in seconds.",
            "description_kind": "plain",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The RRset type to look up, for example A, AAAA, MX, or TXT.",
            "description_kind": "plain",
            "required": true
          },
          "zone": {
            "type": "string",
            "description": "The name of the zone containing the record. Must be a fully qualified domain name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_record_soa": {
      "version": 0,
      "block": {
        "attributes": {
          "disabled": {
            "type": "bool",
            "description": "Whether the SOA record is disabled.",
            "description_kind": "plain",
            "computed": true
          },
          "expire": {
            "type": "number",
            "description": "Expire time in seconds.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "minimum": {
            "type": "number",
            "description": "Minimum TTL (negative caching) in seconds.",
            "description_kind": "plain",
            "computed": true
          },
          "mname": {
            "type": "string",
            "description": "Primary nameserver (MNAME).",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the SOA record (usually the same as the zone name). Must be a fully qualified domain name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          },
          "refresh": {
            "type": "number",
            "description": "Refresh interval in seconds.",
            "description_kind": "plain",
            "computed": true
          },
          "retry": {
            "type": "number",
            "description": "Retry interval in seconds.",
            "description_kind": "plain",
            "computed": true
          },
          "rname": {
            "type": "string",
            "description": "Responsible person email in DNS format (RNAME).",
            "description_kind": "plain",
            "computed": true
          },
          "serial": {
            "type": "number",
            "description": "SOA serial number.",
            "description_kind": "plain",
            "computed": true
          },
          "ttl": {
            "type": "number",
            "description": "The TTL of the SOA record.",
            "description_kind": "plain",
            "computed": true
          },
          "zone": {
            "type": "string",
            "description": "The name of the zone containing the SOA record. Must be a fully qualified domain name ending with a trailing dot.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_reverse_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "cidr": {
            "type": "string",
            "description": "The CIDR block for the reverse zone (e.g., '172.16.0.0/16')",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "The kind of zone (Master or Slave)",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The computed zone name (e.g., '16.172.in-addr.arpa.')",
            "description_kind": "plain",
            "computed": true
          },
          "nameservers": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of nameservers for this zone",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "account": {
            "type": "string",
            "description": "The account associated with the zone",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "The kind of zone (Master, Slave, etc.)",
            "description_kind": "plain",
            "computed": true
          },
          "masters": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of master servers for this zone (Slave zones only)",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the zone to retrieve. Must be a fully qualified domain name ending with a trailing dot or zone variant.",
            "description_kind": "plain",
            "required": true
          },
          "records": {
            "type": [
              "list",
              [
                "object",
                {
                  "content": "string",
                  "disabled": "bool",
                  "name": "string",
                  "ttl": "number",
                  "type": "string"
                }
              ]
            ],
            "description": "List of all records in the zone",
            "description_kind": "plain",
            "computed": true
          },
          "soa_edit_api": {
            "type": "string",
            "description": "SOA edit API setting",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_zone_metadata": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "Metadata kind name (for example ALSO-NOTIFY).",
            "description_kind": "plain",
            "required": true
          },
          "metadata": {
            "type": [
              "set",
              "string"
            ],
            "description": "Values for the requested metadata kind.",
            "description_kind": "plain",
            "computed": true
          },
          "zone": {
            "type": "string",
            "description": "Zone name, as FQDN with trailing dot.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "powerdns_zone_metadata_list": {
      "version": 0,
      "block": {
        "attributes": {
          "entries": {
            "type": [
              "set",
              [
                "object",
                {
                  "kind": "string",
                  "metadata": [
                    "set",
                    "string"
                  ]
                }
              ]
            ],
            "description": "All metadata entries for the zone.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "zone": {
            "type": "string",
            "description": "Zone name, as FQDN with trailing dot.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
