{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_endpoint": {
          "type": "string",
          "description": "The base URL to use for the Glesys API requests. (Defaults to the value of the `GLESYS_API_URL` environment variable or `https://api.glesys.com` if unset.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "User token for the Glesys API. Alternatively, this can be set using the `GLESYS_TOKEN` environment variable",
          "description_kind": "plain",
          "required": true
        },
        "userid": {
          "type": "string",
          "description": "UserId for the Glesys API. Alternatively, this can be set using the `GLESYS_USERID` environment variable",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "glesys_database": {
      "version": 0,
      "block": {
        "attributes": {
          "allowlist": {
            "type": [
              "list",
              "string"
            ],
            "description": "Update the allow list for a database instance list. The list can use single IP addresses or CIDR ranges.",
            "description_kind": "plain",
            "optional": true
          },
          "connectionstring": {
            "type": "string",
            "description": "Connection string to access database",
            "description_kind": "plain",
            "computed": true
          },
          "datacenterkey": {
            "type": "string",
            "description": "Datacenter key",
            "description_kind": "plain",
            "required": true
          },
          "engine": {
            "type": "string",
            "description": "Database engine name",
            "description_kind": "plain",
            "required": true
          },
          "engineversion": {
            "type": "string",
            "description": "Database engine version",
            "description_kind": "plain",
            "required": true
          },
          "fqdn": {
            "type": "string",
            "description": "Database FQDN",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Database ID",
            "description_kind": "plain",
            "computed": true
          },
          "maintenancewindow_durationinminutes": {
            "type": "number",
            "description": "Duration of database maintenance window (minutes).",
            "description_kind": "plain",
            "computed": true
          },
          "maintenancewindow_starttime": {
            "type": "string",
            "description": "Database maintenance window starttime.",
            "description_kind": "plain",
            "computed": true
          },
          "maintenancewindow_weekday": {
            "type": "string",
            "description": "Database maintenance window day of week.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Database name",
            "description_kind": "plain",
            "required": true
          },
          "plankey": {
            "type": "string",
            "description": "Database plan key",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Database status",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
