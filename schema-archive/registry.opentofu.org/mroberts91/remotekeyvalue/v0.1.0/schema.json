{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key_header_name": {
          "type": "string",
          "description": "Name of the header used to send an API Key with the request.",
          "description_kind": "plain",
          "optional": true
        },
        "api_key_header_value": {
          "type": "string",
          "description": "Value of the header used to send an API Key with the request.",
          "description_kind": "plain",
          "optional": true
        },
        "timeout": {
          "type": "number",
          "description": "HTTP Request Timeout",
          "description_kind": "plain",
          "optional": true
        },
        "uri": {
          "type": "string",
          "description": "URI of the API endpoint to retrive the key value. This serves as the base of all requests.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "remotekeyvalue_pair": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Key of the key value pair.",
            "description_kind": "plain",
            "computed": true
          },
          "method": {
            "type": "string",
            "description": "HTTP method to use when retrieving a key-value pair. Defaults to GET.",
            "description_kind": "plain",
            "optional": true
          },
          "path": {
            "type": "string",
            "description": "The path used to retrieve a key-value pair.",
            "description_kind": "plain",
            "required": true
          },
          "sensitive": {
            "type": "bool",
            "description": "Flag that indicated if the value should be treated as sensitive.",
            "description_kind": "plain",
            "computed": true
          },
          "value": {
            "type": "string",
            "description": "Value of the key value pair.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
