{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "coverage_examples_validation": {
      "version": 0,
      "block": {
        "attributes": {
          "examples_directory": {
            "type": "string",
            "description": "Filepath to the examples directory for the module.",
            "description_kind": "markdown",
            "required": true
          },
          "filter": {
            "type": "string",
            "description": "Filter to use to find tests responsible for validating the examples.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID",
            "description_kind": "markdown",
            "computed": true
          },
          "missing_tests": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of example directories that are missing tests",
            "description_kind": "markdown",
            "computed": true
          },
          "tests_directory": {
            "type": "string",
            "description": "Filepath to the tests directory for the module.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Validate that there are tests for all examples in the example directory.",
        "description_kind": "markdown"
      }
    }
  }
}
