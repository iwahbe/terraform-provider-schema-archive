{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "deno_binary_path": {
          "type": "string",
          "description": "Custom path to deno binary. When set, skips automatic download.",
          "description_kind": "markdown",
          "optional": true
        },
        "deno_version": {
          "type": "string",
          "description": "Deno version to auto-download (e.g., 'v2.1.4', 'v2.0.0-rc.1'). Defaults to 'latest' which downloads the latest stable GA release.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "The Deno Bridge provider enables Terraform to manage resources using Deno scripts.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "denobridge_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "config_file": {
            "type": "string",
            "description": "File path to a deno config file to use with the deno script. Useful for import maps, etc...",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for the resource.",
            "description_kind": "plain",
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Path to the Deno script to execute.",
            "description_kind": "plain",
            "required": true
          },
          "permissions": {
            "nested_type": {
              "attributes": {
                "all": {
                  "type": "bool",
                  "description": "Grant all permissions.",
                  "description_kind": "plain",
                  "optional": true
                },
                "allow": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of permissions to allow (e.g., 'read', 'write', 'net').",
                  "description_kind": "plain",
                  "optional": true
                },
                "deny": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of permissions to deny.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Deno runtime permissions for the script.",
            "description_kind": "plain",
            "optional": true
          },
          "props": {
            "type": "dynamic",
            "description": "Input properties to pass to the Deno script.",
            "description_kind": "plain",
            "required": true
          },
          "sensitive_state": {
            "type": "dynamic",
            "description": "Sensitive computed state of the resource as returned by the Deno script. This value is marked as sensitive and will not be displayed in logs or plan output.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "state": {
            "type": "dynamic",
            "description": "Additional computed state of the resource as returned by the Deno script.",
            "description_kind": "plain",
            "computed": true
          },
          "write_only_props": {
            "type": "dynamic",
            "description": "Input properties to pass to the Deno script that are write-only.",
            "description_kind": "plain",
            "optional": true
          },
          "write_only_props_version": {
            "type": "number",
            "description": "Version of the write-only properties.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Bridges the terraform-plugin-framework Resource to a Deno script.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "denobridge_datasource": {
      "version": 0,
      "block": {
        "attributes": {
          "config_file": {
            "type": "string",
            "description": "File path to a deno config file to use with the deno script. Useful for import maps, etc...",
            "description_kind": "plain",
            "optional": true
          },
          "path": {
            "type": "string",
            "description": "Path to the Deno script to execute.",
            "description_kind": "plain",
            "required": true
          },
          "permissions": {
            "nested_type": {
              "attributes": {
                "all": {
                  "type": "bool",
                  "description": "Grant all permissions.",
                  "description_kind": "plain",
                  "optional": true
                },
                "allow": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of permissions to allow (e.g., 'read', 'write', 'net').",
                  "description_kind": "plain",
                  "optional": true
                },
                "deny": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of permissions to deny.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Deno runtime permissions for the script.",
            "description_kind": "plain",
            "optional": true
          },
          "props": {
            "type": "dynamic",
            "description": "Input properties to pass to the Deno script.",
            "description_kind": "plain",
            "required": true
          },
          "result": {
            "type": "dynamic",
            "description": "Output data returned from the Deno script.",
            "description_kind": "plain",
            "computed": true
          },
          "sensitive_result": {
            "type": "dynamic",
            "description": "Sensitive output data returned from the Deno script.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Bridges the terraform-plugin-framework Datasource to a Deno script.",
        "description_kind": "plain"
      }
    }
  }
}
