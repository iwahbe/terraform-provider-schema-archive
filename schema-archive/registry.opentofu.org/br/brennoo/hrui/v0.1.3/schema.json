{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "autosave": {
          "type": "bool",
          "description": "Enable automatic saving of configuration changes after resource creation or updates. Can also be set using the `HRUI_AUTOSAVE` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password for authentication. Can also be set using the `HRUI_PASSWORD` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "URL of the HRUI switch web interface. Can also be set using the `HRUI_URL` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username for authentication. Can also be set using the `HRUI_USERNAME` environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "The HRUI Terraform Provider allows you to manage network switches made by HRUI (Shenzhen HongRui Optical Technology Co., Ltd) that have a Web UI.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "hrui_bandwidth_control": {
      "version": 0,
      "block": {
        "attributes": {
          "egress_rate": {
            "type": "string",
            "description": "Egress bandwidth rate in kbps. Use '0' or 'Unlimited' to disable limitation.",
            "description_kind": "plain",
            "required": true
          },
          "ingress_rate": {
            "type": "string",
            "description": "Ingress bandwidth rate in kbps. Use '0' or 'Unlimited' to disable limitation.",
            "description_kind": "plain",
            "required": true
          },
          "port": {
            "type": "string",
            "description": "Port where bandwidth control is configured (e.g., 'Port 1', 'Trunk2').",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Configures bandwidth control on a specific port.",
        "description_kind": "plain"
      }
    },
    "hrui_eee": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
