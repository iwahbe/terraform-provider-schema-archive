          "p2p": {
            "type": "string",
            "description": "Point-to-point (P2P) configuration:\n\n- **Valid values:** 'Auto', 'True', 'False'.\n- When set to 'Auto', the system automatically determines the P2P configuration based on the port's operation.\n- **Note:** Due to a known limitation in firmware version 1.9, changes to this attribute do not take effect.",
            "description_kind": "plain",
            "computed": true
          },
          "path_cost": {
            "type": "number",
            "description": "The desired STP path cost for the port.",
