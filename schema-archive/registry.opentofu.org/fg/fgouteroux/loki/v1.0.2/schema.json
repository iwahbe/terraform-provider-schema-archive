            "type": "string",
            "description": "Recording Rule group namespace",
            "description_kind": "plain",
            "optional": true
          },
          "org_id": {
            "type": "string",
            "description": "The Organization ID. If not set, the Org ID defined in the provider block will be used.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "rule": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "expr": {
                  "type": "string",
                  "description": "The LogQL expression to evaluate.",
                  "description_kind": "plain",
                  "required": true
                },
                "labels": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "Labels to add or overwrite before storing the result.",
                  "description_kind": "plain",
                  "optional": true
                },
                "record": {
                  "type": "string",
                  "description": "The name of the time series to output to.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "loki_rules": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "YAML content containing rule groups. Mutually exclusive with 'content_file'.",
            "description_kind": "plain",
            "optional": true
          },
          "content_file": {
            "type": "string",
            "description": "Path to YAML file containing rule groups. Mutually exclusive with 'content'.",
            "description_kind": "plain",
            "optional": true
          },
          "content_hash": {
            "type": "string",
            "description": "Hash of the rule configuration content",
            "description_kind": "plain",
            "computed": true
          },
          "groups": {
            "type": [
              "list",
              [
                "object",
                {
                  "alerting_rules_count": "number",
                  "interval": "string",
                  "name": "string",
                  "recording_rules_count": "number",
                  "rules_count": "number"
                }
              ]
            ],
            "description": "Details of all managed rule groups",
            "description_kind": "plain",
            "computed": true
          },
          "groups_count": {
            "type": "number",
            "description": "Number of rule groups managed by this resource",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ignore_groups": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of rule group names to ignore from the content. Useful when you want to manage most groups but exclude specific ones.",
            "description_kind": "plain",
            "optional": true
          },
          "managed_groups": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of rule group names actually managed by this resource",
            "description_kind": "plain",
            "computed": true
          },
          "namespace": {
            "type": "string",
            "description": "The namespace for the rule groups",
            "description_kind": "plain",
            "required": true
          },
          "only_groups": {
            "type": [
              "set",
              "string"
            ],
            "description": "Explicit list of rule group names to manage. If not specified, all groups in the content will be managed. Use this to manage only specific groups from a larger YAML file.",
            "description_kind": "plain",
            "optional": true
          },
          "org_id": {
            "type": "string",
            "description": "The Organization ID. If not set, the Org ID defined in the provider block will be used.",
            "description_kind": "plain",
            "optional": true
          },
          "rule_names": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of all rule names actually managed by this resource",
            "description_kind": "plain",
            "computed": true
          },
          "total_rules": {
            "type": "number",
            "description": "Total number of rules across all managed groups",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages multiple Loki rule groups within a namespace. \n\t\tThis resource is designed to handle YAML files containing multiple rule groups. \n\t\tEach rule group is managed individually via the Loki API, but they are tracked \n\t\ttogether as a single Terraform resource for easier bulk management.",
        "description_kind": "plain"
      }
    }
  },
