{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "ca": {
          "type": "string",
          "description": "Client ca for client authentication",
          "description_kind": "plain",
          "optional": true
        },
        "cert": {
          "type": "string",
          "description": "Client cert for client authentication",
          "description_kind": "plain",
          "optional": true
        },
        "debug": {
          "type": "bool",
          "description": "Enable debug mode to trace requests executed.",
          "description_kind": "plain",
          "optional": true
        },
        "headers": {
          "type": [
            "map",
            "string"
          ],
          "description": "A map of header names and values to set on all outbound requests.",
          "description_kind": "plain",
          "optional": true
        },
        "insecure": {
          "type": "bool",
          "description": "When using https, this disables TLS verification of the host.",
          "description_kind": "plain",
          "optional": true
        },
        "key": {
          "type": "string",
          "description": "Client key for client authentication",
          "description_kind": "plain",
          "optional": true
        },
        "org_id": {
          "type": "string",
          "description": "The default organization id to operate on within loki. For resources that have an org_id attribute, the resource-level attribute has priority. May alternatively be set via the LOKI_ORG_ID environment variable.",
          "description_kind": "plain",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "When set, will use this password for BASIC auth to the API.",
          "description_kind": "plain",
          "optional": true
        },
        "proxy_url": {
          "type": "string",
          "description": "URL to the proxy to be used for all API requests",
          "description_kind": "plain",
          "optional": true
        },
        "timeout": {
          "type": "number",
          "description": "When set, will cause requests taking longer than this time (in seconds) to be aborted.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "When set, will use this token for Bearer auth to the API.",
          "description_kind": "plain",
          "optional": true
        },
        "uri": {
          "type": "string",
          "description": "loki base url",
          "description_kind": "plain",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "When set, will use this username for BASIC auth to the API.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "block_types": {
        "aws_sigv4": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "region": {
                "type": "string",
                "description": "AWS region for signing requests. Defaults to AWS_REGION or AWS_DEFAULT_REGION environment variable.",
                "description_kind": "plain",
                "optional": true
              },
              "service": {
                "type": "string",
                "description": "AWS service name for signing. Defaults to 'execute-api' for API Gateway.",
                "description_kind": "plain",
                "optional": true
              }
            },
            "description": "AWS Signature Version 4 authentication configuration. When configured, requests will be signed using AWS credentials from the default credential chain (environment variables, shared credentials file, IAM role, etc.).",
            "description_kind": "plain"
          },
          "max_items": 1
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "loki_rule_group_alerting": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "interval": {
            "type": "string",
            "description": "Alerting Rule group interval",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Alerting Rule group name",
            "description_kind": "plain",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "Alerting Rule group namespace",
            "description_kind": "plain",
            "optional": true
          },
          "org_id": {
            "type": "string",
            "description": "The Organization ID. If not set, the Org ID defined in the provider block will be used.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "rule": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "alert": {
                  "type": "string",
                  "description": "The name of the alert.",
                  "description_kind": "plain",
                  "required": true
                },
                "annotations": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "Annotations to add to each alert.",
                  "description_kind": "plain",
                  "optional": true
                },
                "expr": {
                  "type": "string",
                  "description": "The LogQL expression to evaluate.",
                  "description_kind": "plain",
                  "required": true
                },
                "for": {
                  "type": "string",
                  "description": "The duration for which the condition must be true before an alert fires.",
                  "description_kind": "plain",
                  "optional": true
                },
                "labels": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "Labels to add or overwrite for each alert.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "loki_rule_group_recording": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
