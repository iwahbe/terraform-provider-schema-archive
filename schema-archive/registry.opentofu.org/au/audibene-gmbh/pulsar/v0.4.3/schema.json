    "pulsar_sink": {
      "version": 0,
      "block": {
        "attributes": {
          "archive": {
            "type": "string",
            "description": "Path to the archive file for the sink. It also supports url-path [http/https/file (file protocol assumes that file already exists on worker host)] from which worker can download the package",
            "description_kind": "plain",
            "required": true
          },
          "auto_ack": {
            "type": "bool",
            "description": "Whether or not the framework will automatically acknowledge messages",
            "description_kind": "plain",
            "required": true
          },
          "classname": {
            "type": "string",
            "description": "The sink's class name if archive is file-url-path (file://)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "cleanup_subscription": {
            "type": "bool",
            "description": "Whether the subscriptions the functions created/used should be deleted when the functions was deleted",
            "description_kind": "plain",
            "required": true
          },
          "configs": {
            "type": "string",
            "description": "User defined configs key/values (JSON string)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "cpu": {
            "type": "number",
            "description": "The CPU that needs to be allocated per sink instance (applicable only to Docker runtime)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "custom_runtime_options": {
            "type": "string",
            "description": "A string that encodes options to customize the runtime",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "custom_schema_inputs": {
            "type": [
              "map",
              "string"
            ],
            "description": "The map of input topics to Schema types or class names (as a JSON string)",
            "description_kind": "plain",
            "optional": true
          },
          "custom_serde_inputs": {
            "type": [
              "map",
              "string"
            ],
            "description": "The map of input topics to SerDe class names (as a JSON string)",
            "description_kind": "plain",
            "optional": true
          },
          "dead_letter_topic": {
            "type": "string",
            "description": "Name of the dead topic where the failing messages will be sent",
            "description_kind": "plain",
            "optional": true
          },
          "disk_mb": {
            "type": "number",
            "description": "The disk that need to be allocated per sink instance (applicable only to Docker runtime)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "inputs": {
            "type": [
              "set",
              "string"
            ],
            "description": "The sink's input topics",
            "description_kind": "plain",
            "optional": true
          },
          "max_redeliver_count": {
            "type": "number",
            "description": "Maximum number of times that a message will be redelivered before being sent to the dead letter topic",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The sink's name",
            "description_kind": "plain",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "The sink's namespace",
            "description_kind": "plain",
            "required": true
          },
          "negative_ack_redelivery_delay_ms": {
            "type": "number",
            "description": "The negative ack message redelivery delay in milliseconds",
            "description_kind": "plain",
            "optional": true
          },
          "parallelism": {
            "type": "number",
            "description": "The sink's parallelism factor",
            "description_kind": "plain",
            "optional": true
          },
          "processing_guarantees": {
            "type": "string",
            "description": "Define the message delivery semantics, default to ATLEAST_ONCE (ATLEAST_ONCE, ATMOST_ONCE, EFFECTIVELY_ONCE)",
            "description_kind": "plain",
            "optional": true
          },
          "ram_mb": {
            "type": "number",
            "description": "The RAM that need to be allocated per sink instance (applicable only to the process and Docker runtimes)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "retain_key_ordering": {
            "type": "bool",
            "description": "Sink consumes and processes messages in key order",
            "description_kind": "plain",
            "optional": true
          },
          "retain_ordering": {
            "type": "bool",
            "description": "Sink consumes and sinks messages in order",
            "description_kind": "plain",
            "optional": true
          },
          "secrets": {
            "type": "string",
            "description": "The map of secretName to an object that encapsulates how the secret is fetched by the underlying secrets provider",
            "description_kind": "plain",
            "optional": true
          },
          "sink_type": {
            "type": "string",
            "description": "The sinks's connector provider",
            "description_kind": "plain",
            "optional": true
          },
          "subscription_name": {
            "type": "string",
            "description": "Pulsar source subscription name if user wants a specific subscription-name for input-topic consumer",
            "description_kind": "plain",
            "optional": true
          },
          "subscription_position": {
            "type": "string",
            "description": "Pulsar source subscription position if user wants to consume messages from the specified location (Latest, Earliest). Default to Earliest.",
            "description_kind": "plain",
            "optional": true
          },
          "tenant": {
            "type": "string",
            "description": "The sink's tenant",
            "description_kind": "plain",
            "required": true
          },
          "timeout_ms": {
            "type": "number",
            "description": "The message timeout in milliseconds",
            "description_kind": "plain",
            "optional": true
          },
          "topics_pattern": {
            "type": "string",
            "description": "TopicsPattern to consume from list of topics under a namespace that match the pattern",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "input_specs": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "is_regex_pattern": {
                  "type": "bool",
                  "description_kind": "plain",
                  "required": true
                },
                "key": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "receiver_queue_size": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "schema_type": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "serde_class_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "The map of input topics specs",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
