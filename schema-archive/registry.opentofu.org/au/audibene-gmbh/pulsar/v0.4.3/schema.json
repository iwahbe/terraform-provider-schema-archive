            "description_kind": "plain",
            "optional": true
          },
          "cleanup_subscription": {
            "type": "bool",
            "description": "Whether to clean up subscription when the function is deleted.",
            "description_kind": "plain",
            "optional": true
          },
          "cpu": {
            "type": "number",
            "description": "The CPU that needs to be allocated per function instance",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "custom_runtime_options": {
            "type": "string",
            "description": "The custom runtime options of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "custom_schema_inputs": {
            "type": [
              "map",
              "string"
            ],
            "description": "The custom schema inputs of the function.",
