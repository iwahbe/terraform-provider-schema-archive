{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_version": {
          "type": "string",
          "description": "Api Version to be used for the pulsar admin interaction",
          "description_kind": "plain",
          "optional": true
        },
        "audience": {
          "type": "string",
          "description": "The OAuth 2.0 resource server identifier for the Pulsar cluster",
          "description_kind": "plain",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "The OAuth 2.0 client identifier",
          "description_kind": "plain",
          "optional": true
        },
        "issuer_url": {
          "type": "string",
          "description": "The OAuth 2.0 URL of the authentication provider which allows the Pulsar client to obtain an access token",
          "description_kind": "plain",
          "optional": true
        },
        "key_file_path": {
          "type": "string",
          "description": "The path of the private key file",
          "description_kind": "plain",
          "optional": true
        },
        "scope": {
          "type": "string",
          "description": "The OAuth 2.0 scope(s) to request",
          "description_kind": "plain",
          "optional": true
        },
        "tls_allow_insecure_connection": {
          "type": "bool",
          "description": "Boolean flag to accept untrusted TLS certificates",
          "description_kind": "plain",
          "optional": true
        },
        "tls_cert_file_path": {
          "type": "string",
          "description": "Path to the cert to use when using TLS client authentication",
          "description_kind": "plain",
          "optional": true
        },
        "tls_key_file_path": {
          "type": "string",
          "description": "Path to the key to use when using TLS client authentication",
          "description_kind": "plain",
          "optional": true
        },
        "tls_trust_certs_file_path": {
          "type": "string",
          "description": "Path to a custom trusted TLS certificate file",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Authentication Token used to grant terraform permissions to modify Apace Pulsar Entities",
          "description_kind": "plain",
          "optional": true
        },
        "web_service_url": {
          "type": "string",
          "description": "Web service url is used to connect to your apache pulsar cluster",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "pulsar_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster": {
            "type": "string",
