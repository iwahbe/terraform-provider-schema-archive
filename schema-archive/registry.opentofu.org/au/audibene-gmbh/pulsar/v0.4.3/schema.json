            "optional": true
          },
          "custom_schema_outputs": {
            "type": [
              "map",
              "string"
            ],
            "description": "The custom schema outputs of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "custom_serde_inputs": {
            "type": [
              "map",
              "string"
            ],
            "description": "The custom serde inputs of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "dead_letter_topic": {
            "type": "string",
            "description": "The dead letter topic of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "disk_mb": {
            "type": "number",
            "description": "The disk that need to be allocated per function instance",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "forward_source_message_property": {
            "type": "bool",
            "description": "Whether to forward source message property to the function output message.",
            "description_kind": "plain",
            "optional": true
          },
          "go": {
