            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "cluster_data": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "broker_service_url": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "broker_service_url_tls": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "peer_clusters": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "web_service_url": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "web_service_url_tls": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Specific configs of this cluster",
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "pulsar_function": {
      "version": 0,
      "block": {
        "attributes": {
          "auto_ack": {
