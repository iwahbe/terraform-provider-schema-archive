            "description_kind": "plain",
            "optional": true
          },
          "inputs": {
            "type": [
              "set",
              "string"
            ],
            "description": "The input topics of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "jar": {
            "type": "string",
            "description": "The path to the jar file.",
            "description_kind": "plain",
            "optional": true
          },
          "log_topic": {
            "type": "string",
            "description": "The log topic of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "max_message_retries": {
            "type": "number",
            "description": "The maximum number of times that a message will be retried when the function is configured with `EFFECTIVELY_ONCE` processing guarantees.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the function.",
            "description_kind": "plain",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "The namespace of the function.",
            "description_kind": "plain",
            "required": true
          },
          "output": {
            "type": "string",
            "description": "The output topic of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "output_schema_type": {
            "type": "string",
            "description": "The output schema type of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "output_serde_classname": {
            "type": "string",
            "description": "The output serde class name of the function. ",
            "description_kind": "plain",
            "optional": true
          },
          "output_type_classname": {
            "type": "string",
            "description": "The output type class name of the function. ",
            "description_kind": "plain",
            "optional": true
          },
          "parallelism": {
            "type": "number",
            "description": "The parallelism of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "processing_guarantees": {
            "type": "string",
            "description": "The processing guarantees (aka delivery semantics) applied to the function. Possible values are `ATMOST_ONCE`, `ATLEAST_ONCE`, and `EFFECTIVELY_ONCE`.",
            "description_kind": "plain",
            "optional": true
          },
          "py": {
            "type": "string",
            "description": "The path to the python file.",
            "description_kind": "plain",
            "optional": true
          },
          "ram_mb": {
            "type": "number",
            "description": "The RAM that need to be allocated per function instance",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "retain_key_ordering": {
            "type": "bool",
            "description": "Whether to retain key ordering when the function is restarted after failure.",
            "description_kind": "plain",
            "optional": true
          },
          "retain_ordering": {
            "type": "bool",
            "description": "Whether to retain ordering when the function is restarted after failure.",
            "description_kind": "plain",
            "optional": true
          },
          "secrets": {
            "type": "string",
            "description": "The secrets of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "skip_to_latest": {
            "type": "bool",
            "description": "Whether to skip to the latest position when the function is restarted after failure.",
            "description_kind": "plain",
            "optional": true
          },
          "subscription_name": {
            "type": "string",
            "description": "The subscription name of the function.",
            "description_kind": "plain",
            "optional": true
          },
          "subscription_position": {
            "type": "string",
            "description": "The subscription position of the function. Possible values are `LATEST`, `EARLIEST`, and `CUSTOM`.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tenant": {
            "type": "string",
            "description": "The tenant of the function.",
            "description_kind": "plain",
            "required": true
          },
          "timeout_ms": {
            "type": "number",
            "description": "The timeout of the function in milliseconds.",
            "description_kind": "plain",
            "optional": true
          },
          "topics_pattern": {
            "type": "string",
            "description": "The input topics pattern of the function. The pattern is a regex expression. The function consumes from all topics matching the pattern.",
            "description_kind": "plain",
            "optional": true
          },
          "user_config": {
            "type": [
              "map",
              "string"
            ],
            "description": "User-defined config key/values",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
