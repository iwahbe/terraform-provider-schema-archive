                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Custom field option name.",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "Custom field option value.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Required and presented for a custom ticket field of type \"multiselect\" or \"tagger\".",
