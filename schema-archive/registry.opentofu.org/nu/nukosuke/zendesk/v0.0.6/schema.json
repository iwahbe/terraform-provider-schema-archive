{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "account": {
          "type": "string",
          "description": "Account name of your Zendesk instance.",
          "description_kind": "plain",
          "optional": true
        },
        "email": {
          "type": "string",
          "description": "Email address of agent user who have permission to access the API.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "[API token](https://developer.zendesk.com/rest_api/docs/support/introduction#api-token) for your Zendesk instance.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "zendesk_attachment": {
      "version": 0,
      "block": {
        "attributes": {
          "content_type": {
            "type": "string",
            "description": "The content type of the image. Example value: \"image/png\"",
            "description_kind": "plain",
            "computed": true
          },
          "content_url": {
            "type": "string",
            "description": "A full URL where the attachment image file can be downloaded. The file may be hosted externally so take care not to inadvertently send Zendesk authentication credentials.",
            "description_kind": "plain",
            "computed": true
          },
          "file_hash": {
            "type": "string",
            "description": "SHA256 hash of the image file. Terraform built-in `filesha256()` is convenient to calculate it.",
            "description_kind": "plain",
            "required": true
          },
          "file_name": {
            "type": "string",
            "description": "The name of the image file.",
            "description_kind": "plain",
            "required": true
          },
          "file_path": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "inline": {
            "type": "bool",
            "description": "If true, the attachment is excluded from the attachment list and the attachment's URL can be referenced within the comment of a ticket. Default is false.",
            "description_kind": "plain",
            "computed": true
          },
          "size": {
            "type": "number",
            "description": "The size of the image file in bytes.",
            "description_kind": "plain",
            "computed": true
          },
          "thumbnails": {
            "type": [
              "set",
              [
                "object",
                {
                  "content_type": "string",
                  "content_url": "string",
                  "file_name": "string",
                  "id": "number",
                  "size": "number"
                }
              ]
            ],
            "description": "A list of attachments.",
            "description_kind": "plain",
            "computed": true
          },
          "token": {
            "type": "string",
            "description": "The token of the uploaded attachment.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provides an attachment resource.",
        "description_kind": "plain"
      }
    },
    "zendesk_automation": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Whether the automation is active.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "position": {
            "type": "number",
            "description": "The position of the automation which specifies the order it will be executed.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "title": {
            "type": "string",
            "description": "The title of the automation.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "action": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "field": {
                  "type": "string",
                  "description": "The name of a ticket field to modify.",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "The new value of the field.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "What the automation will do.",
              "description_kind": "plain"
            },
            "min_items": 1
          },
          "all": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "field": {
                  "type": "string",
                  "description": "The name of a ticket field.",
                  "description_kind": "plain",
                  "required": true
                },
                "operator": {
                  "type": "string",
                  "description": "A comparison operator.",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "The value of a ticket field.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Logical AND. All the conditions must be met.",
              "description_kind": "plain"
            }
          },
          "any": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "field": {
                  "type": "string",
                  "description": "The name of a ticket field.",
                  "description_kind": "plain",
                  "required": true
                },
                "operator": {
                  "type": "string",
                  "description": "A comparison operator.",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "The value of a ticket field.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Logical OR. Any condition can be met.",
              "description_kind": "plain"
            }
          }
        },
        "description": "Provides an automation resource.",
        "description_kind": "plain"
      }
    },
    "zendesk_brand": {
