{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "registry_auth": {
          "nested_type": {
            "attributes": {
              "password": {
                "type": "string",
                "description": "Password for the registry",
                "description_kind": "plain",
                "optional": true,
                "sensitive": true
              },
              "username": {
                "type": "string",
                "description": "Username for the registry",
                "description_kind": "plain",
                "optional": true
              }
            },
            "nesting_mode": "map"
          },
          "description": "A map of docker registries and their authentication credentials. Keys are registry endpoints (e.g., ECR proxy endpoint).",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dockerless_remote_image": {
      "version": 0,
      "block": {
        "attributes": {
          "digest": {
            "type": "string",
            "description": "The digest of the target docker image.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "source": {
            "type": "string",
            "description": "The docker image name and tag to source for pushing to the target image repository. \nCurrently, this docker image must be public or accessible using the same auth as the \"target\" image repository.",
            "description_kind": "markdown",
            "required": true
          },
          "target": {
            "type": "string",
            "description": "The docker image name and tag to ensure exists in an image repository.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "This resource pushes an image to a target docker image repository from a remote repository without using the docker daemon.",
        "description_kind": "markdown"
      }
    }
  }
}
