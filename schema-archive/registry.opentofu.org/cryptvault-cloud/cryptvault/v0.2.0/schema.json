            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "key of related value f.e.: VALUES.foo.bar",
            "description_kind": "markdown",
            "required": true
          },
          "passframe": {
            "type": "string",
            "description": "passframe of value",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "type": {
            "type": "string",
            "description": "passframe of value",
            "description_kind": "markdown",
            "required": true
          },
          "vault_id": {
            "type": "string",
            "description": "id of related vault",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Create a new Value (Passwort) by give name and password",
        "description_kind": "markdown"
      }
    },
    "cryptvault_cloud_vault": {
