{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "vault endpoint",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "cryptvault_cloud_identity": {
      "version": 0,
      "block": {
        "attributes": {
          "creator_key": {
            "type": "string",
            "description": "Private key of identity with rights to create new identities",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description": "Identity id",
            "description_kind": "markdown",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name for the new Identity",
            "description_kind": "markdown",
            "required": true
          },
          "public_key": {
            "type": "string",
            "description": "Public key of identity",
            "description_kind": "markdown",
            "required": true
          },
          "rights": {
            "nested_type": {
              "attributes": {
                "right_value_pattern": {
                  "type": "string",
                  "description": "\nPath to right point separated. \n\t\t\t\t\t\t\nHave to match /^\\((?P<directions>(r|w|d)+)\\)(?P<target>(VALUES|IDENTITY|SYSTEM))(?P<pattern>(\\.([\\w\\-]+|[>\\*]{1}))+)$/\n\nsome examples: \n\t- (rwd)VALUES.foo.bar\n\t- (rdw)VALUES.foo.>\n\t- (rwd)VALUES.>\n\t- (w)IDENTITY.>\n\t- (r)IDENTITY.>\n\t- (rd)VALUES.foo.*\n\nExplain: \n- r = read\n- w = write\n- d = delete\n- > = same area and deeper (next . split group)\n- * = same area but each possible string\n\t\t\t\t\t\t\t",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Permissions for this new Identity",
            "description_kind": "markdown",
            "required": true
          },
          "vault_id": {
            "type": "string",
            "description": "Vault id",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Create a new Identity",
        "description_kind": "markdown"
      }
    },
    "cryptvault_cloud_keypair": {
      "version": 0,
      "block": {
        "attributes": {
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "private_key": {
            "type": "string",
            "description": "Private key of identity",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "public_key": {
            "type": "string",
            "description": "Public key of identity",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "\nCreate a new KeyPair locally.\nIt P521 elliptic curve Keypair.\nYou can use them to create an Identity.\n",
        "description_kind": "markdown"
      }
    },
    "cryptvault_cloud_value": {
      "version": 0,
      "block": {
        "attributes": {
          "creator_key": {
            "type": "string",
            "description": "Private key of identity with rights to create new identities",
            "description_kind": "markdown",
