            "type": "string",
            "description": "Name for the new vault",
            "description_kind": "markdown",
            "required": true
          },
          "operator_id": {
            "type": "string",
            "description": "id of master identity",
            "description_kind": "markdown",
            "computed": true
          },
          "operator_name": {
