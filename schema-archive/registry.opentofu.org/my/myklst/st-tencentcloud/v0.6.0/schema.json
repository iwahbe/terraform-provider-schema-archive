{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "region": {
          "type": "string",
          "description": "Region for Tencent Cloud API. May also be provided via TENCENTCLOUD_REGION environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "secret_id": {
          "type": "string",
          "description": "Access Key for Tencent Cloud API. May also be provided via TENCENTCLOUD_SECRET_ID environment variable",
          "description_kind": "plain",
          "optional": true
        },
        "secret_key": {
          "type": "string",
          "description": "Secret key for Tencent Cloud API. May also be provided via TENCENTCLOUD_SECRET_KEY environment variable",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Tencent Cloud provider is used to interact with the many resources supported by Tencent Cloud. The provider needs to be configured with the proper credentials before it can be used.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "st-tencentcloud_cam_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "attached_policies": {
            "type": [
              "list",
              "string"
            ],
            "description": "The CAM policies to attach to the user.",
            "description_kind": "plain",
            "required": true
          },
          "attached_policies_detail": {
            "nested_type": {
              "attributes": {
                "policy_document": {
                  "type": "string",
                  "description": "The policy document of the CAM policy.",
                  "description_kind": "plain",
                  "computed": true
                },
                "policy_name": {
                  "type": "string",
                  "description": "The policy name.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "A list of policies. Used to compare whether policy has been changed outside of Terraform",
            "description_kind": "plain",
            "computed": true
          },
          "combined_policies_detail": {
            "nested_type": {
              "attributes": {
                "policy_document": {
                  "type": "string",
                  "description": "The policy document of the CAM policy.",
                  "description_kind": "plain",
                  "computed": true
                },
                "policy_name": {
                  "type": "string",
                  "description": "The policy name.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "A list of combined policies that are attached to users.",
            "description_kind": "plain",
            "computed": true
          },
          "user_id": {
            "type": "number",
            "description": "The id of the CAM user that attached to the policy.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Provides a CAM Policy resource that manages policy content exceeding character limits by splitting it into smaller segments. These segments are combined to form a complete policy attached to the user. However, the policy that exceed the maximum length of a policy, they will be attached directly to the user.",
        "description_kind": "plain"
      }
    },
    "st-tencentcloud_cam_user_group_attachment": {
      "version": 0,
      "block": {
        "attributes": {
          "group_id": {
            "type": "number",
            "description": "The ID of CAM group.",
            "description_kind": "plain",
            "required": true
          },
          "user_id": {
            "type": "number",
            "description": "The user ID of CAM group member.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Provides a TencentCloud CAM Group Membership resource.",
        "description_kind": "plain"
      }
    },
    "st-tencentcloud_cdn_path_based_rule": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain name.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "origin": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "origin_list": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of rule paths for origin.",
                  "description_kind": "plain",
                  "optional": true
                },
                "origin_type": {
                  "type": "string",
                  "description": "Domain name.",
                  "description_kind": "plain",
                  "optional": true
                },
                "server_name": {
                  "type": "string",
                  "description": "Server name.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "block_types": {
                "path_based_rule": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "origin": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "List of origin servers.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "rule_paths": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "List of rule paths for origin.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "rule_type": {
                        "type": "string",
                        "description": "Type of the rule for origin.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description_kind": "plain"
                  }
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Provides a TencentCloud Path-Based Rule resource.",
        "description_kind": "plain"
      }
    },
    "st-tencentcloud_enable_mfa_device": {
      "version": 0,
      "block": {
        "attributes": {
          "phone": {
            "type": "number",
            "description": "Set phone as login flag.",
            "description_kind": "plain",
            "required": true
          },
          "user_id": {
            "type": "number",
            "description": "The user ID of a Tencent Cloud user.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Sets the MFA flag for a Tencent Cloud user.",
        "description_kind": "plain"
      }
    }
  },
