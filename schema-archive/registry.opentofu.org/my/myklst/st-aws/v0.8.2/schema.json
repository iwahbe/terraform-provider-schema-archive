            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "client_config": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "access_key": {
                  "type": "string",
                  "description": "The access key that have permissions to list Cloudfront domains. Default to use access key configured in the provider.",
                  "description_kind": "plain",
                  "optional": true
                },
                "region": {
                  "type": "string",
                  "description": "The region of the Cloudfront domains. Default to use region configured in the provider.",
                  "description_kind": "plain",
                  "optional": true
                },
                "secret_key": {
                  "type": "string",
                  "description": "The secret key that have permissions to lsit Cloudfront domains. Default to use secret key configured in the provider.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Config to override default client created in Provider. This block will not be recorded in state file.",
              "description_kind": "plain"
            }
          }
        },
        "description": "Use this data source to retrieve information about a CloudFront distribution.",
        "description_kind": "plain"
      }
    },
