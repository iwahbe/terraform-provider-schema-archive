{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API key to use with the Octopus Deploy REST API. Can be set with the environment variable `OCTOPUSDEPLOY_API_KEY`",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "server_url": {
          "type": "string",
          "description": "The URL of the Octopus Deploy REST API. Can be set with the environment variable `OCTOPUSDEPLOY_SERVER_URL`",
          "description_kind": "markdown",
          "optional": true
        },
        "space_id": {
          "type": "string",
          "description": "The default space ID. Can be set with the environment variable `OCTOPUSDEPLOY_SPACE_ID`",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "octopusdeploy_tenant_connection": {
      "version": 0,
      "block": {
        "attributes": {
          "environment_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of applicable environments to connect",
            "description_kind": "markdown",
            "optional": true
          },
          "project_id": {
            "type": "string",
            "description": "ID of the project to connect",
            "description_kind": "markdown",
            "required": true
          },
          "tenant_id": {
            "type": "string",
            "description": "ID of the tenant to connect to",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "octopusdeploy_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the environment",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the environment",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "octopusdeploy_project": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the project",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the project in Octopus Deploy. This name must be unique",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "slug": {
            "type": "string",
            "description": "A human-readable, unique identifier, used to identify a project",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "octopusdeploy_tenant": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the tenant",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the tenant",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
