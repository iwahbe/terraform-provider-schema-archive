{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "address": {
          "type": "string",
          "description": "Set account 1password domain address (e.g: something.1password.com). Also `OP_ADDRESS` env var can be used.",
          "description_kind": "plain",
          "optional": true
        },
        "email": {
          "type": "string",
          "description": "Set account 1password email. Also `OP_EMAIL` env var can be used.",
          "description_kind": "plain",
          "optional": true
        },
        "fake_storage_path": {
          "type": "string",
          "description": "File to a path where the provider will store the data as if it is 1password (this is used only on development). Also `OP_FAKE_STORAGE_PATH` env var can be used.",
          "description_kind": "plain",
          "optional": true
        },
        "op_cli_path": {
          "type": "string",
          "description": "The path that points to the op cli binary. Also `OP_CLI_PATH` env var can be used. (by default `op` on system path, ignored if run in Terraform cloud).",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Set account 1password password. Also `OP_PASSWORD` env var can be used.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "secret_key": {
          "type": "string",
          "description": "Set account 1password secret key. Also `OP_SECRET_KEY` env var can be used.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "shorthand": {
          "type": "string",
          "description": "Set account 1password shorthand when 2FA is enabeled. Also `OP_SHORTHAND` env var can be used.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "onepasswordorg_group": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "The description of the group.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the group.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "\n    Provides a Group resource.\n\n    A 1password group is like a team that can contain people and can be used to give access to vaults as a\n    group of users.\n    ",
        "description_kind": "plain"
      }
    },
    "onepasswordorg_group_member": {
      "version": 0,
      "block": {
        "attributes": {
          "group_id": {
            "type": "string",
            "description": "The group ID.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "The role of the user on the group (can be `member` or `manager`, by default member).",
            "description_kind": "plain",
            "optional": true
          },
          "user_id": {
            "type": "string",
            "description": "The user ID.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "\nProvides a user and group membership.\n\nA 1password group membership will make a user part of a group with a role on that group.\n    ",
        "description_kind": "plain"
      }
    },
