{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "apply_retry_count": {
          "type": "number",
          "description": "Defines the number of attempts any create/update action will take",
          "description_kind": "plain",
          "optional": true
        },
        "client_certificate": {
          "type": "string",
          "description": "PEM-encoded client certificate for TLS authentication.",
          "description_kind": "plain",
          "optional": true
        },
        "client_key": {
          "type": "string",
          "description": "PEM-encoded client certificate key for TLS authentication.",
          "description_kind": "plain",
          "optional": true
        },
        "cluster_ca_certificate": {
          "type": "string",
          "description": "PEM-encoded root certificates bundle for TLS authentication.",
          "description_kind": "plain",
          "optional": true
        },
        "config_context": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "config_context_auth_info": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "config_context_cluster": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "config_path": {
          "type": "string",
          "description": "Path to the kube config file, defaults to ~/.kube/config",
          "description_kind": "plain",
          "optional": true
        },
        "config_paths": {
          "type": [
            "list",
            "string"
          ],
          "description": "A list of paths to kube config files. Can be set with KUBE_CONFIG_PATHS environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "The hostname (in form of URI) of Kubernetes master.",
          "description_kind": "plain",
          "optional": true
        },
        "insecure": {
          "type": "bool",
          "description": "Whether server should be accessed without verifying the TLS certificate.",
          "description_kind": "plain",
          "optional": true
        },
        "lazy_load": {
          "type": "bool",
          "description": "When true, kubeconfig resolution errors at provider-configure time are swallowed and the actual client is built lazily on first use. Lets `terraform plan` succeed when provider arguments (host, token, certs) are sourced from outputs of resources that have not been applied yet. Off by default; see Troubleshooting in the provider docs for trade-offs.",
          "description_kind": "plain",
          "optional": true
        },
        "load_config_file": {
          "type": "bool",
          "description": "Load local kubeconfig.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The password to use for HTTP basic authentication when accessing the Kubernetes master endpoint.",
          "description_kind": "plain",
          "optional": true
        },
        "proxy_url": {
          "type": "string",
          "description": "URL to the proxy to be used for all API requests",
          "description_kind": "plain",
          "optional": true
        },
        "tls_server_name": {
          "type": "string",
          "description": "Server name passed to the server for SNI and is used in the client to check server certificates against.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Token to authentifcate an service account",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "The username to use for HTTP basic authentication when accessing the Kubernetes master endpoint.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "block_types": {
        "exec": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "api_version": {
                "type": "string",
                "description_kind": "plain",
                "required": true
              },
              "args": {
                "type": [
                  "list",
                  "string"
                ],
                "description_kind": "plain",
                "optional": true
              },
              "command": {
                "type": "string",
                "description_kind": "plain",
                "required": true
              },
              "env": {
                "type": [
                  "map",
                  "string"
                ],
                "description_kind": "plain",
                "optional": true
              }
            },
            "description_kind": "plain"
          }
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "kubectl_manifest": {
      "version": 1,
      "block": {
        "attributes": {
          "api_version": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "apply_only": {
            "type": "bool",
            "description": "Apply only. In other words, it does not delete resource in any case.",
            "description_kind": "plain",
            "optional": true
          },
          "delete_cascade": {
            "type": "string",
            "description": "Cascade mode for delete operations, explicitly setting this to Background to match kubectl is recommended. Default is Background unless wait has been set when it will be Foreground.",
            "description_kind": "plain",
            "optional": true
          },
          "field_manager": {
            "type": "string",
            "description": "Override the default field manager name. This is only relevant when using server-side apply.",
            "description_kind": "plain",
            "optional": true
          },
          "force_conflicts": {
            "type": "bool",
            "description": "Default false.",
            "description_kind": "plain",
            "optional": true
          },
          "force_new": {
            "type": "bool",
            "description": "Default to update in-place. Setting to true will delete and create the kubernetes instead.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ignore_fields": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of yaml keys to ignore changes to. Set these for fields set by Operators or other processes in kubernetes and as such you don't want to update.",
            "description_kind": "plain",
            "optional": true
          },
          "kind": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "live_manifest_incluster": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "live_uid": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "namespace": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "override_namespace": {
            "type": "string",
            "description": "Override the namespace to apply the kubernetes resource to",
            "description_kind": "plain",
            "optional": true
          },
          "sensitive_fields": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of yaml keys with sensitive values. Set these for fields which you want obfuscated in the yaml_body output",
            "description_kind": "plain",
            "optional": true
          },
          "server_side_apply": {
            "type": "bool",
            "description": "Default to client-side-apply. Setting to true will use server-side apply.",
            "description_kind": "plain",
            "optional": true
          },
          "uid": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "upgrade_api_version": {
            "type": "bool",
            "description": "When true, changing the api_version in yaml_body will update the resource in-place rather than forcing a delete and recreate. This leverages Kubernetes' ability to represent the same object across multiple API versions.",
            "description_kind": "plain",
            "optional": true
          },
          "validate_schema": {
            "type": "bool",
            "description": "Default to true (validate). Set this flag to not validate the yaml schema before applying.",
            "description_kind": "plain",
            "optional": true
          },
          "wait": {
            "type": "bool",
            "description": "Default to false (not waiting). Set this flag to wait or not for any deleted resources to be gone. This waits for finalizers.",
            "description_kind": "plain",
            "optional": true
          },
          "wait_for_rollout": {
            "type": "bool",
            "description": "Default to true (waiting). Set this flag to wait or not for Deployments and APIService to complete rollout",
            "description_kind": "plain",
            "optional": true
          },
          "yaml_body": {
            "type": "string",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "yaml_body_parsed": {
            "type": "string",
            "description": "Yaml body that is being applied, with sensitive values obfuscated",
            "description_kind": "plain",
            "computed": true
          },
          "yaml_incluster": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          },
          "wait_for": {
            "nesting_mode": "list",
            "block": {
              "block_types": {
                "condition": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "status": {
                        "type": "string",
                        "description": "Status to wait for in the resulting Condition object",
                        "description_kind": "plain",
                        "required": true
                      },
                      "type": {
                        "type": "string",
                        "description": "Type as expected from the resulting Condition object",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "Condition criteria for a Status Condition",
                    "description_kind": "plain"
                  }
                },
                "field": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "key": {
                        "type": "string",
                        "description": "Key which should be matched from resulting object",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value": {
                        "type": "string",
                        "description": "Value to wait for",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value_type": {
                        "type": "string",
                        "description": "Value type. Can be either a `eq` (equivalent) or `regex`",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description": "Condition criteria for a field",
                    "description_kind": "plain"
                  }
                }
              },
              "description": "If set, will wait until either all of conditions are satisfied, or until timeout is reached",
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "kubectl_server_version": {
      "version": 0,
      "block": {
        "attributes": {
          "build_date": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "git_commit": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "git_version": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "major": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "minor": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "patch": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "platform": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "triggers": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "version": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "kubectl_file_documents": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "documents": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "manifests": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "kubectl_filename_list": {
      "version": 0,
      "block": {
        "attributes": {
          "basenames": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "matches": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "pattern": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "kubectl_manifest": {
      "version": 0,
      "block": {
        "attributes": {
          "api_version": {
            "type": "string",
            "description": "The API version of the resource to read (e.g. `v1`, `apps/v1`).",
            "description_kind": "plain",
            "required": true
          },
          "fields": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map of result-key to gojsonq dot-path expressions to extract from the fetched object (e.g. `replicas = \"spec.replicas\"`, `image = \"spec.template.spec.containers.[0].image\"`). Array indices use the `[N]` form, e.g. `containers.[0]`. Each path must resolve; missing paths produce an error.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "json": {
            "type": "string",
            "description": "The fetched object serialised as JSON.",
            "description_kind": "plain",
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "The Kind of the resource to read (e.g. `ConfigMap`, `Deployment`).",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The metadata.name of the resource to read.",
            "description_kind": "plain",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "The metadata.namespace of the resource. Leave empty for cluster-scoped kinds; for namespaced kinds an empty value defaults to `default`.",
            "description_kind": "plain",
            "optional": true
          },
          "results": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map of extracted field values keyed by the names declared in `fields`. Scalar values are stringified; objects and arrays are JSON-encoded.",
            "description_kind": "plain",
            "computed": true
          },
          "uid": {
            "type": "string",
            "description": "The metadata.uid of the fetched object.",
            "description_kind": "plain",
            "computed": true
          },
          "yaml": {
            "type": "string",
            "description": "The fetched object serialised as YAML.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Reads a single Kubernetes object from the cluster by apiVersion + kind + name (+ namespace) and optionally extracts user-supplied fields by dot-path. Outputs are not marked sensitive at the schema level; callers needing redaction should set `sensitive = true` on the consuming output block or wrap references with `sensitive(...)`. For guaranteed non-persistence to state, use the `kubectl_manifest` ephemeral resource instead.",
        "description_kind": "plain"
      }
    },
    "kubectl_path_documents": {
      "version": 0,
      "block": {
        "attributes": {
          "disable_template": {
            "type": "bool",
            "description": "Flag to disable template parsing of the loaded documents",
            "description_kind": "plain",
            "optional": true
          },
          "documents": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "manifests": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "pattern": {
            "type": "string",
            "description": "Glob pattern to search for",
            "description_kind": "plain",
            "required": true
          },
          "sensitive_vars": {
            "type": [
              "map",
              "string"
            ],
            "description": "Sensitive variables to substitute, allowing for hiding sensitive variables in terraform output",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "vars": {
            "type": [
              "map",
              "string"
            ],
            "description": "Variables to substitute",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "kubectl_server_version": {
      "version": 0,
      "block": {
        "attributes": {
          "build_date": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "git_commit": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "git_version": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "major": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "minor": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "patch": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "platform": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "version": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
