{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_url": {
          "type": "string",
          "description": "URL to Camunda SaaS API",
          "description_kind": "markdown",
          "optional": true
        },
        "audience": {
          "type": "string",
          "description": "Audience of the token",
          "description_kind": "markdown",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "Client ID to authenticate against Camunda SaaS",
          "description_kind": "markdown",
          "required": true
        },
        "client_secret": {
          "type": "string",
          "description": "Client Secret to authenticate against Camunda SaaS",
          "description_kind": "markdown",
          "required": true
        },
        "debug": {
          "type": "bool",
          "description": "Enable debug logs",
          "description_kind": "markdown",
          "optional": true
        },
        "token_url": {
          "type": "string",
          "description": "URL to fetch token from",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "camunda_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "channel": {
            "type": "string",
            "description": "Channel",
            "description_kind": "markdown",
            "required": true
          },
          "generation": {
            "type": "string",
            "description": "Generation",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Cluster ID",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the cluster",
            "description_kind": "markdown",
            "required": true
          },
          "plan_type": {
            "type": "string",
            "description": "Plan type",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "Region",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage a cluster on Camunda SaaS",
        "description_kind": "markdown"
      }
    },
    "camunda_cluster_client": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster ID",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Cluster Client ID",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the cluster client",
            "description_kind": "markdown",
            "required": true
          },
          "scopes": {
            "type": [
              "set",
              "string"
            ],
            "description": "The list of scopes the client will be valid for. It defaults to all the scopes, and at least one scope should be specified. Valid values:\n  * `Operate`\n  * `Optimize`\n  * `Tasklist`\n  * `Zeebe`\n",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "secret": {
            "type": "string",
            "description": "The client secret",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "zeebe_address": {
            "type": "string",
            "description": "Zeebe Address",
            "description_kind": "markdown",
            "computed": true
          },
          "zeebe_authorization_server_url": {
            "type": "string",
            "description": "Zeebe Authorization Server Url",
            "description_kind": "markdown",
            "computed": true
          },
          "zeebe_client_id": {
            "type": "string",
            "description": "Zeebe Client Id",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manage a cluster client on Camunda SaaS.",
        "description_kind": "markdown"
      }
    },
    "camunda_cluster_connector_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster ID",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Cluster Connector Secret Name",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "The value of the connector secret",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Manage a cluster connector secret on Camunda SaaS.",
        "description_kind": "markdown"
      }
    },
    "camunda_cluster_ip_whitelist": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster ID",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "ip_whitelist": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "A short description for this IP whitelist.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "ip": {
                  "type": "string",
                  "description": "The IP address/network to whitelist. Must be a valid IPv4 address/network (such as `10.0.0.1` or `172.42.0.0/24`)",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Manage IP whitelists of a Camunda cluster",
        "description_kind": "markdown"
      }
    },
    "camunda_organization_member": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "The email of the member",
            "description_kind": "markdown",
            "required": true
          },
          "roles": {
            "type": [
              "set",
              "string"
            ],
            "description": "The roles of this member in the organization. Must be one of: `admin`, `analyst`, `developer`, `operationsengineer`, `taskuser`, or `visitor`.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage a member of an organization",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "camunda_channel": {
      "version": 0,
      "block": {
        "attributes": {
          "allowed_generations": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "The ID of the generation",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the generation",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The allowed generations for this channel",
            "description_kind": "markdown",
            "computed": true
          },
          "default_generation_id": {
            "type": "string",
            "description": "The ID of the default generation for this channel",
            "description_kind": "markdown",
            "computed": true
          },
          "default_generation_name": {
            "type": "string",
            "description": "The name of the default generation for this channel",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the channel",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the channel",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "channel data source",
        "description_kind": "markdown"
      }
    },
    "camunda_cluster_plan_type": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the clusterPlanType",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the clusterPlanType",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "clusterPlanType data source",
        "description_kind": "markdown"
      }
    },
    "camunda_region": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the region",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the region",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "region data source",
        "description_kind": "markdown"
      }
    }
  }
}
