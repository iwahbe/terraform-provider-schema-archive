{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "codeowner_path": {
          "type": "string",
          "description": "Path to the CODEOWNERS file",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "codeowners_codeowner": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "owners": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of Codeowners",
            "description_kind": "markdown",
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Path to determine codeownership, this path is only measured relative to the root of the directory.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Codeowners will find the codeowners for the file at a path",
        "description_kind": "markdown"
      }
    }
  }
}
