{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "bootstrap_servers": {
          "type": [
            "list",
            "string"
          ],
          "description": "A list of Kafka brokers",
          "description_kind": "markdown",
          "required": true
        },
        "sasl": {
          "nested_type": {
            "attributes": {
              "enabled": {
                "type": "bool",
                "description": "Enable SASL Authentication",
                "description_kind": "markdown",
                "optional": true
              },
              "mechanism": {
                "type": "string",
                "description": "SASL mechanism to use. One of plain, scram-sha512, scram-sha256, aws-msk-iam (default: aws-msk-iam)",
                "description_kind": "markdown",
                "optional": true
              },
              "password": {
                "type": "string",
                "description": "Password for SASL authentication",
                "description_kind": "markdown",
                "optional": true,
                "sensitive": true
              },
              "username": {
                "type": "string",
                "description": "Username for SASL authentication",
                "description_kind": "markdown",
                "optional": true,
                "sensitive": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "SASL Authentication",
          "description_kind": "markdown",
          "optional": true
        },
        "timeout": {
          "type": "number",
          "description": "Timeout for provider operations in seconds (default: 300)",
          "description_kind": "markdown",
          "optional": true
        },
        "tls": {
          "nested_type": {
            "attributes": {
              "enabled": {
                "type": "bool",
                "description": "Enable TLS communication with Kafka brokers (default: true)",
                "description_kind": "markdown",
                "optional": true
              },
              "skip_verify": {
                "type": "bool",
                "description": "Skips TLS verification when connecting to the brokers (default: false)",
                "description_kind": "markdown",
                "optional": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "TLS Configuration",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "kafka_topic": {
      "version": 0,
      "block": {
        "attributes": {
          "configuration": {
            "type": [
              "map",
              "string"
            ],
            "description": "Configuration",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Topic id",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Topic name",
            "description_kind": "markdown",
            "required": true
          },
          "partitions": {
            "type": "number",
            "description": "Topic partitions count",
            "description_kind": "markdown",
            "required": true
          },
          "replication_factor": {
            "type": "number",
            "description": "Topic replication factor count",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Kafka Topic resource",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "kafka_topic": {
      "version": 0,
      "block": {
        "attributes": {
          "configuration": {
            "type": [
              "map",
              "string"
            ],
            "description": "Configuration version",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Topic name",
            "description_kind": "markdown",
            "required": true
          },
          "partitions": {
            "type": "number",
            "description": "Topic partitions count",
            "description_kind": "markdown",
            "computed": true
          },
          "replication_factor": {
            "type": "number",
            "description": "Topic replication factor",
            "description_kind": "markdown",
            "computed": true
          },
          "version": {
            "type": "number",
            "description": "Topic version",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Topic data source",
        "description_kind": "markdown"
      }
    }
  }
}
