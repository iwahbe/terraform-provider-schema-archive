            "description": "Content file for the account file type.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "folder_id": {
            "type": "number",
            "description": "Folder ID where the account is stored.",
            "description_kind": "plain",
            "required": true
          },
          "folder_name": {
            "type": "string",
            "description": "Name of the folder where the account is stored.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Unique identifier for the account",
            "description_kind": "plain",
            "computed": true
          },
          "ipaddress": {
            "type": "string",
            "description": "Address associated with the account.",
            "description_kind": "plain",
            "optional": true
          },
          "last_modified_date": {
            "type": "string",
            "description": "Date of last modification.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the account (filename if type file).",
