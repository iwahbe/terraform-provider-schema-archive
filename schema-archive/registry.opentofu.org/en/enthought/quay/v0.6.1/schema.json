            "description_kind": "markdown",
            "required": true
          },
          "reponame": {
            "type": "string",
            "description": "Repository name",
            "description_kind": "markdown",
            "required": true
          },
          "teamname": {
            "type": "string",
            "description": "Team name",
            "description_kind": "markdown",
            "required": true
