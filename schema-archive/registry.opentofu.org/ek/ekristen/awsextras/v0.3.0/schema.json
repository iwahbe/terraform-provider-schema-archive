{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "region": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "awsextras_remove_key_pairs": {
      "version": 0,
      "block": {
        "attributes": {
          "exclude_names": {
            "type": [
              "set",
              "string"
            ],
            "description": "exclude any of these key pair names",
            "description_kind": "plain",
            "optional": true
          },
          "exclude_regex": {
            "type": [
              "set",
              "string"
            ],
            "description": "exclude key pair by regex on key pair name",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "include_regex": {
            "type": [
              "set",
              "string"
            ],
            "description": "include key pair by regex matching on key pair name",
            "description_kind": "plain",
            "optional": true
          },
          "key_pair_names": {
            "type": [
              "set",
              "string"
            ],
            "description": "list of computed ssh key pair names remove",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "awsextras_secretsmanager_secret_rotation": {
      "version": 0,
      "block": {
        "attributes": {
          "automatically_after_days": {
            "type": "number",
            "description": "rotate the secret every N days",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "secret_id": {
            "type": "string",
            "description": "Secret ID",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "awsextras_terminate_instances": {
      "version": 0,
      "block": {
        "attributes": {
          "exclude_instance_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "known list of instance ids to treat as managed",
            "description_kind": "plain",
            "optional": true
          },
          "exclude_tags": {
            "type": [
              "set",
              "string"
            ],
            "description": "consider resources with tags as managed (ie kubernetes)",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "include_untagged": {
            "type": "bool",
            "description": "considered resources without tags to be unmanaged an should be terminated",
            "description_kind": "plain",
            "optional": true
          },
          "instance_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "list of computed instance ids to remove",
            "description_kind": "plain",
            "computed": true
          },
          "subnet_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "known list of subnet ids to look for Terminated ec2 instances",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
