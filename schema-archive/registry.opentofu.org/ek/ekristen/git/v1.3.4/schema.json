{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "git_repository": {
      "version": 0,
      "block": {
        "attributes": {
          "branch": {
            "type": "string",
            "description": "Branch Name",
            "description_kind": "markdown",
            "computed": true
          },
          "commit_count": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "has_tag": {
            "type": "bool",
            "description": "Whether or not the current reference has been tagged",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "id",
            "description_kind": "markdown",
            "computed": true
          },
          "is_branch": {
            "type": "bool",
            "description": "Whether or not the current reference is a branch",
            "description_kind": "markdown",
            "computed": true
          },
          "is_dirty": {
            "type": "bool",
            "description": "Whether or not the repository is in a dirty state",
            "description_kind": "markdown",
            "computed": true
          },
          "is_remote": {
            "type": "bool",
            "description": "Is the reference a remote",
            "description_kind": "markdown",
            "computed": true
          },
          "is_tag": {
            "type": "bool",
            "description": "Whether or not the current reference is a tag",
            "description_kind": "markdown",
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Path to Git Repository",
            "description_kind": "markdown",
            "required": true
          },
          "ref": {
            "type": "string",
            "description": "Current reference of the repository",
            "description_kind": "markdown",
            "computed": true
          },
          "ref_short": {
            "type": "string",
            "description": "Short version of the current reference",
            "description_kind": "markdown",
            "computed": true
          },
          "ref_short_length": {
            "type": "number",
            "description": "Length of the short version of the current reference (default: 7)",
            "description_kind": "markdown",
            "optional": true
          },
          "semver": {
            "type": "string",
            "description": "Git Summary in SEMVER format",
            "description_kind": "markdown",
            "computed": true
          },
          "semver_fallback_tag": {
            "type": "string",
            "description": "Fallback Tag for SEMVER Generation",
            "description_kind": "markdown",
            "optional": true
          },
          "summary": {
            "type": "string",
            "description": "Git Summary",
            "description_kind": "markdown",
            "computed": true
          },
          "tag": {
            "type": "string",
            "description": "Current Tag of Repository",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Git Repository data source",
        "description_kind": "markdown"
      }
    }
  }
}
