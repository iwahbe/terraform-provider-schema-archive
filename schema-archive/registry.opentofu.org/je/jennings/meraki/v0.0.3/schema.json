{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Meraki API key. This can also be sourced from the `MERAKI_API_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "host": {
          "type": "string",
          "description": "Host name of the Meraki API. Defaults to `api.meraki.com`. This can also be sourced from the `MERAKI_HOST` environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "meraki_network": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the network",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the network.",
            "description_kind": "markdown",
            "required": true
          },
          "organization_id": {
            "type": "string",
            "description": "Organization ID to add the HTTP server.",
            "description_kind": "markdown",
            "required": true
          },
          "product_types": {
            "type": [
              "set",
              "string"
            ],
            "description": "Product types. Possible values are: wireless, appliance, switch, systemsManager, camera, cellularGateway, sensor, environmental.",
            "description_kind": "markdown",
            "required": true
          },
          "tags": {
            "type": [
              "set",
              "string"
            ],
            "description": "Tags",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a Meraki network.",
        "description_kind": "markdown"
      }
    },
    "meraki_network_webhook_httpserver": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the HTTP server",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the HTTP server.",
            "description_kind": "markdown",
            "required": true
          },
          "network_id": {
            "type": "string",
            "description": "Network ID to add the HTTP server.",
            "description_kind": "markdown",
            "required": true
          },
          "payload_template_id": {
            "type": "string",
            "description": "Payload template ID to send. Defaults to wpt_00001",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "shared_secret": {
            "type": "string",
            "description": "Optional shared secret that can be used in the payload template to authenticate the request.",
            "description_kind": "markdown",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "URL that will receive the webhook.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages an HTTP Server registered to receive webhooks for a network.",
        "description_kind": "markdown"
      }
    }
  },
