            "required": true
          },
          "project_number": {
            "type": "number",
            "description": "GCP Project Number",
            "description_kind": "markdown",
            "required": true
          },
          "service_account_email": {
            "type": "string",
            "description": "GCP Service Account Email",
            "description_kind": "markdown",
            "required": true
          },
          "team": {
            "type": "string",
            "description": "The ID of the owning Team",
            "description_kind": "markdown",
            "required": true
          },
          "workload_identity_pool_id": {
            "type": "string",
            "description": "GCP Workload Identity Pool ID",
            "description_kind": "markdown",
            "required": true
          },
          "workload_identity_pool_provider_id": {
            "type": "string",
            "description": "GCP Workload Identity Pool Provider ID",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Configure a GCP Cloud Provider integration with Workload Identity Federation",
        "description_kind": "markdown"
      }
    },
    "tlspc_cloudprovider_gcp_validate": {
      "version": 0,
      "block": {
        "attributes": {
          "cloudprovider_id": {
            "type": "string",
