{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "apikey": {
          "type": "string",
          "description": "API Key. Required unless specified by setting the environment variable `TLSPC_APIKEY`",
          "description_kind": "markdown",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "TLSPC API Endpoint",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "\n## Provider for the Venafi TLS Protect Cloud Platform\n\nThis provider allows you to manage resources within the Venafi TLS Protect Cloud Platform.\nIt's at an early stage of development; for production workloads, please ensure that versions are locked and upgrades considered to avoid breaking changes.\n\n### Usage\n\nWe recommend that you create a custom user with the [permissions required](https://docs.venafi.cloud/vaas/user-management/about-user-roles/) to manage the necessary resources, and use this user for performing terraform operations.\n",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "tlspc_application": {
      "version": 0,
      "block": {
        "attributes": {
          "ca_template_aliases": {
            "type": [
              "map",
              "string"
            ],
            "description": "CA Template alias-to-id mapping for templates available to this application, see example for format",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of this resource",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the application",
            "description_kind": "markdown",
            "required": true
          },
          "owners": {
            "type": [
              "set",
              [
                "map",
                "string"
              ]
            ],
            "description": "A map of owner ids, see example for format",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "tlspc_certificate_template": {
      "version": 0,
      "block": {
        "attributes": {
          "ca_product_id": {
            "type": "string",
            "description": "The ID of a Certificate Authority Product Option",
            "description_kind": "markdown",
            "required": true
          },
          "ca_type": {
            "type": "string",
            "description": "Type of Certificate Authority (see Certificate Authority Product Option data source)",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "key_reuse": {
            "type": "bool",
            "description": "Allow Private Key Reuse",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Certificate Issuing Template",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage Certificate Issuing Template\n\n-> Currently only a limited subset of attributes are supported. All Common Name/SAN/CSR validation fields are set to `.*` (allow all). Permitted Key Algorithms are set to RSA 2048/3072/4096.",
        "description_kind": "markdown"
      }
    },
    "tlspc_cloudprovider_gcp": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
