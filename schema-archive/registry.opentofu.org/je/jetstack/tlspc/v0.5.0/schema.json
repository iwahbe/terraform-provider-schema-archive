    "tlspc_plugin": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "manifest": {
            "type": "string",
            "description": "JSON string of a plugin manifest",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of plugin, e.g. `CA` or `MACHINE`",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage the installed plugins for a TLS Protect Cloud tenant.\n\nSee the [API Documentation](https://developer.venafi.com/tlsprotectcloud/reference/post-v1-plugins) for guidance.\nThe manifest attribute should be a json string which meets the specification of the manifest object.\n\nFor an example, see the [DigiCert CA Connector](https://github.com/Venafi/digicert-ca-connector/blob/main/manifest.json).\nThis would additionally need a deployment block to meet the required specification, and specify the image location:\n```\n\"deployment\": {\n\t\"executionTarget\": \"vsat\",\n\t\"image\": \"org/image:v0.1.0\"\n}\n```",
        "description_kind": "markdown"
      }
