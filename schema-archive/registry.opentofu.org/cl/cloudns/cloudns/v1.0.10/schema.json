{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "auth_id": {
          "type": "number",
          "description": "When using api users, this is the `auth-id`. It is read from the environment variable `CLOUDNS_AUTH_ID` if not passed explicitly. Mutually exclusive with `sub_auth_id`.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "password": {
          "type": "string",
          "description": "This is the password associated with your auth-id or sub-auth-id. It is read from the environment variable `CLOUDNS_PASSWORD` if not passed explicitly.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "rate_limit": {
          "type": "number",
          "description": "Underlying rate limit (in API calls per second) to observe while interacting with ClouDNS. Defaults to 5 requests per second.",
          "description_kind": "markdown",
          "optional": true
        },
        "sub_auth_id": {
          "type": "number",
          "description": "When using api sub-users, this is the `sub-auth-id`. It is read from the environment variable `CLOUDNS_SUB_AUTH_ID` if not passed explicitly. Mutually exclusive with `auth_id`.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "cloudns_dns_failover": {
      "version": 0,
      "block": {
        "attributes": {
          "backupip1": {
            "type": "string",
            "description": "First Backup IP address.",
            "description_kind": "markdown",
            "optional": true
          },
          "backupip2": {
            "type": "string",
            "description": "Second Backup IP address.",
            "description_kind": "markdown",
            "optional": true
          },
          "backupip3": {
            "type": "string",
            "description": "Third Backup IP address.",
            "description_kind": "markdown",
            "optional": true
          },
          "backupip4": {
            "type": "string",
            "description": "Fourth Backup IP address.",
            "description_kind": "markdown",
            "optional": true
          },
          "backupip5": {
            "type": "string",
            "description": "Fifth Backup IP address.",
            "description_kind": "markdown",
            "optional": true
          },
          "checkperiod": {
            "type": "string",
            "description": "Time-frame between each monitoring check.",
            "description_kind": "markdown",
            "optional": true
          },
          "checkregion": {
            "type": "string",
            "description": "The region from which the check is monitored(it is only received from API)",
            "description_kind": "markdown",
            "optional": true
          },
          "checktype": {
            "type": "string",
            "description": "Monitoring check types for this Failover.",
            "description_kind": "markdown",
            "required": true
          },
          "content": {
            "type": "string",
            "description": "Parameter required for Custom HTTP and Custom HTTPS check types",
            "description_kind": "markdown",
            "optional": true
          },
          "domain": {
            "type": "string",
            "description": "The name of the DNS zone.",
            "description_kind": "markdown",
            "required": true
          },
          "downeventhandler": {
            "type": "string",
            "description": "Event handler if Main IP is down.",
            "description_kind": "markdown",
            "optional": true
          },
          "host": {
            "type": "string",
            "description": "A host to query.",
            "description_kind": "markdown",
            "optional": true
          },
          "httprequesttype": {
            "type": "string",
            "description": "Only for HTTP/S checks. The request type will be used for the check. The default value is GET. Possible values:",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "latencylimit": {
            "type": "string",
            "description": "Only for Ping monitoring checks. If the latency of the check is above the limit, the check will be marked as DOWN.",
            "description_kind": "markdown",
            "optional": true
          },
          "mainip": {
            "type": "string",
            "description": "Main IP address which will be monitored.",
            "description_kind": "markdown",
            "required": true
          },
          "monitoringregion": {
            "type": "string",
            "description": "Monitoring region or country.",
            "description_kind": "markdown",
            "optional": true
          },
          "notificationmail": {
            "type": "string",
            "description": "Email notifications settings.",
            "description_kind": "markdown",
            "optional": true
          },
          "path": {
            "type": "string",
            "description": "Path for the URL",
            "description_kind": "markdown",
            "optional": true
          },
          "port": {
            "type": "string",
            "description": "A port to query.",
            "description_kind": "markdown",
            "optional": true
          },
          "queryresponse": {
            "type": "string",
            "description": "Parameter required for DNS check type. You must fill in the response of the DNS server for this specific record.",
            "description_kind": "markdown",
            "optional": true
          },
          "querytype": {
            "type": "string",
            "description": "Parameter required for DNS check type. It must contain the record type (e.g. A).",
            "description_kind": "markdown",
            "optional": true
          },
          "recordid": {
            "type": "string",
            "description": "The ID of the record for which the failover to be activated / the same as the id param",
            "description_kind": "markdown",
            "required": true
          },
          "timeout": {
            "type": "string",
            "description": "Only for Ping monitoring checks. Seconds to wait for a response. Must be between 1 and 5. Default value is 2.",
            "description_kind": "markdown",
            "optional": true
          },
          "upeventhandler": {
            "type": "string",
            "description": "Event handler if Main IP is up.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "A DNS failover record managed by ClouDNS.",
        "description_kind": "markdown"
      }
    },
    "cloudns_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "algorithm": {
            "type": "number",
            "description": "Algorithm used to create the SSHFP fingerprint. Required for SSHFP records only.",
            "description_kind": "markdown",
            "optional": true
          },
          "altitude": {
            "type": "string",
            "description": "A numeric value(-100000.00 - 42849672.95), sets the altitude in meters.",
            "description_kind": "markdown",
            "optional": true
          },
          "caaflag": {
            "type": "string",
            "description": "0 - Non critical or 128 - Critical",
            "description_kind": "markdown",
            "optional": true
          },
          "caatype": {
            "type": "string",
            "description": "Type of CAA record. The available flags are issue, issuewild, iodef.",
            "description_kind": "markdown",
            "optional": true
          },
          "caavalue": {
            "type": "string",
            "description": "Value of the CAA record.",
            "description_kind": "markdown",
            "optional": true
          },
          "certalgorithm": {
            "type": "number",
            "description": "Identifies the algorithm used to produce a legitimate signature.",
            "description_kind": "markdown",
            "optional": true
          },
          "certkeytag": {
            "type": "number",
            "description": "A numeric value (0-65535), used to efficiently pick a CERT record.",
            "description_kind": "markdown",
            "optional": true
          },
          "certtype": {
            "type": "number",
            "description": "Type of the Certificate/CRL.",
            "description_kind": "markdown",
            "optional": true
          },
          "cpu": {
            "type": "string",
            "description": "The CPU of the server.",
            "description_kind": "markdown",
            "optional": true
          },
          "digesttype": {
            "type": "number",
            "description": "The cryptographic hash algorithm used to create the Digest value.",
            "description_kind": "markdown",
            "optional": true
          },
          "flag": {
            "type": "string",
            "description": "Controls aspects of the rewriting and interpretation of the fields in the record.",
            "description_kind": "markdown",
            "optional": true
          },
          "fptype": {
            "type": "number",
            "description": "Type of the SSHFP algorithm. Required for SSHFP records only.",
            "description_kind": "markdown",
            "optional": true
          },
          "frame": {
            "type": "string",
            "description": "Frame for WR record - 0 or 1 to disable or enable frame",
            "description_kind": "markdown",
            "optional": true
          },
          "framedescription": {
            "type": "string",
            "description": "Description if frame is enabled in Web redirects",
            "description_kind": "markdown",
            "optional": true
          },
          "framekeywords": {
            "type": "string",
            "description": "Keywords if frame is enabled in Web redirects",
            "description_kind": "markdown",
            "optional": true
          },
          "frametitle": {
            "type": "string",
            "description": "Title if frame is enabled in Web redirects",
            "description_kind": "markdown",
            "optional": true
          },
          "geodnscode": {
            "type": "string",
            "description": "Code of a GeoDNS location for A, AAAA, CNAME, NAPTR or SRV record.",
            "description_kind": "markdown",
            "optional": true
          },
          "geodnslocation": {
            "type": "string",
            "description": "ID of a GeoDNS location for A, AAAA, CNAME, NAPTR or SRV record. The GeoDNS locations can be obtained with List GeoDNS locations",
            "description_kind": "markdown",
            "optional": true
          },
          "hprecision": {
            "type": "string",
            "description": "A numeric value(0 - 90000000.00), sets the horizontal precision in meters.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "keytag": {
            "type": "number",
            "description": "A numeric value used for identifying the referenced DS record.",
            "description_kind": "markdown",
            "optional": true
          },
          "latdeg": {
            "type": "number",
            "description": "A numeric value(0-90), sets the latitude degrees.",
            "description_kind": "markdown",
            "optional": true
          },
          "latdir": {
            "type": "string",
            "description": "Sets the latitude direction. Possible values: N - North, S - South",
            "description_kind": "markdown",
            "optional": true
          },
          "latmin": {
            "type": "number",
            "description": "A numeric value(0-59), sets the latitude minutes.",
            "description_kind": "markdown",
            "optional": true
          },
          "latsec": {
            "type": "number",
            "description": "A numeric value(0-59), sets the latitude seconds.",
            "description_kind": "markdown",
            "optional": true
          },
          "longdeg": {
            "type": "number",
            "description": "A numeric value(0-180), sets the longitude degrees.",
            "description_kind": "markdown",
            "optional": true
          },
          "longdir": {
            "type": "string",
            "description": "Sets the longitude direction. Possible values: W - West, E - East",
            "description_kind": "markdown",
            "optional": true
          },
          "longmin": {
            "type": "number",
            "description": "A numeric value(0-59), sets the longitude minutes.",
            "description_kind": "markdown",
            "optional": true
          },
          "longsec": {
            "type": "number",
            "description": "A numeric value(0-59), sets the longitude seconds.",
            "description_kind": "markdown",
            "optional": true
          },
          "mail": {
            "type": "string",
            "description": "E-mail address for RP records",
            "description_kind": "markdown",
            "optional": true
          },
          "mobilemeta": {
            "type": "number",
            "description": "Mobile responsive meta tags if Web redirects with frame is enabled. Default value - 0.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the record",
            "description_kind": "markdown",
            "required": true
          },
          "order": {
            "type": "string",
            "description": "Specifies the order in which multiple NAPTR records must be processed (low to high).",
            "description_kind": "markdown",
            "optional": true
          },
          "os": {
            "type": "string",
            "description": "The operating system of the server.",
            "description_kind": "markdown",
            "optional": true
          },
          "params": {
            "type": "string",
            "description": "Specifies the service parameters applicable to this delegation path.",
            "description_kind": "markdown",
            "optional": true
          },
          "port": {
            "type": "number",
            "description": "Port for SRV record",
            "description_kind": "markdown",
            "optional": true
          },
          "pref": {
            "type": "string",
            "description": "Specifies the order (low to high) in which NAPTR records with equal Order values should be processed.",
            "description_kind": "markdown",
            "optional": true
          },
          "priority": {
            "type": "number",
            "description": "Priority for MX record",
            "description_kind": "markdown",
            "optional": true
          },
          "redirecttype": {
            "type": "number",
            "description": "301 or 302 for Web redirects if frame is disabled",
            "description_kind": "markdown",
            "optional": true
          },
          "regexp": {
            "type": "string",
            "description": "Contains a substitution expression that is applied to the original string, held by the client in order to construct the next domain name to lookup.",
            "description_kind": "markdown",
            "optional": true
          },
          "replace": {
            "type": "string",
            "description": "Specifies the next domain name (fully qualified) to query for depending on the potential values found in the flags field.",
            "description_kind": "markdown",
            "optional": true
          },
          "savepath": {
            "type": "number",
            "description": "0 or 1 for Web redirects",
            "description_kind": "markdown",
            "optional": true
          },
          "size": {
            "type": "string",
            "description": "A numeric value(0 - 90000000.00), sets the size in meters.",
            "description_kind": "markdown",
            "optional": true
          },
          "smimeamatchingtype": {
            "type": "string",
            "description": "Specifies how the certificate association is presented.",
            "description_kind": "markdown",
            "optional": true
          },
          "smimeaselector": {
            "type": "string",
            "description": "Specifies which part of the TLS certificate presented by the server will be matched against the association data",
            "description_kind": "markdown",
            "optional": true
          },
          "smimeausage": {
            "type": "string",
            "description": "Shows the provided association that will be used.",
            "description_kind": "markdown",
            "optional": true
          },
          "status": {
            "type": "number",
            "description": "Set to 1 to create the record active or to 0 to create it inactive. If omitted the record will be created active.",
            "description_kind": "markdown",
            "optional": true
          },
          "tlsamatchingtype": {
            "type": "string",
            "description": "Specifies how the certificate association is presented.",
            "description_kind": "markdown",
            "optional": true
          },
          "tlsaselector": {
            "type": "string",
            "description": "Specifies which part of the TLS certificate presented by the server will be matched against the association data",
            "description_kind": "markdown",
            "optional": true
          },
          "tlsausage": {
            "type": "string",
            "description": "Shows the provided association that will be used.",
            "description_kind": "markdown",
            "optional": true
          },
          "ttl": {
            "type": "number",
            "description": "The TTL to assign to the record",
            "description_kind": "markdown",
            "required": true
          },
          "txt": {
            "type": "string",
            "description": "Domain name for TXT record used in RP records",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "The type of record",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Value of the record",
            "description_kind": "markdown",
            "optional": true
          },
          "vprecision": {
            "type": "string",
            "description": "A numeric value(0 - 90000000.00), sets the vertical precision in meters.",
            "description_kind": "markdown",
            "optional": true
          },
          "weight": {
            "type": "number",
            "description": "Weight for SRV record",
            "description_kind": "markdown",
            "optional": true
          },
          "zone": {
            "type": "string",
            "description": "The zone on which to add the record",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "A simple DNS record.",
        "description_kind": "markdown"
      }
    },
    "cloudns_dns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The name of the DNS zone.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "master": {
            "type": "string",
            "description": "Master IP for slave zone",
            "description_kind": "markdown",
            "optional": true
          },
          "nameserver_type": {
            "type": "string",
            "description": "The type of nameservers to use (all/free/premium.)",
            "description_kind": "markdown",
            "optional": true
          },
          "nameservers": {
            "type": [
              "list",
              "string"
            ],
            "description": "A set of NS servers to use for this zone.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The type of the DNS zone (master/slave/parked/geodns).",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "A DNS zone managed by ClouDNS.",
        "description_kind": "markdown"
      }
    },
    "cloudns_dynamic_url": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The name of the DNS zone.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "recordid": {
            "type": "string",
            "description": "The ID of the record for which the dynamic URL should be enabled / the same as the id param",
            "description_kind": "markdown",
            "required": true
          },
          "url": {
            "type": "string",
            "description": "The URL to which the dynamic DNS request will be sent.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "A dynamic URL for an A or AAAA record managed by ClouDNS.",
        "description_kind": "markdown"
      }
    }
  }
}
