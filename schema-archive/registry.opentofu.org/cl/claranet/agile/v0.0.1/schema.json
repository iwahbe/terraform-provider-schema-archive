{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "allow_insecure": {
          "type": "bool",
          "description": "Skip verification of TLS certificates of API requests. You may need to set this to `true` if you are using your local API without setting up a signed certificate. Can be specified with the `AGILE_INSECURE` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "api_url": {
          "type": "string",
          "description": "URL of the Huawei Agile controller API. Can be specified with the `AGILE_API` environment variable.",
          "description_kind": "markdown",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "Password for the user accessing the API. Can be specified with the `AGILE_PASSWORD` environment variable.",
          "description_kind": "markdown",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "User name for the Huawei Agile controller API. Can be specified with the `AGILE_USERNAME` environment variable.",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "agile_logical_network": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Logical network description.",
            "description_kind": "markdown",
            "optional": true
          },
          "fabrics_id": {
            "type": [
              "list",
              "string"
            ],
            "description": "ID of the fabrics associated with the logical network. If the VPC is not a public VPC, the fabric must have been added by the tenant.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Logical network ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "is_vpc_deployed": {
            "type": "bool",
            "description": "Indicates if VPC is deployed",
            "description_kind": "markdown",
            "computed": true
          },
          "multicast_capability": {
            "type": "bool",
            "description": "Whether the multicast capability is supported. Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Logical network name.",
            "description_kind": "markdown",
            "required": true
          },
          "tenant_id": {
            "type": "string",
            "description": "Tenant to which a logical network (VPC) belongs. If this parameter is left empty, it is a public VPC.",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Logical network type, which can be Instance or Transit. If this parameter is left empty, the default value is Instance. Defaults to `Instance`.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "additional": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "producer": {
                  "type": "string",
                  "description": "This parameter is optional. If it is specified by the user, the specified value is used. The character string starting with component is reserved. If no value is specified, the default value default is used. Defaults to `default`.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Additional Settings.",
              "description_kind": "markdown"
            },
            "max_items": 1
          }
        },
        "description": "Manages Logical Networks.",
        "description_kind": "markdown"
      }
    },
    "agile_tenant": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Tenant description. Defaults to ``.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Tenant ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "multicast_capability": {
            "type": "bool",
            "description": "Whether to enable the multicast capability for the tenant. By default, the multicast capability of a tenant is disabled.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Tenant name.",
            "description_kind": "markdown",
            "required": true
          },
          "producer": {
            "type": "string",
            "description": "Producer. This parameter is optional. If it is specified by the user, the specified value is used. The character string starting with component is reserved. If no value is specified, the default value default is used. Defaults to `default`.",
            "description_kind": "markdown",
            "optional": true
          },
          "quota": {
            "type": [
              "set",
              [
                "object",
                {
                  "logic_router_num": "number",
                  "logic_switch_num": "number",
                  "logic_vas_num": "number"
                }
              ]
            ],
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "multicast_quota": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "acl_num": {
                  "type": "number",
                  "description": "Maximum number of ACL rules that can be created for the tenant when the multicast capability is enabled. The value is an integer in the range from 0 to 1000",
                  "description_kind": "markdown",
                  "optional": true
                },
                "acl_rule_num": {
                  "type": "number",
                  "description": "Maximum number of ACL rules that can be created for the tenant when the multicast capability is enabled. The value is an integer in the range from 0 to 3000",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "res_pool": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "dhcp_group_ids": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "DHCP groups that can be used by the tenant to dynamically allocate IP addresses to VMs in VPC services. UUID Version 4 Format.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "external_gateway_ids": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "External gateway that can be used by the tenant. UUID Version 4 Format.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "fabric_ids": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Fabrics network that can be used by the tenant. UUID Version 4 Format.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "vmm_ids": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "VMMs that can be used by the tenant. This parameter is required only in network virtualization - computing scenarios. UUID Version 4 Format.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description": "Manages Agile Tenant.",
        "description_kind": "markdown"
      }
    }
  },
