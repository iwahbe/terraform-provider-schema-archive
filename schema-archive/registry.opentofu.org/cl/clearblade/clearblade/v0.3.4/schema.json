                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The state most recently received from the device.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
