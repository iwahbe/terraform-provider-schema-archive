                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The configuration for notification of telemetry events received from the device. All telemetry events that were successfully published by the device and acknowledged by Clearblade IoT Core are guaranteed to be delivered to Cloud Pub/Sub.",
            "description_kind": "markdown",
            "optional": true
          },
          "http_config": {
            "nested_type": {
              "attributes": {
                "http_enabled_state": {
