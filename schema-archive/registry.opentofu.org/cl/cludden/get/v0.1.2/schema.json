      "version": 0,
      "block": {
        "attributes": {
          "archive": {
            "type": "string",
            "description": "configure explicit unarchiving behavior",
            "description_kind": "plain",
            "optional": true
          },
          "checksum": {
            "type": "string",
            "description": "configure artifact checksumming",
            "description_kind": "plain",
            "optional": true
          },
          "dest": {
            "type": "string",
            "description": "destination path",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "insecure": {
            "type": "bool",
            "description": "disable TLS verification",
            "description_kind": "plain",
            "optional": true
          },
          "mode": {
            "type": "string",
            "description": "get mode (any, file, dir)",
            "description_kind": "plain",
            "optional": true
          },
          "required": {
            "type": "bool",
            "description": "ensure destination is always present",
            "description_kind": "plain",
            "optional": true
          },
          "sum": {
            "type": "string",
            "description": "artifact checksum",
            "description_kind": "plain",
            "computed": true
          },
          "sum64": {
            "type": "string",
