  "resource_schemas": {
    "cloudsigma_drive": {
      "version": 0,
      "block": {
        "attributes": {
          "clone_drive_id": {
            "type": "string",
            "description": "The UUID of the drive that will be cloned.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "media": {
            "type": "string",
            "description": "Media representation type. It can be `cdrom` or `disk`.",
            "description_kind": "plain",
            "required": true
          },
          "mounted_on": {
            "type": [
              "list",
              [
                "object",
                {
                  "resource_uri": "string",
                  "uuid": "string"
                }
              ]
            ],
            "description": "Servers on which this drive is mounted on.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Human readable name of the drive.",
            "description_kind": "plain",
            "required": true
          },
          "resource_uri": {
            "type": "string",
            "description": "The unique resource identifier of the drive.",
            "description_kind": "plain",
            "computed": true
          },
          "size": {
            "type": "number",
            "description": "Size of the drive in bytes.",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "The drive status.",
            "description_kind": "plain",
            "computed": true
          },
          "storage_type": {
            "type": "string",
            "description": "Drive storage type, cannot be changed after drive creation.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tags": {
            "type": [
              "set",
              "string"
            ],
            "description": "A list of the tags UUIDs to be applied to the drive.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "uuid": {
            "type": "string",
            "description": "The UUID of the drive.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "\nThe drive resource allows you to manage CloudSigma drives.\n\nDrives can be created via cloning library drives with already installed OS.\nUse \"cloudsigma_library_drive\" data source to find UUID of the library drive.\n",
        "description_kind": "plain"
      }
    },
