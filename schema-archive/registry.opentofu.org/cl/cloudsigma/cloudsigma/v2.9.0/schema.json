          "drive": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "device": {
                  "type": "string",
                  "description": "Device emulation type. Valid values: `ide`, `virtio`(default), `scsi`.",
                  "description_kind": "plain",
                  "optional": true
                },
                "uuid": {
                  "type": "string",
                  "description": "The UUID of the drive.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Drive attached to the server on creation.The server will boot from the first defined drive in this resource, which get `boot_order = 1`.",
              "description_kind": "plain"
            }
          },
          "network": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "ipv4_address": {
                  "type": "string",
                  "description": "The IP address reference. Only used with `static` type.",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "Configuration type. Valid values: `dhcp`, `static`, `manual`.",
                  "description_kind": "plain",
                  "optional": true
                },
                "vlan_uuid": {
                  "type": "string",
                  "description": "The UUID of the VLAN reference.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Network interface card attached to the server.",
              "description_kind": "plain"
            }
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
