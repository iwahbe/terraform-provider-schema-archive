{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "apikey": {
          "type": "string",
          "description": "API key Cloudkarafka API.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "description": "Interact with Cloudkarafka.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "cloudkarafka_aclrule": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "number",
            "description": "Rule ID.",
            "description_kind": "plain",
            "computed": true
          },
          "instance_id": {
            "type": "number",
            "description": "Id of the instance where we want to manage the rules.",
            "description_kind": "plain",
            "required": true
          },
          "operation": {
            "type": "string",
            "description": "Which operation to set the rule on.",
            "description_kind": "plain",
            "required": true
          },
          "resource": {
            "type": "string",
            "description": "Which resource to set the rule on, cluster, topic or group are valid values.",
            "description_kind": "plain",
            "required": true
          },
          "resource_pattern": {
            "type": "string",
            "description": "Which resource to match.",
            "description_kind": "plain",
            "required": true
          },
          "resource_pattern_type": {
            "type": "string",
            "description": "How to apply the resource_pattern, literal or prefixed.",
            "description_kind": "plain",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "Name of the user to apply the rules on.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage an ACL rule.",
        "description_kind": "plain"
      }
    },
    "cloudkarafka_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "disk_size": {
            "type": "number",
            "description": "Disk size for each broker.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "Instance ID.",
            "description_kind": "plain",
            "computed": true
          },
          "kafka_version": {
            "type": "string",
            "description": "Which Apache Kafka version to use.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of instance.",
            "description_kind": "plain",
            "required": true
          },
          "plan": {
            "type": "string",
            "description": "What plan to use.",
            "description_kind": "plain",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "Which region to use.",
            "description_kind": "plain",
            "required": true
          },
          "tags": {
            "type": [
              "set",
              "string"
            ],
            "description": "Instance tags.",
            "description_kind": "plain",
            "optional": true
          },
          "vpc_id": {
            "type": "number",
            "description": "ID for which subnet to use.",
            "description_kind": "plain",
            "optional": true
          },
          "vpc_subnet": {
            "type": "string",
            "description": "Subnet for the VPC.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage an instance.",
        "description_kind": "plain"
      }
    },
    "cloudkarafka_kafkaconfig": {
      "version": 0,
      "block": {
        "attributes": {
          "auto_create_topics_enable": {
            "type": "bool",
            "description": "Enable auto creation of topic on the server.",
            "description_kind": "plain",
            "optional": true
          },
          "instance_id": {
            "type": "number",
            "description": "Id of the instance where we want to manage the topic.",
            "description_kind": "plain",
            "required": true
          },
          "log_retention_bytes": {
            "type": "number",
            "description": "The maximum size of the log before deleting it.",
            "description_kind": "plain",
            "optional": true
          },
          "log_retention_ms": {
            "type": "number",
            "description": "The number of milliseconds to keep a log file before deleting it.",
            "description_kind": "plain",
            "optional": true
          },
          "log_segment_bytes": {
            "type": "number",
            "description": "The maximum size of a single log file.",
            "description_kind": "plain",
            "optional": true
          },
          "message_max_bytes": {
            "type": "number",
            "description": "Max size of message.",
            "description_kind": "plain",
            "optional": true
          },
          "min_insync_replicas": {
            "type": "number",
            "description": "Minimum insync replicas avaiable with ACKing.",
            "description_kind": "plain",
            "optional": true
          },
          "num_io_threads": {
            "type": "number",
            "description": "The number of threads that the server uses for processing requests, which may include disk I/O.",
            "description_kind": "plain",
            "optional": true
          },
          "num_network_threads": {
            "type": "number",
            "description": "The number of threads that the server uses for receiving requests from the network and sending responses to the network.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage the Kafka configuration.",
        "description_kind": "plain"
      }
    },
    "cloudkarafka_topic": {
      "version": 0,
      "block": {
        "attributes": {
          "config": {
            "nested_type": {
              "attributes": {
                "cleanup_policy": {
                  "type": "string",
                  "description": "Delete or compact when records hit their retention.",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete_retention_ms": {
                  "type": "number",
                  "description": "Delete or compact when records hit their retention.",
                  "description_kind": "plain",
                  "optional": true
                },
                "min_insync_replicas": {
                  "type": "number",
                  "description": "Delete or compact when records hit their retention.",
                  "description_kind": "plain",
                  "optional": true
                },
                "retention_bytes": {
                  "type": "number",
                  "description": "Delete or compact when records hit their retention.",
                  "description_kind": "plain",
                  "optional": true
                },
                "retention_ms": {
                  "type": "number",
                  "description": "Delete or compact when records hit their retention.",
                  "description_kind": "plain",
                  "optional": true
                },
                "segment_bytes": {
                  "type": "number",
                  "description": "Delete or compact when records hit their retention.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Topic configuration.",
            "description_kind": "plain",
            "optional": true
          },
          "instance_id": {
            "type": "number",
            "description": "Id of the instance where we want to manage the topic.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of topic.",
            "description_kind": "plain",
            "required": true
          },
          "partitions": {
            "type": "number",
            "description": "Number of partitions for the topic.",
            "description_kind": "plain",
            "required": true
          },
          "replication_factor": {
            "type": "number",
            "description": "Replication factor for the topic.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage a topic.",
        "description_kind": "plain"
      }
    },
    "cloudkarafka_user": {
      "version": 0,
      "block": {
        "attributes": {
          "instance_id": {
            "type": "number",
            "description": "Id of the instance where we want to manage the user.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of user.",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of user, either sasl or ssl.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage a user.",
        "description_kind": "plain"
      }
    }
  }
}
