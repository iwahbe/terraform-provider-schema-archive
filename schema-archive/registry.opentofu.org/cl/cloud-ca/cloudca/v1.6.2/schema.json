    "cloudca_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "admin_role": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of users that will be given Environment Admin role",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Description for the environment",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of environment to be created. Must be lower case, contain alphanumeric charaters, underscores or dashes",
            "description_kind": "plain",
            "required": true
          },
          "organization_code": {
            "type": "string",
            "description": "Organization's entry point, i.e. <entry_point>.cloud.ca",
            "description_kind": "plain",
            "required": true
          },
          "read_only_role": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of users that will be given Read-only role",
            "description_kind": "plain",
            "optional": true
          },
          "service_code": {
            "type": "string",
            "description": "A cloudca service code",
            "description_kind": "plain",
            "required": true
          },
          "user_role": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of users that will be given User role",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "cloudca_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "compute_offering": {
            "type": "string",
            "description": "Name or id of the compute offering to use for this instance",
            "description_kind": "plain",
            "required": true
          },
          "cpu_count": {
            "type": "number",
            "description": "The instances CPU count. If the compute offering is custom, this value is required",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "dedicated_group_id": {
            "type": "string",
            "description": "Id of the dedicated group into which the new instance will be created",
            "description_kind": "plain",
            "optional": true
          },
          "environment_id": {
            "type": "string",
            "description": "ID of environment where instance should be created",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "memory_in_mb": {
            "type": "number",
            "description": "The instance's memory in MB. If the compute offering is custom, this value is required",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of instance",
            "description_kind": "plain",
            "required": true
          },
          "network_id": {
            "type": "string",
            "description": "Id of the network into which the new instance will be created",
            "description_kind": "plain",
            "required": true
          },
          "private_ip": {
            "type": "string",
            "description": "The IPv4 address of the instance. Must be within the network's CIDR and not collide with existing instances.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "private_ip_id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "public_key": {
            "type": "string",
            "description": "Public key to attach to the new instance. Note: Cannot be used with SSH key name.",
            "description_kind": "plain",
            "optional": true
          },
          "root_volume_size_in_gb": {
            "type": "number",
            "description": "The size of the root volume in GB. This can only be set if the template allows choosing a custom root volume size.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ssh_key_name": {
            "type": "string",
            "description": "SSH key name to attach to the new instance. Note: Cannot be used with public key.",
            "description_kind": "plain",
            "optional": true
          },
          "template": {
            "type": "string",
            "description": "Name or id of the template to use for this instance",
            "description_kind": "plain",
            "required": true
          },
          "user_data": {
            "type": "string",
            "description": "Additional data passed to the new instance during its initialization",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
