{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "the key to access the Dreamhost API",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dreamhost_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "account_id": {
            "type": "string",
            "description": "the account ID belonging to the DNS record",
            "description_kind": "plain",
            "computed": true
          },
          "comment": {
            "type": "string",
            "description": "any comment attached to the DNS record",
            "description_kind": "plain",
            "computed": true
          },
          "editable": {
            "type": "string",
            "description": "whether the record is editable",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "record": {
            "type": "string",
            "description": "the name of the DNS record",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "the type of the DNS record (e.g. A, CNAME, TXT)",
            "description_kind": "plain",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "the value of the DNS record",
            "description_kind": "plain",
            "required": true
          },
          "zone": {
            "type": "string",
            "description": "the zone of the DNS record (used in a multi-zone setup)",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
