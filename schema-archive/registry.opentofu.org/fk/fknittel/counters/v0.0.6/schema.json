                  "major_value": "number",
                  "minor_triggers": [
                    "map",
                    "string"
                  ],
                  "minor_value": "number",
                  "patch_triggers": [
                    "map",
                    "string"
                  ],
                  "patch_value": "number",
                  "value": "string"
                }
              ]
            ],
