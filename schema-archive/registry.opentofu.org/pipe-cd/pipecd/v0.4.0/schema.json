{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "host": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with PipeCD.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "pipecd_application": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "The description of the application.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "git": {
            "nested_type": {
              "attributes": {
                "filename": {
                  "type": "string",
                  "description": "The configuration file name. (default \"app.pipecd.yaml\")",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "path": {
                  "type": "string",
                  "description": "The relative path from the root of repository to the application directory.",
                  "description_kind": "plain",
                  "required": true
                },
                "repository_id": {
                  "type": "string",
                  "description": "The repository ID. One the registered repositories in the piped configuration.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Git path for the application.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of this Application.",
            "description_kind": "plain",
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "The kind of application.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The application name.",
            "description_kind": "plain",
            "required": true
          },
          "piped_id": {
            "type": "string",
            "description": "The ID of piped that should handle this application.",
            "description_kind": "plain",
            "required": true
          },
          "platform_provider": {
            "type": "string",
            "description": "The platform provider name. One of the registered providers in the piped configuration. The previous name of this field is cloud-provider.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "PipeCD application resource.",
        "description_kind": "markdown"
      }
    },
    "pipecd_piped": {
      "version": 0,
      "block": {
        "attributes": {
          "api_key": {
            "type": "string",
