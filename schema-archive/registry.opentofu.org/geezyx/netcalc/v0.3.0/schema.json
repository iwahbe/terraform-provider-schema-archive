{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "claimed_cidr_blocks": {
          "type": [
            "list",
            "string"
          ],
          "description": "IPv4 and/or IPv6 CIDR blocks that are already claimed by other resources.",
          "description_kind": "markdown",
          "optional": true
        },
        "pool_cidr_blocks": {
          "type": [
            "list",
            "string"
          ],
          "description": "IPv4 and/or IPv6 CIDR blocks that form a collective pool to be allocated in this provider.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "netcalc_subnet": {
      "version": 0,
      "block": {
        "attributes": {
          "cidr_block": {
            "type": "string",
            "description": "Calculated CIDR block.",
            "description_kind": "markdown",
            "computed": true
          },
          "cidr_mask_length": {
            "type": "number",
            "description": "Network size in bits. e.g. if you wanted a /27 network, 27 would be the value here.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Resource ID, same as the calculated cidr_block.",
            "description_kind": "markdown",
            "computed": true
          },
          "ip_family": {
            "type": "string",
            "description": "The IP family for the calculated addresses. Must be one of ipv4 or ipv6.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Subnet resource",
        "description_kind": "markdown"
      }
    },
    "netcalc_subnets": {
      "version": 0,
      "block": {
        "attributes": {
          "cidr_blocks": {
            "type": [
              "list",
              "string"
            ],
            "description": "Calculated CIDR block.",
            "description_kind": "markdown",
            "computed": true
          },
          "cidr_count": {
            "type": "number",
            "description": "Number of CIDR blocks to provision",
            "description_kind": "markdown",
            "required": true
          },
          "cidr_mask_length": {
            "type": "number",
            "description": "Network size in bits. e.g. if you wanted a /27 network, 27 would be the value here.",
            "description_kind": "markdown",
            "required": true
          },
          "existing_cidr_blocks": {
            "type": [
              "set",
              "string"
            ],
            "description": "Set of CIDR blocks which are already in use.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Resource ID, same as the calculated cidr_blocks.",
            "description_kind": "markdown",
            "computed": true
          },
          "pool_cidr_blocks": {
            "type": [
              "set",
              "string"
            ],
            "description": "Set of CIDR blocks from which to select an available subnet.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "*Deprecated* Subnet resource. Use `netcalc_subnet` instead. This resource will be removed in an upcoming version of this provider.",
        "description_kind": "markdown",
        "deprecated": true
      }
    }
  }
}
