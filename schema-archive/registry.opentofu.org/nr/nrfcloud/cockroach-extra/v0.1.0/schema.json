    "cockroach-extra_migration": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster ID",
            "description_kind": "markdown",
            "required": true
          },
          "database": {
            "type": "string",
            "description": "Database to apply the migration to",
            "description_kind": "markdown",
            "required": true
          },
          "destroy_mode": {
            "type": "string",
            "description": "What to do when the resource is destroyed. 'noop' will do nothing and 'down' will run all down migrations",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "migrations_url": {
            "type": "string",
            "description": "Url pointing to your migrations (ex: file://path/to/migrations)",
            "description_kind": "markdown",
            "required": true
          },
          "version": {
            "type": "number",
            "description": "What migration version should be applied. This should be the migration id number (integer prefix of the filename).",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "cockroach-extra_persistent_cursor": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster ID",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Persistent cursor ID",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Unique key that identifies this cursor",
            "description_kind": "markdown",
            "required": true
          },
          "last_used_job_id": {
            "type": "number",
            "description": "ID of the last job that used this cursor",
            "description_kind": "markdown",
            "computed": true
          },
          "ref": {
            "type": "string",
            "description": "Reference to the cursor",
            "description_kind": "markdown",
            "computed": true
          },
          "resume_offset": {
            "type": "number",
            "description": "\nAdd an offset in seconds for changefeed resumption.\nUseful for skipping over whatever caused the error.\n",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "value": {
            "type": "string",
            "description": "Current timestamp of the cursor",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "\nCreate a persistent cursor.\nThis can be used with a changefeed to preserve the state of the cursor across restarts.\nIf the cursor falls behind the gc window (job was in a failed state for too long), it will expire and changefeeds will not be able to resume from it.\n",
        "description_kind": "markdown"
      }
    },
