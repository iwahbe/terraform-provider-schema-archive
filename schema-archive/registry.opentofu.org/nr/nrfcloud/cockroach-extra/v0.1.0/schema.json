                  "optional": true,
                  "sensitive": true
                },
                "full_backup_frequency": {
                  "type": "string",
                  "description": "Frequency that full backups should be taken",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "incremental_backup_location": {
                  "type": "string",
                  "description": "Explicit separate location for incremental backups",
                  "description_kind": "markdown",
                  "optional": true
                },
                "kms": {
                  "type": "string",
                  "description": "KMS URI",
                  "description_kind": "markdown",
                  "optional": true
                },
                "revision_history": {
                  "type": "bool",
                  "description": "Enable revision history",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Backup options",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "cluster_id": {
            "type": "string",
            "description": "Cluster ID",
            "description_kind": "markdown",
            "required": true
          },
          "full_backup_schedule_id": {
            "type": "number",
            "description": "Schedule ID for full backups",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ID of the backup schedule",
            "description_kind": "markdown",
            "computed": true
          },
          "incremental_backup_schedule_id": {
            "type": "number",
            "description": "Schedule ID for incremental backups",
            "description_kind": "markdown",
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Label for the backup schedule",
            "description_kind": "markdown",
            "required": true
          },
          "location": {
            "type": "string",
            "description": "Location for the backup",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "recurring": {
            "type": "string",
            "description": "Recurring schedule",
            "description_kind": "markdown",
            "required": true
          },
          "schedule_options": {
            "nested_type": {
              "attributes": {
                "first_run": {
                  "type": "string",
                  "description": "When should the first run be scheduled",
                  "description_kind": "markdown",
                  "optional": true
                },
                "ignore_existing_backups": {
                  "type": "bool",
                  "description": "Ignore existing backups",
                  "description_kind": "markdown",
                  "optional": true
                },
                "on_execution_failure": {
                  "type": "string",
                  "description": "What to do on execution failure",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "on_previous_running": {
                  "type": "string",
                  "description": "What to do if the previous run is still running",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Backup schedule options",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "target": {
            "nested_type": {
              "attributes": {
                "databases": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Databases to backup",
                  "description_kind": "markdown",
                  "optional": true
                },
                "full_cluster_backup": {
                  "type": "bool",
                  "description": "Backup the full cluster",
                  "description_kind": "markdown",
                  "optional": true
                },
                "tables": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Tables to backup",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Backup target",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Backup schedule",
        "description_kind": "markdown"
      }
    },
