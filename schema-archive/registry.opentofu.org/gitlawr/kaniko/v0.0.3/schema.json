{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "config_path": {
          "type": "string",
          "description": "Path to the kube config file.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "kaniko_image": {
      "version": 0,
      "block": {
        "attributes": {
          "always_run": {
            "type": "bool",
            "description": "Set to true to run build image every time even variables aren't change",
            "description_kind": "plain",
            "optional": true
          },
          "build_arg": {
            "type": [
              "map",
              "string"
            ],
            "description": "Arguments at build time.",
            "description_kind": "plain",
            "optional": true
          },
          "build_id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "cache": {
            "type": "bool",
            "description": "Set to true to opt in caching",
            "description_kind": "plain",
            "optional": true
          },
          "context": {
            "type": "string",
            "description": "Location of the build context",
            "description_kind": "plain",
            "required": true
          },
          "destination": {
            "type": "string",
            "description": "Image name to be built and pushed.",
            "description_kind": "plain",
            "required": true
          },
          "dockerfile": {
            "type": "string",
            "description": "Path to the dockerfile to be built. (default \"Dockerfile\")",
            "description_kind": "plain",
            "optional": true
          },
          "git_password": {
            "type": "string",
            "description": "Password for the git clone",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "git_username": {
            "type": "string",
            "description": "Username for the git clone",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "no_push": {
            "type": "bool",
            "description": "Set to true if you only want to build the image, without pushing to a registry",
            "description_kind": "plain",
            "optional": true
          },
          "push_retry": {
            "type": "number",
            "description": "Number of retries for the push operation",
            "description_kind": "plain",
            "optional": true
          },
          "registry_password": {
            "type": "string",
            "description": "Password for the image registry",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "registry_username": {
            "type": "string",
            "description": "Username for the image registry",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "reproducible": {
            "type": "bool",
            "description": "Set to true to strip timestamps out of the built image and make it reproducible.",
            "description_kind": "plain",
            "optional": true
          },
          "verbosity": {
            "type": "string",
            "description": "Log level (trace, debug, info, warn, error, fatal, panic) (default info)",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Specify the image to build.",
        "description_kind": "plain"
      }
    }
  }
}
