{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "retry_limit": {
          "type": "number",
          "description": "The number of times to retry operations with exponetial backoff.",
          "description_kind": "plain",
          "optional": true
        },
        "server_up_port": {
          "type": "number",
          "description": "The port to use when checking if the server is actually reachable.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The token key for API operations.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "webdock_public_key": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "PublicKey creation datetime",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "PublicKey ID",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "PublicKey content",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "PublicKey name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "webdock_server": {
      "version": 0,
      "block": {
        "attributes": {
          "aliases": {
            "type": [
              "list",
              "string"
            ],
            "description": "Server description (what's installed here?) as entered by admin in Server Metadata",
            "description_kind": "plain",
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "Creation date/time",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "image_slug": {
            "type": "string",
            "description": "Server image",
            "description_kind": "plain",
            "required": true
          },
          "ipv4": {
            "type": "string",
            "description": "IPv4 address",
            "description_kind": "plain",
            "computed": true
          },
          "ipv6": {
            "type": "string",
            "description": "IPv6 address",
            "description_kind": "plain",
            "computed": true
          },
          "location_id": {
            "type": "string",
            "description": "Location ID of the server",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Server name",
            "description_kind": "plain",
            "required": true
          },
          "profile_slug": {
            "type": "string",
            "description": "Server profile",
            "description_kind": "plain",
            "required": true
          },
          "slug": {
            "type": "string",
            "description": "Server slug",
            "description_kind": "plain",
            "computed": true
          },
          "snapshot_runtime": {
            "type": "number",
            "description": "Last knows snapshot runtime (seconds)",
            "description_kind": "plain",
            "computed": true
          },
          "ssh_password_auth_enabled": {
            "type": "bool",
            "description": "Whether SSH password authentication is enabled",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Server status",
            "description_kind": "plain",
            "computed": true
          },
          "virtualization": {
            "type": "string",
            "description": "Virtualization type for your new server. container means the server will be a Webdock LXD VPS and kvm means it will be a KVM Virtual machine. If you specify a snapshotId in the request, the server type from which the snapshot belongs much match the virtualization selected. Reason being that KVM images are incompatible with LXD images and vice-versa.",
            "description_kind": "plain",
            "optional": true
          },
          "webserver": {
            "type": "string",
            "description": "Webserver type (apache, nginx, none)",
            "description_kind": "plain",
            "computed": true
          },
          "wordpress_lockdown": {
            "type": "bool",
            "description": "Whether WordPress is in lockdown mode",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "webdock_shell_user": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "shell user creation datetime",
            "description_kind": "plain",
            "computed": true
          },
          "group": {
            "type": "string",
            "description": "shell user group",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "shell user id",
            "description_kind": "plain",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "shell user password",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "public_keys": {
            "type": [
              "list",
              "number"
            ],
            "description": "shell user public keys",
            "description_kind": "plain",
            "required": true
          },
          "server_slug": {
            "type": "string",
            "description": "shell user server slug",
            "description_kind": "plain",
            "required": true
          },
          "shell": {
            "type": "string",
            "description": "shell user shell",
            "description_kind": "plain",
            "optional": true
          },
          "username": {
            "type": "string",
            "description": "shell user username",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "webdock_images": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
