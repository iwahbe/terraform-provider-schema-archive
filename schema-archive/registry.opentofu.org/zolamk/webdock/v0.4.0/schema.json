            "computed": true
          },
          "images": {
            "type": [
              "list",
              [
                "object",
                {
                  "name": "string",
                  "php_version": "string",
                  "slug": "string",
                  "web_server": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "webdock_locations": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "locations": {
            "type": [
              "list",
              [
                "object",
                {
                  "city": "string",
                  "country": "string",
                  "description": "string",
                  "icon": "string",
                  "id": "string",
                  "name": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "webdock_profiles": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "location_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "profiles": {
            "type": [
              "list",
              [
                "object",
                {
                  "description": "string",
                  "name": "string",
                  "slug": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "webdock_public_keys": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "public_keys": {
            "type": [
              "list",
              [
                "object",
                {
                  "created_at": "string",
                  "id": "string",
                  "key": "string",
                  "name": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "webdock_servers": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "servers": {
            "type": [
              "list",
              [
                "object",
                {
                  "aliases": [
                    "list",
                    "string"
                  ],
                  "created_at": "string",
                  "image_slug": "string",
                  "ipv4": "string",
                  "ipv6": "string",
                  "location_id": "string",
                  "name": "string",
                  "profile_slug": "string",
                  "slug": "string",
                  "snapshot_runtime": "number",
                  "ssh_password_auth_enabled": "bool",
                  "status": "string",
                  "virtualization": "string",
                  "webserver": "string",
                  "wordpress_lockdown": "bool"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Server status (all, suspended, active)",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "webdock_shell_users": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "server_slug": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "shell_users": {
            "type": [
              "list",
              [
                "object",
                {
                  "created_at": "string",
                  "group": "string",
                  "id": "string",
                  "password": "string",
                  "public_keys": [
                    "list",
                    "number"
                  ],
                  "server_slug": "string",
                  "shell": "string",
                  "username": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
