{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_token": {
          "type": "string",
          "description": "Access token to authenticate to mapbox with",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "mapbox_token": {
      "version": 0,
      "block": {
        "attributes": {
          "allowed_urls": {
            "type": [
              "set",
              "string"
            ],
            "description": "URLs that this token is allowed to work with.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Token identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "note": {
            "type": "string",
            "description": "A description for the token.",
            "description_kind": "markdown",
            "required": true
          },
          "scopes": {
            "type": [
              "set",
              "string"
            ],
            "description": "Specify the scopes that the new token will have. The authorizing token needs to have the same scopes as, or more scopes than, the new token you are creating.",
            "description_kind": "markdown",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "Token value",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "username": {
            "type": "string",
            "description": "The username of the account for which to list scopes.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Token resource",
        "description_kind": "markdown"
      }
    }
  }
}
