{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "docker_hub_password": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "docker_hub_username": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "docker_downstream_image": {
      "version": 0,
      "block": {
        "attributes": {
          "downstream_repo": {
            "type": "string",
            "description": "full ECR repository name",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tag": {
            "type": "string",
            "description": "image tag",
            "description_kind": "plain",
            "required": true
          },
          "upstream_repo": {
            "type": "string",
            "description": "full public repository name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Pulls image from a public registry and pushes it to the private ECR",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "docker_upstream_image": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "repo": {
            "type": "string",
            "description": "full repository name",
            "description_kind": "plain",
            "required": true
          },
          "tag": {
            "type": "string",
            "description": "image tag",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Verifies the image presence in the repository",
        "description_kind": "plain"
      }
    }
  }
