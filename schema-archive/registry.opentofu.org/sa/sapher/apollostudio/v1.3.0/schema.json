{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API key to authenticate to Apollo GraphQL API. Can also be set via the `APOLLO_KEY` environment variable",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "Host of the Apollo GraphQL API. Defaults to `https://graphql.api.apollographql.com/api/graphql`",
          "description_kind": "plain",
          "optional": true
        },
        "org_id": {
          "type": "string",
          "description": "Organization ID on Apollo GraphQL. Can also be set via the `APOLLO_ORG_ID` environment variable",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with Apollo GraphQL API",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "apollostudio_graph": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the graph",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the graph. This is an immutable value and cannot be changed and must be unique across all graphs",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the graph",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage a graph",
        "description_kind": "plain"
      }
    },
    "apollostudio_graph_api_key": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Creation date of the API key",
            "description_kind": "plain",
            "computed": true
          },
          "graph_id": {
            "type": "string",
            "description": "ID of the graph",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the API key",
            "description_kind": "plain",
            "computed": true
          },
          "key_name": {
            "type": "string",
            "description": "Name of the API key",
            "description_kind": "plain",
            "required": true
          },
          "role": {
            "type": "string",
            "description": "Role of the API key. This role can be either `GRAPH_ADMIN`, `CONTRIBUTOR`, `DOCUMENTER`, `OBSERVER` or `CONSUMER`",
            "description_kind": "plain",
            "computed": true
          },
          "token": {
            "type": "string",
            "description": "Authentication token of the API key. This value is only fully available when creating the API key, the current value is partially masked",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manage an API key for a specific graph",
        "description_kind": "plain"
      }
    },
    "apollostudio_subgraph": {
      "version": 0,
      "block": {
        "attributes": {
          "graph_id": {
            "type": "string",
            "description": "ID of the graph",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the subgraph",
            "description_kind": "plain",
            "required": true
          },
          "revision": {
            "type": "string",
            "description": "Revision of the subgraph variant",
            "description_kind": "plain",
            "computed": true
          },
          "schema": {
            "type": "string",
            "description": "Schema of the subgraph variant",
            "description_kind": "plain",
            "required": true
          },
          "url": {
            "type": "string",
            "description": "URL of the subgraph variant",
            "description_kind": "plain",
            "required": true
          },
          "variant_name": {
            "type": "string",
            "description": "Name of the subgraph variant",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage a subgraph",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "apollostudio_graph": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the graph",
            "description_kind": "plain",
            "computed": true
          },
          "graph_type": {
            "type": "string",
            "description": "Type of the graph. This can be one of: `CLASSIC`, `CLOUD_SUPERGRAPH`",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ID of the graph",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the graph",
            "description_kind": "plain",
            "computed": true
          },
          "reporting_enabled": {
            "type": "bool",
            "description": "Boolean indicating if reporting is enabled for the graph",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provide details about a specific graph",
        "description_kind": "plain"
      }
    },
    "apollostudio_graph_api_keys": {
      "version": 0,
      "block": {
        "attributes": {
          "api_keys": {
            "nested_type": {
              "attributes": {
                "created_at": {
                  "type": "string",
                  "description": "Creation date of the API key",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "ID of the API key",
                  "description_kind": "plain",
                  "computed": true
                },
                "key_name": {
                  "type": "string",
                  "description": "Name of the API key",
                  "description_kind": "plain",
                  "computed": true
                },
                "role": {
                  "type": "string",
                  "description": "Role of the API key. This role can be either `GRAPH_ADMIN`, `CONTRIBUTOR`, `DOCUMENTER`, `OBSERVER` or `CONSUMER`",
                  "description_kind": "plain",
                  "computed": true
                },
                "token": {
                  "type": "string",
                  "description": "Authentication token of the API key. This value is only fully available when creating the API key, the current value is partially masked",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of API keys",
            "description_kind": "plain",
            "computed": true
          },
          "graph_id": {
            "type": "string",
            "description": "ID of the graph linked to the API keys",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Provide details about a specific graph's API keys. Beware that the API key token is partially masked when read, it's only available at creation time.",
        "description_kind": "plain"
      }
    },
    "apollostudio_graph_variant": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the variant",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the variant",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provide details about a specific graph variant",
        "description_kind": "plain"
      }
    },
    "apollostudio_graph_variants": {
      "version": 0,
      "block": {
        "attributes": {
          "graph_id": {
            "type": "string",
            "description": "ID of the graph",
            "description_kind": "plain",
            "required": true
          },
          "variants": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "ID of the variant",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the variant",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of graph variants",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provide details about a specific graph variants",
        "description_kind": "plain"
      }
    },
    "apollostudio_graphs": {
      "version": 0,
      "block": {
        "attributes": {
          "graphs": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "Description of the graph",
                  "description_kind": "plain",
                  "computed": true
                },
                "graph_type": {
                  "type": "string",
                  "description": "Type of the graph. This can be one of: `CLASSIC`, `CLOUD_SUPERGRAPH`",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "ID of the graph",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the graph",
                  "description_kind": "plain",
                  "computed": true
                },
                "reporting_enabled": {
                  "type": "bool",
                  "description": "Boolean indicating if reporting is enabled for the graph",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of graphs",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provide details about a specific organization's graphs",
        "description_kind": "plain"
      }
    },
    "apollostudio_me": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the user",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the user",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provides details about the current authenticated user",
        "description_kind": "plain"
      }
    },
    "apollostudio_org": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the organization. Be mindful that this is ID can be changed by administrators and therefore should not be used as a unique identifier",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Organization",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provides details about the current organization",
        "description_kind": "plain"
      }
    },
    "apollostudio_subgraphs": {
      "version": 0,
      "block": {
        "attributes": {
          "graph_id": {
            "type": "string",
            "description": "ID of the graph",
            "description_kind": "plain",
            "required": true
          },
          "include_deleted": {
            "type": "bool",
            "description": "Boolean indicating if deleted subgraphs should be included in the result",
            "description_kind": "plain",
            "optional": true
          },
          "subgraphs": {
            "nested_type": {
              "attributes": {
                "active_schema": {
                  "nested_type": {
                    "attributes": {
                      "created_at": {
                        "type": "string",
                        "description": "Creation date of the active schema",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "is_live": {
                        "type": "bool",
                        "description": "Boolean indicating if the active schema is live",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "sdl": {
                        "type": "string",
                        "description": "SDL of the active schema",
                        "description_kind": "plain",
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Provide details about the subgraph active schema",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the subgraph",
                  "description_kind": "plain",
                  "computed": true
                },
                "revision": {
                  "type": "string",
                  "description": "Revision of the subgraph",
                  "description_kind": "plain",
                  "computed": true
                },
                "url": {
                  "type": "string",
                  "description": "Routing URL of the subgraph",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of graph subgraphs",
            "description_kind": "plain",
            "computed": true
          },
          "variant_name": {
            "type": "string",
            "description": "Name of the variant",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Provide details about a specific variant's subgraphs",
        "description_kind": "plain"
      }
    }
  }
}
