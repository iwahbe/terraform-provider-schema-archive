{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "API token ",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "API endpoint",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "snyk_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Snyk Environment ID",
            "description_kind": "markdown",
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "One of [aws,azure,google]",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "User assigned name",
            "description_kind": "markdown",
            "optional": true
          },
          "organization_id": {
            "type": "string",
            "description": "Snyk Organization GUID",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "aws": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "role_arn": {
                  "type": "string",
                  "description": "ARN of the AWS role created for Snyk Cloud",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          },
          "azure": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "application_id": {
                  "type": "string",
                  "description": "ID of the Azure app registration with permissions to scan",
                  "description_kind": "plain",
                  "optional": true
                },
                "subscription_id": {
                  "type": "string",
                  "description": "ID of the Azure subscription to be scanned",
                  "description_kind": "plain",
                  "optional": true
                },
                "tenant_id": {
                  "type": "string",
                  "description": "Azure Tenant (directory) ID",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          },
          "google": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "project_id": {
                  "type": "string",
                  "description": "Google project ID",
                  "description_kind": "plain",
                  "optional": true
                },
                "service_account_email": {
                  "type": "string",
                  "description": "Google service account email",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Provides Snyk [Cloud Environments](https://docs.snyk.io/scan-cloud-deployment/snyk-cloud/snyk-cloud-concepts#environments)",
        "description_kind": "markdown"
      }
    },
    "snyk_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "group_id": {
            "type": "string",
            "description": "The group ID. The API_KEY must have access to this group.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Snyk organization id",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the organization",
            "description_kind": "markdown",
            "required": true
          },
          "source_organization_id": {
            "type": "string",
            "description": "The id of an organization to copy settings from.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Provides Snyk [Organizations](https://docs.snyk.io/snyk-admin/manage-groups-and-organizations/whats-a-snyk-organization)",
        "description_kind": "markdown"
      }
    }
  }
}
