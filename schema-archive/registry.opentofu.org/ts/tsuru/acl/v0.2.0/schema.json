{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "Target to tsuru API",
          "description_kind": "plain",
          "optional": true
        },
        "skip_cert_verification": {
          "type": "bool",
          "description": "Disable certificate verification",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Token to authenticate on tsuru API (optional)",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "acl_destination_rule": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "dns": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "ACL Instance Name",
            "description_kind": "plain",
            "required": true
          },
          "ip": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "pool": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "service_name": {
            "type": "string",
            "description": "ACL Service Name",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "port": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "number": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "protocol": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          },
          "rpaas": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "instance": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "service_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
