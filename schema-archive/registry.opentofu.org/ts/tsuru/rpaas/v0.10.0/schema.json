{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "http_timeout_in_seconds": {
          "type": "number",
          "description": "Timeout in seconds a HTTP request can take. Zero means no limit.",
          "description_kind": "plain",
          "optional": true
        },
        "rpaas_password": {
          "type": "string",
          "description": "Password to authentication on RPaaS API",
          "description_kind": "plain",
          "optional": true
        },
        "rpaas_url": {
          "type": "string",
          "description": "URL address for RPaaS API.",
          "description_kind": "plain",
          "optional": true
        },
        "rpaas_user": {
          "type": "string",
          "description": "Username to authenticate on RPaaS API.",
          "description_kind": "plain",
          "optional": true
        },
        "skip_cert_verification": {
          "type": "bool",
          "description": "Whether should skip certificate verification during TLS protocol.",
          "description_kind": "plain",
          "optional": true
        },
        "tsuru_target": {
          "type": "string",
          "description": "URL address for Tsuru API.",
          "description_kind": "plain",
          "optional": true
        },
        "tsuru_token": {
          "type": "string",
          "description": "Authentication token for Tsuru API.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "rpaas_acl": {
      "version": 0,
      "block": {
        "attributes": {
          "host": {
            "type": "string",
            "description": "Hostname of desired destination",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "RPaaS Instance Name",
            "description_kind": "plain",
            "required": true
          },
          "port": {
            "type": "number",
            "description": "Number of port",
            "description_kind": "plain",
            "required": true
          },
          "service_name": {
            "type": "string",
            "description": "RPaaS Service Name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "rpaas_autoscale": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "RPaaS Instance Name",
            "description_kind": "plain",
            "required": true
          },
          "max_replicas": {
            "type": "number",
            "description": "Maximum number of replicas",
            "description_kind": "plain",
            "required": true
          },
          "min_replicas": {
            "type": "number",
            "description": "Minimum number of replicas",
            "description_kind": "plain",
            "required": true
          },
          "service_name": {
            "type": "string",
            "description": "RPaaS Service Name",
            "description_kind": "plain",
            "required": true
          },
          "target_cpu_utilization_percentage": {
            "type": "number",
            "description": "Target average CPU utilization (represented as a percentage of requested CPU) over all the pods.",
            "description_kind": "plain",
            "optional": true
          },
          "target_requests_per_second": {
            "type": "number",
            "description": "Target average of HTTP requests per second over the serving pods",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "scale_down": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "percentage": {
                  "type": "number",
                  "description": "Percentage of units to scale down",
                  "description_kind": "plain",
                  "optional": true
                },
                "stabilization_window": {
                  "type": "number",
                  "description": "Stabilization window in seconds",
                  "description_kind": "plain",
                  "optional": true
                },
                "units": {
                  "type": "number",
                  "description": "Number of units to scale down",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Behavior of the auto scale down",
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "scheduled_window": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "end": {
                  "type": "string",
                  "description": "An Cron expression defining the end of the scheduled window. Example: `00 00 * * * 1-5`.",
                  "description_kind": "plain",
                  "required": true
                },
                "min_replicas": {
                  "type": "number",
                  "description": "Min number of running pods while this window is active. It cannot be greater than `max_replicas`.",
                  "description_kind": "plain",
                  "required": true
                },
                "start": {
                  "type": "string",
                  "description": "An Cron expression defining the start of the scheduled window. Example: `00 20 * * * 1-5`.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Scheduled windows are recurring (or not) time windows where the instance can scale in/out your min replicas regardless of traffic or resource utilization.",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "rpaas_block": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "Custom Nginx configuration",
            "description_kind": "plain",
            "required": true
          },
          "extend": {
            "type": "bool",
            "description": "Extend is a flag to indicate if the block should be appended to the default configuration, only valid when specify a server_name.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "RPaaS Instance Name",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the block that will receive the custom configuration content. Allowed values: [root http server lua-server lua-worker]",
            "description_kind": "plain",
            "required": true
          },
          "server_name": {
            "type": "string",
            "description": "Optional parameter used to match the server name in the block. If not provided, it will apply to all servers.",
            "description_kind": "plain",
            "optional": true
          },
          "service_name": {
            "type": "string",
            "description": "RPaaS Service Name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "rpaas_cert_manager": {
      "version": 0,
      "block": {
        "attributes": {
          "certificate_name": {
            "type": "string",
            "description": "Certificate Name",
            "description_kind": "plain",
            "required": true
          },
          "dns_names": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of DNS names to be associated with the certificate in Subject Alternative Names extension",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "RPaaS Instance Name",
            "description_kind": "plain",
            "required": true
          },
          "issuer": {
            "type": "string",
            "description": "Certificate issuer name",
            "description_kind": "plain",
            "required": true
          },
          "service_name": {
            "type": "string",
            "description": "RPaaS Service Name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "rpaas_certificate": {
      "version": 0,
      "block": {
        "attributes": {
          "certificate": {
            "type": "string",
            "description": "Certificate content",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "RPaaS Instance Name",
            "description_kind": "plain",
            "required": true
          },
          "key": {
            "type": "string",
            "description": "Key content",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "Name of certificate",
            "description_kind": "plain",
            "required": true
          },
          "service_name": {
            "type": "string",
            "description": "RPaaS Service Name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "rpaas_file": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "Content of the persistent file in the instance filesystem, expected to be an UTF-8 encoded string.",
            "description_kind": "plain",
            "optional": true
          },
          "content_base64": {
            "type": "string",
            "description": "Content of the persistent file in the instance filesystem, expected to be binary encoded as base64 string. (v0.2.3)",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "RPaaS Instance Name",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of a persistent file in the instance filesystem",
            "description_kind": "plain",
            "required": true
          },
          "service_name": {
            "type": "string",
            "description": "RPaaS Service Name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "rpaas_route": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "Custom Nginx configuration content",
            "description_kind": "plain",
            "optional": true
          },
          "destination": {
            "type": "string",
            "description": "Custom Nginx upstream destination",
            "description_kind": "plain",
            "optional": true
          },
          "https_only": {
            "type": "bool",
            "description": "Only on https",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "RPaaS Instance Name",
            "description_kind": "plain",
            "required": true
          },
          "path": {
            "type": "string",
            "description": "Path for this route",
            "description_kind": "plain",
            "required": true
          },
          "server_name": {
            "type": "string",
            "description": "Optional parameter used to match the server name in the location block. If not provided, it will apply to all servers.",
            "description_kind": "plain",
            "optional": true
          },
          "service_name": {
            "type": "string",
            "description": "RPaaS Service Name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "rpaas_upstream": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "Primary app name",
            "description_kind": "plain",
            "required": true
          },
          "canary": {
            "type": [
              "list",
              "string"
            ],
            "description": "Canary app names that participate in traffic distribution",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "RPaaS Instance Name",
            "description_kind": "plain",
            "required": true
          },
          "load_balance": {
            "type": "string",
            "description": "Load balancing algorithm to be used for this upstream. Defaults to 'round_robin' if not specified",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "load_balance_hash_key": {
            "type": "string",
            "description": "Nginx variable for consistent hashing when load_balance is 'chash'",
            "description_kind": "plain",
            "optional": true
          },
          "service_name": {
            "type": "string",
            "description": "RPaaS Service Name",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "traffic_shaping_policy": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "cookie": {
                  "type": "string",
                  "description": "Cookie on which to redirect requests to this backend",
                  "description_kind": "plain",
                  "optional": true
                },
                "header": {
                  "type": "string",
                  "description": "Header on which to redirect requests to this backend",
                  "description_kind": "plain",
                  "optional": true
                },
                "header_pattern": {
                  "type": "string",
                  "description": "Header value match pattern, support exact, regex",
                  "description_kind": "plain",
                  "optional": true
                },
                "header_value": {
                  "type": "string",
                  "description": "Header value on which to redirect requests to this backend",
                  "description_kind": "plain",
                  "optional": true
                },
                "weight": {
                  "type": "number",
                  "description": "Weight for weight-based routing",
                  "description_kind": "plain",
                  "optional": true
                },
                "weight_total": {
                  "type": "number",
                  "description": "Total weight for weight-based routing",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Traffic shaping policy for this upstream",
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
