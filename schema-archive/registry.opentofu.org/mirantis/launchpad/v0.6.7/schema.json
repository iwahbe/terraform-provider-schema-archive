{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "launchpad_config": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Example identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "skip_create": {
            "type": "bool",
            "description": "Skip apply on create",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "skip_destroy": {
            "type": "bool",
            "description": "Skip reset on destroy",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "metadata": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Cluster name",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "Metadata for the launchpad cluster",
              "description_kind": "markdown"
            }
          },
          "spec": {
            "nesting_mode": "single",
            "block": {
              "block_types": {
                "cluster": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "prune": {
                        "type": "bool",
                        "description": "Prune cluster resources orphaned on apply",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "description": "MSR installation configuration",
                    "description_kind": "markdown"
                  }
                },
                "host": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "role": {
                        "type": "string",
                        "description": "Host machine role in the cluster",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "block_types": {
                      "hooks": {
                        "nesting_mode": "list",
                        "block": {
                          "block_types": {
                            "apply": {
                              "nesting_mode": "list",
                              "block": {
                                "attributes": {
                                  "after": {
                                    "type": [
                                      "list",
                                      "string"
                                    ],
                                    "description": "String hooks to run on hosts after the Apply operation is run.",
                                    "description_kind": "markdown",
                                    "optional": true,
                                    "computed": true
                                  },
                                  "before": {
                                    "type": [
                                      "list",
                                      "string"
                                    ],
                                    "description": "String hooks to run on hosts before the Apply operation is run.",
                                    "description_kind": "markdown",
                                    "optional": true,
                                    "computed": true
                                  }
                                },
                                "description": "Launchpad.Apply string hooks for the host",
                                "description_kind": "markdown"
                              }
                            }
                          },
                          "description": "Hook configuration for the host",
                          "description_kind": "markdown"
                        }
                      },
                      "mcr_config": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "bip": {
                              "type": "string",
                              "description": "Base IP",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "debug": {
                              "type": "bool",
                              "description": "Log level",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "default_address_pools": {
                              "nested_type": {
                                "attributes": {
                                  "base": {
                                    "type": "string",
                                    "description": "The CIDR range allocated for bridge networks in each IP address pool.",
                                    "description_kind": "markdown",
                                    "required": true
                                  },
                                  "size": {
                                    "type": "number",
                                    "description": "The CIDR netmask that determines the subnet size to allocate from the base pool.",
                                    "description_kind": "markdown",
                                    "optional": true,
                                    "computed": true
                                  }
                                },
                                "nesting_mode": "list"
                              },
                              "description": "Reassign docker subnets",
                              "description_kind": "markdown",
                              "optional": true
                            }
                          },
                          "description": "MCR configuration for the host",
                          "description_kind": "markdown"
                        }
                      },
                      "ssh": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "address": {
                              "type": "string",
                              "description": "SSH endpoint",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "key_path": {
                              "type": "string",
                              "description": "SSH endpoint",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "port": {
                              "type": "number",
                              "description": "SSH Port",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "user": {
                              "type": "string",
                              "description": "SSH endpoint",
                              "description_kind": "markdown",
                              "required": true
                            }
                          },
                          "description": "SSH configuration for the host",
                          "description_kind": "markdown"
                        }
                      },
                      "winrm": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "address": {
                              "type": "string",
                              "description": "WinRM endpoint",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "insecure": {
                              "type": "bool",
                              "description": "If false, then no SSL certificate validation is used",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "password": {
                              "type": "string",
                              "description": "WinRM password",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "port": {
                              "type": "number",
                              "description": "WinRM Port",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "use_https": {
                              "type": "bool",
                              "description": "If false, then no HTTP is used for winrm transport",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "user": {
                              "type": "string",
                              "description": "WinRM user",
                              "description_kind": "markdown",
                              "required": true
                            }
                          },
                          "description": "WinRM configuration for the host",
                          "description_kind": "markdown"
                        }
                      }
                    },
                    "description": "Individual host configuration, for each machine in the cluster",
                    "description_kind": "markdown"
                  }
                },
                "mcr": {
                  "nesting_mode": "single",
                  "block": {
                    "attributes": {
                      "channel": {
                        "type": "string",
                        "description": "Repitory installation channel",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "install_url_linux": {
                        "type": "string",
                        "description": "MCR installation script for linux installations",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "install_url_windows": {
                        "type": "string",
                        "description": "MCR installation script for windows installations",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "repo_url": {
                        "type": "string",
                        "description": "Repository installation URL for installation script",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "version": {
                        "type": "string",
                        "description": "MCR version to install",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "description": "MCR installation configuration",
                    "description_kind": "markdown"
                  }
                },
                "mke": {
                  "nesting_mode": "single",
                  "block": {
                    "attributes": {
                      "admin_password": {
                        "type": "string",
                        "description": "MKE admin user password",
                        "description_kind": "markdown",
                        "required": true,
                        "sensitive": true
                      },
                      "admin_username": {
                        "type": "string",
                        "description": "MKE admin user name",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "config_data": {
                        "type": "string",
                        "description": "Inline toml config data",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "config_file": {
                        "type": "string",
                        "description": "Path to toml config file",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "image_repo": {
                        "type": "string",
                        "description": "Image repo for MKE images",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "install_flags": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Optional MKE bootstrapper install flags",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "license_file_path": {
                        "type": "string",
                        "description": "MKE license file path",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "upgrade_flags": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Optional MKE bootstrapper update flags",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "version": {
                        "type": "string",
                        "description": "MKE version to install",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "block_types": {
                      "cloud": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "config_data": {
                              "type": "string",
                              "description": "Cloud provider inline configuration",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "config_file": {
                              "type": "string",
                              "description": "Cloud provider config file path",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "provider": {
                              "type": "string",
                              "description": "Cloud Provider plugin to use",
                              "description_kind": "markdown",
                              "required": true
                            }
                          },
                          "description": "Cloud Provider configuration",
                          "description_kind": "markdown"
                        }
                      }
                    },
                    "description": "MKE installation configuration",
                    "description_kind": "markdown"
                  }
                },
                "msr": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "image_repo": {
                        "type": "string",
                        "description": "Image repo for MSR images",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "install_flags": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Optional MSR bootstrapper install flags",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "replica_ids": {
                        "type": "string",
                        "description": "MSR replica IDs as a string",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "upgrade_flags": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Optional MSR bootstrapper update flags",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "version": {
                        "type": "string",
                        "description": "MCR version to install",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "description": "MSR installation configuration",
                    "description_kind": "markdown"
                  }
                }
              },
              "description": "Launchpad install specifications",
              "description_kind": "markdown"
            }
          }
        },
        "description": "Mirantis installation using launchpad, parametrized",
        "description_kind": "markdown"
      }
    }
  }
}
