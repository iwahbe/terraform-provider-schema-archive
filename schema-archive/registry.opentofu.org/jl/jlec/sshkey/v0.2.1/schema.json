{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "sshkey_pair": {
      "version": 0,
      "block": {
        "attributes": {
          "bits": {
            "type": "number",
            "description": "When `algorithm` is `RSA`, the size of the generated RSA key, in bits (default: `2048`).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "comment": {
            "type": "string",
            "description": "SSH key comment",
            "description_kind": "markdown",
            "optional": true
          },
          "fingerprint_md5": {
            "type": "string",
            "description": "OpenSSH key md5 fingerprint",
            "description_kind": "markdown",
            "computed": true
          },
          "fingerprint_sha256": {
            "type": "string",
            "description": "OpenSSH key sha256 fingerprint",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "SSHKey identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "private_key": {
            "type": "string",
            "description": "OpenSSH private key",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "public_key": {
            "type": "string",
            "description": "OpenSSH public key",
            "description_kind": "markdown",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "SSH key type. Supported types are `rsa` and `ed25519`.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Openssh key resource",
        "description_kind": "markdown"
      }
    }
  }
}
