          "index_id": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          },
          "link_documents": {
            "type": "bool",
            "description": "Enable this option to have this node act as a container for documents and not as a parent for further nodes. Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "node_id": {
            "type": "number",
            "description": "Use this property when setting parent node ids.",
            "description_kind": "markdown",
            "computed": true
          },
          "parent_id": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mayanedms_metadata_type": {
      "version": 0,
      "block": {
        "attributes": {
          "default": {
            "type": "string",
