          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Short description of this metadata type.",
            "description_kind": "markdown",
            "required": true
          },
          "lookup": {
            "type": "string",
            "description": "Defaults to ``.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name used by other apps to reference this metadata type. Do not use python reserved words, or spaces.",
            "description_kind": "markdown",
            "required": true
          },
          "parser": {
            "type": "string",
            "description": "The parser will reformat the value entered to conform to the expected format. Defaults to ``.",
            "description_kind": "markdown",
            "optional": true
          },
          "validator": {
            "type": "string",
            "description": "The validator will reject data entry if the value entered does not conform to the expected format. Defaults to ``.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
