{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "insecure": {
          "type": "bool",
          "description": "Whether SSL should be verified or not Defaults to `false`.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password for mayan edms api",
          "description_kind": "markdown",
          "required": true
        },
        "url": {
          "type": "string",
          "description": "Hostname of the mayan edms host",
          "description_kind": "markdown",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "User account for mayan edms api",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "mayanedms_document_type": {
      "version": 0,
      "block": {
        "attributes": {
          "delete_time_period": {
            "type": "number",
            "description": "Amount of time after which documents of this type will be moved to the trash Defaults to `30`.",
            "description_kind": "markdown",
            "optional": true
          },
          "delete_time_unit": {
            "type": "string",
            "description": "Unit of delete_time_period. (minutes, hours, days) Defaults to `days`.",
            "description_kind": "markdown",
            "optional": true
          },
          "filename_generator_backend": {
            "type": "string",
            "description": "The class responsible for producing the actual filename used to store the uploaded documents Defaults to `uuid`.",
            "description_kind": "markdown",
            "optional": true
          },
          "filename_generator_backend_arguments": {
            "type": "string",
            "description": "The arguments for the filename generator backend as a YAML dictionary. Defaults to ``.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "trash_time_period": {
            "type": "number",
            "description": "Amount of time after which documents of this type in the trash will be deleted.",
            "description_kind": "markdown",
            "optional": true
          },
          "trash_time_unit": {
            "type": "string",
            "description": "Unit of trash_time_period. (minutes, hours, days)",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mayanedms_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "users": {
            "type": [
              "set",
              "number"
            ],
            "description": "Collection of user IDs to include in the group.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mayanedms_index_template": {
      "version": 0,
      "block": {
        "attributes": {
          "document_types": {
            "type": [
              "set",
              "number"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "Causes this index to be visible and updated when document data changes. Defaults to `true`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "The name that will be visible to users.",
            "description_kind": "markdown",
            "required": true
          },
          "root_node_id": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "slug": {
            "type": "string",
            "description": "Internal name used to reference this index.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mayanedms_index_template_node": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Causes this node to be visible and updated when document data changes. Defaults to `true`.",
            "description_kind": "markdown",
            "optional": true
          },
          "expression": {
            "type": "string",
            "description": "Enter a python string expression to be evaluated",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
