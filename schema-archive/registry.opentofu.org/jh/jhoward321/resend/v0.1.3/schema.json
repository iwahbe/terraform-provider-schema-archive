{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Resend API key. Can also be set via `RESEND_API_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Resend provider manages resources for the [Resend](https://resend.com) email API, including domains, API keys, and webhooks.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "resend_api_key": {
      "version": 0,
      "block": {
        "attributes": {
          "domain_id": {
            "type": "string",
            "description": "Restrict to a specific domain. Only used with `sending_access`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "API key identifier.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The API key name.",
            "description_kind": "markdown",
            "required": true
          },
          "permission": {
            "type": "string",
            "description": "`full_access` or `sending_access`. Defaults to `full_access`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "token": {
            "type": "string",
            "description": "The generated API key token. Only available at creation time.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manages a Resend API key.",
        "description_kind": "markdown"
      }
    },
    "resend_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Timestamp when the domain was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "dkim_records": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "DNS record hostname.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "record": {
                  "type": "string",
                  "description": "Record purpose (e.g., `SPF`, `DKIM`).",
                  "description_kind": "markdown",
                  "computed": true
                },
                "status": {
                  "type": "string",
                  "description": "Verification status of this record.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "ttl": {
                  "type": "string",
                  "description": "Time to live.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "DNS record type (e.g., `MX`, `TXT`, `CNAME`).",
                  "description_kind": "markdown",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description": "DNS record value.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "DKIM records for domain verification.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Domain identifier.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The domain name (e.g., `example.com`).",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "AWS region for the domain (e.g., `us-east-1`).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "spf_mx_record": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "DNS record hostname.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "priority": {
                  "type": "string",
                  "description": "MX record priority.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "record": {
                  "type": "string",
                  "description": "Record purpose (e.g., `SPF`, `DKIM`).",
                  "description_kind": "markdown",
                  "computed": true
                },
                "status": {
                  "type": "string",
                  "description": "Verification status of this record.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "ttl": {
                  "type": "string",
                  "description": "Time to live.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "DNS record type (e.g., `MX`, `TXT`, `CNAME`).",
                  "description_kind": "markdown",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description": "DNS record value.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "SPF MX record for domain verification.",
            "description_kind": "markdown",
            "computed": true
          },
          "spf_txt_record": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "DNS record hostname.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "record": {
                  "type": "string",
                  "description": "Record purpose (e.g., `SPF`, `DKIM`).",
                  "description_kind": "markdown",
                  "computed": true
                },
                "status": {
                  "type": "string",
                  "description": "Verification status of this record.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "ttl": {
                  "type": "string",
                  "description": "Time to live.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "DNS record type (e.g., `MX`, `TXT`, `CNAME`).",
                  "description_kind": "markdown",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description": "DNS record value.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "SPF TXT record for domain verification.",
            "description_kind": "markdown",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Domain verification status.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manages a Resend sending domain.",
        "description_kind": "markdown"
      }
    },
    "resend_webhook": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Timestamp when the webhook was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "event_types": {
            "type": [
              "list",
              "string"
            ],
            "description": "Event types to subscribe to (e.g., `email.sent`, `email.delivered`, `email.bounced`).",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Webhook identifier.",
            "description_kind": "markdown",
            "computed": true
          },
          "signing_secret": {
            "type": "string",
            "description": "The webhook signing secret. Only available at creation time; will be empty after `terraform import`.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "url": {
            "type": "string",
            "description": "The URL to receive webhook events.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a Resend webhook endpoint.",
        "description_kind": "markdown"
      }
    }
  }
}
