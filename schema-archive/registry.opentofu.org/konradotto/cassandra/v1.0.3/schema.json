{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "connection_timeout": {
          "type": "number",
          "description": "Connection timeout in milliseconds",
          "description_kind": "plain",
          "optional": true
        },
        "consistency": {
          "type": "string",
          "description": "Default consistency level",
          "description_kind": "plain",
          "optional": true
        },
        "cql_version": {
          "type": "string",
          "description": "CQL version",
          "description_kind": "plain",
          "optional": true
        },
        "disable_initial_host_lookup": {
          "type": "bool",
          "description": "Whether the driver will not attempt to get host info from the system.peers table",
          "description_kind": "plain",
          "optional": true
        },
        "enable_host_verification": {
          "type": "bool",
          "description": "Option to disable host verification with SSL. Setting this to false is equivalent to setting SSL_VALIDATE=false with cql",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "Cassandra host",
          "description_kind": "plain",
          "optional": true
        },
        "host_filter": {
          "type": "bool",
          "description": "Filter all incoming events for host. Hosts have to exist before using this provider",
          "description_kind": "plain",
          "optional": true
        },
        "hosts": {
          "type": [
            "list",
            "string"
          ],
          "description": "Cassandra hosts",
          "description_kind": "plain",
          "optional": true
        },
        "insecure_skip_verify": {
          "type": "bool",
          "description": "Skip verifying the remote certificate from the cql client",
          "description_kind": "plain",
          "optional": true
        },
        "keyspace": {
          "type": "string",
          "description": "Initial Keyspace",
          "description_kind": "plain",
          "optional": true
        },
        "min_tls_version": {
          "type": "string",
          "description": "Minimum TLS Version used to connect to the cluster - allowed values are TLS1.0, TLS1.1, TLS1.2, TLS1.3. Applies only when use_ssl is enabled",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Cassandra password",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "port": {
          "type": "number",
          "description": "Cassandra CQL Port",
          "description_kind": "plain",
          "optional": true
        },
        "protocol_version": {
          "type": "number",
          "description": "CQL Binary Protocol Version",
          "description_kind": "plain",
          "optional": true
        },
        "pw_encryption_algorithm": {
          "type": "string",
          "description": "Password encryption algorithm. Allowed values: bcrypt, sha-512",
          "description_kind": "plain",
          "optional": true
        },
        "root_ca": {
          "type": "string",
          "description": "Use root CA to connect to Cluster. Applies only when use_ssl is enabled",
          "description_kind": "plain",
          "optional": true
        },
        "system_keyspace_name": {
          "type": "string",
          "description": "System keyspace name for roles and grants",
          "description_kind": "plain",
          "optional": true
        },
        "use_ssl": {
          "type": "bool",
          "description": "Use SSL when connecting to cluster",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Cassandra username",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "cassandra_grant": {
      "version": 0,
      "block": {
        "attributes": {
          "function_name": {
            "type": "string",
            "description": "keyspace qualifier to the resource, only applicable for resource all functions in keyspace, function, keyspace, table",
            "description_kind": "plain",
            "optional": true
          },
          "grantee": {
            "type": "string",
            "description": "role name who we are granting privilege(s) to",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "keyspace_name": {
            "type": "string",
            "description": "keyspace qualifier to the resource, only applicable for resource all functions in keyspace, function, keyspace, table",
            "description_kind": "plain",
            "optional": true
          },
          "mbean_name": {
            "type": "string",
            "description": "name of mbean, only applicable for resource mbean",
            "description_kind": "plain",
            "optional": true
          },
          "mbean_pattern": {
            "type": "string",
            "description": "pattern for selecting mbeans, only valid for resource mbeans",
            "description_kind": "plain",
            "optional": true
          },
          "privilege": {
            "type": "string",
            "description": "One of select, create, alter, drop, modify, authorize, describe, execute",
            "description_kind": "plain",
            "required": true
          },
          "resource_type": {
            "type": "string",
            "description": "Resource type we are granting privilege to. Must be one of all functions, all functions in keyspace, function, all keyspaces, keyspace, table, all roles, role, roles, mbean, mbeans, all mbeans",
            "description_kind": "plain",
            "required": true
          },
          "role_name": {
            "type": "string",
            "description": "name of the role, applicable only for resource role",
            "description_kind": "plain",
            "optional": true
          },
          "table_name": {
            "type": "string",
            "description": "name of the table, applicable only for resource table",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage Grants within your cassandra cluster",
        "description_kind": "plain"
      }
    },
    "cassandra_keyspace": {
      "version": 0,
      "block": {
        "attributes": {
          "durable_writes": {
            "type": "bool",
            "description": "Enable or disable durable writes - disabling is not recommended",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of keyspace",
            "description_kind": "plain",
            "required": true
          },
          "replication_strategy": {
            "type": "string",
            "description": "Keyspace replication strategy - must be one of SimpleStrategy or NetworkTopologyStrategy",
            "description_kind": "plain",
            "required": true
          },
          "strategy_options": {
            "type": [
              "map",
              "string"
            ],
            "description": "strategy options used with replication strategy",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage Keyspaces within your cassandra cluster",
        "description_kind": "plain"
      }
    },
    "cassandra_role": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "login": {
            "type": "bool",
            "description": "Enable login for the role",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of role",
            "description_kind": "plain",
            "required": true
          },
          "password": {
            "type": "string",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "super_user": {
            "type": "bool",
            "description": "Allow role to create and manage other roles",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage Roles within your cassandra cluster",
        "description_kind": "plain"
      }
    },
    "cassandra_table": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "keyspace": {
            "type": "string",
            "description": "Keyspace to create table within",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of table - must contain between 1 and 256 characters",
            "description_kind": "plain",
            "required": true
          },
          "range_keys": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of Range Keys",
            "description_kind": "plain",
            "optional": true
          },
          "row_keys": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of Row Primary Keys",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "attribute": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "List of Row Keys",
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description": "Create and Delete Tables within Keyspaces",
        "description_kind": "plain"
      }
    }
  }
}
