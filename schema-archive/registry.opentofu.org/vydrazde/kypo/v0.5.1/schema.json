{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "client_id": {
          "type": "string",
          "description": "KYPO local OIDC client ID. Will be ignored when `token` is set. Defaults to `KYPO-Client`. Can be set with `KYPO_CLIENT_ID` environmental variable. See [how to get KYPO client_id](https://registry.terraform.io/vydrazde/kypo/latest/docs/guides/getting_oidc_client_id).",
          "description_kind": "markdown",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "URI of the homepage of the KYPO instance, like `https://my.kypo.instance.ex`. Can be set with `KYPO_ENDPOINT` environmental variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "`password` of the user to login as with `username`. Use either `username` and `password` or just `token`. Can be set with `KYPO_PASSWORD` environmental variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "retry_count": {
          "type": "number",
          "description": "How many times to retry failed HTTP requests. There is a delay of 100ms before the first retry. For each following retry, the delay is doubled. Defaults to 0. Can be set with `KYPO_RETRY_COUNT` environmental variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Bearer token to be used. Takes precedence before `username` and `password`. Bearer tokens usually have limited lifespan. Can be set with `KYPO_TOKEN` environmental variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "`username` of the user to login as with `password`. Use either `username` and `password` or just `token`. Can be set with `KYPO_USERNAME` environmental variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "kypo_sandbox_allocation_unit": {
      "version": 0,
      "block": {
        "attributes": {
          "allocation_request": {
            "nested_type": {
              "attributes": {
                "allocation_unit_id": {
                  "type": "number",
                  "description": "Id of the associated allocation unit",
                  "description_kind": "markdown",
                  "computed": true
                },
                "created": {
                  "type": "string",
                  "description": "Date and time when the allocation request was created",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Id of the allocation request",
                  "description_kind": "markdown",
                  "computed": true
                },
                "stages": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Statuses of the allocation stages. List of three strings, where each is one of `IN_QUEUE`, `FINISHED`, `FAILED` or `RUNNING`",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Allocation request of the allocation unit",
            "description_kind": "markdown",
            "computed": true
          },
          "cleanup_request": {
            "nested_type": {
              "attributes": {
                "allocation_unit_id": {
                  "type": "number",
                  "description": "Id of the allocation unit",
                  "description_kind": "markdown",
                  "computed": true
                },
                "created": {
                  "type": "string",
                  "description": "Date and time when the allocation request was created",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Id of the cleanup request",
                  "description_kind": "markdown",
                  "computed": true
                },
                "stages": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Statuses of cleanup stages. List of three strings, where each is one of `IN_QUEUE`, `FINISHED`, `FAILED` or `RUNNING`",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Cleanup request of the allocation unit",
            "description_kind": "markdown",
            "computed": true
          },
          "created_by": {
            "nested_type": {
              "attributes": {
                "family_name": {
                  "type": "string",
                  "description": "Family name of the user",
                  "description_kind": "markdown",
                  "computed": true
                },
                "full_name": {
                  "type": "string",
                  "description": "Full name of the user",
                  "description_kind": "markdown",
                  "computed": true
                },
                "given_name": {
                  "type": "string",
                  "description": "Given name of the user",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Id of the user",
                  "description_kind": "markdown",
                  "computed": true
                },
                "mail": {
                  "type": "string",
                  "description": "Email of the user",
                  "description_kind": "markdown",
                  "computed": true
                },
                "sub": {
                  "type": "string",
                  "description": "Sub of the user as given by an OIDC provider",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Who created the sandbox allocation unit",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Id of the sandbox allocation unit",
            "description_kind": "markdown",
            "computed": true
          },
          "locked": {
            "type": "bool",
            "description": "Whether the allocation unit is locked. The allocation unit is locked when it is claimed by a Trainee and has an associated training run",
            "description_kind": "markdown",
            "computed": true
          },
          "poll_times": {
            "nested_type": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "Poll time for awaiting the allocation of the allocation unit, defaults to `10s`. Is used by both `Create` and `Update` operations.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description": "Poll time for awaiting the cleanup of the allocation unit, defaults to `5s`.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Times after which the result of the operation is periodically checked. Times are strings which can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration).",
            "description_kind": "markdown",
            "optional": true
          },
          "pool_id": {
            "type": "number",
            "description": "Id of the associated sandbox pool",
            "description_kind": "markdown",
            "required": true
          },
          "timeouts": {
            "nested_type": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.",
                  "description_kind": "plain",
                  "optional": true
                },
                "read": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Read operations occur during any refresh or planning operation when refresh is enabled.",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          },
          "warning_on_allocation_failure": {
            "type": "bool",
            "description": "Whether to emit a warning instead of error when one of the allocation request stages fails",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Sandbox allocation unit",
        "description_kind": "markdown"
      }
    },
