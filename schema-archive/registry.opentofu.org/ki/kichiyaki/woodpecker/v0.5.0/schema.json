{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "server": {
          "type": "string",
          "description": "This is the target Woodpecker CI base API endpoint. It must be provided, but\n\t\t\t\t\tcan also be sourced from the WOODPECKER_SERVER environment\n\t\t\t\t\tvariable.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "A Woodpecker CI Personal Access Token. It must be provided, but\n\t\t\t\t\tcan also be sourced from the WOODPECKER_TOKEN environment\n\t\t\t\t\tvariable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "A Terraform provider used to interact with [Woodpecker CI](https://woodpecker-ci.org/) resources.\n\n\n- v0.4.x and later versions of the provider work with Woodpecker 3.x+\n- v0.2.x and v0.3.x versions of the provider work with Woodpecker 3.0.0>1.x>=2.0.0\n- v0.1.x version of the provider works with Woodpecker 2.0.0>1.x>=1.0.0",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "woodpecker_org_secret": {
      "version": 1,
      "block": {
        "attributes": {
          "events": {
            "type": [
              "set",
              "string"
            ],
            "description": "events for which the secret is available (push, tag, pull_request, pull_request_closed, deployment, cron, manual, release)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "the secret's id",
            "description_kind": "plain",
            "computed": true
          },
          "images": {
            "type": [
              "set",
              "string"
            ],
            "description": "list of Docker images for which this secret is available, leave blank to allow all images",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "the name of the secret",
            "description_kind": "plain",
            "required": true
          },
          "org_id": {
            "type": "number",
            "description": "the ID of the organization",
            "description_kind": "plain",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "the value of the secret",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          }
        },
        "description": "This resource allows you to add/remove secrets that are only available to specific organizations. When applied, a new secret will be created. When destroyed, that secret will be removed. For more information see [the Woodpecker docs](https://woodpecker-ci.org/docs/usage/secrets).",
        "description_kind": "markdown"
      }
    },
    "woodpecker_repository": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_deployments": {
            "type": "bool",
            "description": "Enables a pipeline to be started with the deploy event from a successful pipeline.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "allow_pull_requests": {
            "type": "bool",
            "description": "Enables handling webhook's pull request event. If disabled, then pipeline won't run for pull requests.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "approval_allowed_users": {
            "type": [
              "set",
              "string"
            ],
            "description": "the list of users who's pipelines never require an approval",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "avatar_url": {
            "type": "string",
            "description": "the repository's avatar URL",
            "description_kind": "plain",
            "computed": true
          },
          "cancel_previous_pipeline_events": {
            "type": [
              "set",
              "string"
            ],
            "description": "Enables to cancel pending and running pipelines of the same event and context before starting the newly triggered one (push, tag, pull_request, deployment).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "clone_url": {
            "type": "string",
            "description": "the URL to clone repository",
            "description_kind": "plain",
            "computed": true
          },
          "config_file": {
            "type": "string",
            "description": "The path to the pipeline config file or folder. By default, it is left empty which will use the following configuration resolution .woodpecker/*.yml -> .woodpecker/*.yaml -> .woodpecker.yml -> .woodpecker.yaml.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "default_branch": {
            "type": "string",
            "description": "the name of the default branch",
            "description_kind": "plain",
            "computed": true
          },
          "forge_id": {
            "type": "number",
            "description": "the forge's id",
            "description_kind": "plain",
            "computed": true
          },
          "forge_remote_id": {
            "type": "string",
            "description": "the unique identifier for the repository on the forge",
            "description_kind": "plain",
            "computed": true
          },
          "forge_url": {
            "type": "string",
            "description": "the URL of the repository on the forge",
            "description_kind": "plain",
            "computed": true
          },
          "full_name": {
            "type": "string",
            "description": "the full name of the repository (format: owner/reponame)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "the repository's id",
            "description_kind": "plain",
            "computed": true
          },
          "is_active": {
            "type": "bool",
            "description": "whether the repo is active",
            "description_kind": "plain",
            "computed": true
          },
          "is_private": {
            "type": "bool",
            "description": "whether the repo (SCM) is private",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "the name of the repository",
            "description_kind": "plain",
            "computed": true
          },
          "netrc_trusted_plugins": {
            "type": [
              "set",
              "string"
            ],
            "description": "Plugins that get access to netrc credentials that can be used to clone repositories from the forge or push them into the forge.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "owner": {
            "type": "string",
            "description": "the owner of the repository",
            "description_kind": "plain",
            "computed": true
          },
          "require_approval": {
            "type": "string",
            "description": "Prevents malicious pipelines from exposing secrets or running harmful tasks by approving them before execution. Allowed values: forks, pull_requests, all_events",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "timeout": {
            "type": "number",
            "description": "after this timeout a pipeline has to finish or will be treated as timed out (in minutes)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "trusted": {
            "nested_type": {
              "attributes": {
                "network": {
                  "type": "bool",
                  "description": "Pipeline containers get access to network privileges like changing DNS.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "security": {
                  "type": "bool",
                  "description": "Pipeline containers get access to security privileges.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "volumes": {
                  "type": "bool",
                  "description": "Pipeline containers are allowed to mount volumes.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "visibility": {
            "type": "string",
            "description": "project visibility (public, private, internal), see [the docs](https://woodpecker-ci.org/docs/usage/project-settings#project-visibility) for more info",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Provides a repository resource.",
        "description_kind": "markdown"
      }
    },
    "woodpecker_repository_cron": {
      "version": 0,
      "block": {
        "attributes": {
          "branch": {
            "type": "string",
            "description": "the name of the branch (uses default branch if empty)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "created_at": {
            "type": "number",
            "description": "date the cron job was created",
            "description_kind": "plain",
            "computed": true
          },
          "creator_id": {
            "type": "number",
            "description": "id of user who created the cron job",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "the id of the cron job",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "the name of the cron job",
            "description_kind": "plain",
            "required": true
          },
          "repository_id": {
            "type": "number",
            "description": "the ID of the repository",
            "description_kind": "plain",
            "required": true
          },
          "schedule": {
            "type": "string",
            "description": "[cron expression](https://pkg.go.dev/github.com/robfig/cron#hdr-CRON_Expression_Format)",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "This resource allows you to add/remove cron jobs for specific repositories. When applied, a new cron job will be created. When destroyed, that cron job will be removed. For more information see [the Woodpecker docs](https://woodpecker-ci.org/docs/usage/cron).",
        "description_kind": "markdown"
      }
    },
    "woodpecker_repository_registry": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "the address of the registry (e.g. docker.io)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "the id of the registry",
            "description_kind": "plain",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "password used for authentication",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "repository_id": {
            "type": "number",
            "description": "the ID of the repository",
            "description_kind": "plain",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "username used for authentication",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "This resource allows you to add/remove container registries for specific repositories. When applied, a new registry will be created. When destroyed, that registry will be removed. For more information see [the Woodpecker docs](https://woodpecker-ci.org/docs/usage/registries).",
        "description_kind": "markdown"
      }
    },
