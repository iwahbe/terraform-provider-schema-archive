{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "Base URL of the Uptime Kuma instance (e.g., http://localhost:3001 or https://uptime.example.com)",
          "description_kind": "markdown",
          "required": true
        },
        "insecure_https": {
          "type": "bool",
          "description": "Skip TLS certificate verification",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password for authentication",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Username for authentication",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description": "Interact with Uptime Kuma",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "uptimekuma_monitor": {
      "version": 0,
      "block": {
        "attributes": {
          "auth_method": {
            "type": "string",
            "description": "Authentication method (basic, ntlm, mtls).",
            "description_kind": "markdown",
            "optional": true
          },
          "basic_auth_pass": {
            "type": "string",
            "description": "Basic auth password.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "basic_auth_user": {
            "type": "string",
            "description": "Basic auth username.",
            "description_kind": "markdown",
            "optional": true
          },
          "body": {
            "type": "string",
            "description": "Request body for http monitors.",
            "description_kind": "markdown",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Monitor description.",
            "description_kind": "markdown",
            "required": true
          },
          "headers": {
            "type": "string",
            "description": "Request headers for http monitors (JSON format).",
            "description_kind": "markdown",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description": "Hostname for ping, port, etc. monitors.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "Monitor identifier.",
            "description_kind": "markdown",
            "computed": true
          },
          "ignore_tls": {
            "type": "bool",
            "description": "Ignore TLS/SSL errors.",
            "description_kind": "markdown",
            "optional": true
          },
          "interval": {
            "type": "number",
            "description": "Check interval in seconds.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "keyword": {
            "type": "string",
            "description": "Keyword to search for in response.",
            "description_kind": "markdown",
            "optional": true
          },
          "max_redirects": {
            "type": "number",
            "description": "Maximum number of redirects to follow.",
            "description_kind": "markdown",
            "optional": true
          },
          "max_retries": {
            "type": "number",
            "description": "Maximum number of retries.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "method": {
            "type": "string",
            "description": "HTTP method (GET, POST, etc.) for http monitors.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Monitor name.",
            "description_kind": "markdown",
            "required": true
          },
          "port": {
            "type": "number",
            "description": "Port number for port monitors.",
            "description_kind": "markdown",
            "optional": true
          },
          "resend_interval": {
            "type": "number",
            "description": "Notification resend interval in seconds.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "retry_interval": {
            "type": "number",
            "description": "Retry interval in seconds.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Monitor type (http, ping, port, etc.).",
            "description_kind": "markdown",
            "required": true
          },
          "upside_down": {
            "type": "bool",
            "description": "Invert status (treat DOWN as UP and vice versa).",
            "description_kind": "markdown",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "URL to monitor (required for http, keyword monitors).",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages an Uptime Kuma monitor, allowing creation, modification, and deletion of various monitor types.",
        "description_kind": "markdown"
      }
    },
    "uptimekuma_status_page": {
      "version": 0,
      "block": {
        "attributes": {
          "custom_css": {
            "type": "string",
            "description": "Custom CSS for the status page",
            "description_kind": "markdown",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Status page description",
            "description_kind": "markdown",
            "optional": true
          },
          "domain_name_list": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of custom domain names for the status page",
            "description_kind": "markdown",
            "optional": true
          },
          "footer_text": {
            "type": "string",
            "description": "Custom footer text",
            "description_kind": "markdown",
            "optional": true
          },
          "google_analytics_id": {
            "type": "string",
            "description": "Google Analytics ID",
            "description_kind": "markdown",
            "optional": true
          },
          "icon": {
            "type": "string",
            "description": "Status page icon",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "Status page identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "public_group_list": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "number",
                  "description": "Group identifier",
                  "description_kind": "markdown",
                  "computed": true
                },
                "monitor_list": {
                  "type": [
                    "list",
                    "number"
                  ],
                  "description": "List of monitor IDs in the group",
                  "description_kind": "markdown",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Group name",
                  "description_kind": "markdown",
                  "required": true
                },
                "weight": {
                  "type": "number",
                  "description": "Group order weight",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of monitor groups displayed on the status page",
            "description_kind": "markdown",
            "optional": true
          },
          "published": {
            "type": "bool",
            "description": "Whether the status page is published",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "show_powered_by": {
            "type": "bool",
            "description": "Whether to show 'Powered by Uptime Kuma' text",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "show_tags": {
            "type": "bool",
            "description": "Whether to show tags on the status page",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "slug": {
            "type": "string",
            "description": "Status page URL slug",
            "description_kind": "markdown",
            "required": true
          },
          "theme": {
            "type": "string",
            "description": "Status page theme",
            "description_kind": "markdown",
            "optional": true
          },
          "title": {
            "type": "string",
            "description": "Status page title",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Uptime Kuma Status Page resource",
        "description_kind": "markdown"
      }
    }
  }
}
