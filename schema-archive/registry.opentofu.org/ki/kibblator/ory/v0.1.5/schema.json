{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "URI for the Ory Network console API. May also be provided with the ORY_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "project_id": {
          "type": "string",
          "description": "The project ID for the target Ory Network Project. May also be provided with the ORY_PROJECT_ID environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "workspace_api_key": {
          "type": "string",
          "description": "Your Ory Network workspace API key. May also be provided with the ORY_WORKSPACE_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ory_email_configuration": {
      "version": 0,
      "block": {
        "attributes": {
          "http_config": {
            "nested_type": {
              "attributes": {
                "action_body": {
                  "type": "string",
                  "description": "The base64 encoded action body for the HTTP server.",
                  "description_kind": "plain",
                  "optional": true
                },
                "api_key": {
                  "nested_type": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "The name of the API Key.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "transport_mode": {
                        "type": "string",
                        "description": "The transport mode for the HTTP server.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value": {
                        "type": "string",
                        "description": "The value of the API Key.",
                        "description_kind": "plain",
                        "required": true,
                        "sensitive": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "The API key for the HTTP server.",
                  "description_kind": "plain",
                  "optional": true
                },
                "authentication_type": {
                  "type": "string",
                  "description": "The authentication type for the HTTP server.",
                  "description_kind": "plain",
                  "required": true
                },
                "basic_auth": {
                  "nested_type": {
                    "attributes": {
                      "password": {
                        "type": "string",
                        "description": "The password for the HTTP server auth.",
                        "description_kind": "plain",
                        "required": true,
                        "sensitive": true
                      },
                      "username": {
                        "type": "string",
                        "description": "The username for the HTTP server auth.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "The basic auth configuration for the HTTP server.",
                  "description_kind": "plain",
                  "optional": true
                },
                "request_method": {
                  "type": "string",
                  "description": "The request method for the HTTP server.",
                  "description_kind": "plain",
                  "required": true
                },
                "url": {
                  "type": "string",
                  "description": "The URL of the HTTP server.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "HTTP configuration block (optional, but fields required if present).",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "String identifier of the email configuration resource.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update of the email configuration settings.",
            "description_kind": "plain",
            "computed": true
          },
          "server_type": {
            "type": "string",
            "description": "The type of the email server.",
            "description_kind": "plain",
            "required": true
          },
          "smtp_config": {
            "nested_type": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "The SMTP server host.",
                  "description_kind": "plain",
                  "required": true
                },
                "password": {
                  "type": "string",
                  "description": "The password for the SMTP server.",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "port": {
                  "type": "string",
                  "description": "The SMTP server port.",
                  "description_kind": "plain",
                  "required": true
                },
                "security": {
                  "type": "string",
                  "description": "The security type of the SMTP server.",
                  "description_kind": "plain",
                  "required": true
                },
                "sender_address": {
                  "type": "string",
                  "description": "The email address of the sender.",
                  "description_kind": "plain",
                  "required": true
                },
                "sender_name": {
                  "type": "string",
                  "description": "The name of the sender.",
                  "description_kind": "plain",
                  "required": true
                },
                "username": {
                  "type": "string",
                  "description": "The username for the SMTP server.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "SMTP configuration block (optional, but fields required if present).",
            "description_kind": "plain",
            "optional": true
          },
          "smtp_headers": {
            "nested_type": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "The key of the SMTP header.",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "The value of the SMTP header.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "SMTP headers block (required when server_type is smtp or http).",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "ory_registration": {
      "version": 0,
      "block": {
        "attributes": {
          "enable_login_hints": {
            "type": "bool",
            "description": "Login hints provide additional information to users when they try to sign up with an account, that already exists",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "enable_password_auth": {
            "type": "bool",
            "description": "If enabled, users will be able to sign in and register using a password.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "enable_post_signin_reg": {
            "type": "bool",
            "description": "If enabled, users will be automatically logged in after they register.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "enable_registration": {
            "type": "bool",
            "description": "If enabled, users can sign up using the selfservice UIs.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "String identifier of the registration resource.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update of the registration settings.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
