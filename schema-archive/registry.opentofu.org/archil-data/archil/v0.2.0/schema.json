{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API key for Archil. Can also be set via ARCHIL_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "Override the API endpoint URL. Can also be set via ARCHIL_ENDPOINT.",
          "description_kind": "plain",
          "optional": true
        },
        "region": {
          "type": "string",
          "description": "Archil region (e.g., aws-us-east-1). Can also be set via ARCHIL_REGION. Default: aws-us-east-1.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Manage Archil distributed filesystem resources.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "archil_api_token": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Creation timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Token description (max 500 chars).",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Token ID (hash).",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Token name (1-100 chars).",
            "description_kind": "plain",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "Full token value (only available at creation).",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "token_suffix": {
            "type": "string",
            "description": "Last 4 characters of the token.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages an Archil API token.",
        "description_kind": "plain"
      }
    },
    "archil_disk": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Creation timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "data_size": {
            "type": "number",
            "description": "Total data size in bytes.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Disk ID.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Disk name (1-100 chars, alphanumeric/dashes/underscores).",
            "description_kind": "plain",
            "required": true
          },
          "organization": {
            "type": "string",
            "description": "Owning organization.",
            "description_kind": "plain",
            "computed": true
          },
          "provider_name": {
            "type": "string",
            "description": "Cloud provider.",
            "description_kind": "plain",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Provider region.",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Disk status.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "mount": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "access_key_id": {
                  "type": "string",
                  "description": "Access key ID.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "bucket_endpoint": {
                  "type": "string",
                  "description": "Storage endpoint URL.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "bucket_name": {
                  "type": "string",
                  "description": "Bucket or container name.",
                  "description_kind": "plain",
                  "optional": true
                },
                "bucket_prefix": {
                  "type": "string",
                  "description": "Prefix within the bucket.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "client_id": {
                  "type": "string",
                  "description": "Azure AD client ID.",
                  "description_kind": "plain",
                  "optional": true
                },
                "client_secret": {
                  "type": "string",
                  "description": "Azure AD client secret.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "container_name": {
                  "type": "string",
                  "description": "Azure blob container name.",
                  "description_kind": "plain",
                  "optional": true
                },
                "endpoint": {
                  "type": "string",
                  "description": "Azure blob endpoint URL.",
                  "description_kind": "plain",
                  "optional": true
                },
                "secret_access_key": {
                  "type": "string",
                  "description": "Secret access key.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "session_id": {
                  "type": "string",
                  "description": "Session identifier for IAM role-based authentication. Used as the aws:PrincipalTag/archilSessionId condition in S3 bucket policies. Auto-generated when not set and no access keys are provided.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "session_token": {
                  "type": "string",
                  "description": "Session token for temporary credentials.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "storage_account_name": {
                  "type": "string",
                  "description": "Azure storage account name.",
                  "description_kind": "plain",
                  "optional": true
                },
                "tenant_id": {
                  "type": "string",
                  "description": "Azure AD tenant ID.",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "Mount type: s3, gcs, r2, s3-compatible, azure-blob.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Storage mount configuration. Exactly one mount block is required.",
              "description_kind": "plain"
            }
          }
        },
        "description": "Manages an Archil disk.",
        "description_kind": "plain"
      }
    },
    "archil_disk_user": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Creation timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "disk_id": {
            "type": "string",
            "description": "Disk ID to add the user to.",
            "description_kind": "plain",
            "required": true
          },
          "nickname": {
            "type": "string",
            "description": "Nickname (required when type=token).",
            "description_kind": "plain",
            "optional": true
          },
          "principal": {
            "type": "string",
            "description": "Token value or IAM ARN.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "token_suffix": {
            "type": "string",
            "description": "Last 4 characters of the token.",
            "description_kind": "plain",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "User type: token or awssts.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages an authorized user on an Archil disk.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "archil_disk": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Creation timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "data_size": {
            "type": "number",
            "description": "Total data size in bytes.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Disk ID. Exactly one of id or name must be set.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Disk name. Exactly one of id or name must be set.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "organization": {
            "type": "string",
            "description": "Owning organization.",
            "description_kind": "plain",
            "computed": true
          },
          "provider_name": {
            "type": "string",
            "description": "Cloud provider.",
            "description_kind": "plain",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Provider region.",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Disk status.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Look up an Archil disk by ID or name.",
        "description_kind": "plain"
      }
    }
  }
}
