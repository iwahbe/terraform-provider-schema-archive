{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_url": {
          "type": "string",
          "description": "The endpoint where Cachet is running.",
          "description_kind": "plain",
          "required": true
        },
        "token": {
          "type": "string",
          "description": "The API token to use for Cachet. Generate it from within your account on the Cachet server.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "cachet_component": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the component",
            "description_kind": "plain",
            "required": true
          },
          "enabled": {
            "type": "bool",
            "description": "Is the component enabled",
            "description_kind": "plain",
            "optional": true
          },
          "group_id": {
            "type": "number",
            "description": "The group that the component is within",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "link": {
            "type": "string",
            "description": "A link to the component - can be used for Runbooks etc",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the component",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "The current status of thc component. If you have automation that updates the component status, please use lifecycle rules in terraform",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "A component is a resource that defines a deployable thing that can be operational or degraded",
        "description_kind": "plain"
      }
    },
    "cachet_component_group": {
      "version": 0,
      "block": {
        "attributes": {
          "collapsed": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the component group",
            "description_kind": "plain",
            "required": true
          },
          "public": {
            "type": "bool",
            "description": "Is the component group public?",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A component group is a resource that defines a group of components",
        "description_kind": "plain"
      }
    },
    "cachet_metric": {
      "version": 0,
      "block": {
        "attributes": {
          "calculation_type": {
            "type": "string",
            "description": "Define how math should be performed on this metric",
            "description_kind": "plain",
            "optional": true
          },
          "decimal_places": {
            "type": "number",
            "description": "The number of decimal places to use for this metric",
            "description_kind": "plain",
            "required": true
          },
          "default_value": {
            "type": "number",
            "description": "The default value of the metric to be displayed when there is no data",
            "description_kind": "plain",
            "required": true
          },
          "default_view": {
            "type": "string",
            "description": "default view of the metric, must be on of: HOUR,12_HOURS,WEEK,MONTH",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Descripion of the metric",
            "description_kind": "plain",
            "required": true
          },
          "display_chart": {
            "type": "bool",
            "description": "Should thi metric be displayed on the status page?",
            "description_kind": "plain",
            "optional": true
          },
          "group_id": {
            "type": "number",
            "description": "The group that the metric is within",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "mins_between_datapoints": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the metric",
            "description_kind": "plain",
            "required": true
          },
          "order": {
            "type": "number",
            "description": "The order that the metric should appear in",
            "description_kind": "plain",
            "optional": true
          },
          "unit": {
            "type": "string",
            "description": "The unit suffix for the metrics",
            "description_kind": "plain",
            "required": true
          },
          "visibility": {
            "type": "string",
            "description": "visibility of the metric, must be on of: public,private,hidden",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A component group is a resource that defines a group of components",
        "description_kind": "plain"
      }
    },
    "cachet_metric_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the metric group",
            "description_kind": "plain",
            "required": true
          },
          "public": {
            "type": "bool",
            "description": "Is the metric group public?",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A metric group is a resource that defines a group of metrics",
        "description_kind": "plain"
      }
    },
    "cachet_subscriber": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "the email address for the subscriber",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "verify": {
            "type": "bool",
            "description": "whether to send a verification email",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "A subscriber is an email address that will receive updates about components",
        "description_kind": "plain"
      }
    }
  },
