                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Proxy config secret is set to enable the Permit Proxy to make proxied requests to the backend service.",
            "description_kind": "markdown",
            "required": true
          },
          "environment_id": {
            "type": "string",
            "description": "Unique id of the environment that owns the proxy config",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique id of the proxy config",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Proxy Config is set to enable the Permit Proxy to make proxied requests as part of the Frontend AuthZ.\n\n",
            "description_kind": "markdown",
            "required": true
          },
          "mapping_rules": {
            "nested_type": {
              "attributes": {
                "action": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "headers": {
