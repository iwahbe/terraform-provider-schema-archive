            "description_kind": "plain",
            "optional": true
          },
          "fairshare": {
            "type": "number",
            "description": "Fairshare value for this account's association.",
            "description_kind": "plain",
            "optional": true
          },
          "grp_tres": {
            "nested_type": {
              "attributes": {
                "count": {
                  "type": "number",
                  "description": "TRES count limit.",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "TRES name. Required for generic resources such as gres/gpu; omit for cpu and mem.",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "TRES type (e.g. cpu, mem, gres).",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "Maximum TRES in use at once across this account's group (GrpTRES).",
