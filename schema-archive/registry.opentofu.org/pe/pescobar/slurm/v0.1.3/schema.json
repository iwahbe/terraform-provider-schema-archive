{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_version": {
          "type": "string",
          "description": "The slurmrestd API version (e.g. v0.0.42). Can also be set with the SLURM_API_VERSION environment variable. Defaults to v0.0.42 (Slurm 25.05.x).",
          "description_kind": "plain",
          "optional": true
        },
        "cluster": {
          "type": "string",
          "description": "The Slurm cluster name. Used to scope association operations. Can also be set with the SLURM_CLUSTER environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "The URL of the slurmrestd REST API (e.g. http://localhost:6820). Can also be set with the SLURM_REST_URL environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "JWT token for authenticating to slurmrestd. Can also be set with the SLURM_JWT_TOKEN environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Manage Slurm accounting resources (accounts, users, QOS) via the slurmrestd REST API.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "slurm_account": {
