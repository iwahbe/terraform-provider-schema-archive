                  "sensitive": true
                },
                "user": {
                  "type": "string",
                  "description": "SSH User",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "SSH authentication config. At least one of password, private_key, or private_key_file must be provided. If multiple credential types are provided, each is added to the SSH auth methods.",
            "description_kind": "plain",
            "required": true
          },
          "cluster_auth": {
            "nested_type": {
              "attributes": {
                "certificate_authority_data": {
                  "type": "string",
                  "description": "Base64 encoded certificate authority data for authenticating to the Kubernetes API server.",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "client_certificate_data": {
                  "type": "string",
                  "description": "Base64 encoded client certificate data for authenticating to the Kubernetes API server.",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "client_key_data": {
                  "type": "string",
                  "description": "Base64 encoded client key data for authenticating to the Kubernetes API server.",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "server": {
                  "type": "string",
                  "description": "The URL of the Kubernetes API server endpoint.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Cluster authentication details for connecting to the K3s cluster.",
            "description_kind": "plain",
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description": "Override the api server's hostname",
            "description_kind": "markdown",
            "optional": true
          },
          "k3s_url": {
            "type": "string",
            "description": "K3S_URL variable",
            "description_kind": "markdown",
            "computed": true
          },
          "kubeconfig": {
            "type": "string",
            "description": "Output of the kubeconfig from a k3s_server resource",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "A utility for reading and manipulating kubeconfig. Common use case would be to extract the auth credentials or override the server URL for a load balancer URL or DNS name.",
        "description_kind": "markdown"
      }
    }
  }
}
