                  "optional": true,
                  "sensitive": true
                },
                "port": {
                  "type": "number",
                  "description": "SSH Port. Defaults to 22 when omitted.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "private_key": {
                  "type": "string",
                  "description": "Inline private key in PEM format",
                  "description_kind": "markdown",
