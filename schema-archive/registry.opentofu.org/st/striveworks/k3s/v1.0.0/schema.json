{
  "provider": {
    "version": 0,
    "block": {
      "description": "K3s Terraform Provider\nUse with your favorite cloud provider, openstack or baremetal. Makes no assumptions about the target backend.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "k3s_agent": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "The health of the server",
            "description_kind": "markdown",
            "computed": true
          },
          "auth": {
            "nested_type": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "Hostname or IP Address",
                  "description_kind": "markdown",
                  "required": true
                },
                "host_key": {
                  "type": "string",
                  "description": "Inline SSH host public key",
                  "description_kind": "markdown",
                  "optional": true
                },
                "host_key_file": {
                  "type": "string",
                  "description": "Path to SSH host public key",
                  "description_kind": "markdown",
                  "optional": true
                },
                "password": {
                  "type": "string",
                  "description": "SSH Password",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "port": {
                  "type": "number",
                  "description": "SSH Port",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "private_key": {
                  "type": "string",
                  "description": "Inline private key in PEM format",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "private_key_file": {
                  "type": "string",
                  "description": "Path to pem file",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "user": {
                  "type": "string",
                  "description": "SSH User",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "SSH authentication config. At least one of password, private_key, or private_key_file must be provided.\n\t\tIf multiple credential types are provided, each is added to the SSH auth methods.\n\t\tFor host key verification, host_key or host_key_file can be passed in, otherwise host key verification is ignored.\n\t\t",
            "description_kind": "plain",
            "required": true
          },
          "bin_dir": {
            "type": "string",
            "description": "Value of a path used to put the k3s binary",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "config": {
            "type": "string",
            "description": "K3s agent config",
            "description_kind": "markdown",
            "optional": true
          },
          "env": {
            "type": [
              "map",
              "string"
            ],
            "description": "Extra environment variables to pass to the process",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description": "Id of the k3s agent resource",
            "description_kind": "markdown",
            "computed": true
          },
          "orphan": {
            "type": "bool",
            "description": "Remove the resource from Terraform state without running the k3s agent uninstall script during deletion.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "registry": {
            "type": "string",
            "description": "K3s agent registry",
            "description_kind": "markdown",
            "optional": true
          },
          "server": {
            "type": "string",
            "description": "Server url used for joining nodes to the cluster.",
            "description_kind": "markdown",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "Server token used for joining nodes to the cluster.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "version": {
            "type": "string",
            "description": "The k3s version to use. Versions can be found at https://github.com/k3s-io/k3s/releases. If omitted, the observed running version is stored after install.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Creates a k3s agent resource. Requires SSH authentication, a token, and a server address from a k3s_server resource.",
        "description_kind": "markdown"
      }
    },
    "k3s_server": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "The health of the server",
            "description_kind": "markdown",
            "computed": true
          },
          "auth": {
            "nested_type": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "Hostname or IP Address",
                  "description_kind": "markdown",
                  "required": true
                },
                "host_key": {
                  "type": "string",
                  "description": "Inline SSH host public key",
                  "description_kind": "markdown",
                  "optional": true
                },
                "host_key_file": {
                  "type": "string",
                  "description": "Path to SSH host public key",
                  "description_kind": "markdown",
                  "optional": true
                },
                "password": {
                  "type": "string",
                  "description": "SSH Password",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "port": {
                  "type": "number",
                  "description": "SSH Port",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "private_key": {
                  "type": "string",
                  "description": "Inline private key in PEM format",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "private_key_file": {
                  "type": "string",
                  "description": "Path to pem file",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "user": {
                  "type": "string",
                  "description": "SSH User",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "SSH authentication config. At least one of password, private_key, or private_key_file must be provided.\n\t\tIf multiple credential types are provided, each is added to the SSH auth methods.\n\t\tFor host key verification, host_key or host_key_file can be passed in, otherwise host key verification is ignored.\n\t\t",
            "description_kind": "plain",
            "required": true
          },
          "bin_dir": {
            "type": "string",
            "description": "Value of a path used to put the k3s binary",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "bootstrap_token": {
            "type": "string",
            "description": "Short server token used only when bootstrapping a new server. Changing this value requires replacing the server.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "cluster_auth": {
            "nested_type": {
              "attributes": {
                "certificate_authority_data": {
                  "type": "string",
                  "description": "Base64 encoded certificate authority data for authenticating to the Kubernetes API server.",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "client_certificate_data": {
                  "type": "string",
                  "description": "Base64 encoded client certificate data for authenticating to the Kubernetes API server.",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "client_key_data": {
                  "type": "string",
                  "description": "Base64 encoded client key data for authenticating to the Kubernetes API server.",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "server": {
                  "type": "string",
                  "description": "The URL of the Kubernetes API server endpoint.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Cluster authentication details for connecting to the K3s cluster.",
            "description_kind": "plain",
            "computed": true
          },
          "config": {
            "type": "string",
            "description": "K3s server config",
            "description_kind": "markdown",
            "optional": true
          },
          "env": {
            "type": [
              "map",
              "string"
            ],
            "description": "Extra environment variables to pass to the process",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "highly_available": {
            "nested_type": {
              "attributes": {
                "cluster_init": {
                  "type": "bool",
                  "description": "Node is the init node for the HA cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "server": {
                  "type": "string",
                  "description": "URL of an existing server to join. Optional when using an external datastore such as Postgres.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "token": {
                  "type": "string",
                  "description": "Server token used for joining nodes to the cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Run server node in highly available mode",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Id of the k3s server resource",
            "description_kind": "markdown",
            "computed": true
          },
          "kubeconfig": {
            "type": "string",
            "description": "KubeConfig for the cluster",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "oidc": {
            "nested_type": {
              "attributes": {
                "audience": {
                  "type": "string",
                  "description": "The audience that this ID token is intended for. Required when OIDC is configured.",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "issuer": {
                  "type": "string",
                  "description": "The URL of the OIDC issuer. Required when OIDC is configured.",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "jwks_keys": {
                  "type": "string",
                  "description": "The JSON Web Key Set (JWKS) generated by the K3s cluster after configuring the OIDC provider. This is a computed attribute.",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "pkcs8": {
                  "type": "string",
                  "description": "The public signing key in PKCS8 format for verifying OIDC tokens. Required when OIDC is configured.",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "signing_key": {
                  "type": "string",
                  "description": "The private signing key for signing OIDC tokens. Required when OIDC is configured.",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Configuration for integrating an OpenID Connect (OIDC) provider with the K3s cluster. This allows for authentication using OIDC tokens.",
            "description_kind": "plain",
            "optional": true
          },
          "orphan": {
            "type": "bool",
            "description": "Remove the resource from Terraform state without running the k3s uninstall script during deletion.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "registry": {
            "type": "string",
            "description": "K3s server registry",
            "description_kind": "markdown",
            "optional": true
          },
          "server": {
            "type": "string",
            "description": "Server url  used for joining nodes to the cluster.",
            "description_kind": "markdown",
            "computed": true
          },
          "token": {
            "type": "string",
            "description": "Observed server token used for joining nodes to the cluster.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "version": {
            "type": "string",
            "description": "The k3s version to use. Versions can be found at https://github.com/k3s-io/k3s/releases. If omitted, the observed running version is stored after install.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Creates a k3s server resource. At least one of `password`, `private_key`, or `private_key_file` must be provided.\nWhen running in highly available mode, it is up to the consumers of this module to correctly implement the raft protocol and create an odd number of ha nodes. Due to how HA works, we do not offer a method to gracefully delete a controller node from the cluster before running `k3s-uninstall.sh` during deletion of this resource.",
        "description_kind": "markdown"
      }
    },
    "k3s_token": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Public token ID, which is the first six characters of the generated token.",
            "description_kind": "markdown",
            "computed": true
          },
          "token": {
            "type": "string",
            "description": "Generated K3s-compatible short server token in `[a-z0-9]{32}` format.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Generates a K3s-compatible short server token suitable for bootstrapping the first server with `k3s_server.bootstrap_token`.",
        "description_kind": "markdown"
      }
    }
  },
