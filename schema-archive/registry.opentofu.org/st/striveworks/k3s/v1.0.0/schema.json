    "k3s_kubeconfig": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_empty": {
            "type": "bool",
            "description": "If this is true, it will allow a missing kubeconfig and set null to all outputs",
            "description_kind": "markdown",
            "optional": true
          },
          "auth": {
            "nested_type": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "Hostname or IP Address",
                  "description_kind": "markdown",
                  "required": true
                },
                "host_key": {
                  "type": "string",
                  "description": "Inline SSH host public key",
                  "description_kind": "markdown",
                  "optional": true
                },
                "host_key_file": {
                  "type": "string",
                  "description": "Path to SSH host public key",
                  "description_kind": "markdown",
                  "optional": true
                },
                "password": {
                  "type": "string",
                  "description": "SSH Password",
