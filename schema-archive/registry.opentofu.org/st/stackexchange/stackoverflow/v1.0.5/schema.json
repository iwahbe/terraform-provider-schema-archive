{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_token": {
          "type": "string",
          "description": "The Stack Overflow API access token. The `STACK_OVERFLOW_ACCESS_TOKEN` environment variable can be used instead.",
          "description_kind": "plain",
          "required": true
        },
        "base_url": {
          "type": "string",
          "description": "The base URL for the Stack Overflow API (must end with `/`). For Stack Overflow for Teams this is in the format `https://api.stackoverflowteams.com/v3/teams/{team}/` and for Stack Overflow Enterprise this is in one of the following formats `https://{name}.stackenterprise.co/api/v3/`, `https://{name}.stackenterprise.co/api/v3/teams/{team}/`, `https://{your-custom-domain}/api/v3/`, or `https://{your-custom-domain}/api/v3/teams/{team}/`. The `STACK_OVERFLOW_API_URL` environment variable can be used instead.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "stackoverflow_answer": {
      "version": 0,
      "block": {
        "attributes": {
          "body_markdown": {
            "type": "string",
            "description": "The answer content in Markdown format",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "question_id": {
            "type": "number",
            "description": "The question identifier that this answer applies to",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "stackoverflow_article": {
      "version": 0,
      "block": {
        "attributes": {
          "article_type": {
            "type": "string",
            "description": "The type of article. Must be one of `knowledgeArticle`, `announcement`, `howToGuide`, `policy`",
            "description_kind": "plain",
            "required": true
          },
          "body_markdown": {
            "type": "string",
            "description": "The article content in Markdown format",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "The set of tags to be associated with the article",
            "description_kind": "plain",
            "required": true
          },
          "title": {
            "type": "string",
            "description": "The title of the article",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "stackoverflow_collection": {
      "version": 0,
      "block": {
        "attributes": {
          "content_ids": {
            "type": [
              "list",
              "number"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "The collection description.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "title": {
            "type": "string",
            "description": "The title of the collection",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "stackoverflow_question": {
      "version": 0,
      "block": {
        "attributes": {
          "body_markdown": {
            "type": "string",
            "description": "The question content in Markdown format",
            "description_kind": "plain",
            "required": true
          },
          "id": {
