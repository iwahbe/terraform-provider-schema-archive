{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token_access_key": {
          "type": "string",
          "description": "Stax [API Token](https://www.stax.io/developer/api-tokens/) Access Key. Alternatively, can be configured using the `STAX_ACCESS_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "api_token_secret_key": {
          "type": "string",
          "description": "Stax [API Token](https://www.stax.io/developer/api-tokens/) Secret Key. Alternatively, can be configured using the `STAX_SECRET_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "endpoint_url": {
          "type": "string",
          "description": "Stax API endpoint for your Stax tenancy's control plane, this is used for testing and customers should use `installation`. Must provide only one of `installation` or `endpoint_url`.",
          "description_kind": "markdown",
          "optional": true
        },
        "installation": {
          "type": "string",
          "description": "[Stax Short Installation ID](https://support.stax.io/hc/en-us/articles/4537150525071-Stax-Installation-Regions) for your Stax tenancy's control plane. Alternatively, can be configured using the `STAX_INSTALLATION` environment variable. Must provide only one of `installation` or `endpoint_url`.",
          "description_kind": "markdown",
          "optional": true
        },
        "permission_sets_endpoint_url": {
          "type": "string",
          "description": "Stax Permission Sets API endpoint for your Stax tenancy's control plane, this is used for testing and customers should use `installation`. Must provide only one of `installation` or `endpoint_url`.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
