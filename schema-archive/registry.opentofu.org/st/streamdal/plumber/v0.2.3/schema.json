{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "address": {
          "type": "string",
          "description": "The address of the Plumber server.",
          "description_kind": "markdown",
          "optional": true
        },
        "connection_timeout": {
          "type": "number",
          "description": "The connection timeout for the Plumber server.",
          "description_kind": "markdown",
          "optional": true
        },
        "plumber_token": {
          "type": "string",
          "description": "Plumber API token",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "plumber_connection": {
      "version": 1,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Connection ID",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name",
            "description_kind": "markdown",
            "required": true
          },
          "notes": {
            "type": "string",
            "description": "Customer Notes",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "kafka": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "address": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Address of Kafka brokers",
                  "description_kind": "markdown",
                  "required": true
                },
                "connection_timeout": {
                  "type": "number",
                  "description": "Connection timeout (in seconds)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "sasl_password": {
                  "type": "string",
                  "description": "SASL Password",
                  "description_kind": "markdown",
                  "optional": true
                },
                "sasl_type": {
                  "type": "string",
                  "description": "SASL Authentication Type (Default: `NONE`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "sasl_username": {
                  "type": "string",
                  "description": "SASL Username",
                  "description_kind": "markdown",
                  "optional": true
                },
                "tls_skip_verify": {
                  "type": "bool",
                  "description": "Skip TLS certificate verification",
                  "description_kind": "markdown",
                  "optional": true
                },
                "use_tls": {
                  "type": "bool",
                  "description": "Force TLS connection",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Arguments for a Kafka connection",
              "description_kind": "markdown"
            },
            "max_items": 1
          },
          "rabbit": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "address": {
                  "type": "string",
                  "description": "Full DSN of RabbitMQ cluister (ex: amqp://bus.domain.com:5672)",
                  "description_kind": "markdown",
                  "required": true
                },
                "tls_skip_verify": {
                  "type": "bool",
                  "description": "Skip TLS certificate verification",
                  "description_kind": "markdown",
                  "optional": true
                },
                "use_tls": {
                  "type": "bool",
                  "description": "Force TLS connection (regardless of DSN)",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Arguments for a RabbitMQ connection",
              "description_kind": "markdown"
            },
            "max_items": 1
          }
        },
        "description": "Message Bus Connections",
        "description_kind": "markdown"
      }
    },
    "plumber_relay": {
      "version": 1,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Whether is active or not. Setting to true will start the relay on Create or Update",
            "description_kind": "markdown",
            "required": true
          },
          "batch_max_retry": {
            "type": "number",
            "description": "How many times plumber will try re-sending a batch (Default: `3`)",
            "description_kind": "markdown",
            "optional": true
          },
          "batch_size": {
            "type": "number",
            "description": "How many messages to send in a single batch (Default: `1000`)",
            "description_kind": "markdown",
            "optional": true
          },
          "collection_token": {
            "type": "string",
            "description": "Collection Token",
            "description_kind": "markdown",
            "required": true
          },
          "connection_id": {
            "type": "string",
            "description": "Plumber connection ID",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Relay ID",
            "description_kind": "markdown",
            "computed": true
          },
          "num_workers": {
            "type": "number",
            "description": "How many workers to launch per relay (Default: `10`)",
            "description_kind": "markdown",
            "optional": true
          },
          "stats_enable": {
            "type": "bool",
            "description": "Display periodic relay stats",
            "description_kind": "markdown",
            "optional": true
          },
          "stats_report_interval_sec": {
            "type": "number",
            "description": "How often to print stats (Default: `10`)",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "kafka": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "commit_interval_seconds": {
                  "type": "number",
                  "description": "How often, in seconds, to commit offsets to broker (0 = synchronous) (Default: `5`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "consumer_group_name": {
                  "type": "string",
                  "description": "Specify a specific group-id to use when reading from kafka",
                  "description_kind": "markdown",
                  "optional": true
                },
                "max_bytes": {
                  "type": "number",
                  "description": "Maximum number of bytes to fetch in a single kafka request (throughput optimization) (Default: `1`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "max_wait_seconds": {
                  "type": "number",
                  "description": "How long to wait for new data when reading batches of messages (Default: `1`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "min_bytes": {
                  "type": "number",
                  "description": "Minimum number of bytes to fetch in a single kafka request (throughput optimization) (Default: `1`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "queue_capacity": {
                  "type": "number",
                  "description": "Internal library queue capacity (throughput optimization) (Default: `1`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "read_offset": {
                  "type": "number",
                  "description": "Specify what offset the consumer should read from (Requires use_consumer_group to be true) (Default: `0`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "rebalance_timeout_seconds": {
                  "type": "number",
                  "description": "How long a coordinator will wait for member joins as part of a rebalance (Default: `0`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "topics": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Topics to read from",
                  "description_kind": "markdown",
                  "required": true
                },
                "use_consumer_group": {
                  "type": "bool",
                  "description": "Use a consumer group to read from Kafka",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "rabbit": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "auto_ack": {
                  "type": "bool",
                  "description": "Automatically acknowledge receipt of read/received messages",
                  "description_kind": "markdown",
                  "optional": true
                },
                "binding_key": {
                  "type": "string",
                  "description": "Binding key for topic based exchanges",
                  "description_kind": "markdown",
                  "required": true
                },
                "consumer_tag": {
                  "type": "string",
                  "description": "How to identify the consumer to RabbitMQ",
                  "description_kind": "markdown",
                  "optional": true
                },
                "exchange_name": {
                  "type": "string",
                  "description": "Name of the exchange",
                  "description_kind": "markdown",
                  "required": true
                },
                "queue_declare": {
                  "type": "bool",
                  "description": "Whether to create/declare the queue (if it does not exist)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "queue_delete": {
                  "type": "bool",
                  "description": "Whether to auto-delete the queue after plumber has disconnected",
                  "description_kind": "markdown",
                  "optional": true
                },
                "queue_durable": {
                  "type": "bool",
                  "description": "Whether the queue should survive after disconnect",
                  "description_kind": "markdown",
                  "optional": true
                },
                "queue_exclusive": {
                  "type": "bool",
                  "description": "Whether plumber should be the only one using the queue",
                  "description_kind": "markdown",
                  "optional": true
                },
                "queue_name": {
                  "type": "string",
                  "description": "Name of the queue where messages will be routed to",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description": "Relay messages to your Batch.sh collections",
        "description_kind": "markdown"
      }
    },
    "plumber_tunnel": {
      "version": 1,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Whether the tunnel is active or not. Setting to true will start the tunnel on Create/Update",
            "description_kind": "markdown",
            "required": true
          },
          "batchsh_api_token": {
            "type": "string",
            "description": "API Token for https://console.batch.sh (NOT Plumber Token)",
            "description_kind": "markdown",
            "required": true
          },
          "connection_id": {
            "type": "string",
            "description": "Plumber connection ID",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of this tunnel, which will appear in https://console.batch.sh Destinations",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "dproxy": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "address": {
                  "type": "string",
                  "description": "Address dProxy GRPC Server (Default: `dproxy.batch.sh:443`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "connection_timeout": {
                  "type": "number",
                  "description": "Connection timeout (in seconds) (Default: `5`)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "disable_tls": {
                  "type": "bool",
                  "description": "Disable TLS connection",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Optional dProxy configuration",
              "description_kind": "markdown"
            },
            "max_items": 1
          },
          "kafka": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "headers": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "Headers to write messages with",
                  "description_kind": "markdown",
                  "optional": true
                },
                "key": {
                  "type": "string",
                  "description": "Key to write messages with",
                  "description_kind": "markdown",
                  "optional": true
                },
                "topics": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Topics to replay",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Replay messages to a Kafka connection",
              "description_kind": "markdown"
            },
            "max_items": 1
          },
          "rabbit": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "app_id": {
                  "type": "string",
                  "description": "Fills message properties $app_id with this value",
                  "description_kind": "markdown",
                  "optional": true
                },
                "exchange_auto_delete": {
                  "type": "bool",
                  "description": "Whether to auto-delete the exchange (after writes)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "exchange_declare": {
                  "type": "bool",
                  "description": "Whether to declare an exchange (if it does not exist)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "exchange_durable": {
                  "type": "bool",
                  "description": "Whether to make a declared exchange durable",
                  "description_kind": "markdown",
                  "optional": true
                },
                "exchange_name": {
                  "type": "string",
                  "description": "Exchange to write message(s)",
                  "description_kind": "markdown",
                  "required": true
                },
                "exchange_type": {
                  "type": "string",
                  "description": "The type of exchange we are working with: direct,topic,headers,fanout",
                  "description_kind": "markdown",
                  "optional": true
                },
                "routing_key": {
                  "type": "string",
                  "description": "Routing key to write message(s) to",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "Replay messages to a RabbitMQ connection",
              "description_kind": "markdown"
            },
            "max_items": 1
          }
        },
        "description": "A tunnel allows Plumber to act as a replay destination within your infrastructure",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "plumber_connection": {
      "version": 1,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Connection ID",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Connection name",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "filter": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Field name to filter on",
                  "description_kind": "markdown",
                  "required": true
                },
                "values": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Value(s) to filter by. Wildcards '*' are supported.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "plumber_relay": {
      "version": 1,
      "block": {
        "attributes": {
          "collection_token": {
            "type": "string",
            "description": "Batch.sh Collection token",
            "description_kind": "markdown",
            "computed": true
          },
          "connection_id": {
            "type": "string",
            "description": "Connection ID",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Relay ID",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "filter": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Field name to filter on",
                  "description_kind": "markdown",
                  "required": true
                },
                "values": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Value(s) to filter by. Wildcards '*' are supported.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "plumber_tunnel": {
      "version": 1,
      "block": {
        "attributes": {
          "connection_id": {
            "type": "string",
            "description": "Connection ID",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Tunnel ID",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "filter": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Field name to filter on",
                  "description_kind": "markdown",
                  "required": true
                },
                "values": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Value(s) to filter by. Wildcards '*' are supported.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
