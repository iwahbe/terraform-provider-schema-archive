{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API key for authenticating with the Resend API. Can also be set with the `RESEND_API_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Resend provider allows you to manage Resend resources such as domains and API keys.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "resend_api_key": {
      "version": 0,
      "block": {
        "attributes": {
          "domain_id": {
            "type": "string",
            "description": "The domain ID to restrict the API key to.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The API key ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the API key.",
            "description_kind": "markdown",
            "required": true
          },
          "permission": {
            "type": "string",
            "description": "The permission level. Valid values: `full_access`, `sending_access`. Defaults to `full_access`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "token": {
            "type": "string",
            "description": "The API key token. Only available after creation; cannot be retrieved later.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manages a Resend API key.",
        "description_kind": "markdown"
      }
    },
    "resend_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "click_tracking": {
            "type": "bool",
            "description": "Whether click tracking is enabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "The timestamp when the domain was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "custom_return_path": {
            "type": "string",
            "description": "The custom return path for the domain.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The domain ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The domain name.",
            "description_kind": "markdown",
            "required": true
          },
          "open_tracking": {
            "type": "bool",
            "description": "Whether open tracking is enabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "records": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "priority": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "record": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "status": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "ttl": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "DNS records required for domain verification.",
            "description_kind": "markdown",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "The region where the domain is hosted. Valid values: `us-east-1`, `eu-west-1`, `sa-east-1`, `ap-northeast-1`. Defaults to `us-east-1`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "The verification status of the domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "tls": {
            "type": "string",
            "description": "The TLS setting. Valid values: `enforced`, `opportunistic`. Defaults to `opportunistic`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a Resend domain.",
        "description_kind": "markdown"
      }
    },
    "resend_domain_verification": {
      "version": 0,
      "block": {
        "attributes": {
          "domain_id": {
            "type": "string",
            "description": "The ID of the domain to verify.",
            "description_kind": "markdown",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "The verification status of the domain after triggering verification.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Triggers verification for a Resend domain. Creating this resource sends a verification request to Resend. The domain's DNS records must be configured before verification can succeed.",
        "description_kind": "markdown"
      }
    }
  },
