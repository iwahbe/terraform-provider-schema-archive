{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Your Render api key, created in the render.com Account Settings. If not supplied, `RENDER_API_KEY` is used",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "email": {
          "type": "string",
          "description": "Your Render email. This is used as a default `owner` in all services where no owner is specified. If not supplied, `RENDER_EMAIL` is used",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "\nThe Render provider is used to interact with resources supported by Render.\n        ",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "render_service": {
      "version": 0,
      "block": {
        "attributes": {
          "auto_deploy": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "branch": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "owner": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "private_service_details": {
            "nested_type": {
              "attributes": {
                "disk": {
                  "nested_type": {
                    "attributes": {
                      "mount_path": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "name": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "size_gb": {
                        "type": "number",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "env": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "plan": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "pull_request_previews_enabled": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "region": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Service details for `private_service` type services.",
            "description_kind": "plain",
            "optional": true
          },
          "repo": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "static_site_details": {
            "nested_type": {
              "attributes": {
                "build_command": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "publish_path": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "pull_request_previews_enabled": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Service details for `static_site` type services.",
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "web_service_details": {
            "nested_type": {
              "attributes": {
                "env": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "health_check_path": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "native": {
                  "nested_type": {
                    "attributes": {
                      "build_command": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "start_command": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "plan": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "pull_request_previews_enabled": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "region": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Service details for `web_service` type services.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Provider for service resource",
        "description_kind": "plain"
      }
    },
    "render_service_custom_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "domain_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "service_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Provider for service custom domain resource",
        "description_kind": "plain"
      }
    },
    "render_service_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "service": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "variables": {
            "nested_type": {
              "attributes": {
                "generated": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "key": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Service environment variable",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Provider for service environment resource",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "render_owner": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "type": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provides information about an existing Owner resource.",
        "description_kind": "plain"
      }
    }
  }
}
