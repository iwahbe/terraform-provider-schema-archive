{
  "provider": {
    "version": 0,
    "block": {
      "description": "The k0s provider is used to create and manage a k0s Kubernetes cluster.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "k0s_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "concurrency": {
            "type": "number",
            "description": "Maximum number of hosts to configure in parallel. If omitted, the default value is `0` (unlimited).",
            "description_kind": "markdown",
            "optional": true
          },
          "config": {
            "type": "string",
            "description": "Embedded k0s cluster configuration. When left out, the output of `k0s config create` will be used.",
            "description_kind": "markdown",
            "optional": true
          },
          "dynamic_config": {
            "type": "bool",
            "description": "Enable k0s dynamic config.",
            "description_kind": "markdown",
            "optional": true
          },
          "hosts": {
            "nested_type": {
              "attributes": {
                "environment": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "List of key-value pairs to set to the target host's environment variables.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "files": {
                  "nested_type": {
                    "attributes": {
                      "dst": {
                        "type": "string",
                        "description": "Destination filename for the file",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "group": {
                        "type": "string",
                        "description": "Group name of file owner",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "name": {
                        "type": "string",
                        "description": "name of the file bundle",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "perm": {
                        "type": "string",
                        "description": "File permission mode for uploaded file",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "src": {
                        "type": "string",
                        "description": "File path to the file to upload",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "user": {
                        "type": "string",
                        "description": "User name of file owner",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "List of files to be uploaded to the host.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "hostname": {
                  "type": "string",
                  "description": "Override host's hostname. When not set, the hostname reported by the operating system is used.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "install_flags": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Extra flags passed to the `k0s install` command on the target host.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "no_taints": {
                  "type": "bool",
                  "description": "When `true` and used in conjuction with the `controller+worker` role, the default taints are disabled making regular workloads schedulable on the node. By default, k0s sets a `node-role.kubernetes.io/master:NoSchedule` taint on `controller+worker` nodes and only workloads with toleration for it will be scheduled.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "os": {
                  "type": "string",
                  "description": "Override OS distribution auto-detection.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "private_address": {
                  "type": "string",
                  "description": "Override private IP address selected by host fact gathering.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "private_interface": {
                  "type": "string",
                  "description": "Override private network interface selected by host fact gathering. Useful in case fact gathering picks the wrong private network interface.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "role": {
                  "type": "string",
                  "description": "Role of the host. One of `controller`, `controller+worker`, `single`, `worker`.",
                  "description_kind": "markdown",
                  "required": true
                },
                "ssh": {
                  "nested_type": {
                    "attributes": {
                      "address": {
                        "type": "string",
                        "description": "IP address of the host.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "bastion": {
                        "nested_type": {
                          "attributes": {
                            "address": {
                              "type": "string",
                              "description": "IP address of the host.",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "key": {
                              "type": "string",
                              "description": "SSH private key in PEM format.",
                              "description_kind": "markdown",
                              "optional": true,
                              "sensitive": true
                            },
                            "key_path": {
                              "type": "string",
                              "description": "Path to an SSH private key file.",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "port": {
                              "type": "number",
                              "description": "TCP port of the SSH service on the host.",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "user": {
                              "type": "string",
                              "description": "Username to log in as.",
                              "description_kind": "markdown",
                              "optional": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description": "SSH bastion connection options.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "key": {
                        "type": "string",
                        "description": "SSH private key in PEM format.",
                        "description_kind": "markdown",
                        "optional": true,
                        "sensitive": true
                      },
                      "key_path": {
                        "type": "string",
                        "description": "Path to an SSH private key file.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "port": {
                        "type": "number",
                        "description": "TCP port of the SSH service on the host.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "user": {
                        "type": "string",
                        "description": "Username to log in as.",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "SSH connection options.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "Hosts configuration.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique ID of the cluster.",
            "description_kind": "markdown",
            "computed": true
          },
          "kubeconfig": {
            "type": "string",
            "description": "Admin kubeconfig of the cluster.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "Name of the cluster.",
            "description_kind": "markdown",
            "required": true
          },
          "no_drain": {
            "type": "bool",
            "description": "Do not drain worker nodes when upgrading. If omitted, the default value is `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "no_wait": {
            "type": "bool",
            "description": "Do not wait for worker nodes to join. If omitted, the default value is `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "version": {
            "type": "string",
            "description": "Desired k0s version.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Manages a k0s cluster.",
        "description_kind": "markdown"
      }
    }
  }
}
