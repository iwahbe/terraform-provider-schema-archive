    }
  },
  "resource_schemas": {
    "courier_deployment": {
      "version": 0,
      "block": {
        "attributes": {
          "artifact": {
            "nested_type": {
              "attributes": {
                "command": {
                  "type": "string",
                  "description": "The command to start the artifact.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "digest": {
                  "type": "string",
                  "description": "The digest of the artifact, in form of algorithm:checksum.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "envs": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "The environment variables of the artifact.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "ports": {
                  "type": [
                    "list",
                    "number"
                  ],
                  "description": "The ports of the artifact.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "refer": {
                  "nested_type": {
                    "attributes": {
                      "authn": {
                        "nested_type": {
                          "attributes": {
                            "secret": {
                              "type": "string",
                              "description": "The secret for authentication, either password or token.",
                              "description_kind": "plain",
                              "required": true,
                              "sensitive": true
                            },
                            "type": {
                              "type": "string",
                              "description": "The type for authentication, either \"basic\" or \"bearer\".",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "user": {
                              "type": "string",
                              "description": "The user for authentication.",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description": "The authentication for pulling the artifact.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "insecure": {
                        "type": "bool",
                        "description": "Specify to pull the artifact with insecure mode.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "uri": {
                        "type": "string",
                        "description": "The reference to pull the artifact.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "The reference of the artifact.",
                  "description_kind": "plain",
                  "required": true
                },
                "volumes": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "The volumes of the artifact.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The artifact of the deployment.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the deployment.",
            "description_kind": "plain",
            "computed": true
          },
          "runtime": {
            "nested_type": {
              "attributes": {
                "authn": {
                  "nested_type": {
                    "attributes": {
                      "secret": {
                        "type": "string",
                        "description": "The secret for authentication, either password or token.",
                        "description_kind": "plain",
                        "required": true,
                        "sensitive": true
                      },
                      "type": {
                        "type": "string",
                        "description": "The type for authentication, either \"basic\" or \"bearer\".",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "user": {
                        "type": "string",
                        "description": "The user for authentication.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "The authentication for fetching the runtime.",
                  "description_kind": "plain",
                  "optional": true
                },
                "class": {
                  "type": "string",
                  "description": "Specify the class of the runtime.",
                  "description_kind": "plain",
                  "required": true
                },
                "insecure": {
                  "type": "bool",
                  "description": "Specify to fetch the runtime with insecure mode.",
                  "description_kind": "plain",
                  "optional": true
                },
                "source": {
                  "type": "string",
                  "description": "The source to fetch the runtime, \nonly support a git repository at present.\n\n  - For example:\n    - https://github.com/foo/bar, clone the HEAD commit of the default branch.\n    - https://github.com/foo/bar//subpath, clone the HEAD commit of the default branch, \n      and use the subdirectory.\n    - https://github.com/foo/bar?ref=dev, clone the \"dev\" commit.\n  - Comply with the following structure:\n    ```\n    /tomcat     \t # the name of the runtime.\n      /linux         # the os supported by the runtime.\n        /service.sh  # the POSIX shell script, must name as service.sh.\n          setup\n          start\n          state\n          stop\n          cleanup\n      /windows\n        /service.ps1 # the PowerShell script, must name as service.ps1.\n    ```",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The runtime of the deployment.",
            "description_kind": "plain",
            "required": true
          },
          "strategy": {
            "nested_type": {
              "attributes": {
                "rolling": {
                  "nested_type": {
                    "attributes": {
                      "max_surge": {
                        "type": "number",
                        "description": "The maximum percent of targets to deploy at once.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "The rolling strategy of the deployment.",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "The type of the deployment strategy,\neither \"recreate\" or \"rolling\".",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Specify the strategy of the deployment.",
            "description_kind": "plain",
            "optional": true
          },
          "targets": {
            "nested_type": {
              "attributes": {
                "arch": {
                  "type": "string",
                  "description": "The architecture of the target.",
                  "description_kind": "plain",
                  "required": true
                },
                "host": {
                  "nested_type": {
                    "attributes": {
                      "address": {
                        "type": "string",
                        "description": "The address to access the target, \nin the form of [schema://](ip|dns)[:port].",
                        "description_kind": "plain",
                        "required": true
                      },
                      "authn": {
                        "nested_type": {
                          "attributes": {
                            "agent": {
                              "type": "bool",
                              "description": "Specify to access the target with agent,\neither SSH agent if type is \"ssh\" or NTLM if type is \"winrm\".",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "secret": {
                              "type": "string",
                              "description": "The secret to authenticate when accessing the target, \neither password or private key.",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true,
                              "sensitive": true
                            },
                            "type": {
                              "type": "string",
                              "description": "The type to access the target, either \"ssh\" or \"winrm\".",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "user": {
                              "type": "string",
                              "description": "The user to authenticate when accessing the target.",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description": "The authentication for accessing the host.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "insecure": {
                        "type": "bool",
                        "description": "Specify to access the target with insecure mode.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "proxies": {
                        "nested_type": {
                          "attributes": {
                            "address": {
                              "type": "string",
                              "description": "The address to access the proxy, \nin the form of [schema://](ip|dns)[:port].",
                              "description_kind": "plain",
                              "required": true
                            },
                            "authn": {
                              "nested_type": {
                                "attributes": {
                                  "secret": {
                                    "type": "string",
                                    "description": "The secret to authenticate \nwhen accessing the proxy, either password or private key.",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true,
                                    "sensitive": true
                                  },
                                  "type": {
                                    "type": "string",
                                    "description": "The type to access the proxy, \neither \"ssh\" or \"proxy\".",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true
                                  },
                                  "user": {
                                    "type": "string",
                                    "description": "The user to authenticate \nwhen accessing the proxy.",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true
                                  }
                                },
                                "nesting_mode": "single"
                              },
                              "description": "The authentication for accessing the proxy.",
                              "description_kind": "plain",
                              "required": true
                            },
                            "insecure": {
                              "type": "bool",
                              "description": "Specify to access the target with insecure mode.",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description": "The proxies before accessing the target, \neither a bastion host or a jump host.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Specify the target to access.",
                  "description_kind": "plain",
                  "required": true
                },
                "os": {
                  "type": "string",
                  "description": "The operating system of the target.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The targets of the deployment.",
            "description_kind": "plain",
            "required": true
          },
          "timeouts": {
            "nested_type": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Specify how to deploy.",
        "description_kind": "plain"
      }
    }
