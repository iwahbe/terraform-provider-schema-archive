          "description_kind": "plain",
          "required": true
        },
        "url": {
          "type": "string",
          "description": "The URL of the Circle CI API (v2)",
          "description_kind": "plain",
          "optional": true
        },
        "vcs_type": {
          "type": "string",
          "description": "The VCS type for the organization.",
          "description_kind": "plain",
          "optional": true
        }
