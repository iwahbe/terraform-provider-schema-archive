          "parameter_group": {
            "type": "string",
            "description": "Parameter group ID to use",
            "description_kind": "plain",
            "optional": true
          },
          "password": {
            "type": "string",
            "description": "Password to connect to the datastore",
            "description_kind": "plain",
            "computed": true
          },
          "primary_dsn": {
            "type": "string",
            "description": "DSN to the primary host(s)",
            "description_kind": "plain",
            "computed": true
          },
          "primary_url": {
            "type": "string",
            "description": "URL to the primary host(s)",
            "description_kind": "plain",
            "computed": true
          },
          "replica_dsn": {
