            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "maintenance_start_hour": {
            "type": "number",
            "description": "Hour of the day to start the maintenance. 0-23",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
