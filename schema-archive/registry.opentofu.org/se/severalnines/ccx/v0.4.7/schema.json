        "block_types": {
          "firewall": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "Description of this firewall rule",
                  "description_kind": "plain",
                  "optional": true
                },
                "id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "source": {
                  "type": "string",
                  "description": "CIDR source for the firewall rule",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "FirewallRule rules to allow",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
