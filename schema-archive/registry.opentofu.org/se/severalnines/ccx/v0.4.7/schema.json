  "resource_schemas": {
    "ccx_datastore": {
      "version": 0,
      "block": {
        "attributes": {
          "cloud_provider": {
            "type": "string",
            "description": "Cloud provider name",
            "description_kind": "plain",
            "required": true
          },
          "cloud_region": {
            "type": "string",
            "description": "The region to set up the datastore",
            "description_kind": "plain",
            "required": true
          },
          "db_vendor": {
            "type": "string",
            "description": "Database Vendor",
            "description_kind": "plain",
            "required": true
          },
          "db_version": {
            "type": "string",
            "description": "Database Version",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "dbname": {
            "type": "string",
            "description": "Database name",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "instance_size": {
