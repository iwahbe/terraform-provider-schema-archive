            "optional": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "An optional list of tags",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Replication type of the datastore",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "Username to connect to the datastore",
            "description_kind": "plain",
            "computed": true
          },
          "volume_iops": {
            "type": "number",
