              "list",
              "string"
            ],
            "description": "Network availability zones",
            "description_kind": "plain",
            "optional": true
          },
          "network_ha_enabled": {
            "type": "bool",
            "description": "High availability enabled or not",
            "description_kind": "plain",
            "optional": true
          },
