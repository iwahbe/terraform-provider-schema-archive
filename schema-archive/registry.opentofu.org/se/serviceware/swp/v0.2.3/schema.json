{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "aipe_url": {
          "type": "string",
          "description": "URL of the AIPE",
          "description_kind": "markdown",
          "optional": true
        },
        "application_password": {
          "type": "string",
          "description": "Password for AIPE from user management",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "application_username": {
          "type": "string",
          "description": "Username for AIPE from user management",
          "description_kind": "markdown",
          "optional": true
        },
        "authenticator_realm_url": {
          "type": "string",
          "description": "URL of the Authenticatopr realm",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "swp_aipe_data_object": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The system.id of the data object",
            "description_kind": "markdown",
            "computed": true
          },
          "properties": {
            "type": [
              "map",
              "string"
            ],
            "description": "The property values for the data object",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "The data type name ob the object. Must be the internal name (usually-in-lowecase-and-kebabxase)",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Creates a data object in the AIPE",
        "description_kind": "markdown"
      }
    },
    "swp_aipe_data_object_link": {
      "version": 0,
      "block": {
        "attributes": {
          "link_name": {
            "type": "string",
            "description": "The name of the link. This is the name of the link ('incident-causes'), not the name of the relation (of which a link has 2 - 'caused-by' or 'causes').",
            "description_kind": "markdown",
            "required": true
          },
          "relation_name": {
            "type": "string",
            "description": "The name of the relation. This is the 'end' of the link on the source objects side",
            "description_kind": "markdown",
            "required": true
          },
          "source_id": {
            "type": "string",
            "description": "The system.id of the source object",
            "description_kind": "markdown",
            "required": true
          },
          "target_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "This is the list of target object IDs to link to",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Creates a link between two data objects",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "swp_aipe_data_object": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The system.id of the data object",
            "description_kind": "markdown",
            "required": true
          },
          "properties": {
            "type": [
              "map",
              "string"
            ],
            "description": "The properties in the AIPE, as stringd",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieves a data object from the AIPE",
        "description_kind": "markdown"
      }
    }
  }
}
