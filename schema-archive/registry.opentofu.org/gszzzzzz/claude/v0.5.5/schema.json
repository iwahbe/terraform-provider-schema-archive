{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API key for the Claude Admin API. Can also be set via ANTHROPIC_ADMIN_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "base_url": {
          "type": "string",
          "description": "The base URL for the Claude Admin API. Defaults to https://api.anthropic.com. Can also be set via ANTHROPIC_BASE_URL environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Terraform provider for managing Claude resources via the Admin API.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "claude_user": {
      "version": 0,
      "block": {
        "attributes": {
          "added_at": {
            "type": "string",
            "description": "The timestamp when the user was added to the organization.",
            "description_kind": "plain",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "The email address of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "The role of the user in the organization.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Claude organization user. Users cannot be created via the API; use `terraform import` to manage existing users.",
        "description_kind": "plain"
      }
    },
    "claude_workspace": {
      "version": 0,
      "block": {
        "attributes": {
          "archived_at": {
            "type": "string",
            "description": "The timestamp when the workspace was archived, or null if active.",
            "description_kind": "plain",
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "The timestamp when the workspace was created.",
            "description_kind": "plain",
            "computed": true
          },
          "data_residency": {
            "nested_type": {
              "attributes": {
                "allowed_inference_geos": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "The allowed geographic regions for inference. Use [\"unrestricted\"] to allow all regions.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "default_inference_geo": {
                  "type": "string",
                  "description": "The default geographic region for inference.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "workspace_geo": {
                  "type": "string",
                  "description": "The geographic region for workspace data. Cannot be changed after creation.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Data residency configuration for the workspace.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "display_color": {
            "type": "string",
            "description": "The display color of the workspace, set by the API.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the workspace.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the workspace.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Claude workspace.",
        "description_kind": "plain"
      }
    },
    "claude_workspace_member": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The composite identifier of the workspace member (workspace_id/user_id).",
            "description_kind": "plain",
            "computed": true
          },
          "user_id": {
            "type": "string",
            "description": "The ID of the user.",
            "description_kind": "plain",
            "required": true
          },
          "workspace_id": {
            "type": "string",
            "description": "The ID of the workspace.",
            "description_kind": "plain",
            "required": true
          },
          "workspace_role": {
            "type": "string",
            "description": "The role of the member in the workspace. Valid values: workspace_user, workspace_developer, workspace_admin.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Claude workspace member.",
        "description_kind": "plain"
      }
    }
  },
