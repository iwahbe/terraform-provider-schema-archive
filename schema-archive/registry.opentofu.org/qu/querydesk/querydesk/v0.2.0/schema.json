{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "host": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "querydesk_database": {
      "version": 0,
      "block": {
        "attributes": {
          "adapter": {
            "type": "string",
            "description": "The adapter to use to establish the connection. Currently only `POSTGRES` and `MYSQL` are supported, but  sql server is on the roadmap.",
            "description_kind": "markdown",
            "required": true
          },
          "cacertfile": {
            "type": "string",
            "description": "The server ca cert to use with ssl connections, `ssl` must be set to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "certfile": {
            "type": "string",
            "description": "The client cert to use with ssl connections, `ssl` must be set to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "database": {
            "type": "string",
            "description": "The name of the database to connect to.",
            "description_kind": "markdown",
            "required": true
          },
          "hostname": {
            "type": "string",
            "description": "The hostname for connecting to the database, either an ip or url.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Database id.",
            "description_kind": "markdown",
            "computed": true
          },
          "keyfile": {
            "type": "string",
            "description": "The client key to use with ssl connections, `ssl` must be set to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "The name for users to use to identity the database.",
            "description_kind": "markdown",
            "required": true
          },
          "restrict_access": {
            "type": "bool",
            "description": "Whether access to this databases should be explicitly granted to users or if any authenticated user can access it.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "ssl": {
            "type": "bool",
            "description": "Set to `true` to turn on ssl connections for this database.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Database resource",
        "description_kind": "markdown"
      }
    },
    "querydesk_database_user": {
      "version": 0,
      "block": {
        "attributes": {
          "database_id": {
            "type": "string",
            "description": "Identifier of the related database.",
            "description_kind": "markdown",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Info shown in the UI to help identity available users.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID",
            "description_kind": "markdown",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "The password to authenticate the user with.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "reviews_required": {
            "type": "number",
            "description": "How many reviews are required to use this user. Can be set to 0 to not require reviews.",
            "description_kind": "markdown",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "The user to authenticate with.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "DatabaseUser resource",
        "description_kind": "markdown"
      }
    }
  }
}
