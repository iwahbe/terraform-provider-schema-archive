{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_basepath": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "api_hostname": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "api_token": {
          "type": "string",
          "description": "The API token for operations",
          "description_kind": "markdown",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "A registered Quant client name",
          "description_kind": "markdown",
          "optional": true
        },
        "project": {
          "type": "string",
          "description": "A registered Quant project name",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "quantcdn_form": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "failure_message": {
            "type": "string",
            "description": "Text to display when the form fails to submit correctly",
            "description_kind": "markdown",
            "optional": true
          },
          "honeypot_fields": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of field names that are treated as honeypot fields",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "mandatory_fields": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of field names that are required",
            "description_kind": "markdown",
            "optional": true
          },
          "mandatory_fields_message": {
            "type": "string",
            "description": "Text to display when mandatory fields are missing from the submission",
            "description_kind": "markdown",
            "optional": true
          },
          "remove_fields": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of field names to remove from submissions",
            "description_kind": "markdown",
            "optional": true
          },
          "success_message": {
            "type": "string",
            "description": "Text to display when form submission is successful",
            "description_kind": "markdown",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "The URL path to accept post values for this form",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "notification_email": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "cc": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "enabled": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "from": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "include_results": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "subject": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "text_only": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "to": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Email notification configuration",
              "description_kind": "markdown"
            },
            "max_items": 1
          },
          "notification_slack": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "enabled": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "webhook": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Slack notification configuration",
              "description_kind": "markdown"
            },
            "max_items": 1
          }
        },
        "description": "Manage forms configuration for a project",
        "description_kind": "markdown"
      }
    },
    "quantcdn_revision": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "File path to markup to send to Quant",
            "description_kind": "markdown",
            "required": true
          },
          "find_attachments": {
            "type": "bool",
            "description": "If the Quant API should crawl external assets",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "published": {
            "type": "bool",
            "description": "The published status of the revision",
            "description_kind": "markdown",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "The URL path to the revision",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage revisions for URLs for the project",
        "description_kind": "markdown"
      }
    }
  }
}
