{
  "provider": {
    "version": 0,
    "block": {
      "block_types": {
        "extra_file": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "cleanup": {
                "type": "bool",
                "description": "Set to true to delete file after execution",
                "description_kind": "markdown",
                "optional": true
              },
              "content": {
                "type": "string",
                "description": "File content",
                "description_kind": "markdown",
                "required": true
              },
              "force": {
                "type": "bool",
                "description": "Set to true to overwrite existing file",
                "description_kind": "markdown",
                "optional": true
              },
              "path": {
                "type": "string",
                "description": "Relative file path in Terraform module",
                "description_kind": "markdown",
                "required": true
              }
            },
            "description": "Additional file for Terraform Module",
            "description_kind": "markdown"
          }
        },
        "registry": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "host": {
                "type": "string",
                "description": "Terraform Registry Host",
                "description_kind": "markdown",
                "required": true
              },
              "token": {
                "type": "string",
                "description": "Terraform Registry access token",
                "description_kind": "markdown",
                "required": true,
                "sensitive": true
              }
            },
            "description_kind": "plain"
          }
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "tfcli_apply": {
      "version": 0,
      "block": {
        "attributes": {
          "backend_config": {
            "type": [
              "map",
              "string"
            ],
            "description": "Terraform module backend variables",
            "description_kind": "markdown",
            "optional": true
          },
          "envs": {
            "type": [
              "map",
              "string"
            ],
            "description": "Terraform Envrionment Variables",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "module_path": {
            "type": "string",
            "description": "Path to a local terraform module. Alternative to 'source' and 'version'",
            "description_kind": "markdown",
            "optional": true
          },
          "output": {
            "type": [
              "map",
              "string"
            ],
            "description": "Terraform output",
            "description_kind": "markdown",
            "computed": true
          },
          "source": {
            "type": "string",
            "description": "Terraform Module Source. Not required if 'module_path' is set",
            "description_kind": "markdown",
            "optional": true
          },
          "terraform_version": {
            "type": "string",
            "description": "Terraform Version",
            "description_kind": "markdown",
            "optional": true
          },
          "vars": {
            "type": [
              "map",
              "string"
            ],
            "description": "Terraform module variables",
            "description_kind": "markdown",
            "optional": true
          },
          "version": {
            "type": "string",
            "description": "Terraform Module Version. Not required if 'module_path' is set",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "extra_file": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "cleanup": {
                  "type": "bool",
                  "description": "Set to true to delete file after execution",
                  "description_kind": "markdown",
                  "optional": true
                },
                "content": {
                  "type": "string",
                  "description": "File content",
                  "description_kind": "markdown",
                  "required": true
                },
                "force": {
                  "type": "bool",
                  "description": "Set to true to overwrite existing file",
                  "description_kind": "markdown",
                  "optional": true
                },
                "path": {
                  "type": "string",
                  "description": "Relative file path in Terraform module",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "Additional file for Terraform Module",
              "description_kind": "markdown"
            }
          },
          "registry": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "Terraform Registry Host",
                  "description_kind": "markdown",
                  "required": true
                },
                "token": {
                  "type": "string",
                  "description": "Terraform Registry access token",
                  "description_kind": "markdown",
                  "required": true,
                  "sensitive": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Applies the configured Terraform Module",
        "description_kind": "markdown"
      }
    }
  }
