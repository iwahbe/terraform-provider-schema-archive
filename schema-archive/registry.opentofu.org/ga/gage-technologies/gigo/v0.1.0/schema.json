{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "url": {
          "type": "string",
          "description": "The URL to access Gigo Core.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "gigo_agent": {
      "version": 0,
      "block": {
        "attributes": {
          "arch": {
            "type": "string",
            "description": "The architecture the agent will run on. Must be one of: \"amd64\", \"armv7\", \"arm64\".",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "init_script": {
            "type": "string",
            "description": "Run this script on startup of an instance to initialize the agent.",
            "description_kind": "plain",
            "computed": true
          },
          "os": {
            "type": "string",
            "description": "The operating system the agent will run on. Must be one of: \"linux\", \"darwin\", or \"windows\".",
            "description_kind": "plain",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "Set the environment variable \"GIGO_AGENT_TOKEN\" with this token to authenticate an agent.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Use this resource to associate an agent.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "gigo_provisioner": {
      "version": 0,
      "block": {
        "attributes": {
          "arch": {
            "type": "string",
            "description": "The architecture of the host. This exposes `runtime.GOARCH` (see https://pkg.go.dev/runtime#pkg-constants).",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "os": {
            "type": "string",
            "description": "The operating system of the host. This exposes `runtime.GOOS` (see https://pkg.go.dev/runtime#pkg-constants).",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Use this data source to get information about the Gigo provisioner.",
        "description_kind": "plain"
      }
    },
    "gigo_workspace": {
      "version": 0,
      "block": {
        "attributes": {
          "access_port": {
            "type": "number",
            "description": "The access port of the Gigo deployment provisioning this workspace.",
            "description_kind": "plain",
            "computed": true
          },
          "access_url": {
            "type": "string",
            "description": "The access URL of the Gigo deployment provisioning this workspace.",
            "description_kind": "plain",
            "computed": true
          },
          "container": {
            "type": "string",
            "description": "Container that the workspace will built in.",
            "description_kind": "plain",
            "computed": true
          },
          "cpu": {
            "type": "string",
            "description": "CPU core count for the workspace.",
            "description_kind": "plain",
            "computed": true
          },
          "disk": {
            "type": "string",
            "description": "Disk size of the volume mount.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ID of the workspace.",
            "description_kind": "plain",
            "computed": true
          },
          "mem": {
            "type": "string",
            "description": "Memory size fot the workspace.",
            "description_kind": "plain",
            "computed": true
          },
          "owner": {
            "type": "string",
            "description": "Username of the workspace owner.",
            "description_kind": "plain",
            "computed": true
          },
          "owner_email": {
            "type": "string",
            "description": "Email address of the workspace owner.",
            "description_kind": "plain",
            "computed": true
          },
          "owner_id": {
            "type": "string",
            "description": "ID of the workspace owner.",
            "description_kind": "plain",
            "computed": true
          },
          "start_count": {
            "type": "number",
            "description": "A computed count based on \"transition\" state. If \"start\", count will equal 1.",
            "description_kind": "plain",
            "computed": true
          },
          "transition": {
            "type": "string",
            "description": "Either \"start\" or \"stop\". Use this to start/stop resources with \"count\".",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Use this data source to get information for the active workspace build.",
        "description_kind": "plain"
      }
    }
  }
}
