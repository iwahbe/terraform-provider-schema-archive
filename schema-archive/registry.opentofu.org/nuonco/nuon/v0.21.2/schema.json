{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "A valid API token to access the api.",
          "description_kind": "plain",
          "optional": true
        },
        "org_id": {
          "type": "string",
          "description": "Your Nuon organization ID.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "A Terraform provider for managing apps on the Nuon platform.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "nuon_app": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "App description which is used on installers and different places.",
            "description_kind": "markdown",
            "optional": true
          },
          "display_name": {
            "type": "string",
            "description": "The display name of the app.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The unique ID of the app.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The human readable name of the app.",
            "description_kind": "markdown",
            "required": true
          },
          "slack_webhook_url": {
            "type": "string",
            "description": "The slack webhook url to send notifications too",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "A Nuon application, required to set up components and installs.",
        "description_kind": "plain"
      }
    },
    "nuon_app_input": {
      "version": 0,
      "block": {
        "attributes": {
          "app_id": {
            "type": "string",
