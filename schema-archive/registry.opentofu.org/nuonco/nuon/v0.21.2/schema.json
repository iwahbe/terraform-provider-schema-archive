                  "description_kind": "plain",
                  "required": true
                },
                "directory": {
                  "type": "string",
                  "description": "The directory the component code is in. Use ./ for root.",
                  "description_kind": "plain",
                  "required": true
                },
                "repo": {
                  "type": "string",
                  "description": "The https clone url",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "A publically-accessible git repo.",
            "description_kind": "plain",
            "optional": true
