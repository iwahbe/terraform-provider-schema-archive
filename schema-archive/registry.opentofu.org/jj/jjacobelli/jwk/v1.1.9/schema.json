{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "jwk_from_k8s": {
      "version": 0,
      "block": {
        "attributes": {
          "client_certificate": {
            "type": "string",
            "description": "K8S Client Certificate",
            "description_kind": "markdown",
            "required": true
          },
          "client_key": {
            "type": "string",
            "description": "K8S Client Key",
            "description_kind": "markdown",
            "required": true
          },
          "cluster_ca_certificate": {
            "type": "string",
            "description": "K8S Cluster Certificate",
            "description_kind": "markdown",
            "required": true
          },
          "host": {
            "type": "string",
            "description": "K8S Host",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID",
            "description_kind": "markdown",
            "computed": true
          },
          "jwks": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of JWKs",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "This data source can be used to fetcks JWKs from a K8S cluster",
        "description_kind": "markdown"
      }
    },
    "jwk_to_pem": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID",
            "description_kind": "markdown",
            "computed": true
          },
          "jwk": {
            "type": "string",
            "description": "JWK",
            "description_kind": "markdown",
            "required": true
          },
          "pem": {
            "type": "string",
            "description": "PEM",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "This data source can be used to convert a JWK to PEM format",
        "description_kind": "markdown"
      }
    }
  }
}
