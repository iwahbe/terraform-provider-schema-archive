{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "additional_headers": {
          "type": [
            "map",
            "string"
          ],
          "description": "Additional Headers to pass in requests to Airbyte's API",
          "description_kind": "plain",
          "optional": true
        },
        "host_url": {
          "type": "string",
          "description": "Airbyte API URL",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Airbyte API Password",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "timeout": {
          "type": "number",
          "description": "HTTP Timeout in Seconds (Default: 600)",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Airbyte API Username",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "airbyte_connection": {
      "version": 0,
      "block": {
        "attributes": {
          "basic_schedule": {
            "nested_type": {
              "attributes": {
                "time_unit": {
                  "type": "string",
                  "description": "Allowed: minutes | hours | days | weeks | months",
                  "description_kind": "plain",
                  "required": true
                },
                "units": {
                  "type": "number",
                  "description": "Count of `time_unit`",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Basic time schedule - \"Run sync every ...\"",
            "description_kind": "plain",
            "optional": true
          },
          "breaking_change": {
            "type": "bool",
            "description": "Does this change constitute a breaking change",
            "description_kind": "plain",
            "computed": true
          },
          "cron_schedule": {
            "nested_type": {
              "attributes": {
                "cron_expression": {
                  "type": "string",
                  "description": "[Cron Expression](http://www.quartz-scheduler.org/documentation/quartz-2.3.0/tutorials/crontrigger.html). Example: `0 0 12 * * ?`.",
                  "description_kind": "markdown",
                  "required": true
                },
                "cron_time_zone": {
                  "type": "string",
                  "description": "Time Zone to honor cron expression according to. Examples: `UTC`, `US/Denver`, etc.See the 'TZ database name' column [here](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) for all options.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Flexible Cron Schedule",
            "description_kind": "plain",
            "optional": true
          },
          "destination_id": {
            "type": "string",
            "description": "Destination ID",
            "description_kind": "plain",
            "required": true
          },
          "geography": {
            "type": "string",
            "description": "Allowed Values: 'auto' | 'us' | 'eu'",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Connection ID",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Optional name of the connection",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "namespace_definition": {
            "type": "string",
            "description": "Method used for computing final namespace in destination. Allowed Values: 'source' | 'destination' | 'customformat'",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "namespace_format": {
            "type": "string",
            "description": "Used when namespaceDefinition is 'customformat'. If blank then behaves like namespaceDefinition = 'destination'. If \"${SOURCE_NAMESPACE}\" then behaves like namespaceDefinition = 'source'.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "operation_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "Operation IDs",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "prefix": {
            "type": "string",
            "description": "Prefix that will be prepended to the name of each stream when it is written to the destination. Example: \"airbyte_\"",
            "description_kind": "plain",
            "optional": true
          },
          "resource_requirements": {
            "nested_type": {
              "attributes": {
                "cpu_limit": {
                  "type": "string",
                  "description": "CPU Limit",
                  "description_kind": "plain",
                  "optional": true
                },
                "cpu_request": {
                  "type": "string",
                  "description": "CPU Requested",
                  "description_kind": "plain",
                  "optional": true
                },
                "memory_limit": {
                  "type": "string",
                  "description": "Memory Limit",
                  "description_kind": "plain",
                  "optional": true
                },
                "memory_request": {
                  "type": "string",
                  "description": "Memory Requested",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Optional resource requirements to run workers (blank for unbounded allocations)",
            "description_kind": "plain",
            "optional": true
          },
          "schedule_type": {
            "type": "string",
            "description": "Determine how the schedule data should be interpreted. Allowed: 'manual' | 'basic' | 'cron'",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "source_catalog_id": {
            "type": "string",
            "description": "Source Catalog ID",
            "description_kind": "plain",
            "optional": true
          },
          "source_id": {
            "type": "string",
            "description": "Source ID",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Active means that data is flowing through the connection. Inactive means it is not.Deprecated means the connection is off and cannot be re-activated. The schema field describes the elements of the schema that will be synced. Allowed Values: 'active' | 'inactive' | 'deprecated'.",
            "description_kind": "plain",
            "required": true
          },
          "sync_catalog": {
            "nested_type": {
              "attributes": {
                "destination_config": {
                  "nested_type": {
                    "attributes": {
                      "alias_name": {
                        "type": "string",
                        "description": "Alias name to the stream to be used in the destination",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "cursor_field": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Path to the field that will be used to determine if a record is new or modified since the last sync. This field is REQUIRED if `sync_mode` is `incremental`. Otherwise it is ignored.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "destination_sync_mode": {
                        "type": "string",
                        "description": "Allowed Values: 'append' | 'overwrite' | 'append_dedup'",
                        "description_kind": "plain",
                        "required": true
                      },
                      "primary_key": {
                        "type": [
                          "list",
                          [
                            "list",
                            "string"
                          ]
                        ],
                        "description": "Paths to the fields that will be used as primary key. This field is REQUIRED if `destination_sync_mode` is `*_dedup`. Otherwise it is ignored.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "selected": {
                        "type": "bool",
                        "description": "Whether this config is selected i.e. should be synced",
                        "description_kind": "plain",
                        "required": true
                      },
                      "sync_mode": {
                        "type": "string",
                        "description": "Allowed Values: 'full_refresh' | 'incremental'",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "The mutable part of the stream to configure the destination",
                  "description_kind": "plain",
                  "required": true
                },
                "source_schema": {
                  "nested_type": {
                    "attributes": {
                      "default_cursor_field": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Path to the field that will be used to determine if a record is new or modified since the last sync. If not provided by the source, the end user will have to specify the comparable themselves.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "json_schema": {
                        "type": "string",
                        "description": "Stream schema using json Schema specs",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "name": {
                        "type": "string",
                        "description": "Stream's name",
                        "description_kind": "plain",
                        "required": true
                      },
                      "namespace": {
                        "type": "string",
                        "description": "Optional Source-defined namespace. Airbyte streams from the same sources should have the same namespace. Currently only used by JDBC destinations to determine what schema to write to.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "source_defined_cursor": {
                        "type": "bool",
                        "description": "If the source defines the cursor field, then any other cursor field inputs will be ignored. If it does not, either the user_provided one is used, or the default one is used as a backup.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "source_defined_primary_key": {
                        "type": [
                          "list",
                          [
                            "list",
                            "string"
                          ]
                        ],
                        "description": "If the source defines the primary key, paths to the fields that will be used as a primary key. If not provided by the source, the end user will have to specify the primary key themselves.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "supported_sync_modes": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Allowed Values: 'full_refresh' | 'incremental'",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "The immutable schema defined by the source",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Describes the available schema (catalog). Each stream is split in two parts; the immutable schema from source and mutable configuration for destination.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Connection resource",
        "description_kind": "markdown"
      }
    },
    "airbyte_destination": {
