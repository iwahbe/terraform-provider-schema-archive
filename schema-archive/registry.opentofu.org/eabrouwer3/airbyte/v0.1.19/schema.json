                },
                "cpu_request": {
                  "type": "string",
                  "description": "CPU Requested",
                  "description_kind": "plain",
                  "optional": true
                },
                "job_type": {
                  "type": "string",
                  "description": "Allowed: get_spec | check_connection | discover_schema | sync | reset_connection | connection_updater | replicate",
                  "description_kind": "plain",
                  "required": true
                },
                "memory_limit": {
                  "type": "string",
                  "description": "Memory Limit",
                  "description_kind": "plain",
                  "optional": true
                },
                "memory_request": {
                  "type": "string",
                  "description": "Memory Requested",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Sets resource requirements for a specific job type for an actor definition. These values override the default, if both are set. These values will be overridden by configuration at the connection level.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Destination Definition Name",
            "description_kind": "plain",
            "required": true
