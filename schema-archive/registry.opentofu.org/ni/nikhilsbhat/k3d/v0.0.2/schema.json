{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "k3d_api_version": {
          "type": "string",
          "description": "api version of k3d to be used while creation of cluster",
          "description_kind": "markdown",
          "optional": true
        },
        "kind": {
          "type": "string",
          "description": "kind of config file that you want to use",
          "description_kind": "markdown",
          "optional": true
        },
        "kubernetes_version": {
          "type": "string",
          "description": "version of kubernetes cluster that has to be created (tag of k3s to be passed)",
          "description_kind": "markdown",
          "optional": true
        },
        "registry": {
          "type": "string",
          "description": "registry to be used for pulling images while creating cluster/nodes",
          "description_kind": "markdown",
          "optional": true
        },
        "runtime": {
          "type": "string",
          "description": "runtime in which cluster has to be created, defaults to docker",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "k3d_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "agents_count": {
            "type": "number",
            "description": "Count of agents in the cluster",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "cluster_token": {
            "type": "string",
            "description": "superSecretToken to be used",
            "description_kind": "markdown",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "config_yaml": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "Image name to be used for creation of cluster, it would be used along with kubernetes_version",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Cluster to be created",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "network": {
            "type": "string",
            "description": "Network to be associated with the cluster",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "servers_count": {
            "type": "number",
            "description": "Count of servers",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "subnetwork": {
            "type": "string",
            "description": "Define a subnet for the newly created container network",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "env": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "extra_args": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "key": {
                  "type": "string",
                  "description": "key of key-value pair",
                  "description_kind": "markdown",
                  "optional": true
                },
                "node_filters": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "value": {
                  "type": "string",
                  "description": "value of key-value pair",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Environment variables to be added nodes.",
              "description_kind": "markdown"
            }
          },
          "host_aliases": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "hostnames": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "list of hosts names mapped to an IP",
                  "description_kind": "markdown",
                  "optional": true
                },
                "ip": {
                  "type": "string",
                  "description": "ip address to which the list of hostnames to be mapped",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "/etc/hosts style entries to be injected into /etc/hosts in the node containers and in the NodeHosts section in CoreDNS.",
              "description_kind": "markdown"
            }
          },
          "k3d_options": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "loadbalancer_config_overrides": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Use dotted YAML path syntax to override nginx loadbalancer settings",
                  "description_kind": "markdown",
                  "optional": true
                },
                "no_image_volume": {
                  "type": "bool",
                  "description": "Disable the creation of a volume for importing images.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "no_loadbalancer": {
                  "type": "bool",
                  "description": "Disable the creation of a LoadBalancer in front of the server nodes.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "no_rollback": {
                  "type": "bool",
                  "description": "Disable the automatic rollback actions, if anything goes wrong.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "timeout": {
                  "type": "string",
                  "description": "Rollback changes if cluster couldn't be created in specified duration.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "wait": {
                  "type": "bool",
                  "description": "Wait for the server(s) to be ready before returning. Use '--timeout DURATION' to not wait forever. (default true).",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "k3d runtime settings",
              "description_kind": "markdown"
            }
          },
          "k3s_options": {
            "nesting_mode": "set",
            "block": {
              "block_types": {
                "extra_args": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "extra_args": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "key": {
                        "type": "string",
                        "description": "key of key-value pair",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "node_filters": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description_kind": "plain",
                        "optional": true
                      },
                      "value": {
                        "type": "string",
                        "description": "value of key-value pair",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "description": "additional arguments passed to the `k3s server|agent` command; same as `--k3s-arg`",
                    "description_kind": "markdown"
                  }
                },
                "node_labels": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "extra_args": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "key": {
                        "type": "string",
                        "description": "key of key-value pair",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "node_filters": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description_kind": "plain",
                        "optional": true
                      },
                      "value": {
                        "type": "string",
                        "description": "value of key-value pair",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "description": "same as `--k3s-node-label 'foo=bar@agent:1'` -> this results in a Kubernetes node label",
                    "description_kind": "markdown"
                  }
                }
              },
              "description": "Options passed on to K3s itself",
              "description_kind": "markdown"
            }
          },
          "kube_api": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "Important for the `server` setting in the kubeconfig.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "host_ip": {
                  "type": "string",
                  "description": "Where the Kubernetes API will be listening on.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "host_port": {
                  "type": "number",
                  "description": "Specify the Kubernetes API server port exposed on the LoadBalancer.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "same as `--api-port myhost.my.domain:6445` (where the name would resolve to 127.0.0.1)",
              "description_kind": "markdown"
            },
            "max_items": 1
          },
          "kube_config": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "switch_context": {
                  "type": "bool",
                  "description": "Directly switch the default kubeconfig's current-context to the new cluster's context",
                  "description_kind": "markdown",
                  "optional": true
                },
                "update_default": {
                  "type": "bool",
                  "description": "Directly update the default kubeconfig with the new cluster's context.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Way to manage the kubeconfig generated after creating k3d clusters.",
              "description_kind": "markdown"
            }
          },
          "ports": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "container_port": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "host": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "host_port": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                },
                "node_filters": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "protocol": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Map ports from the node containers (via the serverlb) to the host (Format: [HOST:][HOSTPORT:]CONTAINERPORT[/PROTOCOL][@NODEFILTER])",
              "description_kind": "markdown"
            }
          },
          "registries": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "config": {
                  "type": "string",
                  "description": "define contents of the `registries.yaml` file (or reference a file); same as `--registry-config /path/to/config.yaml`",
                  "description_kind": "markdown",
                  "optional": true
                },
                "create": {
                  "type": "bool",
                  "description": "creates a default registry to be used with the cluster",
                  "description_kind": "markdown",
                  "optional": true
                },
                "use": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "some other k3d-managed registry",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Define how registries should be created or used",
              "description_kind": "markdown"
            }
          },
          "runtime": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "agents_memory": {
                  "type": "string",
                  "description": "Memory limit imposed on the agents nodes [From docker]",
                  "description_kind": "markdown",
                  "optional": true
                },
                "gpu_request": {
                  "type": "string",
                  "description": "GPU devices to add to the cluster node containers ('all' to pass all GPUs) [From docker].",
                  "description_kind": "markdown",
                  "optional": true
                },
                "host_pid_mode": {
                  "type": "bool",
                  "description": "Enable host pid mode of server(s) and agent(s)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "servers_memory": {
                  "type": "string",
                  "description": "Memory limit imposed on the server nodes [From docker]",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "block_types": {
                "labels": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "extra_args": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "key": {
                        "type": "string",
                        "description": "key of key-value pair",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "node_filters": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description_kind": "plain",
                        "optional": true
                      },
                      "value": {
                        "type": "string",
                        "description": "value of key-value pair",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "description": "Labels to be added node container.",
                    "description_kind": "markdown"
                  }
                }
              },
              "description": "Runtime options for k3d",
              "description_kind": "markdown"
            },
            "max_items": 1
          },
          "volumes": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "destination": {
                  "type": "string",
                  "description": "Destination path for the volume",
                  "description_kind": "markdown",
                  "required": true
                },
                "node_filters": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "source": {
                  "type": "string",
                  "description": "Source path of volume mount",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Mount volumes into the nodes (Format: [SOURCE:]DEST[@NODEFILTER[;NODEFILTER...]]",
              "description_kind": "markdown"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "k3d_cluster_action": {
      "version": 0,
      "block": {
        "attributes": {
          "all": {
            "type": "bool",
            "description": "if enabled selected clusters would be started/stopped",
            "description_kind": "markdown",
            "optional": true
          },
          "clusters": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of k3s clusters on which the action has to be applied",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "start": {
            "type": "bool",
            "description": "if enabled it starts a stopped cluster",
            "description_kind": "markdown",
            "optional": true
          },
          "state": {
            "type": "string",
            "description": "latest state of selected clusters",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "stop": {
            "type": "bool",
            "description": "if enabled it stops a running cluster",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "status": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "agents_count": {
                  "type": "number",
                  "description": "count of agents in the cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "agents_running": {
                  "type": "number",
                  "description": "number of agents running in the cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "cluster_token": {
                  "type": "string",
                  "description": "token of the cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "has_loadbalancer": {
                  "type": "bool",
                  "description": "attribute that notifies the presence of loadbalancer in the cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "image_volume": {
                  "type": "string",
                  "description": "volume to import images",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "cluster name that was fetched",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "network": {
                  "type": "string",
                  "description": "network associated with the cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "nodes": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "list of nodes present in cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "servers_count": {
                  "type": "number",
                  "description": "count of servers",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "servers_running": {
                  "type": "number",
                  "description": "count of servers running",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "description": "updated status of clusters",
              "description_kind": "markdown"
            }
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "k3d_connect_registry": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster": {
            "type": "string",
            "description": "cluster to which registries to be associated with",
            "description_kind": "markdown",
            "required": true
          },
          "connect": {
            "type": "bool",
            "description": "enable this flag if registries to be connected with specified cluster",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "registries": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of registries to be connected to the selected cluster",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "status": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "cluster": {
                  "type": "string",
                  "description": "cluster to which the registry is either connected/disconnected",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "registry": {
                  "type": "string",
                  "description": "name of the registry",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "state": {
                  "type": "string",
                  "description": "updated state of registry",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "description": "updated status of registry",
              "description_kind": "markdown"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "k3d_load_image": {
      "version": 0,
      "block": {
        "attributes": {
          "all": {
            "type": "bool",
            "description": "if enabled loads images to all available clusters",
            "description_kind": "markdown",
            "optional": true
          },
          "cluster": {
            "type": "string",
            "description": "name of the existing cluster to which the images has to be imported to",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "images": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of images to be imported to the existing cluster",
            "description_kind": "markdown",
            "required": true
          },
          "images_stored": {
            "type": [
              "list",
              [
                "object",
                {
                  "cluster": "string",
                  "images": [
                    "list",
                    "string"
                  ]
                }
              ]
            ],
            "description": "list of images loaded to the cluster",
            "description_kind": "markdown",
            "computed": true
          },
          "keep_tarball": {
            "type": "bool",
            "description": "enable to keep the tarball of the loaded images locally",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "k3d_node": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster": {
            "type": "string",
            "description": "name of the cluster to which these nodes to be connected with",
            "description_kind": "markdown",
            "required": true
          },
          "creation_time": {
            "type": "string",
            "description": "timestamp of nodes creation, this would be used to track the nodes created",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "image to be used for nodes creation defaults to image declared in provider",
            "description_kind": "markdown",
            "optional": true
          },
          "memory": {
            "type": "string",
            "description": "memory limit to be imposed on the node",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "name the nodes to be created (index would be used to dynamically compute the names for nodes)",
            "description_kind": "markdown",
            "required": true
          },
          "nodes": {
            "type": [
              "list",
              [
                "object",
                {
                  "cluster": "string",
                  "created": "string",
                  "env": [
                    "list",
                    "string"
                  ],
                  "image": "string",
                  "memory": "string",
                  "name": [
                    "list",
                    "string"
                  ],
                  "networks": [
                    "list",
                    "string"
                  ],
                  "role": "string",
                  "state": "string",
                  "volumes": [
                    "list",
                    "string"
                  ]
                }
              ]
            ],
            "description": "list of nodes that were created",
            "description_kind": "markdown",
            "computed": true
          },
          "replicas": {
            "type": "number",
            "description": "number of nodes to be created",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "role to be assigned to the node(agent)",
            "description_kind": "markdown",
            "optional": true
          },
          "timeout": {
            "type": "number",
            "description": "maximum waiting time for before canceling/returning in minutes",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "wait": {
            "type": "bool",
            "description": "if enabled waits for nodes to be ready before returning",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "k3d_node_action": {
      "version": 0,
      "block": {
        "attributes": {
          "all": {
            "type": "bool",
            "description": "if enabled fetches all the nodes available in the selected cluster",
            "description_kind": "markdown",
            "optional": true
          },
          "cluster": {
            "type": "string",
            "description": "name of the cluster of which that nodes to be acted upon",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "nodes": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of nodes on which the action has to be applied",
            "description_kind": "markdown",
