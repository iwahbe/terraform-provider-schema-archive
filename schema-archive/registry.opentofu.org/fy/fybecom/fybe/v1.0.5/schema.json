{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api": {
          "type": "string",
          "description": "The api endpoint is https://api.fybe.com.",
          "description_kind": "plain",
          "optional": true
        },
        "oauth2_client_id": {
          "type": "string",
          "description": "Your oauth2 client id can be found in the [Customer Control Panel](https://new.fybe.com/account/security) under the menu item account secret.",
          "description_kind": "plain",
          "optional": true
        },
        "oauth2_client_secret": {
          "type": "string",
          "description": "Your oauth2 client secret can be found in the [Customer Control Panel](https://new.fybe.com/account/security) under the menu item account secret.",
          "description_kind": "plain",
          "optional": true
        },
        "oauth2_pass": {
          "type": "string",
          "description": "API Password (this is a new password which you'll set or change in the [Customer Control Panel](https://new.fybe.com/account/security) under the menu item account secret.)",
          "description_kind": "plain",
          "optional": true
        },
        "oauth2_token_url": {
          "type": "string",
          "description": "The oauth2 token url is https://airlock.fybe.com/auth/realms/fybe/protocol/openid-connect/token.",
          "description_kind": "plain",
          "optional": true
        },
        "oauth2_user": {
          "type": "string",
          "description": "API User (your email address to login to the [Customer Control Panel](https://new.fybe.com/account/security) under the menu item account secret.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "fybe_image": {
      "version": 0,
      "block": {
        "attributes": {
          "creation_date": {
            "type": "string",
            "description": "The creation date of the image.",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Description of the image.",
            "description_kind": "plain",
            "required": true
          },
          "error_message": {
            "type": "string",
            "description": "If the image is in an error state (see status property), the error message can be seen in this field.",
            "description_kind": "plain",
            "computed": true
          },
          "format": {
            "type": "string",
            "description": "Format of your image `iso` or `qcow`.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The identifier of the image",
            "description_kind": "plain",
            "computed": true
          },
          "image_url": {
            "type": "string",
            "description": "Image download url.",
            "description_kind": "plain",
            "required": true
          },
          "last_updated": {
            "type": "string",
            "description": "Last update time of the image.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Image name.",
            "description_kind": "plain",
            "required": true
          },
          "os_type": {
            "type": "string",
            "description": "Please indicate the type of operating system (OS) you want to use. For MS Windows, specify 'Windows,' and for other OS options, specify 'Linux.' Selecting the incorrect OS type may result in a non-functional cloud instance.",
            "description_kind": "plain",
            "required": true
          },
          "standard_image": {
            "type": "bool",
            "description": "Flag indicating that the image is either a standard (true) or a custom image (false).",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Downloading status of the image `downloading|downloaded|error`.",
            "description_kind": "plain",
            "computed": true
          },
          "uploaded_size_mb": {
            "type": "number",
            "description": "The size of the uploaded image in megabyte.",
            "description_kind": "plain",
            "computed": true
          },
          "version": {
            "type": "string",
            "description": "Please provide a version number to differentiate the contents of the image, such as the version of the operating system.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "To add a custom image, provide a direct download URL for the image in either .iso or .qcow2 format. Any other formats will not be accepted. Please be aware that the download duration depends on your network speed and the image's size. You can monitor the download status by making a GET request to obtain information about the image. Download requests will be declined if they surpass your allocated limits.",
        "description_kind": "plain"
      }
    },
    "fybe_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "additional_ips": {
            "type": [
              "list",
              [
                "object",
