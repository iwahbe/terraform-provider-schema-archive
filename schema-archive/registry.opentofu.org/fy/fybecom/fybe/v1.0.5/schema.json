            "computed": true
          },
          "id": {
            "type": "string",
            "description": "object-storage Id.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of your bucket, consider the naming restriction https://docs.aws.amazon.com/awscloudtrail/latest/userguide/cloudtrail-s3-bucket-naming-requirements.html.",
            "description_kind": "plain",
            "required": true
          },
          "object_storage_id": {
            "type": "string",
            "description": "The Fybe objectStorageId on which the bucket should be created.",
            "description_kind": "plain",
            "required": true
          },
          "public_sharing": {
            "type": "bool",
            "description": "Choose the access to your bucket. You can not share it at all or share it publicly.",
            "description_kind": "plain",
            "optional": true
          },
          "public_sharing_link": {
            "type": "string",
            "description": "If your bucket is publicly shared, you can access it with this link.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manage buckets on your Fybe object-storage. With this resource you are able to manage your buckets the same way your are able to manage them in your Fybe cockpit.",
        "description_kind": "plain"
      }
    },
