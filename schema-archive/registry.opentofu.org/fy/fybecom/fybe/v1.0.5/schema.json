                  "v4": [
                    "list",
                    [
                      "object",
                      {
                        "gateway": "string",
                        "ip": "string",
                        "netmask_cidr": "number"
                      }
                    ]
                  ]
                }
              ]
            ],
            "description": "All other additional IP addresses of the instance.",
            "description_kind": "plain",
            "computed": true
          },
          "cancel_date": {
            "type": "string",
            "description": "The date on which the instance will not longer be accessable due to a cancellation.",
            "description_kind": "plain",
            "optional": true
          },
          "cpu_cores": {
            "type": "number",
            "description": "CPU core count of the instance.",
            "description_kind": "plain",
            "computed": true
          },
          "created_date": {
            "type": "string",
            "description": "Instance creation date.",
            "description_kind": "plain",
            "computed": true
          },
          "disk_mb": {
            "type": "number",
            "description": "Image disk size of the instance in megabyte.",
            "description_kind": "plain",
            "computed": true
          },
          "display_name": {
            "type": "string",
            "description": "Your choosed name for the instance, you can change it in the cockpit.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "error_message": {
            "type": "string",
            "description": "If the instance is in an error state (see status property), the error message can be seen in this field.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Compute instance Id",
            "description_kind": "plain",
            "computed": true
          },
          "image_id": {
            "type": "string",
            "description": "CAUTION: On updating this value your server will be reinstalled! You can find the available image Ids via [API](https://api.fybe.com/#tag/Images/operation/retrieveImage) or via our [command line](https://github.com/fybecom/fybe) tool with this command: `fybe get images`.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ip_config": {
            "type": [
              "list",
              [
                "object",
                {
                  "v4": [
                    "list",
                    [
                      "object",
                      {
                        "gateway": "string",
                        "ip": "string",
                        "netmask_cidr": "number"
                      }
                    ]
                  ],
                  "v6": [
                    "list",
                    [
                      "object",
                      {
                        "gateway": "string",
                        "ip": "string",
                        "netmask_cidr": "number"
                      }
                    ]
                  ]
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Last modified date of the instance.",
            "description_kind": "plain",
            "computed": true
          },
          "license": {
            "type": "string",
            "description": "Additional license in order to enhance your instance. Possible license to buy are cpanel and plesk.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "mac_address": {
            "type": "string",
            "description": "Instance mac address.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Fybe name of the instance.",
            "description_kind": "plain",
            "computed": true
          },
          "os_type": {
            "type": "string",
            "description": "Type of operating system (OS) installed on the instance.",
            "description_kind": "plain",
            "computed": true
          },
          "period": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "product_id": {
            "type": "string",
            "description": "Choose the instance that fits for you.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "product_type": {
            "type": "string",
            "description": "Instances category depending on ProductId. Following product types are available: `ssd`,`nvme`.",
            "description_kind": "plain",
            "computed": true
          },
          "ram_mb": {
            "type": "number",
            "description": "Image ram size in megabyte.",
            "description_kind": "plain",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "The region in it the instance should be installed. Default region is the us-east-1.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "root_password": {
            "type": "number",
            "description": "CAUTION: On updating this value your server will be reinstalled! Root password of the instance.",
            "description_kind": "plain",
            "optional": true
          },
          "ssh_keys": {
            "type": [
              "list",
              "number"
            ],
            "description": "Important: Updating this value will result in your server being reinstalled! This pertains to an array of secretIds that represent public SSH keys used for logging in as the defaultUser with administrator/root privileges. This functionality is applicable to Linux/BSD systems. For further details, please consult the Secrets Management API.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Instance status. The status can be set to `provisioning|uninstalled|running|stopped|error|installing|unknown|installed`.",
            "description_kind": "plain",
            "computed": true
          },
          "user_data": {
            "type": "string",
            "description": "CAUTION: On updating this value your server will be reinstalled! Cloud-Init Config in order to customize during start of the instance.",
            "description_kind": "plain",
            "optional": true
          },
          "v_host_id": {
            "type": "number",
            "description": "vHost Identifier.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "add_ons": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Ids for addons to pimp your instance.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "quantity": {
                  "type": "number",
                  "description": "The number of Addons you wish to buy.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Create and manage compute resources. Cloud-Init is also supported.",
        "description_kind": "plain"
      }
    },
    "fybe_object_storage": {
      "version": 0,
      "block": {
        "attributes": {
          "cancel_date": {
            "type": "string",
            "description": "The date on which the object-storage no longer available, due to cancellation.",
            "description_kind": "plain",
            "computed": true
          },
          "created_date": {
            "type": "string",
            "description": "object-storage creation date.",
            "description_kind": "plain",
            "computed": true
          },
          "customer_id": {
            "type": "string",
            "description": "Your customer Id.",
            "description_kind": "plain",
            "computed": true
          },
          "data_center": {
            "type": "string",
            "description": "Data center located of this object-storage",
            "description_kind": "plain",
            "computed": true
          },
          "display_name": {
            "type": "string",
            "description": "Name for this object-storage.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "object-storage identifier.",
            "description_kind": "plain",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Region of this object-storage.",
            "description_kind": "plain",
            "required": true
          },
          "s3_tenant_id": {
            "type": "string",
            "description": "The S3 tenant Id is only needed for public sharing.",
            "description_kind": "plain",
            "computed": true
          },
          "s3_url": {
            "type": "string",
            "description": "S3 URL needed to connect to the s3 API.",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "The object storage status. It can be set to `PROVISIONING|READY|UPGRADING|CANCELLED|ERROR|DISABLED`.",
            "description_kind": "plain",
            "computed": true
          },
          "tenant_id": {
            "type": "string",
            "description": "Your tenant Id.",
            "description_kind": "plain",
            "computed": true
          },
          "total_purchased_space_tb": {
            "type": "number",
            "description": "Amount of purchased space in terabyte.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "auto_scaling": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "error_message": {
                  "type": "string",
                  "description": "If the autoscaling is in an error state (see status property), the error message can be seen in this field.",
                  "description_kind": "plain",
                  "optional": true
                },
                "size_limit_tb": {
                  "type": "number",
                  "description": "Limit for the size to be autoscaled.",
                  "description_kind": "plain",
                  "optional": true
                },
                "state": {
                  "type": "string",
                  "description": "Autoscaling status it can be `enabled|disabled|error`.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Create and manage our S3 compatible object-storage.  Please be aware that this resource is not the S3 API. If you wish to access the S3 API directly or use S3 compatible tools like the aws CLI, you can do so by using the S3 URL provided by this resource after creating. To retrieve the S3 credentials, please refer to the User Management API.",
        "description_kind": "plain"
      }
    },
    "fybe_object_storage_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "creation_date": {
            "type": "string",
            "description": "The creation date of the bucket.",
