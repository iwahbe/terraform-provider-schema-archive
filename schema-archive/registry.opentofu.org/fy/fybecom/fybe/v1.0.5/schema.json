            "type": "string",
            "description": "Full name of the VPC region.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "VPC modified date.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
