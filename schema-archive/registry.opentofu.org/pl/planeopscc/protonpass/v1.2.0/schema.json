{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "agent_reason": {
          "type": "string",
          "description": "Reason string passed as `PROTON_PASS_AGENT_REASON` to pass-cli. Required when using agent tokens (pass-cli v2.1.0+). Must be between 1 and 300 characters. If `PROTON_PASS_AGENT_REASON` is already set in the environment, this value takes priority.",
          "description_kind": "markdown",
          "optional": true
        },
        "cli_path": {
          "type": "string",
          "description": "Path to the pass-cli binary. Default: 'pass-cli' (from PATH).",
          "description_kind": "markdown",
          "optional": true
        },
        "timeout": {
          "type": "number",
          "description": "Timeout in seconds for CLI commands. Default: 30.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Terraform provider for Proton Pass. Manages vaults and items via the pass-cli.",
      "description_kind": "markdown"
    }
  },
