            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the alias item.",
            "description_kind": "markdown",
            "computed": true
          },
          "prefix": {
            "type": "string",
            "description": "The prefix of the email alias (e.g., `my_prefix` results in `my_prefix.random@passmail.net`).",
            "description_kind": "markdown",
            "required": true
          },
          "share_id": {
            "type": "string",
            "description": "The Share ID of the vault where the alias is created.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Creates a Hide-My-Email Alias in Proton Pass.",
        "description_kind": "markdown"
      }
