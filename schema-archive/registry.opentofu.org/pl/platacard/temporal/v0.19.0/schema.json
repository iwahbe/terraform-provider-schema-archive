{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "audience": {
          "type": "string",
          "description": "Audience of the token.",
          "description_kind": "plain",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "The OAuth2 Client ID for API operations.",
          "description_kind": "plain",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "The OAuth2 Client Secret for API operations.",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "The Temporal server host.",
          "description_kind": "plain",
          "optional": true
        },
        "insecure": {
          "type": "bool",
          "description": "Use insecure connection",
          "description_kind": "plain",
          "optional": true
        },
        "port": {
          "type": "string",
          "description": "The Temporal server port.",
          "description_kind": "plain",
          "optional": true
        },
        "scopes": {
          "type": [
            "list",
            "string"
          ],
          "description": "OAuth2 scopes requested when fetching a token. Defaults to [\"openid\", \"profile\", \"email\"].",
          "description_kind": "plain",
          "optional": true
        },
        "token_url": {
          "type": "string",
          "description": "Oauth2 server URL to fetch token from",
          "description_kind": "plain",
          "optional": true
        }
      },
      "block_types": {
        "tls": {
          "nesting_mode": "single",
          "block": {
            "attributes": {
              "ca": {
                "type": "string",
                "description": "CA certificates",
                "description_kind": "plain",
                "optional": true
              },
              "cert": {
                "type": "string",
                "description": "Client certificate PEM",
                "description_kind": "plain",
                "optional": true
              },
              "cert_reload_time": {
                "type": "number",
                "description": "Certificate reload time",
                "description_kind": "plain",
                "optional": true
              },
              "key": {
                "type": "string",
                "description": "Private key PEM",
                "description_kind": "plain",
                "optional": true
              },
              "server_name": {
                "type": "string",
                "description": "Used to verify the hostname and included in handshake",
                "description_kind": "plain",
                "optional": true
              }
            },
            "description": "TLS Configuration for the Temporal server",
            "description_kind": "plain"
          }
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "temporal_namespace": {
      "version": 0,
      "block": {
        "attributes": {
          "active_cluster_name": {
            "type": "string",
            "description": "Active Cluster Name",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "clusters": {
            "type": [
              "list",
              "string"
            ],
            "description": "Clusters",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Namespace Description",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "history_archival_state": {
            "type": "string",
            "description": "History Archival State",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "history_archival_uri": {
            "type": "string",
            "description": "History Archival URI",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Namespace identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "is_global_namespace": {
            "type": "bool",
            "description": "Namespace is Global",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Namespace name",
            "description_kind": "markdown",
            "required": true
          },
          "owner_email": {
            "type": "string",
            "description": "Namespace Owner Email",
            "description_kind": "markdown",
            "required": true
          },
          "retention": {
            "type": "number",
            "description": "Workflow Execution retention",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "visibility_archival_state": {
            "type": "string",
            "description": "Visibility Archival State",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "visibility_archival_uri": {
            "type": "string",
            "description": "Visibility Archival URI",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Temporal Namespace resource",
        "description_kind": "markdown"
      }
    },
    "temporal_schedule": {
      "version": 0,
      "block": {
        "attributes": {
          "action": {
            "nested_type": {
              "attributes": {
                "workflow": {
                  "nested_type": {
                    "attributes": {
                      "execution_timeout": {
                        "type": "string",
                        "description": "Execution timeout",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "input": {
                        "type": "string",
                        "description": "Workflow input (JSON)",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "run_timeout": {
                        "type": "string",
                        "description": "Run timeout",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "task_queue": {
                        "type": "string",
                        "description": "Task Queue",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "task_timeout": {
                        "type": "string",
                        "description": "Task timeout",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "workflow_id": {
                        "type": "string",
                        "description": "Workflow ID",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "workflow_type": {
                        "type": "string",
                        "description": "Workflow Type",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Workflow action",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Action to execute on schedule",
            "description_kind": "markdown",
            "required": true
          },
          "memo": {
            "type": [
              "map",
              "string"
            ],
            "description": "Non-indexed key-value pairs for metadata",
            "description_kind": "markdown",
            "optional": true
          },
          "namespace": {
            "type": "string",
            "description": "Namespace where the schedule resides",
            "description_kind": "markdown",
            "required": true
          },
          "policy_config": {
            "nested_type": {
              "attributes": {
                "catchup_window": {
                  "type": "string",
                  "description": "Maximum catch-up time for when the Service is unavailable",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "overlap_policy": {
                  "type": "string",
                  "description": "Policy for handling overlapping Workflow Executions. Accepted values: Skip, BufferOne, BufferAll, CancelOther, TerminateOther, AllowAll",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "pause_on_failure": {
                  "type": "bool",
                  "description": "Pause the schedule on action failure",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Schedule policy configuration",
            "description_kind": "markdown",
            "required": true
          },
          "schedule_id": {
            "type": "string",
            "description": "Unique identifier for the schedule",
            "description_kind": "markdown",
            "required": true
          },
          "spec": {
            "nested_type": {
              "attributes": {
                "calendar_items": {
                  "nested_type": {
                    "attributes": {
                      "comment": {
                        "type": "string",
                        "description": "Optional comment describing this calendar entry",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "day_of_month": {
                        "type": "string",
                        "description": "Day of month specification (e.g., '1', '1,15', '1-31')",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "day_of_week": {
                        "type": "string",
                        "description": "Day of week specification in numeric format (e.g., '1', '1-6', '1,3,5')",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "hour": {
                        "type": "string",
                        "description": "Hour specification (e.g., '9', '9-17', '11-14')",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "minute": {
                        "type": "string",
                        "description": "Minute specification (e.g., '0', '0,30', '*/15', '*')",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "month": {
                        "type": "string",
                        "description": "Month specification in numeric format (e.g., '1', '1,2,9', '1-12')",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "second": {
                        "type": "string",
                        "description": "Second specification (e.g., '0', '0,30', '*')",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "year": {
                        "type": "string",
                        "description": "Year specification (e.g., '2022', '2022-2025')",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "Calendar expressions for schedule",
                  "description_kind": "markdown",
                  "optional": true
                },
                "cron_items": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Traditional cron expressions (e.g. '15 8 * * *')",
                  "description_kind": "markdown",
                  "optional": true
                },
                "end_time": {
                  "type": "string",
                  "description": "End time of the schedule (RFC3339)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "intervals": {
                  "nested_type": {
                    "attributes": {
                      "every": {
                        "type": "string",
                        "description": "Duration of the interval (e.g., '24h', '7d')",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "offset": {
                        "type": "string",
                        "description": "Offset from the interval (e.g., '1h')",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "Time intervals for schedule",
                  "description_kind": "markdown",
                  "optional": true
                },
                "jitter": {
                  "type": "string",
                  "description": "Jitter duration to add randomness to scheduled times",
                  "description_kind": "markdown",
                  "optional": true
                },
                "start_time": {
                  "type": "string",
                  "description": "Start time of the schedule (RFC3339)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "time_zone": {
                  "type": "string",
                  "description": "Time zone for the schedule",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Schedule specification",
            "description_kind": "markdown",
            "required": true
          },
          "state": {
            "nested_type": {
              "attributes": {
                "limited_actions": {
                  "type": "bool",
                  "description": "Whether the schedule is limited to a specific number of actions",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "notes": {
                  "type": "string",
                  "description": "Initial notes",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "paused": {
                  "type": "bool",
                  "description": "Pause the Schedule immediately on creation",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "remaining_actions": {
                  "type": "number",
                  "description": "Total allowed actions",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Schedule state",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Temporal Schedule resource for managing workflow schedules",
        "description_kind": "markdown"
      }
    },
