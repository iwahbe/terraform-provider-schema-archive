{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "The URL of the Superset instance. This should include the protocol (http or https) and the hostname or IP address. Example: 'https://superset.example.com'.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The password to authenticate with Superset. This value is sensitive and will not be displayed in logs or state files.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "The username to authenticate with Superset. This user should have the necessary permissions to manage resources within Superset.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Superset provider for managing Superset resources.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "superset_database": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_ctas": {
            "type": "bool",
            "description": "Allow CTAS.",
            "description_kind": "plain",
            "required": true
          },
          "allow_cvas": {
            "type": "bool",
            "description": "Allow CVAS.",
            "description_kind": "plain",
            "required": true
          },
          "allow_dml": {
            "type": "bool",
            "description": "Allow DML.",
            "description_kind": "plain",
            "required": true
          },
          "allow_run_async": {
            "type": "bool",
            "description": "Allow run async.",
            "description_kind": "plain",
            "required": true
          },
          "connection_name": {
            "type": "string",
            "description": "Name of the database connection.",
            "description_kind": "plain",
            "required": true
          },
          "db_engine": {
            "type": "string",
            "description": "Database engine (e.g., postgresql, mysql).",
            "description_kind": "plain",
            "required": true
          },
          "db_host": {
            "type": "string",
            "description": "Database host.",
            "description_kind": "plain",
            "required": true
          },
          "db_name": {
            "type": "string",
            "description": "Database name.",
            "description_kind": "plain",
            "required": true
          },
          "db_pass": {
            "type": "string",
            "description": "Database password.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "db_port": {
            "type": "number",
            "description": "Database port.",
            "description_kind": "plain",
            "required": true
          },
          "db_user": {
            "type": "string",
            "description": "Database username.",
            "description_kind": "plain",
            "required": true
          },
          "expose_in_sqllab": {
            "type": "bool",
            "description": "Expose in SQL Lab.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "Numeric identifier of the database connection.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a database connection in Superset.",
        "description_kind": "plain"
      }
    },
    "superset_dataset": {
      "version": 0,
      "block": {
        "attributes": {
          "database_name": {
            "type": "string",
            "description": "Name of the database where the dataset resides. Cannot be changed after creation.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "Numeric identifier of the dataset.",
            "description_kind": "plain",
            "computed": true
          },
          "schema": {
            "type": "string",
            "description": "Database schema name (optional).",
            "description_kind": "plain",
            "optional": true
          },
          "sql": {
            "type": "string",
            "description": "SQL query for the dataset (optional, for SQL-based datasets).",
            "description_kind": "plain",
            "optional": true
          },
          "table_name": {
            "type": "string",
            "description": "Name of the table or dataset.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a dataset in Superset.",
        "description_kind": "plain"
      }
    },
    "superset_meta_database": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_ctas": {
            "type": "bool",
            "description": "Allow CREATE TABLE AS queries.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "allow_cvas": {
            "type": "bool",
            "description": "Allow CREATE VIEW AS queries.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "allow_dml": {
            "type": "bool",
            "description": "Allow DML queries (INSERT, UPDATE, DELETE).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "allow_run_async": {
            "type": "bool",
            "description": "Allow asynchronous query execution.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "allowed_databases": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of database names that can be accessed through this meta connection.",
            "description_kind": "plain",
            "required": true
          },
          "database_name": {
            "type": "string",
            "description": "Name of the meta database connection.",
            "description_kind": "plain",
            "required": true
          },
          "expose_in_sqllab": {
            "type": "bool",
            "description": "Whether to expose this connection in SQL Lab.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Numeric identifier of the meta database connection.",
            "description_kind": "plain",
            "computed": true
          },
          "is_managed_externally": {
            "type": "bool",
            "description": "Whether this connection is managed externally.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "sqlalchemy_uri": {
            "type": "string",
            "description": "SQLAlchemy URI for the meta database connection. Defaults to 'superset://' for meta databases.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a meta database connection in Superset for cross-database queries.",
        "description_kind": "plain"
      }
    },
    "superset_role": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "number",
            "description": "Numeric identifier of the role.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last update.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the role.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a role in Superset.",
        "description_kind": "plain"
      }
    },
    "superset_role_permissions": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the role permissions resource.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "The timestamp of the last update to the role permissions.",
            "description_kind": "plain",
            "computed": true
          },
          "resource_permissions": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "number",
                  "description": "The unique identifier of the permission.",
                  "description_kind": "plain",
                  "computed": true
                },
                "permission": {
                  "type": "string",
                  "description": "The name of the permission.",
                  "description_kind": "plain",
                  "required": true
                },
                "view_menu": {
                  "type": "string",
                  "description": "The name of the view menu associated with the permission.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "A list of permissions associated with the role.",
            "description_kind": "plain",
            "required": true
          },
          "role_name": {
            "type": "string",
            "description": "The name of the role to which the permissions are assigned.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages the permissions associated with a role in Superset.",
        "description_kind": "plain"
      }
    },
    "superset_user": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Whether the user is active. Defaults to true.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "Email address of the user.",
            "description_kind": "plain",
            "required": true
          },
          "first_name": {
            "type": "string",
            "description": "First name of the user.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "Numeric identifier of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "last_name": {
            "type": "string",
            "description": "Last name of the user.",
            "description_kind": "plain",
            "optional": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last update.",
            "description_kind": "plain",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "Password of the user. Required for creation, optional for updates.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "roles": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of role IDs assigned to the user.",
            "description_kind": "plain",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "Username of the user.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a user in Superset.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "superset_databases": {
      "version": 0,
      "block": {
        "attributes": {
          "databases": {
            "nested_type": {
              "attributes": {
                "database_name": {
                  "type": "string",
                  "description": "Name of the database.",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Numeric identifier of the database.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of databases.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches the list of databases from Superset.",
        "description_kind": "plain"
      }
    },
    "superset_datasets": {
      "version": 0,
      "block": {
        "attributes": {
          "datasets": {
            "nested_type": {
              "attributes": {
                "database_id": {
                  "type": "number",
                  "description": "Database ID to which the dataset belongs.",
                  "description_kind": "plain",
                  "computed": true
                },
                "database_name": {
                  "type": "string",
                  "description": "Database name to which the dataset belongs.",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Dataset ID.",
                  "description_kind": "plain",
                  "computed": true
                },
                "kind": {
                  "type": "string",
                  "description": "Kind of the dataset.",
                  "description_kind": "plain",
                  "computed": true
                },
                "owners": {
                  "nested_type": {
                    "attributes": {
                      "first_name": {
                        "type": "string",
                        "description": "First name of the owner.",
