{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Spaceship API key, created in the [API Manager](https://www.spaceship.com/application/api-manager/). If omitted, the provider will attempt to read the value from the `SPACESHIP_API_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "api_secret": {
          "type": "string",
          "description": "Spaceship API secret, created in the [API Manager](https://www.spaceship.com/application/api-manager/) alongside the API key. If omitted, the provider will attempt to read the value from the `SPACESHIP_API_SECRET` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Spaceship provider is used to manage DNS records and domain settings, including auto-renew and nameservers, for domains managed by the Spaceship registrar",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "spaceship_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "IPv4 or IPv6 address for A and AAAA records",
            "description_kind": "markdown",
            "optional": true
          },
          "alias_name": {
            "type": "string",
            "description": "Canonical domain name for ALIAS records. Implements CNAME-like behavior for the zone apex where CNAME is not allowed.",
            "description_kind": "markdown",
            "optional": true
          },
          "association_data": {
            "type": "string",
            "description": "Association data (hex) for TLSA records.",
            "description_kind": "markdown",
            "optional": true
          },
          "cname": {
            "type": "string",
            "description": "Canonical name for CNAME records.",
            "description_kind": "markdown",
            "optional": true
          },
          "domain": {
            "type": "string",
            "description": "The domain name the record belongs to (for example `example.com`). The domain must already exist in the Spaceship account.",
            "description_kind": "markdown",
            "required": true
          },
          "exchange": {
            "type": "string",
            "description": "Mail exchange host for MX records.",
            "description_kind": "markdown",
            "optional": true
          },
          "flag": {
            "type": "number",
            "description": "Flag for CAA records (0 or 128).",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Composite identifier with the form `domain/TYPE/name/<data-signature>`. The data signature is a normalized representation of the record's type-specific fields (lowercased, pipe-separated) and is the same key used internally for record matching. Stable across updates that don't change identity (e.g. TTL changes).",
            "description_kind": "markdown",
            "computed": true
          },
          "matching": {
            "type": "number",
            "description": "Matching type for TLSA records (0-255).",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Record host. Use `@` for the zone apex.",
            "description_kind": "markdown",
            "required": true
          },
          "nameserver": {
            "type": "string",
            "description": "Nameserver host for NS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "pointer": {
            "type": "string",
            "description": "Pointer target for PTR records.",
            "description_kind": "markdown",
            "optional": true
          },
          "port": {
            "type": "string",
            "description": "Port for HTTPS, SVCB and TLSA records(accepts `*` or `_NNNN`).",
            "description_kind": "markdown",
            "optional": true
          },
          "port_number": {
            "type": "number",
            "description": "Port for SRV records (1-65535).",
            "description_kind": "markdown",
            "optional": true
          },
          "preference": {
            "type": "number",
            "description": "Preference value for MX records (0-65535).",
            "description_kind": "markdown",
            "optional": true
          },
          "priority": {
            "type": "number",
            "description": "Priority for SRV records (0-65535).",
            "description_kind": "markdown",
            "optional": true
          },
          "protocol": {
            "type": "string",
            "description": "Protocol label for SRV/TLSA records (e.g. `_tcp`).",
            "description_kind": "markdown",
            "optional": true
          },
          "scheme": {
            "type": "string",
            "description": "Scheme for HTTPS/SVCB/TLSA records (for example `_https`, `_tcp`)",
            "description_kind": "markdown",
            "optional": true
          },
          "selector": {
            "type": "number",
            "description": "Selector value for TLSA records (0-255).",
            "description_kind": "markdown",
            "optional": true
          },
          "service": {
            "type": "string",
            "description": "Service label for SRV records (for example `_sip`).",
            "description_kind": "markdown",
            "optional": true
          },
          "svc_params": {
            "type": "string",
            "description": "SvcParams string for HTTPS/SVCB records.",
            "description_kind": "markdown",
            "optional": true
          },
          "svc_priority": {
            "type": "number",
            "description": "Service priority for HTTPS/SVCB records (0-65535).",
            "description_kind": "markdown",
            "optional": true
          },
          "tag": {
            "type": "string",
            "description": "Tag for CAA records (e.g. `issue`)",
            "description_kind": "markdown",
            "optional": true
          },
          "target": {
            "type": "string",
            "description": "Target host for SRV records.",
            "description_kind": "markdown",
            "optional": true
          },
          "target_name": {
            "type": "string",
            "description": "Target name for HTTPS/SVCB records.",
            "description_kind": "markdown",
            "optional": true
          },
          "ttl": {
            "type": "number",
            "description": "Record TTL in seconds. Defaults to 3600 if omitted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "DNS record type(A, AAAA, ALIAS, CAA, CNAME, HTTPS, MX, NS, PTR, SRV, SVCB, TLSA, TXT).",
            "description_kind": "markdown",
            "required": true
          },
          "usage": {
            "type": "number",
            "description": "Usage value for TLSA records (0-255).",
            "description_kind": "markdown",
            "optional": true
          },
          "value": {
            "type": "string",
            "description": "Generic value field used by several record types (CAA, TXT).",
            "description_kind": "markdown",
            "optional": true
          },
          "weight": {
            "type": "number",
            "description": "Weight for SRV records (0-65535).",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages a single DNS record for a Spaceship-managed domain. Only records in the `custom` DNS group are managed \u2014 records owned by Spaceship features (e.g. URL redirect, personal nameservers) are left untouched.",
        "description_kind": "markdown"
      }
    },
    "spaceship_dns_records": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The domain name to manage (for example `example.com`). The domain must already exist in the Spaceship account.",
            "description_kind": "markdown",
            "required": true
          },
          "force": {
            "type": "bool",
            "description": "Deprecated: this attribute has no effect. The provider always applies DNS updates with force enabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Internal identifier for tf state.",
            "description_kind": "markdown",
            "computed": true
          },
          "records": {
            "nested_type": {
              "attributes": {
                "address": {
                  "type": "string",
                  "description": "IPv4 or IPv6 address for A and AAAA records",
