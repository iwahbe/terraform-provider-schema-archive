        "description_kind": "markdown"
      }
    },
    "spaceship_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "auto_renew": {
            "type": "bool",
            "description": "Indicates whether the auto-renew option is enabled",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "contacts": {
            "nested_type": {
              "attributes": {
                "admin": {
                  "type": "string",
                  "description": "Administrative contact handle when provided.",
                  "description_kind": "plain",
                  "computed": true
                },
                "attributes": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Optional list of contact attributes supplied by Spaceship.",
                  "description_kind": "plain",
                  "computed": true
                },
                "billing": {
                  "type": "string",
                  "description": "Billing contact handle when provided.",
                  "description_kind": "plain",
                  "computed": true
                },
                "registrant": {
                  "type": "string",
                  "description": "Always present registrant handle.",
                  "description_kind": "plain",
                  "computed": true
                },
                "tech": {
                  "type": "string",
                  "description": "Technical contact handle when provided.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "Indicate domain name which you want to manage",
            "description_kind": "plain",
            "required": true
          },
          "epp_statuses": {
            "type": [
              "list",
              "string"
            ],
            "description": "Possible values clientDeleteProhibited clientHold clientRenewProhibited clientTransferProhibited clientUpdateProhibited",
            "description_kind": "plain",
            "computed": true
          },
          "expiration_date": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "is_premium": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "lifecycle_status": {
            "type": "string",
            "description": "Lifecycle phase. One of creating, registered, grace1, grace2, redemption.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Domain name in ASCII format (A-label)",
            "description_kind": "plain",
            "computed": true
          },
          "nameservers": {
            "nested_type": {
              "attributes": {
                "hosts": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "provider": {
                  "type": "string",
                  "description": "type: basic or custom",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Information about nameservers",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "privacy_protection": {
            "nested_type": {
              "attributes": {
                "contact_form": {
                  "type": "bool",
                  "description": "Indicates whether WHOIS should display the contact form link",
                  "description_kind": "plain",
                  "computed": true
                },
                "level": {
                  "type": "string",
                  "description": "Privacy level: public or high",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "computed": true
          },
          "registration_date": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "suspensions": {
            "nested_type": {
              "attributes": {
                "reason_code": {
                  "type": "string",
                  "description": "Suspension reason code (raaVerification, abuse, promoAbuse, fraud, pendingAccountVerification, unauthorizedAccess, tosViolation, transferDispute, restrictedSecurity, lockCourt, suspendCourt, udrpUrs, restrictedLegal, paymentPending, unpaidService, restrictedWhois, lockedWhois)",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Information about domain suspensions. May contain up to 2 items.",
            "description_kind": "plain",
            "computed": true
          },
          "unicode_name": {
            "type": "string",
            "description": "Domain name in UTF-8 format (U-label)",
            "description_kind": "plain",
            "computed": true
          },
          "verification_status": {
            "type": "string",
            "description": "Status of the RAA verification process. One of verification, success, failed. Null when not applicable.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages domain settings for Spaceship domain",
        "description_kind": "plain"
      }
    },
    "spaceship_personal_nameserver": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The domain the personal nameserver host belongs to (for example `example.com`). Changing this forces a new resource.",
            "description_kind": "markdown",
            "required": true
          },
          "host": {
            "type": "string",
            "description": "The host label of the nameserver, relative to `domain` (for example `ns1`, not `ns1.example.com`). The registry joins the label and the domain to form the full host name `ns1.example.com`; supplying a fully qualified name here would produce `ns1.example.com.example.com`. Changing this renames the host in place via the API.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Composite identifier with the form `domain/host`.",
            "description_kind": "markdown",
            "computed": true
          },
          "ips": {
            "type": [
              "set",
              "string"
            ],
            "description": "The glue record IP addresses (IPv4 or IPv6) served for this host. Must contain between 1 and 16 addresses.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a single personal nameserver host (a registry glue record) for a Spaceship-managed domain. A personal nameserver is a host label (e.g. `ns1`) relative to the domain, plus the set of IP addresses the registry serves for it. Pointing the domain at these hosts is configured separately via the domain's `nameservers` block.",
        "description_kind": "markdown"
      }
    }
  },
