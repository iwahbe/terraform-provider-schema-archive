{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "The hostname of a node you want to connect to",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The password of the user attempting to connect.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "The username of the user attempting to connect. (i.e. root@pve if using PAM authentication)",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Connect to proxmox",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "proxmox_cluster_ha_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "comment": {
            "type": "string",
            "description": "A helpful comment on the HA resource",
            "description_kind": "plain",
            "optional": true
          },
          "group": {
            "type": "string",
            "description": "The HA Group Identifier",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The resource ID (vm:101)",
            "description_kind": "plain",
            "required": true
          },
          "max_relocate": {
            "type": "number",
            "description": "The maximum number of times to relocate the resource (default: 1)",
            "description_kind": "plain",
            "optional": true
          },
          "max_restart": {
            "type": "number",
            "description": "The maximum number of times to restart the resource (default: 1)",
            "description_kind": "plain",
            "optional": true
          },
          "state": {
            "type": "string",
            "description": "The desired state of the resource (default: started)",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Cluster HA Resource",
        "description_kind": "plain"
      }
    },
    "proxmox_node_storage_content": {
      "version": 0,
      "block": {
        "attributes": {
          "filename": {
            "type": "string",
            "description": "The filename on the storage",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The volid of the content",
            "description_kind": "plain",
            "computed": true
          },
          "storage": {
            "type": "string",
            "description": "The storage identifier",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "iso": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "checksum": {
                  "type": "string",
                  "description": "A checksum of the downlaoded content",
                  "description_kind": "plain",
                  "optional": true
                },
                "checksum_algorithm": {
                  "type": "string",
                  "description": "The checksum algorithm of the downlaoded content",
                  "description_kind": "plain",
                  "optional": true
                },
                "url": {
                  "type": "string",
                  "description": "The url to download the iso from",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "An iso object",
              "description_kind": "plain"
            }
          }
        },
        "description": "Storage content aka a volume",
        "description_kind": "plain"
      }
    },
    "proxmox_node_virtual_machine": {
      "version": 0,
      "block": {
        "attributes": {
          "cpus": {
            "type": "number",
            "description": "The number of cpus/cores to allocate",
            "description_kind": "plain",
            "required": true
          },
          "fw_config": {
            "type": "string",
            "description": "Additional arguments to pass to qemu",
            "description_kind": "plain",
            "optional": true
          },
          "guest_agent": {
            "type": "bool",
            "description": "Enables the guest agent on the VM",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "The vmid of the VM",
            "description_kind": "plain",
            "required": true
          },
          "memory": {
            "type": "number",
            "description": "Memory allocation in MB",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the VM",
            "description_kind": "plain",
            "optional": true
          },
          "node": {
            "type": "string",
            "description": "The name of the node to schedule the VM onto",
            "description_kind": "plain",
            "required": true
          },
          "reboot": {
            "type": "bool",
            "description": "Reboot on config change",
            "description_kind": "plain",
            "optional": true
          },
          "serials": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list (max 3) of serial devices on the guest",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "ide": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "backup": {
                  "type": "bool",
                  "description": "If the disk should be backed up during backup",
                  "description_kind": "plain",
                  "optional": true
                },
                "content": {
                  "type": "string",
                  "description": "The content ID for this disk",
                  "description_kind": "plain",
                  "optional": true
                },
                "import_from": {
                  "type": "string",
                  "description": "A volid of an existing disk to copy from",
                  "description_kind": "plain",
                  "optional": true
                },
                "readonly": {
                  "type": "bool",
                  "description": "If set will put the disk in 'snapshot' mode making it readonly",
                  "description_kind": "plain",
                  "optional": true
                },
                "size_gb": {
                  "type": "number",
                  "description": "The size in GB if creating a disk",
                  "description_kind": "plain",
                  "optional": true
                },
                "storage": {
                  "type": "string",
                  "description": "The node storage ID to place the new disk",
                  "description_kind": "plain",
                  "optional": true
                },
                "volume_id": {
                  "type": "string",
                  "description": "The volume ID for this disk",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "description": "A ide disk object",
              "description_kind": "plain"
            }
          },
          "network": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "bridge": {
                  "type": "string",
                  "description": "The hosts network bridge to use",
                  "description_kind": "plain",
                  "required": true
                },
                "firewall": {
                  "type": "bool",
                  "description": "If set will utilize the proxmox firewall",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "A network interface",
              "description_kind": "plain"
            }
          },
          "scsi": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "backup": {
                  "type": "bool",
                  "description": "If the disk should be backed up during backup",
                  "description_kind": "plain",
                  "optional": true
                },
                "content": {
                  "type": "string",
                  "description": "The content ID for this disk",
                  "description_kind": "plain",
                  "optional": true
                },
                "import_from": {
                  "type": "string",
                  "description": "A volid of an existing disk to copy from",
                  "description_kind": "plain",
                  "optional": true
                },
                "readonly": {
                  "type": "bool",
                  "description": "If set will put the disk in 'snapshot' mode making it readonly",
                  "description_kind": "plain",
                  "optional": true
                },
                "size_gb": {
                  "type": "number",
                  "description": "The size in GB if creating a disk",
                  "description_kind": "plain",
                  "optional": true
                },
                "storage": {
                  "type": "string",
                  "description": "The node storage ID to place the new disk",
                  "description_kind": "plain",
                  "optional": true
                },
                "volume_id": {
                  "type": "string",
                  "description": "The volume ID for this disk",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "description": "A scsi disk object",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "proxmox_node": {
      "version": 0,
      "block": {
        "attributes": {
          "ip_address": {
            "type": "string",
            "description": "The first available connectable IP Address",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the node",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A proxmox node",
        "description_kind": "plain"
      }
    }
  }
}
