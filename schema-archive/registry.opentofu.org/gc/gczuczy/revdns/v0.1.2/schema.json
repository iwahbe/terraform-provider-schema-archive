{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "revdns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "IP address to generate the reverse record for",
            "description_kind": "plain",
            "required": true
          },
          "domain": {
            "type": "string",
            "description": "The domain name to be used to generate the FQDN with",
            "description_kind": "plain",
            "required": true
          },
          "fqdn": {
            "type": "string",
            "description": "The Fully Qualified hostname",
            "description_kind": "plain",
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description": "Short hostname associated with the IP",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "record_fqdn": {
            "type": "string",
            "description": "Fully qualified reverse record name",
            "description_kind": "plain",
            "computed": true
          },
          "record_short": {
            "type": "string",
            "description": "Non-qualified reverse record name",
            "description_kind": "plain",
            "computed": true
          },
          "zoneid": {
            "type": "string",
            "description": "The revdns_zone's ID where this record belongs to",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "revdns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "cidr": {
            "type": "string",
            "description": "The CIDR that the reverse zone is for",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "netmask": {
            "type": "number",
            "description": "The netmask of the zone",
            "description_kind": "plain",
            "computed": true
          },
          "parts": {
            "type": "number",
            "description": "Number of octets(v4)/quadlets(v6) in the reverse zone",
            "description_kind": "plain",
            "computed": true
          },
          "zone_name": {
            "type": "string",
            "description": "The generated reverse zone's name for the CIDR",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
