{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_url": {
          "type": "string",
          "description": "URL of the RPC API endpoint. Use `https://api.domrobot.com/jsonrpc/` for production and `https://api.ote.domrobot.com/jsonrpc/` for tests",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Login password of the api",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Login username of the api",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "inwx_dnssec_key": {
      "version": 0,
      "block": {
        "attributes": {
          "algorithm": {
            "type": "number",
            "description": "Algorithm used for the public key",
            "description_kind": "plain",
            "required": true
          },
          "digest": {
            "type": "string",
            "description": "Computed digest for the public key",
            "description_kind": "plain",
            "computed": true
          },
          "digest_type": {
            "type": "number",
            "description": "Digest type",
            "description_kind": "plain",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "Name of the domain",
            "description_kind": "plain",
            "required": true
          },
          "flag": {
            "type": "number",
            "description": "Key flag (256=ZSK, 257=KSK)",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "key_tag": {
            "type": "number",
            "description": "Key tag",
            "description_kind": "plain",
            "computed": true
          },
          "public_key": {
            "type": "string",
            "description": "Public key of the domain",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "DNSSEC status",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "inwx_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "extra_data": {
            "type": [
              "map",
              "string"
            ],
            "description": "Extra data, needed for some jurisdictions",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the domain",
            "description_kind": "plain",
            "required": true
          },
          "nameservers": {
            "type": [
              "set",
              "string"
            ],
            "description": "Set of nameservers of the domain",
            "description_kind": "plain",
            "optional": true
          },
          "period": {
            "type": "string",
            "description": "Registration period of the domain",
            "description_kind": "plain",
            "required": true
          },
          "renewal_mode": {
            "type": "string",
            "description": "Renewal mode of the domain. One of: AUTORENEW, AUTODELETE, AUTOEXPIRE",
            "description_kind": "plain",
            "optional": true
          },
          "transfer_lock": {
            "type": "bool",
            "description": "Whether the domain transfer lock should be enabled",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "contacts": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "admin": {
                  "type": "number",
                  "description": "Id of the admin contact",
                  "description_kind": "plain",
                  "required": true
                },
                "billing": {
                  "type": "number",
                  "description": "Id of the billing contact",
                  "description_kind": "plain",
                  "required": true
                },
                "registrant": {
                  "type": "number",
                  "description": "Id of the registrant contact",
                  "description_kind": "plain",
                  "required": true
                },
                "tech": {
                  "type": "number",
                  "description": "Id of the tech contact",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Contacts of the domain",
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "inwx_domain_contact": {
      "version": 0,
      "block": {
        "attributes": {
          "city": {
            "type": "string",
            "description": "City of the contact",
            "description_kind": "plain",
            "required": true
          },
          "country_code": {
            "type": "string",
            "description": "Country code of the contact. Must be two characters",
            "description_kind": "plain",
            "required": true
          },
          "email": {
            "type": "string",
            "description": "Contact email address",
            "description_kind": "plain",
            "required": true
          },
          "fax": {
            "type": "string",
            "description": "Fax number of the contact",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "First and lastname of the contact",
            "description_kind": "plain",
            "required": true
          },
          "organization": {
            "type": "string",
            "description": "The legal name of the organization. Required for types other than person",
            "description_kind": "plain",
            "optional": true
          },
          "phone_number": {
            "type": "string",
            "description": "Phone number of the contact",
            "description_kind": "plain",
            "required": true
          },
          "postal_code": {
            "type": "string",
            "description": "Postal Code/Zipcode of the contact",
            "description_kind": "plain",
            "required": true
          },
          "remarks": {
            "type": "string",
            "description": "Custom description of the contact",
            "description_kind": "plain",
            "optional": true
          },
          "state_province": {
            "type": "string",
            "description": "State/Province name of the contact",
            "description_kind": "plain",
            "optional": true
          },
          "street_address": {
            "type": "string",
            "description": "Street Address of the contact",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of contact. One of: ORG, PERSON, ROLE",
            "description_kind": "plain",
            "required": true
          },
          "whois_protection": {
            "type": "bool",
            "description": "Whether whois protection for the contact should be enabled. Depends on the registry supporting it. Not the same as whois protection for a domain",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
