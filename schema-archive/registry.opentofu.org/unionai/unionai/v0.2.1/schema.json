              "map",
              "string"
            ],
            "description": "Cluster resource template variables to substitute, as case-sensitive key/value pairs (e.g. `{ defaultUserRoleValue = \"arn:aws:iam::123456789012:role/my-role\" }`).",
            "description_kind": "markdown",
            "required": true
          },
          "domain": {
            "type": "string",
            "description": "Domain the attributes apply to (e.g. `development`, `staging`, `production`).",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Resource identifier, in the form `{project}/{domain}`.",
            "description_kind": "markdown",
            "computed": true
          },
          "project": {
            "type": "string",
            "description": "Project identifier the attributes apply to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Cluster resource attributes (matchable attributes of type `CLUSTER_RESOURCE`) for a project-domain pair. The attribute map is substituted into the cluster resource templates Flyte renders for the project-domain namespace (e.g. `defaultUserRoleValue` to bind a per-project IAM role to the namespace's default ServiceAccount).",
