{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "Garage Admin API endpoint URL (e.g., http://localhost:3903). Can also be set with the GARAGE_ENDPOINT environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "max_retries": {
          "type": "number",
          "description": "Maximum number of retries on transient failures. Defaults to 3.",
          "description_kind": "plain",
          "optional": true
        },
        "retry_max_wait": {
          "type": "number",
          "description": "Maximum wait between retries in seconds. Defaults to 30.",
          "description_kind": "plain",
          "optional": true
        },
        "retry_min_wait": {
          "type": "number",
          "description": "Minimum wait between retries in seconds. Defaults to 1.",
          "description_kind": "plain",
          "optional": true
        },
        "timeout": {
          "type": "number",
          "description": "HTTP request timeout in seconds. Defaults to 30.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Garage Admin API bearer token. Can also be set with the GARAGE_TOKEN environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Manage Garage S3-compatible object storage via the Admin API (v2).",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "garage_admin_token": {
      "version": 0,
      "block": {
        "attributes": {
          "created": {
            "type": "string",
            "description": "Token creation timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "expiration": {
            "type": "string",
            "description": "Expiration date (RFC 3339). Mutually exclusive with never_expires.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "expired": {
            "type": "bool",
            "description": "Whether the token has expired.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Admin token identifier.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the admin token.",
            "description_kind": "plain",
            "required": true
          },
          "never_expires": {
            "type": "bool",
            "description": "Set to true to make the token never expire.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "scope": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of allowed admin API endpoint names, or [\"*\"] for all.",
            "description_kind": "plain",
            "required": true
          },
          "secret_token": {
            "type": "string",
            "description": "The secret bearer token. Only available at creation time.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manages a Garage admin API token.",
        "description_kind": "plain"
      }
    },
    "garage_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "bytes": {
            "type": "number",
            "description": "Total size of objects in the bucket (bytes).",
            "description_kind": "plain",
            "computed": true
          },
          "created": {
            "type": "string",
            "description": "Bucket creation timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "error_document": {
            "type": "string",
            "description": "Error document for website access.",
            "description_kind": "plain",
            "optional": true
          },
          "global_alias": {
            "type": "string",
            "description": "Global alias for the bucket. Must be a valid S3 bucket name.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Bucket identifier.",
            "description_kind": "plain",
            "computed": true
          },
          "index_document": {
            "type": "string",
            "description": "Index document for website access.",
            "description_kind": "plain",
            "optional": true
          },
          "max_objects": {
            "type": "number",
            "description": "Maximum number of objects in the bucket. Null means unlimited.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "max_size": {
            "type": "number",
            "description": "Maximum total size of objects in the bucket (bytes). Null means unlimited.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "objects": {
            "type": "number",
            "description": "Number of objects in the bucket.",
            "description_kind": "plain",
            "computed": true
          },
          "unfinished_multipart_upload_bytes": {
            "type": "number",
            "description": "Total bytes in unfinished multipart uploads.",
            "description_kind": "plain",
            "computed": true
          },
          "unfinished_multipart_upload_parts": {
            "type": "number",
            "description": "Number of parts in unfinished multipart uploads.",
            "description_kind": "plain",
            "computed": true
          },
          "unfinished_multipart_uploads": {
            "type": "number",
            "description": "Number of unfinished multipart uploads.",
            "description_kind": "plain",
            "computed": true
          },
          "unfinished_uploads": {
            "type": "number",
            "description": "Number of unfinished uploads.",
            "description_kind": "plain",
            "computed": true
          },
          "website_access": {
            "type": "bool",
            "description": "Whether website access is enabled.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a Garage S3 bucket.",
        "description_kind": "plain"
      }
    },
    "garage_bucket_alias": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key_id": {
            "type": "string",
            "description": "Access key ID for local aliases. Required when alias_type is 'local'.",
            "description_kind": "plain",
            "optional": true
          },
          "alias_type": {
            "type": "string",
            "description": "Type of alias: 'global' or 'local'.",
            "description_kind": "plain",
            "required": true
          },
          "bucket_id": {
            "type": "string",
            "description": "ID of the bucket.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Composite identifier.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Alias name.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Garage bucket alias (global or local).",
        "description_kind": "plain"
      }
    },
    "garage_bucket_permission": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key_id": {
            "type": "string",
            "description": "Access key ID.",
            "description_kind": "plain",
            "required": true
          },
          "bucket_id": {
            "type": "string",
            "description": "ID of the bucket.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Composite identifier (bucket_id/access_key_id).",
            "description_kind": "plain",
            "computed": true
          },
          "owner": {
            "type": "bool",
            "description": "Allow owner access.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "read": {
            "type": "bool",
            "description": "Allow read access.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "write": {
            "type": "bool",
            "description": "Allow write access.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages permissions for an access key on a Garage bucket.",
        "description_kind": "plain"
      }
    },
    "garage_key": {
      "version": 0,
      "block": {
        "attributes": {
          "create_bucket": {
            "type": "bool",
            "description": "Whether this key is allowed to create buckets.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "created": {
            "type": "string",
            "description": "Key creation timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "expiration": {
            "type": "string",
            "description": "Expiration date (RFC 3339). Mutually exclusive with never_expires.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "expired": {
            "type": "bool",
            "description": "Whether the key has expired.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Access key ID. If set together with secret_access_key, imports a predefined key.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Friendly name for the key.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "never_expires": {
            "type": "bool",
            "description": "Set to true to make the key never expire.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "secret_access_key": {
            "type": "string",
            "description": "Secret access key. Only available at creation or import with showSecretKey.",
            "description_kind": "plain",
            "optional": true,
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manages a Garage access key.",
        "description_kind": "plain"
      }
    },
    "garage_layout_node": {
      "version": 0,
      "block": {
        "attributes": {
          "capacity": {
            "type": "number",
            "description": "Storage capacity in bytes. Null for gateway nodes.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Node identifier (same as node_id).",
            "description_kind": "plain",
            "computed": true
          },
          "layout_version": {
            "type": "number",
            "description": "Layout version after the last apply.",
            "description_kind": "plain",
            "computed": true
          },
          "node_id": {
            "type": "string",
            "description": "64-character hex node identifier.",
            "description_kind": "plain",
            "required": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "Tags for the node.",
            "description_kind": "plain",
            "optional": true
          },
          "zone": {
            "type": "string",
            "description": "Zone name for the node.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a node's role in the Garage cluster layout. Changes are staged and applied (two-phase commit).",
        "description_kind": "plain"
      }
    }
  },
