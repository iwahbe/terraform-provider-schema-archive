{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "dns_api_enabled": {
          "type": "bool",
          "description": "Optional dns api enabler flag. DNS API is enabled by default.",
          "description_kind": "markdown",
          "optional": true
        },
        "dns_api_token": {
          "type": "string",
          "description": "Optional DNS Api Authentication token. When missing provider will populate it from `HETZNER_DNS_API_TOKEN` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "This providers helps you to manage of Hetzner resources",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "hetzner_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Record Identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Record name",
            "description_kind": "markdown",
            "required": true
          },
          "ttl": {
            "type": "number",
            "description": "Record TTL",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Record Type. Supported values: [ A,AAAA,NS,MX,CNAME,RP,TXT,SOA,HINFO,SRV,DANE,TLSA,DS,CAA ]",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Record value",
            "description_kind": "markdown",
            "required": true
          },
          "zone_id": {
            "type": "string",
            "description": "Zone identifier that record belongs to",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Hetzner Record Resource.",
        "description_kind": "markdown"
      }
    },
    "hetzner_dns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Zone Identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Zone Name",
            "description_kind": "markdown",
            "required": true
          },
          "ns": {
            "type": [
              "list",
              "string"
            ],
            "description": "Primary Nameservers assigned to the Zone. Managed by Hetzner.",
            "description_kind": "markdown",
            "computed": true
          },
          "paused": {
            "type": "bool",
            "description": "Zone activeness",
            "description_kind": "markdown",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "\n\t\t\tStatus of the zone. Supported values are:\n\t\t\t*verified*: Zone is verified.\n\t\t\t*failed*: Zone verification is failed.\n\t\t\t*pending*: Verification is in progress\n\t\t\t",
            "description_kind": "markdown",
            "computed": true
          },
          "ttl": {
            "type": "number",
            "description": "Zone Default TTL for zone records",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Hetzner Zone Resource.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "hetzner_dns_records": {
      "version": 0,
      "block": {
        "attributes": {
          "records": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Record Identifier",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Record name",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "ttl": {
                  "type": "number",
                  "description": "Record TTL",
                  "description_kind": "markdown",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "Record Type. Supported values: [ A,AAAA,NS,MX,CNAME,RP,TXT,SOA,HINFO,SRV,DANE,TLSA,DS,CAA ]",
                  "description_kind": "markdown",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description": "Record value",
                  "description_kind": "markdown",
                  "computed": true
                },
                "zone_id": {
                  "type": "string",
                  "description": "Zone identifier that record belongs to",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of records created in the zone.",
            "description_kind": "markdown",
            "computed": true
          },
          "zone_id": {
            "type": "string",
            "description": "Hetzner Zone Identifier",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Hetzner Zone Records Data Source",
        "description_kind": "markdown"
      }
    },
    "hetzner_dns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Zone Identifier",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Zone Name",
            "description_kind": "markdown",
            "optional": true
          },
          "ns": {
            "type": [
              "list",
              "string"
            ],
            "description": "Primary Nameservers assigned to the Zone. Managed by Hetzner.",
            "description_kind": "markdown",
            "computed": true
          },
          "paused": {
            "type": "bool",
            "description": "Zone activeness",
            "description_kind": "markdown",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "\n\t\t\tStatus of the zone. Supported values are:\n\t\t\t*verified*: Zone is verified.\n\t\t\t*failed*: Zone verification is failed.\n\t\t\t*pending*: Verification is in progress\n\t\t\t",
            "description_kind": "markdown",
            "computed": true
          },
          "ttl": {
            "type": "number",
            "description": "Zone Default TTL for zone records",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Hetzner Zone Data Source.",
        "description_kind": "markdown"
      }
    },
    "hetzner_dns_zones": {
      "version": 0,
      "block": {
        "attributes": {
          "name": {
            "type": "string",
            "description": "Zone full or partial name to query zones",
            "description_kind": "markdown",
            "optional": true
          },
          "zones": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Zone Identifier",
                  "description_kind": "markdown",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Zone Name",
                  "description_kind": "markdown",
                  "optional": true
                },
                "ns": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Primary Nameservers assigned to the Zone. Managed by Hetzner.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "paused": {
                  "type": "bool",
                  "description": "Zone activeness",
                  "description_kind": "markdown",
                  "computed": true
                },
                "status": {
                  "type": "string",
                  "description": "\n\t\t\tStatus of the zone. Supported values are:\n\t\t\t*verified*: Zone is verified.\n\t\t\t*failed*: Zone verification is failed.\n\t\t\t*pending*: Verification is in progress\n\t\t\t",
                  "description_kind": "markdown",
                  "computed": true
                },
                "ttl": {
                  "type": "number",
                  "description": "Zone Default TTL for zone records",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of Zones matches the given `1name ",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Hetzner Zones Data Source.",
        "description_kind": "markdown"
      }
    }
  }
}
