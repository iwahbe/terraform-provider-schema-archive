{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "waypoint_auth_method": {
      "version": 0,
      "block": {
        "attributes": {
          "accessor_selector": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "allowed_redirect_uris": {
            "type": [
              "list",
              "string"
            ],
            "description": "Allowed URI for auth redirection.",
            "description_kind": "plain",
            "optional": true
          },
          "auds": {
            "type": [
              "list",
              "string"
            ],
            "description": "The optional audience claims required",
            "description_kind": "plain",
            "optional": true
          },
          "claim_mappings": {
            "type": [
              "map",
              "string"
            ],
            "description": "Mapping of a claim to a variable value for the access selector",
            "description_kind": "plain",
            "optional": true
          },
          "client_id": {
            "type": "string",
            "description": "Client ID of OIDC provider",
            "description_kind": "plain",
            "required": true
          },
          "client_secret": {
            "type": "string",
            "description": "Client Secret of OIDC provider",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "description": {
            "type": "string",
            "description": "Description of auth method",
            "description_kind": "plain",
            "optional": true
          },
          "discovery_ca_pem": {
            "type": [
              "list",
              "string"
            ],
            "description": "Optional CA certificate chain to validate the discovery URL. Multiple CA certificates can be specified to support easier rotation",
            "description_kind": "plain",
            "optional": true
          },
          "discovery_url": {
            "type": "string",
            "description": "Discovery URL for OIDC provider",
            "description_kind": "plain",
            "required": true
          },
          "display_name": {
            "type": "string",
            "description": "The display name of the Auth Method",
            "description_kind": "plain",
            "optional": true
          },
          "list_claim_mappings": {
            "type": [
              "map",
              "string"
            ],
            "description": "Same as claim_mappings but for list values",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the Auth Method",
            "description_kind": "plain",
            "required": true
          },
          "scopes": {
            "type": [
              "list",
              "string"
            ],
            "description": "The optional claims scope requested.",
            "description_kind": "plain",
            "optional": true
          },
          "signing_algs": {
            "type": [
              "list",
              "string"
            ],
            "description": "The signing algorithms supported by the OIDC connect server. If this isn't specified, this will default to RS256 since that should be supported according to the RFC. The string values here should be valid OIDC signing algorithms",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "waypoint_config_source": {
      "version": 0,
      "block": {
        "attributes": {
          "application": {
            "type": "string",
            "description": "Config Source Project",
            "description_kind": "plain",
            "optional": true
          },
          "config": {
            "type": [
              "map",
              "string"
            ],
            "description": "Configuration for the dynamic source type",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "Unique Hash ID",
            "description_kind": "plain",
            "computed": true
          },
          "project": {
            "type": "string",
            "description": "Config Source Project",
            "description_kind": "plain",
            "optional": true
          },
          "scope": {
            "type": "string",
            "description": "Config Source Scope",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Config Source type",
            "description_kind": "plain",
            "required": true
          },
          "workspace": {
            "type": "string",
            "description": "Config Source Workspace",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "waypoint_project": {
      "version": 0,
      "block": {
        "attributes": {
          "app_status_poll_seconds": {
            "type": "number",
            "description": "Application status poll interval in seconds",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "data_source_git": {
            "nested_type": {
              "attributes": {
                "file_change_signal": {
                  "type": "string",
                  "description": "Indicates signal to be sent to any applications when their config files change.",
                  "description_kind": "plain",
                  "optional": true
                },
                "git_path": {
                  "type": "string",
                  "description": "Path in git repository when waypoint.hcl file is stored in a sub-directory",
                  "description_kind": "plain",
                  "optional": true
                },
                "git_poll_interval_seconds": {
                  "type": "number",
                  "description": "Interval at which Waypoint should poll git repository for changes",
                  "description_kind": "plain",
                  "optional": true
                },
                "git_ref": {
                  "type": "string",
                  "description": "Git repository ref containing waypoint.hcl file",
                  "description_kind": "plain",
                  "optional": true
                },
                "git_url": {
                  "type": "string",
                  "description": "Url of git repository storing the waypoint.hcl file",
                  "description_kind": "plain",
                  "optional": true
                },
                "ignore_changes_outside_path": {
                  "type": "bool",
                  "description": "Whether Waypoint ignores changes outside path storing waypoint.hcl file",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Configuration of Git repository where waypoint.hcl file is stored",
            "description_kind": "plain",
            "required": true
          },
          "git_auth_basic": {
            "nested_type": {
              "attributes": {
                "password": {
                  "type": "string",
                  "description": "Git password",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "username": {
                  "type": "string",
                  "description": "Git username",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Basic authentication details for Git consisting of `username` and `password`",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "git_auth_ssh": {
            "nested_type": {
              "attributes": {
                "git_user": {
                  "type": "string",
                  "description": "Git user associated with private key",
                  "description_kind": "plain",
                  "optional": true
                },
                "passphrase": {
                  "type": "string",
                  "description": "Passphrase to use with private key",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "ssh_private_key": {
                  "type": "string",
                  "description": "Private key to authenticate to Git",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "SSH authentication details for Git",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description": "The id required for acceptance testing to work",
            "description_kind": "plain",
            "computed": true
          },
          "project_name": {
            "type": "string",
            "description": "The name of the Waypoint project",
            "description_kind": "plain",
            "required": true
          },
          "project_variables": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "sensitive": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of variables in Key/value pairs associated with the Waypoint Project",
            "description_kind": "plain",
            "optional": true
          },
          "remote_runners_enabled": {
            "type": "bool",
            "description": "Enable remote runners for project",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "waypoint_runner_profile": {
      "version": 0,
      "block": {
        "attributes": {
          "default": {
            "type": "bool",
            "description": "Indicates if this runner profile is the default for any new projects. The default is false",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "environment_variables": {
            "type": [
              "map",
              "string"
            ],
            "description": "Any environment variables that should be exposed to the on demand runner.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Waypoint generated ID for the runner config",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the runner profile",
            "description_kind": "plain",
            "required": true
          },
          "oci_url": {
            "type": "string",
            "description": "oci_url is the OCI image that will be used to boot the on demand runner.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "plugin_config": {
            "type": "string",
            "description": "Plugin config is the configuration for the plugin that is created. It is usually HCL and is decoded like the other plugins, and is plugin specific.",
            "description_kind": "plain",
            "optional": true
          },
          "plugin_config_format": {
            "type": "string",
            "description": "Config format specifies the format of plugin_config. Valid values are HCL or JSON. The default is HCL",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "plugin_type": {
            "type": "string",
            "description": "Plugin type for runner i.e docker / kubernetes / aws-ecs.",
            "description_kind": "plain",
            "required": true
          },
          "target_runner_id": {
            "type": "string",
            "description": "The ID of the target runner for this profile.",
            "description_kind": "plain",
            "optional": true
          },
          "target_runner_labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "A map of labels on target runners",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
