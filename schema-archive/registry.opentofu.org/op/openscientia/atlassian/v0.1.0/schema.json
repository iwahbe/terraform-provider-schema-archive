{
  "provider": {
    "version": 1,
    "block": {
      "attributes": {
        "apitoken": {
          "type": "string",
          "description": "Atlassian API Token. Can also be set with the `ATLASSIAN_TOKEN` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "computed": true,
          "sensitive": true
        },
        "url": {
          "type": "string",
          "description": "Atlassian Host URL. Can also be set with the `ATLASSIAN_URL` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "computed": true
        },
        "username": {
          "type": "string",
          "description": "Atlassian Username. Can also be set with the `ATLASSIAN_USERNAME` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "computed": true
        }
      },
      "description": "Atlassian",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "atlassian_jira_issue_type": {
      "version": 1,
      "block": {
        "attributes": {
          "avatar_id": {
            "type": "number",
            "description": "The ID of the issue type's avatar.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description of the issue type.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "hierarchy_level": {
            "type": "number",
            "description": "The hierarchy level of the issue type. Can be either `0` or `-1`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the issue type.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the issue type. The maximum length is 60 characters.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "The type of the issue type. Can be either `standard` or `sub-task`.",
            "description_kind": "markdown",
            "deprecated": true,
            "optional": true,
            "computed": true
          }
        },
        "description": "Jira Issue Type Resource",
        "description_kind": "markdown"
      }
    },
    "atlassian_jira_issue_type_scheme": {
      "version": 1,
      "block": {
        "attributes": {
          "default_issue_type_id": {
            "type": "string",
            "description": "The ID of the default issue type of the issue type scheme. This ID must be included in issue_type_ids.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description of the issue type scheme. The maximum length is 4000 characters.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the issue type scheme.",
            "description_kind": "markdown",
            "computed": true
          },
          "issue_type_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of issue types IDs of the issue type scheme. At least one standard issue type ID is required.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the issue type scheme. The name must be unique. The maximum length is 255 characters.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Jira Issue Type Scheme Resource",
        "description_kind": "markdown"
      }
    }
  },
