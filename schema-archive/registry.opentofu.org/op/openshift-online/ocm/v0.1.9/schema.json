{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "client_id": {
          "type": "string",
          "description": "OpenID client identifier.",
          "description_kind": "plain",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "OpenID client secret.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "insecure": {
          "type": "bool",
          "description": "When set to 'true' enables insecure communication with the server. This disables verification of TLS certificates and host names and it isn't recommended for production environments.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "User password.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "token": {
          "type": "string",
          "description": "Access or refresh token.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "token_url": {
          "type": "string",
          "description": "OpenID token URL.",
          "description_kind": "plain",
          "optional": true
        },
        "trusted_cas": {
          "type": "string",
          "description": "PEM encoded certificates of authorities that will be trusted. If this isn't explicitly specified then the provider will trust the certificate authorities trusted by default by the system.",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "URL of the API server.",
          "description_kind": "plain",
          "optional": true
        },
        "user": {
          "type": "string",
          "description": "User name.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ocm_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "api_url": {
            "type": "string",
            "description": "URL of the API server.",
            "description_kind": "plain",
            "computed": true
          },
          "availability_zones": {
            "type": [
              "list",
              "string"
            ],
            "description": "availability zones",
            "description_kind": "plain",
            "optional": true
          },
          "aws_access_key_id": {
            "type": "string",
            "description": "Identifier of the AWS access key.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "aws_account_id": {
            "type": "string",
            "description": "Identifier of the AWS account.",
            "description_kind": "plain",
            "optional": true
          },
          "aws_private_link": {
            "type": "bool",
            "description": "aws subnet ids",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "aws_secret_access_key": {
            "type": "string",
            "description": "AWS access key.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "aws_subnet_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "aws subnet ids",
            "description_kind": "plain",
            "optional": true
          },
          "ccs_enabled": {
            "type": "bool",
            "description": "Enables customer cloud subscription.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "cloud_provider": {
            "type": "string",
            "description": "Cloud provider identifier, for example 'aws'.",
            "description_kind": "plain",
            "required": true
          },
          "cloud_region": {
            "type": "string",
            "description": "Cloud region identifier, for example 'us-east-1'.",
            "description_kind": "plain",
            "required": true
          },
          "compute_machine_type": {
            "type": "string",
            "description": "Identifier of the machine type used by the compute nodes, for example `r5.xlarge`. Use the `ocm_machine_types` data source to find the possible values.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "compute_nodes": {
            "type": "number",
            "description": "Number of compute nodes of the cluster.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "console_url": {
            "type": "string",
            "description": "URL of the console.",
            "description_kind": "plain",
            "computed": true
          },
          "host_prefix": {
            "type": "number",
            "description": "Length of the prefix of the subnet assigned to each node.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier of the cluster.",
            "description_kind": "plain",
            "computed": true
          },
          "machine_cidr": {
            "type": "string",
            "description": "Block of IP addresses for nodes.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "multi_az": {
            "type": "bool",
            "description": "Indicates if the cluster should be deployed to multiple availability zones. Default value is 'false'.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the cluster.",
            "description_kind": "plain",
            "required": true
          },
          "pod_cidr": {
            "type": "string",
            "description": "Block of IP addresses for pods.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "product": {
            "type": "string",
            "description": "Product ID OSD or Rosa",
            "description_kind": "plain",
            "required": true
          },
          "properties": {
            "type": [
              "map",
              "string"
            ],
            "description": "User defined properties.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "proxy": {
            "nested_type": {
              "attributes": {
                "http_proxy": {
                  "type": "string",
                  "description": "http proxy",
                  "description_kind": "plain",
                  "required": true
                },
                "https_proxy": {
                  "type": "string",
                  "description": "https proxy",
                  "description_kind": "plain",
                  "required": true
                },
                "no_proxy": {
                  "type": "string",
                  "description": "no proxy",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "proxy",
            "description_kind": "plain",
            "optional": true
          },
          "service_cidr": {
            "type": "string",
            "description": "Block of IP addresses for services.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "state": {
            "type": "string",
            "description": "State of the cluster.",
            "description_kind": "plain",
            "computed": true
          },
          "version": {
            "type": "string",
            "description": "Identifier of the version of OpenShift, for example 'openshift-v4.1.0'.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "wait": {
            "type": "bool",
            "description": "Wait till the cluster is ready.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "OpenShift managed cluster.",
        "description_kind": "plain"
      }
    },
