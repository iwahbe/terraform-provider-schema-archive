{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "region": {
          "type": "string",
          "description": "The RDS data service AWS region",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "awsrdsdata_mysql_grant": {
      "version": 0,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description": "The MySQL database to grant privileges for",
            "description_kind": "markdown",
            "required": true
          },
          "database_resource_arn": {
            "type": "string",
            "description": "The RDS database resource ARN to run SQL queries against",
            "description_kind": "markdown",
            "required": true
          },
          "database_secret_arn": {
            "type": "string",
            "description": "The RDS database secret ARN to use for authentication",
            "description_kind": "markdown",
            "required": true
          },
          "host": {
            "type": "string",
            "description": "The host field associated with the MySQL user",
            "description_kind": "markdown",
            "required": true
          },
          "privileges": {
            "type": [
              "list",
              "string"
            ],
            "description": "The MySQL user privileges to grant",
            "description_kind": "markdown",
            "required": true
          },
          "user": {
            "type": "string",
            "description": "The MySQL user name to grant privileges",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "AWS RDS Data MySQL user privileges",
        "description_kind": "markdown"
      }
    },
    "awsrdsdata_mysql_user": {
      "version": 0,
      "block": {
        "attributes": {
          "database_resource_arn": {
            "type": "string",
            "description": "The RDS database resource ARN to run SQL queries against",
            "description_kind": "markdown",
            "required": true
          },
          "database_secret_arn": {
            "type": "string",
            "description": "The RDS database secret ARN to use for authentication",
            "description_kind": "markdown",
            "required": true
          },
          "host": {
            "type": "string",
            "description": "The MySQL user host value",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "The MySQL password to set for the user (must be at least 16 characters long)",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "user": {
            "type": "string",
            "description": "The MySQL user name to create",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "AWS RDS Data MySQL user resource",
        "description_kind": "markdown"
      }
    }
  }
}
