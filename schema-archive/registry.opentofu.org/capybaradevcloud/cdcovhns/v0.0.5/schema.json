{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "application_key": {
          "type": "string",
          "description": "The OVH API Application Key. Can also be configured using the `OVH_APPLICATION_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "application_secret": {
          "type": "string",
          "description": "The OVH API Application Secret. Can also be configured using the `OVH_SECRET_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "consumer_key": {
          "type": "string",
          "description": "The OVH API Consumer key. Can also be configured using the `OVH_CONSUMER_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "The OVH API endpoint to target (eg: \"ovh-eu\"). Can also be configured using the `OVH_ENDPOINT` environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "cdcovhns_name_servers": {
      "version": 0,
      "block": {
        "attributes": {
          "name_servers": {
            "nested_type": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "DNS Hostname",
                  "description_kind": "plain",
                  "required": true
                },
                "id": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "ip": {
                  "type": "string",
                  "description": "DNS IP address",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "is_used": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                },
                "to_delete": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "map"
            },
            "description_kind": "plain",
            "required": true
          },
          "service_name": {
            "type": "string",
            "description": "Domain name",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "OVH Name Servers type - 'external' (if external name servers like Cloudflare) or 'hosted' if OVH Name Servers.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "OVH Name Server resource",
        "description_kind": "plain"
      }
    }
  }
