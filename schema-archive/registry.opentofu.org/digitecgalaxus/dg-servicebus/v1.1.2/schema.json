{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "azure_servicebus_hostname": {
          "type": "string",
          "description": "The hostname of the Azure Service Bus instance",
          "description_kind": "plain",
          "required": true
        },
        "client_id": {
          "type": "string",
          "description": "The Client ID of the service principal. This can also be sourced from the `DG_SERVICEBUS_CLIENTID` Environment Variable.",
          "description_kind": "plain",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "The Client Secret of the service principal. This can also be sourced from the `DG_SERVICEBUS_CLIENTSECRET` Environment Variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "tenant_id": {
          "type": "string",
          "description": "The Tenant ID of the service principal. This can also be sourced from the `DG_SERVICEBUS_TENANTID` Environment Variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "This provider allows you to manage Endpoints for NServiceBus on Azure Service Bus.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dgservicebus_endpoint": {
      "version": 1,
      "block": {
        "attributes": {
          "additional_queues": {
            "type": [
              "list",
              "string"
            ],
            "description": "Additional queues to create for the endpoint.",
            "description_kind": "plain",
            "optional": true
          },
          "endpoint_exists": {
            "type": "bool",
            "description": "Internal attribute used to track whether the endpoint exists.",
            "description_kind": "plain",
            "computed": true
          },
          "endpoint_name": {
            "type": "string",
            "description": "The name of the endpoint to create.",
            "description_kind": "plain",
            "required": true
          },
          "has_malformed_filters": {
            "type": "bool",
            "description": "Internal attribute used to track whether the endpoint has malformed filters.",
            "description_kind": "plain",
            "computed": true
          },
          "queue_exists": {
            "type": "bool",
            "description": "Internal attribute used to track whether the queue exists.",
            "description_kind": "plain",
            "computed": true
          },
          "queue_options": {
            "nested_type": {
              "attributes": {
                "enable_partitioning": {
                  "type": "bool",
                  "description_kind": "plain",
                  "required": true
                },
                "max_message_size_in_kilobytes": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "max_size_in_megabytes": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The options for the queue, which is created for the endpoint.",
            "description_kind": "plain",
            "required": true
          },
          "should_create_endpoint": {
            "type": "bool",
            "description": "Internal attribute used to track whether the endpoint should be created.",
            "description_kind": "plain",
            "computed": true
          },
          "should_create_queue": {
            "type": "bool",
            "description": "Internal attribute used to track whether the queue should be created.",
            "description_kind": "plain",
            "computed": true
          },
          "should_update_subscriptions": {
            "type": "bool",
            "description": "Internal attribute used to track whether the subscriptions should be updated.",
            "description_kind": "plain",
            "computed": true
          },
          "subscriptions": {
            "nested_type": {
              "attributes": {
                "filter": {
                  "type": "string",
                  "description": "The filter for the subscription.",
                  "description_kind": "plain",
                  "required": true
                },
                "filter_type": {
                  "type": "string",
                  "description": "The filter type for the subscription.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description_kind": "plain",
            "required": true
          },
          "topic_name": {
            "type": "string",
            "description": "The name of the topic to create the endpoint on.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "The Endpoint resource allows consumers to create and manage an NServiceBus Endpoint. When initially creating the Endpoint, a default deny-all rule ensures that no invalid messages are received, before the configured subscription rules have been applied.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "dgservicebus_endpoint": {
      "version": 0,
      "block": {
        "attributes": {
          "endpoint_name": {
            "type": "string",
            "description": "The name of the endpoint.",
            "description_kind": "plain",
            "required": true
          },
          "queue_options": {
            "nested_type": {
              "attributes": {
                "enable_partitioning": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                },
                "max_message_size_in_kilobytes": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "max_size_in_megabytes": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The configuration used when creating any queues for that endpoint",
            "description_kind": "plain",
            "computed": true
          },
          "subscriptions": {
            "nested_type": {
              "attributes": {
                "filter": {
                  "type": "string",
                  "description": "The filter for the subscription.",
                  "description_kind": "plain",
                  "computed": true
                },
                "filter_type": {
                  "type": "string",
                  "description": "The filter type for the subscription.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "computed": true
          },
          "topic_name": {
            "type": "string",
            "description": "The name of the topic, in which the endpoint is created",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "The Endpoint data source porvides information about an existing Endpoint.",
        "description_kind": "plain"
      }
    }
  }
}
