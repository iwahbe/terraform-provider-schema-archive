    "scylladbcloud_cluster": {
      "version": 3,
      "block": {
        "attributes": {
          "alternator_write_isolation": {
            "type": "string",
            "description": "The write isolation policy. Used only for the ALTERNATOR API interface.",
            "description_kind": "plain",
            "optional": true
          },
          "availability_zone_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "Availability zone IDs where cluster nodes are provisioned. Provide exactly 3 distinct AZ IDs (e.g. [\"use1-az1\", \"use1-az4\", \"use1-az5\"]). If omitted, zones are selected automatically. After refreshing state with terraform refresh, you can read back the IDs that were assigned.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "byoa_id": {
            "type": "number",
            "description": "The ID of your account (BYOA) in ScyllaDB Cloud (only for AWS).",
            "description_kind": "plain",
            "optional": true
          },
          "cidr_block": {
            "type": "string",
            "description": "The CIDR block for the cluster network.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "cloud": {
            "type": "string",
            "description": "The cloud provider. Accepted values: AWS, GCP.",
            "description_kind": "plain",
            "optional": true
          },
          "cluster_id": {
            "type": "number",
            "description": "The computed cluster ID.",
            "description_kind": "plain",
            "computed": true
          },
          "datacenter": {
            "type": "string",
            "description": "The computed cluster datacenter name.",
            "description_kind": "plain",
            "computed": true
          },
          "enable_dns": {
            "type": "bool",
            "description": "Whether to enable DNS for the cluster.",
            "description_kind": "plain",
            "optional": true
          },
          "enable_vpc_peering": {
            "type": "bool",
            "description": "Whether to enable VPC peering for the cluster.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "min_nodes": {
            "type": "number",
            "description": "Minimum number of nodes in the cluster. Defaults to 3. Applies to Standard clusters only. Must not be set when the scaling block is present. Increasing this value scales the cluster out; decreasing it scales the cluster in. Either operation takes effect immediately on `terraform apply` and does not force cluster re-creation.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the cluster.",
            "description_kind": "plain",
            "required": true
          },
          "node_count": {
            "type": "number",
            "description": "The last retrieved number of nodes.",
            "description_kind": "plain",
            "computed": true
          },
          "node_disk_size": {
            "type": "number",
            "description": "The disk size in gigabytes of the node.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "node_dns_names": {
            "type": [
              "set",
              "string"
            ],
            "description": "The cluster nodes DNS names.",
            "description_kind": "plain",
            "computed": true
          },
          "node_private_ips": {
            "type": [
              "set",
              "string"
            ],
            "description": "The cluster nodes private IP addresses.",
            "description_kind": "plain",
            "computed": true
          },
          "node_type": {
            "type": "string",
            "description": "The instance type for cluster nodes (e.g. i8g.large). Required for Standard clusters. Must not be set when the scaling block is present.",
            "description_kind": "plain",
            "optional": true
          },
          "region": {
            "type": "string",
            "description": "The cloud region to deploy the cluster in (e.g. us-east-1).",
            "description_kind": "plain",
            "required": true
          },
          "request_id": {
            "type": "number",
            "description": "The cluster creation request ID.",
            "description_kind": "plain",
            "computed": true
          },
          "scylla_version": {
            "type": "string",
            "description": "Scylla version. The latest version will be used by default.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "The cluster status.",
            "description_kind": "plain",
            "computed": true
          },
          "user_api_interface": {
            "type": "string",
            "description": "The type of user API interface. Valid values are CQL or ALTERNATOR.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "scaling": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "instance_families": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Instance families to use for autoscaling (e.g. [\"i8g\"]). X Cloud scales within one predefined instance family. Manually restricting the cluster to a narrow set of instance types can limit the effectiveness of the autoscaling engine. Either instance_families or instance_types should be used.",
                  "description_kind": "plain",
                  "optional": true
                },
                "instance_types": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Instance types to use for autoscaling (e.g. [\"i8g.large\", \"i8g.xlarge\"]). Consider using instance_families instead. Either instance_families or instance_types should be used.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "block_types": {
                "storage_policy": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "min_gb": {
                        "type": "number",
                        "description": "Minimum physical storage, in gigabytes, to keep provisioned across the cluster. The cluster will not scale below this threshold. If omitted, ScyllaDB Cloud manages baseline storage dynamically.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "target_utilization": {
                        "type": "number",
                        "description": "Target storage utilization as a fraction between 0 and 1 (e.g. 0.75 = 75%). The autoscaler adds or removes capacity to maintain this level. Defaults to 0.8. Maximum is 0.9. For write-intensive workloads, values below 0.85 are recommended to provide headroom before the autoscaler triggers.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "Controls storage-based autoscaling.",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                },
                "vcpu_policy": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "min": {
                        "type": "number",
                        "description": "Minimum vCPU count to maintain across the cluster. The cluster will not scale below this compute baseline. If omitted, ScyllaDB Cloud manages compute capacity dynamically.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "Controls compute-based autoscaling.",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description": "Defines the autoscaling policy for an X Cloud cluster. Mutually exclusive with `node_type` and `min_nodes`. When present, the control plane manages scaling automatically based on the policy defined below.",
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
