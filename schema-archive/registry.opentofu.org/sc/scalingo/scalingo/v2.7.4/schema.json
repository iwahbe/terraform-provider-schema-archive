{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "API Token to authenticate requests with. Can also be sourced from `SCALINGO_API_TOKEN`.",
          "description_kind": "plain",
          "optional": true
        },
        "api_url": {
          "type": "string",
          "description": "URL of the Scalingo Application API to use (Override region default). Can also be sourced from `SCALINGO_API_URL`.",
          "description_kind": "plain",
          "optional": true
        },
        "auth_api_url": {
          "type": "string",
          "description": "URL of the Scalingo Authentication API to use (Override region default). Can also be sourced from `SCALINGO_AUTH_URL`.",
          "description_kind": "plain",
          "optional": true
        },
        "db_api_url": {
          "type": "string",
          "description": "URL of the Scalingo Database API to use (Override region default). Can also be sourced from `SCALINGO_DB_API_URL`.",
          "description_kind": "plain",
          "optional": true
        },
        "region": {
          "type": "string",
          "description": "Region to use with the provider. Can also be sourced from `SCALINGO_REGION`. (default: `osc-fr1`)",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "scalingo_addon": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "ID of the application which will receive the addon",
            "description_kind": "plain",
            "required": true
          },
          "database_features": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of enabled features for the addon (Database addons only)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "plan": {
            "type": "string",
            "description": "Name of the plan of the addon to provision",
            "description_kind": "plain",
            "required": true
          },
          "plan_id": {
            "type": "string",
            "description": "ID of the plan which was provisioned",
            "description_kind": "plain",
            "computed": true
          },
          "provider_id": {
            "type": "string",
            "description": "ID of slug name of the addon provider",
            "description_kind": "plain",
            "required": true
          },
          "resource_id": {
            "type": "string",
            "description": "Human readable ID of the addon which is provisioned",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Resource representing an Addon attached to an Application based on an AddonProvider",
        "description_kind": "plain"
      }
    },
    "scalingo_alert": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "ID or Name of the targeted application",
            "description_kind": "plain",
            "required": true
          },
          "container_type": {
            "type": "string",
            "description": "Type of containers (web/worker/...) watched by the alert",
            "description_kind": "plain",
            "required": true
          },
          "disabled": {
            "type": "bool",
            "description": "Disable the alert without deleting it",
            "description_kind": "plain",
            "optional": true
          },
          "duration_before_trigger": {
            "type": "string",
            "description": "Delay before triggering the alert when the threshold is reached",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "limit": {
            "type": "number",
            "description": "Limit/Threshold value at which the alert is triggered",
            "description_kind": "plain",
            "required": true
          },
          "metric": {
            "type": "string",
            "description": "Metric (cpu/ram/swap/rpm/...) monitored by the alert",
            "description_kind": "plain",
            "required": true
          },
          "notifiers": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of notifier IDs to which alerts are sent",
            "description_kind": "plain",
            "optional": true
          },
          "remind_every": {
            "type": "string",
            "description": "Duration after which the alert will be re-triggered and sent to the notifiers",
            "description_kind": "plain",
            "optional": true
          },
          "send_when_below": {
            "type": "bool",
            "description": "Send alert when the current value is below the threshold instead of above",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Resource representing an alert definition for an application",
        "description_kind": "plain"
      }
    },
    "scalingo_app": {
      "version": 0,
      "block": {
        "attributes": {
          "all_environment": {
            "type": [
              "map",
              "string"
            ],
            "description": "Computed key-value map containing environment in read-only",
            "description_kind": "plain",
            "computed": true
          },
          "base_url": {
            "type": "string",
            "description": "Base URL (https://*), generated by Scalingo, to access the application",
            "description_kind": "plain",
            "computed": true
          },
          "environment": {
            "type": [
              "map",
              "string"
            ],
            "description": "Key-value map of environment variables attached to the application",
            "description_kind": "plain",
            "optional": true
          },
          "force_https": {
            "type": "bool",
            "description": "Redirect HTTP traffic to HTTPS + HSTS header if enabled",
            "description_kind": "plain",
            "optional": true
          },
          "git_url": {
            "type": "string",
            "description": "Hostname to use to deploy code with Git + SSH",
            "description_kind": "plain",
            "computed": true
          },
          "hds_resource": {
            "type": "bool",
            "description": "Whether the application should be an HDS resource",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the application",
            "description_kind": "plain",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "ID of the project to which the application belongs to",
            "description_kind": "plain",
            "optional": true
          },
          "router_logs": {
            "type": "bool",
            "description": "Enable Router Logs to log all the connections made to your application",
            "description_kind": "plain",
            "optional": true
          },
          "stack_id": {
            "type": "string",
            "description": "ID of the base stack to use (scalingo-18/scalingo-20/scalingo-22)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "sticky_session": {
            "type": "bool",
            "description": "Enable the Sticky Session feature, which associate all HTTP requests from an end-user to a single `web` application container.",
            "description_kind": "plain",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "URL (https://*) to access the application",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Resource representing an application",
        "description_kind": "plain"
      }
    },
    "scalingo_autoscaler": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "ID or Name of the targeted application",
            "description_kind": "plain",
            "required": true
          },
          "container_type": {
            "type": "string",
            "description": "Container type targeted by the autoscaler (web, worker, etc.)",
            "description_kind": "plain",
            "required": true
          },
          "disabled": {
            "type": "bool",
            "description": "Disable without deleting the autoscaler",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "max_containers": {
            "type": "number",
            "description": "Maximum number of containers (autoscaler won't get over it)",
            "description_kind": "plain",
            "required": true
          },
          "metric": {
            "type": "string",
            "description": "Watched metric to base the autoscaling on (cpu, ram, etc.)",
            "description_kind": "plain",
            "required": true
          },
          "min_containers": {
            "type": "number",
            "description": "Minimum number of containers (autoscaler won't get under it)",
            "description_kind": "plain",
            "required": true
          },
          "target": {
            "type": "number",
            "description": "Target reference value to base the autoscaling algorithm on",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Resource representing an autoscaler of an application, setting rules to automatically scale up and down containers of the app",
        "description_kind": "plain"
      }
    },
    "scalingo_collaborator": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "ID of the targeted application",
            "description_kind": "plain",
            "required": true
          },
          "email": {
            "type": "string",
            "description": "Email of the collaborator to invite",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "limited": {
            "type": "bool",
            "description": "Whether the collaborator is a limited collaborator for the application",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "Status of the collaboration (pending/accepted)",
            "description_kind": "plain",
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "Username of the attached account once the collaboration has been accepted",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Resource representing a collaboration between a user and an application",
        "description_kind": "plain"
      }
    },
    "scalingo_container_type": {
      "version": 0,
      "block": {
        "attributes": {
          "amount": {
            "type": "number",
            "description": "Number of containers to boot for this type",
            "description_kind": "plain",
            "required": true
          },
          "app": {
            "type": "string",
            "description": "ID of the targeted application",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the container type",
            "description_kind": "plain",
            "required": true
          },
          "size": {
            "type": "string",
            "description": "Size of the container (S/M/L/etc.)",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Resource representing a container type, allowing to scale an application containers",
        "description_kind": "plain"
      }
    },
    "scalingo_database": {
      "version": 0,
      "block": {
        "attributes": {
          "database_id": {
            "type": "string",
            "description": "ID of the Database NG on DBAPI side",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Database NG",
            "description_kind": "plain",
            "required": true
          },
          "plan": {
            "type": "string",
            "description": "Name of the plan of the Database NG to provision",
            "description_kind": "plain",
            "required": true
          },
          "plan_id": {
            "type": "string",
            "description": "ID of the plan of the Database NG to provision",
            "description_kind": "plain",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "ID of the project to which the Database NG belongs to",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "technology": {
            "type": "string",
            "description": "Technology of the Database NG",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Resource representing a Database NG on Scalingo",
        "description_kind": "plain"
      }
    },
    "scalingo_database_firewall_rule": {
      "version": 0,
      "block": {
        "attributes": {
          "cidr": {
            "type": "string",
            "description": "CIDR for a custom range firewall rule",
            "description_kind": "plain",
            "optional": true
          },
          "database_id": {
            "type": "string",
            "description": "ID of the Database NG",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Label for a custom range firewall rule",
            "description_kind": "plain",
            "optional": true
          },
          "managed_range_id": {
            "type": "string",
            "description": "ID of a managed range firewall rule",
            "description_kind": "plain",
            "optional": true
          },
          "rule_type": {
            "type": "string",
            "description": "Type of the firewall rule (custom_range or managed_range)",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Resource representing a database firewall rule",
        "description_kind": "plain"
      }
    },
    "scalingo_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "ID of the targeted application",
            "description_kind": "plain",
            "required": true
          },
          "canonical": {
            "type": "bool",
            "description": "If true, all requests will be redirected to this domain (one per application)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "common_name": {
            "type": "string",
            "description": "Common Name (hostname) of the DNS entry which will target the application",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "letsencrypt_enabled": {
            "type": "bool",
            "description": "If true (default), the domain will be secured with a Let's Encrypt certificate",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Resource representing a custom domain targeting an application",
        "description_kind": "plain"
      }
    },
    "scalingo_log_drain": {
      "version": 0,
      "block": {
        "attributes": {
          "addon": {
            "type": "string",
            "description": "UUID of the targeted addon attached to the application",
            "description_kind": "plain",
            "optional": true
          },
          "app": {
            "type": "string",
            "description": "ID of the targeted application",
            "description_kind": "plain",
            "required": true
          },
          "drain_region": {
            "type": "string",
            "description": "destination region (see compatible destination in documentation)",
            "description_kind": "plain",
            "optional": true
          },
          "drain_url": {
            "type": "string",
            "description": "URL representation of the log drain",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "host": {
            "type": "string",
            "description": "hostname to which logs are transferred",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "port": {
            "type": "string",
            "description": "port to which logs are transferred",
            "description_kind": "plain",
            "optional": true
          },
          "token": {
            "type": "string",
            "description": "token used to authenticate log drain requests (see compatible destination in documentation)",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "type": {
            "type": "string",
            "description": "type of log drain (syslog/http/elk/etc.)",
            "description_kind": "plain",
            "required": true
          },
          "url": {
            "type": "string",
            "description": "helper to generate all the host/port/token fields",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          }
        },
        "description": "Resource representing a log drain attached to an application or a database",
        "description_kind": "plain"
      }
    },
    "scalingo_notifier": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Ability to disable notifier without deleting it",
            "description_kind": "plain",
            "optional": true
          },
          "app": {
            "type": "string",
            "description": "ID of the targeted application",
            "description_kind": "plain",
            "required": true
          },
          "emails": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of emails which should receive notifications (for notifier platform 'email')",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name given to the notifier",
            "description_kind": "plain",
            "required": true
          },
          "platform_id": {
            "type": "string",
            "description": "ID of the Notifier Platform used to send notifications to",
            "description_kind": "plain",
            "required": true
          },
          "selected_events": {
            "type": [
              "set",
              "string"
            ],
            "description": "Allowlist of event types to filter which should trigger notifications",
            "description_kind": "plain",
            "optional": true
          },
          "send_all_alerts": {
            "type": "bool",
            "description": "Send notifications, all types alerts attached to the application if true",
            "description_kind": "plain",
            "optional": true
          },
          "send_all_events": {
            "type": "bool",
            "description": "Send notifications for all types of events of the application if true",
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Human readable notifier type (slack/webhook/email/rocket_chat/etc.)",
            "description_kind": "plain",
            "computed": true
          },
          "user_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of collaborators who should receive notifications (for notifier platform 'email')",
            "description_kind": "plain",
            "optional": true
          },
          "webhook_url": {
            "type": "string",
            "description": "Destination URL which should receive notifications (for notifier platforms 'slack', 'rocket_chat' and 'webhook')",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Resource representing a Notifier based on an NotificationPlatform",
        "description_kind": "plain"
      }
    },
    "scalingo_project": {
      "version": 0,
      "block": {
        "attributes": {
          "default": {
            "type": "bool",
            "description": "Whether or not the project is a default project",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the project",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the project",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Resource representing a project",
        "description_kind": "plain"
      }
    },
    "scalingo_scm_integration": {
      "version": 0,
      "block": {
        "attributes": {
          "access_token": {
            "type": "string",
            "description": "API Access Token to communicate with the API (GitHub Enterprise and Gitlab Self-Hosted only)",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "avatar_url": {
            "type": "string",
            "description": "Avatar URL in the SCM account",
            "description_kind": "plain",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "Email in the SCM account",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "profile_url": {
            "type": "string",
            "description": "Profile URL in the SCM account",
            "description_kind": "plain",
            "computed": true
          },
          "scm_type": {
            "type": "string",
            "description": "Type of integration (github-enterprise/gitlab-self-hosted), others should be created from dashboard",
            "description_kind": "plain",
            "required": true
          },
          "uid": {
            "type": "string",
            "description": "Unique ID of the SCM account",
