{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "The API token to authenticate with Turso API",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "turso_database": {
      "version": 0,
      "block": {
        "attributes": {
          "db_id": {
            "type": "string",
            "description": "The database universal unique identifier (UUID).",
            "description_kind": "markdown",
            "computed": true
          },
          "group": {
            "type": "string",
            "description": "The name of the group where the database should be created. The group must already exist.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description": "The DNS hostname used for client libSQL and HTTP connections.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the new database. Must contain only lowercase letters, numbers, dashes. No longer than 64 characters.",
            "description_kind": "markdown",
            "required": true
          },
          "organization_name": {
            "type": "string",
            "description": "Name of organization to create the database for",
            "description_kind": "markdown",
            "required": true
          },
          "size_limit": {
            "type": "string",
            "description": "The maximum size of the database in bytes. Values with units are also accepted, e.g. 1mb, 256mb, 1gb.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Database resource",
        "description_kind": "markdown"
      }
    },
    "turso_database_configuration": {
      "version": 0,
      "block": {
        "attributes": {
          "block_reads": {
            "type": "bool",
            "description": "Block all database reads.",
            "description_kind": "markdown",
            "optional": true
          },
          "block_writes": {
            "type": "bool",
            "description": "Block all database writes.",
            "description_kind": "markdown",
            "optional": true
          },
          "database_name": {
            "type": "string",
            "description": "The name of the database.",
            "description_kind": "markdown",
            "required": true
          },
          "delete_protection": {
            "type": "bool",
            "description": "Prevent the database from being deleted.",
            "description_kind": "markdown",
            "optional": true
          },
          "organization_slug": {
            "type": "string",
            "description": "The slug of the organization or user account.",
            "description_kind": "markdown",
            "required": true
          },
          "size_limit": {
            "type": "string",
            "description": "The maximum size of the database in bytes. Values with units are also accepted, e.g. 1mb, 256mb, 1gb.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages a database configuration belonging to the organization or user.",
        "description_kind": "markdown"
      }
    },
    "turso_database_token": {
      "version": 0,
      "block": {
        "attributes": {
          "authorization": {
            "type": "string",
            "description": "Authorization level for the token (full-access or read-only).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "database_name": {
            "type": "string",
            "description": "The name of the database.",
            "description_kind": "markdown",
            "required": true
          },
          "expiration": {
            "type": "string",
            "description": "Expiration time for the token (e.g., 2w1d30m).",
            "description_kind": "markdown",
            "optional": true
          },
          "jwt": {
            "type": "string",
            "description": "The generated authorization token (JWT).",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "organization_name": {
            "type": "string",
            "description": "The name of the organization or user.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Database Token resource",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "turso_database": {
      "version": 0,
      "block": {
        "attributes": {
          "db_id": {
            "type": "string",
            "description": "The database universal unique identifier (UUID).",
            "description_kind": "markdown",
            "computed": true
          },
          "group": {
            "type": "string",
            "description": "The name of the group where the database should be created. The group must already exist.",
            "description_kind": "markdown",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description": "The DNS hostname used for client libSQL and HTTP connections.",
            "description_kind": "markdown",
            "computed": true
          },
          "is_schema": {
            "type": "bool",
            "description": "Mark this database as the parent schema database that updates child databases with any schema changes.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the new database. Must contain only lowercase letters, numbers, dashes. No longer than 32 characters.",
            "description_kind": "markdown",
            "required": true
          },
          "organization_name": {
            "type": "string",
            "description": "Name of organization to create the database for",
            "description_kind": "markdown",
            "required": true
          },
          "schema": {
            "type": "string",
            "description": "The name of the parent database to use as the schema.",
            "description_kind": "markdown",
            "optional": true
          },
          "size_limit": {
            "type": "string",
            "description": "The maximum size of the database in bytes. Values with units are also accepted, e.g. 1mb, 256mb, 1gb.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Database data source",
        "description_kind": "markdown"
      }
    },
    "turso_database_configuration": {
      "version": 0,
      "block": {
        "attributes": {
          "block_reads": {
            "type": "bool",
            "description": "Block all database reads.",
            "description_kind": "markdown",
            "computed": true
          },
          "block_writes": {
            "type": "bool",
            "description": "Block all database writes.",
            "description_kind": "markdown",
            "computed": true
          },
          "database_name": {
            "type": "string",
            "description": "The name of the database.",
            "description_kind": "markdown",
            "required": true
          },
          "delete_protection": {
            "type": "bool",
            "description": "Prevent the database from being deleted.",
            "description_kind": "markdown",
            "computed": true
          },
          "organization_slug": {
            "type": "string",
            "description": "The slug of the organization or user account.",
            "description_kind": "markdown",
            "required": true
          },
          "size_limit": {
            "type": "string",
            "description": "The maximum size of the database in bytes. Values with units are also accepted, e.g. 1mb, 256mb, 1gb.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Database data source",
        "description_kind": "markdown"
      }
    },
    "turso_database_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "database_name": {
            "type": "string",
            "description": "The name of the database.",
            "description_kind": "markdown",
            "required": true
          },
          "hostname": {
            "type": "string",
            "description": "The DNS hostname used for client libSQL and HTTP connections (specific to this instance only).",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the instance.",
            "description_kind": "markdown",
            "required": true
          },
          "organization_slug": {
            "type": "string",
            "description": "The slug of the organization or user account.",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "The location code for the region this instance is located.",
            "description_kind": "markdown",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The type of database instance this, will be `primary` or `replica`.",
            "description_kind": "markdown",
            "computed": true
          },
          "uuid": {
            "type": "string",
            "description": "The instance universal unique identifier (UUID).",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieves data from an individual database instance by name.",
        "description_kind": "markdown"
      }
    },
    "turso_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "name": {
            "type": "string",
            "description": "The organization name. Every user has a `personal` organization for their own account.",
            "description_kind": "markdown",
            "computed": true
          },
          "slug": {
            "type": "string",
            "description": "The organization slug. This will be your username for `personal` accounts.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "The type of account this organization is. Will always be `personal` or `team`.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Organization data source",
        "description_kind": "markdown"
      }
    }
  }
}
