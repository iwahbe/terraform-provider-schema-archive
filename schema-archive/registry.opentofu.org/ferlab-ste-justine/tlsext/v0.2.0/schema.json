{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "tlsext_pgp_private_key": {
      "version": 0,
      "block": {
        "attributes": {
          "algorithm": {
            "type": "string",
            "description": "Algorithm of the encryption. The following values are currently supported: rsa.",
            "description_kind": "markdown",
            "optional": true
          },
          "email": {
            "type": "string",
            "description": "Email to associate with the gpg key.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name to associate with the gpg key.",
            "description_kind": "markdown",
            "required": true
          },
          "private_key": {
            "type": "string",
            "description": "Private key to convert in pem format.",
            "description_kind": "markdown",
            "required": true
          },
          "private_key_gpg_armor": {
            "type": "string",
            "description": "Private key in gpg armor format.",
            "description_kind": "markdown",
            "computed": true
          },
          "public_key_gpg_armor": {
            "type": "string",
            "description": "Public key in gpg armor format.",
            "description_kind": "markdown",
            "computed": true
          },
          "timestamp": {
            "type": "string",
            "description": "Timestamp needed by pgp.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Pgp private key, generated by converting an existing private key passed in pem format.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "tlsext_pem_chain": {
      "version": 0,
      "block": {
        "attributes": {
          "first_pem": {
            "type": "string",
            "description": "First pem element that was encountered in the chain.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_pem": {
            "type": "string",
            "description": "Last pem element that was encountered in the chain.",
            "description_kind": "markdown",
            "computed": true
          },
          "pem_chain": {
            "type": "string",
            "description": "Concatenated pem chain to parse.",
            "description_kind": "markdown",
            "required": true
          },
          "pem_list": {
            "type": [
              "list",
              "string"
            ],
            "description": "Ordered list of pem elements in the same order they were encountered in the chain.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Convenience to retrieve a list of elements from an input pem chain concaneted as a string. Aims to be more flexible and robust than using a regex.",
        "description_kind": "markdown"
      }
    }
  }
}
