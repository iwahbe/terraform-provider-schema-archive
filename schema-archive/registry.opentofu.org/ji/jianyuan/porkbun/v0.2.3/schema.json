{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API key for the Porkbun account. It can be sourced from the `PORKBUN_API_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "base_url": {
          "type": "string",
          "description": "The base URL for the Porkbun API. Defaults to `https://api.porkbun.com/api/json`. It can be sourced from the `PORKBUN_BASE_URL` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "secret_key": {
          "type": "string",
          "description": "The secret API key for the Porkbun account. It can be sourced from the `PORKBUN_SECRET_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Porkbun provider is used to interact with the Porkbun service.\n\nIf you find this provider useful, please consider supporting me through GitHub Sponsorship or Ko-Fi to help with its development.\n\n[![Github-sponsors](https://img.shields.io/badge/sponsor-30363D?style=for-the-badge&logo=GitHub-Sponsors&logoColor=#EA4AAA)](https://github.com/sponsors/jianyuan)\n[![Ko-Fi](https://img.shields.io/badge/Ko--fi-F16061?style=for-the-badge&logo=ko-fi&logoColor=white)](https://ko-fi.com/L3L71DQEL)",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "porkbun_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "The answer content for the record. Please see the DNS management popup from the domain management console for proper formatting of each record type.",
            "description_kind": "markdown",
            "required": true
          },
          "domain": {
            "type": "string",
            "description": "The domain for the record being created.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The record ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The full name of the record being created, including the subdomain and the domain itself.",
            "description_kind": "markdown",
            "computed": true
          },
          "notes": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "priority": {
            "type": "number",
            "description": "The priority of the record for those that support it.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "subdomain": {
            "type": "string",
            "description": "The subdomain for the record being created, not including the domain itself. Omit to create a record on the root domain. Use * to create a wildcard record.",
            "description_kind": "markdown",
            "optional": true
          },
          "ttl": {
            "type": "number",
            "description": "The time to live in seconds for the record. The minimum and the default is 600 seconds.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The type of record being created. Valid types are: A, MX, CNAME, ALIAS, TXT, NS, AAAA, SRV, TLSA, CAA, HTTPS, SVCB.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage a DNS record for a domain.",
        "description_kind": "markdown"
      }
    },
    "porkbun_domain_nameservers": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "nameservers": {
            "type": [
              "set",
              "string"
            ],
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Update the name servers for your domain.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "porkbun_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "The domain name.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The record ID.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "notes": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "priority": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "ttl": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "type": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieve a single record for a particular record ID.",
        "description_kind": "markdown"
      }
    },
    "porkbun_dns_records": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The domain name.",
            "description_kind": "markdown",
            "required": true
          },
          "filter": {
            "nested_type": {
              "attributes": {
                "subdomain": {
                  "type": "string",
                  "description": "Record subdomain.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "Record type. Valid types are: A, MX, CNAME, ALIAS, TXT, NS, AAAA, SRV, TLSA, CAA, HTTPS, SVCB.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Record filter.",
            "description_kind": "markdown",
            "optional": true
          },
          "records": {
            "nested_type": {
              "attributes": {
                "content": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "notes": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "priority": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "ttl": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "All editable DNS records.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieve all editable DNS records associated with a domain.",
        "description_kind": "markdown"
      }
    },
    "porkbun_domain_nameservers": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The domain name for which to retrieve the authoritative name servers.",
            "description_kind": "markdown",
            "required": true
          },
          "nameservers": {
            "type": [
              "set",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Get the authoritative name servers listed at the registry for your domain.",
        "description_kind": "markdown"
      }
    },
    "porkbun_domains": {
      "version": 0,
      "block": {
        "attributes": {
          "domains": {
            "nested_type": {
              "attributes": {
                "auto_renew": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                },
                "create_date": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "domain": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "expire_date": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "not_local": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                },
                "security_lock": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                },
                "status": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "tld": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "whois_privacy": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "Domain names in account.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Get all domain names in account.",
        "description_kind": "markdown"
      }
    }
  }
}
