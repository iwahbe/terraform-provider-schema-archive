{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The Admin API key for authentication. Get this from the [Anthropic console](https://console.anthropic.com/settings/admin-keys). It can be sourced from the `ANTHROPIC_API_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "base_url": {
          "type": "string",
          "description": "API endpoint for the Anthropic service. Defaults to `https://api.anthropic.com`. It can be sourced from the `ANTHROPIC_BASE_URL` environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "The Anthropic provider is used to interact with the Anthropic service.\n\nIf you find this provider useful, please consider supporting me through GitHub Sponsorship or Ko-Fi to help with its development.\n\n[![Github-sponsors](https://img.shields.io/badge/sponsor-30363D?style=for-the-badge&logo=GitHub-Sponsors&logoColor=#EA4AAA)](https://github.com/sponsors/jianyuan)\n[![Ko-Fi](https://img.shields.io/badge/Ko--fi-F16061?style=for-the-badge&logo=ko-fi&logoColor=white)](https://ko-fi.com/L3L71DQEL)",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "anthropic_organization_invite": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Timestamp when the invite was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "Email address of the person being invited.",
            "description_kind": "markdown",
            "required": true
          },
          "expires_at": {
            "type": "string",
            "description": "Timestamp when the invite expires.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for the invite.",
            "description_kind": "markdown",
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "Role to assign to the invited user. Must be one of `user`, `developer`, `billing`, `admin`, or `claude_code_user`.",
            "description_kind": "markdown",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Current status of the invite (e.g., pending, accepted, expired).",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Organization invite resource. Manages invitations to join an organization.",
        "description_kind": "markdown"
      }
    },
    "anthropic_workspace": {
      "version": 0,
      "block": {
        "attributes": {
          "archived_at": {
            "type": "string",
            "description": "RFC 3339 datetime string indicating when the Workspace was archived, or null if the Workspace is not archived.",
            "description_kind": "markdown",
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "RFC 3339 datetime string indicating when the Workspace was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "display_color": {
            "type": "string",
            "description": "Hex color code representing the Workspace in the Anthropic Console.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ID of the Workspace.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Workspace.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Workspace resource.",
        "description_kind": "markdown"
      }
    },
    "anthropic_workspace_member": {
      "version": 0,
      "block": {
        "attributes": {
          "user_id": {
            "type": "string",
            "description": "ID of the user who is a member of the Workspace.",
            "description_kind": "markdown",
            "required": true
          },
          "workspace_id": {
            "type": "string",
            "description": "ID of the Workspace to which the member belongs.",
            "description_kind": "markdown",
            "required": true
          },
          "workspace_role": {
            "type": "string",
            "description": "Role of the new Workspace Member. Must be one of `workspace_user`, `workspace_developer`, or `workspace_admin`.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Workspace member resource.",
        "description_kind": "markdown"
      }
    }
  },
