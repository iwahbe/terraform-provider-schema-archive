{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "unarchive_file": {
      "version": 0,
      "block": {
        "attributes": {
          "excludes": {
            "type": [
              "list",
              "string"
            ],
            "description": "Glob patterns to exclude files to extract. Defaults to `[]` (no file excluded).",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "output_dir": {
            "type": "string",
            "description": "Path of the directory where files are extracted. Defaults to `.`.",
            "description_kind": "markdown",
            "optional": true
          },
          "output_files": {
            "type": [
              "list",
              [
                "object",
                {
                  "name": "string",
                  "path": "string"
                }
              ]
            ],
            "description": "Extracted files.",
            "description_kind": "markdown",
            "computed": true
          },
          "patterns": {
            "type": [
              "list",
              "string"
            ],
            "description": "Glob patterns to filter files to extract. Defaults to `[\"**\"]` (all files included).",
            "description_kind": "markdown",
            "optional": true
          },
          "source_file": {
            "type": "string",
            "description": "Path of the archive file.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "The type of the archive file. NOTE: `zip` is supported",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Extract an archive and then enumerate the files.",
        "description_kind": "markdown"
      }
    }
  }
}
