{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "auth_token": {
          "type": "string",
          "description": "Authentication token for instellar, May also be provided via INSTELLAR_AUTH_TOKEN env variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "host": {
          "type": "string",
          "description": "Host for instellar API. May also be provided via INSTELLAR_HOST env variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Provision instellar resources.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "instellar_balancer": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "Balancer Address",
            "description_kind": "plain",
            "required": true
          },
          "cluster_id": {
            "type": "string",
            "description": "Which cluster does balancer belong to",
            "description_kind": "plain",
            "required": true
          },
          "current_state": {
            "type": "string",
            "description": "Balancer Current State",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Balancer identifier",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Balancer Last Updated",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Balancer Name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Balancer registers the load balancer address from your infrastructure load balancer and tells OpsMaru to use the load balancer address for communicating with the cluster.",
        "description_kind": "plain"
      }
    },
    "instellar_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "current_state": {
            "type": "string",
            "description": "Current state for the cluster",
            "description_kind": "plain",
            "computed": true
          },
          "endpoint": {
            "type": "string",
            "description": "Endpoint for cluster",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Cluster identifier",
            "description_kind": "plain",
            "computed": true
          },
          "insterra_component_id": {
            "type": "number",
            "description": "Reference to insterra component",
            "description_kind": "plain",
            "optional": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the terraform update",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name assigned by the user",
            "description_kind": "plain",
            "required": true
          },
          "password_token": {
            "type": "string",
            "description": "Password or Trust Token for cluster",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "provider_name": {
            "type": "string",
            "description": "Provider of the infrastructure",
            "description_kind": "plain",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "Region of the cluster",
            "description_kind": "plain",
            "required": true
          },
          "slug": {
            "type": "string",
            "description": "Unique slug for cluster",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Clusters are the foundation compute layer that run your application containers.",
        "description_kind": "plain"
      }
    },
    "instellar_component": {
      "version": 0,
      "block": {
        "attributes": {
          "channels": {
            "type": [
              "list",
              "string"
            ],
            "description": "Channels to restrict component availability",
            "description_kind": "plain",
            "required": true
          },
          "cluster_ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "Cluster ids to attach component",
            "description_kind": "plain",
            "required": true
          },
          "current_state": {
            "type": "string",
            "description": "Current state for the component",
            "description_kind": "plain",
            "computed": true
          },
          "driver": {
            "type": "string",
            "description": "Driver of the component",
            "description_kind": "plain",
            "required": true
          },
          "driver_version": {
            "type": "string",
            "description": "Version of the driver",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Component identifier",
            "description_kind": "plain",
            "computed": true
          },
          "insterra_component_id": {
            "type": "number",
            "description": "Reference to insterra component",
            "description_kind": "plain",
            "optional": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of terraform update",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the component assigned by the user",
            "description_kind": "plain",
            "required": true
          },
          "provider_name": {
            "type": "string",
            "description": "Provider of the infrastructure",
            "description_kind": "plain",
            "required": true
          },
          "slug": {
            "type": "string",
            "description": "Unique slug for component",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "credential": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "certificate": {
                  "type": "string",
                  "description": "Certificate URL or PEM",
                  "description_kind": "plain",
                  "optional": true
                },
                "host": {
                  "type": "string",
                  "description": "Host for the component.",
                  "description_kind": "plain",
                  "required": true
                },
                "password": {
                  "type": "string",
                  "description": "Password for the component, this field is sensitive.",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "port": {
                  "type": "number",
                  "description": "Port for the component",
                  "description_kind": "plain",
                  "required": true
                },
                "resource": {
                  "type": "string",
                  "description": "Resource for the component, this can be the database name or the region name.",
                  "description_kind": "plain",
                  "required": true
                },
                "secure": {
                  "type": "bool",
                  "description": "SSL configuration for the component",
                  "description_kind": "plain",
                  "optional": true
                },
                "username": {
                  "type": "string",
                  "description": "Username for the component.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Components enable you to add things like PostgreSQL, MySQL, Redis or any other 'components' and associate them to a given cluster.",
        "description_kind": "plain"
      }
    },
    "instellar_node": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster ID",
            "description_kind": "plain",
            "required": true
          },
          "current_state": {
            "type": "string",
            "description": "Current state",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Node identifier",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of terraform update",
            "description_kind": "plain",
            "computed": true
          },
          "public_ip": {
            "type": "string",
            "description": "Public IP of the node",
            "description_kind": "plain",
            "required": true
          },
          "slug": {
            "type": "string",
            "description": "Node slug",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Nodes are representation of the low level machine running your cluster. This can be a VM or a Bare Metal machine.",
        "description_kind": "plain"
      }
    },
    "instellar_storage": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key_id": {
            "type": "string",
            "description": "Access key id",
            "description_kind": "plain",
            "required": true
          },
          "bucket": {
            "type": "string",
            "description": "Bucket name",
            "description_kind": "plain",
            "required": true
          },
          "current_state": {
            "type": "string",
            "description": "Current State",
            "description_kind": "plain",
            "computed": true
          },
          "host": {
            "type": "string",
            "description": "Hostname of storage",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Storage Identifier",
            "description_kind": "plain",
            "computed": true
          },
          "insterra_component_id": {
            "type": "number",
            "description": "Reference to insterra component",
            "description_kind": "plain",
            "optional": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timesmap of teraform update",
            "description_kind": "plain",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Region of storage",
            "description_kind": "plain",
            "required": true
          },
          "secret_access_key": {
            "type": "string",
            "description": "Secret access key",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Storage is what instellar use to store all the build artifacts / ssl certificates / others. Basically anything that's needed to manage your deployments.",
        "description_kind": "plain"
      }
    },
    "instellar_uplink": {
      "version": 0,
      "block": {
        "attributes": {
          "channel_slug": {
            "type": "string",
            "description": "Which distribution channel are we using?",
            "description_kind": "plain",
            "required": true
          },
          "cluster_id": {
            "type": "string",
            "description": "Which cluster does uplink belong to",
            "description_kind": "plain",
            "required": true
          },
          "current_state": {
            "type": "string",
            "description": "The current state of uplink",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Uplink identifier",
            "description_kind": "plain",
            "computed": true
          },
          "installation_id": {
            "type": "string",
            "description": "Which installation does uplink belong to",
            "description_kind": "plain",
            "computed": true
          },
          "kit_slug": {
            "type": "string",
            "description": "Which kit are we using? lite | pro",
            "description_kind": "plain",
            "required": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of terraform update",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Uplink provides, ingress management, deployment management and environment variable management on your cluster. It routes traffic using caddy and makes sure caddy's config is up-to-date.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "instellar_uplink": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Uplink id",
            "description_kind": "plain",
            "required": true
          },
          "nodes": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of nodes",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Uplink provides a list of nodes running uplink",
        "description_kind": "plain"
      }
    }
  }
}
