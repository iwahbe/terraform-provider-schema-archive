    "ldap_object": {
      "version": 0,
      "block": {
        "attributes": {
          "additional_attributes": {
            "type": [
              "set",
              "string"
            ],
            "description": "Any additional attributes to request, such as constructed attributes",
            "description_kind": "markdown",
            "optional": true
          },
          "attributes": {
            "type": [
              "map",
              [
                "list",
                "string"
              ]
            ],
            "description": "The definition of an attribute, the name defines the type of the attribute",
            "description_kind": "markdown",
            "computed": true
          },
          "dn": {
            "type": "string",
            "description": "DN of this ldap object",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Datasource identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "object_classes": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of classes this object implements",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Generic LDAP object datasource",
        "description_kind": "markdown"
      }
    },
    "ldap_search": {
      "version": 0,
      "block": {
        "attributes": {
          "additional_attributes": {
            "type": [
              "set",
              "string"
            ],
            "description": "Any additional attributes to request, such as constructed or operational attributes",
            "description_kind": "markdown",
            "optional": true
          },
          "base_dn": {
            "type": "string",
            "description": "Base DN to use to search for LDAP objects",
            "description_kind": "markdown",
            "optional": true
          },
          "filter": {
            "type": "string",
            "description": "Filter to search for LDAP objects with",
