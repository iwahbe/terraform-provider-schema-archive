{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "ldap_bind_dn": {
          "type": "string",
          "description": "Bind DN used to manage directory (`LDAP_BIND_DN`)",
          "description_kind": "markdown",
          "optional": true
        },
        "ldap_bind_password": {
          "type": "string",
          "description": "Bind password (`LDAP_BIND_PASSWORD`)",
          "description_kind": "markdown",
          "optional": true
        },
        "ldap_tls_insecure_verify": {
          "type": "bool",
          "description": "Whether to skip certificate verification (`LDAP_TLS_INSECURE_VERIFY`)",
          "description_kind": "markdown",
          "optional": true
        },
        "ldap_tls_use_starttls": {
          "type": "bool",
          "description": "Whether to connect using STARTTLS (`LDAP_TLS_USE_STARTTLS`)",
          "description_kind": "markdown",
          "optional": true
        },
        "ldap_url": {
          "type": "string",
          "description": "LDAP URL to managed server (`LDAP_URL`)",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Terraform provider to manage and read entries in an LDAP directory.\n\nInspired by [elastic-infra/ldap](https://registry.terraform.io/providers/elastic-infra/ldap/latest), but updated to\nTerraform Framework and including ignoring attributes and a data source.\n\nAll provider options can be set by the respective environment variables as well.\n",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "ldap_object": {
      "version": 0,
      "block": {
        "attributes": {
          "attributes": {
            "type": [
              "map",
              [
                "list",
                "string"
              ]
            ],
            "description": "The definition of an attribute, the name defines the type of the attribute",
            "description_kind": "markdown",
            "optional": true
          },
          "dn": {
            "type": "string",
            "description": "DN of this ldap object",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Resource identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "ignore_changes": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of types for which changes are ignored",
            "description_kind": "markdown",
            "optional": true
          },
          "object_classes": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of classes this object implements",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Generic LDAP object resource",
        "description_kind": "markdown"
      }
    }
  },
