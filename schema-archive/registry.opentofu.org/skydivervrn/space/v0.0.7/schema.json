{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "token": {
          "type": "string",
          "description": "Token for access Space instance. https://www.jetbrains.com/help/space/personal-tokens.html",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "url": {
          "type": "string",
          "description": "URL for space instance. Example: https://test.jetbrains.space",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "space_git_repository": {
      "version": 0,
      "block": {
        "attributes": {
          "default_branch_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "latest_repository_activity": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Repository name",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "Id of parent Space project",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "This resource will create repository in project for JetBrains Space",
        "description_kind": "markdown"
      }
    },
    "space_project": {
      "version": 0,
      "block": {
        "attributes": {
          "archived": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "created_at_iso": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "created_at_timestamp": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "icon": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Unique key which couldn't be changed in future.",
            "description_kind": "markdown",
            "computed": true
          },
          "latest_repository_activity": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Space project name.",
            "description_kind": "markdown",
            "required": true
          },
          "private": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "This resource will create project for JetBrains Space https://jetbrains.space",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "space_project_data_source": {
      "version": 0,
      "block": {
        "attributes": {
          "archived": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "created_at_iso": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "created_at_timestamp": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "icon": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique id of Space project.",
            "description_kind": "markdown",
            "required": true
          },
          "key": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "latest_repository_activity": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "private": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Space project data source in the Terraform provider Space.",
        "description_kind": "markdown"
      }
    }
  }
}
