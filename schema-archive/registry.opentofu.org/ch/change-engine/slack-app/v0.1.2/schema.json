{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "token": {
          "type": "string",
          "description": "An App configuration token from https://api.slack.com/authentication/config-tokens. Can be set via the `SLACK_APP_TOKEN` environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "This is for managing Slack App Manifests, it is no use if you are not developing an App for Slack.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "slack-app_manifest": {
      "version": 0,
      "block": {
        "attributes": {
          "credentials": {
            "nested_type": {
              "attributes": {
                "client_id": {
                  "type": "string",
                  "description": "Send with `client_secret` when making your oauth.v2.access request.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "client_secret": {
                  "type": "string",
                  "description": "Send with `client_id` when making your oauth.v2.access request.",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "signing_secret": {
                  "type": "string",
                  "description": "Slack signs the requests we send you using this secret. Confirm that each request comes from Slack by verifying its unique signature.",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "verification_token": {
                  "type": "string",
                  "description": "used to verify that requests come from Slack.",
                  "description_kind": "markdown",
                  "deprecated": true,
                  "computed": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the app.",
            "description_kind": "markdown",
            "computed": true
          },
          "manifest": {
            "type": "string",
            "description": "A JSON app manifest encoded as a string.",
            "description_kind": "markdown",
            "required": true
          },
          "oauth_authorize_url": {
            "type": "string",
            "description": "Full URL for authorization.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Slack App Manifest resource",
        "description_kind": "markdown"
      }
    }
  }
}
