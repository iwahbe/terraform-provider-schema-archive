{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "author_email": {
          "type": "string",
          "description": "Default Git author email for commits created by resources.",
          "description_kind": "markdown",
          "optional": true
        },
        "author_name": {
          "type": "string",
          "description": "Default Git author name for commits created by resources.",
          "description_kind": "markdown",
          "optional": true
        },
        "cache_dir": {
          "type": "string",
          "description": "Directory used for provider-managed repository clones. Defaults to the OS user cache directory under `terraform-provider-git`.",
          "description_kind": "markdown",
          "optional": true
        },
        "commit_message_prefix": {
          "type": "string",
          "description": "Prefix added to default commit messages.",
          "description_kind": "markdown",
          "optional": true
        },
        "insecure_ignore_host_key": {
          "type": "bool",
          "description": "Disable SSH host key verification. This is insecure and should only be used for controlled test environments.",
          "description_kind": "markdown",
          "optional": true
        },
        "known_hosts_file": {
          "type": "string",
          "description": "Path to an OpenSSH known_hosts file used for SSH host key verification.",
          "description_kind": "markdown",
          "optional": true
        },
        "ssh_passphrase": {
          "type": "string",
          "description": "Passphrase for the SSH private key.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "ssh_private_key": {
          "type": "string",
          "description": "PEM encoded SSH private key.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "token": {
          "type": "string",
          "description": "Token or password for HTTPS authentication.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Username for HTTPS authentication.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Manage files in Git repositories.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "git_file": {
      "version": 0,
      "block": {
        "attributes": {
          "author_email": {
            "type": "string",
            "description": "Git author email for commits created by this resource.",
            "description_kind": "markdown",
            "optional": true
          },
          "author_name": {
            "type": "string",
            "description": "Git author name for commits created by this resource.",
            "description_kind": "markdown",
            "optional": true
          },
          "blob_sha": {
            "type": "string",
            "description": "Git blob SHA for the managed file content.",
            "description_kind": "markdown",
            "computed": true
          },
          "branch": {
            "type": "string",
            "description": "Branch to read from and push to.",
            "description_kind": "markdown",
            "required": true
          },
          "commit_message": {
            "type": "string",
            "description": "Commit message for create, update, and delete operations. Defaults to an operation-specific provider-generated message.",
            "description_kind": "markdown",
            "optional": true
          },
          "commit_sha": {
            "type": "string",
            "description": "Commit SHA at which the managed file content was last observed or written.",
            "description_kind": "markdown",
            "computed": true
          },
          "content": {
            "type": "string",
            "description": "Text file content.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Stable resource identifier derived from repository URL, branch, and path.",
            "description_kind": "markdown",
            "computed": true
          },
          "last_remote_commit_sha": {
            "type": "string",
            "description": "Remote branch commit SHA observed immediately before the most recent operation.",
            "description_kind": "markdown",
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Repository-relative file path.",
            "description_kind": "markdown",
            "required": true
          },
          "repository_url": {
            "type": "string",
            "description": "Git repository URL.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages one text file in a Git repository branch.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "git_file": {
      "version": 0,
      "block": {
        "attributes": {
          "blob_sha": {
            "type": "string",
            "description": "Git blob SHA for the file content.",
            "description_kind": "markdown",
            "computed": true
          },
          "branch": {
            "type": "string",
            "description": "Branch to read from.",
            "description_kind": "markdown",
            "required": true
          },
          "commit_sha": {
            "type": "string",
            "description": "Remote branch commit SHA used for the read.",
            "description_kind": "markdown",
            "computed": true
          },
          "content": {
            "type": "string",
            "description": "Text file content.",
            "description_kind": "markdown",
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Repository-relative file path.",
            "description_kind": "markdown",
            "required": true
          },
          "repository_url": {
            "type": "string",
            "description": "Git repository URL.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Reads one text file from a Git repository branch.",
        "description_kind": "markdown"
      }
    }
  }
}
