{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "The url to communicate with the bowtie control plane at example: https://bowtie.example.com",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The password to login to the bowtie control plane",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "The username/email to login to the bowtie control plane",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Bowtie Provider",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "bowtie_dns": {
      "version": 0,
      "block": {
        "attributes": {
          "excludes": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "order": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Provider Metadata storing extra API information about the exclude settings",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the dns settings",
            "description_kind": "markdown",
            "computed": true
          },
          "include_only_sites": {
            "type": [
              "list",
              "string"
            ],
            "description": "The sites you only want this dns to be responsible for",
            "description_kind": "markdown",
            "optional": true
          },
          "is_counted": {
            "type": "bool",
            "description": "Is Counted var",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_dns64": {
            "type": "bool",
            "description": "Is Counted var",
            "description_kind": "markdown",
            "optional": true
          },
          "is_drop_a": {
            "type": "bool",
            "description": "Whether to drop the A record or not",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_drop_all": {
            "type": "bool",
            "description": "Should all records be dropped",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_log": {
            "type": "bool",
            "description": "Is Log Var",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_search_domain": {
            "type": "bool",
            "description": "should be treated as a search domain",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Metadata about the last time a write api was called by this provider for this resource",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The DNS zone name you wish to target",
            "description_kind": "markdown",
            "required": true
          },
          "servers": {
            "nested_type": {
              "attributes": {
                "addr": {
                  "type": "string",
                  "description": "The IP address for this dns server",
                  "description_kind": "markdown",
                  "required": true
                },
                "id": {
                  "type": "string",
                  "description": "The bowtie ID for this dns server",
                  "description_kind": "markdown",
                  "computed": true
                },
                "order": {
                  "type": "number",
                  "description": "The order for this dns server",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Provider Metadata storing extra API data about the server settings",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "bowtie_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The group identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the group",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "A user group used to assign policies for access to groups of users",
        "description_kind": "markdown"
      }
    },
    "bowtie_group_membership": {
      "version": 0,
      "block": {
        "attributes": {
          "group_id": {
            "type": "string",
            "description": "The group id to manage membership for.",
            "description_kind": "markdown",
            "required": true
          },
          "users": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of users to grant membership to the group. This resource accepts both user_ids and emails. Will completely overwrite memebership on apply.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Used to set the membership of a group. Will remove any users not represented in the users array. Each group can only be associated with a single membership resource.",
        "description_kind": "markdown"
      }
    },
    "bowtie_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The bowtie api id for the resource.",
            "description_kind": "markdown",
            "computed": true
          },
          "location": {
            "nested_type": {
              "attributes": {
                "cidr": {
                  "type": "string",
                  "description": "A CIDR behind your bowtie gateway",
                  "description_kind": "markdown",
                  "optional": true
                },
                "dns": {
                  "type": "string",
                  "description": "A DNS address pointing to a resource behind your bowtie gateway",
                  "description_kind": "markdown",
                  "optional": true
                },
                "ip": {
                  "type": "string",
                  "description": "The IP address of a resource behind your bowtie gateway.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The address of the resource you are permissioning. Can be a CIDR, or single IP or DNS address.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Human readable name of the resource so users can identify what it is.",
            "description_kind": "markdown",
            "required": true
          },
          "ports": {
            "nested_type": {
              "attributes": {
                "collection": {
                  "type": [
                    "list",
                    "number"
                  ],
                  "description": "List of allowed access ports",
                  "description_kind": "markdown",
                  "optional": true
                },
                "range": {
                  "type": [
                    "list",
                    "number"
                  ],
                  "description": "First entry is the low port and second is high and all ports between the 2 inclusive are accessible",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "required": true
          },
          "protocol": {
            "type": "string",
            "description": "The connection protocol to allow connection using.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Resource object for use in access policies to grant access to resources in your network",
        "description_kind": "markdown"
      }
    },
    "bowtie_resource_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The id for the resource group in the api",
            "description_kind": "markdown",
            "computed": true
          },
          "inherited": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of resource groups to include in this resource group",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The human readable name/description of the resource group",
            "description_kind": "markdown",
            "required": true
          },
          "resources": {
            "type": [
              "list",
              "string"
            ],
            "description": "The resources that should directly be included in this resource group",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "bowtie_site": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The unique id for the site as represented in the bowtie api.",
            "description_kind": "markdown",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "The last time this object was updated using terraform. _Not part of the api_ just a piece of provider metadata.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the site that will be displayed in the control plan ui.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Represents a bowtie site.",
        "description_kind": "markdown"
      }
    },
    "bowtie_site_range": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "The description of what this range is.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The unique ID from the api for this site range.",
            "description_kind": "markdown",
            "computed": true
          },
          "ipv4_range": {
            "type": "string",
            "description": "The IPv4 CIDR range for this site range. **Mutually exlcusive with `ipv6_range`**",
            "description_kind": "markdown",
            "optional": true
          },
          "ipv6_range": {
            "type": "string",
            "description": "The IPv6 CIDR range for this site range. **Mutually exlcusive with `ipv4_range`**",
            "description_kind": "markdown",
            "optional": true
          },
          "last_updated": {
            "type": "string",
            "description": "Provider metadata for when the last update was performed via terraform for this resource.",
            "description_kind": "markdown",
            "computed": true
          },
          "metric": {
            "type": "number",
            "description": "The metric for this range",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of this range.",
            "description_kind": "markdown",
            "required": true
          },
          "site_id": {
            "type": "string",
            "description": "The Site id that this range should be associated with.",
            "description_kind": "markdown",
            "required": true
          },
          "weight": {
            "type": "number",
            "description": "The weight for this range.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "bowtie_user": {
      "version": 0,
      "block": {
        "attributes": {
          "authz_control_plane": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "authz_devices": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "authz_policies": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "authz_users": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "email": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
