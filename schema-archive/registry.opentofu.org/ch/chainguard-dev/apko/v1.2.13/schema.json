{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "build_repositories": {
          "type": [
            "list",
            "string"
          ],
          "description": "Additional repositories to search for packages, only during apko build",
          "description_kind": "plain",
          "optional": true
        },
        "default_annotations": {
          "type": [
            "map",
            "string"
          ],
          "description": "Default annotations to add",
          "description_kind": "plain",
          "optional": true
        },
        "default_archs": {
          "type": [
            "list",
            "string"
          ],
          "description": "Default architectures to build for",
          "description_kind": "plain",
          "optional": true
        },
        "default_layering": {
          "nested_type": {
            "attributes": {
              "budget": {
                "type": "number",
                "description": "Budget for the maximum number of layers that can be generated",
                "description_kind": "plain",
                "required": true
              },
              "strategy": {
                "type": "string",
                "description": "Layering strategy, currently only 'origin' is supported",
                "description_kind": "plain",
                "required": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "Default image layering configuration when not specified in the config",
          "description_kind": "plain",
          "optional": true
        },
        "extra_keyring": {
          "type": [
            "list",
            "string"
          ],
          "description": "Additional keys to use for package verification",
          "description_kind": "plain",
          "optional": true
        },
        "extra_packages": {
          "type": [
            "list",
            "string"
          ],
          "description": "Additional packages to install",
          "description_kind": "plain",
          "optional": true
        },
        "extra_repositories": {
          "type": [
            "list",
            "string"
          ],
          "description": "Additional repositories to search for packages",
          "description_kind": "plain",
          "optional": true
        },
        "plan_offline": {
          "type": "bool",
          "description": "Whether to plan offline",
          "description_kind": "plain",
          "optional": true
        },
        "size_limits": {
          "nested_type": {
            "attributes": {
              "apk_control_max_size": {
                "type": "number",
                "description": "Maximum decompressed size for APK control sections in bytes (default: 10MB).",
                "description_kind": "plain",
                "optional": true
              },
              "apk_data_max_size": {
                "type": "number",
                "description": "Maximum decompressed size for APK data sections in bytes (default: 4GB). Protects against gzip bombs.",
                "description_kind": "plain",
                "optional": true
              },
              "apk_index_decompressed_max_size": {
                "type": "number",
                "description": "Maximum decompressed size for APKINDEX archives in bytes (default: 100MB). Protects against gzip bombs.",
                "description_kind": "plain",
                "optional": true
              },
              "http_response_max_size": {
                "type": "number",
                "description": "Maximum size for HTTP responses in bytes (default: 2GB).",
                "description_kind": "plain",
                "optional": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "Size limits for APK operations to protect against decompression bombs. A value of 0 means use the default, and a value of -1 means no limit.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
