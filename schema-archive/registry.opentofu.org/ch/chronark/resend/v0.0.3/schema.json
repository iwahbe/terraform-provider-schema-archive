{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "A resend API key",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "resend_api_key": {
      "version": 0,
      "block": {
        "attributes": {
          "domain_id": {
            "type": "string",
            "description": "Restrict an API key to send emails only from a specific domain. Only used when the permission is `sending_access`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The API key ID",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The API key name",
            "description_kind": "markdown",
            "required": true
          },
          "permission": {
            "type": "string",
            "description": "The API key can have full access to Resend\u2019s API or be only restricted to send emails.\n- **full_access**: Can create, delete, get, and update any resource.\n- **sending_access**: Can only send emails.",
            "description_kind": "markdown",
            "optional": true
          },
          "token": {
            "type": "string",
            "description": "The API key token",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Add a new API key to authenticate communications with Resend.",
        "description_kind": "markdown"
      }
    },
    "resend_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "The date and time the domain was created",
            "description_kind": "markdown",
            "computed": true
          },
          "dns_provider": {
            "type": "string",
            "description": "The DNS provider used to configure the domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the domain within Resend.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the domain you want to create",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "The region where emails will be sent from. Possible values: `us-east-1` | `eu-west-1` | `sa-east-1`",
            "description_kind": "markdown",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "The status of the domain. TODO: find out possible values",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Add a new Domain.",
        "description_kind": "markdown"
      }
    }
  }
}
