{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "timestamp": {
          "type": "string",
          "description": "The current timestamp.  Only useful for testing.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "\nMulti Rotate Provider is a provider that allows you to easily rotate multiple instances of an object on a regular basis.\n",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "multirotate_set": {
      "version": 0,
      "block": {
        "attributes": {
          "current_rotation": {
            "type": "number",
            "description": "Current rotation index",
            "description_kind": "markdown",
            "computed": true
          },
          "last_rotate": {
            "type": "string",
            "description": "Last rotation time",
            "description_kind": "markdown",
            "computed": true
          },
          "number": {
            "type": "number",
            "description": "Number of different values to rotate",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "rotation_period": {
            "type": "string",
            "description": "Rotation period as Go duration string",
            "description_kind": "markdown",
            "required": true
          },
          "rotation_set": {
            "nested_type": {
              "attributes": {
                "creation": {
                  "type": "string",
                  "description": "Creation time",
                  "description_kind": "markdown",
                  "computed": true
                },
                "expiration": {
                  "type": "string",
                  "description": "Expiration time",
                  "description_kind": "markdown",
                  "computed": true
                },
                "version": {
                  "type": "string",
                  "description": "Version",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of rotation set info",
            "description_kind": "markdown",
            "computed": true
          },
          "timestamp": {
            "type": "string",
            "description": "Current time",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "version": {
            "type": "string",
            "description": "Version of new rotations",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "\nThis resource allows you to control a set of objects that are rotated on a regular basis.\nYou can define the rotation period, as well as the number of objects to rotate.\nIt will create an output list with creation/expiration times as well as which one is expiring the furthest out.\n",
        "description_kind": "markdown"
      }
    }
  }
}
