            "type": "bool",
            "description": "Whether the web launcher requires incognito mode.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "fields": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "fielddescription": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "fieldid": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "fieldname": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "fileattachmentid": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "filename": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "isfile": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "islist": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "isnotes": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "ispassword": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "itemid": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "itemvalue": {
                  "type": "string",
                  "description": "The value of the field. For SSH key generation, this will be computed by the server.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "listtype": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "slug": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "description": "List of fields for the secret.",
              "description_kind": "plain"
            }
          },
          "sshkeyargs": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "generatepassphrase": {
                  "type": "bool",
                  "description": "Whether to generate a passphrase for the SSH key.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "generatesshkeys": {
                  "type": "bool",
                  "description": "Whether to generate SSH keys.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "description": "SSH key generation arguments.",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "tss_secret_deletion": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the resource. This is set to 'secret_<secret_id>' after deletion.",
            "description_kind": "plain",
            "computed": true
          },
          "secret_id": {
            "type": "number",
            "description": "The ID of the secret to delete.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A resource to delete secrets by ID without requiring them to be in the Terraform state.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "tss_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "field": {
            "type": "string",
            "description": "The field to extract from the secret.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the secret to retrieve.",
            "description_kind": "plain",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "The value of the requested field from the secret.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description_kind": "plain"
      }
    },
    "tss_secrets": {
      "version": 0,
      "block": {
        "attributes": {
          "field": {
            "type": "string",
            "description": "The field to extract from the secrets",
            "description_kind": "plain",
            "required": true
          },
          "ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "A list of IDs of the secrets",
            "description_kind": "plain",
            "required": true
          },
          "secrets": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "number",
                  "description": "The ID of the secret",
                  "description_kind": "plain",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description": "The ephemeral value of the field of the secret",
                  "description_kind": "plain",
                  "computed": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "A list of secrets with their field values",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
