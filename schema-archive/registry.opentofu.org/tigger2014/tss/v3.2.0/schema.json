{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "domain": {
          "type": "string",
          "description": "Domain of the Secret Server user",
          "description_kind": "plain",
          "optional": true
        },
        "http_headers": {
          "type": [
            "map",
            "string"
          ],
          "description": "Additional HTTP headers to include in every API request",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "password": {
          "type": "string",
          "description": "The password of the Secret Server User",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "server_url": {
          "type": "string",
          "description": "The Secret Server base URL e.g. https://localhost/SecretServer",
          "description_kind": "plain",
          "required": true
        },
        "token": {
          "type": "string",
          "description": "A token to authenticate the Secret Server User",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "The username of the Secret Server User to connect as",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "tss_resource_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Whether the secret is active.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "autochangenabled": {
            "type": "bool",
            "description": "Whether auto-change is enabled for the secret.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "checkedout": {
            "type": "bool",
            "description": "Whether the secret is checked out.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "checkoutchangepasswordenabled": {
            "type": "bool",
            "description": "Whether checkout change password is enabled.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "checkoutenabled": {
            "type": "bool",
            "description": "Whether checkout is enabled for the secret.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "checkoutintervalminutes": {
            "type": "number",
            "description": "The checkout interval in minutes.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "delayindexing": {
            "type": "bool",
            "description": "Whether delay indexing is enabled.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "enableinheritpermissions": {
            "type": "bool",
            "description": "Whether inherit permissions is enabled.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "enableinheritsecretpolicy": {
            "type": "bool",
            "description": "Whether inherit secret policy is enabled.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "folderid": {
            "type": "string",
            "description": "The folder ID of the secret.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "The ID of the secret.",
            "description_kind": "plain",
            "computed": true
          },
          "launcherconnectassecretid": {
            "type": "number",
            "description": "The ID of the launcher connect-as secret.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the secret.",
            "description_kind": "plain",
            "required": true
          },
          "passwordtypewebscriptid": {
            "type": "number",
            "description": "The ID of the password type web script.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "proxyenabled": {
            "type": "bool",
            "description": "Whether proxy is enabled.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "requirescomment": {
            "type": "bool",
            "description": "Whether a comment is required.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "secretpolicyid": {
            "type": "number",
            "description": "The ID of the secret policy.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "secrettemplateid": {
            "type": "string",
            "description": "The template ID in which the secret will be created.",
            "description_kind": "plain",
            "required": true
          },
          "sessionrecordingenabled": {
            "type": "bool",
            "description": "Whether session recording is enabled.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "siteid": {
            "type": "string",
            "description": "The site ID where the secret will be created.",
            "description_kind": "plain",
            "required": true
          },
