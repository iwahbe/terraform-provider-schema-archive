{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "ChatGPT API Key from https://platform.openai.com/account/api-keys",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "chatgpt_prompt": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "max_tokens": {
            "type": "number",
            "description": "The max number of characters to show in the result (max is 4000).",
            "description_kind": "plain",
            "required": true
          },
          "query": {
            "type": "string",
            "description": "The query you would like to send to ChatGPT.",
            "description_kind": "plain",
            "required": true
          },
          "result": {
            "type": "string",
            "description": "The result of your query as processed by ChatGPT.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
