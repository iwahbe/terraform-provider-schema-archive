    "devhub_workflow": {
      "version": 0,
      "block": {
        "attributes": {
          "cron_schedule": {
            "type": "string",
            "description": "A cron expression evaluated using UTC time to trigger the workflow (e.g. 0 0 * * *).",
            "description_kind": "markdown",
            "optional": true
          },
          "group": {
            "type": "string",
            "description": "Used to organize workflows into folders in the workflow list.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Workflow id.",
            "description_kind": "markdown",
            "computed": true
          },
          "inputs": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "A description of what this input is for.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "key": {
                  "type": "string",
                  "description": "The key for this input.",
                  "description_kind": "markdown",
                  "required": true
                },
                "required": {
                  "type": "bool",
                  "description": "Whether this input is required.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "The type of this input (string, float, integer, boolean).",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the workflow.",
            "description_kind": "markdown",
            "required": true
          },
          "steps": {
            "nested_type": {
              "attributes": {
                "api_action": {
                  "nested_type": {
                    "attributes": {
                      "body": {
                        "type": "string",
                        "description": "The request body for the API request.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "endpoint": {
                        "type": "string",
                        "description": "The endpoint for the API request.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "expected_status_code": {
                        "type": "number",
                        "description": "The expected status code for the API request.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "headers": {
                        "nested_type": {
                          "attributes": {
                            "key": {
                              "type": "string",
                              "description": "The key for the header.",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "value": {
                              "type": "string",
                              "description": "The value for the header.",
                              "description_kind": "markdown",
                              "required": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description": "Headers for the API request.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "include_devhub_jwt": {
                        "type": "bool",
                        "description": "Whether to include the Devhub JWT in the API request.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "method": {
                        "type": "string",
                        "description": "The HTTP method for the API request.",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "approval_action": {
                  "nested_type": {
                    "attributes": {
                      "permissions": {
                        "nested_type": {
                          "attributes": {
                            "id": {
                              "type": "string",
                              "description": "Permission ID.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "organization_user_id": {
                              "type": "string",
                              "description": "The id of the organization user.",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "permission": {
                              "type": "string",
                              "description": "The permission granted to the role or user.",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "role_id": {
                              "type": "string",
                              "description": "The id of the role.",
                              "description_kind": "markdown",
                              "optional": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description_kind": "plain",
                        "optional": true
                      },
                      "reviews_required": {
                        "type": "number",
                        "description": "Number of required approvals.",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "condition": {
                  "type": "string",
                  "description": "Expression to evaluate if this step should run, if evaluated as true step will run, otherwise it will be skipped. If no condition is set the step will always run. You can use the input, output from previous steps, and basic operators like ==, !=, >, <, >=, <=, &&, ||, not.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "condition_action": {
                  "nested_type": {
                    "attributes": {
                      "condition": {
                        "type": "string",
                        "description": "Expression to evaluate if workflow should continue, if evaluated as true workflow will continue. You can use the input, output from previous steps, and basic operators like ==, !=, >, <, >=, <=, &&, ||, not.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "when_false": {
                        "type": "string",
                        "description": "When false, mark workflow as: (failed, succeeded)",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the step.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "query_action": {
                  "nested_type": {
                    "attributes": {
                      "credential_id": {
                        "type": "string",
                        "description": "The ID of the database credential to use.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "query": {
                        "type": "string",
                        "description": "The SQL query to execute.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "timeout": {
                        "type": "number",
                        "description": "The timeout for the query.",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "slack_action": {
                  "nested_type": {
                    "attributes": {
                      "link_text": {
                        "type": "string",
                        "description": "The text to display in the link.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "message": {
                        "type": "string",
                        "description": "The message to post.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "slack_channel": {
                        "type": "string",
                        "description": "The Slack channel to post to.",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "slack_reply_action": {
                  "nested_type": {
                    "attributes": {
                      "message": {
                        "type": "string",
                        "description": "The message to reply with.",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "reply_to_step_name": {
                        "type": "string",
                        "description": "The name of the step to reply to.",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "required": true
          },
          "trigger_linear_label_name": {
            "type": "string",
            "description": "The name of the Linear label that should trigger the workflow.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Workflow resource",
        "description_kind": "markdown"
      }
    }
  },
