        "description": "Dashboard resource",
        "description_kind": "markdown"
      }
    },
    "devhub_querydesk_database": {
      "version": 0,
      "block": {
        "attributes": {
          "adapter": {
            "type": "string",
            "description": "The adapter to use to establish the connection. Currently only `POSTGRES`, `MYSQL`, `CLICKHOUSE`, `SQLSERVER`, and `ORACLE` are supported.",
            "description_kind": "markdown",
            "required": true
          },
          "agent_id": {
            "type": "string",
            "description": "The agent id for the database.",
            "description_kind": "markdown",
            "optional": true
          },
          "cacertfile": {
            "type": "string",
            "description": "The server ca cert to use with ssl connections, `ssl` must be set to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "certfile": {
            "type": "string",
            "description": "The client cert to use with ssl connections, `ssl` must be set to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "credential_ids": {
            "type": [
              "map",
              "string"
            ],
            "description": "A map of credential IDs by username.",
            "description_kind": "markdown",
            "computed": true
          },
          "credentials": {
            "nested_type": {
              "attributes": {
                "default_credential": {
                  "type": "bool",
                  "description": "Whether this is the default credential for the database.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "hostname": {
                  "type": "string",
                  "description": "The hostname to use for connecting to the database when using this credential (overrides the default hostname).",
                  "description_kind": "markdown",
                  "optional": true
                },
                "id": {
                  "type": "string",
                  "description": "Credential id.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "password": {
                  "type": "string",
                  "description": "The username to use for connecting to the database.",
                  "description_kind": "markdown",
                  "required": true,
                  "sensitive": true
                },
                "reviews_required": {
                  "type": "number",
                  "description": "The number of reviews required before a query can be executed.",
                  "description_kind": "markdown",
                  "required": true
                },
                "username": {
                  "type": "string",
                  "description": "The username to use for connecting to the database.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "required": true
          },
          "database": {
            "type": "string",
            "description": "The name of the database to connect to.",
            "description_kind": "markdown",
            "required": true
          },
          "group": {
            "type": "string",
            "description": "The group this database belongs to, used for UI grouping.",
            "description_kind": "markdown",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description": "The hostname for connecting to the database, either an ip or url.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Database id.",
            "description_kind": "markdown",
            "computed": true
          },
          "keyfile": {
            "type": "string",
            "description": "The client key to use with ssl connections, `ssl` must be set to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "The name for users to use to identity the database.",
            "description_kind": "markdown",
            "required": true
          },
          "port": {
            "type": "number",
            "description": "The port to connect to the database on, if not specified the default port for the database type will be used.",
            "description_kind": "markdown",
            "optional": true
          },
          "restrict_access": {
            "type": "bool",
            "description": "Whether access to this databases should be explicitly granted to users or if any authenticated user can access it.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "slack_channel": {
            "type": "string",
            "description": "The slack channel to send query request notifications to.",
            "description_kind": "markdown",
            "optional": true
          },
          "ssl": {
            "type": "bool",
            "description": "Set to `true` to turn on ssl connections for this database.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Database resource",
        "description_kind": "markdown"
      }
    },
    "devhub_terradesk_workspace": {
      "version": 0,
      "block": {
        "attributes": {
          "agent_id": {
            "type": "string",
            "description": "The agent id for the database.",
            "description_kind": "markdown",
            "optional": true
          },
          "cpu_requests": {
            "type": "string",
            "description": "How much cpu should be requested for the pod scheduled by the job, see kubernetes docs for allowable values.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "docker_image": {
            "type": "string",
            "description": "The docker image to use for running commands, for example: hashicorp/terraform:1.10.",
            "description_kind": "markdown",
            "required": true
          },
          "env_vars": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Env var id.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name to use for the env var.",
                  "description_kind": "markdown",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "Env var value.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Workspace id.",
            "description_kind": "markdown",
            "computed": true
          },
          "init_args": {
            "type": "string",
            "description": "Args to pass to the init command.",
            "description_kind": "markdown",
            "optional": true
          },
          "memory_requests": {
            "type": "string",
            "description": "How much memory should be requested for the pod scheduled by the job, see kubernetes docs for allowable values.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name for users to use to identity the workspace.",
            "description_kind": "markdown",
            "required": true
          },
          "path": {
            "type": "string",
            "description": "The file path of here the workspace is located in the provided GitHub repository. Defaults to the root of the repository.",
            "description_kind": "markdown",
            "optional": true
          },
          "repository": {
            "type": "string",
            "description": "Which GitHub repository should be used in the format `owner/name`. Must have the GitHub integration enabled.",
            "description_kind": "markdown",
            "required": true
          },
          "required_approvals": {
            "type": "number",
            "description": "Specify how many reviews are required to apply plans.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "run_plans_automatically": {
            "type": "bool",
            "description": "Whether to run plans automatically for PRs and pushes. Make sure to consider who can push to your GitHub repository if you have this setting on as it could grant sensitive access.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "secrets": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Secret id.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Secret name.",
                  "description_kind": "markdown",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "Secret value.",
                  "description_kind": "markdown",
                  "required": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "workload_identity": {
            "nested_type": {
              "attributes": {
                "enabled": {
                  "type": "bool",
                  "description": "Whether to enable Google workload identity to authenticate with Google services.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "provider": {
                  "type": "string",
                  "description": "The workload identity provider to use: `projects/${PROJECT_NUMBER}/locations/global/workloadIdentityPools/${POOL}/providers/${PROVIDER}`",
                  "description_kind": "markdown",
                  "optional": true
                },
                "service_account_email": {
                  "type": "string",
                  "description": "The service account email to use for workload identity.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "TerraDesk workspace resource",
        "description_kind": "markdown"
      }
