                        "required": true
                      },
                      "query": {
                        "type": "string",
                        "description": "The SQL query to execute.",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "title": {
                  "type": "string",
                  "description": "The title of the panel.",
