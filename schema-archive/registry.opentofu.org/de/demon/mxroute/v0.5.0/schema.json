{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "apikey": {
          "type": "string",
          "description": "API key from `panel.mxroute.com/api-keys.php`. May also be set via `MXROUTE_APIKEY`.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "server": {
          "type": "string",
          "description": "Mail server hostname (e.g. `eagle.mxlogin.com`). May also be set via `MXROUTE_SERVER`.",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "DirectAdmin username. May also be set via `MXROUTE_USERNAME`.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Manages domains on an MXroute email hosting account.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "mxroute_catch_all": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "Destination email when `type = \"address\"`. Required in that case; must be unset otherwise.",
            "description_kind": "markdown",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the current catch-all setting. Server-managed.",
            "description_kind": "markdown",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "Domain to manage the catch-all setting for. Must already exist on the account.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Catch-all behaviour: `fail` rejects unknown recipients, `blackhole` silently discards them, `address` forwards them to `address`.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages the catch-all behaviour for mail sent to unknown addresses under a domain. Destroying this resource resets the domain to `fail`.",
        "description_kind": "markdown"
      }
    },
    "mxroute_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "name": {
            "type": "string",
            "description": "Domain name (e.g. `example.com`).",
            "description_kind": "markdown",
            "required": true
          },
          "ssl_enabled": {
            "type": "bool",
            "description": "Whether SSL is provisioned for the domain. Server-managed.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manages a domain on an MXroute account. Use `mxroute_mail_hosting` to toggle mail routing for the domain.",
        "description_kind": "markdown"
      }
    },
    "mxroute_domain_pointer": {
      "version": 0,
      "block": {
        "attributes": {
          "alias": {
            "type": "bool",
            "description": "If `true`, the pointer is an alias (mail accepted under the pointer name). If `false`, it is a redirect. Defaults to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "Target domain that the pointer resolves to (must exist on the account).",
            "description_kind": "markdown",
            "required": true
          },
          "pointer": {
            "type": "string",
            "description": "Pointer domain that aliases or redirects to `domain`.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a domain pointer (alias or redirect) targeting an MXroute-hosted domain.",
        "description_kind": "markdown"
      }
    },
    "mxroute_email_account": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain the mailbox belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "email": {
            "type": "string",
            "description": "Full email address (`username@domain`). Server-computed.",
            "description_kind": "markdown",
            "computed": true
          },
          "limit": {
            "type": "number",
            "description": "Daily outbound send limit. Defaults to `9600` server-side when omitted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "Mailbox password. Must be at least 8 characters and include uppercase, lowercase, and a digit.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "quota": {
            "type": "number",
            "description": "Storage quota in MB. `0` means unlimited. Defaults to `1024` server-side when omitted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "sent": {
            "type": "number",
            "description": "Emails sent today. Server-reported.",
            "description_kind": "markdown",
            "computed": true
          },
          "suspended": {
            "type": "bool",
            "description": "Whether the mailbox is suspended. Server-reported.",
            "description_kind": "markdown",
            "computed": true
          },
          "usage": {
            "type": "number",
            "description": "Current disk usage in MB. Server-reported.",
            "description_kind": "markdown",
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "Local part of the email address (before the `@`).",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages an email account (mailbox) on an MXroute-hosted domain.",
        "description_kind": "markdown"
      }
    },
    "mxroute_email_forwarder": {
      "version": 0,
      "block": {
        "attributes": {
          "alias": {
            "type": "string",
            "description": "Local part of the forwarder address (before the `@`).",
            "description_kind": "markdown",
            "required": true
          },
          "destinations": {
            "type": [
              "set",
              "string"
            ],
            "description": "Set of destination email addresses (or `:blackhole:` / `:fail:`).",
            "description_kind": "markdown",
            "required": true
          },
          "domain": {
            "type": "string",
            "description": "Domain the forwarder belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "email": {
            "type": "string",
            "description": "Full forwarder address (`alias@domain`). Server-computed.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manages an email forwarder on an MXroute-hosted domain. The API has no update endpoint, so changes to `destinations` force replacement. Special destinations: `:blackhole:` silently discards, `:fail:` rejects.",
        "description_kind": "markdown"
      }
    },
    "mxroute_mail_hosting": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain to manage mail hosting for. Must already exist on the account.",
            "description_kind": "markdown",
            "required": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether mail hosting is enabled for the domain.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages the mail hosting toggle for an MXroute domain. Destroying this resource disables mail hosting for the domain; it does not remove the domain itself.",
        "description_kind": "markdown"
      }
    },
    "mxroute_reseller_package": {
      "version": 0,
      "block": {
        "attributes": {
          "domain_pointers": {
            "type": "string",
            "description": "Maximum number of domain pointers, or `unlimited`. Defaults to `\"10\"` server-side when omitted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "domains": {
            "type": "string",
            "description": "Maximum number of domains, or `unlimited`. Defaults to `\"1\"` server-side when omitted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "email_accounts": {
            "type": "string",
            "description": "Maximum number of email accounts, or `unlimited`. Defaults to `\"100\"` server-side when omitted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "email_forwarders": {
            "type": "string",
            "description": "Maximum number of email forwarders, or `unlimited`. Defaults to `\"100\"` server-side when omitted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Package name. Letters, numbers, underscores, and hyphens.",
            "description_kind": "markdown",
            "required": true
          },
          "quota": {
            "type": "string",
            "description": "Mailbox disk quota in GB, or `unlimited`. Defaults to `\"1\"` server-side when omitted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a reseller account package. Requires a reseller-enabled MXroute account; non-reseller accounts will receive a `FORBIDDEN` error from the API. Each setting accepts either a numeric string or the literal `\"unlimited\"`.",
        "description_kind": "markdown"
      }
    },
    "mxroute_reseller_user": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Primary domain attached to the user. Server-computed.",
            "description_kind": "markdown",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "Contact email address. Immutable after creation.",
            "description_kind": "markdown",
            "required": true
          },
          "package": {
            "type": "string",
            "description": "Name of the package assigned to the user.",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Account password. Minimum 8 characters.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "quota_limit": {
            "type": "number",
            "description": "Quota limit in MB. `null` when the user has unlimited quota. Server-computed from the assigned package.",
            "description_kind": "markdown",
            "computed": true
          },
          "quota_unlimited": {
            "type": "bool",
            "description": "Whether the user has an unlimited quota. Server-computed from the assigned package.",
            "description_kind": "markdown",
            "computed": true
          },
          "quota_used": {
            "type": "number",
            "description": "Current quota usage in MB. Server-reported.",
            "description_kind": "markdown",
            "computed": true
          },
          "suspended": {
            "type": "bool",
            "description": "Whether the user is suspended. Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "DirectAdmin username. 1\u201310 chars, lowercase letters, numbers, and underscores.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a user under the reseller account. Requires a reseller-enabled MXroute account; non-reseller accounts will receive a `FORBIDDEN` error from the API.",
        "description_kind": "markdown"
      }
    },
    "mxroute_spam_blacklist_entry": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain whose blacklist the entry belongs to. Must already exist on the account.",
            "description_kind": "markdown",
            "required": true
          },
          "entry": {
            "type": "string",
            "description": "Email address or wildcard pattern (e.g. `*@example.com`).",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a single entry in the spam blacklist for a domain.",
        "description_kind": "markdown"
      }
    },
    "mxroute_spam_settings": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain to manage spam settings for. Must already exist on the account.",
            "description_kind": "markdown",
            "required": true
          },
          "high_score": {
            "type": "number",
            "description": "Spam score threshold (1-50) above which messages are auto-deleted.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages the spam filter settings for a domain. Destroying this resource removes Terraform tracking but leaves the server-side `high_score` value unchanged, since the API has no delete endpoint.",
        "description_kind": "markdown"
      }
    },
    "mxroute_spam_whitelist_entry": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain whose whitelist the entry belongs to. Must already exist on the account.",
            "description_kind": "markdown",
            "required": true
          },
          "entry": {
            "type": "string",
            "description": "Email address or wildcard pattern (e.g. `*@example.com`).",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a single entry in the spam whitelist for a domain.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "mxroute_dns": {
      "version": 0,
      "block": {
        "attributes": {
          "dkim": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "DKIM TXT record. Null if DKIM is not configured for the domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "Domain to retrieve DNS configuration for.",
            "description_kind": "markdown",
            "required": true
          },
          "mx_records": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "hostname": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "priority": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "MX records, ordered by priority.",
            "description_kind": "markdown",
            "computed": true
          },
          "spf": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "SPF TXT record.",
            "description_kind": "markdown",
            "computed": true
          },
          "verification": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Domain ownership verification TXT record. Null once verification is complete.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Returns the DNS records required to configure mail for a domain at its registrar (`GET /domains/{domain}/dns`).",
        "description_kind": "markdown"
      }
    },
    "mxroute_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "mail_hosting": {
            "type": "bool",
            "description": "Whether mail hosting is enabled for the domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Domain name (e.g. `example.com`).",
            "description_kind": "markdown",
            "required": true
          },
          "pointers": {
            "type": [
              "map",
              "string"
            ],
            "description": "Pointer domains targeting this domain, keyed by pointer name. Values are `alias` or `redirect`.",
            "description_kind": "markdown",
            "computed": true
          },
          "ssl_enabled": {
            "type": "bool",
            "description": "Whether SSL is provisioned for the domain.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Reads a single domain from the MXroute account.",
        "description_kind": "markdown"
      }
    },
    "mxroute_domain_pointers": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Target domain whose pointers should be listed.",
            "description_kind": "markdown",
            "required": true
          },
          "pointers": {
            "nested_type": {
              "attributes": {
                "pointer": {
                  "type": "string",
                  "description": "Pointer domain.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "target": {
                  "type": "string",
                  "description": "Target domain.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "Pointer type: `alias` or `redirect`.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Pointers configured for the domain.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Lists all pointers (aliases and redirects) configured for a domain.",
        "description_kind": "markdown"
      }
    },
    "mxroute_domains": {
      "version": 0,
      "block": {
        "attributes": {
          "domains": {
            "type": [
              "list",
              "string"
            ],
            "description": "Domain names on the account.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Lists all domains on the MXroute account.",
        "description_kind": "markdown"
      }
    },
    "mxroute_email_accounts": {
      "version": 0,
      "block": {
        "attributes": {
          "accounts": {
            "nested_type": {
              "attributes": {
                "email": {
                  "type": "string",
                  "description": "Full email address.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "limit": {
                  "type": "number",
                  "description": "Daily send limit.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "quota": {
                  "type": "number",
                  "description": "Quota in MB (`0` = unlimited).",
                  "description_kind": "markdown",
                  "computed": true
                },
                "sent": {
                  "type": "number",
                  "description": "Emails sent today.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "suspended": {
                  "type": "bool",
                  "description": "Whether the mailbox is suspended.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "usage": {
                  "type": "number",
                  "description": "Current usage in MB.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "username": {
                  "type": "string",
                  "description": "Local part of the address.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Email accounts on the domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "Domain whose email accounts should be listed.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Lists all email accounts (mailboxes) configured for a domain.",
        "description_kind": "markdown"
      }
    },
    "mxroute_email_forwarders": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain whose forwarders should be listed.",
            "description_kind": "markdown",
            "required": true
          },
          "forwarders": {
            "nested_type": {
              "attributes": {
                "alias": {
                  "type": "string",
                  "description": "Local part of the forwarder.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "destinations": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "Destination email addresses.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "email": {
                  "type": "string",
                  "description": "Full forwarder address.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Forwarders configured for the domain.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Lists all email forwarders configured for a domain.",
        "description_kind": "markdown"
      }
    },
    "mxroute_quota": {
      "version": 0,
      "block": {
        "attributes": {
          "breakdown": {
            "nested_type": {
              "attributes": {
                "backups": {
                  "type": "number",
                  "description": "Bytes used by backups.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "databases": {
                  "type": "number",
                  "description": "Bytes used by databases.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "email": {
                  "type": "number",
                  "description": "Bytes used by email.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "other": {
                  "type": "number",
                  "description": "Bytes used by other content.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "web": {
                  "type": "number",
                  "description": "Bytes used by web content.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Disk usage by category, in bytes.",
            "description_kind": "markdown",
            "computed": true
          },
          "grace_period": {
            "nested_type": {
              "attributes": {
                "days_remaining": {
                  "type": "number",
                  "description": "Days remaining in the grace period.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "deadline": {
                  "type": "string",
                  "description": "ISO 8601 timestamp when the grace period ends.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Present when the account has exceeded its quota; `null` otherwise.",
            "description_kind": "markdown",
            "computed": true
          },
          "percent_used": {
            "type": "number",
            "description": "Usage as a percentage of the quota limit.",
            "description_kind": "markdown",
            "computed": true
          },
          "total_limit": {
            "type": "number",
            "description": "Quota limit in bytes. `0` means unlimited.",
            "description_kind": "markdown",
            "computed": true
          },
          "total_used": {
            "type": "number",
            "description": "Total bytes used across all categories.",
            "description_kind": "markdown",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "ISO 8601 timestamp of the last upstream refresh.",
            "description_kind": "markdown",
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "DirectAdmin username for the account.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Returns overall account disk usage, quota limit, usage percentage, category breakdown, and grace period status. Refreshed hourly upstream.",
        "description_kind": "markdown"
      }
    },
    "mxroute_quota_email": {
      "version": 0,
      "block": {
        "attributes": {
          "accounts": {
            "nested_type": {
              "attributes": {
                "email_address": {
                  "type": "string",
                  "description": "Full email address.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "size_bytes": {
                  "type": "number",
                  "description": "Mailbox size in bytes.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "updated_at": {
                  "type": "string",
