{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key": {
          "type": "string",
          "description": "Access Key for DWS",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "profile": {
          "type": "string",
          "description": "DWS profile name",
          "description_kind": "plain",
          "optional": true
        },
        "s3_endpoint": {
          "type": "string",
          "description": "DWS s3 endpoint address",
          "description_kind": "plain",
          "optional": true
        },
        "s3_region": {
          "type": "string",
          "description": "DWS s3 region",
          "description_kind": "plain",
          "optional": true
        },
        "secret_access_key": {
          "type": "string",
          "description": "Secret Access Key for DWS",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "shared_credentials_file": {
          "type": "string",
          "description": "Path to credentials file DWS",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with DWS provider",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dws_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket_name": {
            "type": "string",
            "description": "Name of the s3 bucket to be used",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a s3 Bucket",
        "description_kind": "plain"
      }
    },
    "dws_deployment": {
      "version": 0,
      "block": {
        "attributes": {
          "assign_public_ipv4": {
            "type": "bool",
            "description": "If true assigns a public ipv4 address for your Deployment",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "assign_public_ipv6": {
            "type": "bool",
            "description": "If true assigns a public ipv6 address for your Deployment",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "assign_ygg_ip": {
            "type": "bool",
            "description": "If true assigns a yggdrasil address for your Deployment",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "cpu": {
            "type": "number",
            "description": "Number of CPU cores for your Deployment",
            "description_kind": "plain",
            "required": true
          },
          "disk_size": {
            "type": "number",
            "description": "Amount of disk size for your Deployment in MB",
            "description_kind": "plain",
            "required": true
          },
          "disk_type": {
            "type": "string",
            "description": "Disk type for your Deployment. Available options: hdd, ssd",
            "description_kind": "plain",
            "required": true
          },
          "host_name": {
            "type": "string",
            "description": "Host name for your Deployment",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "String ID of the deployment, computed",
            "description_kind": "plain",
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "OS Image used to install on the target Vitrual Machine Deployment. \nAvailable options: Ubuntu-v22.04",
            "description_kind": "plain",
            "required": true
          },
          "network_uuid": {
            "type": "string",
            "description": "ID of the network to deploy your VM into",
            "description_kind": "plain",
            "optional": true
          },
          "public_ipv4": {
            "type": "string",
            "description": "Public IPv4 of your VM",
            "description_kind": "plain",
            "computed": true
          },
          "public_ipv6": {
            "type": "string",
            "description": "Public IPv6 of your VM",
            "description_kind": "plain",
            "computed": true
          },
          "ram": {
            "type": "number",
            "description": "Amount of RAM for your Deployment in MB",
            "description_kind": "plain",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "Region where you want to deploy your Deployment.\nAvailable options: USA",
            "description_kind": "plain",
            "required": true
          },
          "ssh_key": {
            "type": "string",
            "description": "SSH key to add to the target VM to make it possible to connect to your VM",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "ssh_key_name": {
            "type": "string",
            "description": "SSH key name for Deployment",
            "description_kind": "plain",
            "required": true
          },
          "ygg_ip": {
            "type": "string",
            "description": "Yggdrasil IP of your VM",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a deployment",
        "description_kind": "plain"
      }
    },
    "dws_gpu": {
      "version": 0,
      "block": {
        "attributes": {
          "gpu_count": {
            "type": "number",
            "description": "Number of GPU instances for your deployment",
            "description_kind": "plain",
            "optional": true
          },
          "gpu_name": {
            "type": "string",
            "description": "Name of the GPU to be used in deployment",
            "description_kind": "plain",
            "required": true
          },
          "image": {
            "type": "string",
            "description": "Image used to run your docker container name:version",
            "description_kind": "plain",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "Region where you want to deploy your GPU. Available options: \n\"Northern America\", \"Central America\", \"South America\", \"Europe\", \"Asia\", \"Africa\", \"Oceania\", \"Caribbean\"",
            "description_kind": "plain",
            "optional": true
          },
          "ssh_key": {
            "type": "string",
            "description": "SSH key to add to the target GPU to make it possible to connect to your deployment",
            "description_kind": "plain",
            "required": true
          },
          "uuid": {
            "type": "string",
            "description": "String UUID of the GPU, computed",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a GPU",
        "description_kind": "plain"
      }
    },
    "dws_vpc": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the VPC",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "String ID of the VPC, computed",
            "description_kind": "plain",
            "computed": true
          },
          "ip_range": {
            "type": "string",
            "description": "IP range of the VPC",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the VPC",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a VPC",
        "description_kind": "plain"
      }
    }
  }
}
