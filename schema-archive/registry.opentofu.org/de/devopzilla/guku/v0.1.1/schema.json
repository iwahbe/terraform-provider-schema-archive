              ]
            ],
            "description": "List of config sets that can be used to configure this platform",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Platform description",
            "description_kind": "markdown",
            "computed": true
          },
