  "resource_schemas": {
    "guku_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "api_version": {
            "type": "string",
            "description": "Kubernetes API version as <MAJOR>.<MINOR>",
            "description_kind": "markdown",
            "required": true
          },
          "ca": {
            "type": "string",
            "description": "Kubernetes API server CA, base64 encoded",
            "description_kind": "markdown",
            "optional": true
          },
          "context": {
            "type": "string",
            "description": "Additional JSON cluster context",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Cluster id",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Cluster name, should be unique across clusters",
            "description_kind": "markdown",
            "required": true
          },
          "server": {
            "type": "string",
            "description": "Kubernetes API server endpoint",
            "description_kind": "markdown",
            "optional": true
          },
          "token": {
            "type": "string",
            "description": "guku service account token",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Cluster resource",
        "description_kind": "markdown"
      }
    },
    "guku_platform_binding": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster id",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Platform Binding id",
            "description_kind": "markdown",
            "computed": true
          },
          "platform_config_id": {
            "type": "string",
            "description": "Platform Config id",
            "description_kind": "markdown",
            "required": true
          },
          "platform_id": {
            "type": "string",
            "description": "Platform id",
            "description_kind": "markdown",
            "required": true
          },
          "platform_version": {
            "type": "string",
            "description": "Platform Version",
            "description_kind": "markdown",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Platform Binding status, one of `Pending`, `Succeeded`, `Failed`, `Error`",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "PlatformBinding resource",
        "description_kind": "markdown"
      }
    }
