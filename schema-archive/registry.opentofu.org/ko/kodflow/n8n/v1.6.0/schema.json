  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API key for n8n instance authentication. Can also be set via N8N_API_KEY environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "base_url": {
          "type": "string",
          "description": "Base URL of the n8n instance (e.g., https://n8n.example.com). Can also be set via N8N_API_URL environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Terraform provider for n8n automation platform",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "n8n_credential": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Timestamp when the credential was created",
            "description_kind": "markdown",
            "computed": true
          },
          "data": {
            "type": [
              "map",
              "string"
            ],
            "description": "Credential data (secrets, passwords, API keys, etc.). String values are automatically converted to the correct type (number, boolean) based on the credential schema.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description": "Credential identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Credential name",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "Project ID to assign the credential to. If not set, credential is created in personal space (General).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Credential type (e.g., httpHeaderAuth)",
            "description_kind": "markdown",
            "required": true
          },
          "updated_at": {
            "type": "string",
            "description": "Timestamp when the credential was last updated",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "n8n credential resource with automatic rotation on update.\n\n**Update Behavior**: When updated, the credential is rotated:\n1. New credential is created\n2. All workflows using the old credential are updated\n3. Old credential is deleted\n4. If any step fails, automatic rollback is performed\n\n**Note**: The credential ID will change after an update, but this is handled automatically.",
        "description_kind": "markdown"
      }
    },
