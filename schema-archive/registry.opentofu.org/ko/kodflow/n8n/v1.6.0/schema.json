          },
          "user_id": {
            "type": "string",
            "description": "ID of the user",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages user membership and roles within n8n projects. Allows adding users to projects, changing their roles, and removing them from projects.",
        "description_kind": "markdown"
      }
    },
