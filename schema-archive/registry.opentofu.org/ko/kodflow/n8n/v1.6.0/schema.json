            "type": [
              "map",
              "string"
            ],
            "description": "Workflow metadata",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Workflow name",
            "description_kind": "markdown",
            "required": true
          },
          "nodes_json": {
            "type": "string",
            "description": "Workflow nodes as JSON string. Must be valid JSON array of node objects.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "pin_data": {
            "type": [
              "map",
              "string"
            ],
            "description": "Pinned test data for the workflow",
            "description_kind": "markdown",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Project ID where the workflow should be created. If not specified, workflow is created in the default 'Overview' location. The workflow can be transferred to a different project by updating this value. Note: Once assigned to a project, a workflow cannot be moved back to the Overview location due to n8n API limitations.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "settings_json": {
            "type": "string",
            "description": "Workflow settings as JSON string. Must be valid JSON object.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "tags": {
            "type": [
              "set",
              "string"
            ],
            "description": "Set of tag IDs associated with this workflow",
            "description_kind": "markdown",
            "optional": true
          },
          "trigger_count": {
            "type": "number",
            "description": "Number of triggers in the workflow",
            "description_kind": "markdown",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "Timestamp when the workflow was last updated",
            "description_kind": "markdown",
            "computed": true
          },
          "version_id": {
            "type": "string",
            "description": "Version identifier of the workflow",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "n8n workflow resource using generated SDK",
        "description_kind": "markdown"
      }
    },
