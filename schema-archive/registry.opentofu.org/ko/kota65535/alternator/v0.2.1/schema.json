{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "dialect": {
          "type": "string",
          "description": "SQL dialect. Currently, only \"mysql\" is supported.",
          "description_kind": "markdown",
          "required": true
        },
        "host": {
          "type": "string",
          "description": "Host on which database server is located. If port number is not specified, the default value is used according to the SQL dialect (ex: mysql -> 3306).",
          "description_kind": "markdown",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "Password to use when connecting to server.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "user": {
          "type": "string",
          "description": "User name to use when connecting to server.",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "alternator_database_schema": {
      "version": 0,
      "block": {
        "attributes": {
          "changed": {
            "type": "bool",
            "description": "Used by the provider internal.",
            "description_kind": "markdown",
            "computed": true
          },
          "database": {
            "type": "string",
            "description": "Target database name.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "remote_schema": {
            "type": "string",
            "description": "Actual remote database schema definition.",
            "description_kind": "markdown",
            "computed": true
          },
          "schema": {
            "type": "string",
            "description": "SQL Database schema definition, composed by DDL statements.",
            "description_kind": "markdown",
            "required": true
          },
          "statements": {
            "type": [
              "list",
              "string"
            ],
            "description": "Statements to execute on apply.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manage SQL database schemas by [Alternator](https://github.com/kota65535/alternator).",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "alternator_database_schema": {
      "version": 0,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description": "Target database name.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "remote_schema": {
            "type": "string",
            "description": "Actual remote database schema definition.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Fetch SQL database schemas.",
        "description_kind": "markdown"
      }
    }
  }
}
