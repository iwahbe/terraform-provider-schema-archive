{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description": "Password to authenticate against the private maven repository.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "repository_url": {
          "type": "string",
          "description": "URL of the maven repository. Defaults to `https://repo1.maven.org/maven2`.",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username to authenticate against the private maven repository.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "maven_artifact": {
      "version": 0,
      "block": {
        "attributes": {
          "artifact_id": {
            "type": "string",
            "description": "Artifact ID.",
            "description_kind": "markdown",
            "required": true
          },
          "classifier": {
            "type": "string",
            "description": "Classifier.",
            "description_kind": "markdown",
            "optional": true
          },
          "extension": {
            "type": "string",
            "description": "Extension of the artifact file. Defaults to `jar`.",
            "description_kind": "markdown",
            "optional": true
          },
          "group_id": {
            "type": "string",
            "description": "Group ID.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "output_base64sha256": {
            "type": "string",
            "description": "Base64 Encoded SHA256 checksum of the artifact file.",
            "description_kind": "markdown",
            "computed": true
          },
          "output_dir": {
            "type": "string",
            "description": "Path of the directory where the artifact file is located.",
            "description_kind": "markdown",
            "optional": true
          },
          "output_md5": {
            "type": "string",
            "description": "MD5 of the artifact file.",
            "description_kind": "markdown",
            "computed": true
          },
          "output_path": {
            "type": "string",
            "description": "Path of the artifact file.",
            "description_kind": "markdown",
            "computed": true
          },
          "output_sha": {
            "type": "string",
            "description": "SHA1 checksum of the artifact file.",
            "description_kind": "markdown",
            "computed": true
          },
          "output_size": {
            "type": "number",
            "description": "Size of the artifact file.",
            "description_kind": "markdown",
            "computed": true
          },
          "version": {
            "type": "string",
            "description": "Version.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Download an artifact from the maven repository.",
        "description_kind": "markdown"
      }
    }
  }
}
