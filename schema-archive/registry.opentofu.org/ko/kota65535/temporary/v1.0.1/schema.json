{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base": {
          "type": "string",
          "description": "Path of the base directory where temporary directories/files are created. If not specified, OS-dependent temporary directory is used.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "temporary_directory": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Path of the temporary directory created.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Directory name.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Create a temporary directory. The directory is deleted every `terraform apply`, `plan` and `refresh`.",
        "description_kind": "markdown"
      }
    }
  }
}
