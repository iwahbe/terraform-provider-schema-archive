{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_image": {
          "type": "string",
          "description": "Default base image for builds",
          "description_kind": "markdown",
          "optional": true
        },
        "basic_auth": {
          "type": "string",
          "description": "Basic auth to use to authorize requests",
          "description_kind": "markdown",
          "optional": true
        },
        "repo": {
          "type": "string",
          "description": "Container repository to publish images to. Defaults to `KO_DOCKER_REPO` env var",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ko_build": {
      "version": 1,
      "block": {
        "attributes": {
          "base_image": {
            "type": "string",
            "description": "base image to use",
            "description_kind": "markdown",
            "optional": true
          },
          "env": {
            "type": [
              "list",
              "string"
            ],
            "description": "Extra environment variables to pass to the go build",
            "description_kind": "markdown",
            "optional": true
          },
          "go_binary_path": {
            "type": "string",
            "description": "Path to the Go binary to use for builds (sets KO_GO_PATH)",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "image_ref": {
            "type": "string",
            "description": "built image reference by digest",
            "description_kind": "markdown",
            "computed": true
          },
          "importpath": {
            "type": "string",
            "description": "import path to build",
            "description_kind": "markdown",
            "required": true
          },
          "ldflags": {
            "type": [
              "list",
              "string"
            ],
            "description": "Extra ldflags to pass to the go build",
            "description_kind": "markdown",
            "optional": true
          },
          "platforms": {
            "type": [
              "list",
              "string"
            ],
            "description": "Which platform to use when pulling a multi-platform base. Format: all | <os>[/<arch>[/<variant>]][,platform]*",
            "description_kind": "markdown",
            "optional": true
          },
          "repo": {
            "type": "string",
            "description": "Container repository to publish images to. If set, this overrides the provider's `repo`, and the image name will be exactly the specified `repo`, without the importpath appended.",
            "description_kind": "markdown",
            "optional": true
          },
          "sbom": {
            "type": "string",
            "description": "The SBOM media type to use (none will disable SBOM synthesis and upload).",
            "description_kind": "markdown",
            "optional": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "Which tags to use for the produced image instead of the default 'latest' tag",
            "description_kind": "markdown",
            "optional": true
          },
          "working_dir": {
            "type": "string",
            "description": "working directory for the build",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Sample resource in the Terraform provider scaffolding.",
        "description_kind": "markdown"
      }
    }
  }
}
