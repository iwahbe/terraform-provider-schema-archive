{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "Remote host to connect. example: `localhost:8022`.",
          "description_kind": "plain",
          "required": true
        },
        "max_sessions": {
          "type": "number",
          "description": "SSH max concurrent sessions. Default: 5",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "SSH password.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "password_env_var": {
          "type": "string",
          "description": "Env var for password.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "private_key": {
          "type": "string",
          "description": "SSH private key",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "private_key_env_var": {
          "type": "string",
          "description": "Env var with private key",
          "description_kind": "plain",
          "optional": true
        },
        "private_key_path": {
          "type": "string",
          "description": "Path to SSH private key",
          "description_kind": "plain",
          "optional": true
        },
        "sudo": {
          "type": "bool",
          "description": "Whether commands should be executed as sudo or not. Default: false",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "SSH user. Default is current user",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "remote_file": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "Content of the file",
            "description_kind": "plain",
            "required": true
          },
          "ensure_dir": {
            "type": "bool",
            "description": "Ensure dir before file creation. Default is false. If true, the deletion won't remove the directory and a later change of the value won't have any effect.",
            "description_kind": "plain",
            "optional": true
          },
          "group": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "group_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Placeholder identifier attribute.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "owner": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "owner_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Absolute path to the file",
            "description_kind": "plain",
            "required": true
          },
          "permissions": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "remote_folder": {
      "version": 0,
      "block": {
        "attributes": {
          "group": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "group_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Placeholder identifier attribute.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "owner": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "owner_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Absolute path to the folder",
            "description_kind": "plain",
            "required": true
          },
          "permissions": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
