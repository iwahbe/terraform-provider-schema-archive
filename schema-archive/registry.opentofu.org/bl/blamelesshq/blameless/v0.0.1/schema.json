{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "instance": {
          "type": "string",
          "description": "Your Blameless instance URL. It can also be sourced from the `BLAMELESS_INSTANCE` environment variable.",
          "description_kind": "plain",
          "required": true
        },
        "key": {
          "type": "string",
          "description": "Your Blameless API key. It can also be sourced from the `BLAMELESS_KEY` environment variable.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "blameless_incident_roles": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "roles": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of incident roles.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Incident Roles",
        "description_kind": "plain"
      }
    },
    "blameless_incident_severities": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "severity": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "label": {
                  "type": "string",
                  "description": "Label for Severity.",
                  "description_kind": "plain",
                  "required": true
                },
                "level": {
                  "type": "number",
                  "description": "Level of Severity.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description": "Incident Severities",
        "description_kind": "plain"
      }
    },
    "blameless_incident_type": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Active/Inactive",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of incident type.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "severity_settings": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "custom_channel_format": {
                  "type": "string",
                  "description": "Custom format for incident channel names.",
                  "description_kind": "plain",
                  "optional": true
                },
                "end_of_customer_impact_status": {
                  "type": "string",
                  "description": "Status that marks the end of the impact of the incident to the customer.",
                  "description_kind": "plain",
                  "optional": true
                },
                "incident_naming_scheme": {
                  "type": "string",
                  "description": "Naming scheme for incidents.",
                  "description_kind": "plain",
                  "optional": true
                },
                "private_incident_channel": {
                  "type": "bool",
                  "description": "Enables private channels when an incident is created.",
                  "description_kind": "plain",
                  "optional": true
                },
                "require_dash_separator": {
                  "type": "bool",
                  "description": "Require a dash separator in custom incident names.",
                  "description_kind": "plain",
                  "optional": true
                },
                "retrospective_analysis_template": {
                  "type": "string",
                  "description": "Markdown template for the retrospective analysis.",
                  "description_kind": "plain",
                  "optional": true
                },
                "retrospective_daily_reminder": {
                  "type": "bool",
                  "description": "Enables daily reminder to complete the retrospective.",
                  "description_kind": "plain",
                  "optional": true
                },
                "retrospective_incident_resolution_required": {
                  "type": "bool",
                  "description": "Requires incident resolution for the retrospective to be completed.",
                  "description_kind": "plain",
                  "optional": true
                },
                "retrospective_questionnaire_template": {
                  "type": "string",
                  "description": "JSON schema for the retrospective questionnaire.",
                  "description_kind": "plain",
                  "optional": true
                },
                "retrospective_required": {
                  "type": "bool",
                  "description": "Requires retrospectives.",
                  "description_kind": "plain",
                  "optional": true
                },
                "severity": {
                  "type": "number",
                  "description": "Severity level.",
                  "description_kind": "plain",
                  "required": true
                },
                "slack_announcement_channels": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Slack channels to notify when an incident is created.",
                  "description_kind": "plain",
                  "optional": true
                },
                "slack_invited_users": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Slack team members to automatically recruit into the incident channel.",
                  "description_kind": "plain",
                  "optional": true
                },
                "tasks_full_permission_role": {
                  "type": "string",
                  "description": "Role with full permissions to tasks.",
                  "description_kind": "plain",
                  "optional": true
                },
                "teams_announcement_channels": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "MS Teams channels to notify when an incident is created.",
                  "description_kind": "plain",
                  "optional": true
                },
                "teams_announcement_groups": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "MS Teams groups to notify when an incident is created.",
                  "description_kind": "plain",
                  "optional": true
                },
                "teams_invited_users": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "MS Teams team members to automatically recruit into the incident channel.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "block_types": {
                "task_list": {
                  "nesting_mode": "set",
                  "block": {
                    "block_types": {
                      "task": {
                        "nesting_mode": "set",
                        "block": {
                          "attributes": {
                            "incident_status": {
                              "type": "string",
                              "description": "Status to present the task.",
                              "description_kind": "plain",
                              "required": true
                            },
                            "name": {
                              "type": "string",
                              "description": "Name of the task.",
                              "description_kind": "plain",
                              "required": true
                            },
                            "required": {
                              "type": "bool",
                              "description": "Requires task to be completed.",
                              "description_kind": "plain",
                              "required": true
                            },
                            "role": {
                              "type": "string",
                              "description": "Role assigned to the task.",
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "description_kind": "plain"
                        },
                        "min_items": 1
                      }
                    },
                    "description": "Tasks to complete at each status of an incident.",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description": "Severity configuration",
              "description_kind": "plain"
            }
          }
        },
        "description": "Incident Type",
        "description_kind": "plain"
      }
    },
    "blameless_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the organization.",
            "description_kind": "plain",
            "required": true
          },
          "timezone": {
            "type": "string",
            "description": "Timezone specifier",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Organization Settings",
        "description_kind": "plain"
      }
    }
  }
}
