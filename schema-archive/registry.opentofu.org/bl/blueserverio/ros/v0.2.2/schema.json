{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "hosturl": {
          "type": "string",
          "description": "URL of the ROS router. Include the scheme (http/https)",
          "description_kind": "markdown",
          "required": true
        },
        "insecure": {
          "type": "bool",
          "description": "Whether to verify the SSL certificate or not",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password for the ROS user",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Username for the ROS user",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ros_system_identity": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The display name for the device.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Setting the System's Identity provides a unique identifying name for when the system identifies itself to other routers in the network and when accessing services such as DHCP, Neighbour Discovery, and default wireless SSID. The default system Identity is set to 'MikroTik'.",
        "description_kind": "markdown"
      }
    }
  }
}
