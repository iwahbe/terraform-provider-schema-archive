{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "controller_name": {
          "type": "string",
          "description": "The name of k8s service for the sealed-secret-controller.",
          "description_kind": "plain",
          "optional": true
        },
        "controller_namespace": {
          "type": "string",
          "description": "The namespace the controller is running in.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "block_types": {
        "kubernetes": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "client_certificate": {
                "type": "string",
                "description": "PEM-encoded client certificate for TLS authentication.",
                "description_kind": "plain",
                "required": true
              },
              "client_key": {
                "type": "string",
                "description": "PEM-encoded client certificate key for TLS authentication.",
                "description_kind": "plain",
                "required": true
              },
              "cluster_ca_certificate": {
                "type": "string",
                "description": "PEM-encoded root certificates bundle for TLS authentication.",
                "description_kind": "plain",
                "required": true
              },
              "host": {
                "type": "string",
                "description": "The hostname (in form of URI) of Kubernetes master.",
                "description_kind": "plain",
                "required": true
              }
            },
            "description": "Kubernetes configuration.",
            "description_kind": "plain"
          },
          "min_items": 1,
          "max_items": 1
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "sealedsecret_local": {
      "version": 0,
      "block": {
        "attributes": {
          "data": {
            "type": [
              "map",
              "string"
            ],
            "description": "Key/value pairs to populate the secret. The value will be base64 encoded",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the secret, must be unique.",
            "description_kind": "plain",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "Namespace of the secret.",
            "description_kind": "plain",
            "required": true
          },
          "public_key_hash": {
            "type": "string",
            "description": "The public key hashed to detect if the public key changes.",
            "description_kind": "plain",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The secret type (ex. Opaque). Default type is Opaque.",
            "description_kind": "plain",
            "optional": true
          },
          "yaml_content": {
            "type": "string",
            "description": "The produced sealed secret yaml file.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Creates a sealed secret and store it in yaml_content.",
        "description_kind": "plain"
      }
    }
  }
}
