          "hc_mode": {
            "type": "string",
            "description": "The health check mode.",
            "description_kind": "markdown",
            "optional": true
          },
          "hc_path": {
            "type": "string",
            "description": "The health check path.",
            "description_kind": "markdown",
            "optional": true
          },
          "hc_port": {
            "type": "number",
            "description": "The health check port.",
            "description_kind": "markdown",
            "optional": true
          },
          "hc_scheme": {
