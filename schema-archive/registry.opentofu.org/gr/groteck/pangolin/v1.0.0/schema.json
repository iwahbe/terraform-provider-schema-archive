            "description_kind": "markdown",
            "optional": true
          },
          "site_id": {
            "type": "number",
            "description": "The ID of the site.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a backend target for a resource.",
        "description_kind": "markdown"
