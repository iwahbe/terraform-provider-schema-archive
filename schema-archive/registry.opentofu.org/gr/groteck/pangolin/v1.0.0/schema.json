          "port": {
            "type": "number",
            "description": "The port of the target.",
            "description_kind": "markdown",
            "required": true
          },
          "priority": {
            "type": "number",
            "description": "The priority of the target.",
            "description_kind": "markdown",
            "optional": true
          },
          "resource_id": {
            "type": "number",
            "description": "The ID of the resource this target belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "rewrite_path": {
            "type": "string",
