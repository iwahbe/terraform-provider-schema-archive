{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "Pangolin API base URL. Can also be set via the PANGOLIN_BASE_URL environment variable. Defaults to https://api.pangolin.net/v1",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Pangolin API token. Can also be set via the PANGOLIN_TOKEN environment variable.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "pangolin_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "domain_id": {
            "type": "string",
            "description": "The ID of the domain.",
            "description_kind": "markdown",
            "required": true
          },
          "http": {
            "type": "bool",
            "description": "Whether the resource is an HTTP resource.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "The ID of the resource.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the resource.",
            "description_kind": "markdown",
            "required": true
          },
          "org_id": {
            "type": "string",
            "description": "The ID of the organization.",
            "description_kind": "markdown",
            "required": true
          },
          "protocol": {
            "type": "string",
            "description": "The protocol of the resource (tcp or udp).",
            "description_kind": "markdown",
            "required": true
          },
          "subdomain": {
            "type": "string",
            "description": "The subdomain for the resource.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages an app-style resource (HTTP/TCP/UDP).",
        "description_kind": "markdown"
      }
    },
    "pangolin_role": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "The description of the role.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "The ID of the role.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the role.",
            "description_kind": "markdown",
            "required": true
          },
          "org_id": {
            "type": "string",
            "description": "The ID of the organization this role belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages an organization role.",
        "description_kind": "markdown"
      }
    },
    "pangolin_site_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "alias": {
            "type": "string",
            "description": "The alias for the resource.",
            "description_kind": "markdown",
            "optional": true
          },
          "client_ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "The list of client IDs allowed to access this resource.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "destination": {
            "type": "string",
            "description": "The destination address or CIDR.",
            "description_kind": "markdown",
            "required": true
          },
          "disable_icmp": {
            "type": "bool",
            "description": "Whether to disable ICMP for this resource.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether the resource is enabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "The ID of the site resource.",
            "description_kind": "markdown",
            "computed": true
          },
          "mode": {
            "type": "string",
            "description": "The mode of the resource (host or cidr).",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the site resource.",
            "description_kind": "markdown",
            "required": true
          },
          "nice_id": {
            "type": "string",
            "description": "The human-readable ID of the site resource.",
            "description_kind": "markdown",
            "computed": true
          },
          "org_id": {
            "type": "string",
            "description": "The ID of the organization.",
            "description_kind": "markdown",
            "required": true
          },
          "role_ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "The list of role IDs allowed to access this resource.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "site_id": {
            "type": "number",
            "description": "The ID of the site.",
            "description_kind": "markdown",
            "required": true
          },
          "tcp_port_range_string": {
            "type": "string",
            "description": "The TCP port range allowed (e.g., '80,443' or '*').",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "udp_port_range_string": {
            "type": "string",
            "description": "The UDP port range allowed (e.g., '53' or '*').",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "user_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of user IDs allowed to access this resource.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a site resource (Host or CIDR mode).",
        "description_kind": "markdown"
      }
    },
