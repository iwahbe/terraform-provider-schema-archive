          },
          "name": {
            "type": "string",
            "description": "Name of the cluster where the GreenOps agent should be installed",
            "description_kind": "plain",
            "required": true
          },
          "rotate": {
            "type": "bool",
            "description": "Set to true to rotate the apikey used by the agent",
