{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "profile": {
          "type": "string",
          "description": "The profile that should be used to connect to AWS",
          "description_kind": "plain",
          "optional": true
        },
        "region": {
          "type": "string",
          "description": "The region where AWS operations will take place. Examples\nare us-east-1, us-west-2, etc.",
          "description_kind": "plain",
          "required": true
        },
        "table": {
          "type": "string",
          "description": "The DynamoDB table where the secrets are stored.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "credstash_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "context": {
            "type": [
              "map",
              "string"
            ],
            "description": "encryption context for the secret",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "name of the secret",
            "description_kind": "plain",
            "required": true
          },
          "table": {
            "type": "string",
            "description": "name of DynamoDB table where the secrets are stored",
            "description_kind": "plain",
            "optional": true
          },
          "value": {
            "type": "string",
            "description": "The secret contents. Either `value` or `generate` must be defined.",
            "description_kind": "plain",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "version": {
            "type": "number",
            "description": "version of the secrets",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "generate": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "charsets": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "Define the set of characters to randomly generate a password from. Options are all, alphanumeric, numeric, lowercase, uppercase, letters, symbols and human-readable.",
                  "description_kind": "plain",
                  "optional": true
                },
                "length": {
                  "type": "number",
                  "description": "The length of the secret to generate.",
                  "description_kind": "plain",
                  "required": true
                },
                "min": {
                  "type": [
                    "map",
                    "number"
                  ],
                  "description": "Ensure that the generated secret contains at least n characters from the given character set. Note that adding constraints reduces the strength of the secret.",
                  "description_kind": "plain",
                  "optional": true
                },
                "use_symbols": {
                  "type": "bool",
                  "description": "Whether the secret should contain symbols.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Settings for autogenerating a secret. Either `value` or `generate` must be defined.",
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "credstash_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "context": {
            "type": [
              "map",
              "string"
            ],
            "description": "encryption context for the secret",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "name of the secret",
            "description_kind": "plain",
            "required": true
          },
          "table": {
            "type": "string",
            "description": "name of DynamoDB table where the secrets are stored",
            "description_kind": "plain",
            "optional": true
          },
          "value": {
            "type": "string",
            "description": "value of the secret",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "version": {
            "type": "number",
            "description": "version of the secrets",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
