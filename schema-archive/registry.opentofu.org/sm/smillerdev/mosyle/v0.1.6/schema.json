{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "accesstoken": {
          "type": "string",
          "description": "Access Token from the Mosyle API integration",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "password": {
          "type": "string",
          "description": "Password used to log in to Mosyle",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Username used to log in to Mosyle",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "mosyle_assignment": {
      "version": 0,
      "block": {
        "attributes": {
          "device_serial": {
            "type": "string",
            "description": "Assigned device",
            "description_kind": "markdown",
            "required": true
          },
          "device_udid": {
            "type": "string",
            "description": "Device UDID",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "os": {
            "type": "string",
            "description": "Assignment device os",
            "description_kind": "markdown",
            "required": true
          },
          "user_id": {
            "type": "string",
            "description": "Assignment user identifier",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Assignment data",
        "description_kind": "markdown"
      }
    },
    "mosyle_user": {
      "version": 0,
      "block": {
        "attributes": {
          "code": {
            "type": "string",
            "description": "User code",
            "description_kind": "markdown",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "User email",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "identifier": {
            "type": "string",
            "description": "User identifier, set by admin",
            "description_kind": "markdown",
            "required": true
          },
          "iduser": {
            "type": "string",
            "description": "User id from mosyle",
            "description_kind": "markdown",
            "computed": true
          },
          "is_removed": {
            "type": "bool",
            "description": "User is removed",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "User name",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "User type, one of (ENDUSER|GROUP_ADMIN|ADMIN) default: ENDUSER",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "User data",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "mosyle_devicegroups": {
      "version": 0,
      "block": {
        "attributes": {
          "filter": {
            "type": [
              "map",
              "string"
            ],
            "description": "Filters to limit API data",
            "description_kind": "markdown",
            "required": true
          },
          "groups": {
            "type": [
              "list",
              [
                "object",
                {
                  "device_numbers": "number",
                  "id": "string",
                  "name": "string"
                }
              ]
            ],
            "description": "Device group data from Mosyle",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
