    "netlify_dns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "site_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "netlify_environment_variable": {
      "version": 0,
      "block": {
        "attributes": {
          "account_id": {
            "type": "string",
            "description": "The account ID / slug to create the environment variable for.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The name of the environment variable (case-sensitive).",
            "description_kind": "markdown",
            "required": true
          },
          "scopes": {
            "type": [
              "set",
              "string"
            ],
            "description": "The scopes that this environment variable is set to (Pro plans and above)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "site_id": {
            "type": "string",
            "description": "If provided, creates the environment variable on the site level, not the account level",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "netlify_environment_variable_value": {
      "version": 0,
      "block": {
        "attributes": {
          "context": {
            "type": "string",
