        "block_types": {
          "repo": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "command": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "deploy_key_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "dir": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "provider": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "repo_branch": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "repo_path": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
