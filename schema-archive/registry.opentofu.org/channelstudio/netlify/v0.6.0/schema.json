            "description_kind": "markdown",
            "required": true
          },
          "environment_variable_id": {
            "type": "string",
            "description": "The ID of a netlify_environment_variable resource this is a value of.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "value": {
            "type": "string",
            "description": "The environment variable's unencrypted value",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "netlify_hook": {
      "version": 0,
      "block": {
        "attributes": {
          "data": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "required": true
          },
          "event": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "site_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "netlify_site": {
      "version": 0,
      "block": {
        "attributes": {
          "account_name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "account_slug": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "custom_domain": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "deploy_url": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "repo": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "command": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "deploy_key_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "dir": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "installation_id": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "provider": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "repo_branch": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "repo_path": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
