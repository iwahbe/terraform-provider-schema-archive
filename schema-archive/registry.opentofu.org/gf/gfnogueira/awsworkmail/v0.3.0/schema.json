{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "assume_role": {
          "nested_type": {
            "attributes": {
              "duration_seconds": {
                "type": "number",
                "description": "Duration of the assumed role session in seconds. Must be between 900 (15 minutes) and 43200 (12 hours). If not specified, uses the role's default.",
                "description_kind": "markdown",
                "optional": true
              },
              "external_id": {
                "type": "string",
                "description": "External ID to use when assuming the role.",
                "description_kind": "markdown",
                "optional": true
              },
              "role_arn": {
                "type": "string",
                "description": "ARN of the IAM role to assume.",
                "description_kind": "markdown",
                "required": true
              },
              "session_name": {
                "type": "string",
                "description": "Session name for the assumed role session. If not specified, generates a default name.",
                "description_kind": "markdown",
                "optional": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "Configuration block for assuming an IAM role. Useful for cross-account access or when Terraform state is stored in a different account than WorkMail resources.",
          "description_kind": "markdown",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "Example provider attribute",
          "description_kind": "markdown",
          "optional": true
        },
        "region": {
          "type": "string",
          "description": "AWS region for WorkMail operations. If not specified, uses the standard AWS SDK configuration (environment variables, ~/.aws/config, etc.). WorkMail is only available in select regions.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "awsworkmail_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain name to add to WorkMail organization",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the WorkMail domain (domain name)",
            "description_kind": "markdown",
            "computed": true
          },
          "mx_records": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of MX records to configure in your DNS for this domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "organization_id": {
            "type": "string",
            "description": "ID of the WorkMail organization",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "awsworkmail_group": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "Primary email address for the group (optional, can be set after creation)",
            "description_kind": "markdown",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether the group is enabled in WorkMail.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ID of the WorkMail group",
            "description_kind": "markdown",
            "computed": true
          },
          "members": {
            "type": [
              "set",
              "string"
            ],
            "description": "Set of user IDs to be members of the group.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Group name (login name)",
            "description_kind": "markdown",
            "required": true
          },
          "organization_id": {
            "type": "string",
            "description": "ID of the WorkMail organization",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "awsworkmail_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "alias": {
            "type": "string",
            "description": "Alias for the WorkMail organization",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the WorkMail organization (alias used as ID)",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "awsworkmail_user": {
      "version": 0,
      "block": {
        "attributes": {
          "display_name": {
            "type": "string",
            "description": "Display name for the user",
            "description_kind": "markdown",
            "required": true
          },
          "email": {
            "type": "string",
            "description": "Primary email address for the user (optional, can be set after creation)",
            "description_kind": "markdown",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether the user is enabled in WorkMail.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "first_name": {
            "type": "string",
            "description": "First name of the user (optional)",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the WorkMail user",
            "description_kind": "markdown",
            "computed": true
          },
          "last_name": {
            "type": "string",
            "description": "Last name of the user (optional)",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "User name (login name)",
            "description_kind": "markdown",
            "required": true
          },
          "organization_id": {
            "type": "string",
            "description": "ID of the WorkMail organization",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Password for the user (must meet AWS WorkMail requirements)",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "awsworkmail_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "The primary email of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "organization_id": {
            "type": "string",
            "description": "The WorkMail Organization ID.",
            "description_kind": "plain",
            "required": true
          },
          "state": {
            "type": "string",
            "description": "The state of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "user_id": {
            "type": "string",
            "description": "The WorkMail User ID.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Data source for querying AWS WorkMail users.",
        "description_kind": "plain"
      }
    }
  }
}
