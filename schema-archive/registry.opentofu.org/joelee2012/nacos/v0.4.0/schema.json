{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "URL of nacos server, set the value statically in the configuration, or use the `NACOS_HOST` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password for nacos server, set the value statically in the configuration, or use the `NACOS_PASSWORD` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username for nacos server, set the value statically in the configuration, or use the `NACOS_USERNAME` environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Terraform Provider for [Nacos](https://nacos.io/)",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "nacos_configuration": {
      "version": 0,
      "block": {
        "attributes": {
          "application": {
            "type": "string",
            "description": "Configuration application.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "content": {
            "type": "string",
            "description": "Configuration content.",
            "description_kind": "markdown",
            "required": true
          },
          "data_id": {
            "type": "string",
            "description": "Configuration data id.",
            "description_kind": "markdown",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Configuration description.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "group": {
            "type": "string",
            "description": "Configuration group, default is `DEFAULT_GROUP`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of this Terraform resource. In the format of `<namespace_id>:<group>:<data_id>`.",
            "description_kind": "markdown",
            "computed": true
          },
          "namespace_id": {
            "type": "string",
            "description": "Configuration namespace id, default is empty string which means public namespace.",
            "description_kind": "markdown",
            "optional": true
          },
          "tags": {
            "type": [
              "set",
              "string"
            ],
            "description": "Configuration tags.",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Configuration type, default is `text`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Nacos configuration resource",
        "description_kind": "markdown"
      }
    },
    "nacos_namespace": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of namespace.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of namespace and this terraform resource.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of namespace.",
            "description_kind": "markdown",
            "required": true
          },
          "namespace_id": {
            "type": "string",
            "description": "ID of namespace",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Nacos namespace resource",
        "description_kind": "markdown"
      }
    },
    "nacos_permission": {
      "version": 0,
      "block": {
        "attributes": {
          "action": {
            "type": "string",
            "description": "Action to bind this permission, choices are `r`, `w`, `rw`",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of this terraform resource, in the format of `<role_name>:<resource>:<action>`",
            "description_kind": "markdown",
            "computed": true
          },
          "resource": {
            "type": "string",
            "description": "Resource to bind this permission, in the format of `<namespace_id>:<group>:<data_id>`",
            "description_kind": "markdown",
            "required": true
          },
          "role_name": {
            "type": "string",
            "description": "Role name to bind this permission",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Nacos permission resource",
        "description_kind": "markdown"
      }
    },
    "nacos_role": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of this terraform resource, in the format of `<name>:<username>`.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of role.",
            "description_kind": "markdown",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "Username to bind this role",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Nacos role resource",
        "description_kind": "markdown"
      }
    },
    "nacos_user": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of this terraform resource.",
            "description_kind": "markdown",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "Password of user.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "username": {
            "type": "string",
            "description": "Name of user",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Nacos user resource",
        "description_kind": "markdown"
      }
    }
  },
