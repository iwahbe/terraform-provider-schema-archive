{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_base_url": {
          "type": "string",
          "description": "The base URL of the Kevel API. This can also be set via the KEVEL_API_BASE_URL environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "api_key": {
          "type": "string",
          "description": "Your Kevel API Key. This can also be set via the KEVEL_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The \"kevel\" provider allows the configuration of inventory items within the [Kevel](https://www.kevel.com) ad server platform.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "kevel_ad_type": {
      "version": 0,
      "block": {
        "attributes": {
          "height": {
            "type": "number",
            "description": "Height of the ad type",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "Numeric identifier of the ad type",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the ad type",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "width": {
            "type": "number",
            "description": "Width of the ad type",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Kevel AdType",
        "description_kind": "plain"
      }
    },
    "kevel_channel": {
      "version": 0,
      "block": {
        "attributes": {
          "ad_types": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of ad types",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "Numeric identifier of the channel",
            "description_kind": "plain",
            "computed": true
          },
          "title": {
            "type": "string",
            "description": "Title of the channel",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Kevel Channel",
        "description_kind": "plain"
      }
    },
    "kevel_channel_site_map": {
      "version": 0,
      "block": {
        "attributes": {
          "channel_id": {
            "type": "number",
            "description": "Numeric identifier of the channel",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Composite identifier of the channel site map",
            "description_kind": "plain",
            "computed": true
          },
          "priority": {
            "type": "number",
            "description": "Priority of the channel site map",
            "description_kind": "plain",
            "required": true
          },
          "site_id": {
            "type": "number",
            "description": "Numeric identifier of the site",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Kevel Channel Site Map",
        "description_kind": "plain"
      }
    },
    "kevel_site": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "number",
            "description": "Numeric identifier of the site",
            "description_kind": "plain",
            "computed": true
          },
          "title": {
            "type": "string",
            "description": "Title of the site",
            "description_kind": "plain",
            "required": true
          },
          "url": {
            "type": "string",
            "description": "URL of the site",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Kevel Site",
        "description_kind": "plain"
      }
    }
  }
}
