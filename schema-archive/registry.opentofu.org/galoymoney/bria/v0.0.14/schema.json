{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API key for Bria.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "The API endpoint for Bria.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "bria_api_key": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the key.",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The secret key.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "profile": {
            "type": "string",
            "description": "The name of the profile.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "bria_payout_queue": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "config": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "consolidate_deprecated_keychains": {
                  "type": "bool",
                  "description_kind": "plain",
                  "required": true
                },
                "cpfp_payouts_after_blocks": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                },
                "cpfp_payouts_after_mins": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                },
                "force_min_change_sats": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                },
                "interval_secs": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "tx_priority": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "bria_profile": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the profile.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the profile.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "spending_policy": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "allowed_payout_addresses": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "max_payout_sats": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "bria_signer_config": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "xpub": {
            "type": "string",
            "description": "The ID of the xpub.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "bitcoind": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "endpoint": {
                  "type": "string",
                  "description": "The Bitcoind endpoint.",
                  "description_kind": "plain",
                  "required": true
                },
                "rpc_password": {
                  "type": "string",
                  "description": "The password for the Bitcoind RPC.",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "rpc_user": {
                  "type": "string",
                  "description": "The user for the Bitcoind RPC.",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                }
              },
              "description": "BitcoinD signer configuration.",
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "lnd": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "cert": {
                  "type": "string",
                  "description": "The LND certificate.",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "endpoint": {
                  "type": "string",
                  "description": "The LND endpoint.",
                  "description_kind": "plain",
                  "required": true
                },
                "macaroon_base64": {
                  "type": "string",
                  "description": "The base64 encoded macaroon.",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                }
              },
              "description": "LND signer configuration.",
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "bria_static_address": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "The address",
            "description_kind": "plain",
            "computed": true
          },
          "external_id": {
            "type": "string",
            "description": "The ID of the address.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "wallet": {
            "type": "string",
            "description": "The name of the wallet.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "bria_wallet": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the wallet.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the wallet.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "keychain": {
            "nesting_mode": "list",
            "block": {
              "block_types": {
                "descriptors": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "external": {
                        "type": "string",
                        "description": "The external descriptor",
                        "description_kind": "plain",
                        "required": true
                      },
                      "internal": {
                        "type": "string",
                        "description": "The internal descriptor",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "Descriptor configuration for the wallet.",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                },
                "wpkh": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "derivation_path": {
                        "type": "string",
                        "description": "The derivation path for the xpub (if it is not a reference)",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "xpub": {
                        "type": "string",
                        "description": "The xpub-ref or xpub",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "A list of xpub reference IDs associated with the wallet.",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description": "The keychain configuration for the wallet.",
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "bria_xpub": {
      "version": 0,
      "block": {
        "attributes": {
          "derivation": {
            "type": "string",
            "description": "The derivation path for the xpub.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the xpub.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the xpub.",
            "description_kind": "plain",
            "required": true
          },
          "xpub": {
            "type": "string",
            "description": "The extended public key.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
