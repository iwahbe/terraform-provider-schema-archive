{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_url": {
          "type": "string",
          "description": "Gandi API base URL. Defaults to `https://api.gandi.net`. Falls back to `GANDI_API_URL`. Takes precedence over `sandbox`.",
          "description_kind": "markdown",
          "optional": true
        },
        "personal_access_token": {
          "type": "string",
          "description": "Gandi Personal Access Token. Falls back to the `GANDI_PAT` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "sandbox": {
          "type": "bool",
          "description": "Use the Gandi sandbox API (`https://api.sandbox.gandi.net`) instead of production. Requires a separate sandbox account and sandbox PAT. Falls back to `GANDI_SANDBOX`. Ignored if `api_url` is set.",
          "description_kind": "markdown",
          "optional": true
        },
        "sharing_id": {
          "type": "string",
          "description": "Organization ID (sharing_id) to scope requests. Falls back to `GANDI_SHARING_ID`.",
          "description_kind": "markdown",
          "optional": true
        },
        "timeout_seconds": {
          "type": "number",
          "description": "Per-request HTTP timeout in seconds. Defaults to 30.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Manage Gandi domains, nameservers, glue records and LiveDNS records. Authenticates with a Personal Access Token (PAT); the deprecated API key is not supported.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "gandi_glue_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The domain (FQDN) the glue record belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "`<domain>/<name>`.",
            "description_kind": "markdown",
            "computed": true
          },
          "ips": {
            "type": [
              "set",
              "string"
            ],
            "description": "IPv4/IPv6 addresses for the host.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Short host name, e.g. `ns1` for `ns1.example.com`.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a glue record (host) for a Gandi domain, mapping a nameserver name to one or more IPs.",
        "description_kind": "markdown"
      }
    },
    "gandi_livedns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The domain (FQDN) the record belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "`<domain>/<name>/<type>`.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Record name relative to the domain, e.g. `www` or `@` for the apex.",
            "description_kind": "markdown",
            "required": true
          },
          "ttl": {
            "type": "number",
            "description": "Time to live in seconds (300\u20132592000). Defaults to 10800.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Record type, e.g. `A`, `AAAA`, `CNAME`, `MX`, `TXT`.",
            "description_kind": "markdown",
            "required": true
          },
          "values": {
            "type": [
              "set",
              "string"
            ],
            "description": "Record values. For CNAME/MX/NS use fully-qualified names ending with a dot.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a single LiveDNS rrset (record) on a Gandi domain. The domain must use Gandi LiveDNS nameservers for records to resolve.",
        "description_kind": "markdown"
      }
    },
    "gandi_nameservers": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The domain (FQDN) whose nameservers are managed.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The domain (FQDN); same as `domain`.",
            "description_kind": "markdown",
            "computed": true
          },
          "nameservers": {
            "type": [
              "list",
              "string"
            ],
            "description": "Ordered list of nameserver hostnames. Minimum one.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages the registry-level nameservers of a Gandi domain. Deleting this resource stops Terraform managing the nameservers but does not reset them at the registry.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "gandi_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "fqdn": {
            "type": "string",
            "description": "Fully qualified domain name to look up.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "nameservers": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "registry_ends_at": {
            "type": "string",
            "description": "Expiry date at the registry.",
            "description_kind": "markdown",
            "computed": true
          },
          "status": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "tld": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Look up an existing Gandi domain.",
        "description_kind": "markdown"
      }
    }
  }
}
