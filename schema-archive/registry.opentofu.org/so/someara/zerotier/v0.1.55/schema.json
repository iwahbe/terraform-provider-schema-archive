{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "zerotier_central__token": {
          "type": "string",
          "description": "ZeroTier Central API Token; you can generate a new one at https://my.zerotier.com/account.",
          "description_kind": "plain",
          "required": true
        },
        "zerotier_central__url": {
          "type": "string",
          "description": "ZeroTier Central API endpoint. Unlikely you'll need to alter this unless you're testing ZeroTier central itself.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "zerotier_identity": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "private_key": {
            "type": "string",
            "description": "The private key of the identity.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "public_key": {
            "type": "string",
            "description": "The public key of the identity.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Identity generator for ZeroTier members. Use this provider with others to authenticate and join users to your networks.",
        "description_kind": "plain"
      }
    },
    "zerotier_member": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_ethernet_bridging": {
            "type": "bool",
            "description": "Is this member allowed to activate ethernet bridging over the ZeroTier network?",
            "description_kind": "plain",
            "optional": true
          },
          "authorized": {
            "type": "bool",
            "description": "Is the member authorized on the network?",
            "description_kind": "plain",
            "optional": true
          },
          "capabilities": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of network capabilities",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Text description of this member.",
            "description_kind": "plain",
            "optional": true
          },
          "hidden": {
            "type": "bool",
            "description": "Is this member visible?",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ip_assignments": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of IP address assignments",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "member_id": {
            "type": "string",
            "description": "ID of this member.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Descriptive name of this member.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "network_id": {
            "type": "string",
            "description": "ID of the network this member belongs to",
            "description_kind": "plain",
            "required": true
          },
          "no_auto_assign_ips": {
            "type": "bool",
            "description": "Exempt this member from the IP auto assignment pool on a Network",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage ZeroTier members and join them to networks",
        "description_kind": "plain"
      }
    },
    "zerotier_network": {
      "version": 0,
      "block": {
        "attributes": {
          "assign_ipv4": {
            "type": [
              "map",
              "bool"
            ],
            "description": "IPv4 Assignment RuleSets",
            "description_kind": "plain",
            "optional": true
          },
          "assign_ipv6": {
            "type": [
              "map",
              "bool"
            ],
            "description": "IPv6 Assignment RuleSets",
            "description_kind": "plain",
            "optional": true
          },
          "creation_time": {
            "type": "number",
            "description": "The time at which this network was created, in epoch seconds",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description of the network",
            "description_kind": "plain",
            "optional": true
          },
          "enable_broadcast": {
            "type": "bool",
            "description": "Enable broadcast packets on the network",
            "description_kind": "plain",
            "optional": true
          },
          "flow_rules": {
            "type": "string",
            "description": "The layer 2 flow rules to apply to packets traveling across this network. Please see https://www.zerotier.com/manual/#3_4_1 for more information.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ZeroTier's internal network identifier, aka NetworkID",
            "description_kind": "plain",
            "computed": true
          },
          "mtu": {
            "type": "number",
            "description": "MTU to set on the client virtual network adapter",
            "description_kind": "plain",
            "optional": true
          },
          "multicast_limit": {
            "type": "number",
            "description": "Maximum number of recipients per multicast or broadcast. Warning - Setting this to 0 will disable IPv4 communication on your network!",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the network",
            "description_kind": "plain",
            "required": true
          },
          "private": {
            "type": "bool",
            "description": "Whether or not the network is private.  If false, members will *NOT* need to be authorized to join.",
            "description_kind": "plain",
            "optional": true
          },
          "tf_last_updated": {
            "type": "number",
            "description": "The time at which this terraform was last updated, in epoch seconds",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "assignment_pool": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "cidr": {
                  "type": "string",
                  "description": "An address range in CIDR notation. This must have no other keys assigned to this block as CIDR denotes the start and end address automatically",
                  "description_kind": "plain",
                  "optional": true
                },
                "end": {
                  "type": "string",
                  "description": "The last address in the assignment rule. This must be the highest number in the pool. end must also be accompanied by start.",
                  "description_kind": "plain",
                  "optional": true
                },
                "start": {
                  "type": "string",
                  "description": "The first address in the assignment rule. This must be the lowest number in the pool. `start` must also be accompanied by `end`.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Rules regarding IPv4 and IPv6 assignments",
              "description_kind": "plain"
            }
          },
          "route": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "target": {
                  "type": "string",
                  "description": "Network to route for",
                  "description_kind": "plain",
                  "required": true
                },
                "via": {
                  "type": "string",
                  "description": "Gateway address",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "A ipv4 or ipv6 network route",
              "description_kind": "plain"
            }
          }
        },
        "description": "Network provider for ZeroTier, allows you to create ZeroTier networks.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "zerotier_network": {
      "version": 0,
      "block": {
        "attributes": {
          "assign_ipv4": {
            "type": [
              "map",
              "bool"
            ],
            "description": "IPv4 Assignment RuleSets",
            "description_kind": "plain",
            "computed": true
          },
          "assign_ipv6": {
            "type": [
              "map",
              "bool"
            ],
            "description": "IPv6 Assignment RuleSets",
            "description_kind": "plain",
            "computed": true
          },
          "assignment_pool": {
            "type": [
              "set",
              [
                "object",
                {
                  "cidr": "string",
                  "end": "string",
                  "start": "string"
                }
              ]
            ],
            "description": "Rules regarding IPv4 and IPv6 assignments",
            "description_kind": "plain",
            "computed": true
          },
          "creation_time": {
            "type": "number",
            "description": "The time at which this network was created, in epoch seconds",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description of the network",
            "description_kind": "plain",
            "computed": true
          },
          "enable_broadcast": {
            "type": "bool",
            "description": "Enable broadcast packets on the network",
            "description_kind": "plain",
            "computed": true
          },
          "flow_rules": {
            "type": "string",
            "description": "The layer 2 flow rules to apply to packets traveling across this network. Please see https://www.zerotier.com/manual/#3_4_1 for more information.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ZeroTier's internal network identifier, aka NetworkID",
            "description_kind": "plain",
            "optional": true
          },
          "mtu": {
            "type": "number",
            "description": "MTU to set on the client virtual network adapter",
            "description_kind": "plain",
            "computed": true
          },
          "multicast_limit": {
            "type": "number",
            "description": "Maximum number of recipients per multicast or broadcast. Warning - Setting this to 0 will disable IPv4 communication on your network!",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the network",
            "description_kind": "plain",
            "computed": true
          },
          "private": {
            "type": "bool",
            "description": "Whether or not the network is private.  If false, members will *NOT* need to be authorized to join.",
            "description_kind": "plain",
            "computed": true
          },
          "route": {
            "type": [
              "set",
              [
                "object",
                {
                  "target": "string",
                  "via": "string"
                }
              ]
            ],
            "description": "A ipv4 or ipv6 network route",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Data source for ZeroTier networks, allowing you to find a network by ID",
        "description_kind": "plain"
      }
    }
  }
}
