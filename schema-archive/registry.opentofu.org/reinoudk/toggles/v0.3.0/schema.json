{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "toggles_leapfrog": {
      "version": 0,
      "block": {
        "attributes": {
          "alpha": {
            "type": "bool",
            "description": "A boolean indicating whether the alpha output is active (changed last). This is always the inverse of beta.",
            "description_kind": "plain",
            "computed": true
          },
          "alpha_timestamp": {
            "type": "string",
            "description": "An UTC RFC333 timestamp denoting the last time the alpha value was updated.",
            "description_kind": "plain",
            "computed": true
          },
          "beta": {
            "type": "bool",
            "description": "A boolean indicating whether the beta output is active (changed last). This is always the inverse of alpha.",
            "description_kind": "plain",
            "computed": true
          },
          "beta_timestamp": {
            "type": "string",
            "description": "An UTC RFC333 timestamp denoting the last time the beta value was updated.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "trigger": {
            "type": "string",
            "description": "An arbitrary string value that, when changed, toggles the output.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "toggles_rotary": {
      "version": 0,
      "block": {
        "attributes": {
          "active_output": {
            "type": "number",
            "description": "The 0-index based number of the active output.",
            "description_kind": "plain",
            "computed": true
          },
          "counters": {
            "type": [
              "list",
              "number"
            ],
            "description": "A list of counters denoting the number of times the corresponding output was set to true.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "n": {
            "type": "number",
            "description": "The number of outputs. Should be between 2 and 256",
            "description_kind": "plain",
            "optional": true
          },
          "outputs": {
            "type": [
              "list",
              "bool"
            ],
            "description": "A list of n boolean outputs.",
            "description_kind": "plain",
            "computed": true
          },
          "trigger": {
            "type": "string",
            "description": "An arbitrary string value that, when changed, toggles the output.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
