{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "database": {
          "type": "string",
          "description": "Database number. May also be set with the `REDISDB_DATABASE` environment variable. Defaults to `0`.",
          "description_kind": "plain",
          "optional": true
        },
        "hostname": {
          "type": "string",
          "description": "Server hostname. May also be set with the `REDISDB_HOSTNAME` environment variable. Defaults to `127.0.0.1`.",
          "description_kind": "plain",
          "optional": true
        },
        "port": {
          "type": "string",
          "description": "Server port. May also be set with the `REDISDB_PORT` environment variable. Defaults to `6379`.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "The redisdb provider lets you manage data inside a Redis database.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "redisdb_hash": {
      "version": 0,
      "block": {
        "attributes": {
          "hash": {
            "type": [
              "map",
              "string"
            ],
            "description": "The fields and values of the Hash.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID (key) of the Hash.",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The Hash key.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "`redisdb_hash` manages an individual Hash in Redis.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "redisdb_hash": {
      "version": 0,
      "block": {
        "attributes": {
          "hash": {
            "type": [
              "map",
              "string"
            ],
            "description": "The fields and values of the Hash.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID (key) of the Hash.",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The Hash key.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "`redisdb_hash` reads all fields and values of a Hash from Redis.",
        "description_kind": "plain"
      }
    }
  }
}
