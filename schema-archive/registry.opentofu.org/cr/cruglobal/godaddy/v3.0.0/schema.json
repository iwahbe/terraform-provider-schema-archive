          "nameservers": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of nameserver hostnames.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "`godaddy_domain_nameservers` manages the nameservers for a domain registered with GoDaddy.",
        "description_kind": "plain"
      }
