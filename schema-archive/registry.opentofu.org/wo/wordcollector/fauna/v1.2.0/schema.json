    "fauna_collection": {
      "version": 0,
      "block": {
        "attributes": {
          "data": {
            "type": [
              "map",
              "string"
            ],
            "description": "Developer-defined metadata for this collection.",
            "description_kind": "markdown",
            "optional": true
          },
          "history_days": {
            "type": "number",
            "description": "The number of days that document history is to be retained for in this collection.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of this collection. Cannot be one of: events, sets, self, documents, _.",
            "description_kind": "markdown",
            "required": true
          },
          "ts": {
            "type": "number",
            "description": "A timestamp of when this collection was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "ttl": {
            "type": "number",
            "description": "A timestamp of when this collection is to be removed.",
            "description_kind": "markdown",
            "optional": true
          },
          "ttl_days": {
            "type": "number",
            "description": "The number of days documents are to be retained for in this collection.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "fauna_database": {
      "version": 0,
      "block": {
        "attributes": {
          "data": {
