{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "git_url": {
          "type": "string",
          "description": "The URL to the SourceHut Git API endpoint. It is required if using\n\t\t\t\t\ta private installation of SourceHut. The default is to use the cloud\n\t\t\t\t\tgit service. It can be provided via the SRHT_GIT_URL environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "meta_url": {
          "type": "string",
          "description": "The URL to the SourceHut Meta API endpoint. It is required if using\n\t\t\t\t\ta private installation of SourceHut. The default is to use the cloud\n\t\t\t\t\tpaste service. It can be provided via the SRHT_META_URL environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "paste_url": {
          "type": "string",
          "description": "The URL to the SourceHut Paste API endpoint. It is required if using\n\t\t\t\t\ta private installation of SourceHut. The default is to use the cloud\n\t\t\t\t\tpaste service. It can be provided via the SRHT_PASTE_URL environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "A SourceHut API personal access token. It is required to use most\n\t\t\t\t\tresources. It can be provided via the SRHT_TOKEN environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "sourcehut_repository": {
      "version": 0,
      "block": {
        "attributes": {
          "created": {
            "type": "string",
            "description": "The date on which the repo was created in RFC3339 format.",
            "description_kind": "plain",
            "computed": true
          },
          "created_unix": {
            "type": "number",
            "description": "The date on which the repo was created as a unix timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "A description of the repository.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the repository.",
            "description_kind": "plain",
            "required": true
          },
          "subject": {
            "type": "string",
            "description": "The message subject.",
            "description_kind": "plain",
            "computed": true
          },
          "visibility": {
            "type": "string",
            "description": "The visibility of the repository (\"public\", \"unlisted\", or \"private\").",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "sourcehut_user_pgp_key": {
      "version": 0,
      "block": {
        "attributes": {
          "canonical_user": {
            "type": "string",
            "description": "The canonical name of the user that owns the key (eg. '~example').",
            "description_kind": "plain",
            "computed": true
          },
          "created": {
            "type": "string",
            "description": "The date on which the key was authorized in RFC3339 format.",
            "description_kind": "plain",
            "computed": true
          },
          "created_unix": {
            "type": "number",
            "description": "The date on which the key was authorized as a unix timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "fingerprint": {
            "type": "string",
            "description": "The fingerprint of the key.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The armored PGP key.",
            "description_kind": "plain",
            "required": true
          },
          "user": {
            "type": "string",
            "description": "The name of the user that owns the key (eg. 'example').",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "sourcehut_user_ssh_key": {
      "version": 0,
      "block": {
        "attributes": {
          "canonical_user": {
            "type": "string",
