{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_endpoint": {
          "type": "string",
          "description": "Confluent API endpoint. Can be configured using `CONFLUENT_CLOUD_API_ENDPOINT` environment variable. Defaults to: https://api.confluent.cloud",
          "description_kind": "plain",
          "optional": true
        },
        "cloud_api_key": {
          "type": "string",
          "description": "Confluent Cloud API Key. Can be configured using `CONFLUENT_CLOUD_API_KEY` environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "cloud_api_secret": {
          "type": "string",
          "description": "Confluent Cloud API Secret. Can be configured using `CONFLUENT_CLOUD_API_SECRET` environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "schema_registry_api_key": {
          "type": "string",
          "description": "Confluent Cloud API Key. Can be configured using `SCHEMA_REGISTRY_API_KEY` environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "schema_registry_api_secret": {
          "type": "string",
          "description": "Confluent Cloud API Key. Can be configured using `SCHEMA_REGISTRY_API_SECRET` environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "schema_registry_rest_endpoint": {
          "type": "string",
          "description": "Confluent Cloud API Key. Can be configured using `SCHEMA_REGISTRY_REST_ENDPOINT` environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "`foxcon` provider extends Confluent official [confluentinc/confluent](https://registry.terraform.io/providers/confluentinc/confluent/latest/docs) provider.\n\n`foxcon` includes below resources:\n- Normalization configuration for subject.\n- Normalization configuration for schema registry.\n- Confluent invitation resource that acts as original, however also deletes user from Confluent on resource deletion.\n- Cleanup of schema versions. Can be performed for soft-deleted or all non-latest versions.\n- `foxcon_confluent_read_user` that reads user details from Confluent on resources creation and deletes user from Confluent on resource deletion.\n- `foxcon_set_subject_mode` action that sets subject mode adhoc.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "foxcon_confluent_invitation": {
      "version": 0,
      "block": {
        "attributes": {
          "auth_type": {
            "type": "string",
            "description": "User's/invitee's authentication type. Must be set to `AUTH_TYPE_SSO` or `AUTH_TYPE_LOCAL`. Defauts to `AUTH_TYPE_SSO`.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "User's/invitee's email address.",
            "description_kind": "plain",
            "required": true
          },
          "invitation_id": {
            "type": "string",
            "description": "Confluent invitation id.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last apply execution.",
            "description_kind": "plain",
            "computed": true
          },
          "user_id": {
            "type": "string",
            "description": "Confluent user id.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provides an invitation resource that enables creating, reading, and deleting invitation on Confluent Cloud. On deleting invitation also deletes user from Confluent Cloud.",
        "description_kind": "markdown"
      }
    },
    "foxcon_read_confluent_user": {
      "version": 0,
      "block": {
        "attributes": {
          "invitation_id": {
            "type": "string",
            "description": "Confluent invitation id.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last apply execution.",
            "description_kind": "plain",
            "computed": true
          },
          "user_email": {
            "type": "string",
            "description": "User email address.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "user_id": {
            "type": "string",
            "description": "Confluent user id.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Gets user id, user email and invitation id by setting one of these parameters. On deletion, resource also removes user from Confluent Cloud.",
        "description_kind": "markdown"
      }
    },
    "foxcon_schema_registry_normalization": {
      "version": 0,
      "block": {
        "attributes": {
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last apply execution.",
            "description_kind": "plain",
            "computed": true
          },
          "normalization_enabled": {
            "type": "bool",
            "description": "Normalization toggle value.",
            "description_kind": "plain",
            "optional": true
          },
          "rest_endpoint": {
            "type": "string",
            "description": "The REST endpoint of the Schema Registry cluster.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "credentials": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "The Schema Registry API Key.",
                  "description_kind": "plain",
                  "optional": true
                },
                "secret": {
                  "type": "string",
                  "description": "The Schema Registry API Secret.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Sets schema registry normalization.",
        "description_kind": "markdown"
      }
    },
    "foxcon_subject_cleanup": {
      "version": 0,
      "block": {
        "attributes": {
          "cleanup_method": {
            "type": "string",
            "description": "Cleanup mode. Accepted values are: `KEEP_LATEST_ONLY`, `KEEP_ACTIVE_ONLY` and `MAX_STORED_SCHEMAS`.",
            "description_kind": "plain",
            "required": true
          },
          "cleanup_needed": {
            "type": "bool",
            "description": "Toggle to control whether clean-up in needed. No need to set it manually.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_deleted": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of schema versions deleted on the last apply execution.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last apply execution.",
            "description_kind": "plain",
            "computed": true
          },
          "latest_schema_version": {
            "type": "number",
            "description": "Last schema version number.",
            "description_kind": "plain",
            "computed": true
          },
          "number_of_schemas_to_keep": {
            "type": "number",
            "description": "Number of schemas to keep in the subject. Is a mandatory attribute while using the `MAX_STORED_SCHEMAS` cleanup mode.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "rest_endpoint": {
            "type": "string",
            "description": "Schema registry rest endpoint.",
            "description_kind": "plain",
            "optional": true
          },
          "subject_name": {
            "type": "string",
            "description": "The name of the subject.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "credentials": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "The Schema Registry API Key.",
                  "description_kind": "plain",
                  "optional": true
                },
                "secret": {
                  "type": "string",
                  "description": "The Schema Registry API Secret.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Deletes schema versions depending on the configured clean-up method.",
        "description_kind": "markdown"
      }
    },
    "foxcon_subject_normalization": {
      "version": 0,
      "block": {
        "attributes": {
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last apply execution.",
            "description_kind": "plain",
            "computed": true
          },
          "normalization_enabled": {
            "type": "bool",
            "description": "Normalization toggle value.",
            "description_kind": "plain",
            "optional": true
          },
          "rest_endpoint": {
            "type": "string",
            "description": "The REST endpoint of the Schema Registry cluster.",
            "description_kind": "plain",
            "optional": true
          },
          "subject_name": {
            "type": "string",
            "description": "The name of the subject.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "credentials": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "The Schema Registry API Key.",
                  "description_kind": "plain",
                  "optional": true
                },
                "secret": {
                  "type": "string",
                  "description": "The Schema Registry API Secret.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Sets subject normalization.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "foxcon_schema_registry_normalization": {
      "version": 0,
      "block": {
        "attributes": {
          "normalization_enabled": {
            "type": "bool",
            "description": "Normalization value",
            "description_kind": "plain",
            "computed": true
          },
          "rest_endpoint": {
            "type": "string",
            "description": "The REST endpoint of the Schema Registry cluster.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "credentials": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "The Schema Registry API Key.",
                  "description_kind": "plain",
                  "optional": true
                },
                "secret": {
                  "type": "string",
                  "description": "The Schema Registry API Secret.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Reads schema registry normalization value.",
        "description_kind": "markdown"
      }
    },
    "foxcon_subject_versions": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of all active versions.",
            "description_kind": "plain",
            "computed": true
          },
          "all": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of all schema versions (active and soft-deleted).",
            "description_kind": "plain",
            "computed": true
          },
          "latest": {
            "type": "number",
            "description": "Latest schema version number.",
            "description_kind": "plain",
            "computed": true
          },
          "rest_endpoint": {
            "type": "string",
            "description": "The REST endpoint of the Schema Registry cluster.",
            "description_kind": "plain",
            "optional": true
          },
          "soft_deleted": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of all soft-deleted versions.",
            "description_kind": "plain",
            "computed": true
          },
          "subject_name": {
            "type": "string",
            "description": "The name of the subject.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "credentials": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "The Schema Registry API Key.",
                  "description_kind": "plain",
                  "optional": true
                },
                "secret": {
                  "type": "string",
                  "description": "The Schema Registry API Secret.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Reads subject schema versions.",
        "description_kind": "markdown"
      }
    }
  }
}
