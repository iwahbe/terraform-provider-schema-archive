{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "Base URL for the CloudRift platform API. If not specified the provider has a built in default Base URL that will be used.May also be provided via CLOUDRIFT_BASE_URL environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "proto_version": {
          "type": "string",
          "description": "Protocol Version to be used for the CloudRift platform API.If not specified the provider has a built in default version that will be used. May also be provided via CLOUDRIFT_PROTO_VERSION environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "team_id": {
          "type": "string",
          "description": "Team ID for team-scoped operations (instance provisioning). May also be provided via CLOUDRIFT_TEAM_ID environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Token for CloudRift platform API. May also be provided via CLOUDRIFT_TOKEN environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Interact with CloudRift platform",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "cloudrift_ssh_key": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "SSH Key ID",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The SSH Key name",
            "description_kind": "markdown",
            "required": true
          },
          "public_key": {
            "type": "string",
            "description": "The SSH public key",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage SSH Keys",
        "description_kind": "markdown"
      }
    },
    "cloudrift_virtual_machine": {
      "version": 0,
      "block": {
        "attributes": {
          "datacenter": {
            "type": "string",
            "description": "The datacenter identifier",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Instance ID",
            "description_kind": "markdown",
            "computed": true
          },
          "instance_type": {
            "type": "string",
            "description": "The instance type identifier",
            "description_kind": "markdown",
            "required": true
          },
          "metadata": {
            "nested_type": {
              "attributes": {
                "startup_commands": {
                  "type": "string",
                  "description": "A plain text script that will be executed after the first instance boot.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Option to provide metadata. Currently supported is `startup_commands`.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Optional name for the Virtual Machine, shown in the CloudRift dashboard. Changing it forces replacement.",
            "description_kind": "markdown",
            "optional": true
          },
          "node_id": {
            "type": "string",
            "description": "ID of the node where the Virtual Machine is running on.",
            "description_kind": "markdown",
            "computed": true
          },
          "node_mode": {
            "type": "string",
            "description": "Mode of the Node the Virtual Machine is running on.",
            "description_kind": "markdown",
            "computed": true
          },
          "node_status": {
            "type": "string",
            "description": "Status fo the Node the Virtual Machine is running on.",
            "description_kind": "markdown",
            "computed": true
          },
          "port_mappings": {
            "nested_type": {
              "attributes": {
                "guest_port": {
                  "type": "number",
                  "description": "Port on the VM.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "host_port": {
                  "type": "number",
                  "description": "Port on the host/shared IP.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Port mappings for shared-IP instances. Each mapping pairs an external port on the shared IP to an internal port on the VM.",
            "description_kind": "markdown",
            "computed": true
          },
          "private_ip": {
            "type": "string",
            "description": "The private IP address",
            "description_kind": "markdown",
            "computed": true
          },
          "provider_name": {
            "type": "string",
            "description": "The name of the provider.",
            "description_kind": "markdown",
            "computed": true
          },
          "public_ip": {
            "type": "string",
            "description": "The public IPv4 IP address",
            "description_kind": "markdown",
            "computed": true
          },
          "recipe": {
            "type": "string",
            "description": "The Base Image used for the Virtual Machine",
            "description_kind": "markdown",
            "required": true
          },
          "ssh_key_id": {
            "type": "string",
            "description": "The SSH Key ID to be able to connect to the Virtual Machine.",
            "description_kind": "markdown",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "The status of the virtual machine",
            "description_kind": "markdown",
            "computed": true
          },
          "virtual_machines": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Name assigned to the Virtual Machine by the CloudRift Platform.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "username": {
                  "type": "string",
                  "description": "Username Generated by the CloudRift API to SSH into the Virtual Machine.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "vmid": {
                  "type": "number",
                  "description": "ID of the VM",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Virtual Machines info.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manage virtualMachines",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "cloudrift_instance_types": {
      "version": 0,
      "block": {
        "attributes": {
          "instance_types": {
            "nested_type": {
              "attributes": {
                "brand_short": {
                  "type": "string",
                  "description": "Short name of the Brand",
                  "description_kind": "markdown",
                  "computed": true
                },
                "manufacturer": {
                  "type": "string",
                  "description": "Name of the Manufacturer",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the Instance Type",
                  "description_kind": "markdown",
                  "computed": true
                },
                "variants": {
                  "nested_type": {
                    "attributes": {
                      "cost_per_hour": {
                        "type": "number",
                        "description": "Cost per Hour",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "cpu_count": {
                        "type": "number",
                        "description": "Number of CPUs",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "datacenters": {
                        "nested_type": {
                          "attributes": {
                            "count": {
                              "type": "number",
                              "description": "Number of instances of this variant in the datacenter. Does not equal to the number of currently available instances in the datacenter of this variant",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "name": {
                              "type": "string",
                              "description": "Name of the datacenter",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "public_ips": {
                              "type": "bool",
                              "description": "Whether dedicated public IPs are available in this datacenter. When false, the datacenter uses a shared public IP with port forwarding",
                              "description_kind": "markdown",
                              "computed": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description": "Datacenters for the Instance Variant Type",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "disk": {
                        "type": "number",
                        "description": "Disk size",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "dram": {
                        "type": "number",
                        "description": "DRAM size",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "gpu_count": {
                        "type": "number",
                        "description": "Number of GPUs",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "logical_cpu_count": {
                        "type": "number",
                        "description": "Logical CPU count (cpu_count * 2)",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "mig_profile": {
                        "type": "string",
                        "description": "MIG profile name for fractional GPU allocation",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "name": {
                        "type": "string",
                        "description": "Name of the Instance Type Variant",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "vram": {
                        "type": "number",
                        "description": "VRAM per GPU in bytes",
                        "description_kind": "markdown",
                        "computed": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "Variants of the Instance Type",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Known Instance Types",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Read Instance Types",
        "description_kind": "markdown"
      }
    },
    "cloudrift_recipes": {
      "version": 0,
      "block": {
        "attributes": {
          "groups": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "Description of the group",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the group containing related recipes",
                  "description_kind": "markdown",
                  "computed": true
                },
                "recipes": {
                  "nested_type": {
                    "attributes": {
                      "description": {
                        "type": "string",
                        "description": "Description of the recipe",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "name": {
                        "type": "string",
                        "description": "Name of the recipe",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "tags": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Tags for the recipe",
                        "description_kind": "markdown",
                        "computed": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "Recipes belonging to the group",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Grouped recipes",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Read recipes",
        "description_kind": "markdown"
      }
    },
    "cloudrift_ssh_key": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "SSH Key ID",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The SSH Key name",
            "description_kind": "markdown",
            "required": true
          },
          "public_key": {
            "type": "string",
            "description": "The SSH public key",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manage SSH Keys",
        "description_kind": "markdown"
      }
    }
  }
}
