{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "insecure": {
          "type": "bool",
          "description": "Whether to skip TLS verification, can optionally be passed as `GRAVITY_INSECURE` environmental variable",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The Gravity API token, can optionally be passed as `GRAVITY_TOKEN` environmental variable",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "url": {
          "type": "string",
          "description": "The Gravity API endpoint, can optionally be passed as `GRAVITY_URL` environmental variable",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "gravity_dhcp_lease": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "identifier": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "reservation": {
            "type": "bool",
            "description": "Defaults to `true`.",
            "description_kind": "markdown",
            "optional": true
          },
          "scope": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "gravity_dhcp_scope": {
      "version": 0,
      "block": {
        "attributes": {
          "default": {
            "type": "bool",
            "description": "Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ipam": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "required": true
          },
          "lease_ttl": {
            "type": "number",
            "description": "Defaults to `86400`.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "subnet_cidr": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "dns": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "add_zone_in_hostname": {
                  "type": "bool",
                  "description": "Defaults to `false`.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "search": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "zone": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "option": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "tag": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                },
                "tag_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "value64": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "gravity_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "data": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "fqdn": {
            "type": "string",
            "description": "Generated.",
            "description_kind": "markdown",
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "mx_preference": {
            "type": "number",
            "description_kind": "plain",
            "optional": true
          },
          "srv_port": {
            "type": "number",
            "description_kind": "plain",
            "optional": true
          },
          "srv_priority": {
            "type": "number",
            "description_kind": "plain",
            "optional": true
          },
          "srv_weight": {
            "type": "number",
            "description_kind": "plain",
            "optional": true
          },
          "ttl": {
            "type": "number",
            "description": "Defaults to `0`.",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Allowed values:\n  - `A`\n  - `AAAA`\n  - `PTR`\n  - `SRV`\n  - `MX`\n  - `CNAME`\n  - `TXT`\n  - `SOA`",
            "description_kind": "markdown",
            "required": true
          },
          "uid": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "zone": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "gravity_dns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "authoritative": {
            "type": "bool",
            "description": "Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "default_ttl": {
            "type": "number",
            "description": "Defaults to `86400`.",
            "description_kind": "markdown",
            "optional": true
          },
          "handler_configs": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "gravity_user": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "permissions": {
            "type": "string",
            "description": "Defaults to `[]`.",
            "description_kind": "markdown",
            "optional": true
          },
          "username": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
