{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_url": {
          "type": "string",
          "description": "The URL endpoint for the Breaking Bad Quotes API. Defaults to 'https://api.breakingbadquotes.xyz'.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "breakingbad_quote": {
      "version": 0,
      "block": {
        "attributes": {
          "quote": {
            "type": "string",
            "description": "The quote from Breaking Bad.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provides quotes and authors from Breaking Bad",
        "description_kind": "plain"
      }
    }
  }
}
