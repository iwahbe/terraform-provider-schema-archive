{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "allow_insecure": {
          "type": "bool",
          "description": "Allow insecure connections to the Pleasant Password Server, Can be specified with the `PPS_ALLOW_INSECURE` environment variable",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Required: The password of the Pleasant Password Server, Can be specified with the `PPS_PASSWORD` environment variable",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "server_url": {
          "type": "string",
          "description": "Required: The URL of the Pleasant Password Server, Can be specified with the `PPS_SERVER_URL` environment variable  ",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Required: The username of the Pleasant Password Server, Can be specified with the `PPS_USERNAME` environment variable",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "PPS API : Programatically control Pleasant Password Server.",
      "description_kind": "plain"
    }
  },
