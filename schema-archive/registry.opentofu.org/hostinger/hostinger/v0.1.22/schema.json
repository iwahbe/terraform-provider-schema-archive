{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "API token for authenticating with Hostinger API.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "hostinger_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "ttl": {
            "type": "number",
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "value": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "zone": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "hostinger_vps": {
      "version": 0,
      "block": {
        "attributes": {
          "data_center_id": {
            "type": "number",
            "description": "Data center location identifier for the VPS.",
            "description_kind": "plain",
            "required": true
          },
          "hostname": {
            "type": "string",
            "description": "Hostname to assign to the VPS (FQDN). If not set, a default hostname is generated.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ipv4_address": {
            "type": "string",
            "description": "Public IPv4 address assigned to the VPS.",
            "description_kind": "plain",
            "computed": true
          },
          "ipv6_address": {
            "type": "string",
            "description": "Public IPv6 address assigned to the VPS (if available).",
            "description_kind": "plain",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "Root password for the new VPS (will be sent to the server).",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "payment_method_id": {
            "type": "number",
            "description": "Payment method ID to use for the order. If omitted, the default method will be used.",
            "description_kind": "plain",
            "optional": true
          },
          "plan": {
            "type": "string",
            "description": "VPS plan identifier (e.g., `hostingercom-vps-kvm2-usd-1m`).",
            "description_kind": "plain",
            "required": true
          },
          "post_install_script_id": {
            "type": "number",
            "description": "ID of the post-install script to run after OS setup.",
            "description_kind": "plain",
            "optional": true
          },
          "ssh_key_ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of SSH key IDs to attach to the VPS after setup.",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "Current status of the VPS (e.g., running, stopped, installing, reinstalling).",
            "description_kind": "plain",
            "computed": true
          },
          "template_id": {
            "type": "number",
            "description": "OS template ID to install (e.g., `1002` for Debian 11).",
            "description_kind": "plain",
            "required": true
          },
          "vps_id": {
            "type": "number",
            "description": "The Hostinger VPS instance ID.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "hostinger_vps_post_install_script": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "Shell script content to execute post-install.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the post-install script.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "hostinger_vps_ssh_key": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The actual SSH public key string.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "Name of the SSH public key.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "hostinger_vps_data_centers": {
      "version": 0,
      "block": {
        "attributes": {
          "data_centers": {
            "type": [
              "list",
              [
                "object",
                {
                  "city": "string",
                  "continent": "string",
                  "id": "number",
                  "location": "string",
                  "name": "string"
                }
              ]
            ],
            "description": "List of data center locations available for VPS provisioning.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "hostinger_vps_plans": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "plans": {
            "type": [
              "list",
              [
                "object",
                {
                  "category": "string",
                  "id": "string",
                  "name": "string"
                }
              ]
            ],
            "description": "List of available VPS pricing plans and SKUs.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "hostinger_vps_templates": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "templates": {
            "type": [
              "list",
              [
                "object",
                {
                  "description": "string",
                  "id": "number",
                  "name": "string"
                }
              ]
            ],
            "description": "List of available OS templates.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
