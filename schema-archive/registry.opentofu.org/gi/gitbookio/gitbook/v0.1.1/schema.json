{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_token": {
          "type": "string",
          "description": "GitBook Terraform integration access token (env variable: `GITBOOK_ACCESS_TOKEN`)",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "base_url": {
          "type": "string",
          "description": "GitBook API base URL (env variable: `GITBOOK_API_BASE_URL`)",
          "description_kind": "markdown",
          "optional": true
        },
        "integration_url": {
          "type": "string",
          "description": "GitBook Terraform integration URL (env variable: `GITBOOK_INTEGRATION_URL`)",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Syncs Terraform resources with GitBook entities. See the [GitBook Terraform integration documentation](https://docs.gitbook.com/product-tour/integrations/terraform) for more detailed installation and usage instructions.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "gitbook_entity": {
      "version": 0,
      "block": {
        "attributes": {
          "entity_id": {
            "type": "string",
            "description": "The ID of the entity, unique for the related entity schema.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The computed ID of the entity. Not to be confused with the `entity_id` attribute.",
            "description_kind": "markdown",
            "computed": true
          },
          "organization_id": {
            "type": "string",
            "description": "The ID of the organization that owns the entity.",
            "description_kind": "markdown",
            "required": true
          },
          "properties": {
            "nested_type": {
              "attributes": {
                "boolean": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "number": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                },
                "relation": {
                  "nested_type": {
                    "attributes": {
                      "entity_id": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "string": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "map"
            },
            "description": "Map of properties, where each key is the property name and the value is an object with either a `string`, `number` or `boolean` property.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "The type of the entity schema. Must be prefixed with `terraform:`.",
            "description_kind": "markdown",
            "required": true
          },
          "urls": {
            "nested_type": {
              "attributes": {
                "location": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Entity resource",
        "description_kind": "markdown"
      }
    },
    "gitbook_entity_schema": {
      "version": 0,
      "block": {
        "attributes": {
          "organization_id": {
            "type": "string",
            "description": "The ID of the organization that owns the entity schema.",
            "description_kind": "markdown",
            "required": true
          },
          "properties": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "The description of the property.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "entity": {
                  "nested_type": {
                    "attributes": {
                      "type": {
                        "type": "string",
                        "description": "The type of the entity schema that can be used for relations.",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Required when type is `relation`.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the property. Must be unique within the entity schema.",
                  "description_kind": "markdown",
                  "required": true
                },
                "title": {
                  "type": "string",
                  "description": "The title of the property.",
                  "description_kind": "markdown",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description": "The type of the property. Must be one of `text`, `number`, `boolean`, `date`, or `relation`.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "The properties of the entity schema. Each property must have a unique name. At least one property is required.",
            "description_kind": "markdown",
            "required": true
          },
          "title": {
            "nested_type": {
              "attributes": {
                "plural": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "singular": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The title of the entity schema.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "The type of the entity schema. Must be prefixed with `terraform:`.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Entity schema resource",
        "description_kind": "markdown"
      }
    }
  },
