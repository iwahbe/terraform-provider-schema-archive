{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "token": {
          "type": "string",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "influxdbv2_authorization": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Status of the token. If inactive, requests using the token will be rejected.",
            "description_kind": "markdown",
            "optional": true
          },
          "created_at": {
            "type": "string",
            "description": "Authorization creation date.",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "A description of the token.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "org_id": {
            "type": "string",
            "description": "ID of the organization that the authorization is scoped to.",
            "description_kind": "markdown",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "Token used to authenticate API requests.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "updated_at": {
            "type": "string",
            "description": "Last authorization update date.",
            "description_kind": "markdown",
            "computed": true
          },
          "user_id": {
            "type": "string",
            "description": "ID of the user that created and owns the token.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "permissions": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "action": {
                  "type": "string",
                  "description": "Enum: 'read'|'write'.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "block_types": {
                "resource": {
                  "nesting_mode": "set",
                  "block": {
                    "attributes": {
                      "id": {
                        "type": "string",
                        "description": "If ID is set, that is a permission for a specific resource. If it is not set, it is a permission for all resources of that resource type.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "org_id": {
                        "type": "string",
                        "description": "If orgID is set, that is a permission for all resources owned by that org. If it is not set, it is a permission for all resources of that resource type.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "type": {
                        "type": "string",
                        "description": "Type of resource.",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "description": "Resource info.",
                    "description_kind": "markdown"
                  },
                  "min_items": 1,
                  "max_items": 1
                }
              },
              "description": "List of permissions for an authorization. An authorization must have at least one permission.",
              "description_kind": "markdown"
            },
            "min_items": 1
          }
        },
        "description": "InfluxDB Bucket resource",
        "description_kind": "markdown"
      }
    },
    "influxdbv2_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Bucket creation date.",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Description of the bucket.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Bucket name.",
            "description_kind": "markdown",
            "required": true
          },
          "org_id": {
            "type": "string",
            "description": "ID of organization in which to create a bucket.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Bucket type.",
            "description_kind": "markdown",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "Last bucket update date.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "retention_rules": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "every_seconds": {
                  "type": "number",
                  "description": "Duration in seconds for how long data will be kept in the database. 0 means infinite.",
                  "description_kind": "markdown",
                  "required": true
                },
                "shard_group_duration_seconds": {
                  "type": "number",
                  "description": "Shard duration measured in seconds.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "description": "Rules to expire or retain data. No rules means data never expires.",
              "description_kind": "markdown"
            }
          }
        },
        "description": "InfluxDB Bucket resource",
        "description_kind": "markdown"
      }
    }
  },
