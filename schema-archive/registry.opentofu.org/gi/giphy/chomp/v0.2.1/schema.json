{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "chomp_left": {
      "version": 0,
      "block": {
        "attributes": {
          "found": {
            "type": "bool",
            "description": "Indicates whether a matching key was found. Useful when ignore_not_found_error is true.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ignore_not_found_error": {
            "type": "bool",
            "description": "If true, this provider will not error. Default is false.",
            "description_kind": "plain",
            "optional": true
          },
          "key": {
            "type": "string",
            "description": "Longest key found in src map matching the lookup key. If ignore_not_found_error is true, and no matching key is found, this will return an empty string.",
            "description_kind": "plain",
            "computed": true
          },
          "lookup": {
            "type": "string",
            "description": "Lookup longest matching key in src map.",
            "description_kind": "plain",
            "required": true
          },
          "separator": {
            "type": "string",
            "description": "Chomp source map using separator.",
            "description_kind": "plain",
            "required": true
          },
          "src": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map to search.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
