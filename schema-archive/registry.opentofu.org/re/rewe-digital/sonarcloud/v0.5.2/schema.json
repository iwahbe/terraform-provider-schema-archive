            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Quality Gate.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "This resource manages a Quality Gate",
        "description_kind": "plain"
      }
    },
