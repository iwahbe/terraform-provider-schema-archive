        "description": "This resource manages a project main branch.\n\nNote that certain operations, such as the deletion of a project's main branch configuration, may\nnot be permitted by the SonarCloud web API, or may require admin permissions.\n\t\t",
        "description_kind": "plain"
      }
    },
    "sonarcloud_quality_gate": {
      "version": 0,
      "block": {
        "attributes": {
          "conditions": {
            "nested_type": {
              "attributes": {
                "error": {
