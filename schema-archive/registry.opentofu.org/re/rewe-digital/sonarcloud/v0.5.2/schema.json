            "type": "number",
            "description": "Id computed by SonarCloud servers",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Implicit Terraform ID",
            "description_kind": "plain",
            "computed": true
          },
          "is_built_in": {
            "type": "bool",
