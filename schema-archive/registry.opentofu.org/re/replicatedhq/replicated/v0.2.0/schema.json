{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "Vendor API token",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "Vendor API endpoint",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "replicated_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "disk": {
            "type": "number",
            "description": "Disk Size (GiB) to request per node (default 50)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "distribution": {
            "type": "string",
            "description": "Kubernetes distribution of the cluster to provision",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "instance_type": {
            "type": "string",
            "description": "The type of instance to use (e.g. m6i.large)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "kubeconfig": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "Cluster name (defaults to random name)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "nodes": {
            "type": "number",
            "description": "Node count (default 1)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "ttl": {
            "type": "string",
            "description": "Cluster TTL (duration, max 48h)",
            "description_kind": "markdown",
            "optional": true
          },
          "version": {
            "type": "string",
            "description": "Kubernetes version to provision (format is distribution dependent)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "wait_duration": {
            "type": "string",
            "description": "How long to wait for the cluster to be ready",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Cluster resource",
        "description_kind": "markdown"
      }
    },
    "replicated_customer": {
      "version": 0,
      "block": {
        "attributes": {
          "app_id": {
            "type": "string",
            "description": "App to which the channel is associated",
            "description_kind": "markdown",
            "required": true
          },
          "channel_id": {
            "type": "string",
            "description": "Channel to which the customer license is associated",
            "description_kind": "markdown",
            "required": true
          },
          "email": {
            "type": "string",
            "description": "Email of the customer",
            "description_kind": "markdown",
            "optional": true
          },
          "entitlement_values": {
            "type": [
              "map",
              "string"
            ],
            "description": "Entitlement values of the customer",
            "description_kind": "markdown",
            "optional": true
          },
          "expires_at": {
            "type": "string",
            "description": "Expiration date of the customer license",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the customer",
            "description_kind": "markdown",
            "computed": true
          },
          "is_airgap_enabled": {
            "type": "bool",
            "description": "Is airgap enabled for the customer license",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_embedded_cluster_download_enabled": {
            "type": "bool",
            "description": "Is embedded cluster download enabled for the customer license",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_geoaxis_supported": {
            "type": "bool",
            "description": "Is geoaxis supported for the customer license",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_gitops_supported": {
            "type": "bool",
            "description": "Is gitops supported for the customer license",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_identity_service_supported": {
            "type": "bool",
            "description": "Is identity service supported for the customer license",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_installer_support_enabled": {
            "type": "bool",
            "description": "Is installer support enabled for the customer license",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_kots_install_enabled": {
            "type": "bool",
            "description": "Is kots install enabled for the customer license",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_snapshot_supported": {
            "type": "bool",
            "description": "Is snapshot supported for the customer license",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_support_bundle_upload_enabled": {
            "type": "bool",
            "description": "Is support bundle upload enabled for the customer license",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the customer",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of the customer",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Customer resource",
        "description_kind": "markdown"
      }
    }
  }
}
