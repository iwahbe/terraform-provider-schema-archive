{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "account_id": {
          "type": "string",
          "description": "The unique ID of the PHC Account to use this provider with. If not set explicitly in the provider block, `$LIFEOMIC_ACCOUNT` will be used.",
          "description_kind": "plain",
          "optional": true
        },
        "headers": {
          "type": [
            "map",
            "string"
          ],
          "description": "Additional headers that will be passed with any requests made. You can also use the LIFEOMIC_HEADERS environment variable as stringified JSON. Environment variables take precedent over other values",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "The PHC API host to communicate with.. If not set explicitly in the provider block, `$LIFEOMIC_HOST` will be used.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The token to use for authenticating with the PHC API. If not set explicitly in the provider block, `$LIFEOMIC_TOKEN` will be used.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "lifeomic_marketplace_wellness_offering": {
      "version": 0,
      "block": {
        "attributes": {
          "app_link": {
            "type": "string",
            "description": "Link to open the subsidy in-app",
            "description_kind": "plain",
            "optional": true
          },
          "approximate_unit_cost": {
            "type": "number",
            "description": "The approximate per unit cost of the module represented in USD Pennies",
            "description_kind": "plain",
            "required": true
          },
          "configuration_schema": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "The description of the Wellness Offering",
            "description_kind": "plain",
            "required": true
          },
          "icon_url": {
            "type": "string",
            "description": "Link to an icon representing the subsidy",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "An optional id for the Wellness Offering",
            "description_kind": "plain",
            "optional": true
          },
          "image_url": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "info_url": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "install_url": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "is_approved": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "is_enabled": {
            "type": "bool",
            "description_kind": "plain",
            "required": true
          },
          "is_test_module": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "marketplace_provider": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "parent_module_id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "price_range": {
            "type": [
              "object",
              {
                "high": "number",
                "low": "number"
              }
            ],
            "description": "Link to an icon representing the subsidy",
            "description_kind": "plain",
            "optional": true
          },
          "subsidy_type": {
            "type": "string",
            "description": "One of SERVICE | REDEMPTION | LIFE_LEAGUE_PARTNER | LIFE_LEAGUE_PARENT",
            "description_kind": "plain",
            "required": true
          },
          "title": {
            "type": "string",
            "description": "The title of the Wellness Offering",
            "description_kind": "plain",
            "required": true
          },
          "version": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "marketplace_wellness_offering manages Wellness Offering subsidies",
        "description_kind": "plain"
      }
    },
    "lifeomic_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of this ABAC policy resource.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The unique name of this ABAC policy.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "rule": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "allowed": {
                  "type": "bool",
                  "description": "A describing whether this operation is allowed. Must either be null or true.",
                  "description_kind": "plain",
                  "optional": true
                },
                "operation": {
                  "type": "string",
                  "description": "The [operation](https://phc.docs.lifeomic.com/development/abac-syntax#operations) this ABAC rule governs.Exactly one of `comparison` and `allowed` should be set.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "comparison": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "subject": {
                        "type": "string",
                        "description": "The subject is the [attribute](https://phc.docs.lifeomic.com/development/abac-syntax#attributes) used in this ABAC comparison.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "target": {
                        "type": "string",
                        "description": "The target to use in this ABAC comparison.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "type": {
                        "type": "string",
                        "description": "The [type](https://phc.docs.lifeomic.com/development/abac-syntax#supported-comparisons) of ABAC comparison.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value": {
                        "type": "string",
                        "description": "The value to use in this ABAC comparison.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "values": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "The values to use in this ABAC comparison.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description": "An ABAC comparison. Exactly one of `value`, `values`, or `target` should be set.",
                    "description_kind": "plain"
                  }
                }
              },
              "description": "An ABAC [rule](https://phc.docs.lifeomic.com/development/abac-syntax#rules) containing comparisons to be evaluated for the given operation.",
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description": "`lifeomic_policy` manages an [Attribute Based Access Control (ABAC) policy](https://phc.docs.lifeomic.com/user-guides/access-control#privileges-and-permissions).",
        "description_kind": "plain"
      }
    }
  }
}
