{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "insecure": {
          "type": "bool",
          "description": "By default, every TLS connection should be verified to be secure, this option allows to proceed and operate even for connections considered insecure",
          "description_kind": "markdown",
          "optional": true
        },
        "otp": {
          "type": "string",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "password": {
          "type": "string",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "pve_vm": {
      "version": 0,
      "block": {
        "attributes": {
          "cores": {
            "type": "number",
            "description": "Number of cpu core.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ipv4_address": {
            "type": "string",
            "description": "IPv4 Address of this vm.",
            "description_kind": "markdown",
            "computed": true
          },
          "memory": {
            "type": "number",
            "description": "Memory size in Megabyte",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "VM name.",
            "description_kind": "markdown",
            "required": true
          },
          "onboot": {
            "type": "bool",
            "description": "Specifies whether a VM will be started during system bootup.",
            "description_kind": "markdown",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "Desired VM status",
            "description_kind": "markdown",
            "optional": true
          },
          "target_node": {
            "type": "string",
            "description": "Node where this vm sit.",
            "description_kind": "markdown",
            "required": true
          },
          "target_storage": {
            "type": "string",
            "description": "Storage where this vm sit.",
            "description_kind": "markdown",
            "required": true
          },
          "template_name": {
            "type": "string",
            "description": "VM template.",
            "description_kind": "markdown",
            "required": true
          },
          "user_data": {
            "type": "string",
            "description": "cloud-init user data. Use this to provision vm, including ssh public key or password setup. Learn more https://cloudinit.readthedocs.io/en/latest/topics/format.html",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "disk": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "size": {
                  "type": "number",
                  "description": "Size in GB",
                  "description_kind": "markdown",
                  "required": true
                },
                "storage": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Attach extra disk into VM",
              "description_kind": "markdown"
            }
          }
        },
        "description": "VM",
        "description_kind": "markdown"
      }
    }
  }
}
