{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "kubernetes": {
          "nested_type": {
            "attributes": {
              "client_certificate": {
                "type": "string",
                "description": "PEM-encoded client certificate for TLS authentication.",
                "description_kind": "plain",
                "optional": true
              },
              "client_key": {
                "type": "string",
                "description": "PEM-encoded client certificate key for TLS authentication.",
                "description_kind": "plain",
                "optional": true,
                "sensitive": true
              },
              "cluster_ca_certificate": {
                "type": "string",
                "description": "PEM-encoded root certificates bundle for TLS authentication.",
                "description_kind": "plain",
                "optional": true
              },
              "config_context": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "config_context_auth_info": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "config_context_cluster": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "config_path": {
                "type": "string",
                "description": "Path to the kube config file. Can be set with KubeConfigPath.",
                "description_kind": "plain",
                "optional": true
              },
              "config_paths": {
                "type": [
                  "list",
                  "string"
                ],
                "description_kind": "plain",
                "optional": true
              },
              "exec": {
                "nested_type": {
                  "attributes": {
                    "api_version": {
                      "type": "string",
                      "description_kind": "plain",
                      "required": true
                    },
                    "args": {
                      "type": [
                        "list",
                        "string"
                      ],
                      "description_kind": "plain",
                      "optional": true
                    },
                    "command": {
                      "type": "string",
                      "description_kind": "plain",
                      "required": true
                    },
                    "env": {
                      "type": [
                        "map",
                        "string"
                      ],
                      "description_kind": "plain",
                      "optional": true
                    }
                  },
                  "nesting_mode": "single"
                },
                "description_kind": "plain",
                "optional": true
              },
              "host": {
                "type": "string",
                "description": "The hostname (in form of URI) of Kubernetes master.",
                "description_kind": "plain",
                "optional": true
              },
              "insecure": {
                "type": "bool",
                "description": "Whether server should be accessed without verifying the TLS certificate.",
                "description_kind": "plain",
                "optional": true
              },
              "password": {
                "type": "string",
                "description": "The password to use for HTTP basic authentication when accessing the Kubernetes master endpoint.",
                "description_kind": "plain",
                "optional": true,
                "sensitive": true
              },
              "proxy_url": {
                "type": "string",
                "description": "URL to the proxy to be used for all API requests",
                "description_kind": "plain",
                "optional": true
              },
              "token": {
                "type": "string",
                "description": "Token to authenticate an service account",
                "description_kind": "plain",
                "optional": true,
                "sensitive": true
              },
              "username": {
                "type": "string",
                "description": "The username to use for HTTP basic authentication when accessing the Kubernetes master endpoint.",
                "description_kind": "plain",
                "optional": true
              }
            },
            "nesting_mode": "single"
          },
          "description_kind": "plain",
          "optional": true
        },
        "liqo_version": {
          "type": "string",
          "description": "The version of Liqo to use for downloading liqoctl binary. Defaults to v1.0.1.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with Liqo.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "liqo_offload": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_selector_terms": {
            "nested_type": {
              "attributes": {
                "match_expressions": {
                  "nested_type": {
                    "attributes": {
                      "key": {
                        "type": "string",
                        "description": " The label key that the selector applies to.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "operator": {
                        "type": "string",
                        "description": "Represents a key's relationship to a set of values.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "values": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "An array of string values.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "A list of cluster selector.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Selectors to restrict the set of remote clusters.",
            "description_kind": "plain",
            "optional": true
          },
          "namespace": {
            "type": "string",
            "description": "Offload a namespace.",
            "description_kind": "plain",
            "required": true
          },
          "namespace_mapping_strategy": {
            "type": "string",
            "description": "Naming strategy used to create the remote namespace.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "pod_offloading_strategy": {
            "type": "string",
            "description": "Namespace to offload.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Offload a namespace.",
        "description_kind": "plain"
      }
    },
    "liqo_peer": {
      "version": 0,
      "block": {
        "attributes": {
          "cpu": {
            "type": "string",
            "description": "The amount of CPU requested for the VirtualNode.",
            "description_kind": "plain",
            "optional": true
          },
          "create_resource_slice": {
            "type": "bool",
            "description": "Create a ResourceSlice for the peering.",
            "description_kind": "plain",
            "optional": true
          },
          "create_virtual_node": {
            "type": "bool",
            "description": "Create a VirtualNode for the peering.",
            "description_kind": "plain",
            "optional": true
          },
          "gw_client_address": {
            "type": "string",
            "description": "Address used by the gateway client to connect to the gateway server.",
            "description_kind": "plain",
            "optional": true
          },
          "gw_client_port": {
            "type": "number",
            "description": "Port used by the gateway client to connect to the gateway server.",
            "description_kind": "plain",
            "optional": true
          },
          "gw_server_service_loadbalancer_ip": {
            "type": "string",
            "description": "IP of the LoadBalancer for the Gateway Server service.",
            "description_kind": "plain",
            "optional": true
          },
          "gw_server_service_nodeport": {
            "type": "number",
            "description": "Force the NodePort of the Gateway Server service.",
            "description_kind": "plain",
            "optional": true
          },
          "gw_server_service_port": {
            "type": "number",
            "description": "Port of the Gateway Server service.",
            "description_kind": "plain",
            "optional": true
          },
          "gw_server_service_type": {
            "type": "string",
            "description": "Service type of the Gateway Server service (LoadBalancer, NodePort, ClusterIP).",
            "description_kind": "plain",
            "optional": true
          },
          "in_band": {
            "type": "bool",
            "description": "Use in-band authentication.",
            "description_kind": "plain",
            "optional": true
          },
          "liqo_namespace": {
            "type": "string",
            "description": "Namespace where Liqo is installed in local cluster.",
            "description_kind": "plain",
            "optional": true
          },
          "memory": {
            "type": "string",
            "description": "The amount of memory requested for the VirtualNode.",
            "description_kind": "plain",
            "optional": true
          },
          "mtu": {
            "type": "number",
            "description": "MTU of the Gateway server and client.",
            "description_kind": "plain",
            "optional": true
          },
          "networking_disabled": {
            "type": "bool",
            "description": "Disable networking between the two clusters.",
            "description_kind": "plain",
            "optional": true
          },
          "peer_status": {
            "type": "string",
            "description": "Status of the peering operation.",
            "description_kind": "plain",
            "computed": true
          },
          "pods": {
            "type": "string",
            "description": "The amount of pods requested for the VirtualNode.",
            "description_kind": "plain",
            "optional": true
          },
          "proxy_url": {
            "type": "string",
            "description": "The URL of the proxy to use for communication with the remote cluster.",
            "description_kind": "plain",
            "optional": true
          },
          "remote_kubeconfig": {
            "type": "string",
            "description": "Path to the remote (provider) cluster kubeconfig file.",
            "description_kind": "plain",
            "required": true
          },
          "remote_liqo_namespace": {
            "type": "string",
            "description": "Namespace where Liqo is installed in remote cluster.",
            "description_kind": "plain",
            "optional": true
          },
          "resource_slice_class": {
            "type": "string",
            "description": "The class of the ResourceSlice.",
            "description_kind": "plain",
            "optional": true
          },
          "skip_validation": {
            "type": "bool",
            "description": "Skip the validation.",
            "description_kind": "plain",
            "optional": true
          },
          "timeout": {
            "type": "string",
            "description": "Timeout for peering completion (e.g., '10m').",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Enable peering towards a remote provider cluster using liqoctl.",
        "description_kind": "plain"
      }
    }
  }
}
