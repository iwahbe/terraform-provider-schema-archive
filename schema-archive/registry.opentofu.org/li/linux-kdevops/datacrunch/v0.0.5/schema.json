{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "bearer": {
          "type": "string",
          "description": "OAuth2 access token (use this OR client_id/client_secret)",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "client_id": {
          "type": "string",
          "description": "OAuth2 client ID (use with client_secret)",
          "description_kind": "markdown",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "OAuth2 client secret (use with client_id)",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "server_url": {
          "type": "string",
          "description": "Server URL (defaults to https://api.datacrunch.io/v1)",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "DataCrunch Provider: Public API for datacrunch platform",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "datacrunch_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Instance creation timestamp",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Instance description",
            "description_kind": "markdown",
            "required": true
          },
          "hostname": {
            "type": "string",
            "description": "Instance hostname",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Instance ID",
            "description_kind": "markdown",
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "Operating system image type",
            "description_kind": "markdown",
            "required": true
          },
          "instance_type": {
            "type": "string",
            "description": "Instance type (e.g., 1H100.80S.30V)",
            "description_kind": "markdown",
            "required": true
          },
          "ip": {
            "type": "string",
            "description": "Instance IP address",
            "description_kind": "markdown",
            "computed": true
          },
          "location_code": {
            "type": "string",
            "description": "Datacenter location code",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "os_volume_id": {
            "type": "string",
            "description": "OS volume ID for the instance",
            "description_kind": "markdown",
            "computed": true
          },
          "price_per_hour": {
            "type": "number",
            "description": "Instance hourly price",
            "description_kind": "markdown",
            "computed": true
          },
          "ssh_key_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of SSH key IDs",
            "description_kind": "markdown",
            "required": true
          },
          "startup_script_id": {
            "type": "string",
            "description": "Startup script ID",
            "description_kind": "markdown",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "Instance status",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "DataCrunch instance resource",
        "description_kind": "markdown"
      }
    },
    "datacrunch_ssh_key": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "SSH key ID",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "SSH key name",
            "description_kind": "markdown",
            "required": true
          },
          "public_key": {
            "type": "string",
            "description": "SSH public key content",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "DataCrunch SSH key resource",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "datacrunch_images": {
      "version": 0,
      "block": {
        "attributes": {
          "images": {
            "nested_type": {
              "attributes": {
                "category": {
                  "type": "string",
                  "description": "Image category",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Image ID",
                  "description_kind": "markdown",
                  "computed": true
                },
                "image_type": {
                  "type": "string",
                  "description": "Image type identifier",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Image name",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of available OS images",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "DataCrunch images data source",
        "description_kind": "markdown"
      }
    },
    "datacrunch_instance_types": {
      "version": 0,
      "block": {
        "attributes": {
          "instance_types": {
            "nested_type": {
              "attributes": {
                "cpu": {
                  "type": "string",
                  "description": "CPU specification",
                  "description_kind": "markdown",
                  "computed": true
                },
                "description": {
                  "type": "string",
                  "description": "Instance type description",
                  "description_kind": "markdown",
                  "computed": true
                },
                "gpu": {
                  "type": "string",
                  "description": "GPU specification",
                  "description_kind": "markdown",
                  "computed": true
                },
                "instance_type": {
                  "type": "string",
                  "description": "Instance type identifier",
                  "description_kind": "markdown",
                  "computed": true
                },
                "memory": {
                  "type": "number",
                  "description": "Memory in GB",
                  "description_kind": "markdown",
                  "computed": true
                },
                "price_per_hour": {
                  "type": "number",
                  "description": "Price per hour in USD",
                  "description_kind": "markdown",
                  "computed": true
                },
                "storage": {
                  "type": "number",
                  "description": "Storage in GB",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of available instance types",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "DataCrunch instance types data source",
        "description_kind": "markdown"
      }
    },
    "datacrunch_locations": {
      "version": 0,
      "block": {
        "attributes": {
          "locations": {
            "nested_type": {
              "attributes": {
                "code": {
                  "type": "string",
                  "description": "Location code",
                  "description_kind": "markdown",
                  "computed": true
                },
                "country": {
                  "type": "string",
                  "description": "Country",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Location name",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of available datacenter locations",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "DataCrunch datacenter locations data source",
        "description_kind": "markdown"
      }
    }
  }
}
