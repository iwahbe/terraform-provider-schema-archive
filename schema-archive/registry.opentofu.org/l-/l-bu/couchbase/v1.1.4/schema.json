{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "address": {
          "type": "string",
          "description": "Couchbase address (without scheme)",
          "description_kind": "plain",
          "optional": true
        },
        "allow_sasl_mechanism": {
          "type": "string",
          "description": "Allowed Sasl Mechanism (separate values with commas \",\")\nAllowed values:\nPLAIN\nSCRAM-SHA1\nSCRAM-SHA256\nSCRAM-SHA512\n",
          "description_kind": "plain",
          "optional": true
        },
        "client_port": {
          "type": "number",
          "description": "Couchbase port: client-to-node (use for api calls usually http 8091 or https 18091)",
          "description_kind": "plain",
          "optional": true
        },
        "management_timeout": {
          "type": "number",
          "description": "Couchbase connection timeout",
          "description_kind": "plain",
          "optional": true
        },
        "node_port": {
          "type": "number",
          "description": "Couchbase port: node-to-node (usually for scheme couchbase 11210 or couchbases 112107)",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Couchbase password",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "tls_root_cert": {
          "type": "string",
          "description": "Path to TLS Root Certificate (in PEM format)",
          "description_kind": "plain",
          "optional": true
        },
        "tls_root_cert_skip_verify": {
          "type": "bool",
          "description": "TLS root certificate skip verify",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Couchbase username",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "couchbase_bucket_collection": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "Bucket name",
            "description_kind": "plain",
            "required": true
          },
          "history": {
            "type": "bool",
            "description": "Collection history enable/disable. Bucket must have \"magma\" storage mode",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "max_expire": {
            "type": "number",
            "description": "Max expiry in seconds",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Collection name",
            "description_kind": "plain",
            "required": true
          },
          "scope": {
            "type": "string",
            "description": "Scope name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage collections in couchbase",
        "description_kind": "plain"
      }
    },
    "couchbase_bucket_manager": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket_type": {
            "type": "string",
            "description": "Bucket type:\nmemcached\nephemeral\nmembase\n",
            "description_kind": "plain",
            "optional": true
          },
          "compression_mode": {
            "type": "string",
            "description": "Compression mode:\noff\nactive\npassive\n",
            "description_kind": "plain",
            "optional": true
          },
          "conflict_resolution_type": {
            "type": "string",
            "description": "Conflict resolution type:\nseqno\nlww\n",
            "description_kind": "plain",
            "optional": true
          },
          "durability_level": {
            "type": "number",
            "description": "Durability level:\n1\n2\n3\n4\n",
            "description_kind": "plain",
            "optional": true
          },
          "eviction_policy_type": {
            "type": "string",
            "description": "Eviction policy type:\nfullEviction\nvalueOnly\nnruEviction\nnoEviction\n",
            "description_kind": "plain",
            "optional": true
          },
          "flush_enabled": {
            "type": "bool",
            "description": "Bucket flush enable/disable",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "max_expire": {
            "type": "number",
            "description": "Max expiry in seconds",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Bucket name",
            "description_kind": "plain",
            "required": true
          },
          "num_replicas": {
            "type": "number",
            "description": "Number of bucket replicas",
            "description_kind": "plain",
            "optional": true
          },
          "ram_quota_mb": {
            "type": "number",
            "description": "Ram quota for bucket",
            "description_kind": "plain",
            "required": true
          },
          "replica_index_disable": {
            "type": "bool",
            "description": "Bucket index replicas",
            "description_kind": "plain",
            "optional": true
          },
          "storage_backend": {
            "type": "string",
            "description": "Storage Backend:\ncouchstore\nmagma\n",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage buckets in couchbase",
        "description_kind": "plain"
      }
    },
    "couchbase_bucket_scope": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "Bucket name",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Scope name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage scopes in couchbase",
        "description_kind": "plain"
      }
    },
    "couchbase_primary_query_index": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "Primary query index bucket name",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Primary query index name",
            "description_kind": "plain",
            "required": true
          },
          "num_replica": {
            "type": "number",
            "description": "Primary query index number of replica",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage primary query indexes in couchbase",
        "description_kind": "plain"
      }
    },
    "couchbase_query_index": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "Query index bucket name",
            "description_kind": "plain",
            "required": true
          },
          "condition": {
            "type": "string",
            "description": "Query index where statement",
            "description_kind": "plain",
            "optional": true
          },
          "fields": {
            "type": [
              "list",
              "string"
            ],
            "description": "Query index fields",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Query index name",
            "description_kind": "plain",
            "required": true
          },
          "num_replica": {
            "type": "number",
            "description": "Query index number of replica",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage query indexes in couchbase",
        "description_kind": "plain"
      }
    },
    "couchbase_security_group": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Group description",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ldap_reference": {
            "type": "string",
            "description": "Group ldap reference",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Group name",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "role": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "bucket": {
                  "type": "string",
                  "description": "Bucket name",
                  "description_kind": "plain",
                  "required": true
                },
                "collection": {
                  "type": "string",
                  "description": "Collection within a scope",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Role name",
                  "description_kind": "plain",
                  "required": true
                },
                "scope": {
                  "type": "string",
                  "description": "Scope within a bucket",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Group role",
              "description_kind": "plain"
            }
          }
        },
        "description": "Manage groups in couchbase",
        "description_kind": "plain"
      }
    },
    "couchbase_security_user": {
      "version": 0,
      "block": {
        "attributes": {
          "display_name": {
            "type": "string",
            "description": "Full username",
            "description_kind": "plain",
            "optional": true
          },
          "groups": {
            "type": [
              "list",
              "string"
            ],
            "description": "Assigned groups",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "Password",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "username": {
            "type": "string",
            "description": "Username",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "role": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "bucket": {
                  "type": "string",
                  "description": "Bucket name",
                  "description_kind": "plain",
                  "required": true
                },
                "collection": {
                  "type": "string",
                  "description": "Collection within a scope",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Role name",
                  "description_kind": "plain",
                  "required": true
                },
                "scope": {
                  "type": "string",
                  "description": "Scope within a bucket",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "User role",
              "description_kind": "plain"
            }
          }
        },
        "description": "Manage users in couchbase",
        "description_kind": "plain"
      }
    }
  }
}
