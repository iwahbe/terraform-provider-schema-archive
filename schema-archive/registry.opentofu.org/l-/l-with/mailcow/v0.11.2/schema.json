{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The mailcow API key, can optionally be passed as `MAILCOW_API_KEY` environmental variable",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "host_name": {
          "type": "string",
          "description": "The name of the mailcow host, can optionally be passed as `MAILCOW_HOST_NAME` environmental variable",
          "description_kind": "plain",
          "required": true
        },
        "insecure": {
          "type": "bool",
          "description": "Whether to skip TLS verification, can optionally be passed as `MAILCOW_INSECURE` environmental variable",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "mailcow_alias": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "is alias active or not",
            "description_kind": "plain",
            "optional": true
          },
          "address": {
            "type": "string",
            "description": "alias address, for catchall use \"@domain.tld\"",
            "description_kind": "plain",
            "required": true
          },
          "goto": {
            "type": "string",
            "description": "destination address, comma separated. Special values are \"ham@localhost\", \"spam@localhost\" and \"null@localhost\".",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "private_comment": {
            "type": "string",
            "description": "private comment",
            "description_kind": "plain",
            "optional": true
          },
          "public_comment": {
            "type": "string",
            "description": "public comment",
            "description_kind": "plain",
            "optional": true
          },
          "sogo_visible": {
            "type": "bool",
            "description": "visibility as selectable sender in SOGo",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mailcow_dkim": {
      "version": 0,
      "block": {
        "attributes": {
          "dkim_selector": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "dkim_txt": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "length": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          },
          "pubkey": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mailcow_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "is domain active or not",
            "description_kind": "plain",
            "optional": true
          },
          "aliases": {
            "type": "number",
            "description": "limit count of aliases associated with this domain",
            "description_kind": "plain",
            "optional": true
          },
          "backupmx": {
            "type": "bool",
            "description": "relay domain or not",
            "description_kind": "plain",
            "optional": true
          },
          "defquota": {
            "type": "number",
            "description": "predefined mailbox quota in add mailbox form",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Description of domain",
            "description_kind": "plain",
            "optional": true
          },
          "domain": {
            "type": "string",
            "description": "Fully qualified domain name",
            "description_kind": "plain",
            "required": true
          },
          "gal": {
            "type": "bool",
            "description": "is domain global address list active or not, it enables shared contacts accross domain in SOGo webmail",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "mailboxes": {
            "type": "number",
            "description": "limit count of mailboxes associated with this domain",
            "description_kind": "plain",
            "optional": true
          },
          "maxquota": {
            "type": "number",
            "description": "maximum quota per mailbox",
            "description_kind": "plain",
            "optional": true
          },
          "quota": {
            "type": "number",
            "description": "maximum quota for this domain (for all mailboxes in sum)",
            "description_kind": "plain",
            "optional": true
          },
          "rate_limit": {
            "type": "string",
            "description": "rate limit, decimal with unit s,m,h,d",
            "description_kind": "plain",
            "optional": true
          },
          "relay_all_recipients": {
            "type": "bool",
            "description": "if not, them you have to create \"dummy\" mailbox for each address to relay",
            "description_kind": "plain",
            "optional": true
          },
          "relay_unknown_only": {
            "type": "bool",
            "description": "Relay non-existing mailboxes only. Existing mailboxes will be delivered locally.",
            "description_kind": "plain",
            "optional": true
          },
          "restart_sogo": {
            "type": "bool",
            "description": "if the SOGo container should be restarted after adding the domain",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mailcow_domain_alias": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "is domain alias active or not",
            "description_kind": "plain",
            "optional": true
          },
          "alias_domain": {
            "type": "string",
            "description": "Alias domain name",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "target_domain": {
            "type": "string",
            "description": "Target domain name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mailcow_identity_provider_keycloak": {
      "version": 0,
      "block": {
        "attributes": {
          "authsource": {
            "type": "string",
            "description": "must be 'keycloak'",
            "description_kind": "plain",
            "optional": true
          },
          "client_id": {
            "type": "string",
            "description": "the Client ID assigned to mailcow Client in Keycloak",
            "description_kind": "plain",
            "required": true
          },
          "client_secret": {
            "type": "string",
            "description": "the Client Secret assigned to the mailcow client in Keycloak",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ignore_ssl_error": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "import_users": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "mailpassword_flow": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "periodic_sync": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "realm": {
            "type": "string",
            "description": "the Keycloak realm where the mailcow client is configured",
            "description_kind": "plain",
            "required": true
          },
          "redirect_url": {
            "type": "string",
            "description": "the redirect URL that Keycloak will use after authentication. This should point to your mailcow UI. Example: https://mail.mailcow.tld",
            "description_kind": "plain",
            "required": true
          },
          "server_url": {
            "type": "string",
            "description": "the base URL of the Keycloak server",
            "description_kind": "plain",
            "required": true
          },
          "sync_interval": {
            "type": "number",
            "description_kind": "plain",
            "optional": true
          },
          "version": {
            "type": "string",
            "description": "specifies the Keycloak version (cite from blog 'It is essential to know whether a version greater or smaller than 20 is used since mailcow needs to add the '\u201copenid'\u201d scope accordingly.')",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mailcow_mailbox": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "is alias active or not",
            "description_kind": "plain",
            "optional": true
          },
          "address": {
            "type": "string",
            "description": "e-mail address",
            "description_kind": "plain",
            "computed": true
          },
          "authsource": {
            "type": "string",
            "description": "Authentication source to use. One of: generic-oidc, mailcow, keycloak, ldap.",
            "description_kind": "plain",
            "optional": true
          },
          "domain": {
            "type": "string",
            "description": "domain name",
            "description_kind": "plain",
            "required": true
          },
          "force_pw_update": {
            "type": "bool",
            "description": "forces the user to update its password on first login",
            "description_kind": "plain",
            "optional": true
          },
          "full_name": {
            "type": "string",
            "description": "Full name of the mailbox user",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "imap_access": {
            "type": "bool",
            "description": "if 'IMAP' is an allowed protocol",
            "description_kind": "plain",
            "optional": true
          },
          "local_part": {
            "type": "string",
            "description": "left part of email address",
            "description_kind": "plain",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "mailbox password (the password is excluded from update)",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "pop3_access": {
            "type": "bool",
            "description": "if 'POP3' is an allowed protocol",
            "description_kind": "plain",
            "optional": true
          },
          "quota": {
            "type": "number",
            "description": "mailbox quota",
            "description_kind": "plain",
            "optional": true
          },
          "sieve_access": {
            "type": "bool",
            "description": "if 'Sieve' is an allowed protocol",
            "description_kind": "plain",
            "optional": true
          },
          "smtp_access": {
            "type": "bool",
            "description": "if 'SMTP' is an allowed protocol",
            "description_kind": "plain",
            "optional": true
          },
          "sogo_access": {
            "type": "bool",
            "description": "if direct login access to SOGo is granted",
            "description_kind": "plain",
            "optional": true
          },
          "tls_enforce_in": {
            "type": "bool",
            "description": "force inbound email tls encryption",
            "description_kind": "plain",
            "optional": true
          },
          "tls_enforce_out": {
            "type": "bool",
            "description": "force outbound mail tls encryption",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "mailcow_oauth2_client": {
      "version": 0,
      "block": {
        "attributes": {
          "client_id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "client_secret": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "redirect_uri": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "scope": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
