{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "k3s_version": {
          "type": "string",
          "description": "K3s version to select, if not selected will default to latest",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "K3s Terraform Provider\nUse with your favorite cloud provider, openstack or baremetal. Makes no assumptions about the target backend.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "k3s_agent": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "The health of the server",
            "description_kind": "markdown",
            "computed": true
          },
          "allow_delete_err": {
            "type": "bool",
            "description": "If this is true, deleting the node using kubectl first will be allowed to error not stopping the k3s uninstall process",
            "description_kind": "markdown",
            "optional": true
          },
          "auth": {
            "nested_type": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "Hostname of the target server",
                  "description_kind": "markdown",
                  "optional": true
                },
                "password": {
                  "type": "string",
                  "description": "Username of the target server",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "port": {
                  "type": "number",
                  "description": "Override default SSH port (22)",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "private_key": {
                  "type": "string",
                  "description": "Private ssh key value to be used in place of a password",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "user": {
                  "type": "string",
                  "description": "Username of the target server",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Auth configuration for the node",
            "description_kind": "plain",
            "required": true
          },
          "bin_dir": {
            "type": "string",
            "description": "Value of a path used to put the k3s binary",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "config": {
            "type": "string",
            "description": "K3s server config",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Id of the k3s server resource",
            "description_kind": "markdown",
            "computed": true
          },
          "kubeconfig": {
            "type": "string",
            "description": "KubeConfig for the cluster, needed so agent node can clean itself up",
            "description_kind": "markdown",
            "required": true
          },
          "registry": {
            "type": "string",
            "description": "K3s agent registry",
            "description_kind": "markdown",
            "optional": true
          },
          "server": {
            "type": "string",
            "description": "Hostname for k3s api server",
            "description_kind": "markdown",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "Server token used for joining nodes to the cluster",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Creates a k3s agent resource. Only one of `password` or `private_key` can be passed. Requires a token and server address to a k3s_server resource",
        "description_kind": "markdown"
      }
    },
    "k3s_server": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "The health of the server",
            "description_kind": "markdown",
            "computed": true
          },
          "auth": {
            "nested_type": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "Hostname of the target server",
                  "description_kind": "markdown",
                  "optional": true
                },
                "password": {
                  "type": "string",
                  "description": "Username of the target server",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "port": {
                  "type": "number",
                  "description": "Override default SSH port (22)",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "private_key": {
                  "type": "string",
                  "description": "Private ssh key value to be used in place of a password",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "user": {
                  "type": "string",
                  "description": "Username of the target server",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Auth configuration for the node",
            "description_kind": "plain",
            "required": true
          },
          "bin_dir": {
            "type": "string",
            "description": "Value of a path used to put the k3s binary",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "cluster_auth": {
            "nested_type": {
              "attributes": {
                "certificate_authority_data": {
                  "type": "string",
                  "description": "Client CA, already base64 decoded",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "client_certificate_data": {
                  "type": "string",
                  "description": "Client user certificate, already base64 decoded",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "client_key_data": {
                  "type": "string",
                  "description": "Client user key, already base64 decoded",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "server": {
                  "type": "string",
                  "description": "Apiserver address",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Cluster auth objects",
            "description_kind": "plain",
            "computed": true
          },
          "config": {
            "type": "string",
            "description": "K3s server config",
            "description_kind": "markdown",
            "optional": true
          },
          "highly_available": {
            "nested_type": {
              "attributes": {
                "cluster_init": {
                  "type": "bool",
                  "description": "Node is the init node for the HA cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "server": {
                  "type": "string",
                  "description": "Url of init node",
                  "description_kind": "markdown",
                  "optional": true
                },
                "token": {
                  "type": "string",
                  "description": "Server token used for joining nodes to the cluster",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Run server node in highly available mode",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Id of the k3s server resource",
            "description_kind": "markdown",
            "computed": true
          },
          "kubeconfig": {
            "type": "string",
            "description": "KubeConfig for the cluster",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "oidc": {
            "nested_type": {
              "attributes": {
                "audience": {
                  "type": "string",
                  "description": "OIDC Audience",
                  "description_kind": "markdown",
                  "required": true,
                  "sensitive": true
                },
                "issuer": {
                  "type": "string",
                  "description": "Issuer url",
                  "description_kind": "markdown",
                  "required": true,
                  "sensitive": true
                },
                "jwks_keys": {
                  "type": "string",
                  "description": "JSON web key set generated by the cluster following API server configuration",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "pkcs8": {
                  "type": "string",
                  "description": "Public signing key",
                  "description_kind": "markdown",
                  "required": true,
                  "sensitive": true
                },
                "signing_key": {
                  "type": "string",
                  "description": "Private signing key",
                  "description_kind": "markdown",
                  "required": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Support for including oidc provider in k3s",
            "description_kind": "plain",
            "optional": true
          },
          "registry": {
            "type": "string",
            "description": "K3s server registry",
            "description_kind": "markdown",
            "optional": true
          },
          "server": {
            "type": "string",
            "description": "Server url  used for joining nodes to the cluster.",
            "description_kind": "markdown",
            "computed": true
          },
          "token": {
            "type": "string",
            "description": "Server token used for joining nodes to the cluster",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Creates a k3s server resource. Only one of `password` or `private_key` can be passed.\nIf ran in highly available mode, it is up to the consumers of this module to correctly implement the raft protocol and create an odd number of ha nodes. Due to how HA works, we do not offer a method to gracefully delete a controller node from the cluster before running `k3s-uninstall.sh` during deletion of this resource.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "k3s_kubeconfig": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_empty": {
            "type": "bool",
            "description": "If this is true, it will allow a missing kubeconfig and set null to all outputs",
            "description_kind": "markdown",
            "optional": true
          },
          "auth": {
            "nested_type": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description": "Hostname of the target server",
                  "description_kind": "markdown",
                  "optional": true
                },
                "password": {
                  "type": "string",
                  "description": "Username of the target server",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "port": {
                  "type": "number",
                  "description": "Override default SSH port (22)",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "private_key": {
                  "type": "string",
                  "description": "Private ssh key value to be used in place of a password",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "user": {
                  "type": "string",
                  "description": "Username of the target server",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Auth configuration for the node",
            "description_kind": "plain",
            "required": true
          },
          "cluster_auth": {
            "nested_type": {
              "attributes": {
                "certificate_authority_data": {
                  "type": "string",
                  "description": "Client CA, already base64 decoded",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "client_certificate_data": {
                  "type": "string",
                  "description": "Client user certificate, already base64 decoded",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "client_key_data": {
                  "type": "string",
                  "description": "Client user key, already base64 decoded",
                  "description_kind": "markdown",
                  "computed": true,
                  "sensitive": true
                },
                "server": {
                  "type": "string",
                  "description": "Apiserver address",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Cluster auth objects",
            "description_kind": "plain",
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description": "Override the api server's hostname",
            "description_kind": "markdown",
            "optional": true
          },
          "kubeconfig": {
            "type": "string",
            "description": "Output of the kubeconfig from a k3s_server resource",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "A utility for reading and manipulating kubeconfig. Common use case would be to nicely extract the auth credentials or overridding the server url for a load balancer url or dns name.",
        "description_kind": "markdown"
      }
    }
  }
}
