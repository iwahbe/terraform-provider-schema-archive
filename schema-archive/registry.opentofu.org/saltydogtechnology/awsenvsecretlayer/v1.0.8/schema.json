{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "profile": {
          "type": "string",
          "description": "The profile name as set in the shared credentials file for the provider.",
          "description_kind": "plain",
          "optional": true
        },
        "region": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "awsenvsecretlayer_lambda": {
      "version": 1,
      "block": {
        "attributes": {
          "compatible_runtimes": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "envs_map": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "file_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ignore_local_output_changes": {
            "type": "bool",
            "description": "If true, changes to local_output_file_path and local_output_file_name will not trigger resource updates or be tracked in state",
            "description_kind": "plain",
            "optional": true
          },
          "layer_id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "layer_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "license_files": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "local_output_file_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "local_output_file_path": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "need_update": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "secrets_arns": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "skip_destroy": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "stored_secrets_hash": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "track_actual_secrets": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "validate_env_entries": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "yaml_config": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
