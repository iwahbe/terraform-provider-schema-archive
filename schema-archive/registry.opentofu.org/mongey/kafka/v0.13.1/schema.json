{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "bootstrap_servers": {
          "type": [
            "list",
            "string"
          ],
          "description": "A list of kafka brokers",
          "description_kind": "plain",
          "required": true
        },
        "ca_cert": {
          "type": "string",
          "description": "CA certificate file to validate the server's certificate.",
          "description_kind": "plain",
          "optional": true
        },
        "ca_cert_file": {
          "type": "string",
          "description": "Path to a CA certificate file to validate the server's certificate.",
          "description_kind": "plain",
          "deprecated": true,
          "optional": true
        },
        "client_cert": {
          "type": "string",
          "description": "The client certificate.",
          "description_kind": "plain",
          "optional": true
        },
        "client_cert_file": {
          "type": "string",
          "description": "Path to a file containing the client certificate.",
          "description_kind": "plain",
          "deprecated": true,
          "optional": true
        },
        "client_key": {
          "type": "string",
          "description": "The private key that the certificate was issued for.",
          "description_kind": "plain",
          "optional": true
        },
        "client_key_file": {
          "type": "string",
          "description": "Path to a file containing the private key that the certificate was issued for.",
          "description_kind": "plain",
          "deprecated": true,
          "optional": true
        },
        "client_key_passphrase": {
          "type": "string",
          "description": "The passphrase for the private key that the certificate was issued for.",
          "description_kind": "plain",
          "optional": true
        },
        "kafka_version": {
          "type": "string",
          "description": "The version of Kafka protocol to use in `$MAJOR.$MINOR.$PATCH` format. Some features may not be available on older versions. Default is 2.7.0.",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_access_key": {
          "type": "string",
          "description": "The AWS access key.",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_container_authorization_token_file": {
          "type": "string",
          "description": "Path to a file containing the AWS pod identity authorization token",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_container_credentials_full_uri": {
          "type": "string",
          "description": "URI to retrieve AWS credentials from",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_creds_debug": {
          "type": "bool",
          "description": "Set this to true to turn AWS credentials debug.",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_external_id": {
          "type": "string",
          "description": "External ID of the AWS IAM role to assume",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_profile": {
          "type": "string",
          "description": "AWS profile name to use",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_region": {
          "type": "string",
          "description": "AWS region where MSK is deployed.",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_role_arn": {
          "type": "string",
          "description": "Arn of an AWS IAM role to assume",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_secret_key": {
          "type": "string",
          "description": "The AWS secret key.",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_shared_config_files": {
          "type": [
            "list",
            "string"
          ],
          "description": "List of paths to AWS shared config files.",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_aws_token": {
          "type": "string",
          "description": "The AWS session token. Only required if you are using temporary security credentials.",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_mechanism": {
          "type": "string",
          "description": "SASL mechanism, can be plain, scram-sha512, scram-sha256, aws-iam",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_oauth_scopes": {
          "type": [
            "list",
            "string"
          ],
          "description": "OAuth scopes to request when using the oauthbearer mechanism",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_password": {
          "type": "string",
          "description": "Password for SASL authentication.",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_token_url": {
          "type": "string",
          "description": "The url to retrieve oauth2 tokens from, when using sasl mechanism oauthbearer",
          "description_kind": "plain",
          "optional": true
        },
        "sasl_username": {
          "type": "string",
          "description": "Username for SASL authentication.",
          "description_kind": "plain",
          "optional": true
        },
        "skip_tls_verify": {
          "type": "bool",
          "description": "Set this to true only if the target Kafka server is an insecure development instance.",
          "description_kind": "plain",
          "optional": true
        },
        "timeout": {
          "type": "number",
          "description": "Timeout in seconds",
          "description_kind": "plain",
          "optional": true
        },
        "tls_enabled": {
          "type": "bool",
          "description": "Enable communication with the Kafka Cluster over TLS.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "kafka_acl": {
      "version": 1,
      "block": {
        "attributes": {
          "acl_host": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "acl_operation": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "acl_permission_type": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "acl_principal": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "resource_name": {
            "type": "string",
            "description": "The name of the resource",
            "description_kind": "plain",
            "required": true
          },
          "resource_pattern_type_filter": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "resource_type": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "kafka_quota": {
      "version": 0,
      "block": {
        "attributes": {
          "config": {
            "type": [
              "map",
              "number"
            ],
            "description": "A map of string k/v properties.",
            "description_kind": "plain",
            "optional": true
          },
          "entity_name": {
            "type": "string",
            "description": "The name of the entity (if entity_name is not provided, it will create entity-default Kafka quota)",
            "description_kind": "plain",
            "optional": true
          },
          "entity_type": {
            "type": "string",
            "description": "The type of the entity (client-id, user, ip)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "kafka_topic": {
      "version": 0,
      "block": {
        "attributes": {
          "config": {
            "type": [
              "map",
              "string"
            ],
            "description": "A map of string k/v attributes.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the topic.",
            "description_kind": "plain",
            "required": true
          },
          "partitions": {
            "type": "number",
            "description": "Number of partitions.",
            "description_kind": "plain",
            "required": true
          },
          "replication_factor": {
            "type": "number",
            "description": "Number of replicas.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "kafka_user_scram_credential": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "The password of the credential (deprecated, use password_wo instead)",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "password_wo": {
            "type": "string",
            "description": "The write-only password of the credential",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "password_wo_version": {
            "type": "string",
            "description": "Version identifier for the write-only password to track changes",
            "description_kind": "plain",
            "optional": true
          },
          "scram_iterations": {
            "type": "number",
            "description": "The number of SCRAM iterations used when generating the credential",
            "description_kind": "plain",
            "optional": true
          },
          "scram_mechanism": {
            "type": "string",
            "description": "The SCRAM mechanism used to generate the credential (SCRAM-SHA-256, SCRAM-SHA-512)",
            "description_kind": "plain",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "The name of the credential",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "kafka_topic": {
      "version": 0,
      "block": {
        "attributes": {
          "config": {
            "type": [
              "map",
              "string"
            ],
            "description": "A map of string k/v attributes.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the topic.",
            "description_kind": "plain",
            "required": true
          },
          "partitions": {
            "type": "number",
            "description": "Number of partitions.",
            "description_kind": "plain",
            "computed": true
          },
          "replication_factor": {
            "type": "number",
            "description": "Number of replicas.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "kafka_topics": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "list": {
            "type": [
              "list",
              [
                "object",
                {
                  "config": [
                    "map",
                    "string"
                  ],
                  "partitions": "number",
                  "replication_factor": "number",
                  "topic_name": "string"
                }
              ]
            ],
            "description": "A list containing all the topics.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Provides a list of all Kafka topics in the cluster.",
        "description_kind": "plain"
      }
    }
  }
}
