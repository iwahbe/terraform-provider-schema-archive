{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description": "Kea ctrl-agent password. Defaults to env var `KEA_PASSWORD` if not specified.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Kea ctrl-agent username. Defaults to env var `KEA_USERNAME` if not specified.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "kea_remote_option_def4_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "array": {
            "type": "bool",
            "description": "The false value of the array parameter determines that the option does NOT comprise an array of uint32 values but is, instead, a single value..",
            "description_kind": "markdown",
            "optional": true
          },
          "code": {
            "type": "number",
            "description": "DHCP option code. e.g. `222`",
            "description_kind": "markdown",
            "required": true
          },
          "encapsulate": {
            "type": "string",
            "description": "The name of the option space in which the sub-options are defined.",
            "description_kind": "markdown",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description": "Hostname of the kea server to connect to. e.g. `kea.example.com`",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "DHCP option name. e.g. `location-identifier`",
            "description_kind": "markdown",
            "required": true
          },
          "record_types": {
            "type": "string",
            "description": "The record_types value should be non-empty if type is set to \"record\"; otherwise it must be left blank. ",
            "description_kind": "markdown",
            "optional": true
          },
          "space": {
            "type": "string",
            "description": "The DHCP space for the option-def. e.g. `dhcp4`.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "DHCP option type. e.g. `string`, `uint32`",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Remote OptionDef4 resource",
        "description_kind": "markdown"
      }
    },
    "kea_remote_subnet4_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "boot_file_name": {
            "type": "string",
            "description": "Optional conveys the boot configuration file, can be up to 128 bytes long, and is sent using the `file` field.",
            "description_kind": "markdown",
            "optional": true
          },
          "ddns_generated_prefix": {
            "type": "string",
            "description": "Prefix used when Kea generates forward DDNS names. e.g. `host`",
            "description_kind": "markdown",
            "optional": true
          },
          "ddns_override_client_update": {
            "type": "bool",
            "description": "When true, Kea sends DDNS updates even if the client requests to do it itself.",
            "description_kind": "markdown",
            "optional": true
          },
          "ddns_override_no_update": {
            "type": "bool",
            "description": "When true, Kea sends DDNS updates even if the client sets the N flag.",
            "description_kind": "markdown",
            "optional": true
          },
          "ddns_qualifying_suffix": {
            "type": "string",
            "description": "Suffix appended to generated forward DDNS names. e.g. `example.com.`",
            "description_kind": "markdown",
            "optional": true
          },
          "ddns_rev_dns_name": {
            "type": "string",
            "description": "Reverse DNS zone for PTR records. e.g. `225.168.192.in-addr.arpa.`",
            "description_kind": "markdown",
            "optional": true
          },
          "ddns_send_updates": {
            "type": "bool",
            "description": "When true, Kea sends DDNS updates for leases in this subnet.",
            "description_kind": "markdown",
            "optional": true
          },
          "ddns_use_conflict_resolution": {
            "type": "bool",
            "description": "When true, Kea uses DDNS conflict-resolution behavior for this subnet.",
            "description_kind": "markdown",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description": "Hostname of the kea server to connect to. e.g. `kea.example.com`",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "next_server": {
            "type": "string",
            "description": "Optional TFTP boot server IP address, packets sent in the `siaddr` field.",
            "description_kind": "markdown",
            "optional": true
          },
          "option_data": {
            "nested_type": {
              "attributes": {
                "always_send": {
                  "type": "bool",
                  "description_kind": "plain",
                  "required": true
                },
                "code": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "data": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of option-data to configure on the pool. e.g. `[{code = 6, name = \"domain-name-servers\", data = \"8.8.8.8, 4.2.2.2\"}]`",
            "description_kind": "markdown",
            "optional": true
          },
          "pools": {
            "nested_type": {
              "attributes": {
                "pool": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of pools to configure in the subnet. e.g. `['192.168.230.10-192.168.230.200']",
            "description_kind": "markdown",
            "required": true
          },
          "relay": {
            "nested_type": {
              "attributes": {
                "ip_address": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of relay IPs to configure in Kea. e.g. `['192.168.230.1']`",
            "description_kind": "markdown",
            "optional": true
          },
          "server_hostname": {
            "type": "string",
            "description": "Optional, conveys a server hostname, can be up to 64 bytes long, and is in the `sname` field.",
            "description_kind": "markdown",
            "optional": true
          },
          "subnet": {
            "type": "string",
            "description": "Subnet4 prefix to configure in Kea. e.g. `192.168.230.0/24`",
            "description_kind": "markdown",
            "required": true
          },
          "user_context": {
            "type": [
              "map",
              "string"
            ],
            "description": "Arbitrary string data to tie to the subnet. e.g. `{site = \"AUS\", name = \"Austin, Tx\"}`",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Remote Subnet4 resource",
        "description_kind": "markdown"
      }
    },
    "kea_reservation_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "boot_file_name": {
            "type": "string",
            "description": "Boot-file-name for this reservation.",
            "description_kind": "markdown",
            "optional": true
          },
          "circuit_id": {
            "type": "string",
            "description": "Circuit-Id for this reservation.",
            "description_kind": "markdown",
            "optional": true
          },
          "client_id": {
            "type": "string",
            "description": "Client-Id for this reservation.",
            "description_kind": "markdown",
            "optional": true
          },
          "duid": {
            "type": "string",
            "description": "Du-Id for this reservation.",
            "description_kind": "markdown",
            "optional": true
          },
          "flex_id": {
            "type": "string",
            "description": "Flex-Id for this reservation.",
            "description_kind": "markdown",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description": "Hostname of the kea server to connect to. e.g. `kea.example.com`",
            "description_kind": "markdown",
            "required": true
          },
          "hw_address": {
            "type": "string",
            "description": "Hw-address/MAC address for this reservation.",
            "description_kind": "markdown",
            "required": true
          },
          "ip_address": {
            "type": "string",
            "description": "IP address for this reservation.",
            "description_kind": "markdown",
            "required": true
          },
          "next_server": {
            "type": "string",
            "description": "Next-Server for this reservation.",
            "description_kind": "markdown",
            "optional": true
          },
          "option_data": {
            "nested_type": {
              "attributes": {
                "always_send": {
                  "type": "bool",
                  "description_kind": "plain",
                  "required": true
                },
                "code": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "data": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of option-data to configure on the pool. e.g. `[{code = 6, name = \"domain-name-servers\", data = \"8.8.8.8, 4.2.2.2\"}]`",
            "description_kind": "markdown",
            "optional": true
          },
          "reservation_hostname": {
            "type": "string",
            "description": "Hostname to define this reservation. e.g. `switch.example.com`",
            "description_kind": "markdown",
            "required": true
          },
          "subnet_id": {
            "type": "number",
            "description": "Subnet ID of the subnet to reserve in Kea. e.g. `1921682300`",
            "description_kind": "markdown",
            "required": true
          },
          "user_context": {
            "type": [
              "map",
              "string"
            ],
            "description": "Arbitrary string data to tie to the subnet. e.g. `{site = \"AUS\", name = \"Austin, Tx\"}`",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Reservation resource",
        "description_kind": "markdown"
      }
    }
  },
