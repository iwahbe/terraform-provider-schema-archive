{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dmcloud_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "airflow_version": {
            "type": "string",
            "description": "The airflow version of the environment, either 1 or 2, defaults to 2.",
            "description_kind": "plain",
            "optional": true
          },
          "cluster_id": {
            "type": "string",
            "description": "The cluster if of the environment",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "deletion_protection": {
            "type": "bool",
            "description": "Wether to project your environment from deletion.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The id of the environment.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the environment.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Provides a Data Minded Cloud environment.",
        "description_kind": "plain"
      }
    },
    "dmcloud_environment_user": {
      "version": 0,
      "block": {
        "attributes": {
          "environment_id": {
            "type": "string",
            "description": "The id of the environment to add the user to.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of this resource.",
            "description_kind": "plain",
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "The role the user should have on the environment, either `admin`, `contributor` or `operator`.",
            "description_kind": "plain",
            "required": true
          },
          "user_id": {
            "type": "string",
            "description": "The email address of the user to add.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Links a user to Datafy environment.",
        "description_kind": "plain"
      }
    },
    "dmcloud_project": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "The description of the project, you can input markdown here.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "git_repo": {
            "type": "string",
            "description": "The link to the git repo for this project.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The id of the project.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the project.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Provides a Data Minded Cloud project.\n\nAfter creating a project with the terraform provider you can generate the `.datafy/project.yaml` file with the command:\n\n```bash\ndatafy project generate-config --name YOUR_PROJECT_NAME\n```\n",
        "description_kind": "plain"
      }
    },
    "dmcloud_project_user": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of this resource",
            "description_kind": "plain",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "The id of the project to add the user to.",
            "description_kind": "plain",
            "required": true
          },
          "role": {
            "type": "string",
            "description": "The role the user should have on the project, either `admin` or `contributor`.",
            "description_kind": "plain",
            "required": true
          },
          "user_id": {
            "type": "string",
            "description": "The email address of the user to add.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Links a user to Datafy project.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "dmcloud_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "default": {
            "type": "bool",
            "description": "Wether this is the default cluster",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The id of cluster",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the cluster",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Can be used to find the id of a cluster.",
        "description_kind": "plain"
      }
    },
    "dmcloud_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The id of the environment",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the environment",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Can be used to find the id of an environment.",
        "description_kind": "plain"
      }
    },
    "dmcloud_project": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The id of the project",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the project",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Can be used to find the id of a project.",
        "description_kind": "plain"
      }
    }
  }
}
