{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "docker_host": {
          "type": "string",
          "description": "Docker daemon endpoint.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "docker_container": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "The Docker image name and tag (e.g., nginx:latest).",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the Docker container.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "ports": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "external": {
                  "type": "number",
                  "description": "The external port on the host.",
                  "description_kind": "plain",
                  "required": true
                },
                "internal": {
                  "type": "number",
                  "description": "The internal port inside the container.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Port mappings from container to host.",
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
