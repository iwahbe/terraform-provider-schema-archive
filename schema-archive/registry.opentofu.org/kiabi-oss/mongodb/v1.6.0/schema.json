{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "url": {
          "type": "string",
          "description": "URL of the MongoDB instance to connect to.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Create resources in MongoDB.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "mongodb_index": {
      "version": 0,
      "block": {
        "attributes": {
          "background": {
            "type": "bool",
            "description": "Create the index in the background.",
            "description_kind": "plain",
            "optional": true
          },
          "collation": {
            "nested_type": {
              "attributes": {
                "alternate": {
                  "type": "string",
                  "description": "Whether spaces and punctuation are considered base characters.",
                  "description_kind": "plain",
                  "optional": true
                },
                "backwards": {
                  "type": "bool",
                  "description": "Causes secondary differences to be considered in reverse order, as it is done in the French language.",
                  "description_kind": "plain",
                  "optional": true
                },
                "case_first": {
                  "type": "string",
                  "description": "The case ordering.",
                  "description_kind": "plain",
                  "optional": true
                },
                "case_level": {
                  "type": "bool",
                  "description": "The case level.",
                  "description_kind": "plain",
                  "optional": true
                },
                "locale": {
                  "type": "string",
                  "description": "The locale.",
                  "description_kind": "plain",
                  "required": true
                },
                "max_variable": {
                  "type": "string",
                  "description": "Which characters are affected by alternate: 'shifted'.",
                  "description_kind": "plain",
                  "optional": true
                },
                "normalization": {
                  "type": "bool",
                  "description": "Causes text to be normalized into Unicode NFD.",
                  "description_kind": "plain",
                  "optional": true
                },
                "numeric_ordering": {
                  "type": "bool",
                  "description": "Whether to order numbers based on numerical order and not collation order.",
                  "description_kind": "plain",
                  "optional": true
                },
                "strength": {
                  "type": "number",
                  "description": "The number of comparison levels to use.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Index collation.",
            "description_kind": "plain",
            "optional": true
          },
          "collection": {
            "type": "string",
            "description": "Name of the collection where to create the index.",
            "description_kind": "plain",
            "required": true
          },
          "database": {
            "type": "string",
            "description": "Name of the database where to create the index.",
            "description_kind": "plain",
            "required": true
          },
          "expire_after_seconds": {
            "type": "number",
            "description": "Documents ttl in seconds for ttl indexes.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "deprecated": true,
            "computed": true
          },
          "keys": {
            "nested_type": {
              "attributes": {
                "field": {
                  "type": "string",
                  "description": "The name of the field to index.",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description": "The type of index for this field.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The list of fields composing the index.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the index to create.",
            "description_kind": "plain",
            "required": true
          },
          "partial_filter_expression": {
            "type": "string",
            "description": "A JSON string representing a filter expression for partial indexes.",
            "description_kind": "plain",
            "optional": true
          },
          "sparse": {
            "type": "bool",
            "description": "Is it a sparse index.",
            "description_kind": "plain",
            "optional": true
          },
          "unique": {
            "type": "bool",
            "description": "Is it a unique index.",
            "description_kind": "plain",
            "optional": true
          },
          "wildcard_projection": {
            "type": [
              "map",
              "number"
            ],
            "description": "Projection for wirldcard indexes.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Create indexes in MongoDB.",
        "description_kind": "plain"
      }
    },
    "mongodb_query_plan": {
      "version": 0,
      "block": {
        "attributes": {
          "allowed_indexes": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of index names allowed for this query shape. Set to [\"*\"] to allow all indexes.",
            "description_kind": "plain",
            "required": true
          },
          "collection": {
            "type": "string",
            "description": "Name of the collection.",
            "description_kind": "plain",
            "required": true
          },
          "comment": {
            "type": "string",
            "description": "Comment describing the reason for the query settings.",
            "description_kind": "plain",
            "optional": true
          },
          "database": {
            "type": "string",
            "description": "Name of the database.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "deprecated": true,
            "computed": true
          },
          "query_hash": {
            "type": "string",
            "description": "The SHA256 query shape hash to apply settings to.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage query plan settings in MongoDB. Forces query settings for a given query shape hash.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "mongodb_query_shape": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_disk_use": {
            "type": "bool",
            "description": "Allow disk use for aggregation operations.",
            "description_kind": "plain",
            "optional": true
          },
          "batch_size": {
            "type": "number",
            "description": "Number of documents to return per batch.",
            "description_kind": "plain",
            "optional": true
          },
          "collation": {
            "type": "string",
            "description": "JSON string representing the collation specification.",
            "description_kind": "plain",
            "optional": true
          },
          "collection": {
            "type": "string",
            "description": "Name of the collection.",
            "description_kind": "plain",
            "required": true
          },
          "command": {
            "type": "string",
            "description": "Type of command. One of: find, aggregate, distinct, count.",
            "description_kind": "plain",
            "required": true
          },
          "database": {
            "type": "string",
            "description": "Name of the database.",
            "description_kind": "plain",
            "required": true
          },
          "filter": {
            "type": "string",
            "description": "JSON string representing the query filter.",
            "description_kind": "plain",
            "optional": true
          },
          "hash": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "hint": {
            "type": "string",
            "description": "JSON string representing the index hint.",
            "description_kind": "plain",
            "optional": true
          },
          "key": {
            "type": "string",
            "description": "The field to use for distinct command.",
            "description_kind": "plain",
            "optional": true
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of documents to return.",
            "description_kind": "plain",
            "optional": true
          },
          "pipeline": {
            "type": "string",
            "description": "JSON string representing the aggregation pipeline array.",
            "description_kind": "plain",
            "optional": true
          },
          "projection": {
            "type": "string",
            "description": "JSON string representing the projection specification.",
            "description_kind": "plain",
            "optional": true
          },
          "skip": {
            "type": "number",
            "description": "Number of documents to skip.",
            "description_kind": "plain",
            "optional": true
          },
          "sort": {
            "type": "string",
            "description": "JSON string representing the sort specification.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Retrieve the query shape hash from MongoDB.",
        "description_kind": "plain"
      }
    }
  }
}
