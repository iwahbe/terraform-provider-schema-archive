    "cruiser_envoy_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_discovery_type": {
            "type": "string",
            "description": "The type of discovery service that will be used to discover cluster members. Valid values are `EDS`, `STATIC`, `STRICT_DNS`, `LOGICAL_DNS` and `ORIGINAL_DST`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "connect_timeout": {
            "type": "string",
            "description": "The timeout for new network connections to hosts in the cluster. If not specified, the default is 5s.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "dns_lookup_family": {
            "type": "string",
            "description": "The DNS resolver to use for hostname resolution. Valid values are `V4_ONLY`, `V6_ONLY`, `V4_PREFERRED`, `ALL` and `AUTO`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "eds_cluster_config": {
            "nested_type": {
              "attributes": {
                "api_type": {
                  "type": "string",
                  "description": "The API type to use. Valid values are `GRPC`, `REST`, `DELTA_GRPC`, `AGGREGATED_GRPC` and `AGGREGATED_DELTA_GRPC`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "envoy_grpc_cluster_name": {
                  "type": "string",
                  "description": "The name of the Envoy gRPC cluster.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "resource_api": {
                  "type": "string",
                  "description": "The resource API version to use. Valid values are `AUTO`, `V2` and `V3`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "service_name": {
                  "type": "string",
                  "description": "The name of the service to load balance. This name must match the name used in the Envoy proxy configuration.",
                  "description_kind": "markdown",
                  "required": true
                },
                "set_node_on_first_message_only": {
                  "type": "bool",
                  "description": "Whether to set the node on the first message only.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "transport_api_version": {
                  "type": "string",
                  "description": "The transport API version to use. Valid values are `AUTO`, `V2` and `V3`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The configuration for the EDS cluster.",
            "description_kind": "markdown",
            "optional": true
          },
          "enable_tls_transport": {
            "type": "bool",
            "description": "Whether to enable TLS transport for the cluster.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "lb_policy": {
            "type": "string",
            "description": "The load balancing policy for the cluster. Valid values are `ROUND_ROBIN`, `LEAST_REQUEST`, `RANDOM`, `RING_HASH`, `MAGLEV`, `CLUSTER_PROVIDED`, `LOAD_BALANCING_POLICY_CONFIG`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the cluster. This name must match the name used in the Envoy proxy configuration.",
            "description_kind": "markdown",
            "required": true
          },
          "proto_json": {
            "type": "string",
            "description": "The Envoy Cluster Resource in JSON format",
            "description_kind": "markdown",
            "computed": true
          },
          "protocol_options": {
            "nested_type": {
              "attributes": {
                "enable_http1": {
                  "type": "bool",
                  "description": "Whether to enable HTTP/1.1.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "enable_http2": {
                  "type": "bool",
                  "description": "Whether to enable HTTP/2.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "http2_max_concurrent_streams": {
                  "type": "number",
                  "description": "The maximum number of concurrent HTTP/2 streams.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The protocol options for the cluster.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Envoy Cluster Resource",
        "description_kind": "markdown"
      }
    },
