{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Plausible API KEY. Can be specified with the `PLAUSIBLE_API_KEY` environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "Plausible URL. Can be specified with the `PLAUSIBLE_URL` environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "plausible_site": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The site ID",
            "description_kind": "plain",
            "computed": true
          },
          "javascript_snippet": {
            "type": "string",
            "description": "Include this snippet in the <head> of your website.",
            "description_kind": "plain",
            "computed": true
          },
          "timezone": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
