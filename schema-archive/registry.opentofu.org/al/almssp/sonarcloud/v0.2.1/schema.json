{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "organization": {
          "type": "string",
          "description": "The SonarCloud organization to manage the resources for. This value must be set in the `SONARCLOUD_ORGANIZATION` environment variable if left empty.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The token of a user with admin permissions in the organization. This value must be set in the `SONARCLOUD_TOKEN` environment variable if left empty.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "sonarcloud_project": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The key of the project. **Warning**: must be globally unique.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the project. **Warning:** forces project recreation when changed.",
            "description_kind": "plain",
            "required": true
          },
          "visibility": {
            "type": "string",
            "description": "The visibility of the project. Use `private` to only share it with your organization. Use `public` if the project should be visible to everyone. Defaults to the organization's default visibility. **Note:** private projects are only available when you have a SonarCloud subscription.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "This resource manages a project.",
        "description_kind": "plain"
      }
    },
    "sonarcloud_user_group": {
      "version": 0,
      "block": {
        "attributes": {
          "default": {
            "type": "bool",
            "description": "Whether the group is the default group or not.",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description for the user group.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "members_count": {
            "type": "number",
            "description": "The number of members this group has.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the user group.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "This resource manages a user group.",
        "description_kind": "plain"
      }
    },
    "sonarcloud_user_group_member": {
      "version": 0,
      "block": {
        "attributes": {
          "group": {
            "type": "string",
            "description": "The name of the group to which the user should be added.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "login": {
            "type": "string",
            "description": "The login of the user that should be added to the group.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "This resource manages a single member of a user group.",
        "description_kind": "plain"
      }
    },
    "sonarcloud_user_token": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "login": {
            "type": "string",
            "description": "The login of the user to which the token should be added. This should be the same user as configured in the provider.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the token.",
            "description_kind": "plain",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "The value of the generated token.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "This resource manages the tokens for a user.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "sonarcloud_projects": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "projects": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "ID of the project. Equals to the project name.",
                  "description_kind": "plain",
                  "computed": true
                },
                "key": {
                  "type": "string",
                  "description": "The key of the project.",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the project.",
                  "description_kind": "plain",
                  "computed": true
                },
                "visibility": {
                  "type": "string",
                  "description": "The visibility of the project.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The projects of this organization.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "This data source retrieves a list of projects for the configured organization.",
        "description_kind": "plain"
      }
    },
    "sonarcloud_user_group": {
      "version": 0,
      "block": {
        "attributes": {
          "default": {
            "type": "bool",
            "description": "Whether new members are added to this user group per default or not.",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description of the user group.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the user group.",
            "description_kind": "plain",
            "computed": true
          },
          "members_count": {
            "type": "number",
            "description": "The number of members in this user group.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the user group.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "This data source retrieves a single user group.",
        "description_kind": "plain"
      }
    },
    "sonarcloud_user_group_members": {
      "version": 0,
      "block": {
        "attributes": {
          "group": {
            "type": "string",
            "description": "The name of the group.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "users": {
            "nested_type": {
              "attributes": {
                "login": {
                  "type": "string",
                  "description": "The login of this user",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of this user",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The users of the group.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "This data source retrieves a list of users for the given group.",
        "description_kind": "plain"
      }
    },
    "sonarcloud_user_groups": {
      "version": 0,
      "block": {
        "attributes": {
          "groups": {
            "nested_type": {
              "attributes": {
                "default": {
                  "type": "bool",
                  "description": "Whether new members are added to this user group per default or not.",
                  "description_kind": "plain",
                  "computed": true
                },
                "description": {
                  "type": "string",
                  "description": "The description of the user group.",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "The ID of the user group.",
                  "description_kind": "plain",
                  "computed": true
                },
                "members_count": {
                  "type": "number",
                  "description": "The number of members in this user group.",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the user group.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The groups of this organization.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "This data source retrieves a list of user groups for the configured organization.",
        "description_kind": "plain"
      }
    }
  }
}
