{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "address": {
          "type": "string",
          "description": "Origin URL of the Vault server. This is a URL with a scheme, a hostname and a port but with no path. May be set via the VAULT_ADDR environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "namespace": {
          "type": "string",
          "description": "Set the namespace to use. May be set via the VAULT_NAMESPACE environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Vault token that will be used by Terraform to authenticate. May be set via the VAULT_TOKEN environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "vaultoidc_token": {
      "version": 0,
      "block": {
        "attributes": {
          "application": {
            "type": "string",
            "description": "Application",
            "description_kind": "markdown",
            "required": true
          },
          "oidc_provider": {
            "type": "string",
            "description": "OIDC provider",
            "description_kind": "markdown",
            "required": true
          },
          "redirect_uri": {
            "type": "string",
            "description": "Redirect URI, default http://localhost:8000",
            "description_kind": "markdown",
            "optional": true
          },
          "response_type": {
            "type": "string",
            "description": "Response Type, default 'code'",
            "description_kind": "markdown",
            "optional": true
          },
          "scope": {
            "type": "string",
            "description": "Scopes, default openid k8s-user k8s-groups",
            "description_kind": "markdown",
            "optional": true
          },
          "token": {
            "type": "string",
            "description": "Token",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Token data source",
        "description_kind": "markdown"
      }
    }
  }
}
