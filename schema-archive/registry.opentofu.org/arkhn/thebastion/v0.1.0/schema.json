{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "IP:PORT for TheBastion.",
          "description_kind": "plain",
          "optional": true
        },
        "path_known_host": {
          "type": "string",
          "description": "Path known host for TheBastion. Used to connect in ssh to TheBastion.",
          "description_kind": "plain",
          "optional": true
        },
        "path_private_key": {
          "type": "string",
          "description": "Path private key for TheBastion. Used to connect in ssh to TheBastion.",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username for TheBastion.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "thebastion_user": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of resource. Required by terraform-plugin-testing",
            "description_kind": "plain",
            "computed": true
          },
          "ingress_keys": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of ingress keys of users.",
            "description_kind": "plain",
            "required": true
          },
          "is_active": {
            "type": "number",
            "description": "Is the user active.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of user. Used as an unique identifier by TheBastion.",
            "description_kind": "plain",
            "required": true
          },
          "uid": {
            "type": "number",
            "description": "UID of user.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage an user.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "thebastion_users": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of list of users. Required by terraform-plugin-testing",
            "description_kind": "plain",
            "computed": true
          },
          "users": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "ID of user. Required by terraform-plugin-testing",
                  "description_kind": "plain",
                  "computed": true
                },
                "ingress_keys": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of ingress keys of users.",
                  "description_kind": "plain",
                  "computed": true
                },
                "is_active": {
                  "type": "number",
                  "description": "Is the user active.",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of user. Used as an unique identifier by TheBastion.",
                  "description_kind": "plain",
                  "computed": true
                },
                "uid": {
                  "type": "number",
                  "description": "UID of user.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of users.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches the list of users.",
        "description_kind": "plain"
      }
    }
  }
}
