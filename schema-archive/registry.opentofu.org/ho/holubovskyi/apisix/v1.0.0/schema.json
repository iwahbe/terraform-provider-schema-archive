{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API Key for APISIX API. May also be provided via APISIX_APIKEY environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "Endpoint for APISIX API. May also be provided via APISIX_ENDPOINT environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with APISIX API.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "apisix_consumer": {
      "version": 0,
      "block": {
        "attributes": {
          "desc": {
            "type": "string",
            "description": "Description of usage scenarios.",
            "description_kind": "plain",
            "optional": true
          },
          "group_id": {
            "type": "string",
            "description": "Group of the Consumer.",
            "description_kind": "plain",
            "optional": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Attributes of the Consumer specified as key-value pairs.",
            "description_kind": "plain",
            "optional": true
          },
          "plugins": {
            "type": "string",
            "description": "Plugins that are executed during the request/response cycle.",
            "description_kind": "plain",
            "optional": true
          },
          "username": {
            "type": "string",
            "description": "Name and Identifier of the Consumer.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages APISIX Consumers.",
        "description_kind": "plain"
      }
    },
    "apisix_consumer_group": {
      "version": 0,
      "block": {
        "attributes": {
          "desc": {
            "type": "string",
            "description": "Description of usage scenarios.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the consumer group.",
            "description_kind": "plain",
            "required": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Attributes of the Consumer group specified as key-value pairs.",
            "description_kind": "plain",
            "optional": true
          },
          "plugins": {
            "type": "string",
            "description": "Plugins that are executed during the request/response cycle.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages APISIX Group of Plugins which can be reused across Consumers.",
        "description_kind": "plain"
      }
    },
    "apisix_global_rule": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Identifier of the global rule.",
            "description_kind": "plain",
            "required": true
          },
          "plugins": {
            "type": "string",
            "description": "Plugins that are executed during the request/response cycle.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Sets APISIX Plugins which run globally.",
        "description_kind": "plain"
      }
    },
    "apisix_plugin_config": {
      "version": 0,
      "block": {
        "attributes": {
          "desc": {
            "type": "string",
            "description": "Description of usage scenarios.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the plugin config.",
            "description_kind": "plain",
            "required": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Attributes of the Plugin config specified as key-value pairs.",
            "description_kind": "plain",
            "optional": true
          },
          "plugins": {
            "type": "string",
            "description": "Plugins that are executed during the request/response cycle.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages APISIX Group of Plugins which can be reused across Routes.",
        "description_kind": "plain"
      }
    },
    "apisix_route": {
      "version": 0,
      "block": {
        "attributes": {
          "desc": {
            "type": "string",
            "description": "Description of usage scenarios.",
            "description_kind": "plain",
            "optional": true
          },
          "enable_websocket": {
            "type": "bool",
            "description": "Enables a websocket. Set to `false` by default.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "filter_func": {
            "type": "string",
            "description": "Matches based on a user-defined filtering function.Used in scenarios requiring complex matching. These functions can accept an input parameter `vars` which can be used to access the Nginx variables.",
            "description_kind": "markdown",
            "optional": true
          },
          "host": {
            "type": "string",
            "description": "Matches with domain names such as `foo.com` or PAN domain names like `*.foo.com`.",
            "description_kind": "plain",
            "optional": true
          },
          "hosts": {
            "type": [
              "list",
              "string"
            ],
            "description": "Matches with any one of the multiple `host`s specified in the form of a non-empty list.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the route.",
            "description_kind": "plain",
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Attributes of the Service specified as key-value pairs.",
            "description_kind": "plain",
            "optional": true
          },
          "methods": {
            "type": [
              "list",
              "string"
            ],
            "description": "Matches with the specified HTTP methods. Matches all methods if empty or unspecified.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Identifier for the route.",
            "description_kind": "plain",
            "optional": true
          },
          "plugin_config_id": {
            "type": "string",
            "description": "Plugin config bound to the Route.",
            "description_kind": "plain",
            "optional": true
          },
          "plugins": {
            "type": "string",
            "description": "Plugins that are executed during the request/response cycle.",
            "description_kind": "plain",
            "optional": true
          },
          "priority": {
            "type": "number",
            "description": "If different Routes matches to the same `uri`, then the Route is matched based on its `priority`.A higher value corresponds to higher priority.It is set to `0` by default.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "remote_addr": {
            "type": "string",
            "description": "Matches with the specified IP address in standard IPv4 format (`192.168.1.101`), CIDR format (`192.168.1.0/24`), or in IPv6 format.",
            "description_kind": "plain",
            "optional": true
          },
          "remote_addrs": {
            "type": [
              "list",
              "string"
            ],
            "description": "Matches with any one of the multiple `remote_addrs` specified in the form of a non-empty list.",
            "description_kind": "markdown",
            "optional": true
          },
          "script": {
            "type": "string",
            "description": "Used for writing arbitrary Lua code or directly calling existing plugins to be executed.",
            "description_kind": "plain",
            "optional": true
          },
          "service_id": {
            "type": "string",
            "description": "Configuration of the bound Service.",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "number",
            "description": "Enables the current Route. Set to `1` (enabled) by default. `1` to enable, `0` to disable",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "timeout": {
            "nested_type": {
              "attributes": {
                "connect": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "read": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "send": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Sets the timeout (in seconds) for connecting to, and sending and receiving messages to and from the Upstream.",
            "description_kind": "markdown",
            "optional": true
          },
          "upstream_id": {
            "type": "string",
            "description": "Id of the Upstream service.",
            "description_kind": "plain",
            "optional": true
          },
          "uri": {
            "type": "string",
            "description": "Matches the uri.",
            "description_kind": "plain",
            "optional": true
          },
          "uris": {
            "type": [
              "list",
              "string"
            ],
            "description": "Matches with any one of the multiple `uri`s specified in the form of a non-empty list.",
            "description_kind": "markdown",
            "optional": true
          },
          "vars": {
            "type": "string",
            "description": "Matches based on the specified variables consistent with variables in Nginx. Takes the form `[[var, operator, val], [var, operator, val], ...]]`.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages APISIX routes.",
        "description_kind": "plain"
      }
    },
    "apisix_service": {
      "version": 0,
      "block": {
        "attributes": {
          "desc": {
            "type": "string",
            "description": "Description of usage scenarios.",
            "description_kind": "plain",
            "optional": true
          },
          "enable_websocket": {
            "type": "bool",
            "description": "Enables a websocket. Set to `false` by default.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "hosts": {
            "type": [
              "list",
              "string"
            ],
            "description": "Matches with any one of the multiple `hosts` specified in the form of a non-empty list.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the service.",
            "description_kind": "plain",
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Attributes of the Service specified as key-value pairs.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Identifier for the service.",
            "description_kind": "plain",
            "optional": true
          },
          "plugins": {
            "type": "string",
            "description": "Plugins that are executed during the request/response cycle.",
            "description_kind": "plain",
            "optional": true
          },
          "upstream_id": {
            "type": "string",
            "description": "Id of the Upstream service.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages APISIX services.",
        "description_kind": "plain"
      }
    },
    "apisix_ssl_certificate": {
      "version": 0,
      "block": {
        "attributes": {
          "certificate": {
            "type": "string",
            "description": "HTTPS certificate.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the certificate.",
            "description_kind": "plain",
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Attributes of the resource specified as key-value pairs. An individual pair cannot be deleted using APISIX APIIn order to delete an individual pair, you can delete all labels and reapply the resource with the desired labels map",
            "description_kind": "markdown",
            "optional": true
          },
          "private_key": {
            "type": "string",
            "description": "HTTPS private key.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "snis": {
            "type": [
              "list",
              "string"
            ],
            "description": "A non-empty array of HTTPS SNI. Required if `type` is `server`",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "status": {
            "type": "number",
            "description": "Enables the current SSL. Set to `1` (enabled) by default. `1` to enable, `0` to disable",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Identifies the type of certificate, default `server`\n`client` Indicates that the certificate is a client certificate, which is used when APISIX accesses the upstream;\n`server` Indicates that the certificate is a server-side certificate, which is used by APISIX when verifying client requests.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages APISIX SSL certificates.",
        "description_kind": "plain"
      }
    },
    "apisix_stream_route": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Identifier of the stream route.",
            "description_kind": "plain",
            "computed": true
          },
          "remote_addr": {
            "type": "string",
            "description": "Filters Upstream forwards by matching with client IP. IPv4 (`127.0.0.1`) OR CIDR format (`127.0.0.1/32`).",
            "description_kind": "markdown",
            "optional": true
          },
          "server_addr": {
            "type": "string",
            "description": "Filters Upstream forwards by matching with APISIX Server IP. IPv4 (`127.0.0.1`) OR CIDR format (`127.0.0.1/32`).",
            "description_kind": "markdown",
            "optional": true
          },
          "server_port": {
            "type": "number",
            "description": "Filters Upstream forwards by matching with APISIX Server port.",
            "description_kind": "plain",
            "optional": true
          },
          "sni": {
            "type": "string",
            "description": "Server Name Indication. Matches with domain names such as `foo.com`",
            "description_kind": "markdown",
            "optional": true
          },
          "upstream_id": {
            "type": "string",
            "description": "Id of the Upstream service.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages APISIX Routes used in the Stream Proxy.",
        "description_kind": "plain"
      }
    },
    "apisix_upstream": {
      "version": 0,
      "block": {
        "attributes": {
          "checks": {
            "nested_type": {
              "attributes": {
                "active": {
                  "nested_type": {
                    "attributes": {
                      "concurrency": {
                        "type": "number",
                        "description": "The number of targets to be checked at the same time during the active check.",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "healthy": {
                        "nested_type": {
                          "attributes": {
                            "http_statuses": {
                              "type": [
                                "list",
                                "number"
                              ],
                              "description": "Active check (healthy node) HTTP or HTTPS type check, the HTTP status code of the healthy node.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "interval": {
                              "type": "number",
                              "description": "Active check (healthy node) check interval (unit: second)",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "successes": {
                              "type": "number",
                              "description": "Active check (healthy node) determine the number of times a node is healthy.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true
                      },
                      "host": {
                        "type": "string",
                        "description": "The hostname of the HTTP request actively checked.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "http_path": {
                        "type": "string",
                        "description": "The HTTP request path that is actively checked.",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "https_verify_certificate": {
                        "type": "bool",
                        "description": "Active check whether to check the SSL certificate of the remote host when HTTPS type checking is used.",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "port": {
                        "type": "number",
                        "description": "The host port of the HTTP request that is actively checked.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "req_headers": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Active check When using HTTP or HTTPS type checking, set additional request header information.",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "timeout": {
                        "type": "number",
                        "description": "The timeout period of the active check (seconds).",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "type": {
                        "type": "string",
                        "description": "The type of active check. Valid values are `http`, `https`, and `tcp`",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "unhealthy": {
                        "nested_type": {
                          "attributes": {
                            "http_failures": {
                              "type": "number",
                              "description": "Active check (unhealthy node) HTTP or HTTPS type check, determine the number of times that the node is not healthy.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "http_statuses": {
                              "type": [
                                "list",
                                "number"
                              ],
                              "description": "Active check (unhealthy node) HTTP or HTTPS type check, the HTTP status code of the non-healthy node.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "interval": {
                              "type": "number",
                              "description": "Active check (unhealthy node) check interval (unit: second)",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "tcp_failures": {
                              "type": "number",
                              "description": "Active check (unhealthy node) TCP type check, determine the number of times that the node is not healthy.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "timeouts": {
                              "type": "number",
                              "description": "Active check (unhealthy node) to determine the number of timeouts for unhealthy nodes.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Active health check mainly means that APISIX actively detects the survivability of upstream nodes through probes.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "passive": {
                  "nested_type": {
                    "attributes": {
                      "healthy": {
                        "nested_type": {
                          "attributes": {
                            "http_statuses": {
                              "type": [
                                "list",
                                "number"
                              ],
                              "description": "Passive check (healthy node) HTTP or HTTPS type check, the HTTP status code of the healthy node.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "successes": {
                              "type": "number",
                              "description": "Passive checks (healthy node) determine the number of times a node is healthy.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description": "Passive health check refers to judging whether the corresponding upstream node is healthy by judging the response status of the request forwarded from APISIX to the upstream node.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "unhealthy": {
                        "nested_type": {
                          "attributes": {
                            "http_failures": {
                              "type": "number",
                              "description": "Passive check (unhealthy node) The number of times that the node is not healthy during HTTP or HTTPS type checking.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "http_statuses": {
                              "type": [
                                "list",
                                "number"
                              ],
                              "description": "Passive check (unhealthy node) HTTP or HTTPS type check, the HTTP status code of the non-healthy node.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "tcp_failures": {
                              "type": "number",
                              "description": "Passive check (unhealthy node) When TCP type is checked, determine the number of times that the node is not healthy.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            },
                            "timeouts": {
                              "type": "number",
                              "description": "Passive checks (unhealthy node) determine the number of timeouts for unhealthy nodes.",
                              "description_kind": "markdown",
                              "optional": true,
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Passive health check refers to judging whether the corresponding upstream node is healthy by judging the response status of the request forwarded from APISIX to the upstream node.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Configures the parameters for the health check.",
            "description_kind": "markdown",
            "optional": true
          },
          "desc": {
            "type": "string",
            "description": "Description of usage scenarios.",
            "description_kind": "markdown",
            "optional": true
          },
          "discovery_type": {
            "type": "string",
            "description": "The type of service discovery. Required, if `service_name` is used",
            "description_kind": "markdown",
            "optional": true
          },
          "hash_on": {
            "type": "string",
            "description": "Only valid if the type is chash. Supports Nginx variables (vars), custom headers (header), cookie and consumer. Defaults to vars.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the upstream.",
            "description_kind": "plain",
            "computed": true
          },
          "keepalive_pool": {
            "nested_type": {
              "attributes": {
                "idle_timeout": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "requests": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "size": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Sets the `keepalive_pool`.",
            "description_kind": "markdown",
            "optional": true
          },
          "key": {
            "type": "string",
            "description": "Nginx var",
            "description_kind": "markdown",
            "optional": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Attributes of the Upstream specified as `key-value` pairs.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Identifier for the Upstream.",
            "description_kind": "markdown",
            "optional": true
          },
          "nodes": {
            "nested_type": {
              "attributes": {
                "host": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "port": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "weight": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Configures the parameters for the health check.",
            "description_kind": "markdown",
            "optional": true
          },
          "pass_host": {
            "type": "string",
            "description": "Configures the `host` when the request is forwarded to the upstream. Can be one of `pass`, `node` or `rewrite`. Defaults to `pass` if not specified.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "retries": {
            "type": "number",
            "description": "Sets the number of retries while passing the request to Upstream using the underlying Nginx mechanism. Setting this to `0` disables retry.",
            "description_kind": "markdown",
            "optional": true
          },
          "retry_timeout": {
            "type": "number",
            "description": "Timeout to continue with retries. Setting this to `0` disables the retry timeout.",
            "description_kind": "markdown",
            "optional": true
          },
          "scheme": {
            "type": "string",
            "description": "The scheme used when communicating with the Upstream. For an L7 proxy, this value can be one of `http`, `https`, `grpc`, `grpcs`. For an L4 proxy, this value could be one of `tcp`, `udp`, `tls`. Defaults to `http`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "service_name": {
            "type": "string",
            "description": "Service name used for service discovery. Can't be used with `nodes`",
            "description_kind": "markdown",
            "optional": true
          },
          "timeout": {
            "nested_type": {
              "attributes": {
                "connect": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "read": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "send": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Sets the timeout (in seconds) for connecting to, and sending and receiving messages to and from the Upstream.",
            "description_kind": "markdown",
            "optional": true
          },
          "tls_client_cert_id": {
            "type": "string",
            "description": "Set the referenced SSL id.",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Load balancing algorithm to be used, and the default value is `roundrobin`.\nCan be one of the following: `roundrobin`, `chash`, `ewma` or `least_conn`",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "upstream_host": {
            "type": "string",
            "description": "Specifies the host of the Upstream request. This is only valid if the `pass_host` is set to `rewrite`.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages APISIX Upstreams.",
        "description_kind": "plain"
      }
    }
  }
}
