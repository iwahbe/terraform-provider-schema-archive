{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "\nThe hostname (without port) of the SMTP server.\nCan be passed using the SMTP_HOST environment variable.\",\n\t\t\t\t\t",
          "description_kind": "markdown",
          "required": true
        },
        "port": {
          "type": "number",
          "description": "\nThe port of the SMTP server.\nCan be passed using the SMTP_PORT environment variable.\nIf not set explicitly, it will default to 587.\n\t\t\t\t\t",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "\nThe username to use for authentication.\nCan be passed using the SMTP_USERNAME environment variable.\n\t\t\t\t\t",
          "description_kind": "markdown",
          "required": true
        }
      },
      "block_types": {
        "cram_md5_auth": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "secret": {
                "type": "string",
                "description": "\nThe secret to use for authentication.\nCan be passed using the SMTP_CRAM_MD5_SECRET environment variable.\n\t\t\t\t\t\t\t\t",
                "description_kind": "markdown",
                "required": true,
                "sensitive": true
              }
            },
            "description": "CRAM-MD5 authentication settings as defined in RFC 2195",
            "description_kind": "markdown"
          },
          "max_items": 1
        },
        "plain_auth": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "identity": {
                "type": "string",
                "description": "\nThe identity to use for authentication.\nUsually the identity should be the empty string, to act as username,\nand this is the default.\nCan be passed using the SMTP_PLAIN_IDENTITY environment variable.\n\t\t\t\t\t\t\t\t",
                "description_kind": "markdown",
                "optional": true
              },
              "password": {
                "type": "string",
                "description": "\nThe password to use for authentication.\nCan be passed using the SMTP_PLAIN_PASSWORD environment variable\n\t\t\t\t\t\t\t\t",
                "description_kind": "markdown",
                "required": true,
                "sensitive": true
              }
            },
            "description": "PLAIN authentication settings as defined in RFC 4616",
            "description_kind": "markdown"
          },
          "max_items": 1
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "smtp_message": {
      "version": 0,
      "block": {
        "attributes": {
          "bcc": {
            "type": [
              "set",
              "string"
            ],
            "description": "BCC recipients of the message",
            "description_kind": "markdown",
            "optional": true
          },
          "body": {
            "type": "string",
            "description": "Body of the message",
            "description_kind": "markdown",
            "required": true
          },
          "cc": {
            "type": [
              "set",
              "string"
            ],
            "description": "CC recipients of the message",
            "description_kind": "markdown",
            "optional": true
          },
          "headers": {
            "type": [
              "map",
              "string"
            ],
            "description": "Extra headers of the message",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "subject": {
            "type": "string",
            "description": "Subject of the message",
            "description_kind": "markdown",
            "required": true
          },
          "to": {
            "type": [
              "set",
              "string"
            ],
            "description": "Direct recipients of the message",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Single SMTP message",
        "description_kind": "markdown"
      }
    }
  }
}
