    "technitium_dns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "catalog": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "dnssec_validation": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "forwarder": {
            "type": "string",
            "description": "The address of the DNS server to be used as a forwarder. This optional parameter is required to be used with Conditional Forwarder zones. A special value `this-server` can be used as a forwarder which when used will forward all the requests internally to this DNS server such that you can override the zone with records and rest of the zone gets resolved via this server. The `initialize_forwarder` parameter must be set to `true` to use this option.",
            "description_kind": "plain",
            "optional": true
          },
          "initialize_forwarder": {
            "type": "bool",
            "description": " Set value as true to initialize the Conditional Forwarder zone with an FWD record or set it to false to create an empty Forwarder zone. Default value is `true`",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "primary_name_server_addresses": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "protocol": {
            "type": "string",
            "description": "The DNS transport protocol to be used by the Conditional Forwarder zone.This optional parameter is used with Conditional Forwarder zones.Valid values are [`Udp`, `Tcp`, `Tls`, `Https`, `Quic`].Default is `Udp`",
            "description_kind": "plain",
            "optional": true
          },
          "tsig_key_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "The type of DNS zone. Valid values are [`Primary`, `Secondary`, `Stub`, `Forwarder`, `SecondaryForwarder`, `Catalog`, `SecondaryCatalog`]",
            "description_kind": "plain",
            "required": true
          },
          "use_soa_serial_date_scheme": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "zone_transfer_protocol": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
