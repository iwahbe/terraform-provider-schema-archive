{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "skip_certificate_verification": {
          "type": "bool",
          "description": "Skip https certificate verification. Useful for servers using self-signed certificates.",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Technitium API token.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "url": {
          "type": "string",
          "description": "The Technitium server URL.",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description": "Technitium DNS provider",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "technitium_record": {
      "version": 0,
      "block": {
        "attributes": {
          "algorithm": {
            "type": "string",
            "description": "The algorithm for DS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "aname": {
            "type": "string",
            "description": "The ANAME value.",
            "description_kind": "markdown",
            "optional": true
          },
          "app_name": {
            "type": "string",
            "description": "The app name for APP records.",
            "description_kind": "markdown",
            "optional": true
          },
          "auto_ipv4_hint": {
            "type": "bool",
            "description": "Whether to use automatic IPv4 hints for SVCB/HTTPS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "auto_ipv6_hint": {
            "type": "bool",
            "description": "Whether to use automatic IPv6 hints for SVCB/HTTPS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "class_path": {
            "type": "string",
            "description": "The class path for APP records.",
            "description_kind": "markdown",
            "optional": true
          },
          "cname": {
            "type": "string",
            "description": "The canonical name for CNAME records.",
            "description_kind": "markdown",
            "optional": true
          },
          "create_ptr_zone": {
            "type": "bool",
            "description": "Specifies if the PTR zone should be automatically created for A/AAAA records.",
            "description_kind": "markdown",
            "optional": true
          },
          "digest": {
            "type": "string",
            "description": "The digest for DS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "digest_type": {
            "type": "string",
            "description": "The digest type for DS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "dname": {
            "type": "string",
            "description": "The DNAME for DNAME records.",
            "description_kind": "markdown",
            "optional": true
          },
          "dnssec_validation": {
            "type": "bool",
            "description": "Whether DNSSEC validation is enabled for FWD records.",
            "description_kind": "markdown",
            "optional": true
          },
          "domain": {
            "type": "string",
            "description": "The domain name for the DNS record (FQN)",
            "description_kind": "markdown",
            "required": true
          },
          "exchange": {
            "type": "string",
            "description": "The exchange server for MX records.",
            "description_kind": "markdown",
            "optional": true
          },
          "flags": {
            "type": "string",
            "description": "The flags for CAA records.",
            "description_kind": "markdown",
            "optional": true
          },
          "forwarder": {
            "type": "string",
            "description": "The forwarder address for FWD records.",
            "description_kind": "markdown",
            "optional": true
          },
          "forwarder_priority": {
            "type": "number",
            "description": "The priority for FWD records.",
            "description_kind": "markdown",
            "optional": true
          },
          "glue": {
            "type": "string",
            "description": "The glue record for NS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "ip_address": {
            "type": "string",
            "description": "The IP address for A or AAAA records.",
            "description_kind": "markdown",
            "optional": true
          },
          "key_tag": {
            "type": "number",
            "description": "The key tag for DS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "mailbox": {
            "type": "string",
            "description": "The mailbox for RP records.",
            "description_kind": "markdown",
            "optional": true
          },
          "name_server": {
            "type": "string",
            "description": "The name server for NS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "naptr_flags": {
            "type": "string",
            "description": "The flags for NAPTR records.",
            "description_kind": "markdown",
            "optional": true
          },
          "naptr_order": {
            "type": "number",
            "description": "The order for NAPTR records.",
            "description_kind": "markdown",
            "optional": true
          },
          "naptr_preference": {
            "type": "number",
            "description": "The preference for NAPTR records.",
            "description_kind": "markdown",
            "optional": true
          },
          "naptr_regexp": {
            "type": "string",
            "description": "The regular expression for NAPTR records.",
            "description_kind": "markdown",
            "optional": true
          },
          "naptr_replacement": {
            "type": "string",
            "description": "The replacement field for NAPTR records.",
            "description_kind": "markdown",
            "optional": true
          },
          "naptr_services": {
            "type": "string",
            "description": "The services for NAPTR records.",
            "description_kind": "markdown",
            "optional": true
          },
          "port": {
            "type": "number",
            "description": "The port for SRV records.",
            "description_kind": "markdown",
            "optional": true
          },
          "preference": {
            "type": "number",
            "description": "The priority for MX records.",
            "description_kind": "markdown",
            "optional": true
          },
          "priority": {
            "type": "number",
            "description": "The priority for SRV records.",
            "description_kind": "markdown",
            "optional": true
          },
          "proxy_address": {
            "type": "string",
            "description": "The proxy address for FWD records.",
            "description_kind": "markdown",
            "optional": true
          },
          "proxy_password": {
            "type": "string",
            "description": "The proxy password for FWD records.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "proxy_port": {
            "type": "number",
            "description": "The proxy port for FWD records.",
            "description_kind": "markdown",
            "optional": true
          },
          "proxy_type": {
            "type": "string",
            "description": "The proxy type for FWD records.",
            "description_kind": "markdown",
            "optional": true
          },
          "proxy_username": {
            "type": "string",
            "description": "The proxy username for FWD records.",
            "description_kind": "markdown",
            "optional": true
          },
          "ptr": {
            "type": "bool",
            "description": "Specifies if this record should create a PTR record for A/AAAA types.",
            "description_kind": "markdown",
            "optional": true
          },
          "ptr_name": {
            "type": "string",
            "description": "The PTR name for PTR records.",
            "description_kind": "markdown",
            "optional": true
          },
          "record_data": {
            "type": "string",
            "description": "The record data for APP records.",
            "description_kind": "markdown",
            "optional": true
          },
          "split_text": {
            "type": "bool",
            "description": "Whether to split TXT record text into multiple character strings.",
            "description_kind": "markdown",
            "optional": true
          },
          "sshfp_algorithm": {
            "type": "string",
            "description": "The SSHFP algorithm.",
            "description_kind": "markdown",
            "optional": true
          },
          "sshfp_fingerprint": {
            "type": "string",
            "description": "The SSHFP fingerprint.",
            "description_kind": "markdown",
            "optional": true
          },
          "sshfp_fingerprint_type": {
            "type": "string",
            "description": "The SSHFP fingerprint type.",
            "description_kind": "markdown",
            "optional": true
          },
          "svc_params": {
            "type": "string",
            "description": "The parameters for SVCB/HTTPS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "svc_priority": {
            "type": "number",
            "description": "The priority for SVCB/HTTPS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "svc_target_name": {
            "type": "string",
            "description": "The target name for SVCB/HTTPS records.",
            "description_kind": "markdown",
            "optional": true
          },
          "tag": {
            "type": "string",
            "description": "The tag for CAA records.",
            "description_kind": "markdown",
            "optional": true
          },
          "target": {
            "type": "string",
            "description": "The target for SRV records.",
            "description_kind": "markdown",
            "optional": true
          },
          "text": {
            "type": "string",
            "description": "The text value for TXT records.",
            "description_kind": "markdown",
            "optional": true
          },
          "tlsa_certificate_association_data": {
            "type": "string",
            "description": "The TLSA certificate association data.",
            "description_kind": "markdown",
            "optional": true
          },
          "tlsa_certificate_usage": {
            "type": "string",
            "description": "The TLSA certificate usage.",
            "description_kind": "markdown",
            "optional": true
          },
          "tlsa_matching_type": {
            "type": "string",
            "description": "The TLSA matching type.",
            "description_kind": "markdown",
            "optional": true
          },
          "tlsa_selector": {
            "type": "string",
            "description": "The TLSA selector.",
            "description_kind": "markdown",
            "optional": true
          },
          "ttl": {
            "type": "number",
            "description": "The time-to-live (TTL) of the DNS record, in seconds.",
            "description_kind": "markdown",
            "required": true
          },
          "txt_domain": {
            "type": "string",
            "description": "The TXT domain for RP records.",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "The DNS record type (e.g., A, AAAA, CNAME, etc.).",
            "description_kind": "markdown",
            "required": true
          },
          "update_svcb_hints": {
            "type": "bool",
            "description": "Whether to update SVCB hints for this record.",
            "description_kind": "markdown",
            "optional": true
          },
          "uri": {
            "type": "string",
            "description": "The URI for URI records.",
            "description_kind": "markdown",
            "optional": true
          },
          "uri_priority": {
            "type": "number",
            "description": "The priority for URI records.",
            "description_kind": "markdown",
            "optional": true
          },
          "uri_weight": {
            "type": "number",
            "description": "The weight for URI records.",
            "description_kind": "markdown",
            "optional": true
          },
          "value": {
            "type": "string",
            "description": "The value for CAA records.",
            "description_kind": "markdown",
            "optional": true
          },
          "weight": {
            "type": "number",
            "description": "The weight for SRV records.",
            "description_kind": "markdown",
            "optional": true
          },
          "zone": {
            "type": "string",
            "description": "The DNS zone name. If not specified, it will be inferred from the domain.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages a DNS record in Technitium DNS Server.",
        "description_kind": "markdown"
      }
    },
    "technitium_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "catalog": {
            "type": "string",
            "description": "The name of the catalog zone to become its member zone. Valid only for `Primary`, `Stub`, and `Forwarder` zones.",
            "description_kind": "markdown",
            "optional": true
          },
          "dnssec_validation": {
            "type": "bool",
            "description": "Set to `true` to enable DNSSEC validation. Valid for Conditional Forwarder zones.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "forwarder": {
            "type": "string",
            "description": "The address of the DNS server to be used as a forwarder. Required for Conditional Forwarder zones.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "initialize_forwarder": {
            "type": "bool",
            "description": "Set to `true` to initialize the Conditional Forwarder zone with an FWD record. Valid for Conditional Forwarder zones.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The domain name for the DNS zone.",
            "description_kind": "markdown",
            "required": true
          },
          "primary_name_server_addresses": {
            "type": "string",
            "description": "List of comma separated IP addresses or domain names of the primary name server. Required for `Secondary`, `SecondaryForwarder`, and `SecondaryCatalog` zones.",
            "description_kind": "markdown",
            "optional": true
          },
          "protocol": {
            "type": "string",
            "description": "The DNS transport protocol to be used by the Conditional Forwarder zone. Valid values are `Udp`, `Tcp`, `Tls`, `Https`, `Quic`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "proxy_address": {
            "type": "string",
            "description": "The proxy server address.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "proxy_password": {
            "type": "string",
            "description": "The proxy server password.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "proxy_port": {
            "type": "number",
            "description": "The proxy server port.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "proxy_type": {
            "type": "string",
            "description": "The type of proxy to be used for conditional forwarding. Valid values are `NoProxy`, `DefaultProxy`, `Http`, `Socks5`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "proxy_username": {
            "type": "string",
            "description": "The proxy server username.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "tsig_key_name": {
            "type": "string",
            "description": "The TSIG key name to be used by `Secondary`, `SecondaryForwarder`, and `SecondaryCatalog` zones.",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "The type of zone to create. Valid values are `Primary`, `Secondary`, `Stub`, `Forwarder`, `SecondaryForwarder`, `Catalog`, `SecondaryCatalog`.",
            "description_kind": "markdown",
            "required": true
          },
          "use_soa_serial_date_scheme": {
            "type": "bool",
            "description": "Set to `true` to enable using date scheme for SOA serial. Valid only with `Primary`, `Forwarder`, and `Catalog` zones.",
            "description_kind": "markdown",
            "optional": true
          },
          "validate_zone": {
            "type": "bool",
            "description": "Set to `true` to enable ZONEMD validation. Valid only for `Secondary` zones.",
            "description_kind": "markdown",
            "optional": true
          },
          "zone_transfer_protocol": {
            "type": "string",
            "description": "The zone transfer protocol to be used by `Secondary`, `SecondaryForwarder`, and `SecondaryCatalog` zones. Valid values are `Tcp`, `Tls`, `Quic`.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages a DNS zone in Technitium DNS Server.",
        "description_kind": "markdown"
      }
    }
  }
}
