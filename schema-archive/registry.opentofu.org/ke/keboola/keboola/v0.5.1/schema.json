{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "hostname_suffix": {
          "type": "string",
          "description": "Hostname suffix for the Keboola Stack (e.g., 'keboola.com'). The provider will automatically prepend 'connection.' to construct the full URL. Can be also provided via KBC_HOSTNAME_SUFFIX environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "API Token used to authenticate against the API. Can be also provided via KBC_TOKEN environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Interact with Keboola Storage API (https://keboola.docs.apiary.io/).",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "keboola_branch": {
      "version": 1,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Branch description",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Branch ID",
            "description_kind": "markdown",
            "computed": true
          },
          "is_default": {
            "type": "bool",
            "description": "Default flag",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Branch name",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Branch resource",
        "description_kind": "markdown"
      }
    },
    "keboola_branch_metadata": {
      "version": 1,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch ID",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Metadata ID",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Metadata key",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Metadata value",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Branch resource",
        "description_kind": "markdown"
      }
    },
    "keboola_component_configuration": {
      "version": 1,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "ID of the branch. If not specified, then default branch will be used.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "change_description": {
            "type": "string",
            "description": "Change description associated with the configuration change.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "component_id": {
            "type": "string",
            "description": "ID of the component.",
            "description_kind": "markdown",
            "required": true
          },
          "configuration": {
            "type": "string",
            "description": "Content of the configuration specified as JSON string.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "created": {
            "type": "string",
            "description": "Timestamp of the configuration creation date.",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Description of the configuration.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "fqn": {
            "type": "string",
            "description": "Fully qualified name for the configuration, composed as branch_id/component_id/configuration_id.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ID of the configuration. If not specified, then will be autogenerated.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_deleted": {
            "type": "bool",
            "description": "Whether configuration has been deleted or not.",
            "description_kind": "plain",
            "computed": true
          },
          "is_disabled": {
            "type": "bool",
            "description": "Whether configuration is enabled or disabled.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the configuration.",
            "description_kind": "plain",
            "required": true
          },
          "rows": {
            "nested_type": {
              "attributes": {
                "change_description": {
                  "type": "string",
                  "description": "Change description associated with the configuration row change.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "configuration_row": {
                  "type": "string",
                  "description": "Content of the configuration row specified as JSON string.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "description": {
                  "type": "string",
                  "description": "Description of the configuration row.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "ID of the configuration row",
                  "description_kind": "plain",
                  "computed": true
                },
                "is_disabled": {
                  "type": "bool",
                  "description": "Whether configuration row is enabled or disabled.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the configuration row.",
                  "description_kind": "plain",
                  "required": true
                },
                "state": {
                  "type": "string",
                  "description": "State of the configuration row.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Rows for the configuration",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages component configurations (https://keboola.docs.apiary.io/#reference/components-and-configurations).",
        "description_kind": "markdown"
      }
    },
    "keboola_component_configuration_row": {
      "version": 0,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "ID of the branch. Mutually exclusive with `configuration_fqn`.",
            "description_kind": "markdown",
            "optional": true
          },
          "change_description": {
            "type": "string",
            "description": "Change description associated with the configuration row change.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "component_id": {
            "type": "string",
            "description": "ID of the component. Mutually exclusive with `configuration_fqn`.",
            "description_kind": "markdown",
            "optional": true
          },
          "configuration": {
            "type": "string",
            "description": "Content of the configuration row as a JSON object.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "configuration_fqn": {
            "type": "string",
            "description": "Fully qualified name for the configuration row. Required if not using branch_id/component_id/configuration_id.",
            "description_kind": "plain",
            "optional": true
          },
          "configuration_id": {
            "type": "string",
            "description": "ID of the configuration. Mutually exclusive with `configuration_fqn`.",
            "description_kind": "markdown",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Description of the configuration row.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Compound ID of the configuration row.",
            "description_kind": "markdown",
            "computed": true
          },
          "is_disabled": {
            "type": "bool",
            "description": "Whether configuration row is enabled or disabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the configuration row.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a configuration row in Keboola. You must specify either `configuration_fqn` or all of `branch_id`, `component_id`, and `configuration_id`.",
        "description_kind": "markdown"
      }
    },
    "keboola_encrypted_value": {
      "version": 1,
      "block": {
        "attributes": {
          "branch_type": {
            "type": "string",
            "description": "Type of the branch where the encrypted value will be used (e.g., 'default', 'dev').",
            "description_kind": "markdown",
            "optional": true
          },
          "component_id": {
            "type": "string",
            "description": "Id of the component where the encrypted value will be used.",
            "description_kind": "markdown",
            "optional": true
          },
          "config_id": {
            "type": "string",
            "description": "Id of the configuration where the encrypted value will be used.",
            "description_kind": "markdown",
            "optional": true
          },
          "encrypted_value": {
            "type": "string",
            "description": "Actual encrypted value of the value attribute. If the value attribute changes to an empty-string then the encrypted value won't update and keep the current one.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Encrypted value identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "value": {
            "type": "string",
            "description": "Value to be encrypted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Encrypted value resource",
        "description_kind": "markdown"
      }
    },
    "keboola_scheduler": {
      "version": 1,
      "block": {
        "attributes": {
          "configuration_id": {
            "type": "string",
            "description": "ID of the configuration that is scheduled to run.",
            "description_kind": "markdown",
            "required": true
          },
          "configuration_version": {
            "type": "string",
            "description": "Version of the configuration to run.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier of the scheduler.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manages scheduler configurations.",
        "description_kind": "markdown"
      }
    }
  }
}
