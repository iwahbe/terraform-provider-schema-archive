                  "required": true
                },
                "auth_uri": {
                  "type": "string",
                  "description": "Auth URI.",
                  "description_kind": "plain",
                  "required": true
                },
                "client_email": {
                  "type": "string",
                  "description": "Client email.",
                  "description_kind": "plain",
                  "required": true
                },
                "client_id": {
                  "type": "string",
                  "description": "Client ID.",
                  "description_kind": "plain",
                  "required": true
                },
                "client_x509_cert_url": {
                  "type": "string",
                  "description": "Client x509 cert URL.",
                  "description_kind": "plain",
                  "required": true
                },
                "private_key": {
                  "type": "string",
                  "description": "Private key.",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "private_key_id": {
                  "type": "string",
                  "description": "Private key ID.",
                  "description_kind": "plain",
                  "required": true
                },
                "project_id": {
                  "type": "string",
                  "description": "GCP project ID.",
                  "description_kind": "plain",
                  "required": true
                },
                "token_uri": {
                  "type": "string",
                  "description": "Token URI.",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description": "Credential type.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Service account credentials for GCS storage.",
              "description_kind": "plain"
            }
          }
        },
        "description": "Manages GCP Cloud Storage file storage. Only Create and Read are supported.",
        "description_kind": "plain"
      }
    },
    "keboola-management_file_storage_s3": {
      "version": 0,
      "block": {
        "attributes": {
          "aws_key": {
            "type": "string",
            "description": "AWS access key.",
            "description_kind": "plain",
            "required": true
          },
          "aws_secret": {
            "type": "string",
            "description": "AWS secret key.",
            "description_kind": "plain",
