    "keboola-management_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "activity_center_project_id": {
            "type": "string",
            "description": "Set ActivityCenter ProjectId. Only maintainer members and superadmins can change this.",
            "description_kind": "plain",
            "optional": true
          },
          "allow_auto_join": {
            "type": "string",
            "description": "Set whether superAdmins need approval to join the organization's projects (default true).",
            "description_kind": "plain",
            "optional": true
          },
          "crm_id": {
            "type": "string",
            "description": "Set CRM ID. Only maintainer members and superadmins can change this.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Organization ID.",
            "description_kind": "plain",
            "computed": true
          },
          "maintainer_id": {
            "type": "string",
            "description": "Assign the organization to another maintainer.",
            "description_kind": "plain",
            "required": true
          },
          "mfa_required": {
            "type": "string",
            "description": "Toggle whether all members of or organization and its projects must have enabled multi-factor authentication (default false).",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Organization name.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Keboola organization.",
        "description_kind": "plain"
      }
    },
    "keboola-management_project": {
      "version": 0,
      "block": {
        "attributes": {
          "data_retention_time_in_days": {
            "type": "string",
            "description": "Data retention in days for Time Travel.",
            "description_kind": "plain",
            "optional": true
          },
          "default_backend": {
            "type": "string",
            "description": "Project default backend: snowflake or redshift; default is snowflake.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Project ID.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Project name.",
            "description_kind": "plain",
            "required": true
          },
          "organization_id": {
            "type": "string",
            "description": "ID of the organization to which the project belongs.",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Project type: one of production, poc, demo; default is production.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Keboola project.",
        "description_kind": "plain"
      }
    },
    "keboola-management_project_feature": {
      "version": 0,
      "block": {
        "attributes": {
          "feature": {
            "type": "string",
            "description": "Feature to add to the project.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique ID for this resource (project_id:feature).",
            "description_kind": "plain",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "ID of the project.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Adds a feature to a Keboola project.",
        "description_kind": "plain"
      }
    },
    "keboola-management_project_invitation": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "Email address of the invited user.",
            "description_kind": "plain",
            "required": true
          },
          "expiration_seconds": {
            "type": "number",
            "description": "After how many seconds the invitation and membership of a user will expire.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Project invitation ID.",
            "description_kind": "plain",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "ID of the project to which the invitation is sent.",
            "description_kind": "plain",
            "required": true
          },
          "reason": {
            "type": "string",
            "description": "Reason for inviting user.",
            "description_kind": "plain",
            "optional": true
          },
          "role": {
            "type": "string",
            "description": "Role to assign to the invited user.",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Status of the invitation (e.g., 'pending', 'accepted', 'expired').",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a Keboola project invitation.",
        "description_kind": "plain"
      }
    },
    "keboola-management_project_token": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket_permissions": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map of bucket permissions, e.g., {\"in.c\": \"main: read\"}.",
            "description_kind": "plain",
            "optional": true
          },
          "can_manage_buckets": {
            "type": "bool",
            "description": "Token has full permissions on tabular storage.",
            "description_kind": "plain",
            "optional": true
          },
          "can_purge_trash": {
            "type": "bool",
            "description": "Allows permanently removing deleted configurations.",
            "description_kind": "plain",
            "optional": true
          },
          "can_read_all_file_uploads": {
            "type": "bool",
            "description": "Token has full permissions to files staging.",
            "description_kind": "plain",
            "optional": true
          },
          "component_access": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of component IDs to grant access for component configurations.",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Token description.",
            "description_kind": "plain",
            "optional": true
          },
          "expires_in": {
            "type": "number",
            "description": "Token lifetime in seconds.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Token ID.",
            "description_kind": "plain",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "ID of the Keboola project.",
            "description_kind": "plain",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "Token value.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manages a Keboola project storage token. The token is a one-time secret and cannot be read after creation.",
        "description_kind": "plain"
      }
    }
  }
}
