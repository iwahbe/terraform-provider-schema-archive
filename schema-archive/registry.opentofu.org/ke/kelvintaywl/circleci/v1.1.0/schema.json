{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "A CircleCI user API token. This can also be set via the `CIRCLE_TOKEN` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "hostname": {
          "type": "string",
          "description": "CircleCI hostname (default: circleci.com). This can also be set via the `CIRCLE_HOSTNAME` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "max_retries": {
          "type": "number",
          "description": "Maximum number of retries for API calls when retry is enabled (default: 3).",
          "description_kind": "markdown",
          "optional": true
        },
        "retry": {
          "type": "bool",
          "description": "Whether to retry API calls when provider receives an HTTP 429 status code (default: false).",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
