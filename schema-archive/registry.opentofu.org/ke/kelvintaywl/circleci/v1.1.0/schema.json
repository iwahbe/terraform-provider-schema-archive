            "description_kind": "markdown",
            "optional": true
          },
          "project_slug": {
            "type": "string",
            "description": "The project-slug for the schedule",
            "description_kind": "markdown",
            "required": true
          },
          "tag": {
            "type": "string",
            "description": "Tag name to trigger scheduled pipeline from (mutually exclusive to branch)",
            "description_kind": "markdown",
            "optional": true
          },
          "timetable": {
            "nested_type": {
              "attributes": {
                "days_of_month": {
                  "type": [
                    "list",
                    "number"
                  ],
                  "description": "Days in a month in which the schedule triggers. This is mutually exclusive with days in a week.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "days_of_week": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Days in a week in which the schedule triggers.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "hours_of_day": {
                  "type": [
                    "list",
                    "number"
                  ],
                  "description": "Hours in a day in which the schedule triggers.",
                  "description_kind": "markdown",
                  "required": true
                },
                "months": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Months in which the schedule triggers. Defaults to all months if not set.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "per_hour": {
                  "type": "number",
                  "description": "Number of times a schedule triggers per hour, value must be between 1 and 60",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Timetable that specifies when a schedule triggers.",
            "description_kind": "markdown",
            "required": true
          },
          "updated_at": {
            "type": "string",
            "description": "The date and time the schedule was last updated",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manages a project's schedule",
        "description_kind": "markdown"
      }
    },
    "circleci_webhook": {
