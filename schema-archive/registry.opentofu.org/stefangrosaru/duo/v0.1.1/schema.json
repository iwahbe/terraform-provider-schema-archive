{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_hostname": {
          "type": "string",
          "description": "Duo Admin API Server hostname",
          "description_kind": "markdown",
          "required": true
        },
        "integration_key": {
          "type": "string",
          "description": "Duo Admin API Integration key",
          "description_kind": "markdown",
          "required": true
        },
        "secret_key": {
          "type": "string",
          "description": "Duo Admin API Secret skey",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "duo_group": {
      "version": 0,
      "block": {
        "attributes": {
          "desc": {
            "type": "string",
            "description": "The description of the group.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the group.",
            "description_kind": "markdown",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "The authentication status of the group. Must be one of: `active` `bypass` `disabled`.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Provides a Duo Group resource.",
        "description_kind": "markdown"
      }
    },
    "duo_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "The email address of this user.",
            "description_kind": "markdown",
            "optional": true
          },
          "firstname": {
            "type": "string",
            "description": "The user's given name.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "lastname": {
            "type": "string",
            "description": "The user's surname.",
            "description_kind": "markdown",
            "optional": true
          },
          "notes": {
            "type": "string",
            "description": "An optional description or notes field. Can be viewed in the Duo Admin Panel.",
            "description_kind": "markdown",
            "optional": true
          },
          "realname": {
            "type": "string",
            "description": "The real name (or full name) of this user.",
            "description_kind": "markdown",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "The user's status. Must be one of: `active` `bypass` `disabled`.",
            "description_kind": "markdown",
            "optional": true
          },
          "username": {
            "type": "string",
            "description": "The name of the user to create.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Provides a Duo User resource.",
        "description_kind": "markdown"
      }
    },
    "duo_user_group_association": {
      "version": 0,
      "block": {
        "attributes": {
          "group_id": {
            "type": "string",
            "description": "The ID of the group to associate with the user.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "user_id": {
            "type": "string",
            "description": "The ID of the user to associate with the group.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Provides a Duo Group resource.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "duo_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "The email address of this user.",
