{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_host": {
          "type": "string",
          "description": "This variable is not required, and only useful for development purposes. Default value is `https://api.omg.lol`. Pass this variable in the provider configuration, or alternatively set the `OMGLOL_API_HOST` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "api_key": {
          "type": "string",
          "description": "Pass this variable in the provider configuration, or alternatively set the `OMGLOL_API_KEY` environment variable. As this is a sensitive variable, it is recommended to set it as an environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "user_email": {
          "type": "string",
          "description": "Pass this variable in the provider configuration, or alternatively set the `OMGLOL_USER_EMAIL` environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "The omg.lol provider provides utilities for working with resources in omg.lol.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "omglol_account_settings": {
      "version": 0,
      "block": {
        "attributes": {
          "communication": {
            "type": "string",
            "description": "Commuinication preferences. Valid values are `email_ok` and `email_not_ok`",
            "description_kind": "markdown",
            "required": true
          },
          "date_format": {
            "type": "string",
            "description": "Date preferences. Valid values are: `iso_8601` for *YYYY-MM-DD*, `dmy` for *DD-MM-YYYY*, and `mdy` for *MM-DD-YYYY*.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "omglol_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "Your omg.lol address to create the record for.",
            "description_kind": "markdown",
            "required": true
          },
          "created_at": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "data": {
            "type": "string",
            "description": "The data to enter into the record.",
            "description_kind": "markdown",
            "required": true
          },
          "fqdn": {
            "type": "string",
            "description": "The fully qualified domain name of the record. Made by combining DNS name, address, and omg.lol top-level.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The prefix to attach before the address. Enter `@` to use the apex.",
            "description_kind": "markdown",
            "required": true
          },
          "priority": {
            "type": "number",
            "description": "The priority of the record. Only applies to MX records.",
            "description_kind": "markdown",
            "optional": true
          },
          "ttl": {
            "type": "number",
            "description": "The Time-To-Live (TTL) of the record.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "The record type. Valid values are `A`, `AAAA`, `CAA`, `CNAME`, `TXT`, `MX`, `NS`, and `SRV`.",
            "description_kind": "markdown",
            "required": true
          },
          "updated_at": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manage omg.lol DNS records.",
        "description_kind": "markdown"
      }
    },
    "omglol_purl": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "Your omg.lol address to create the pURL for.",
            "description_kind": "markdown",
            "required": true
          },
          "counter": {
            "type": "number",
            "description": "The number of time a PURL has been accessed.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "listed": {
            "type": "bool",
            "description": "Set true to list on your `address`.url.lol page.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the PURL. The name field is how you will access your designated URL.",
            "description_kind": "markdown",
            "required": true
          },
          "updated_at": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "The URL to link to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage omg.lol Persistent URLs.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "omglol_account_info": {
      "version": 0,
      "block": {
        "attributes": {
          "created": {
            "type": "string",
            "description": "The RFC 3339 representation of the time that the account was created. This can be used in conjunction with the [formatdate](https://developer.hashicorp.com/terraform/language/functions/formatdate) function.",
            "description_kind": "markdown",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "The email address associated with the account.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name associated with the account.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieve account info.",
        "description_kind": "markdown"
      }
    },
    "omglol_dns_records": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "The omg.lol address to read the records from.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "records": {
            "nested_type": {
              "attributes": {
                "created_at": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "data": {
                  "type": "string",
                  "description": "The data entered into the record.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "fqdn": {
                  "type": "string",
                  "description": "The fully qualified domain name of the record. Made by combining DNS name, address, and omg.lol top-level.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The prefix attached before the address. `@` represents the apex.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "priority": {
                  "type": "number",
                  "description": "The priority of the record. Only applies to MX records.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "ttl": {
                  "type": "number",
                  "description": "The Time-To-Live (TTL) of the record.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "The record type.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "updated_at": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "A list of all the DNS records for the given address.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "List all DNS records for a given omg.lol address.",
        "description_kind": "markdown"
      }
    },
    "omglol_purls": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "The omg.lol address to read the purls from.",
            "description_kind": "markdown",
            "required": true
          },
          "purls": {
            "nested_type": {
              "attributes": {
                "counter": {
                  "type": "number",
                  "description": "The number of time a PURL has been accessed.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Unique ID of the PURL. Can be used for imports.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "listed": {
                  "type": "bool",
                  "description": "Returns `true` if listed on your `address`.url.lol page.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the PURL. The name field is how you will access your designated URL.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "url": {
                  "type": "string",
                  "description": "The url that is pointed to.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "A list of all the PURLs for the given address.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "List all PURLs for a given omg.lol address.",
        "description_kind": "markdown"
      }
    }
  }
}
