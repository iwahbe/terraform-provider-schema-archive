{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "Host address of The One API, if not provided ENV['LOTR_API_HOST'] will be used",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "An API token for The One API, if not provided ENV['LOTR_API_TOKEN'] will be used",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "The Lord of The Rings API provider based on The One API",
      "description_kind": "markdown"
    }
  },
  "data_source_schemas": {
    "lotr_character": {
      "version": 0,
      "block": {
        "attributes": {
          "characters": {
            "nested_type": {
              "attributes": {
                "birth": {
                  "type": "string",
                  "description": "birth of a character",
                  "description_kind": "markdown",
                  "computed": true
                },
                "death": {
                  "type": "string",
                  "description": "death of a character",
                  "description_kind": "markdown",
                  "computed": true
                },
                "gender": {
                  "type": "string",
                  "description": "gender of a character",
                  "description_kind": "markdown",
                  "computed": true
                },
                "hair": {
                  "type": "string",
                  "description": "hair of a character",
                  "description_kind": "markdown",
                  "computed": true
                },
                "height": {
                  "type": "string",
                  "description": "Height of a character",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Character identifier",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "name of a character",
                  "description_kind": "markdown",
                  "computed": true
                },
                "race": {
                  "type": "string",
                  "description": "race of a character",
                  "description_kind": "markdown",
                  "computed": true
                },
                "realm": {
                  "type": "string",
                  "description": "realm of a character",
                  "description_kind": "markdown",
                  "computed": true
                },
                "spouse": {
                  "type": "string",
                  "description": "spouse of a character",
                  "description_kind": "markdown",
                  "computed": true
                },
                "wiki_url": {
                  "type": "string",
                  "description": "wiki of a character",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of Lord of the Rings characters",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Character featuring in Lord of The Rings",
        "description_kind": "markdown"
      }
    }
  }
}
