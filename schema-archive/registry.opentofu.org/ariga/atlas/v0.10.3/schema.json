{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "binary_path": {
          "type": "string",
          "description": "The path to the atlas-cli binary. If not set, the provider will look for the binary in the PATH.",
          "description_kind": "plain",
          "optional": true
        },
        "dev_url": {
          "type": "string",
          "description": "The URL of the dev database. This configuration is shared for all resources if there is no config on the resource.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "block_types": {
        "cloud": {
          "nesting_mode": "single",
          "block": {
            "attributes": {
              "project": {
                "type": "string",
                "description_kind": "plain",
                "deprecated": true,
                "optional": true
              },
              "repo": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "token": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "url": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              }
            },
            "description_kind": "plain"
          }
        }
      },
      "description": "The Atlas provider is used to manage your database migrations, using the DDL of Atlas.\nFor documentation about Atlas, visit: https://atlasgo.io",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "atlas_migration": {
      "version": 0,
      "block": {
        "attributes": {
          "baseline": {
            "type": "string",
            "description": "An optional version to start the migration history from. See https://atlasgo.io/versioned/apply#existing-databases",
            "description_kind": "plain",
            "optional": true
          },
          "config": {
            "type": "string",
            "description": "Atlas HCL configuration content. Use abspath(path.module) when referencing local files or directories, for example: `file://${abspath(path.module)}/migrations`. See https://atlasgo.io/hcl/config",
            "description_kind": "plain",
            "optional": true
          },
          "dev_url": {
            "type": "string",
            "description": "The url of the dev-db see https://atlasgo.io/cli/url",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "dir": {
            "type": "string",
            "description": "the URL of the migration directory. dir or remote_dir block is required",
            "description_kind": "plain",
            "optional": true
          },
          "env_name": {
            "type": "string",
            "description": "The name of the environment used for reporting runs to Atlas Cloud. Default: tf",
            "description_kind": "plain",
            "optional": true
          },
          "exec_order": {
            "type": "string",
            "description": "How Atlas computes and executes pending migration files to the database. One of `linear`,`linear-skip` or `non-linear`. See https://atlasgo.io/versioned/apply#execution-order",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The ID of this resource",
            "description_kind": "plain",
            "computed": true
          },
          "revisions_schema": {
            "type": "string",
            "description": "The name of the schema the revisions table resides in",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": [
              "object",
              {
                "current": "string",
                "latest": "string",
                "next": "string",
                "status": "string"
              }
            ],
            "description": "The status of the migration",
            "description_kind": "plain",
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "The url of the database see https://atlasgo.io/cli/url",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "variables": {
            "type": "string",
            "description": "Stringify JSON object containing variables to be used inside the Atlas configuration file.",
            "description_kind": "plain",
            "optional": true
          },
          "version": {
            "type": "string",
            "description": "The version of the migration to apply, if not specified the latest version will be applied",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "cloud": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "project": {
                  "type": "string",
                  "description_kind": "plain",
                  "deprecated": true,
                  "optional": true
                },
                "repo": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "token": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          },
          "protected_flows": {
            "nesting_mode": "single",
            "block": {
              "block_types": {
                "migrate_down": {
                  "nesting_mode": "single",
                  "block": {
                    "attributes": {
                      "allow": {
                        "type": "bool",
                        "description": "Allow allows the flow to be executed.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "auto_approve": {
                        "type": "bool",
                        "description": "AutoApprove allows the flow to be automatically approved.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description": "migrate_down defines policies for down migrations.",
                    "description_kind": "plain"
                  }
                }
              },
              "description": "ProtectedFlows defines the protected flows of a deployment.",
              "description_kind": "plain"
            }
          },
          "remote_dir": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "The name of the remote directory. This attribute is required when remote_dir is set",
                  "description_kind": "plain",
                  "optional": true
                },
                "tag": {
                  "type": "string",
                  "description": "The tag of the remote directory",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain",
              "deprecated": true
            }
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "Timeout defaults to 20 mins. A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "Timeout defaults to 20 mins. A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "The resource applies pending migration files on the connected database.See https://atlasgo.io/",
        "description_kind": "plain"
      }
    },
    "atlas_schema": {
      "version": 0,
      "block": {
        "attributes": {
          "config": {
            "type": "string",
            "description": "Atlas HCL configuration content. Use abspath(path.module) when referencing local files or directories, for example: `file://${abspath(path.module)}/migrations`. See https://atlasgo.io/hcl/config",
            "description_kind": "plain",
            "optional": true
          },
          "dev_url": {
            "type": "string",
            "description": "The url of the dev-db see https://atlasgo.io/cli/url",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "env_name": {
            "type": "string",
            "description": "The name of the environment used for reporting runs to Atlas Cloud. Default: tf",
            "description_kind": "plain",
            "optional": true
          },
          "exclude": {
            "type": [
              "list",
              "string"
            ],
            "description": "Filter out resources matching the given glob pattern. See https://atlasgo.io/declarative/inspect#exclude",
            "description_kind": "plain",
            "optional": true
          },
          "hcl": {
            "type": "string",
            "description": "The schema definition for the database (preferably normalized - see `atlas_schema` data source)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of this resource",
            "description_kind": "plain",
            "computed": true
          },
          "include": {
            "type": [
              "list",
              "string"
            ],
            "description": "Include only resources that match the given glob pattern. See https://atlasgo.io/declarative/inspect#include",
            "description_kind": "plain",
            "optional": true
          },
          "tx_mode": {
            "type": "string",
            "description": "The transaction mode to use when applying the schema. See https://atlasgo.io/versioned/apply#transaction-configuration",
            "description_kind": "plain",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "The url of the database see https://atlasgo.io/cli/url",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "variables": {
            "type": "string",
            "description": "Stringify JSON object containing variables to be used inside the Atlas configuration file.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "cloud": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "project": {
                  "type": "string",
                  "description_kind": "plain",
                  "deprecated": true,
                  "optional": true
                },
                "repo": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "token": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          },
          "diff": {
            "nesting_mode": "single",
            "block": {
              "block_types": {
                "concurrent_index": {
                  "nesting_mode": "single",
                  "block": {
                    "attributes": {
                      "create": {
                        "type": "bool",
                        "description": "Whether to create indexes concurrently",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "drop": {
                        "type": "bool",
                        "description": "Whether to drop indexes concurrently",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description": "The concurrent index policy",
                    "description_kind": "plain"
                  }
                },
                "skip": {
                  "nesting_mode": "single",
                  "block": {
                    "attributes": {
                      "add_column": {
                        "type": "bool",
                        "description": "Whether to skip adding columns",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "add_foreign_key": {
                        "type": "bool",
                        "description": "Whether to skip adding foreign keys",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "add_index": {
                        "type": "bool",
                        "description": "Whether to skip adding indexes",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "add_schema": {
                        "type": "bool",
                        "description": "Whether to skip adding schemas",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "add_table": {
                        "type": "bool",
                        "description": "Whether to skip adding tables",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "drop_column": {
                        "type": "bool",
                        "description": "Whether to skip dropping columns",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "drop_foreign_key": {
                        "type": "bool",
                        "description": "Whether to skip dropping foreign keys",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "drop_index": {
                        "type": "bool",
                        "description": "Whether to skip dropping indexes",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "drop_schema": {
                        "type": "bool",
                        "description": "Whether to skip dropping schemas",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "drop_table": {
                        "type": "bool",
                        "description": "Whether to skip dropping tables",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "modify_column": {
                        "type": "bool",
                        "description": "Whether to skip modifying columns",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "modify_foreign_key": {
                        "type": "bool",
                        "description": "Whether to skip modifying foreign keys",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "modify_index": {
                        "type": "bool",
                        "description": "Whether to skip modifying indexes",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "modify_schema": {
                        "type": "bool",
                        "description": "Whether to skip modifying schemas",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "modify_table": {
                        "type": "bool",
                        "description": "Whether to skip modifying tables",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description": "The skip changes policy",
                    "description_kind": "plain"
                  }
                }
              },
              "description_kind": "plain"
            }
          },
          "lint": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "review": {
                  "type": "string",
                  "description": "The review policy. One of `ALWAYS`, `WARNING` and `ERROR`.",
                  "description_kind": "plain",
                  "optional": true
                },
                "review_timeout": {
                  "type": "string",
                  "description": "The review timeout. The time to wait for the review to be approved. Valid time unit are 's' (seconds), 'm' (minutes), 'h' (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "The lint policy",
              "description_kind": "plain"
            }
          }
        },
        "description": "Atlas database resource manages the data schema of the database, using an HCL file describing the wanted state of the database. See https://atlasgo.io/",
        "description_kind": "plain"
      }
    }
  },
