  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_version": {
          "type": "string",
          "description": "Api version to use (defaults to v5). Lower versions than v4 might not work correctly or at all. For more information https://teampasswordmanager.com/docs",
          "description_kind": "plain",
          "deprecated": true,
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "Host of the team password manager. (ie: http://localhost:8081)",
          "description_kind": "plain",
          "required": true
        },
        "private_key": {
          "type": "string",
          "description": "Private key from http://{ host }/index.php/user_info/api_keys",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "public_key": {
          "type": "string",
          "description": "Public key from http://{ host }/index.php/user_info/api_keys",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "tls_skip_verify": {
          "type": "bool",
          "description": "Whether the TLS certificate verification should be skipped (defaults to false).",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
