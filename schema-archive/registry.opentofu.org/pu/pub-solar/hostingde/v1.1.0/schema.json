{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "account_id": {
          "type": "string",
          "description": "Account ID for hosting.de API. May also be provided via HOSTINGDE_ACCOUNT_ID environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "auth_token": {
          "type": "string",
          "description": "Auth token for hosting.de API. May also be provided via HOSTINGDE_AUTH_TOKEN environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "base_url": {
          "type": "string",
          "description": "Base URL for hosting.de API. May also be provided via HOSTINGDE_BASE_URL environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "hostingde_record": {
      "version": 0,
      "block": {
        "attributes": {
          "comments": {
            "type": "string",
            "description": "Comment to the record.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "content": {
            "type": "string",
            "description": "Content of the DNS record.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "DNS record ID",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the record. Example: mail.example.com.",
            "description_kind": "plain",
            "required": true
          },
          "priority": {
            "type": "number",
            "description": "Priority of MX and SRV records.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ttl": {
            "type": "number",
            "description": "TTL of the DNS record in seconds. Minimum is 60, maximum is 31556926. Defaults to 3600.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Type of the DNS record. Valid types are A, AAAA, ALIAS, CAA, CERT, CNAME, DNSKEY, DS, MX, NS, NSEC, NSEC3, NSEC3PARAM, NULLMX, OPENPGPKEY, PTR, RRSIG, SRV, SSHFP, TLSA, and TXT.",
            "description_kind": "plain",
            "required": true
          },
          "zone_id": {
            "type": "string",
            "description": "ID of DNS zone that the record belongs to.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "hostingde_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "The hostmaster email address. Only relevant if the type is NATIVE or MASTER. If the field is left empty, the default is hostmaster@name.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Numeric identifier of the zone.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Domain name (top-level domain) of the zone.",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "The zone type. Valid types are NATIVE, MASTER, and SLAVE. Changing this forces re-creation of the zone.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
