{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "auth_mode": {
          "type": "string",
          "description": "The auth_mode of Nebraska server. Can be configured using the env variable `NEBRASKA_AUTH_MODE`, if not provided defaults to `noop`.",
          "description_kind": "markdown",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "The address of Nebraska server. Can be configured using the env variable `NEBRASKA_ENDPOINT`, if not provided defaults to `http://localhost:8000`.",
          "description_kind": "markdown",
          "optional": true
        },
        "github_token": {
          "type": "string",
          "description": "The github_token used to authenticate when the auth_mode is `github`. Can be configured using the env variable `NEBRASKA_GH_TOKEN`",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The password used to authenticate when the auth_mode is `oidc`. Can be configured using the env variable `NEBRASKA_PASSWORD`",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "The username used to authenticate when the auth_mode is `oidc`. Can be configured using the env variable `NEBRASKA_USERNAME`",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "nebraska_application": {
      "version": 0,
      "block": {
        "attributes": {
          "created_ts": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "A description of the application",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "product_id": {
            "type": "string",
            "description": "product id of app",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "A nebraska application",
        "description_kind": "markdown"
      }
    },
    "nebraska_channel": {
      "version": 0,
      "block": {
        "attributes": {
          "application_id": {
            "type": "string",
            "description": "ID of the application this channel belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "arch": {
            "type": "string",
            "description": "Arch. Cannot be changed once created.",
            "description_kind": "markdown",
            "required": true
          },
          "color": {
            "type": "string",
            "description": "Hex color code that informs the color of the channel in the UI.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "created_ts": {
            "type": "string",
            "description": "Creation timestamp.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the channel. Can be an existing one as long as the arch is different.",
            "description_kind": "markdown",
            "required": true
          },
          "package_id": {
            "type": "string",
            "description": "The id of the package this channel provides.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "A release channel that provides a particular package version.",
        "description_kind": "markdown"
      }
    },
    "nebraska_group": {
      "version": 0,
      "block": {
        "attributes": {
          "application_id": {
            "type": "string",
            "description": "ID of the application this group belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "channel_id": {
            "type": "string",
            "description": "The channel this group provides.",
            "description_kind": "markdown",
            "optional": true
          },
          "created_ts": {
            "type": "string",
            "description": "Creation timestamp",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "A description of the group.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the group.",
            "description_kind": "markdown",
            "required": true
          },
          "policy_max_updates_per_period": {
            "type": "number",
            "description": "The maximum number of updates that can be performed within the `policy_period_interval`. Defaults to `1`.",
            "description_kind": "markdown",
            "optional": true
          },
          "policy_office_hours": {
            "type": "bool",
            "description": "Only update between 9am and 5pm. Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "policy_period_interval": {
            "type": "string",
            "description": "Period used in combination with `policy_max_updates_per_period`. Defaults to `1 hours`.",
            "description_kind": "markdown",
            "optional": true
          },
          "policy_safe_mode": {
            "type": "bool",
            "description": "Safe mode will only update 1 instance at a time, and stop if an update fails. Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "policy_timezone": {
            "type": "string",
            "description": "Timezone used to inform `policy_office_hours`. Defaults to `Asia/Calcutta`.",
            "description_kind": "markdown",
            "optional": true
          },
          "policy_update_timeout": {
            "type": "string",
            "description": "Timeout for updates Defaults to `1 days`.",
            "description_kind": "markdown",
            "optional": true
          },
          "policy_updates_enabled": {
            "type": "bool",
            "description": "Enable updates. Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "rollout_in_progress": {
            "type": "bool",
            "description": "Indicates whether a rollout is currently in progress for this group.",
            "description_kind": "markdown",
            "computed": true
          },
          "track": {
            "type": "string",
            "description": "Identifier for clients, filled with the group ID if omitted.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "A group provides a particular release channel to machines and controls various options that manage the update procedure.",
        "description_kind": "markdown"
      }
    },
    "nebraska_package": {
      "version": 0,
      "block": {
        "attributes": {
          "application_id": {
            "type": "string",
            "description": "ID of the application this package belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "arch": {
            "type": "string",
            "description": "Package arch. Defaults to `all`.",
            "description_kind": "markdown",
            "optional": true
          },
          "channels_blacklist": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of channels (by id) that cannot point to this package.",
            "description_kind": "markdown",
            "optional": true
          },
          "created_ts": {
            "type": "string",
            "description": "Creation timestamp.",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "A description of the package.",
            "description_kind": "markdown",
            "required": true
          },
          "filename": {
            "type": "string",
            "description": "The filename of the package.",
            "description_kind": "markdown",
            "required": true
          },
          "hash": {
            "type": "string",
            "description": "A base64 encoded sha1 hash of the package digest. Tip: `cat update.gz | openssl dgst -sha1 -binary | base64`.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "nua_commit": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "nua_kustomize_config": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "nua_namespace": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "size": {
            "type": "string",
            "description": "The size, in bytes.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of package. Defaults to `flatcar`.",
            "description_kind": "markdown",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "URL where the package is available.",
            "description_kind": "markdown",
            "required": true
          },
          "version": {
            "type": "string",
            "description": "Package version.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "flatcar_action": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "chromeos_version": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "created_ts": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "deadline": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "disable_payload_backoff": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                },
                "event": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "is_delta": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                },
                "metadata_signature_rsa": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "metadata_size": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "needs_admin": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                },
                "sha256": {
                  "type": "string",
                  "description": "A base64 encoded sha256 hash of the action. Tip: `cat update.gz | openssl dgst -sha256 -binary | base64`.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "A Flatcar specific Omaha action.",
              "description_kind": "markdown"
            },
            "max_items": 1
          }
        },
        "description": "A versioned package of the application.",
        "description_kind": "markdown"
      }
    }
  },
