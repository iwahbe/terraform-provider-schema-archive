{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "client_id": {
          "type": "string",
          "description": "Strava API application ID. May also be provided via the STRAVA_CLIENT_ID environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "Strava API application secret. May also be provided via the STRAVA_CLIENT_SECRET environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Interact with Strava.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "strava_push_subscription": {
      "version": 0,
      "block": {
        "attributes": {
          "application_id": {
            "type": "number",
            "description": "Strava API application ID.",
            "description_kind": "plain",
            "computed": true
          },
          "callback_url": {
            "type": "string",
            "description": "Address where webhook events will be sent; maximum length of 255 characters.",
            "description_kind": "plain",
            "required": true
          },
          "created_at": {
            "type": "string",
            "description": "Date and time the subscription was created.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Push subscription ID.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update to the push subscription.",
            "description_kind": "plain",
            "computed": true
          },
          "resource_state": {
            "type": "number",
            "description": "State of the push subscription.",
            "description_kind": "plain",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "Date and time the subscription was last updated.",
            "description_kind": "plain",
            "computed": true
          },
          "verify_token": {
            "type": "string",
            "description": "String chosen by the application owner for client security. An identical string will be included in the validation request made by Strava's subscription service.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Manages a Strava push subscription.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "strava_push_subscriptions": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Placeholder identifier attribute.",
            "description_kind": "plain",
            "computed": true
          },
          "push_subscriptions": {
            "nested_type": {
              "attributes": {
                "application_id": {
                  "type": "number",
                  "description": "Strava API application ID.",
                  "description_kind": "plain",
                  "computed": true
                },
                "callback_url": {
                  "type": "string",
                  "description": "Address where webhook events will be sent; maximum length of 255 characters.",
                  "description_kind": "plain",
                  "computed": true
                },
                "created_at": {
                  "type": "string",
                  "description": "Date and time the subscription was created.",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Push subscription ID.",
                  "description_kind": "plain",
                  "computed": true
                },
                "resource_state": {
                  "type": "number",
                  "description": "State of the subscription.",
                  "description_kind": "plain",
                  "computed": true
                },
                "updated_at": {
                  "type": "string",
                  "description": "Date and time the subscription was last updated.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of push subscriptions.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches the list of push subscriptions.",
        "description_kind": "plain"
      }
    }
  }
}
