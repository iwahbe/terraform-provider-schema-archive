{
  "provider": {
    "version": 0,
    "block": {
      "block_types": {
        "ckbox": {
          "nesting_mode": "single",
          "block": {
            "attributes": {
              "base_url": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "email": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "organization_id": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "password": {
                "type": "string",
                "description_kind": "plain",
                "optional": true,
                "sensitive": true
              },
              "subscription_id": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              }
            },
            "description_kind": "plain"
          }
        },
        "gobright": {
          "nesting_mode": "single",
          "block": {
            "attributes": {
              "base_url": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "login": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "organization_code": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "password": {
                "type": "string",
                "description_kind": "plain",
                "optional": true,
                "sensitive": true
              }
            },
            "description_kind": "plain"
          }
        },
        "zitadel": {
          "nesting_mode": "single",
          "block": {
            "attributes": {
              "api": {
                "type": "string",
                "description": "gRPC endpoint host:port, e.g. example.zitadel.cloud:443",
                "description_kind": "plain",
                "optional": true
              },
              "insecure": {
                "type": "bool",
                "description": "Disable TLS on the gRPC connection (local dev only)",
                "description_kind": "plain",
                "optional": true
              },
              "issuer": {
                "type": "string",
                "description": "OIDC issuer, e.g. https://example.zitadel.cloud",
                "description_kind": "plain",
                "optional": true
              },
              "key": {
                "type": "string",
                "description": "PEM-encoded RSA private key whose public counterpart is registered for user_id",
                "description_kind": "plain",
                "optional": true,
                "sensitive": true
              },
              "user_id": {
                "type": "string",
                "description": "SystemAPIUser id configured in Zitadel",
                "description_kind": "plain",
                "optional": true
              }
            },
            "description": "Zitadel SystemAPI access for managing instances on a Zitadel tenant. Authenticates as a configured SystemAPIUser via JWT profile.",
            "description_kind": "plain"
          }
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "saasutils_ckbox_access_key": {
      "version": 0,
      "block": {
        "attributes": {
          "env_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "saasutils_ckbox_env": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "saasutils_gobright_integration": {
      "version": 0,
      "block": {
        "attributes": {
          "external_system": {
            "type": "string",
            "description": "Integration type. One of `openid` (GoBright externalSystem=14) or `office365` (=1).",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "new_id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "oidc": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "audience": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "issuer": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "jwks_endpoint": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "public_key": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "related_user_integration_id": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "token_replay_prevention_mode": {
                  "type": "bool",
                  "description": "GoBright `oidcTokenReplayPreventionMode` projected to a boolean (false=0, true=1).",
                  "description_kind": "plain",
                  "required": true
                },
                "user_identifier_claim_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "validation_mode": {
                  "type": "bool",
                  "description": "GoBright `oidcValidationMode` projected to a boolean (false=0, true=1).",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "OIDC configuration. The block is required; `fromModel` returns an error if it is omitted.",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "saasutils_zitadel_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "custom_domain": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "default_language": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "first_org_id": {
            "type": "string",
            "description": "ID of the instance's first organization (named by `first_org_name`, or `instance_name` when unset), resolved after the instance reaches STATE_RUNNING. Empty when no credentials are available to query it.",
            "description_kind": "plain",
            "computed": true
          },
          "first_org_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Instance ID returned by Zitadel.",
            "description_kind": "plain",
            "computed": true
          },
          "instance_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "pat": {
            "type": "string",
            "description": "Personal Access Token returned by Zitadel when creating the instance. Empty if not requested.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "ready_timeout": {
            "type": "string",
            "description": "Maximum time to wait for the new instance to reach STATE_RUNNING, as a Go duration (e.g. \"30s\", \"2m\"). Defaults to 30s.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "human": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "email": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "first_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "is_email_verified": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "last_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "password": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "password_change_required": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true
                },
                "preferred_language": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "user_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Human owner of the new instance. Mutually exclusive with `machine`; exactly one of the two must be set. All fields are create-only.",
              "description_kind": "plain"
            }
          },
          "machine": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "user_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "personal_access_token": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "expiration_date": {
                        "type": "string",
                        "description": "RFC3339 timestamp for PAT expiration. Omit for no expiration.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description": "If present, a Personal Access Token is issued for the machine user and returned as `pat`.",
                    "description_kind": "plain"
                  }
                }
              },
              "description": "Machine (service account) owner of the new instance. Mutually exclusive with `human`; exactly one of the two must be set. All fields are create-only.",
              "description_kind": "plain"
            }
          }
        },
        "description": "Creates a Zitadel instance on the configured Zitadel tenant via the SystemAPI. Only `instance_name` is updatable; changing any other field forces a replacement.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "saasutils_ckbox_env": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "saasutils_gobright_integration": {
      "version": 0,
      "block": {
        "attributes": {
          "external_system": {
            "type": "string",
            "description": "Filter: integration type. One of `openid` (GoBright externalSystem=14) or `office365` (=1).",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Stringified GoBright integer id.",
            "description_kind": "plain",
            "computed": true
          },
          "microsoft_permission_mode": {
            "type": "bool",
            "description": "Filter: GoBright `microsoftPermissionMode` projected to a boolean (false=0, true=1). Omit (or set `null`) to match integrations where the API returns null \u2014 typical for OIDC integrations.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Filter: GoBright integration `name` (exact match).",
            "description_kind": "plain",
            "required": true
          },
          "new_id": {
            "type": "string",
            "description": "Server-generated GUID.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "oidc": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "audience": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "issuer": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "jwks_endpoint": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "public_key": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "related_user_integration_id": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "token_replay_prevention_mode": {
                  "type": "bool",
                  "description": "GoBright `oidcTokenReplayPreventionMode` projected to a boolean (false=0, true=1).",
                  "description_kind": "plain",
                  "computed": true
                },
                "user_identifier_claim_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "validation_mode": {
                  "type": "bool",
                  "description": "GoBright `oidcValidationMode` projected to a boolean (false=0, true=1).",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "description": "OIDC fields from the matched integration. Populated by the data source's Read.",
              "description_kind": "plain"
            }
          }
        },
        "description": "Look up an existing GoBright integration by name + external_system + microsoft_permission_mode. Errors if the filters do not identify exactly one integration.",
        "description_kind": "plain"
      }
    }
  },
  "functions": {
    "customers_config": {
      "description": "Compute customer configurations with product and feature inheritance",
      "summary": "Compute customer configurations with product and feature inheritance",
      "return_type": "dynamic",
      "parameters": [
        {
          "name": "customers",
          "description": "Map of customer configurations",
          "type": "dynamic"
        },
        {
          "name": "products",
          "description": "Map of product definitions",
          "type": "dynamic"
        },
        {
          "name": "features",
          "description": "Map of feature definitions",
          "type": "dynamic"
        }
      ]
    },
    "icase_asgid": {
      "description": "Work around Azure ASG case plague",
      "summary": "Generate Azure ASG id with upper or lower case resource group and ASG name",
      "return_type": "string",
      "parameters": [
        {
          "name": "uppercase",
          "description": "when true, switch RG and ASG to uppercase",
          "type": "bool"
        },
        {
          "name": "asgid",
          "description": "the asg identifier",
          "type": "string"
        }
      ]
    },
    "jwt_sign": {
      "description": "Builds a JWT with aud=Environment ID and signs it with HS256 using the Access key. Optionally includes sub, CKBox role, and exp via ttl_seconds.",
      "summary": "Generate and sign CKEditor Cloud JWT (HS256)",
      "return_type": "string",
      "parameters": [
        {
          "name": "environment_id",
          "description": "Cloud Environment ID (maps to aud).",
          "type": "string"
        },
        {
          "name": "access_key",
          "description": "Access key used as HS256 secret (signature key).",
          "type": "string"
        },
        {
          "name": "sub",
          "description": "Optional user id (sub). If empty or null, omitted.",
          "type": "string"
        },
        {
          "name": "ckbox_role",
          "description": "Optional CKBox role (auth.ckbox.role), e.g. admin. If empty or null, auth is omitted.",
          "type": "string"
        },
        {
          "name": "ttl_seconds",
          "description": "Optional token TTL in seconds. If > 0, exp = iat + ttl_seconds is added. Default: 0 (no exp).",
          "type": "number"
        },
        {
          "name": "iat_unix",
          "description": "Optional issued-at unix seconds. If set, used instead of current time.",
          "type": "number"
        }
      ]
    },
    "secrets_config": {
      "description": "This function handles the secrets processing domain, taking processed customer/product data as input.",
      "summary": "Compute secrets lists for customer features and components",
      "return_type": "dynamic",
      "parameters": [
        {
          "name": "customers_config",
          "description": "Output from customers_config function. Contains: inherit_customer, inherit_product, and inherit_products_subfeatures maps.",
          "type": "dynamic"
        },
        {
          "name": "features",
          "description": "Map of feature definitions. Each feature can have: subfeatures (map of bools), required_config_params (list of strings), and involved_secrets (map with fields and depends_on).",
          "type": "dynamic"
        },
        {
          "name": "component_secrets",
          "description": "Map of component-specific secrets configuration. Structure: component -> secret -> {fields: []}",
          "type": "dynamic"
        }
      ]
    }
  }
}
