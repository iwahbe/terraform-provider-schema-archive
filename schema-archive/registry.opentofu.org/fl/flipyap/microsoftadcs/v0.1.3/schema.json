{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "Hostname of the Server hosting the Active Directory Certificate Services",
          "description_kind": "markdown",
          "optional": true
        },
        "krb5conf": {
          "type": "string",
          "description": "Kerberos Config to use for authentication",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Active Directory Password for Kerberos authentication",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "use_ntlm": {
          "type": "bool",
          "description": "Use NTLM authentication",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Active Directory Username for Kerberos authentication",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "microsoftadcs_certificate": {
      "version": 0,
      "block": {
        "attributes": {
          "attributes": {
            "type": "string",
            "description": "Extra attributes to add to the certificate",
            "description_kind": "plain",
            "optional": true
          },
          "certificate_b64": {
            "type": "string",
            "description": "The certificate returned from ADCS as base64 encoded.",
            "description_kind": "plain",
            "computed": true
          },
          "certificate_chain_b64": {
            "type": "string",
            "description": "The certificate chain returned from ADCS as base64 encoded.",
            "description_kind": "plain",
            "computed": true
          },
          "certificate_signing_request": {
            "type": "string",
            "description": "The certificate signing request used to create a certificate ",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Numeric identifier of the generated certificate.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "template": {
            "type": "string",
            "description": "There are usually several predefined templates that make it easier to request certificates \ndepending on what they are needed for.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "microsoftadcs_certificate": {
      "version": 0,
      "block": {
        "attributes": {
          "certificate_b64": {
            "type": "string",
            "description": "The certificate returned from ADCS as base64 encoded.",
            "description_kind": "plain",
            "computed": true
          },
          "certificate_chain_b64": {
            "type": "string",
