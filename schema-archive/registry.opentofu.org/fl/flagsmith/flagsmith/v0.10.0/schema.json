{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_api_url": {
          "type": "string",
          "description": "Used by api client to connect to flagsmith instance. NOTE: update this if you are running a self hosted version. e.g: https://your.flagsmith.com/api/v1",
          "description_kind": "markdown",
          "optional": true
        },
        "master_api_key": {
          "type": "string",
          "description": "Master API key used by flagsmith api client. Can also be set using the environment variable `FLAGSMITH_MASTER_API_KEY`",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The flagsmith provider is used  to interact with the resource supported by Flagsmith.\n\t\t\t\t      The provider needs to be configured with the proper credentials before it can be used.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "flagsmith_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_client_traits": {
            "type": "bool",
            "description": "Allows clients using the client API key to set traits.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "api_key": {
            "type": "string",
            "description": "Client side API Key",
            "description_kind": "markdown",
            "computed": true
          },
          "banner_colour": {
            "type": "string",
            "description": "hex code for the UI banner colour",
            "description_kind": "markdown",
            "optional": true
          },
          "banner_text": {
            "type": "string",
            "description": "Banner text to display in the UI",
            "description_kind": "markdown",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Description of the environment",
            "description_kind": "markdown",
            "optional": true
          },
          "hide_disabled_flags": {
            "type": "bool",
            "description": "If true will exclude flags from SDK which are disabled",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "hide_sensitive_data": {
            "type": "bool",
            "description": "If true, will hide sensitive data(e.g: traits, description etc) from the SDK endpoints",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "ID of the environment",
            "description_kind": "markdown",
            "computed": true
          },
          "minimum_change_request_approvals": {
            "type": "number",
            "description": "Minimum number of approvals required for a change request",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the environment",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "number",
            "description": "ID of the project",
            "description_kind": "markdown",
            "required": true
          },
          "use_identity_composite_key_for_hashing": {
            "type": "bool",
            "description": "Enable this to have consistent multivariate and percentage split evaluations across all SDKs (in local and server side mode) ",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "uuid": {
            "type": "string",
            "description": "UUID of the environment",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Flagsmith Environment",
        "description_kind": "markdown"
      }
    },
    "flagsmith_feature": {
      "version": 0,
      "block": {
        "attributes": {
          "default_enabled": {
            "type": "bool",
            "description": "Determines if the feature is enabled by default. If unspecified, it will default to false",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Description of the feature",
            "description_kind": "markdown",
            "optional": true
          },
          "feature_name": {
            "type": "string",
            "description": "Name of the feature",
            "description_kind": "markdown",
            "required": true
          },
          "group_owners": {
            "type": [
              "set",
              "number"
            ],
            "description": "List of group IDs representing the group owners of the feature.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "ID of the feature",
            "description_kind": "markdown",
            "computed": true
          },
          "initial_value": {
            "type": "string",
            "description": "Determines the initial value of the feature.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_archived": {
            "type": "bool",
            "description": "Can be used to archive/unarchive a feature. If unspecified, it will default to false",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "owners": {
            "type": [
              "set",
              "number"
            ],
            "description": "List of user IDs representing the owners of the feature.",
            "description_kind": "markdown",
            "optional": true
          },
          "project_id": {
            "type": "number",
            "description": "ID of the project",
            "description_kind": "markdown",
            "computed": true
          },
          "project_uuid": {
            "type": "string",
            "description": "UUID of project the feature belongs to",
            "description_kind": "markdown",
            "required": true
          },
          "tags": {
            "type": [
              "set",
              "number"
            ],
            "description": "List of tag IDs representing the tags attached to the feature.",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Type of the feature, can be STANDARD, or MULTIVARIATE. if unspecified, it will default to STANDARD",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "uuid": {
            "type": "string",
            "description": "UUID of the feature",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Flagsmith Feature/ Remote config",
        "description_kind": "markdown"
      }
    },
    "flagsmith_feature_state": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Used for enabling/disabling the feature",
            "description_kind": "markdown",
            "required": true
          },
          "environment_id": {
            "type": "number",
            "description": "ID of the environment",
            "description_kind": "markdown",
            "computed": true
          },
          "environment_key": {
            "type": "string",
            "description": "Client side environment key associated with the environment",
            "description_kind": "markdown",
            "required": true
          },
          "feature_id": {
            "type": "number",
            "description": "ID of the feature",
            "description_kind": "markdown",
            "required": true
          },
          "feature_segment_id": {
            "type": "number",
            "description": "ID of the feature_segment, used internally to bind a feature state to a segment",
            "description_kind": "markdown",
            "computed": true
          },
          "feature_state_value": {
            "nested_type": {
              "attributes": {
                "boolean_value": {
                  "type": "bool",
                  "description": "Boolean value of the feature if the type is `bool`",
                  "description_kind": "markdown",
                  "optional": true
                },
                "integer_value": {
                  "type": "number",
                  "description": "Integer value of the feature if the type is `int`",
                  "description_kind": "markdown",
                  "optional": true
                },
                "string_value": {
                  "type": "string",
                  "description": "String value of the feature if the type is `unicode`.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "Type of the feature state value, can be `unicode`, `int` or `bool`",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Value for the feature State. NOTE: One of string_value, integer_value or boolean_value must be set",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "ID of the featurestate",
            "description_kind": "markdown",
            "computed": true
          },
          "segment_id": {
            "type": "number",
            "description": "ID of the segment, used for creating segment overrides",
            "description_kind": "markdown",
            "optional": true
          },
          "segment_priority": {
            "type": "number",
            "description": "Priority of the segment overrides.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "uuid": {
            "type": "string",
            "description": "UUID of the featurestate",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Flagsmith Feature state/ Remote config value",
        "description_kind": "markdown"
      }
    },
    "flagsmith_mv_feature_option": {
      "version": 0,
      "block": {
        "attributes": {
          "boolean_value": {
            "type": "bool",
            "description": "Boolean value of the multivariate option if the type is `bool`",
            "description_kind": "markdown",
            "optional": true
          },
          "default_percentage_allocation": {
            "type": "number",
            "description": "Percentage allocation of the current multivariate option",
            "description_kind": "markdown",
            "required": true
          },
          "feature_id": {
            "type": "number",
            "description": "ID of the feature to which the multivariate option belongs",
            "description_kind": "markdown",
            "computed": true
          },
          "feature_uuid": {
            "type": "string",
            "description": "UUID of the feature to which the multivariate option belongs",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "ID of the multivariate option",
            "description_kind": "markdown",
            "computed": true
          },
          "integer_value": {
            "type": "number",
            "description": "Integer value of the multivariate option if the type is `int`",
            "description_kind": "markdown",
            "optional": true
          },
          "project_id": {
            "type": "number",
            "description": "Project ID of the feature to which the multivariate option belongs",
            "description_kind": "markdown",
            "computed": true
          },
          "string_value": {
            "type": "string",
            "description": "String value of the multivariate option if the type is `unicode`",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Type of the multivariate option can be `unicode`, `int` or `bool`",
            "description_kind": "markdown",
            "required": true
          },
          "uuid": {
            "type": "string",
            "description": "UUID of the multivariate option",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Flagsmith Feature Multivariate Option",
        "description_kind": "markdown"
      }
    },
    "flagsmith_project": {
      "version": 0,
      "block": {
        "attributes": {
          "enable_realtime_updates": {
            "type": "bool",
            "description": "Enable this to trigger a realtime(sse) event whenever the value of a flag changes",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "enforce_feature_owners": {
            "type": "bool",
            "description": "If true, feature creation requires at least one owner or group owner.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "feature_name_regex": {
            "type": "string",
            "description": "Used for validating feature names",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "hide_disabled_flags": {
            "type": "bool",
            "description": "If true will exclude flags from SDK which are disabled",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "ID of the project",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the project",
            "description_kind": "markdown",
            "required": true
          },
          "only_allow_lower_case_feature_names": {
            "type": "bool",
            "description": "Used by UI to validate feature names",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "organisation_id": {
            "type": "number",
            "description": "ID of the organisation project belongs to",
            "description_kind": "markdown",
            "required": true
          },
          "prevent_flag_defaults": {
            "type": "bool",
            "description": "Prevent defaults from being set in all environments when creating a feature.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "stale_flags_limit_days": {
            "type": "number",
            "description": "Number of days without modification in any environment before a flag is considered stale.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "uuid": {
            "type": "string",
            "description": "UUID of the project",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Flagsmith Project",
        "description_kind": "markdown"
      }
    },
    "flagsmith_segment": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the segment",
            "description_kind": "markdown",
            "optional": true
          },
          "feature_id": {
            "type": "number",
            "description": "Set this to create a feature specific segment",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "ID of the segment",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the segment",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "number",
            "description": "ID of the project",
            "description_kind": "markdown",
            "computed": true
          },
          "project_uuid": {
            "type": "string",
            "description": "UUID of project the segment belongs to",
            "description_kind": "markdown",
            "required": true
          },
          "rules": {
            "nested_type": {
              "attributes": {
                "conditions": {
                  "nested_type": {
                    "attributes": {
                      "operator": {
                        "type": "string",
                        "description": "Operator of the condition, can be one of `EQUAL`, `GREATER_THAN`, `LESS_THAN`, `LESS_THAN_INCLUSIVE` `CONTAINS`, `GREATER_THAN_INCLUSIVE`, `NOT_CONTAINS`, `NOT_EQUAL`,  `REGEX`, `PERCENTAGE_SPLIT`,  `MODULO`, `IS_SET`, `IS_NOT_SET`, `IN` ",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "property": {
                        "type": "string",
                        "description": "Property of the condition",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "value": {
                        "type": "string",
                        "description": "Value of the condition",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "List of Conditions for the nested Rule",
                  "description_kind": "markdown",
                  "optional": true
                },
                "rules": {
                  "nested_type": {
                    "attributes": {
                      "conditions": {
                        "nested_type": {
                          "attributes": {
                            "operator": {
                              "type": "string",
                              "description": "Operator of the condition, can be one of `EQUAL`, `GREATER_THAN`, `LESS_THAN`, `LESS_THAN_INCLUSIVE` `CONTAINS`, `GREATER_THAN_INCLUSIVE`, `NOT_CONTAINS`, `NOT_EQUAL`,  `REGEX`, `PERCENTAGE_SPLIT`,  `MODULO`, `IS_SET`, `IS_NOT_SET`, `IN` ",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "property": {
                              "type": "string",
                              "description": "Property of the condition",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "value": {
                              "type": "string",
                              "description": "Value of the condition",
                              "description_kind": "markdown",
                              "optional": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description": "List of Conditions for the nested Rule",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "type": {
                        "type": "string",
                        "description": "Type of the rule",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "List of Nested Rules",
                  "description_kind": "markdown",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "Type of the rule, can be of: `ALL`, `ANY`, `NONE`",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Rules for the segment",
            "description_kind": "markdown",
            "required": true
          },
          "uuid": {
            "type": "string",
            "description": "UUID of the segment",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Flagsmith Segment",
        "description_kind": "markdown"
      }
    },
    "flagsmith_tag": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the feature",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "ID of the tag",
            "description_kind": "markdown",
            "computed": true
          },
          "project_id": {
            "type": "number",
            "description": "ID of the project",
            "description_kind": "markdown",
            "computed": true
          },
          "project_uuid": {
            "type": "string",
            "description": "UUID of project the tag belongs to",
            "description_kind": "markdown",
            "required": true
          },
          "tag_colour": {
            "type": "string",
            "description": "Colour for this tag, as accepted by [color-string](https://github.com/Qix-/color-string).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "tag_name": {
            "type": "string",
            "description": "Name of the tag",
            "description_kind": "markdown",
            "required": true
          },
          "uuid": {
            "type": "string",
            "description": "UUID of the tag",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Flagsmith Tag",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "flagsmith_organisation": {
      "version": 0,
      "block": {
        "attributes": {
          "force_2fa": {
            "type": "bool",
            "description": "If true, signup will require 2FA",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "ID of the organisation",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the organisation",
            "description_kind": "markdown",
            "computed": true
          },
          "persist_trait_data": {
            "type": "bool",
            "description": "If false, trait data for this organisation identities will not stored",
            "description_kind": "markdown",
            "computed": true
          },
          "restrict_project_create_to_admin": {
            "type": "bool",
            "description": "If true, only organisation admin can create projects",
            "description_kind": "markdown",
            "computed": true
          },
          "uuid": {
            "type": "string",
            "description": "UUID of the organisation",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Flagsmith Organisation",
        "description_kind": "markdown"
      }
    },
    "flagsmith_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "Email address of the user",
            "description_kind": "markdown",
            "required": true
          },
          "first_name": {
            "type": "string",
            "description": "First name of the user",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "ID of the user",
            "description_kind": "markdown",
            "computed": true
          },
          "last_name": {
            "type": "string",
            "description": "Last name of the user",
            "description_kind": "markdown",
            "computed": true
          },
          "organisation_id": {
            "type": "number",
            "description": "ID of the organisation the user belongs to",
            "description_kind": "markdown",
            "required": true
          },
          "role": {
            "type": "string",
            "description": "Role of the user in the organisation",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Use this data source to look up a Flagsmith user by email within an organisation.",
        "description_kind": "markdown"
      }
    }
  }
}
