{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "insecure_tls": {
          "type": "bool",
          "description": "Skip TLS certificate verification (default: false)",
          "description_kind": "markdown",
          "optional": true
        },
        "max_connections": {
          "type": "number",
          "description": "Maximum number of concurrent connections to Pi-hole (default: 1)",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Pi-hole admin password",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "request_delay_ms": {
          "type": "number",
          "description": "Delay in milliseconds between API requests (default: 300)",
          "description_kind": "markdown",
          "optional": true
        },
        "retry_attempts": {
          "type": "number",
          "description": "Number of retry attempts for failed requests (default: 3)",
          "description_kind": "markdown",
          "optional": true
        },
        "retry_backoff_base_ms": {
          "type": "number",
          "description": "Base delay in milliseconds for retry backoff (default: 500)",
          "description_kind": "markdown",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "Pi-hole server URL",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "pihole_cname_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain name for the CNAME record",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "CNAME record identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "target": {
            "type": "string",
            "description": "Target domain for the CNAME record",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Pi-hole CNAME record resource",
        "description_kind": "markdown"
      }
    },
    "pihole_config": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Resource identifier (same as key)",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Configuration key (e.g., 'webserver.api.app_sudo'). This uses dot notation to specify nested configuration values.",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Configuration value. For boolean settings, use 'true' or 'false'.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages Pi-hole configuration settings. **Important**: Configuration changes require admin password, not application password. Application passwords cannot modify Pi-hole configuration settings unless `webserver.api.app_sudo` is enabled. This setting can be enabled via the Pi-hole web interface under Settings \u2192 API/Web interface \u2192 \"Permit destructive actions via API\".",
        "description_kind": "markdown"
      }
    },
    "pihole_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain name for the DNS record",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "DNS record identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "ip": {
            "type": "string",
            "description": "IP address for the DNS record",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Pi-hole DNS record resource",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "pihole_cname_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The CNAME domain name to look up",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Data source identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "target": {
            "type": "string",
            "description": "The target domain name that the CNAME points to",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieves a specific CNAME record from Pi-hole by domain name",
        "description_kind": "markdown"
      }
    },
    "pihole_cname_records": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Data source identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "records": {
            "nested_type": {
              "attributes": {
                "domain": {
                  "type": "string",
                  "description": "The CNAME domain name",
                  "description_kind": "markdown",
                  "computed": true
                },
                "target": {
                  "type": "string",
                  "description": "The target domain name",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of CNAME records",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieves all CNAME records from Pi-hole",
        "description_kind": "markdown"
      }
    },
    "pihole_config": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Data source identifier (same as key)",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Configuration key to read (e.g., 'webserver.api.app_sudo'). This uses dot notation to specify nested configuration values.",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Current configuration value. Boolean values are returned as 'true' or 'false'.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Reads Pi-hole configuration settings. This data source can be used to read current configuration values, such as checking if `webserver.api.app_sudo` is enabled.",
        "description_kind": "markdown"
      }
    },
    "pihole_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The domain name to look up",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Data source identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "ip": {
            "type": "string",
            "description": "The IP address that the domain resolves to",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieves a specific DNS A record from Pi-hole by domain name",
        "description_kind": "markdown"
      }
    },
    "pihole_dns_records": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Data source identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "records": {
            "nested_type": {
              "attributes": {
                "domain": {
                  "type": "string",
                  "description": "The domain name",
                  "description_kind": "markdown",
                  "computed": true
                },
                "ip": {
                  "type": "string",
                  "description": "The IP address",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of DNS A records",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieves all DNS A records from Pi-hole",
        "description_kind": "markdown"
      }
    }
  }
}
