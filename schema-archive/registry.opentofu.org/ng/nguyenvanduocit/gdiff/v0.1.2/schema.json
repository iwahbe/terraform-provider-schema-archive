{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "diff_mode": {
          "type": "string",
          "description": "DiffMode of the git repository. e.g. 'tag' or 'commit', 'stage', 'dirty'",
          "description_kind": "markdown",
          "optional": true
        },
        "git_path": {
          "type": "string",
          "description": "Absolute path to the git folder",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "gdiff_commit": {
      "version": 0,
      "block": {
        "attributes": {
          "hash": {
            "type": "string",
            "description": "The hash of the last commit",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Absolute path to the file,directory.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "This data source provides the last commit of a file or folder",
        "description_kind": "markdown"
      }
    }
  }
}
