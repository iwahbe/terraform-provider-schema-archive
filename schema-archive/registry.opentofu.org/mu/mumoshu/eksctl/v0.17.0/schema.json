          },
          "headers": {
            "type": [
              "map",
              [
                "list",
                "string"
              ]
            ],
            "description": "HttpHeaderConfig values of ALB listener rule condition \"http-header\" field.\n\nExample:\n\nheaders = {\n Cookie = \"condition=foobar\"\n}\n\nproduces:\n\n[\n\u00a0\u00a0{\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\"Field\":\u00a0\"http-header\",\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\"HttpHeaderConfig\":\u00a0{\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\"HttpHeaderName\":\u00a0\"Cookie\",\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\"Values\":\u00a0[\"condition=foobar\"]\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0}\n\u00a0\u00a0}\n]\n",
            "description_kind": "plain",
            "optional": true
          },
          "hosts": {
            "type": [
              "set",
              "string"
            ],
            "description": "ALB listener rule condition values for host-header condition, e.g. hosts = [\"example.com\", \"*.example.com\"]",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "listener_arn": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "methods": {
            "type": [
              "set",
              "string"
            ],
            "description": "ALB listener rule condition values for http-request-method condition, e.g. methods = [\"get\"]",
            "description_kind": "plain",
            "optional": true
          },
          "path_patterns": {
            "type": [
              "set",
              "string"
            ],
            "description": "\nPAthPatternConfig values of ALB listener rule condition \"path-pattern\" field.\n\nExample:\n\npath_patterns = [\"/prefix/*\"]\n\nproduces:\n\n[\n  {\n      \"Field\": \"path-pattern\",\n      \"PathPatternConfig\": {\n          \"Values\": [\"/prefix/*\"]\n      }\n  }\n]\n",
            "description_kind": "plain",
            "optional": true
          },
          "priority": {
            "type": "number",
            "description_kind": "plain",
            "optional": true
          },
          "profile": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "querystrings": {
            "type": [
              "map",
              "string"
            ],
            "description": "QueryStringConfig values of ALB listener rule condition \"query-string\" field.\n\nExample:\n\nquerystrings = {\n foo = \"bar\"\n}\n\nproduces:\n\n{\n     \"Field\": \"query-string\",\n     \"QueryStringConfig\": {\n         \"Values\": [\n           {\n               \"Key\": \"foo\",\n               \"Value\": \"bar\"\n           }\n         ]\n     }\n }\n",
            "description_kind": "plain",
            "optional": true
          },
          "region": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "source_ips": {
            "type": [
              "set",
              "string"
            ],
            "description": "\nSourceIpConfig values of ALB listener rule condition \"source-ip\" field.\n\nExample:\n\nheaders = [\"MYIPD/CIDR\"]\n\nproduces:\n\n[\n\u00a0\u00a0{\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\"Field\":\u00a0\"source-ip\",\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\"SourceIpConfig\":\u00a0{\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\"Values\":\u00a0[\"MYIP/CIDR\"]\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0}\n\u00a0\u00a0}\n]\n",
            "description_kind": "plain",
            "optional": true
          },
          "step_interval": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "step_weight": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          }
