{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API key. You can also set the `INCIDENT_IO_API_KEY` environment variable instead.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "incidentio_custom_field": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the custom field",
            "description_kind": "markdown",
            "required": true
          },
          "field_type": {
            "type": "string",
            "description": "The type of the custom field",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for the custom field",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Human readable name of the custom field",
            "description_kind": "markdown",
            "required": true
          },
          "required": {
            "type": "string",
            "description": "When this custom field must be set during the incident lifecycle. Must be one of `never`, `before_closure` or `always`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "show_before_closure": {
            "type": "bool",
            "description": "Whether a custom field should be shown in the incident close modal. If this custom field is required before closure, but no value has been set for it, the field will be shown in the closure modal whatever the value of this setting.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "show_before_creation": {
            "type": "bool",
            "description": "Whether a custom field should be shown in the incident creation modal. This must be true if the field is always required.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "show_before_update": {
            "type": "bool",
            "description": "Whether a custom field should be shown in the incident update modal.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Configure a custom field",
        "description_kind": "markdown"
      }
    },
    "incidentio_custom_field_option": {
      "version": 0,
      "block": {
        "attributes": {
          "custom_field_id": {
            "type": "string",
            "description": "ID of the custom field this option belongs to",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for the custom field option",
            "description_kind": "markdown",
            "computed": true
          },
          "sort_key": {
            "type": "number",
            "description": "Sort key used to order the custom field options correctly",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "value": {
            "type": "string",
            "description": "Human readable name for the custom field option",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Configure a custom field option",
        "description_kind": "markdown"
      }
    },
    "incidentio_incident_role": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Describes the purpose of the role",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for the role",
            "description_kind": "markdown",
            "computed": true
          },
          "instructions": {
            "type": "string",
            "description": "Provided to whoever is nominated for the role",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Human readable name of the incident role",
            "description_kind": "markdown",
            "required": true
          },
          "required": {
            "type": "bool",
            "description": "Whether incident require this role to be set",
            "description_kind": "markdown",
            "required": true
          },
          "short_form": {
            "type": "string",
            "description": "Short human readable name for Slack",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Configure an incident role",
        "description_kind": "markdown"
      }
    },
    "incidentio_severity": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the severity",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for the severity",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Human readable name of the severity",
            "description_kind": "markdown",
            "required": true
          },
          "rank": {
            "type": "number",
            "description": "Rank to help sort severities (lower numbers are less severe)",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Configure a severity",
        "description_kind": "markdown"
      }
    }
  }
}
