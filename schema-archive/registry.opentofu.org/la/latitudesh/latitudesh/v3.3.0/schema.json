          },
          "project": {
            "type": "string",
            "description": "The project id or slug. If not set, falls back to provider's project.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "rules": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "from": {
                  "type": "string",
