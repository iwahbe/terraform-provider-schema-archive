{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "auth_token": {
          "type": "string",
          "description": "Latitude.sh API authentication token. Can also be set via the LATITUDESH_AUTH_TOKEN environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "project": {
          "type": "string",
          "description": "The project ID to use for all resources. If not set, project must be defined in the resource.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "latitudesh_elastic_ip": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "The assigned IP address",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Elastic IP identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "project": {
            "type": "string",
            "description": "The project (ID or Slug) that owns the Elastic IP. Falls back to the provider-level `project` default.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "server_id": {
            "type": "string",
            "description": "The server ID this Elastic IP is assigned to. Changing this value moves the IP to the new server (asynchronous).",
            "description_kind": "markdown",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Current status of the Elastic IP (configuring, active, moving, releasing, error)",
            "description_kind": "markdown",
            "computed": true
          },
          "timeouts": {
            "nested_type": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Elastic IP resource. Reserves a static public IPv4 address assigned to a server and movable between servers within the same project.",
        "description_kind": "markdown"
      }
    },
    "latitudesh_firewall": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
