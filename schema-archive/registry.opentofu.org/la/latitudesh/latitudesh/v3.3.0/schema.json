    "latitudesh_server": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_reinstall": {
            "type": "bool",
            "description": "Allow server reinstallation when `operating_system`, `hostname`, `ssh_keys`, `user_data` (ID or content), `raid`, or `ipxe` changes. Defaults to `false`. When `false`, `hostname` changes are applied in-place via PATCH and any other reinstall-only field change fails the plan with an explicit error. See `allowed_reinstall_triggers` to restrict which kinds of changes are permitted to cause a reinstall.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "allowed_reinstall_triggers": {
            "type": [
              "list",
              "string"
            ],
            "description": "Optional list restricting which field changes are allowed to trigger a server reinstall when `allow_reinstall = true`. When omitted, all reinstall-only field changes trigger a reinstall (existing behavior). When set, only listed names cause a reinstall; changes to reinstall-only fields not in the list fail the plan, except `hostname` which falls back to in-place PATCH. Valid values: `operating_system`, `user_data`, `raid`, `disk_layout`, `ipxe`, `ssh_keys`, `hostname`. The token `user_data` covers both ID changes and content changes of the referenced user_data resource.",
            "description_kind": "markdown",
            "optional": true
          },
          "billing": {
            "type": "string",
            "description": "The server billing type (hourly, monthly, yearly). Defaults to monthly.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "The timestamp for when the server was created",
            "description_kind": "markdown",
            "computed": true
          },
          "disk_layout": {
            "nested_type": {
              "attributes": {
                "count": {
                  "type": "number",
                  "description": "Number of disks to include in this group",
                  "description_kind": "markdown",
                  "required": true
                },
                "mount_point": {
                  "type": "string",
                  "description": "Mount point for this disk group",
                  "description_kind": "markdown",
                  "optional": true
                },
                "raid_level": {
                  "type": "string",
                  "description": "RAID level for this disk group (raid-0, raid-1)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "role": {
                  "type": "string",
                  "description": "Role of this disk group (os, storage, raw)",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Custom disk layout made of one or more disk groups, used instead of `raid`. Mutually exclusive with `raid` and `ipxe`. The layout is refreshed from the server deploy config on read, so out-of-band changes are detected and imported servers populate it. Changing it triggers a reinstall (requires `allow_reinstall = true`). The OS group's filesystem is always `ext4` (managed by the API) and is not configurable here.",
            "description_kind": "markdown",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description": "The server hostname. Changing this value triggers a server reinstall when `allow_reinstall` is `true` (default); set `allow_reinstall = false` to perform an in-place update instead.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Server identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "interfaces": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "Description",
                  "description_kind": "markdown",
                  "computed": true
                },
                "mac_address": {
                  "type": "string",
                  "description": "MAC address",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Interface name",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of network interfaces",
            "description_kind": "markdown",
            "computed": true
          },
          "ipxe": {
            "type": "string",
            "description": "The iPXE script to boot. Accepts either a URL pointing at the script, or the script encoded in base64. Required when `operating_system = \"ipxe\"`; the plan fails with an explicit error if it is missing. Updating ipxe requires a reinstall and only succeeds when `allow_reinstall = true`; otherwise the plan fails with an error.",
            "description_kind": "markdown",
            "optional": true
          },
          "locked": {
            "type": "bool",
            "description": "Whether the server is locked",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "operating_system": {
            "type": "string",
            "description": "The operating system for the new server",
            "description_kind": "markdown",
            "required": true
          },
          "plan": {
            "type": "string",
            "description": "The plan to choose server from",
            "description_kind": "markdown",
            "required": true
          },
          "primary_ipv4": {
            "type": "string",
            "description": "Primary IPv4 address of the server",
            "description_kind": "markdown",
            "computed": true
          },
          "primary_ipv6": {
            "type": "string",
            "description": "Primary IPv6 address of the server",
            "description_kind": "markdown",
            "computed": true
          },
          "project": {
            "type": "string",
            "description": "The project (ID or Slug) to deploy the server",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "raid": {
            "type": "string",
            "description": "RAID mode for the server (raid-0, raid-1). Mutually exclusive with `disk_layout`.",
            "description_kind": "markdown",
            "optional": true
          },
          "region": {
            "type": "string",
            "description": "The region where the server is deployed",
            "description_kind": "markdown",
            "computed": true
          },
          "site": {
            "type": "string",
            "description": "The site to deploy the server (case-insensitive)",
            "description_kind": "markdown",
            "required": true
          },
          "ssh_keys": {
            "type": [
              "list",
              "string"
            ],
            "description": "SSH Keys to set on the server",
            "description_kind": "markdown",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "Server power status",
            "description_kind": "markdown",
            "computed": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of server tag IDs",
            "description_kind": "markdown",
            "optional": true
          },
          "timeouts": {
            "nested_type": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          },
          "user_data": {
            "type": "string",
            "description": "User data ID to assign to the server (reference to latitudesh_user_data resource)",
            "description_kind": "markdown",
            "optional": true
          },
          "user_data_content_hash": {
            "type": "string",
            "description": "SHA256 hex digest of the user_data `content` currently tracked for this server. Maintained automatically by the provider; a change in this value triggers a server reinstall when `allow_reinstall = true` and `user_data` is an allowed reinstall trigger.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Server resource",
        "description_kind": "markdown"
      }
    },
