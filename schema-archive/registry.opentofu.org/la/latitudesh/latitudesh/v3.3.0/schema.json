                },
                "port": {
                  "type": "string",
                  "description": "Port or port range",
                  "description_kind": "markdown",
                  "required": true
                },
                "protocol": {
                  "type": "string",
                  "description": "Protocol (TCP, UDP, ICMP)",
                  "description_kind": "markdown",
                  "required": true
                },
                "to": {
                  "type": "string",
                  "description": "Destination IP or range",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "Firewall rules",
              "description_kind": "markdown"
            }
          }
        },
        "description": "Firewall resource",
        "description_kind": "markdown"
      }
    },
    "latitudesh_firewall_assignment": {
