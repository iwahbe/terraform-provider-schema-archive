{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "auth_url": {
          "type": "string",
          "description": "The Amplience authentication URL",
          "description_kind": "plain",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "The OAuth Client ID for the Amplience management API https://amplience_provider.com/docs/api/dynamic-content/management/index.html#section/Authentication",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "client_secret": {
          "type": "string",
          "description": "The OAuth Client Secret for Amplience management API. https://amplience_provider.com/docs/api/dynamic-content/management/index.html#section/Authentication",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "content_api_url": {
          "type": "string",
          "description": "The base URL path for the Amplience Content API",
          "description_kind": "plain",
          "optional": true
        },
        "hub_id": {
          "type": "string",
          "description": "ID of the Hub to manage",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "amplience_content_repository": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Content Repositories function as subfolders inside of Hubs. Although a user can view content in all repositories within a single hub, their ability to create content may be limited to certain repositories. Typically you will want your content producers to be able to create content in one or more repositories, but your planners to only be able to view the content. Content and slot types are registered with hubs and enabled on repositories. So you can choose which types of content can be created in each repository, or just choose to limit the number of content types that are available.\nFor more info see [Amplience Hubs & Repositories Docs](https://amplience.com/docs/intro/hubsandrepositories.html)",
        "description_kind": "plain"
      }
    },
    "amplience_content_type": {
      "version": 0,
      "block": {
        "attributes": {
          "content_type_uri": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Status of the Content Type. Can be ACTIVE or DELETED",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "icon": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "size": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          },
          "visualization": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "default": {
                  "type": "bool",
                  "description_kind": "plain",
                  "required": true
                },
                "label": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "templated_uri": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Content types are the templates for content items, defining the type of content to be created, including its structure and validation rules. Content types are stored externally to Dynamic Content, on web based services such as AWS, and must be registered with a hub before they can be used to create content.\nFor more info see [Amplience Content Type Docs](https://amplience.com/docs/integration/workingwithcontenttypes.html)",
        "description_kind": "plain"
      }
    },
    "amplience_content_type_assignment": {
      "version": 0,
      "block": {
        "attributes": {
          "content_type_id": {
            "type": "string",
            "description": "ID of the Content Type to assign to the Repository",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "repository_id": {
            "type": "string",
            "description": "ID of the Content Repository to assign the type to",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Resource used to assign a Content Type to a Content Repository",
        "description_kind": "plain"
      }
    },
    "amplience_content_type_schema": {
      "version": 0,
      "block": {
        "attributes": {
          "auto_sync": {
            "type": "bool",
            "description": "Enable if you want content types to be automatically synced when the schema gets updated",
            "description_kind": "plain",
            "optional": true
          },
          "body": {
            "type": "string",
            "description": "JSON definition of the schema",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "schema_id": {
            "type": "string",
            "description": "Unique schema ID",
            "description_kind": "plain",
            "required": true
          },
          "validation_level": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "version": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Content type schemas are JSON schemas that define a type of content to be created, including its structure, format and validation rules. In Dynamic Content, content type schemas match the format of the JSON Schema standard, with a few extensions and some keywords that are not supported.\nFor more info see [Amplience Content Type Schema Docs](https://amplience.com/docs/integration/contenttypes.html)",
        "description_kind": "plain"
      }
    },
    "amplience_hub": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Hub description",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Hub label",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Hub name",
            "description_kind": "plain",
            "required": true
          },
          "settings": {
            "nested_type": {
              "attributes": {
                "applications": {
                  "nested_type": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "template_uri": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "asset_management": {
                  "nested_type": {
                    "attributes": {
                      "client_config": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "enabled": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "devices": {
                  "nested_type": {
                    "attributes": {
                      "height": {
                        "type": "number",
                        "description_kind": "plain",
                        "required": true
                      },
                      "name": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "orientate": {
                        "type": "bool",
                        "description_kind": "plain",
                        "required": true
                      },
                      "width": {
                        "type": "number",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "localization": {
                  "nested_type": {
                    "attributes": {
                      "locales": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "preview_virtual_staging_environment": {
                  "nested_type": {
                    "attributes": {
                      "hostname": {
                        "type": "string",
                        "description": "Virtual Staging Environment hostname",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "publishing": {
                  "nested_type": {
                    "attributes": {
                      "platforms": {
                        "nested_type": {
                          "attributes": {
                            "amplience_dam": {
                              "nested_type": {
                                "attributes": {
                                  "api_key": {
                                    "type": "string",
                                    "description": "DAM publishing client key",
                                    "description_kind": "plain",
                                    "required": true
                                  },
                                  "api_secret": {
                                    "type": "string",
                                    "description": "DAM publishing client secret",
                                    "description_kind": "plain",
                                    "required": true,
                                    "sensitive": true
                                  },
                                  "endpoint": {
                                    "type": "string",
                                    "description": "Publishing endpoint, also known as Company Tag",
                                    "description_kind": "plain",
                                    "required": true
                                  }
                                },
                                "nesting_mode": "single"
                              },
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "virtual_staging_environment": {
                  "nested_type": {
                    "attributes": {
                      "hostname": {
                        "type": "string",
                        "description": "Virtual Staging Environment hostname",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Hub settings",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Permissions are set at the hub level. All users of a hub can at least view all of the content within the repositories inside that hub. Content cannot be shared across hubs. However, content can be shared and linked to across repositories within the same hub. So you can create a content item in one repository and include content stored in another. Events and editions are scheduled within a single hub. So if you want an overall view of the planning calendar across many brands, then you may wish to consider a single hub. However, in some cases you may want to keep the calendars separate. Many settings, such as the publishing endpoint (the subdomain to which your content is published) are set at a hub level. Multiple hubs may publish content to the same endpoint.\n\nFor more info see [Amplience Hubs & Repositories Docs](https://amplience.com/docs/intro/hubsandrepositories.html)\n\n**It is recommended to import a new hub instead of creating it!** This is because the hub already exists, so any differences in configuration might be overwritten, leading to unintended outcomes.",
        "description_kind": "markdown"
      }
    },
    "amplience_search_index": {
      "version": 0,
      "block": {
        "attributes": {
          "content_types": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of content type urls. Each content type will create 2 corresponding webhooks (PUT & DELETE)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Label for the Index",
            "description_kind": "plain",
            "required": true
          },
          "settings": {
            "type": "string",
            "description": "A JSON string containing Algolia settings (https://www.algolia.com/doc/api-reference/api-parameters/)",
            "description_kind": "plain",
            "optional": true
          },
          "suffix": {
            "type": "string",
            "description": "Suffix for the Index",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Either PRODUCTION or STAGING",
            "description_kind": "plain",
            "required": true
          },
          "webhook_custom_payload": {
            "type": [
              "map",
              "string"
            ],
            "description": "A Handlebars Json string for the custom payload that will be used for each content type webhook",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "A search index is the connection between Amplience and Algolia.For more info see [Amplience Index Docs](https://amplience.com/docs/development/search-indexes/readme.html)",
        "description_kind": "plain"
      }
    },
    "amplience_webhook": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Indicates if the Webhook should be fired",
            "description_kind": "plain",
            "optional": true
          },
          "custom_payload": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "events": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of events to register the Webhook against",
            "description_kind": "plain",
            "optional": true
          },
          "handlers": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of URLs to receive the Webhook",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Label for the Webhook",
            "description_kind": "plain",
            "required": true
          },
          "method": {
            "type": "string",
            "description": "Webhook HTTP method: POST, PATCH, PUT or DELETE",
            "description_kind": "plain",
            "required": true
          },
          "secret": {
            "type": "string",
            "description": "Shared secret between the handler and DC",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          }
        },
        "block_types": {
          "filter": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "type": {
                  "type": "string",
                  "description": "Specify whether the filter is an \"in\" or an \"equal\" filter",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "arguments": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "json_path": {
                        "type": "string",
                        "description": "JSON Path of the filed you wish to match",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "The value to compare too",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "min_items": 1,
                  "max_items": 1
                }
              },
              "description_kind": "plain"
            },
            "max_items": 10
          },
          "header": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "Header key",
                  "description_kind": "plain",
                  "required": true
                },
                "secret_value": {
                  "type": "string",
                  "description": "Indicates whether this header value is sensitive",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "value": {
                  "type": "string",
                  "description": "Header value",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "List of additional headers",
              "description_kind": "plain"
            }
          },
          "notifications": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "email": {
                  "type": "string",
                  "description": "email address to notify",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "List of notifications",
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description": "A webhook is a way for Dynamic Content to automatically send messages or data to a third party system. Developers create webhooks that are triggered by specified events in Dynamic Content. These events usually correspond to an action performed by the user such as creating or updating content, or scheduling editions. Webhooks are associated with a single Dynamic Content hub.\nFor more info see [Amplience Webhook Docs](https://amplience.com/docs/integration/webhooks.html)",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "amplience_content_repository": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "label": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Content Repositories function as subfolders inside of Hubs. Although a user can view content in all repositories within a single hub, their ability to create content may be limited to certain repositories. Typically you will want your content producers to be able to create content in one or more repositories, but your planners to only be able to view the content. Content and slot types are registered with hubs and enabled on repositories. So you can choose which types of content can be created in each repository, or just choose to limit the number of content types that are available.\nFor more info see [Amplience Hubs & Repositories Docs](https://amplience.com/docs/intro/hubsandrepositories.html)",
        "description_kind": "plain"
      }
    },
    "amplience_hub": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Permissions are set at the hub level. All users of a hub can at least view all of the content within the repositories inside that hub. Content cannot be shared across hubs. However, content can be shared and linked to across repositories within the same hub. So you can create a content item in one repository and include content stored in another. Events and editions are scheduled within a single hub. So if you want an overall view of the planning calendar across many brands, then you may wish to consider a single hub. However, in some cases you may want to keep the calendars separate. Many settings, such as the publishing endpoint (the subdomain to which your content is published) are set at a hub level. Multiple hubs may publish content to the same endpoint.\nFor more info see [Amplience Hubs & Repositories Docs](https://amplience.com/docs/intro/hubsandrepositories.html)",
        "description_kind": "plain"
      }
    }
  }
}
