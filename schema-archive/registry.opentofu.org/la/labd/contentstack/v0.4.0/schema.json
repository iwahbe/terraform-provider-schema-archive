{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API key is a unique key assigned to each stack.",
          "description_kind": "plain",
          "optional": true
        },
        "auth_token": {
          "type": "string",
          "description": "The Authtoken is a read-write token used to make authorized CMA requests, and it is a user-specific token.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "base_url": {
          "type": "string",
          "description": "The BaseURL, e.g. https://eu-api.contentstack.com/. See https://www.contentstack.com/docs/developers/apis/content-management-api/#base-url",
          "description_kind": "plain",
          "optional": true
        },
        "branch": {
          "type": "string",
          "description": "The branch to manage resources in. If not specified, the main branch will be used.",
          "description_kind": "plain",
          "optional": true
        },
        "management_token": {
          "type": "string",
          "description": "Management Tokens are stack-level tokens, with no users attached to them.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "max_retries": {
          "type": "number",
          "description": "The maximum number of retry attempts for 429 (rate limit) responses. Defaults to 3. Uses exponential backoff with jitter.",
          "description_kind": "plain",
          "optional": true
        },
        "retry_wait_max": {
          "type": "number",
          "description": "The maximum wait time in seconds between retries. Defaults to 30 seconds.",
          "description_kind": "plain",
          "optional": true
        },
        "retry_wait_min": {
          "type": "number",
          "description": "The minimum wait time in seconds between retries. Defaults to 1 second.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "contentstack_content_type": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "schema": {
            "type": "string",
            "description": "The schema as JSON. Use jsonencode(jsonecode(<schema>)) to work around wrong changes.",
            "description_kind": "plain",
            "optional": true
          },
          "title": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "uid": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "\n\t\tContent type defines the structure or schema of a page or a section of\n\t\tyour web or mobile property. To create content for your application, you\n\t\tare required to first create a content type, and then create entries\n\t\tusing the content type.\n\n\t\tNote: Removing a field or modifying its properties may result in data\n\t\tloss or invalidate field visibility rules.\n\t\t",
        "description_kind": "plain"
      }
    },
    "contentstack_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "uid": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "url": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "locale": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "\n\t\tContentstack environment are designated destinations to which you can publish\n\t\tyour content. Environments are global, meaning they are available across all\n\t\tbranches of your stack. An environment can also have a list of URLs to be used\n\t\tas a prefix for published content.\n\t\t",
        "description_kind": "plain"
      }
    },
    "contentstack_global_field": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "maintain_revisions": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "schema": {
            "type": "string",
            "description": "The schema as JSON. Use jsonencode(jsonecode(<schema>)) to work around wrong changes.",
            "description_kind": "plain",
            "optional": true
          },
          "title": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "uid": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "\n\t\tA Global field is a reusable field (or group of fields) that you can\n\t\tdefine once and reuse in any content type within your stack. This\n\t\teliminates the need (and thereby time and efforts) to create the same\n\t\tset of fields repeatedly in multiple content types.\n\t\t",
        "description_kind": "plain"
      }
    },
    "contentstack_locale": {
      "version": 0,
      "block": {
        "attributes": {
          "code": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "fallback_locale": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "uid": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "\n\t\tContentstack offers multilingual support, which allows you to create\n\t\tentries in any language of your choice. When creating entries in other\n\t\tlanguages, they inherit data initially from the fallback language until\n\t\tthey are localized.\n\t\t",
        "description_kind": "plain"
      }
    },
    "contentstack_webhook": {
      "version": 0,
      "block": {
        "attributes": {
          "branches": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "channels": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "concise_payload": {
            "type": "bool",
            "description": "allows you to send a concise JSON payload to the target URL when a specific event occurs. To send a comprehensive JSON payload, you can set its value to false.",
            "description_kind": "plain",
            "optional": true
          },
          "disabled": {
            "type": "bool",
            "description": "allows you to enable or disable the webhook.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "retry_policy": {
            "type": "string",
            "description": "should be set to `manual`",
            "description_kind": "plain",
            "required": true
          },
          "uid": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "destination": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "custom_headers": {
                  "nested_type": {
                    "attributes": {
                      "header_name": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "http_basic_auth": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "http_basic_password": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "target_url": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description": "\n\t\tA webhook is a user-defined HTTP callback. It is a mechanism that sends\n\t\treal-time information to any third-party app or service.\n\t\t",
        "description_kind": "plain"
      }
    }
  }
}
