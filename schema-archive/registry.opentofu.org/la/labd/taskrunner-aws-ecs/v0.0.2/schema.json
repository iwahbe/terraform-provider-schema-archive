{
  "provider": {
    "version": 0,
    "block": {
      "description": "Interact with ECS tasks",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "taskrunner-aws-ecs_run": {
      "version": 0,
      "block": {
        "attributes": {
          "command": {
            "type": "string",
            "description": "Command to run",
            "description_kind": "plain",
            "optional": true
          },
          "container": {
            "type": "string",
            "description": "Container to run command in",
            "description_kind": "plain",
            "required": true
          },
          "ecs_cluster_arn": {
            "type": "string",
            "description": "ECS Cluster to run the task on",
            "description_kind": "plain",
            "required": true
          },
          "max_wait_time": {
            "type": "number",
            "description": "Max time to wait (default = 5 minutes)",
            "description_kind": "plain",
            "optional": true
          },
          "task_definition": {
            "type": "string",
            "description": "The task definition (family:revision)",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Run a task until completed",
        "description_kind": "plain"
      }
    }
  }
}
