{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "multipass_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "cloudinit_file": {
            "type": "string",
            "description": "Path to a user-data cloud-init configuration.",
            "description_kind": "markdown",
            "optional": true
          },
          "cpus": {
            "type": "number",
            "description": "Number of CPUs to allocate. Minimum: 1, default: 1.",
            "description_kind": "markdown",
            "optional": true
          },
          "disk": {
            "type": "string",
            "description": "Disk space to allocate. Positive integers, in KiB, MiB, GiB or TiB suffix. Minimum: 512MiB, default: 5GiB.",
            "description_kind": "markdown",
            "optional": true
          },
          "image": {
            "type": "string",
            "description": "Optional image to launch. If omitted, then the default Ubuntu LTS will be used. <remote> can be either \u2018release\u2019 or \u2018daily\u2018. If <remote> is omitted, \u2018release\u2019 will be used. <image> can be a partial image hash or an Ubuntu release version, codename or alias. <url> is a custom image URL that is in http://, https://, or file:// format.",
            "description_kind": "markdown",
            "optional": true
          },
          "ipv4": {
            "type": "string",
            "description": "The IPv4 address of the instance.",
            "description_kind": "markdown",
            "computed": true
          },
          "memory": {
            "type": "string",
            "description": "Amount of memory to allocate. Positive integers, in KiB, MiB, GiB or TiB suffix. Minimum: 128MiB, default: 1GiB.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name for the instance. If it is 'primary' (the configured primary instance name), the user's home directory is mounted inside the newly launched instance, in 'Home'.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Multipass instance resource.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "multipass_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "image": {
            "type": "string",
            "description": "The image of the instance",
            "description_kind": "markdown",
            "computed": true
          },
          "image_hash": {
            "type": "string",
            "description": "The image_hash of the instance",
            "description_kind": "markdown",
            "computed": true
          },
          "ipv4": {
            "type": "string",
            "description": "The IPv4 address of the instance",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Instance name",
            "description_kind": "markdown",
            "required": true
          },
          "state": {
            "type": "string",
            "description": "The state of the instance",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Instance data source",
        "description_kind": "markdown"
      }
    }
  }
}
