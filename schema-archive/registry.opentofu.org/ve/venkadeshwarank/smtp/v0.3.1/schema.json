{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "authentication": {
          "type": "bool",
          "description": "Enable or Disable the authentication with SMTP (by default, it sets to 'true'). May also be provided via SMTP_AUTHENTICATION environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "SMTP host domain. eg. smtp.example.com. May also be provided via SMTP_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password to authenticate with SMTP. May also be provided via SMTP_PASSWORD environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "port": {
          "type": "string",
          "description": "SMTP host port. eg: 25. May also be provided via SMTP_PORT environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "User name to authenticate with SMTP. May also be provided via SMTP_USERNAME environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with SMTP.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "smtp_send_mail": {
      "version": 0,
      "block": {
        "attributes": {
          "bcc": {
            "type": [
              "list",
              "string"
            ],
            "description": "BCC email addresses. ",
            "description_kind": "plain",
            "optional": true
          },
          "body": {
            "type": "string",
            "description": "Body of the email.",
            "description_kind": "plain",
            "required": true
          },
          "cc": {
            "type": [
              "list",
              "string"
            ],
            "description": "CC email addresses.",
            "description_kind": "plain",
            "optional": true
          },
          "from": {
            "type": "string",
            "description": "From email address. If not provided, the username used in the smtp auth will be used.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Autogenerated id for the resource.",
            "description_kind": "plain",
            "computed": true
          },
          "render_html": {
            "type": "bool",
            "description": "Boolean flag is identify whether the body is html or plain text. Set this to `true` if body is a HTML content.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "subject": {
            "type": "string",
            "description": "Subject of the email.",
            "description_kind": "plain",
            "required": true
          },
          "to": {
            "type": [
              "list",
              "string"
            ],
            "description": "To email addresses.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Send a email with smtp. Note: At this moment TLS validation is not support.",
        "description_kind": "plain"
      }
    }
  }
}
