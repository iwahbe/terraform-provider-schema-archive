{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key": {
          "type": "string",
          "description": "AWS access key ID",
          "description_kind": "plain",
          "optional": true
        },
        "auto_import": {
          "type": "bool",
          "description": "Automatically import on create, not recommended unless transitioning away from GSI created with the AWS resource",
          "description_kind": "plain",
          "optional": true
        },
        "dynamodb_endpoint": {
          "type": "string",
          "description": "AWS dynamodb endpoint",
          "description_kind": "plain",
          "optional": true
        },
        "profile": {
          "type": "string",
          "description": "AWS profile",
          "description_kind": "plain",
          "optional": true
        },
        "region": {
          "type": "string",
          "description": "AWS region",
          "description_kind": "plain",
          "optional": true
        },
        "secret_key": {
          "type": "string",
          "description": "AWS secret key ID",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "AWS session token",
          "description_kind": "plain",
          "optional": true
        },
        "validate": {
          "type": "bool",
          "description": "Validate AWS credentials passed to the provider. Consider setting false if using an IAM role or EC2 instance profile.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "block_types": {
        "assume_role": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "role_arn": {
                "type": "string",
                "description": "Amazon Resource Name (ARN) of an IAM Role to assume prior to making API calls.",
                "description_kind": "plain",
                "optional": true
              }
            },
            "description_kind": "plain"
          },
          "max_items": 1
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "gsi_global_secondary_index": {
      "version": 0,
      "block": {
        "attributes": {
          "arn": {
            "type": "string",
            "description": "ARN of the Global Secondary Index.",
            "description_kind": "plain",
            "computed": true
          },
          "autoscaling_enabled": {
            "type": "bool",
            "description": "Whether capacity is controlled by an autoscaler.",
            "description_kind": "plain",
            "optional": true
          },
          "billing_mode": {
            "type": "string",
            "description": "The billing mode to apply to this index. Should match the associated table",
            "description_kind": "plain",
            "optional": true
          },
          "hash_key": {
            "type": "string",
            "description": "Hash key of the index.",
            "description_kind": "plain",
            "required": true
          },
          "hash_key_type": {
            "type": "string",
            "description": "Type of the hash key.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the index.",
            "description_kind": "plain",
            "required": true
          },
          "non_key_attributes": {
            "type": [
              "set",
              "string"
            ],
            "description": "Additional attributes to include based in the projection.",
            "description_kind": "plain",
            "optional": true
          },
          "projection_type": {
            "type": "string",
            "description": "Projection type.",
            "description_kind": "plain",
            "required": true
          },
          "range_key": {
            "type": "string",
            "description": "Range key of the index.",
            "description_kind": "plain",
            "optional": true
          },
          "range_key_type": {
            "type": "string",
            "description": "Type of the range key.",
            "description_kind": "plain",
            "optional": true
          },
          "read_capacity": {
            "type": "number",
            "description": "Read capacity for the index, untracked after creation if autoscaling is enabled.",
            "description_kind": "plain",
            "optional": true
          },
          "table_name": {
            "type": "string",
            "description": "Name of the DynamoDB table to which the GSI is associated..",
            "description_kind": "plain",
            "required": true
          },
          "write_capacity": {
            "type": "number",
            "description": "Write capacity for the table, untracked after creation if autoscaling is enabled.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
