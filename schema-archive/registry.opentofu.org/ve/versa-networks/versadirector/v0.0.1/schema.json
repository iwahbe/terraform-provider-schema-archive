{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "IP Address for versadirector, May also be provided via VERSA_DIRECTOR_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "oauth_client_id": {
          "type": "string",
          "description": "OAUTH2 Client-ID for authentication, May also be provided via VERSA_DIRECTOR_OAUTH_CLIENT_ID environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "oauth_client_secret": {
          "type": "string",
          "description": "OAUTH2 Client-secret for authentication, May also be provided via VERSA_DIRECTOR_OAUTH_CLIENT_SECRET environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "oauth_grant_type": {
          "type": "string",
          "description": "Grant-Type for OAUTH2 authentication, May also be provided via VERSA_DIRECTOR_OAUTH_GRANT_TYPE environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "password": {
          "type": "string",
          "description": "Password for versadirector, May also be provided via VERSA_DIRECTOR_PASSWORD environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "port": {
          "type": "string",
          "description": "Port for versadirector, May also be provided via VERSA_DIRECTOR_PORT environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username for versadirector, May also be provided via VERSA_DIRECTOR_USERNAME environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interfact with versadirector",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "versadirector_addresses": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "nested_type": {
              "attributes": {
                "fqdn": {
                  "type": "string",
                  "description": "FQDN for the address object.",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the address object.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of addresses to be configured.",
            "description_kind": "plain",
            "required": true
          },
          "device_name": {
            "type": "string",
            "description": "Device name to be configured.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier name to be configured.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update of the configuration.",
            "description_kind": "plain",
            "computed": true
          },
          "organization_name": {
            "type": "string",
            "description": "Organization name for the device to be configured.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "versadirector_addresses": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "nested_type": {
              "attributes": {
                "fqdn": {
                  "type": "string",
                  "description": "FQDN for the address object.",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the address object.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of configured addresses.",
            "description_kind": "plain",
            "optional": true
          },
          "device_name": {
            "type": "string",
            "description": "Device name to be configured.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier name to be configured.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update of the configuration.",
            "description_kind": "plain",
            "computed": true
          },
          "organization_name": {
            "type": "string",
            "description": "Organization name for the device to be configured.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
