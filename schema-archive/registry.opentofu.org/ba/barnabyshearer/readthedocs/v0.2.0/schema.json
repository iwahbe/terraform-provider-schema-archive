{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "ReadTheDocs API base URL. Can be used to target the Read The Docs For Business API.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "API Token for authentication.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "readthedocs_project": {
      "version": 0,
      "block": {
        "attributes": {
          "analytics_code": {
            "type": "string",
            "description": "Google Analytics code for tracking views.",
            "description_kind": "plain",
            "optional": true
          },
          "analytics_disabled": {
            "type": "bool",
            "description": "Disable Google Analytics.",
            "description_kind": "plain",
            "optional": true
          },
          "default_branch": {
            "type": "string",
            "description": "Branch to build from.",
            "description_kind": "plain",
            "optional": true
          },
          "default_version": {
            "type": "string",
            "description": "Version of documentation to show by default.",
            "description_kind": "plain",
            "optional": true
          },
          "external_builds_enabled": {
            "type": "bool",
            "description": "Build PRs.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The Slug of the project.",
            "description_kind": "plain",
            "computed": true
          },
          "language": {
            "type": "string",
            "description": "Given like `en`, `fr` etc.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Project name.",
            "description_kind": "plain",
            "required": true
          },
          "organization": {
            "type": "string",
            "description": "ReadTheDocs for Business organization where the project should be created. Only valid when using Read The Docs for Business.",
            "description_kind": "plain",
            "optional": true
          },
          "programming_language": {
            "type": "string",
            "description": "Given like `py`, `js` etc.",
            "description_kind": "plain",
            "optional": true
          },
          "repository": {
            "type": "string",
            "description": "URL of repository to clone documentation from.",
            "description_kind": "plain",
            "required": true
          },
          "show_version_warning": {
            "type": "bool",
            "description": "Warn when viewing old versions.",
            "description_kind": "plain",
            "optional": true
          },
          "single_version": {
            "type": "bool",
            "description": "Only show single version.",
            "description_kind": "plain",
            "optional": true
          },
          "teams": {
            "type": "string",
            "description": "Team slugs the project will belong to. Only valid when using Read The Docs for Business.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "A readthedocs.org project.",
        "description_kind": "plain"
      }
    }
  }
}
