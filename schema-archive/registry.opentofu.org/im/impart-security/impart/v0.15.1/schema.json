    "impart_rule_test_case": {
      "version": 0,
      "block": {
        "attributes": {
          "assertions": {
            "nested_type": {
              "attributes": {
                "assertion_type": {
                  "type": "string",
                  "description": "The assertion type of the request.",
                  "description_kind": "plain",
                  "required": true
                },
                "condition": {
                  "type": "string",
                  "description": "\nThe condition of the assertion.\nAccepted values per assertion type:\n**output**: contains, not_contains.\n**tags**: contains, not_contains.\n**status_code**: equal, not_equal, greater_than, less_than, one_of.\n**block**: N/A",
                  "description_kind": "markdown",
                  "optional": true
                },
                "description": {
                  "type": "string",
                  "description": "The description of the assertion.",
                  "description_kind": "plain",
                  "optional": true
                },
                "expected": {
                  "type": "string",
                  "description": "\nThe expected value of the assertion.\nIt is a string value, and the format it must satisfy depends on the assertion type:\n**output**: A string.\n**tags**: A string.\n**status_code**: An integer value (e.g., \"200\") or comma-separated list of integers for one_of condition (e.g., \"200,404,500\").\n**block**: A boolean value represented as \"true\" or \"false\".",
                  "description_kind": "markdown",
                  "required": true
                },
                "location": {
                  "type": "string",
                  "description": "The location of the assertion. Allowed values: req, res. Not applicable for assertion type output.",
                  "description_kind": "plain",
                  "optional": true
                },
                "message_indexes": {
                  "type": [
                    "list",
                    "number"
                  ],
                  "description": "The indexes of the messages in the test case the assertion applies to.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The assertions of the test case.",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "The description of the test case.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the test case.",
            "description_kind": "plain",
            "computed": true
          },
          "labels": {
            "type": [
              "list",
              "string"
            ],
            "description": "The applied labels.",
            "description_kind": "plain",
            "optional": true
          },
          "messages": {
            "nested_type": {
              "attributes": {
                "count": {
                  "type": "number",
                  "description": "The number of times to include the message in the test case.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "delay": {
                  "type": "number",
                  "description": "The delay in milliseconds between message iterations.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
