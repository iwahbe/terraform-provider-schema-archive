            "type": [
              "list",
              "string"
            ],
            "description": "An array of notification template ids for the templates that will send notifications to their respective connectors.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage a monitor.",
        "description_kind": "plain"
      }
