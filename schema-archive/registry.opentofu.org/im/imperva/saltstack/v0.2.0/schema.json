{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "debug": {
          "type": "bool",
          "description": "Run provider in DEBUG mode. Defaults to `false`",
          "description_kind": "plain",
          "optional": true
        },
        "eauth": {
          "type": "string",
          "description": "Salt Master API External Authentication system. Currently supports: `pam`, `file`, `sharedsecret`. Reference: https://docs.saltproject.io/en/latest/topics/eauth/index.html. Defaults to `pam`",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "Salt Master hostname.",
          "description_kind": "plain",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "Salt Master API password.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "port": {
          "type": "number",
          "description": "Salt Master API port.",
          "description_kind": "plain",
          "required": true
        },
        "scheme": {
          "type": "string",
          "description": "Connection scheme. Can be http or https. Defaults to `https`.",
          "description_kind": "plain",
          "optional": true
        },
        "ssl_skip_verify": {
          "type": "bool",
          "description": "Skip SSL verification. Defaults to `false`",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Authentication token if `use_token` is true.",
          "description_kind": "plain",
          "optional": true
        },
        "use_token": {
          "type": "bool",
          "description": "Whether or not to use token authentication. Reference: https://docs.saltproject.io/en/latest/topics/eauth/index.html#tokens. Defaults to `false`",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Salt Master API username.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "saltstack_minion_key_pair": {
      "version": 0,
      "block": {
        "attributes": {
          "force": {
            "type": "bool",
            "description": "If set to True, it will overwrite existing keys for the same ID. A previously accepted key will be overwritten and will result in the minion being unable to connect.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "key_size": {
            "type": "number",
            "description": "The size of the key pair to generate. The size must be 2048, which is the default, or greater. If set to a value less than 2048, the key size will be rounded up to 2048.",
            "description_kind": "plain",
            "optional": true
          },
          "minion_id": {
            "type": "string",
            "description": "The ID of SaltStack minion.",
            "description_kind": "plain",
            "required": true
          },
          "private_key": {
            "type": "string",
            "description": "Minion's private key.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "public_key": {
            "type": "string",
            "description": "Minion's public key.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
