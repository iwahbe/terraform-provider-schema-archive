{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "basepath": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "password": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "scheme": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "couchdb_bulk_documents": {
      "version": 0,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description": "Database to associate design with",
            "description_kind": "plain",
            "required": true
          },
          "docs": {
            "type": "string",
            "description": "JSON Document, the _id field is required (wrap in <<EOF { } EOF)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "partition": {
            "type": "string",
            "description": "partition key to add to the document id",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "couchdb_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "action": {
            "type": "string",
            "description": "enable_single_node, enable_cluster, add_node, finish_cluster",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "state": {
            "type": "string",
            "description": "Indicates the current node or cluster state",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "couchdb_database": {
      "version": 0,
      "block": {
        "attributes": {
          "document_count": {
            "type": "number",
            "description": "Number of documents in database",
            "description_kind": "plain",
            "computed": true
          },
          "document_deletion_count": {
            "type": "number",
            "description": "Number of tombstones in database",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the database",
            "description_kind": "plain",
            "required": true
          },
          "partitioned": {
            "type": "bool",
            "description": "Whether to create a partitioned database",
            "description_kind": "plain",
            "optional": true
          },
          "size_file": {
            "type": "number",
            "description": "The size of the database file on disk in bytes. Views indexes are not included in the calculation",
            "description_kind": "plain",
            "computed": true
          },
          "sizes_active": {
            "type": "number",
            "description": "The size of live data inside the database, in bytes.",
            "description_kind": "plain",
            "computed": true
          },
          "sizes_external": {
            "type": "number",
            "description": "The uncompressed size of database contents in bytes.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "clustering": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "replicas": {
                  "type": "number",
                  "description": "Number of replicas",
                  "description_kind": "plain",
                  "optional": true
                },
                "shards": {
                  "type": "number",
                  "description": "Number of shards",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "database clustering configuration",
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "couchdb_database_design_document": {
      "version": 0,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description": "Database to associate design with",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "indexes": {
            "type": "string",
            "description": "The indexes inside the design document (wrap in <<EOF { } EOF)",
            "description_kind": "plain",
            "optional": true
          },
          "language": {
            "type": "string",
            "description": "Language of map/ reduce functions",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the design document",
            "description_kind": "plain",
            "required": true
          },
          "revision": {
            "type": "string",
            "description": "Revision",
            "description_kind": "plain",
            "computed": true
          },
          "views": {
            "type": "string",
            "description": "The views inside the design document (wrap in <<EOF { } EOF)",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "couchdb_database_replication": {
      "version": 0,
      "block": {
        "attributes": {
          "continuous": {
            "type": "bool",
            "description": "Keep the replication permanently running?",
            "description_kind": "plain",
            "optional": true
          },
          "create_target": {
            "type": "bool",
            "description": "Create target if it does not exist?",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "revision": {
            "type": "string",
            "description": "Revision",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "source": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "headers": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "authorization": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description": "Source of the replication",
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "target": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "headers": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "authorization": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description": "Target of the replication",
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "couchdb_document": {
      "version": 0,
      "block": {
        "attributes": {
          "batch": {
            "type": "bool",
            "description": " Stores document in batch mode, Batch mode is not suitable for critical data",
            "description_kind": "plain",
            "optional": true
          },
          "database": {
            "type": "string",
            "description": "Database to associate design with",
            "description_kind": "plain",
            "required": true
          },
          "doc": {
            "type": "string",
            "description": "JSON Document (wrap in <<EOF { } EOF)",
            "description_kind": "plain",
            "required": true
          },
          "docid": {
            "type": "string",
            "description": "Document ID",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "revision": {
            "type": "string",
            "description": "Revision",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "couchdb_user": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Username",
            "description_kind": "plain",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Password",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "revision": {
            "type": "string",
            "description": "Revision",
            "description_kind": "plain",
            "computed": true
          },
          "roles": {
            "type": [
              "set",
              "string"
            ],
            "description": "User roles",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
