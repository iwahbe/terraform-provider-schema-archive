{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "issuer_id": {
          "type": "string",
          "description": "The issuer ID from the API keys page in App Store Connect. Can also be set via the `APP_STORE_CONNECT_ISSUER_ID` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "key_id": {
          "type": "string",
          "description": "The key ID from the API keys page in App Store Connect. Can also be set via the `APP_STORE_CONNECT_KEY_ID` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "private_key": {
          "type": "string",
          "description": "The private key contents (.p8 file) for App Store Connect API authentication. Can also be set via the `APP_STORE_CONNECT_PRIVATE_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Apple App Store Connect provider allows you to manage App Store Connect resources such as Pass Type IDs and Certificates.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "appleappstoreconnect_certificate": {
      "version": 0,
      "block": {
        "attributes": {
          "certificate_ca_issuers": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of CA Issuer URIs from the Authority Information Access extension.",
            "description_kind": "markdown",
            "computed": true
          },
          "certificate_content": {
            "type": "string",
            "description": "The certificate content in base64 encoded DER format.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "certificate_content_pem": {
            "type": "string",
            "description": "The certificate content in base64 encoded PEM format.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "certificate_type": {
            "type": "string",
            "description": "The type of certificate to create. Valid values are: `IOS_DEVELOPMENT`, `IOS_DISTRIBUTION`, `MAC_APP_DEVELOPMENT`, `MAC_APP_DISTRIBUTION`, `MAC_INSTALLER_DISTRIBUTION`, `PASS_TYPE_ID`, `PASS_TYPE_ID_WITH_NFC`, `DEVELOPER_ID_KEXT`, `DEVELOPER_ID_APPLICATION`, `DEVELOPMENT_PUSH_SSL`, `PRODUCTION_PUSH_SSL`, `PUSH_SSL`.",
            "description_kind": "markdown",
            "required": true
          },
          "csr_content": {
            "type": "string",
            "description": "The certificate signing request (CSR) content in PEM format.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "display_name": {
            "type": "string",
            "description": "The display name of the certificate.",
            "description_kind": "markdown",
            "computed": true
          },
          "expiration_date": {
            "type": "string",
            "description": "The expiration date of the certificate.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the Certificate.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the certificate.",
            "description_kind": "markdown",
            "computed": true
          },
          "pkcs12_bundle_content": {
            "type": "string",
            "description": "The PKCS12 bundle content in base64 encoded format. Only available when `pkcs12_bundle_password` is provided.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "pkcs12_bundle_password": {
            "type": "string",
            "description": "Password to use for the PKCS12 bundle. When provided, a PKCS12 bundle will be generated and available in the `pkcs12_bundle_content` attribute. Changes to this value do not require certificate replacement.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "platform": {
            "type": "string",
            "description": "The platform for the certificate.",
            "description_kind": "markdown",
            "computed": true
          },
          "private_key_pem": {
            "type": "string",
            "description": "The private key in PEM format. Only required if you want to generate a PKCS12 bundle. This is not sent to Apple's API and is only used locally for PKCS12 generation. Changes to this value do not require certificate replacement.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "recreate_threshold": {
            "type": "number",
            "description": "The number of seconds before certificate expiration when Terraform should recreate the certificate. Set to 0 to disable automatic recreation. Default is 2592000 seconds (30 days).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "relationships": {
            "nested_type": {
              "attributes": {
                "pass_type_id": {
                  "type": "string",
                  "description": "The ID of the Pass Type ID to associate with this certificate. Required for PASS_TYPE_ID and PASS_TYPE_ID_WITH_NFC certificate types.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The relationships for the certificate.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "serial_number": {
            "type": "string",
            "description": "The serial number of the certificate.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manages a Certificate in App Store Connect.",
        "description_kind": "markdown"
      }
    },
    "appleappstoreconnect_pass_type_id": {
      "version": 0,
      "block": {
        "attributes": {
          "created_date": {
            "type": "string",
            "description": "The date when the Pass Type ID was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "A description of the Pass Type ID.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the Pass Type ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "identifier": {
            "type": "string",
            "description": "The identifier for the Pass Type ID (e.g., 'pass.io.truetickets.test.membership'). This must be unique and follow reverse-DNS format.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a Pass Type ID in App Store Connect.",
        "description_kind": "markdown"
      }
    }
  },
