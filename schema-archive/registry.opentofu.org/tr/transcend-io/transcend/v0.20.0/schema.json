    "transcend_data_point": {
      "version": 0,
      "block": {
        "attributes": {
          "data_silo_id": {
            "type": "string",
            "description": "The id of the data silo to create the datapoint for",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "A description for the datapoint",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "he datapoint name (used to key by)",
            "description_kind": "plain",
            "required": true
          },
          "path": {
            "type": [
              "list",
              "string"
            ],
            "description": "Usually only relevant for databases,\nthis field should include any schema information for a given datapoint.\n\t\t\t\nExamples:\n- In postgres, it's possible to have multiple tables with the same name under\ndifferent schemas. e.g., \"public\", \"test\". So here you'd specify [\"public\"] or [\"test\"]\n- In Snowflake, it's possible to have different databases with different schemas,\nso you can specify [\"ANALYTICS\", \"public\"] to indicate that the datapoint belongs to\nthe \"public\" schema of the \"ANALYTICS\" database.",
            "description_kind": "plain",
            "optional": true
          },
          "title": {
            "type": "string",
            "description": "The title of the datapoint",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "properties": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "access_request_visibility_enabled": {
                  "type": "bool",
                  "description": "When true, this subdatapoint should be revealed in a data access request. When false, this field should be redacted",
                  "description_kind": "plain",
                  "optional": true
                },
                "description": {
                  "type": "string",
                  "description": "A description for the subdatapoint",
                  "description_kind": "plain",
                  "optional": true
                },
                "erasure_request_redaction_enabled": {
                  "type": "bool",
                  "description": "When true, this subdatapoint should be redacted during an erasure request.\nThere normally is a choice of enabling hard deletion or redaction at the\ndatapoint level, but if redaction is enabled, this column can be used\nto define which fields should be redacted.",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the subdatapoint",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "attributes": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "key": {
                        "type": "string",
                        "description": "The attribute key that houses the attribute values",
                        "description_kind": "plain",
                        "required": true
                      },
                      "values": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "The attribute values used to label resources",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "The attribute values used to label this subdatapoint",
                    "description_kind": "plain"
                  }
                },
                "categories": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "category": {
                        "type": "string",
                        "description": "The category of personal data",
                        "description_kind": "plain",
                        "required": true
                      },
                      "name": {
                        "type": "string",
                        "description": "The name of the subcategory",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "The category of personal data for this subdatapoint",
                    "description_kind": "plain"
                  }
                },
                "purposes": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "The purpose of processing sub category",
                        "description_kind": "plain",
                        "required": true
                      },
                      "purpose": {
                        "type": "string",
                        "description": "The purpose of processing",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "The processing purposes for this subdatapoint",
                    "description_kind": "plain"
                  }
                }
              },
              "description": "The properties associated with this datapoint",
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
