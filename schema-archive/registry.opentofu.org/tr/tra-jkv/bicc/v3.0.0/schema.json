{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "The Oracle Fusion Applications hostname (e.g., servername.fa.us2.oraclecloud.com). Can also be set via BICC_HOST environment variable.",
          "description_kind": "plain",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "Password for BICC authentication. Can also be set via BICC_PASSWORD environment variable.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "port": {
          "type": "number",
          "description": "Port for the BICC API. Defaults to 443 when not set. Must be between 1 and 65535.",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username for BICC authentication. Can also be set via BICC_USERNAME environment variable.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description": "Provider for managing Oracle Business Intelligence Cloud Connector (BICC) extraction jobs.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "bicc_job": {
      "version": 0,
      "block": {
        "attributes": {
          "data_stores": {
            "nested_type": {
              "attributes": {
                "auto_populate_all_columns": {
                  "type": "bool",
                  "description": "Automatically fetch and include all available columns from the data store. When true, define only column_overrides.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "chunk_date_seq_incr": {
                  "type": "number",
                  "description": "Date sequence increment for chunking.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "chunk_date_seq_min": {
                  "type": "number",
                  "description": "Minimum date sequence for chunking.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "chunk_pk_seq_incr": {
                  "type": "number",
                  "description": "Primary key sequence increment for chunking.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "chunk_type": {
                  "type": "string",
                  "description": "Chunking type for large extractions. Use 'DateSeqIncr' to chunk by creation date (requires at least one column marked is_creation_date=true).",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "column_overrides": {
                  "nested_type": {
                    "attributes": {
                      "is_creation_date": {
                        "type": "bool",
                        "description": "Override: mark as creation date column.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "is_effective_start_date": {
                        "type": "bool",
                        "description": "Override: mark as effective start date column.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "is_last_update_date": {
                        "type": "bool",
                        "description": "Override: mark as last update date column (required for incremental).",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "is_natural_key": {
                        "type": "bool",
                        "description": "Override: mark as natural key column.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "is_populate": {
                        "type": "bool",
                        "description": "Override: include this column in extraction.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "is_primary_key": {
                        "type": "bool",
                        "description": "Override: mark as primary key column.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "name": {
                        "type": "string",
                        "description": "Column name to override.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "Column configuration overrides (use with auto_populate_all_columns to mark specific columns like LastUpdateDate as incremental tracking).",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "columns": {
                  "nested_type": {
                    "attributes": {
                      "is_creation_date": {
                        "type": "bool",
                        "description": "Mark as creation date column.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "is_effective_start_date": {
                        "type": "bool",
                        "description": "Mark as effective start date column.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "is_last_update_date": {
                        "type": "bool",
                        "description": "Mark as last update date column (required for incremental).",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "is_natural_key": {
                        "type": "bool",
                        "description": "Mark as natural key column.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "is_populate": {
                        "type": "bool",
                        "description": "Include this column in extraction.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "is_primary_key": {
                        "type": "bool",
                        "description": "Mark as primary key column.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "name": {
                        "type": "string",
                        "description": "Column name.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "set"
                  },
                  "description": "Explicit column configuration. Not needed when auto_populate_all_columns is true.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "data_store_key": {
                  "type": "string",
                  "description": "Unique key for the data store (e.g., CrmAnalyticsAM.PartiesAnalyticsAM.Person).",
                  "description_kind": "plain",
                  "required": true
                },
                "filters": {
                  "type": "string",
                  "description": "Filter expression for data extraction.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "initial_extract_date": {
                  "type": "string",
                  "description": "Initial extract date for incremental extraction (format: YYYY-MM-DD).",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "is_effective_date_disabled": {
                  "type": "bool",
                  "description": "Disable effective date filtering.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "is_silent_error": {
                  "type": "bool",
                  "description": "Continue extraction even if this data store fails.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "use_union_for_incremental": {
                  "type": "bool",
                  "description": "Enable incremental extraction using UNION approach.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "Set of data stores to extract (order-independent, keyed by data_store_key).",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Description of the BICC job.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The numeric ID of the BICC job.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the BICC job.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a BICC extraction job.",
        "description_kind": "plain"
      }
    }
  }
}
