            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "user_id": {
            "type": "string",
            "description": "The user ID.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "\nProvides a user and group membership.\n\nA 1password group membership will make a user part of a group with a role on that group.\n",
        "description_kind": "plain"
      }
    },
