            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the group.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "\nProvides a Group resource.\n\nA 1password group is like a team that can contain people and can be used to give access to vaults as a\ngroup of users.\n",
        "description_kind": "plain"
      }
    },
