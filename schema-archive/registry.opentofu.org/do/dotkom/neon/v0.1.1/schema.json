{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "token": {
          "type": "string",
          "description": "The token used to authenticate with Neon.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "neon_branch": {
      "version": 0,
      "block": {
        "attributes": {
          "endpoint": {
            "nested_type": {
              "attributes": {
                "compute_provisioner": {
                  "type": "string",
                  "description": "Provisioner of the endpoint.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "host": {
                  "type": "string",
                  "description": "Host of the endpoint.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Identifier of the endpoint.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "max_cu": {
                  "type": "number",
                  "description": "Maximum number of compute units for the endpoint. **Default** `0.25`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "min_cu": {
                  "type": "number",
                  "description": "Minimum number of compute units for the endpoint. **Default** `0.25`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "suspend_timeout": {
                  "type": "number",
                  "description": "Suspend timeout of the endpoint. **Default** `300`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Read-write compute endpoint settings of the branch.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the branch.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the branch.",
            "description_kind": "markdown",
            "required": true
          },
          "parent_id": {
            "type": "string",
            "description": "ID of the parent branch. Defaults to the primary branch.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Project the branch belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Neon branch. Please use `neon_project` to create primary branch.",
        "description_kind": "markdown"
      }
    },
    "neon_database": {
      "version": 0,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch the database belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "ID of the database.",
            "description_kind": "markdown",
            "computed": true
