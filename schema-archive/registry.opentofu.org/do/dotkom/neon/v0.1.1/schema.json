            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "Project the database belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Neon database.",
        "description_kind": "markdown"
      }
