{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "allow_insecure": {
          "type": "bool",
          "description": "Allow invalid certificates on the Mastodon server.",
          "description_kind": "markdown",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "The client ID of the application.",
          "description_kind": "markdown",
          "required": true
        },
        "client_secret": {
          "type": "string",
          "description": "The client secret of the application.",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "password": {
          "type": "string",
          "description": "The password of the user.",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "server": {
          "type": "string",
          "description": "The server to connect to.",
          "description_kind": "markdown",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "The user with which to login.",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "mastodon_follow": {
      "version": 0,
      "block": {
        "attributes": {
          "account": {
            "type": "string",
            "description": "The name of the account to follow. If remote, it must include the domain.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the account on the local server.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "mastodon_follow manages the following relationship between the user and an account, either local or remote.",
        "description_kind": "markdown"
      }
    }
  }
}
