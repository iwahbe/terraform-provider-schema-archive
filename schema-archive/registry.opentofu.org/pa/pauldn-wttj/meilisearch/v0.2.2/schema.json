{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Meilisearch master API key. May also be provided via MEILISEARCH_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "host": {
          "type": "string",
          "description": "Host of Meilisearch server. May also be provided via MEILISEARCH_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "meilisearch_index": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Date and time when the key was created (RFC3339)",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Placeholder identifier attribute.",
            "description_kind": "plain",
            "computed": true
          },
          "primary_key": {
            "type": "string",
            "description": "Primary key of the index (`null` if not specified and if no documents have been added yet, see [official documentation](https://www.meilisearch.com/docs/learn/core_concepts/primary_key#meilisearch-guesses-your-primary-key) for more details).",
            "description_kind": "plain",
            "required": true
          },
          "uid": {
            "type": "string",
            "description": "Unique identifier of the index.",
            "description_kind": "plain",
            "required": true
          },
          "updated_at": {
            "type": "string",
            "description": "Date and time when the key was last updated (RFC3339)",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a Meilisearch Index.",
        "description_kind": "plain"
      }
    },
    "meilisearch_key": {
      "version": 0,
      "block": {
        "attributes": {
          "actions": {
            "type": [
              "list",
              "string"
            ],
            "description": "Actions permitted for the key.",
            "description_kind": "plain",
            "required": true
          },
          "created_at": {
            "type": "string",
            "description": "Date and time when the key was created (RFC3339)",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Description of the key.",
            "description_kind": "plain",
            "optional": true
          },
          "expires_at": {
            "type": "string",
            "description": "Date and time when the key will expire (RFC3339)",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Placeholder identifier attribute.",
            "description_kind": "plain",
            "computed": true
          },
          "indexes": {
            "type": [
              "list",
              "string"
            ],
            "description": "Indexes the key is authorized to act on (with the actions specified in the scope of the key).",
            "description_kind": "plain",
            "required": true
          },
          "key": {
            "type": "string",
            "description": "Actual key value.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "Name of the key.",
            "description_kind": "plain",
            "optional": true
          },
          "uid": {
            "type": "string",
            "description": "UID (uuid v4) used by Meilisearch to identify the key.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "Date and time when the key was last updated (RFC3339)",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a Meilisearch API key.",
        "description_kind": "plain"
      }
    }
  },
