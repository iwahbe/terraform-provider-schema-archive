{
  "provider": {
    "version": 1,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "This can be used to override the base URL for Snyk API requests. It can be also sourced from the `SNYK_ENDPOINT` environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "This is the API token from Snyk. It must be provided, but it can also be sourced from the `SNYK_TOKEN` environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "snyk_integration": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the integration.",
            "description_kind": "plain",
            "computed": true
          },
          "organization_id": {
            "type": "string",
            "description": "The ID of the organization that the integration belongs to.",
            "description_kind": "plain",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "The password used by the integration.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "pull_request_dependency_upgrade": {
            "nested_type": {
              "attributes": {
                "enabled": {
                  "type": "bool",
                  "description": "Denotes the pull request automatic dependency upgrade feature should be enabled for this integration",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "ignored_dependencies": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of exact names of the dependencies that should not be included in the automatic upgrade operation. You can use only enter lowercase letters.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "include_major_version": {
                  "type": "bool",
                  "description": "Defines if major version upgrades will be included in the recommendations. By default, only patches and minor versions are included in the upgrade recommendations.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "limit": {
                  "type": "number",
                  "description": "The maximum number of simultaneously opened pull requests with dependency upgrades.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The pull request configuration for dependency upgrades. Snyk can automatically raise pull requests to update out-of-date dependencies.",
            "description_kind": "plain",
            "optional": true
          },
          "pull_request_sca": {
            "nested_type": {
              "attributes": {
                "enabled": {
                  "type": "bool",
                  "description": "Denotes the pull request SCA feature should be enabled for this integration.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "fail_on_any_issue": {
                  "type": "bool",
                  "description": "Fails an opened pull request if any vulnerable dependencies have been detected, otherwise the pull request should only fail when a dependency with issues is added.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "fail_only_for_high_and_critical_severity": {
                  "type": "bool",
                  "description": "Fails an opened pull request if any dependencies are marked as being of high or critical severity.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "fail_only_on_issues_with_fix": {
                  "type": "bool",
                  "description": "Fails an opened pull request only when issues found have a fix available.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The pull request testing configuration for SCA (Software Composition Analysis). Snyk will checks projects imported through the SCM integration for security and license issues whenever a new PR is opened.",
            "description_kind": "plain",
            "optional": true
          },
          "region": {
            "type": "string",
            "description": "The region used by the integration.",
            "description_kind": "plain",
            "optional": true
          },
          "registry_url": {
            "type": "string",
            "description": "The URL for container registries used by the integration (e.g. for ECR).",
            "description_kind": "plain",
            "optional": true
          },
          "role_arn": {
            "type": "string",
            "description": "The role ARN used by the integration (ECR only).",
            "description_kind": "plain",
            "optional": true
          },
          "token": {
            "type": "string",
            "description": "The token used by the integration.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "type": {
            "type": "string",
            "description": "The integration type, e.g. 'github'.",
            "description_kind": "plain",
            "required": true
          },
          "url": {
            "type": "string",
            "description": "The URL used by the integration.",
            "description_kind": "plain",
            "optional": true
          },
          "username": {
            "type": "string",
            "description": "The username used by the integration.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "The integration resource allows you to manage Snyk integration.",
        "description_kind": "plain"
      }
    },
    "snyk_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "group_id": {
            "type": "string",
            "description": "The ID of the group that contains the organization.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the organization.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the organization.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "The organization resource allows you to manage Snyk organization.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "snyk_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "group_id": {
            "type": "string",
            "description": "The ID of the group that contains the organization.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the organization.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the organization.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "The organization data source provides information about an existing Snyk organization.",
        "description_kind": "plain"
      }
    },
    "snyk_project": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the project.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the project.",
            "description_kind": "plain",
            "required": true
          },
          "organization_id": {
            "type": "string",
            "description": "The ID of the organization that the project belongs to.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "The project data source provides information about an existing Snyk project.",
        "description_kind": "plain"
      }
    },
    "snyk_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "The email of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the user.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "The username of the user.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "The user data source provides information about an existing Snyk user.",
        "description_kind": "plain"
      }
    }
  }
}
