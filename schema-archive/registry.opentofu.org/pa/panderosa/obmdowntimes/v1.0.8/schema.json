{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "address": {
          "type": "string",
          "description": "The URL of the Action web service https://<server>:<port>/topaz/bsmservices/customers/[customerID]/downtimes, where <server> is the name of the OMi server.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Provider will use this password for BASIC auth to the Downtimes API. By default provider takes the password from the OBM_BA_PASSWORD environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Provider will use this username for BASIC auth to the Downtimes API. By default provider takes the username from the OBM_BA_USER environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "downtime": {
      "version": 0,
      "block": {
        "attributes": {
          "action": {
            "type": "string",
            "description": "A value which represents the downtime action name. Valid values: REMINDER, SUPPRESS_NOTIFICATIONS, ENFORCE_ON_KPI_CALCULATION, ENFORCE_ON_REPORTS, STOP_MONITORING, ENFORCE_ON_REPORTS.",
            "description_kind": "plain",
            "required": true
          },
          "approver": {
            "type": "string",
            "description": "Name of the approver of the downtime",
            "description_kind": "plain",
            "required": true
          },
          "category": {
            "type": "string",
            "description": "A value which represents the downtime category name. Valid values: NW_MAINTENANCE, HW_MAINTENANCE, HW_INSTALLATION, SECURITY, OTHER, OS_CONFIGURATION, APP_MAINTENANCE, APP_INSTALLATION.",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Long description for the downtime.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the downtime.",
            "description_kind": "plain",
            "required": true
          },
          "selected_cis": {
            "type": [
              "set",
              "string"
            ],
            "description": "Array of RTSM configuration items id's impacted by the downtime: [\"id1\",\"id2\",...].",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "schedule": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "end_date": {
                  "type": "string",
                  "description": "The downtime end date specified as the RFC 3339 date-time format: yyyy-MM-dd'T'HH:mm:ss('+'/'-')HH:mm.",
                  "description_kind": "plain",
                  "required": true
                },
                "start_date": {
                  "type": "string",
                  "description": "The downtime start date specified as the RFC 3339 date-time format: yyyy-MM-dd'T'HH:mm:ss('+'/'-')HH:mm.",
                  "description_kind": "plain",
                  "required": true
                },
                "timezone": {
                  "type": "string",
                  "description": "Timezone used in start_date and end_date.",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description": "For the current version of the provider must be set to ONCE. The donwtime occurs only once on a specified start date and lasts till a specified end date.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "downtime_item": {
      "version": 0,
      "block": {
        "attributes": {
          "action": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "approver": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "category": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "schedule": {
            "type": [
              "set",
              [
                "object",
                {
                  "end_date": "string",
                  "start_date": "string",
                  "timezone": "string",
                  "type": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          },
          "selected_cis": {
            "type": [
              "set",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "downtime_item_list": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "item": {
            "type": [
              "set",
              [
                "object",
                {
                  "action": "string",
                  "approver": "string",
                  "category": "string",
                  "description": "string",
                  "id": "string",
                  "name": "string",
                  "schedule": [
                    "set",
                    [
                      "object",
                      {
                        "end_date": "string",
                        "start_date": "string",
                        "timezone": "string",
                        "type": "string"
                      }
                    ]
                  ],
                  "selected_cis": [
                    "set",
                    "string"
                  ]
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "filter": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
