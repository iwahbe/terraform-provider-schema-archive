{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API Key for Instatus API. May also be provided via INSTATUS_APIKEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Interact with Instatus.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "instatus_component": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the component.",
            "description_kind": "plain",
            "optional": true
          },
          "group": {
            "type": "string",
            "description": "Name of the group for the component (Require grouped set to true).",
            "description_kind": "plain",
            "optional": true
          },
          "group_id": {
            "type": "string",
            "description": "String Identifier of the parent group of the component.",
            "description_kind": "plain",
            "computed": true
          },
          "grouped": {
            "type": "bool",
            "description": "Whether the component is in a group (Require group set to desired name when true).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "String Identifier of the component.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update of the component.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the component.",
            "description_kind": "plain",
            "required": true
          },
          "order": {
            "type": "number",
            "description": "Order in the page of the component.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "page_id": {
            "type": "string",
            "description": "String Identifier of the page of the component.",
            "description_kind": "plain",
            "required": true
          },
          "show_uptime": {
            "type": "bool",
            "description": "Whether show uptime is enabled in the component.",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "Status of the component. One of: (OPERATIONAL, UNDERMAINTENANCE, DEGRADEDPERFORMANCE, PARTIALOUTAGE, MAJOROUTAGE).",
            "description_kind": "plain",
            "optional": true
          },
          "unique_email": {
            "type": "string",
            "description": "Unique email generated by Instatus for the component.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a component.",
        "description_kind": "plain"
      }
    },
    "instatus_template": {
      "version": 0,
      "block": {
        "attributes": {
          "components": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "String Identifier of the component.",
                  "description_kind": "plain",
                  "required": true
                },
                "status": {
                  "type": "string",
                  "description": "Status of the component. One of: (OPERATIONAL, UNDERMAINTENANCE, DEGRADEDPERFORMANCE, PARTIALOUTAGE, MAJOROUTAGE).",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of components in the template with their status.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "String Identifier of the template.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update of the template.",
            "description_kind": "plain",
            "computed": true
          },
          "message": {
            "type": "string",
            "description": "Message of the template.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the template.",
            "description_kind": "plain",
            "required": true
          },
          "notify": {
            "type": "bool",
            "description": "Whether notify is enabled for the template.",
            "description_kind": "plain",
            "optional": true
          },
          "page_id": {
            "type": "string",
            "description": "String Identifier of the page of the template.",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Status of the template. One of: (INVESTIGATING, IDENTIFIED, MONITORING, RESOLVED, NOTSTARTEDYET, INPROGRESS, COMPLETED).",
            "description_kind": "plain",
            "required": true
          },
          "subdomain": {
            "type": "string",
            "description": "Subdomain of the page of the template.",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of the template. One of: (MAINTENANCE, INCIDENT).",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a template.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "instatus_user": {
      "version": 0,
      "block": {
        "attributes": {
          "avatar": {
            "type": "string",
            "description": "Avatar url of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "Email of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "slug": {
            "type": "string",
            "description": "Slug of the user.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieves user profile.",
        "description_kind": "plain"
      }
    }
  }
}
