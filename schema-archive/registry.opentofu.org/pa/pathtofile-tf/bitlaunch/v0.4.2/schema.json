{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "token": {
          "type": "string",
          "description": "API Token",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "bitlaunch_server": {
      "version": 0,
      "block": {
        "attributes": {
          "created": {
            "type": "string",
            "description": "The creation date of the server.",
            "description_kind": "markdown",
            "computed": true
          },
          "host": {
            "type": "string",
            "description": "The host for the server to reside on.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "image_description": {
            "type": "string",
            "description": "The description of the image installed on the server.",
            "description_kind": "markdown",
            "computed": true
          },
          "image_id": {
            "type": "string",
            "description": "The image ID to use on the server.",
            "description_kind": "markdown",
            "required": true
          },
          "initscript": {
            "type": "string",
            "description": "A script to run on first boot of the server. Only hosts with initScript enabled can use this feature.",
            "description_kind": "markdown",
            "optional": true
          },
          "ipv4": {
            "type": "string",
            "description": "The name of the key.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the server.",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "The root user password to set on the server. Must be used if no SSH keys designated.",
            "description_kind": "markdown",
            "optional": true
          },
          "rate": {
            "type": "number",
            "description": "The hourly rate of the server that will be deducted from your account balance every hour.",
            "description_kind": "markdown",
            "computed": true
          },
          "region_id": {
            "type": "string",
            "description": "The region ID of the location that the server will reside at.",
            "description_kind": "markdown",
            "required": true
          },
          "size_id": {
            "type": "string",
            "description": "The size ID of the server to be provisioned to.",
            "description_kind": "markdown",
            "required": true
          },
          "ssh_keys": {
            "type": [
              "list",
              "string"
            ],
            "description": "An array of SSH key IDs to place on the server for authentication. Must be used if no password is designated of if the selected image does not support passwords.",
            "description_kind": "markdown",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "The name of the key.",
            "description_kind": "markdown",
            "computed": true
          },
          "wait_for_ip": {
            "type": "bool",
            "description": "Wait to get IP Address",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Virtual Machine Resource. Matches https://developers.bitlaunch.io/reference/server-object",
        "description_kind": "markdown"
      }
    },
    "bitlaunch_sshkey": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "The public portion of the SSH key.",
            "description_kind": "markdown",
            "required": true
          },
          "created": {
            "type": "string",
            "description": "The creation date of the key.",
            "description_kind": "markdown",
            "computed": true
          },
          "fingerprint": {
            "type": "string",
            "description": "The name of the key.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the key.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "SSH Key resouce. Matches https://developers.bitlaunch.io/reference/ssh-key-object-1",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "bitlaunch_image": {
      "version": 0,
      "block": {
        "attributes": {
          "distro_name": {
            "type": "string",
            "description": "The name of the Linux Distibution or one-click app.",
            "description_kind": "markdown",
            "optional": true
          },
          "extra_cost_per_month": {
            "type": "number",
            "description": "Extra monthly cost.",
            "description_kind": "markdown",
            "computed": true
          },
          "host": {
            "type": "string",
            "description": "Host Provider (DigitalOcean, Vultr, etc.)",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "is_windows": {
            "type": "bool",
            "description": "Flag to determine if the image is Windows-based.",
            "description_kind": "markdown",
            "computed": true
          },
          "min_disk_size": {
            "type": "number",
            "description": "The minimum disk size available in GB.",
            "description_kind": "markdown",
            "computed": true
          },
          "password_unsupported": {
            "type": "bool",
            "description": "If setting a password is supported.",
            "description_kind": "markdown",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The type of the image: image or app.",
            "description_kind": "markdown",
            "computed": true
          },
          "unavailable_regions": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of unavailable subregion IDs.",
            "description_kind": "markdown",
            "computed": true
          },
          "version_name": {
            "type": "string",
            "description": "The Specific Image Version",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Holds details on Images and apps available when configuring a server. Matches https://developers.bitlaunch.io/reference/host-image-object",
        "description_kind": "markdown"
      }
    },
    "bitlaunch_region": {
      "version": 0,
      "block": {
        "attributes": {
          "host": {
            "type": "string",
            "description": "Host Provider (DigitalOcean, Vultr, etc.)",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "iso": {
            "type": "string",
            "description": "The ISO code for the region.",
            "description_kind": "markdown",
            "computed": true
          },
          "region_name": {
            "type": "string",
            "description": "The name of the Region.",
            "description_kind": "markdown",
            "optional": true
          },
          "slug": {
            "type": "string",
            "description": "The Specific Subregion slug.",
            "description_kind": "markdown",
            "optional": true
          },
          "unavailable_sizes": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of the unavailable sizes for this subregion.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Holds available region configurations for a server. Matches https://developers.bitlaunch.io/reference/host-region-object",
        "description_kind": "markdown"
      }
    },
    "bitlaunch_size": {
      "version": 0,
      "block": {
        "attributes": {
          "bandwidth_gb": {
            "type": "number",
            "description": "The available monthly bandwidth in GB.",
            "description_kind": "markdown",
            "computed": true
          },
          "cost_per_hour": {
            "type": "number",
            "description": "The amount of balance deducted per hour.",
            "description_kind": "markdown",
            "computed": true
          },
          "cost_per_month": {
            "type": "number",
            "description": "The amount in USD charged per month.",
            "description_kind": "markdown",
            "computed": true
          },
          "cpu_count": {
            "type": "number",
            "description": "The amount of vCPU's included.",
            "description_kind": "markdown",
            "optional": true
          },
          "disk_gb": {
            "type": "number",
            "description": "The amount of disk space included.",
            "description_kind": "markdown",
            "optional": true
          },
          "disks": {
            "type": [
              "list",
              [
                "object",
                {
                  "count": "number",
                  "size": "string",
                  "type": "string",
                  "unit": "string"
                }
              ]
            ],
            "description": "Details on disks included with the size.",
            "description_kind": "markdown",
            "computed": true
          },
          "host": {
            "type": "string",
            "description": "Host Provider (DigitalOcean, Vultr, etc.)",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "memory_mb": {
            "type": "number",
            "description": "The amount of memory (RAM) included.",
            "description_kind": "markdown",
            "optional": true
          },
          "plan_type": {
            "type": "string",
            "description": "Some hosts offer a different plan type for different usage. You should refer to the host documentation for more information.",
            "description_kind": "markdown",
            "computed": true
          },
          "slug": {
            "type": "string",
            "description": "A human readable string.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Holds details on available size configurations for a server. Matches https://developers.bitlaunch.io/reference/host-size-object",
        "description_kind": "markdown"
      }
    }
  }
}
