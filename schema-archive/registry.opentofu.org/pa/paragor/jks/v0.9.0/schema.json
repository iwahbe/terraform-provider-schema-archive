{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "jks_key_store": {
      "version": 0,
      "block": {
        "attributes": {
          "ca": {
            "type": "string",
            "description": "Certificates key to include in generated key store; in PEM format.",
            "description_kind": "plain",
            "optional": true
          },
          "certificate_chain": {
            "type": [
              "list",
              "string"
            ],
            "description": "Certificates key to include in generated key store; in PEM format.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "jks": {
            "type": "string",
            "description": "JKS key store data; base64 encoded.",
            "description_kind": "plain",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "Password to secure key store. Defaults to empty string.",
            "description_kind": "plain",
            "required": true
          },
          "private_key": {
            "type": "string",
            "description": "Private key to include in generated key store; in PEM format.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "JKS trust store generated from private key and certificate.",
        "description_kind": "plain"
      }
    },
    "jks_trust_store": {
      "version": 0,
      "block": {
        "attributes": {
          "certificates": {
            "type": [
              "list",
              "string"
            ],
            "description": "CA certificates or chains to include in generated trust store; in PEM format.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "jks": {
            "type": "string",
            "description": "JKS trust store data; base64 encoded.",
            "description_kind": "plain",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "Password to secure trust store. Defaults to empty string.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "JKS trust store generated from one or more PEM encoded certificates.",
        "description_kind": "plain"
      }
    }
  }
}
