{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "owner": {
          "type": "string",
          "description": "The GitHub owner name to manage. Use this field instead of `organization` when managing individual accounts.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The OAuth token used to connect to GitHub. Anonymous mode is enabled if both `token` and `app_auth` are not set.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Performs readonly operations on GitHub repositories",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "githubrepos_all": {
      "version": 0,
      "block": {
        "attributes": {
          "repos": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "number",
                  "description": "GitHub ID for the repository",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "map"
            },
            "description": "Map of repository names and their attributes",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Gets repository attributes from GitHub",
        "description_kind": "plain"
      }
    }
  }
}
