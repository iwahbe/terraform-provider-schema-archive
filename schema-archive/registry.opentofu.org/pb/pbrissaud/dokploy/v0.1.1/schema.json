{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Dokploy API key. Falls back to DOKPLOY_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "host": {
          "type": "string",
          "description": "Dokploy server URL (e.g. https://dokploy.example.com). Falls back to DOKPLOY_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "organization_id": {
          "type": "string",
          "description": "Organization ID for org-scoped resources (e.g. SSH keys). Falls back to DOKPLOY_ORGANIZATION_ID environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with the Dokploy API to manage projects, applications, domains, and SSH keys.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dokploy_application": {
      "version": 0,
      "block": {
        "attributes": {
          "app_name": {
            "type": "string",
            "description": "Internal application identifier (1-63 chars, alphanumeric/.-_). Immutable after creation. Auto-generated by Dokploy if not set.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "auto_deploy": {
            "type": "bool",
            "description": "Automatically deploy on source changes.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "build_type": {
            "type": "string",
            "description": "Build type. One of: dockerfile, heroku_buildpacks, paketo_buildpacks, nixpacks, static, railpack.",
            "description_kind": "plain",
            "required": true
          },
          "custom_git_branch": {
            "type": "string",
            "description": "Git branch to deploy.",
            "description_kind": "plain",
            "optional": true
          },
          "custom_git_build_path": {
            "type": "string",
            "description": "Build path within the git repository.",
            "description_kind": "plain",
            "optional": true
          },
          "custom_git_ssh_key_id": {
            "type": "string",
            "description": "SSH key ID for private git repositories.",
            "description_kind": "plain",
            "optional": true
          },
          "custom_git_url": {
            "type": "string",
            "description": "Git repository URL. Required when source_type is 'git'.",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Optional description.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "env": {
            "type": "string",
            "description": "Environment variables in dotenv format (KEY=VALUE). Line order is ignored when detecting drift.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "environment_id": {
            "type": "string",
            "description": "ID of the environment this application belongs to.",
            "description_kind": "plain",
            "required": true
          },
          "github_branch": {
            "type": "string",
            "description": "GitHub branch to deploy.",
            "description_kind": "plain",
            "optional": true
          },
          "github_build_path": {
            "type": "string",
            "description": "Build path within the GitHub repository (default: /).",
            "description_kind": "plain",
            "optional": true
          },
          "github_id": {
            "type": "string",
            "description": "GitHub provider ID. Required when source_type is 'github'.",
            "description_kind": "plain",
            "optional": true
          },
          "github_owner": {
            "type": "string",
            "description": "GitHub repository owner. Required when source_type is 'github'.",
            "description_kind": "plain",
            "optional": true
          },
          "github_repository": {
            "type": "string",
            "description": "GitHub repository name. Required when source_type is 'github'.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the application.",
            "description_kind": "plain",
            "required": true
          },
          "server_id": {
            "type": "string",
            "description": "Optional server ID to deploy on. Immutable after creation.",
            "description_kind": "plain",
            "optional": true
          },
          "source_type": {
            "type": "string",
            "description": "Source type. One of: github, git, docker, gitlab, bitbucket, gitea, drop.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Dokploy application.",
        "description_kind": "plain"
      }
    },
    "dokploy_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "application_id": {
            "type": "string",
            "description": "The application ID this domain belongs to. Immutable after creation.",
            "description_kind": "plain",
            "required": true
          },
          "certificate_type": {
            "type": "string",
            "description": "Certificate type: letsencrypt, none, or custom.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "host": {
            "type": "string",
            "description": "The hostname (e.g. app.example.com).",
            "description_kind": "plain",
            "required": true
          },
          "https": {
            "type": "bool",
            "description": "Enable HTTPS for this domain.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The domain ID.",
            "description_kind": "plain",
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "URL path prefix.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "port": {
            "type": "number",
            "description": "Application port to forward traffic to.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a Dokploy domain attached to an application.",
        "description_kind": "plain"
      }
    },
    "dokploy_project": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Optional project description.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "env": {
            "type": "string",
            "description": "Project-level environment variables in dotenv format (KEY=VALUE). Line order is ignored when detecting drift.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The project ID.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The project name.",
            "description_kind": "plain",
            "required": true
          },
          "organization_id": {
            "type": "string",
            "description": "The organization ID this project belongs to.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a Dokploy project.",
        "description_kind": "plain"
      }
    },
    "dokploy_ssh_key": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Optional description.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The SSH key ID.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the SSH key.",
            "description_kind": "plain",
            "required": true
          },
          "organization_id": {
            "type": "string",
            "description": "The organization this key belongs to (resolved from provider configuration).",
            "description_kind": "plain",
            "computed": true
          },
          "private_key": {
            "type": "string",
            "description": "PEM-encoded private key. Changing this forces a new resource.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "public_key": {
            "type": "string",
            "description": "OpenSSH-encoded public key. Changing this forces a new resource.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Dokploy SSH key. Requires organization_id to be set on the provider.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "dokploy_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The environment ID.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The environment name to look up.",
            "description_kind": "plain",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "The project ID to search within.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Look up a Dokploy environment by project ID and name.",
        "description_kind": "plain"
      }
    },
    "dokploy_github_providers": {
      "version": 0,
      "block": {
        "attributes": {
          "providers": {
            "nested_type": {
              "attributes": {
                "created_at": {
                  "type": "string",
                  "description": "Creation timestamp.",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "GitHub provider ID.",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "GitHub App name.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of installed GitHub providers.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Lists all GitHub App providers installed in Dokploy.",
        "description_kind": "plain"
      }
    }
  }
}
