{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "The endpoint of the Bitrise API",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The API token for authenticating with the Bitrise API",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "bitrise_app": {
      "version": 0,
      "block": {
        "attributes": {
          "app_slug": {
            "type": "string",
            "description": "App Slug",
            "description_kind": "markdown",
            "computed": true
          },
          "configurable_attribute": {
            "type": "string",
            "description": "App configurable attribute",
            "description_kind": "markdown",
            "optional": true
          },
          "git_owner": {
            "type": "string",
            "description": "Git Owner",
            "description_kind": "markdown",
            "optional": true
          },
          "git_repo_slug": {
            "type": "string",
            "description": "Git Repo Slug",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "App identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "is_public": {
            "type": "bool",
            "description": "Is Public",
            "description_kind": "markdown",
            "optional": true
          },
          "organization_slug": {
            "type": "string",
            "description": "Organization Slug",
            "description_kind": "markdown",
            "optional": true
          },
          "repo": {
            "type": "string",
            "description": "Repo",
            "description_kind": "markdown",
            "optional": true
          },
          "repo_url": {
            "type": "string",
            "description": "Repo URL",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Type",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "App resource",
        "description_kind": "markdown"
      }
    },
    "bitrise_app_bitrise_yml": {
      "version": 0,
      "block": {
        "attributes": {
          "app_slug": {
            "type": "string",
            "description": "The slug of the Bitrise app",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the resource (app_slug)",
            "description_kind": "markdown",
            "computed": true
          },
          "update_on_create_only": {
            "type": "bool",
            "description": "If set to true, the bitrise.yml will only be applied during resource creation. Subsequent updates will be ignored. Default is false.",
            "description_kind": "markdown",
            "optional": true
          },
          "yml_content": {
            "type": "string",
            "description": "The content of the bitrise.yml file. This should be a valid YAML configuration for Bitrise workflows.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages the bitrise.yml configuration file for a Bitrise application. This resource allows you to create and update the workflow configuration.",
        "description_kind": "markdown"
      }
    },
    "bitrise_app_finish": {
      "version": 0,
      "block": {
        "attributes": {
          "app_slug": {
            "type": "string",
            "description": "App Slug",
            "description_kind": "markdown",
            "required": true
          },
          "config": {
            "type": "string",
            "description": "The configuration for the app",
            "description_kind": "markdown",
            "required": true
          },
          "envs": {
            "type": [
              "map",
              "string"
            ],
            "description": "Envs",
            "description_kind": "plain",
            "optional": true
          },
          "mode": {
            "type": "string",
            "description": "The mode of the app (e.g., manual)",
            "description_kind": "markdown",
            "required": true
          },
          "organization_slug": {
            "type": "string",
            "description": "The slug of the organization that owns the app",
            "description_kind": "markdown",
            "required": true
          },
          "project_type": {
            "type": "string",
            "description": "The type of the project",
            "description_kind": "markdown",
            "required": true
          },
          "stack_id": {
            "type": "string",
            "description": "The ID of the stack on which the build will run",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Bitrise App Finish resource",
        "description_kind": "markdown"
      }
    },
    "bitrise_app_roles": {
      "version": 0,
      "block": {
        "attributes": {
          "app_slug": {
            "type": "string",
            "description": "The slug of the Bitrise app",
            "description_kind": "markdown",
            "required": true
          },
          "groups": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of group slugs to assign to this role. This replaces all existing groups.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Resource identifier (app_slug/role_name)",
            "description_kind": "markdown",
            "computed": true
          },
          "role_name": {
            "type": "string",
            "description": "The role type to manage. Supported values: admin, manager (developer), member (tester/qa), platform_engineer",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages the groups assigned to a specific role type for a Bitrise application. This resource replaces all groups for the specified role with the provided list.",
        "description_kind": "markdown"
      }
    },
    "bitrise_app_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "app_slug": {
            "type": "string",
            "description": "The slug of the Bitrise app",
            "description_kind": "markdown",
            "required": true
          },
          "expand_in_step_inputs": {
            "type": "bool",
            "description": "If true, variable expansion will be enabled for this secret in step inputs. Default: true",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the secret",
            "description_kind": "markdown",
            "computed": true
          },
          "is_exposed_for_pull_requests": {
            "type": "bool",
            "description": "If true, the secret will be available for pull request builds. Default: false",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_protected": {
            "type": "bool",
            "description": "If true, the secret value cannot be retrieved via the API. Default: false",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name (key) of the secret",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "The value of the secret",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Manages secrets for a Bitrise application. Secrets are environment variables that are securely stored and can be used in your build workflows.",
        "description_kind": "markdown"
      }
    },
    "bitrise_app_ssh": {
      "version": 0,
      "block": {
        "attributes": {
          "app_slug": {
            "type": "string",
            "description": "App Slug",
            "description_kind": "markdown",
            "required": true
          },
          "auth_ssh_private_key": {
            "type": "string",
            "description": "Private SSH key for authentication",
            "description_kind": "markdown",
            "required": true
          },
          "auth_ssh_public_key": {
            "type": "string",
            "description": "Public SSH key for authentication",
            "description_kind": "markdown",
            "required": true
          },
          "is_register_key_into_provider_service": {
            "type": "bool",
            "description": "Whether to register the public key into the provider service",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Bitrise App SSH resource",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "bitrise_app_roles": {
      "version": 0,
      "block": {
        "attributes": {
          "app_slug": {
            "type": "string",
            "description": "The slug of the Bitrise app",
            "description_kind": "markdown",
            "required": true
          },
          "groups": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of group slugs assigned to this role",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Data source identifier (app_slug/role_name)",
            "description_kind": "markdown",
            "computed": true
          },
          "role_name": {
            "type": "string",
            "description": "The role type to query. Supported values: admin, manager (developer), member (tester/qa), platform_engineer",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Retrieves the list of groups assigned to a specific role type for a Bitrise application.",
        "description_kind": "markdown"
      }
    },
    "bitrise_available_stacks": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Data source identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "stack_keys": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of all available stack IDs",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieves the list of all available stacks from Bitrise.",
        "description_kind": "markdown"
      }
    },
    "bitrise_org_groups": {
      "version": 0,
      "block": {
        "attributes": {
          "groups": {
            "type": [
              "list",
              [
                "object",
                {
                  "name": "string",
                  "slug": "string"
                }
              ]
            ],
            "description": "List of groups in the organization",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Data source identifier (org_slug)",
            "description_kind": "markdown",
            "computed": true
          },
          "org_slug": {
            "type": "string",
            "description": "The slug of the Bitrise organization",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Retrieves the list of groups for a Bitrise organization.",
        "description_kind": "markdown"
      }
    }
  }
}
