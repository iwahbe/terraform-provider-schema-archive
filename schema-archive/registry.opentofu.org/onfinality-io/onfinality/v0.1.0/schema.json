{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key": {
          "type": "string",
          "description": "access key for https://app.onfinality.io, use env TF_VAR_onf_access_key to set up",
          "description_kind": "markdown",
          "required": true
        },
        "secret_key": {
          "type": "string",
          "description": "secret key for https://app.onfinality.io, use env TF_VAR_onf_secret_key to set up",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "onfinality_node": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_hash": {
            "type": "string",
            "description": "Cluster where the node will be deployed, check `onf info cluster` for all available clusters",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "Node Id",
            "description_kind": "markdown",
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "The full image (with version)",
            "description_kind": "markdown",
            "computed": true
          },
          "image_version": {
            "type": "string",
            "description": "Image Version to use",
            "description_kind": "markdown",
            "required": true
          },
          "network_spec_key": {
            "type": "string",
            "description": "Network of the node, can get from `onf network-spec list` & `onf network-spec list-backups`",
            "description_kind": "markdown",
            "required": true
          },
          "node_name": {
            "type": "string",
            "description": "Name of the node",
            "description_kind": "markdown",
            "required": true
          },
          "node_spec": {
            "nested_type": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "multiplier": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Node Spec of the node, always put key=\"unit\", 1 * unit ~ 0.5 cpu 1.5G mem",
            "description_kind": "markdown",
            "required": true
          },
          "node_type": {
            "type": "string",
            "description": "full or archive or validator, depends on network",
            "description_kind": "markdown",
            "required": true
          },
          "stopped": {
            "type": "bool",
            "description": "Change it to true will stop the node",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "storage": {
            "type": "string",
            "description": "Disk size of the node, <num>Gi , e.g 100Gi",
            "description_kind": "markdown",
            "required": true
          },
          "workspace_id": {
            "type": "number",
            "description": "Workspace id, can get it from url https://app.onfinality.io/workspaces/<workspace_id>/nodes",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Example resource",
        "description_kind": "markdown"
      }
    }
  }
}
