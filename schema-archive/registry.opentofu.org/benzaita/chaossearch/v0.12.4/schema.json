{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key_id": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "region": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "secret_access_key": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "chaossearch_indexing_state": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Whether the live indexing should be running or not",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "object_group_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "chaossearch_object_group": {
      "version": 0,
      "block": {
        "attributes": {
          "array_flatten_depth": {
            "type": "number",
            "description": "Array flattening level. 0 - disabled, -1 - unlimited, >1 - the respective flattening level",
            "description_kind": "plain",
            "optional": true
          },
          "column_renames": {
            "type": [
              "map",
              "string"
            ],
            "description": "A map specifying names of columns to rename (keys) and what to rename them to (values)",
            "description_kind": "plain",
            "optional": true
          },
          "column_types": {
            "type": [
              "map",
              "string"
            ],
            "description": "An optional map specifying column types defined statically. Supported values are: TIMEVAL.",
            "description_kind": "plain",
            "optional": true
          },
          "compression": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "filter_json": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "format": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "horizontal": {
            "type": "bool",
            "description": "Specifies whether flatten JSON arrays horizontally (into columns) or vertically (into rows)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "index_retention": {
            "type": "number",
            "description": "Number of days to keep the data before deleting it",
            "description_kind": "plain",
            "optional": true
          },
          "keep_original": {
            "type": "bool",
            "description": "Works in connection with the `column_selection`, dictates whether to keep the fields filtered out by the column_selection in a separate field",
            "description_kind": "plain",
            "optional": true
          },
          "live_events_sqs_arn": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "partition_by": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "pattern": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "source_bucket": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "column_selection": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "include": {
                  "type": "bool",
                  "description": "Only for type=regex, whether to use patterns to include (true) or exclude (false) fields.",
                  "description_kind": "plain",
                  "optional": true
                },
                "includes": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "For types 'whitelist' and 'blacklist' - the list of fields to include or exclude.",
                  "description_kind": "plain",
                  "optional": true
                },
                "patterns": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "For type 'regex' - list of regexes to filter fields.",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "Column selection type: whitelist, blacklist, regex.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "List of fields in logs to include or exclude from parsing. If nothing is specified, all fields will be parsed",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "chaossearch_object_groups": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "object_groups": {
            "type": [
              "list",
              [
                "object",
                {
                  "id": "string",
                  "name": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
