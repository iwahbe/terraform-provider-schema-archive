{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API access key. Default is read from the environment variable `NEON_API_KEY`.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "neon_api_key": {
      "version": 1,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The API key ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The generated 64-bit token required to access the Neon API.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "The name of the API Key.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "A key to access the Neon API.\n\n~>**WARNING** The resource does not support import.\n",
        "description_kind": "markdown"
      }
    },
    "neon_branch": {
      "version": 8,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Branch ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "logical_size": {
            "type": "number",
            "description": "Branch logical size in MB.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Branch name.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "parent_id": {
            "type": "string",
            "description": "ID of the branch to check out.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "parent_lsn": {
            "type": "string",
            "description": "Log Sequence Number (LSN) horizon for the data to be present in the new branch.\nSee details: https://neon.tech/docs/reference/glossary/#lsn",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "parent_timestamp": {
            "type": "number",
            "description": "Timestamp horizon for the data to be present in the new branch.\n**Note**: it's defined as Unix epoch.'",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Project ID.",
            "description_kind": "markdown",
            "required": true
          },
          "protected": {
            "type": "string",
            "description": "Set to 'yes' to activate, 'no' to deactivate explicitly, and omit to keep the default value.\nSet whether the branch is protected.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Project Branch. See details: https://neon.tech/docs/introduction/branching/",
        "description_kind": "markdown"
      }
    },
    "neon_database": {
      "version": 7,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch ID.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Database name.",
            "description_kind": "markdown",
            "required": true
          },
          "owner_name": {
            "type": "string",
            "description": "Role name of the database owner.",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "Project ID.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Project Database. See details: https://neon.tech/docs/manage/databases/",
        "description_kind": "markdown"
      }
    },
    "neon_endpoint": {
      "version": 8,
      "block": {
        "attributes": {
          "autoscaling_limit_max_cu": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "autoscaling_limit_min_cu": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "branch_id": {
            "type": "string",
            "description": "Branch ID.",
            "description_kind": "markdown",
            "required": true
          },
          "compute_provisioner": {
            "type": "string",
            "description": "Provisioner The Neon compute provisioner.\nSpecify the k8s-neonvm provisioner to create a compute endpoint that supports Autoscaling.\n",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "disabled": {
            "type": "bool",
            "description": "Disable the endpoint.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "host": {
            "type": "string",
            "description": "Endpoint URI.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Endpoint ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "pg_settings": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "pooler_enabled": {
            "type": "bool",
            "description": "Activate connection pooling.\nSee details: https://neon.tech/docs/connect/connection-pooling",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "pooler_mode": {
            "type": "string",
            "description": "Mode of connections pooling.\nSee details: https://neon.tech/docs/connect/connection-pooling",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Project ID.",
            "description_kind": "markdown",
            "required": true
          },
          "proxy_host": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "region_id": {
            "type": "string",
            "description": "Deployment region: https://neon.tech/docs/introduction/regions",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "suspend_timeout_seconds": {
            "type": "number",
            "description": "Duration of inactivity in seconds after which the compute endpoint is automatically suspended.\nThe value 0 means use the global default.\nThe value -1 means never suspend. The default value is 300 seconds (5 minutes).\nThe maximum value is 604800 seconds (1 week)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Access type. **Note** that a single branch can have only one \"read_write\" endpoint.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Project Endpoint. See details: https://neon.tech/docs/manage/endpoints/",
        "description_kind": "markdown"
      }
    },
    "neon_jwks_url": {
      "version": 0,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch ID.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "jwks_url": {
            "type": "string",
            "description": "The URL that lists the JWKS.",
            "description_kind": "markdown",
            "required": true
          },
          "jwt_audience": {
            "type": "string",
            "description": "The name of the required JWT Audience to be used.",
            "description_kind": "markdown",
            "optional": true
          },
          "project_id": {
            "type": "string",
            "description": "Project ID.",
            "description_kind": "markdown",
            "required": true
          },
          "provider_name": {
            "type": "string",
            "description": "The name of the authentication provider.",
            "description_kind": "markdown",
            "required": true
          },
          "role_names": {
            "type": [
              "list",
              "string"
            ],
            "description": "The roles the JWKS should be mapped to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Project JWKS URL. See details: https://neon.tech/docs/guides/neon-rls-authorize\n\n~>**WARNING** The resource does not support import.\n",
        "description_kind": "markdown"
      }
    },
    "neon_org_api_key": {
      "version": 1,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The API key ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The generated 64-bit token required to access the Neon API.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "name": {
            "type": "string",
            "description": "The name of the API Key.",
            "description_kind": "markdown",
            "required": true
          },
          "org_id": {
            "type": "string",
            "description": "The organisation ID.",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "The project ID to which this key will grant the access to.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "An org-specific key to access the Neon API.\n\n~>**WARNING** The resource does not support import.\n",
        "description_kind": "markdown"
      }
    },
    "neon_project": {
      "version": 11,
      "block": {
        "attributes": {
          "allowed_ips": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of IP addresses that are allowed to connect to the endpoints.\nNote that the feature is available to the Neon Scale plans only. Details: https://neon.tech/docs/manage/projects#configure-ip-allow",
            "description_kind": "markdown",
            "optional": true
          },
          "allowed_ips_protected_branches_only": {
            "type": "string",
            "description": "Set to 'yes' to activate, 'no' to deactivate explicitly, and omit to keep the default value.\nApply the allow-list to the protected branches only.\nNote that the feature is available to the Neon Scale plans only.",
            "description_kind": "markdown",
            "optional": true
          },
          "block_public_connections": {
            "type": "string",
            "description": "Set to 'yes' to activate, 'no' to deactivate explicitly, and omit to keep the default value.\nBlock connections from public internet. This supersedes the AllowedIPs list.",
            "description_kind": "markdown",
            "optional": true
          },
          "block_vpc_connections": {
            "type": "string",
            "description": "Set to 'yes' to activate, 'no' to deactivate explicitly, and omit to keep the default value.\nBlock connections that use VPC endpoints.",
            "description_kind": "markdown",
            "optional": true
          },
          "compute_provisioner": {
            "type": "string",
            "description": "Provisioner The Neon compute provisioner.\nSpecify the k8s-neonvm provisioner to create a compute endpoint that supports Autoscaling.\n",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "connection_uri": {
            "type": "string",
            "description": "Default connection uri. **Note** that it contains access credentials.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "connection_uri_pooler": {
            "type": "string",
            "description": "Default connection uri with the traffic via pooler. **Note** that it contains access credentials.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "database_host": {
            "type": "string",
            "description": "Default database host.",
            "description_kind": "markdown",
            "computed": true
          },
          "database_host_pooler": {
            "type": "string",
            "description": "Default endpoint host via pooler.",
            "description_kind": "markdown",
            "computed": true
          },
          "database_name": {
            "type": "string",
            "description": "Default database name.",
            "description_kind": "markdown",
            "computed": true
          },
          "database_password": {
            "type": "string",
            "description": "Default database access password.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "database_user": {
            "type": "string",
            "description": "Default database role.",
            "description_kind": "markdown",
            "computed": true
          },
          "default_branch_id": {
            "type": "string",
            "description": "Default branch ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "default_endpoint_id": {
            "type": "string",
            "description": "Default endpoint ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "enable_logical_replication": {
            "type": "string",
            "description": "Set to 'yes' to activate, 'no' to deactivate explicitly, and omit to keep the default value.\nSets wal_level=logical for all compute endpoints in this project.\nAll active endpoints will be suspended. Once enabled, logical replication cannot be disabled.\nSee details: https://neon.tech/docs/introduction/logical-replication\n",
            "description_kind": "markdown",
            "optional": true
          },
          "history_retention_seconds": {
            "type": "number",
            "description": "The number of seconds to retain the point-in-time restore (PITR) backup history for this project.\nDefault: 1 day, see https://neon.tech/docs/reference/glossary#point-in-time-restore.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Project ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Project name.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "org_id": {
            "type": "string",
            "description": "Identifier of the organisation to which this project belongs.",
            "description_kind": "markdown",
            "optional": true
          },
          "pg_version": {
            "type": "number",
            "description": "Postgres version",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "region_id": {
            "type": "string",
            "description": "Deployment region: https://neon.tech/docs/introduction/regions",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "store_password": {
            "type": "string",
            "description": "Set to 'yes' to activate, 'no' to deactivate explicitly, and omit to keep the default value.\nWhether or not passwords are stored for roles in the Neon project.\nStoring passwords facilitates access to Neon features that require authorization.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "branch": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "database_name": {
                  "type": "string",
                  "description": "The name of the default database provisioned upon creation of new project. It's owned by the default role (`role_name`).\nIf not specified, the default database name will be used.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Branch ID.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the default branch provisioned upon creation of new project.\nIf not specified, the default branch name will be used.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "role_name": {
                  "type": "string",
                  "description": "The name of the default role provisioned upon creation of new project.\nIf not specified, the default role name will be used.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "default_endpoint_settings": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "autoscaling_limit_max_cu": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "autoscaling_limit_min_cu": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Endpoint ID.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "suspend_timeout_seconds": {
                  "type": "number",
                  "description": "Duration of inactivity in seconds after which the compute endpoint is automatically suspended.\nThe value 0 means use the global default.\nThe value -1 means never suspend. The default value is 300 seconds (5 minutes).\nThe maximum value is 604800 seconds (1 week)",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "maintenance_window": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "end_time": {
                  "type": "string",
                  "description": "End time of the maintenance window, in the format of \"HH:MM\". Uses UTC.",
                  "description_kind": "markdown",
                  "required": true
                },
                "start_time": {
                  "type": "string",
                  "description": "Start time of the maintenance window, in the format of \"HH:MM\". Uses UTC.",
                  "description_kind": "markdown",
                  "required": true
                },
                "weekdays": {
                  "type": [
                    "list",
                    "number"
                  ],
                  "description": "A list of weekdays when the maintenance window is active. Encoded as ints, where 1 - Monday, and 7 - Sunday.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "A time period during which Neon may perform maintenance on the project's infrastructure. During this time, the project's compute endpoints may be unavailable and existing connections can be interrupted.",
              "description_kind": "markdown"
            },
            "max_items": 1
          },
          "quota": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "active_time_seconds": {
                  "type": "number",
                  "description": "The total amount of wall-clock time allowed to be spent by the project's compute endpoints.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "compute_time_seconds": {
                  "type": "number",
                  "description": "The total amount of CPU seconds allowed to be spent by the project's compute endpoints.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "data_transfer_bytes": {
                  "type": "number",
                  "description": "Total amount of data transferred from all of a project's branches using the proxy.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "logical_size_bytes": {
                  "type": "number",
                  "description": "Limit on the logical size of every project's branch.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "written_data_bytes": {
                  "type": "number",
                  "description": "Total amount of data written to all of a project's branches.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "description": "Per-project consumption quota. If the quota is exceeded, all active computes\nare automatically suspended and it will not be possible to start them with\nan API method call or incoming proxy connections. The only exception is\nlogical_size_bytes, which is applied on per-branch basis, i.e., only the\ncompute on the branch that exceeds the logical_size quota will be suspended.\n\nQuotas are enforced based on per-project consumption metrics with the same names,\nwhich are reset at the end of each billing period (the first day of the month).\nLogical size is also an exception in this case, as it represents the total size\nof data stored in a branch, so it is not reset.\n\nThe zero value per attributed means 'unlimited'.",
              "description_kind": "markdown"
            },
            "max_items": 1
          }
        },
        "description": "Neon Project.\n\nSee details: https://neon.tech/docs/get-started-with-neon/setting-up-a-project/\nAPI: https://api-docs.neon.tech/reference/createproject",
        "description_kind": "markdown"
      }
    },
    "neon_project_permission": {
      "version": 1,
      "block": {
        "attributes": {
          "grantee": {
            "type": "string",
            "description": "Email of the user whom to grant project permission.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Project ID.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Project's access permission.",
        "description_kind": "markdown"
      }
    },
    "neon_role": {
      "version": 7,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch ID.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Role name.",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Database authentication password.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "project_id": {
            "type": "string",
            "description": "Project ID.",
            "description_kind": "markdown",
            "required": true
          },
          "protected": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Project Role. **Note** that User and Role are synonymous terms in Neon. \nSee details: https://neon.tech/docs/manage/users/\n",
        "description_kind": "markdown"
      }
    },
    "neon_vpc_endpoint_assignment": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "A descriptive label for the VPC endpoint.",
            "description_kind": "markdown",
            "required": true
          },
          "org_id": {
            "type": "string",
            "description": "The Neon organization ID.",
            "description_kind": "markdown",
            "required": true
          },
          "region_id": {
            "type": "string",
            "description": "The Neon region ID.",
            "description_kind": "markdown",
            "required": true
          },
          "vpc_endpoint_id": {
            "type": "string",
            "description": "The VPC endpoint ID.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Assigns, or updates existing assignment of a VPC endpoint to a Neon organization.\nSee details: https://neon.tech/docs/guides/neon-private-networking#enable-private-dns\n",
        "description_kind": "markdown"
      }
    },
    "neon_vpc_endpoint_restriction": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "A descriptive label for the VPC endpoint.",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "The Neon project ID.",
            "description_kind": "markdown",
            "required": true
          },
          "vpc_endpoint_id": {
            "type": "string",
            "description": "The VPC endpoint ID.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Sets or updates a VPC endpoint restriction for a Neon project.\nWhen a VPC endpoint restriction is set, the project only accepts connections\nfrom the specified VPC.\nA VPC endpoint can be set as a restriction only after it is assigned to the\nparent organization of the Neon project.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "neon_branch_endpoints": {
      "version": 1,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch ID.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
