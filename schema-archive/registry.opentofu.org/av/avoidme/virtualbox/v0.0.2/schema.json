{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "virtualbox_vm": {
      "version": 0,
      "block": {
        "attributes": {
          "cpu": {
            "type": "number",
            "description": "Virtualbox vm cpu count",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Example identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "Path or URL to virtualbox vm image",
            "description_kind": "markdown",
            "required": true
          },
          "memory": {
            "type": "number",
            "description": "Virtualbox vm memory count (MB)",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Virtualbox vm name",
            "description_kind": "markdown",
            "required": true
          },
          "ssh_key": {
            "type": "string",
            "description": "Path to public ssh key, will be inserted into authorized_keys of guest vm",
            "description_kind": "markdown",
            "optional": true
          },
          "ssh_port": {
            "type": "string",
            "description": "Forwarded local port to guest ssh(22)",
            "description_kind": "markdown",
            "computed": true
          },
          "ssh_user": {
            "type": "string",
            "description": "User for which ssh key will be injected. Root by default.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Virtualbox VM resource",
        "description_kind": "markdown"
      }
    }
  }
}
