{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "refresh_token": {
          "type": "string",
          "description": "This is the [offline token](https://access.redhat.com/articles/3626371#bgenerating-a-new-offline-tokenb-3) used to generate access tokens for Red Hat Subscription Manager. This must be provided in the config or in the environment variable `RHSM_REFRESH_TOKEN`.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "rhsm_allocation": {
      "version": 0,
      "block": {
        "attributes": {
          "created_by": {
            "type": "string",
            "description": "The user account used to create the subscription allocation.",
            "description_kind": "markdown",
            "computed": true
          },
          "created_date": {
            "type": "string",
            "description": "The date and time the subscription allocation was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "entitlements_attached": {
            "type": [
              "list",
              [
                "object",
                {
                  "reason": "string",
                  "valid": "bool"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          },
          "entitlements_attached_quantity": {
            "type": "number",
            "description": "The number of entitlements associated with the subscription",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_modified": {
            "type": "string",
            "description": "The date and time the subscription allocation was last modified.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the subscription allocation.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "The type of the subscription allocation.  The only one supported by this resource is `Satellite`.",
            "description_kind": "markdown",
            "computed": true
          },
          "uuid": {
            "type": "string",
            "description": "The UUID of the subscription allocation that was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "version": {
            "type": "string",
            "description": "The version of the subscription allocation type.  This defaults in the API to 6.5 and cannot be set through the API. It can be adjusted in the RHSM portal.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Resource to manage a RHSM Subscription allocation for a Red Hat Satellite server.",
        "description_kind": "markdown",
        "deprecated": true
      }
    },
    "rhsm_allocation_entitlement": {
      "version": 0,
      "block": {
        "attributes": {
          "allocation_uuid": {
            "type": "string",
            "description": "The UUID of the subscription allocation to create the entitlement on.",
            "description_kind": "markdown",
            "required": true
          },
          "contract_number": {
            "type": "string",
            "description": "The support contract associated with the entitlement.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "pool": {
            "type": "string",
            "description": "The ID of the pool you would like to create the entitlement from.",
            "description_kind": "markdown",
            "required": true
          },
          "quantity": {
            "type": "number",
            "description": "The number of entitlements you would like add to the allocation/use from the pool.",
            "description_kind": "markdown",
            "required": true
          },
          "sku": {
            "type": "string",
            "description": "The SKU of the entitlement.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Resource to manage entitlements to a RHSM Subscription Allocation for a Red Hat Satellite server.",
        "description_kind": "markdown",
        "deprecated": true
      }
    },
    "rhsm_allocation_manifest": {
      "version": 0,
      "block": {
        "attributes": {
          "allocation_uuid": {
            "type": "string",
            "description": "The UUID of the subscription allocation to create the manifest from.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_modified": {
            "type": "string",
            "description": "The date and time the subscription allocation was last modified.",
            "description_kind": "markdown",
            "computed": true
          },
          "manifest": {
            "type": "string",
            "description": "The manifest as downloaded from the RHSM portal.  This is a zip file which has been base64 encoded to a string.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "manifest_last_modified": {
            "type": "string",
            "description": "The date and time the subscription allocation was last modified when the manifest was last generated.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Resource to create a manifest from a RHSM subscription allocation that can be uploaded to a Red Hat Satellite server.",
        "description_kind": "markdown",
        "deprecated": true
      }
    },
    "rhsm_cloud_access_account": {
      "version": 0,
      "block": {
        "attributes": {
          "account_id": {
            "type": "string",
            "description": "The ID of a cloud account that you would like to request Red Hat Cloud Access for. For GCE this should be a Google Group.",
            "description_kind": "plain",
            "required": true
          },
          "date_added": {
            "type": "string",
            "description": "The date the cloud account was added to Red Hat Cloud Access.",
            "description_kind": "plain",
            "computed": true
          },
          "gold_image_status": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "The description of the gold image.",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the gold image.",
                  "description_kind": "plain",
                  "computed": true
                },
                "status": {
                  "type": "string",
                  "description": "The status of the gold image request.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "The status of any requests for gold image access for the cloud account.",
            "description_kind": "plain",
            "computed": true
          },
          "gold_images": {
            "type": [
              "set",
              "string"
            ],
            "description": "A list of gold images to request access to for the account. Images available to a cloud provider can be found with the `rhsm_cloud_access` data source. Once you request access to a gold image, it is not possible to disable access via the API.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the cloud account in the format `provider_short_name:account_id`.",
            "description_kind": "markdown",
            "computed": true
          },
          "nickname": {
            "type": "string",
            "description": "A nickname to help describe the account.",
            "description_kind": "plain",
            "optional": true
          },
          "provider_short_name": {
            "type": "string",
            "description": "The short name of the cloud provider that the `account_id` is in. This must be one of \"AWS\", \"GCE\", or \"MSAZ\".  Other cloud providers are supported but have not been tested so they are not in the list of valid options.",
            "description_kind": "plain",
            "required": true
          },
          "source_id": {
            "type": "string",
            "description": "Source ID of linked account. Only for accounts created via Sources on cloud.redhat.com.",
            "description_kind": "plain",
            "computed": true
          },
          "verified": {
            "type": "bool",
            "description": "Is the cloud provider account verified for RHSM Auto Registration?",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Resource to manage entitlement for Red Hat Cloud Access for an account in a supported cloud provider.",
        "description_kind": "markdown"
      }
    }
  },
