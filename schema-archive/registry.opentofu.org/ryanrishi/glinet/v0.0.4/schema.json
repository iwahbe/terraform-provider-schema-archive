{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "URI for GL.iNet API. May also be provided via GLINET_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password for GL.iNet API. May also be provided via GLINET_PASSWORD environment variable.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Username for GL.iNet API. May also be provided via GLINET_USERNAME environment variable.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description": "Interact with GL.iNet.",
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "glinet_system_timezone_config": {
      "version": 0,
      "block": {
        "attributes": {
          "auto_timezone_enabled": {
            "type": "bool",
            "description": "Whether the device is enabled for automatic time zone.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "localtime": {
            "type": "number",
            "description": "The timestamp of the device (Unit: Seconds).",
            "description_kind": "plain",
            "computed": true
          },
          "timezone": {
            "type": "string",
            "description": "Time zone of the device.",
            "description_kind": "plain",
            "computed": true
          },
          "tzoffset": {
            "type": "string",
            "description": "System time-zone offset.",
            "description_kind": "plain",
            "computed": true
          },
          "zonename": {
            "type": "string",
            "description": "Time zone name of the device (It will return null when use UTC).",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Get the time zone information of the device.",
        "description_kind": "plain"
      }
    }
  }
}
