{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "audience": {
          "type": "string",
          "description": "Kinde M2M application audience, also set by KINDE_AUDIENCE",
          "description_kind": "markdown",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "Kinde M2M application client id, also set by KINDE_CLIENT_ID",
          "description_kind": "markdown",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "Kinde M2M application client secret, also set by KINDE_CLIENT_SECRET",
          "description_kind": "markdown",
          "optional": true
        },
        "domain": {
          "type": "string",
          "description": "Kinde organisation domain, also set by KINDE_DOMAIN",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "kinde_api": {
      "version": 0,
      "block": {
        "attributes": {
          "audience": {
            "type": "string",
            "description": "Audience of the API",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the API",
            "description_kind": "markdown",
            "computed": true
          },
          "is_management_api": {
            "type": "bool",
            "description": "Whether this API is a management API",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the API. Currently, there is no way to change this via the management API.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "APIs represent the resource server to authorise against. See [documentation](https://docs.kinde.com/developer-tools/your-apis/register-manage-apis/) for more details.",
        "description_kind": "markdown"
      }
    },
    "kinde_application": {
      "version": 0,
      "block": {
        "attributes": {
          "client_id": {
            "type": "string",
            "description": "Client id of the application",
            "description_kind": "markdown",
            "computed": true
          },
          "client_secret": {
            "type": "string",
            "description": "Client secret of the application",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "homepage_uri": {
            "type": "string",
            "description": "The homepage URI of the application.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the application",
            "description_kind": "markdown",
            "computed": true
          },
          "login_uri": {
            "type": "string",
            "description": "The login URI of the application.",
            "description_kind": "plain",
            "optional": true
          },
          "logout_uris": {
            "type": [
              "list",
              "string"
            ],
            "description": "The logout URIs of the application.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the application. Currently, there is no way to change this via the management application.",
            "description_kind": "markdown",
            "required": true
          },
          "redirect_uris": {
            "type": [
              "list",
              "string"
            ],
            "description": "The redirect URIs of the application.",
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Type of the application",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Applications facilitates the interface for users to authenticate against. See [documentation](https://docs.kinde.com/build/applications/about-applications/) for more details.",
        "description_kind": "markdown"
      }
    },
    "kinde_application_connection": {
      "version": 0,
      "block": {
        "attributes": {
          "application_id": {
            "type": "string",
            "description": "ID of the application",
            "description_kind": "markdown",
            "required": true
          },
          "connection_id": {
            "type": "string",
            "description": "ID of the connection to enable",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Composite ID of the application connection",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manages a connection for a Kinde application.",
        "description_kind": "markdown"
      }
    },
    "kinde_connection": {
      "version": 0,
      "block": {
        "attributes": {
          "display_name": {
            "type": "string",
            "description": "Display name of the connection",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the connection",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the connection",
            "description_kind": "markdown",
            "required": true
          },
          "options": {
            "nested_type": {
              "attributes": {
                "client_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "client_secret": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Options for the connection. Required for OAuth2 connections. Sensitive values are stored in state and rely on state encryption for security.",
            "description_kind": "markdown",
            "optional": true
          },
          "strategy": {
            "type": "string",
            "description": "Strategy of the connection",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a connection in Kinde.",
        "description_kind": "markdown"
      }
    },
    "kinde_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "background_color": {
            "type": "string",
            "description": "The background color of the organization's theme.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "button_color": {
            "type": "string",
            "description": "The button color of the organization's theme.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "button_text_color": {
            "type": "string",
            "description": "The button text color of the organization's theme.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "code": {
            "type": "string",
            "description": "The organization code.",
            "description_kind": "plain",
            "computed": true
          },
          "created_on": {
            "type": "string",
            "description": "The timestamp when the organization was created.",
            "description_kind": "plain",
            "computed": true
          },
          "external_id": {
            "type": "string",
            "description": "The external ID of the organization.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "handle": {
            "type": "string",
            "description": "The organization handle.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the organization.",
            "description_kind": "plain",
            "computed": true
          },
          "link_color": {
            "type": "string",
            "description": "The link color of the organization's theme.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the organization.",
            "description_kind": "plain",
            "required": true
          },
          "theme_code": {
            "type": "string",
            "description": "The theme code of the organization.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a Kinde organization.",
        "description_kind": "plain"
      }
    },
    "kinde_organization_user": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The composite ID of the organization user membership.",
            "description_kind": "plain",
            "computed": true
          },
          "organization_code": {
            "type": "string",
            "description": "The code of the organization.",
            "description_kind": "plain",
            "required": true
          },
          "permissions": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of permission IDs to assign to the user.",
            "description_kind": "plain",
            "optional": true
          },
          "roles": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of role IDs to assign to the user.",
            "description_kind": "plain",
            "optional": true
          },
          "user_id": {
            "type": "string",
            "description": "The ID of the user.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a user's membership and roles in a Kinde organization.",
        "description_kind": "plain"
      }
    },
    "kinde_permission": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the permission",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the permission",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Key identifier of the permission",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the permission",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Permissions represent individual access rights that can be assigned to roles. See [documentation](https://docs.kinde.com/kinde-apis/management/#tag/permissions) for more details.",
        "description_kind": "markdown"
      }
    },
    "kinde_role": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the role. This field is required because the Kinde API does not properly handle unsetting or empty descriptions once they are set. To maintain consistent behavior and prevent state drift, we require a description for all roles.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the role",
            "description_kind": "markdown",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Key identifier of the role",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the role",
            "description_kind": "markdown",
            "required": true
          },
          "permissions": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of permission IDs associated with this role",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Roles represent collections of permissions that can be assigned to users. See [documentation](https://docs.kinde.com/kinde-apis/management/#tag/roles) for more details.",
        "description_kind": "markdown"
      }
    },
    "kinde_user": {
      "version": 0,
      "block": {
        "attributes": {
          "created_on": {
            "type": "string",
            "description": "The timestamp when the user was created.",
            "description_kind": "plain",
            "computed": true
          },
          "first_name": {
            "type": "string",
            "description": "The first name of the user.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier for the user.",
            "description_kind": "plain",
            "computed": true
          },
          "identities": {
            "nested_type": {
              "attributes": {
                "type": {
                  "type": "string",
                  "description": "The type of identity (email, username, phone, enterprise, social).",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "The value of the identity.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "Identities for the user (email, username, phone, etc.).",
            "description_kind": "plain",
            "required": true
          },
          "is_suspended": {
            "type": "bool",
            "description": "Whether the user is suspended.",
            "description_kind": "plain",
            "optional": true
          },
          "last_name": {
            "type": "string",
            "description": "The last name of the user.",
            "description_kind": "markdown",
            "required": true
          },
          "organization_code": {
            "type": "string",
            "description": "The code of the organization the user belongs to.",
            "description_kind": "plain",
            "optional": true
          },
          "updated_on": {
            "type": "string",
            "description": "The timestamp when the user was last updated.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a user within a Kinde organization.",
        "description_kind": "markdown"
      }
    },
    "kinde_user_role": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Computed ID for this role assignment",
            "description_kind": "markdown",
            "computed": true
          },
          "organization_code": {
            "type": "string",
            "description": "Code of the organization",
            "description_kind": "markdown",
            "required": true
          },
          "role_id": {
            "type": "string",
            "description": "ID of the role to assign",
            "description_kind": "markdown",
            "required": true
          },
          "user_id": {
            "type": "string",
            "description": "ID of the user",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Assigns a role to a user within an organization. See [documentation](https://docs.kinde.com/kinde-apis/management/#tag/organizations/post/api/v1/organizations/{org_code}/users/{user_id}/roles) for more details.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "kinde_api": {
      "version": 0,
      "block": {
        "attributes": {
          "audience": {
            "type": "string",
            "description": "Audience of the API",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ID of the API",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the API. Currently, there is no way to change this via the management API.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "APIs represent the resource server to authorise against. See [documentation](https://docs.kinde.com/developer-tools/your-apis/register-manage-apis/) for more details.",
        "description_kind": "markdown"
      }
    },
    "kinde_application": {
      "version": 0,
      "block": {
        "attributes": {
          "client_id": {
            "type": "string",
            "description": "The client ID of the application.",
            "description_kind": "plain",
            "computed": true
          },
          "client_secret": {
            "type": "string",
            "description": "The client secret of the application.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the application.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the application.",
            "description_kind": "plain",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The type of the application (reg, spa, or m2m).",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches a Kinde application.",
        "description_kind": "plain"
      }
    },
    "kinde_connections": {
      "version": 0,
      "block": {
        "attributes": {
          "connections": {
            "nested_type": {
              "attributes": {
                "display_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "strategy": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "computed": true
          },
          "filter": {
            "type": "string",
            "description": "Filter connections by type. Valid values are: `builtin`, `custom`, `all`. Defaults to `all`.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Use this data source to list available connections.",
        "description_kind": "markdown"
      }
    }
  }
}
