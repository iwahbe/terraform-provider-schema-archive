{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key_id": {
          "type": "string",
          "description": "Rad Security Customer Access ID",
          "description_kind": "markdown",
          "required": true
        },
        "rad_security_api_url": {
          "type": "string",
          "description": "Rad Security API to target. Defaults to https://api.rad.security",
          "description_kind": "markdown",
          "optional": true
        },
        "secret_key": {
          "type": "string",
          "description": "Rad Security Customer Secret Key",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "rad-security_aws_register": {
      "version": 0,
      "block": {
        "attributes": {
          "api_path": {
            "type": "string",
            "description": "Target of the API path",
            "description_kind": "markdown",
            "computed": true
          },
          "aws_account_id": {
            "type": "string",
            "description": "Rad Security Customer AWS account ID",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "rad_security_assumed_role_arn": {
            "type": "string",
            "description": "Rad Security Role to Trust",
            "description_kind": "markdown",
            "required": true
          },
          "rad_security_registered": {
            "type": "bool",
            "description": "Tracks if the account has been successfully registered",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Register AWS account with Rad Security",
        "description_kind": "markdown"
      }
    },
    "rad-security_azure_register": {
      "version": 0,
      "block": {
        "attributes": {
          "api_path": {
            "type": "string",
            "description": "Target of the API path",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "rad_security_registered": {
            "type": "bool",
            "description": "Target of the API path",
            "description_kind": "markdown",
            "computed": true
          },
          "service_principal_token_id": {
            "type": "string",
            "description": "Optional: Service Principal Token ID to use when authenticating  with token id and secret. OIDC based auth is the preferred option as it is more secure.",
            "description_kind": "markdown",
            "optional": true
          },
          "service_principal_token_secret": {
            "type": "string",
            "description": "Optional: Service Principal Token Secret to use when authenticating with token id and secret. OIDC based auth is the preferred option as it is more secure.",
            "description_kind": "markdown",
            "optional": true
          },
          "subscription_id": {
            "type": "string",
            "description": "Subscription ID to use",
            "description_kind": "markdown",
            "required": true
          },
          "tenant_id": {
            "type": "string",
            "description": "Azure Tenant to use when gathering resources",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Register Azure Subscription and Tenant with Rad Security",
        "description_kind": "markdown"
      }
    },
    "rad-security_cluster_api_key": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key": {
            "type": "string",
            "description": "Rad Security Cluster Access Key",
            "description_kind": "markdown",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "prefix": {
            "type": "string",
            "description": "Prefix for the access key name",
            "description_kind": "markdown",
            "optional": true
          },
          "secret_key": {
            "type": "string",
            "description": "Rad Security Cluster Secret Key",
            "description_kind": "markdown",
            "optional": true,
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Create new cluster access keys to use",
        "description_kind": "markdown"
      }
    },
    "rad-security_google_cloud_register": {
      "version": 0,
      "block": {
        "attributes": {
          "google_cloud_pool_provider_name": {
            "type": "string",
            "description": "Google Cloud pool provider name",
            "description_kind": "markdown",
            "required": true
          },
          "google_cloud_project_number": {
            "type": "string",
            "description": "Google Cloud project number to sync resources with",
            "description_kind": "markdown",
            "required": true
          },
          "google_cloud_service_account_email": {
            "type": "string",
            "description": "Google Cloud service account to impersonate",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Register Google Cloud Project with Workload Federation",
        "description_kind": "markdown"
      }
    },
    "rad-security_oci_register": {
      "version": 0,
      "block": {
        "attributes": {
          "api_path": {
            "type": "string",
            "description": "Target of the API path",
            "description_kind": "markdown",
            "computed": true
          },
          "fingerprint": {
            "type": "string",
            "description": "Fingerprint of the API signing key registered against the user.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "private_key": {
            "type": "string",
            "description": "PEM-encoded RSA private key matching the registered API signing key. Sent over TLS to Rad Security and stored in AWS Secrets Manager.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "rad_security_registered": {
            "type": "bool",
            "description": "Tracks if the account has been successfully registered.",
            "description_kind": "markdown",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "OCI home region used to sign API calls (e.g. us-ashburn-1).",
            "description_kind": "markdown",
            "required": true
          },
          "tenancy_ocid": {
            "type": "string",
            "description": "OCI Tenancy OCID \u2014 uniquely identifies the cloud account.",
            "description_kind": "markdown",
            "required": true
          },
          "user_ocid": {
            "type": "string",
            "description": "OCID of the OCI user that Rad Security authenticates as.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Register Oracle Cloud Infrastructure (OCI) tenancy with Rad Security",
        "description_kind": "markdown"
      }
    }
  }
}
