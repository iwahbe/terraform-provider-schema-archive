            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The id of the cloudspace",
            "description_kind": "markdown",
            "deprecated": true,
            "computed": true
          },
          "kubernetes_version": {
            "type": "string",
            "description": "Kubernetes version to deploy in the cloudspace. Supported values: 1.29.6, 1.30.10, 1.31.1",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "The last time the cloudspace was updated.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the cloudspace.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "pending_allocations": {
            "nested_type": {
              "attributes": {
                "bid_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "count": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "server_class": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "set"
            },
            "description_kind": "plain",
            "computed": true
          },
          "preemption_webhook": {
            "type": "string",
            "description": "Webhook URL for preemption notifications.",
            "description_kind": "markdown",
            "optional": true
          },
          "region": {
            "type": "string",
            "description": "The region where the cloudspace will be created.",
            "description_kind": "markdown",
            "required": true
          },
          "spotnodepool_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "IDs of the spotnodepools associated with the cloudspace.",
            "description_kind": "markdown",
            "computed": true
          },
          "timeouts": {
            "nested_type": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
