{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "The DRP server URL. ie: https://1.2.3.4:8092",
          "description_kind": "markdown",
          "optional": true
        },
        "key": {
          "type": "string",
          "description": "The DRP user:password key",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The DRP password",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Granted DRP token (use instead of RS_KEY)",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "The DRP user",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "drp_machine": {
      "version": 0,
      "block": {
        "attributes": {
          "add_parameters": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of parameters to add to the machine when allocating.  Parameters are removed on release.",
            "description_kind": "markdown",
            "optional": true
          },
          "add_profiles": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of profiles to add to the machine when allocating.  Profiles are removed on release.",
            "description_kind": "markdown",
            "optional": true
          },
          "address": {
            "type": "string",
            "description": "Returns the IP address on the machine, Machine.Address field",
            "description_kind": "markdown",
            "computed": true
          },
          "allocate_workflow": {
            "type": "string",
            "description": "Workflow to run when the machine is allocated in the pool",
            "description_kind": "markdown",
            "optional": true
          },
          "authorized_keys": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of ssh public keys that should be added to the access-keys parameter on the machine.",
            "description_kind": "markdown",
            "optional": true
          },
          "deallocate_parameters": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of parameters to add to the machine when deallocating.",
            "description_kind": "markdown",
            "optional": true
          },
          "deallocate_profiles": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of profiles to add to the machine when deallocating.",
            "description_kind": "markdown",
            "optional": true
          },
          "deallocate_workflow": {
            "type": "string",
            "description": "Workflow to run when the machine is released to the pool",
            "description_kind": "markdown",
            "optional": true
          },
          "filters": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of filters to restrict the search for a machie (usee Digital Rebar format e.g. FilterVar=Fn(value))",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Example identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Returns the Name of the machine, Machine.Name field",
            "description_kind": "markdown",
            "computed": true
          },
          "pool": {
            "type": "string",
            "description": "Pool to operate against for machine actions",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Returns the Pool status of the machine, Machine.PoolStatus field",
            "description_kind": "markdown",
            "computed": true
          },
          "timeout": {
            "type": "string",
            "description": "Maximum time to wait for the machine to complete transition.  Time string format.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Machine resource",
        "description_kind": "markdown"
      }
    }
  }
}
