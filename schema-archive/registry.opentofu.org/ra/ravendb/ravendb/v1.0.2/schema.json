{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ravendb_server": {
      "version": 0,
      "block": {
        "attributes": {
          "assets": {
            "type": [
              "map",
              "string"
            ],
            "description": "Upload files to an absolute path",
            "description_kind": "plain",
            "optional": true
          },
          "cluster_setup_zip": {
            "type": "string",
            "description": "This zip file path generated from either RavenDB setup wizard or from RavenDB RVN tool",
            "description_kind": "plain",
            "optional": true
          },
          "database": {
            "type": "string",
            "description": "The database name to check whether he is alive or not",
            "description_kind": "plain",
            "optional": true
          },
          "hosts": {
            "type": [
              "list",
              "string"
            ],
            "description": "The hostnames (or ip addresses) of the nodes that terraform will use to setup the RavenDB cluster",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "license": {
            "type": "string",
            "description": "The license that will be used for the setup of the RavenDB cluster",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "nodes": {
            "type": [
              "list",
              [
                "object",
                {
                  "assets": [
                    "map",
                    "string"
                  ],
                  "certificate_holder": "string",
                  "databases": [
                    "set",
                    [
                      "object",
                      {
                        "database": [
                          "list",
                          [
                            "object",
                            {
                              "encryption_key": "string",
                              "indexes": [
                                "list",
                                [
                                  "object",
                                  {
                                    "index": [
                                      "set",
                                      [
                                        "object",
                                        {
                                          "configuration": [
                                            "map",
                                            "string"
                                          ],
                                          "index_name": "string",
                                          "maps": [
                                            "list",
                                            "string"
                                          ],
                                          "reduce": "string"
                                        }
                                      ]
                                    ]
                                  }
                                ]
                              ],
                              "name": "string",
                              "replication_nodes": [
                                "list",
                                "string"
                              ],
                              "settings": [
                                "map",
                                "string"
                              ]
                            }
                          ]
                        ]
                      }
                    ]
                  ],
                  "databases_to_delete": [
                    "set",
                    [
                      "object",
                      {
                        "database": [
                          "list",
                          [
                            "object",
                            {
                              "hard_delete": "bool",
                              "name": "string"
                            }
                          ]
                        ]
                      }
                    ]
                  ],
                  "failed": "bool",
                  "host": "string",
                  "http_url": "string",
                  "indexes_to_delete": [
                    "set",
                    [
                      "object",
                      {
                        "index": [
                          "list",
                          [
                            "object",
                            {
                              "database_name": "string",
                              "indexes_names": [
                                "list",
                                "string"
                              ]
                            }
                          ]
                        ]
                      }
                    ]
                  ],
                  "license": "string",
                  "settings": [
                    "map",
                    "string"
                  ],
                  "tcp_url": "string",
                  "unsecured": "bool",
                  "version": "string"
                }
              ]
            ],
            "description": "The state of all the nodes in the RavenDB cluster.",
            "description_kind": "plain",
            "computed": true
          },
          "settings_override": {
            "type": [
              "map",
              "string"
            ],
            "description": "Overriding the settings.json file",
            "description_kind": "plain",
            "optional": true
          },
          "unsecured": {
            "type": "bool",
            "description": "Whatever to allow to run RavenDB in unsecured mode. This is ***NOT*** recommended!",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "databases": {
            "nesting_mode": "set",
            "block": {
              "block_types": {
                "database": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "encryption_key": {
                        "type": "string",
                        "description": "Encryption key for the database",
                        "description_kind": "plain",
                        "optional": true,
                        "sensitive": true
                      },
                      "name": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "replication_nodes": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "The database will be created on these nodes",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "settings": {
                        "type": [
                          "map",
                          "string"
                        ],
                        "description": "Database Settings",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "block_types": {
                      "indexes": {
                        "nesting_mode": "list",
                        "block": {
                          "block_types": {
                            "index": {
                              "nesting_mode": "set",
                              "block": {
                                "attributes": {
                                  "configuration": {
                                    "type": [
                                      "map",
                                      "string"
                                    ],
                                    "description_kind": "plain",
                                    "optional": true
                                  },
                                  "index_name": {
                                    "type": "string",
                                    "description_kind": "plain",
                                    "required": true
                                  },
                                  "maps": {
                                    "type": [
                                      "list",
                                      "string"
                                    ],
                                    "description_kind": "plain",
                                    "required": true
                                  },
                                  "reduce": {
                                    "type": "string",
                                    "description_kind": "plain",
                                    "required": true
                                  }
                                },
                                "description_kind": "plain"
                              },
                              "min_items": 1
                            }
                          },
                          "description_kind": "plain"
                        }
                      }
                    },
                    "description_kind": "plain"
                  },
                  "min_items": 1
                }
              },
              "description": "Creation of databases and indexes",
              "description_kind": "plain"
            }
          },
          "databases_to_delete": {
            "nesting_mode": "set",
            "block": {
              "block_types": {
                "database": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "hard_delete": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "name": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "min_items": 1
                }
              },
              "description": "Databases that will be hard/soft deleted",
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "indexes_to_delete": {
            "nesting_mode": "set",
            "block": {
              "block_types": {
                "index": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "database_name": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "indexes_names": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "min_items": 1
                }
              },
              "description": "Indexes that will be deleted on a given database",
              "description_kind": "plain"
            }
          },
          "package": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "arch": {
                  "type": "string",
                  "description": "Operating system architecture name - amd64, arm64, arm32",
                  "description_kind": "plain",
                  "optional": true
                },
                "version": {
                  "type": "string",
                  "description": "The RavenDB version to use for the cluster",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "The RavenDB download package set",
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          },
          "ssh": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "pem": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "user": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                }
              },
              "description": "Connection credentials needed to SSH to the machines",
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          },
          "url": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "http_port": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                },
                "list": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "required": true
                },
                "tcp_port": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Nodes to deploy",
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
