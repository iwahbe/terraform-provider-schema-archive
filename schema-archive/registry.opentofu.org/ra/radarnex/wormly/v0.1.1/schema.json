{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Wormly API key.",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "backoff_multiplier": {
          "type": "number",
          "description": "Multiplier for exponential backoff. Defaults to 2.0.",
          "description_kind": "markdown",
          "optional": true
        },
        "base_url": {
          "type": "string",
          "description": "Base URL for the Wormly API. Defaults to 'https://api.wormly.com'.",
          "description_kind": "markdown",
          "optional": true
        },
        "debug": {
          "type": "bool",
          "description": "Enable debug logging for API requests and responses. Defaults to false.",
          "description_kind": "markdown",
          "optional": true
        },
        "initial_backoff": {
          "type": "string",
          "description": "Initial backoff duration for retry attempts. Defaults to '1s'.",
          "description_kind": "markdown",
          "optional": true
        },
        "max_backoff": {
          "type": "string",
          "description": "Maximum backoff duration. Defaults to '30s'.",
          "description_kind": "markdown",
          "optional": true
        },
        "max_retries": {
          "type": "number",
          "description": "Maximum number of retries for failed requests. Defaults to 3.",
          "description_kind": "markdown",
          "optional": true
        },
        "requests_per_second": {
          "type": "number",
          "description": "Maximum number of requests per second to the Wormly API. Defaults to 10.",
          "description_kind": "markdown",
          "optional": true
        },
        "user_agent": {
          "type": "string",
          "description": "User agent string for API requests. Defaults to 'terraform-provider-wormly/dev'.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "wormly_global_alerts_mute": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Whether global alerts mute is enabled",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Resource identifier (always 'global_alerts_mute')",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Wormly global alerts mute resource. Controls the global alert mute setting.",
        "description_kind": "markdown"
      }
    },
    "wormly_host": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Whether the host is enabled",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Host identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Host name",
            "description_kind": "markdown",
            "required": true
          },
          "test_interval": {
            "type": "number",
            "description": "Test interval in seconds",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Wormly host resource",
        "description_kind": "markdown"
      }
    },
    "wormly_scheduled_downtime_period": {
      "version": 0,
      "block": {
        "attributes": {
          "end": {
            "type": "string",
            "description": "The ending time of the period in HH:mm format (24-hour clock)",
            "description_kind": "markdown",
            "required": true
          },
          "hostid": {
            "type": "number",
            "description": "The ID of the host to schedule downtime for",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Scheduled downtime period identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "on": {
            "type": "string",
            "description": "The specific day for the downtime. For ONCEONLY recurrence, this is a date in YYYY-MM-DD format. For WEEKLY recurrence, this is the day of the week (e.g., 'Sunday'). For MONTHLY recurrence, this is the day of the month (1-31 or 'LASTDAY'). This argument should be omitted for DAILY recurrence.",
            "description_kind": "markdown",
            "optional": true
          },
          "recurrence": {
            "type": "string",
            "description": "The recurrence pattern. Must be one of ONCEONLY, DAILY, WEEKLY, or MONTHLY",
            "description_kind": "markdown",
            "required": true
          },
          "start": {
            "type": "string",
            "description": "The starting time of the period in HH:mm format (24-hour clock)",
            "description_kind": "markdown",
            "required": true
          },
          "timezone": {
            "type": "string",
            "description": "The POSIX standard timezone of the start and end times (e.g., 'GMT', 'Europe/London')",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Wormly scheduled downtime period resource",
        "description_kind": "markdown"
      }
    },
    "wormly_sensor_http": {
      "version": 0,
      "block": {
        "attributes": {
          "cookies": {
            "type": "string",
            "description": "Cookies to send with request",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "custom_request_headers": {
            "type": "string",
            "description": "Custom request headers",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether the sensor is enabled",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "expected_text": {
            "type": "string",
            "description": "Expected text in response",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "force_resolve": {
            "type": "string",
            "description": "Force resolve to specific IP",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "host_id": {
            "type": "number",
            "description": "Host ID",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Sensor identifier in format <host_id>/<sensor_id>",
            "description_kind": "markdown",
            "computed": true
          },
          "nice_name": {
            "type": "string",
            "description": "Nice name for the sensor",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "post_params": {
            "type": "string",
            "description": "POST parameters",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "response_code": {
            "type": "string",
            "description": "Expected HTTP response code",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "search_headers": {
            "type": "bool",
            "description": "Whether to search headers",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "ssl_validity": {
            "type": "number",
            "description": "SSL validity period in days",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "timeout": {
            "type": "number",
            "description": "Timeout in seconds",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "unwanted_text": {
            "type": "string",
            "description": "Unwanted text in response",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "URL to monitor",
            "description_kind": "markdown",
            "required": true
          },
          "user_agent": {
            "type": "string",
            "description": "User agent string",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "verify_ssl_cert": {
            "type": "bool",
            "description": "Whether to verify SSL certificate",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Wormly HTTP sensor resource\n\n~> Note: Wormly's public API does not currently provide a dedicated update command for HTTP sensor settings, so changes to attributes other than `enabled` require resource replacement.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "wormly_host": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Whether the host is enabled",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Host identifier",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Host name",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Wormly host data source",
        "description_kind": "markdown"
      }
    },
    "wormly_sensor_http": {
      "version": 0,
      "block": {
        "attributes": {
          "host_id": {
            "type": "number",
            "description": "Host identifier",
            "description_kind": "markdown",
            "required": true
          },
          "sensors": {
            "nested_type": {
              "attributes": {
                "enabled": {
                  "type": "bool",
                  "description": "Whether the sensor is enabled",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Sensor identifier",
                  "description_kind": "markdown",
                  "computed": true
                },
                "nice_name": {
                  "type": "string",
                  "description": "Sensor nice name",
                  "description_kind": "markdown",
                  "computed": true
                },
                "params": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "Sensor parameters",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of HTTP sensors for the host",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Wormly HTTP sensor data source",
        "description_kind": "markdown"
      }
    }
  }
}
