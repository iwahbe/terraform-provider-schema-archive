{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "Endpoint url",
          "description_kind": "markdown",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "Password",
          "description_kind": "markdown",
          "optional": true
        },
        "tls": {
          "type": "bool",
          "description": "Enable TLS, defaults to true",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "arangodb_database": {
      "version": 0,
      "block": {
        "attributes": {
          "name": {
            "type": "string",
            "description": "Database name",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "An Arango Database can store data",
        "description_kind": "markdown"
      }
    },
    "arangodb_user": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "An optional flag that specifies whether the user is active",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "The user password",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "user": {
            "type": "string",
            "description": "The name of the user",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "An Arango user can access some defined databases",
        "description_kind": "markdown"
      }
    },
    "arangodb_user_permission": {
      "version": 0,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description": "Database name",
            "description_kind": "markdown",
            "required": true
          },
          "permission": {
            "type": "string",
            "description": "Permission to access the database, can be 'ro' for read only, 'rw' for read-write or 'none'",
            "description_kind": "markdown",
            "required": true
          },
          "user": {
            "type": "string",
            "description": "The name of the user",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "A user permission to access a database",
        "description_kind": "markdown"
      }
    }
  }
}
