    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The Confluent Cloud API Key.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "api_secret": {
          "type": "string",
          "description": "The Confluent Cloud API Secret.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "The base endpoint of Confluent Cloud API. Defaults to `https://api.confluent.cloud`.",
          "description_kind": "markdown",
          "optional": true
        },
        "wait_until": {
          "type": "string",
          "description": "Terraform apply will wait until the specified field that is populated. Defaults to `PROVISIONED`.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
