{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key": {
          "type": "string",
          "description": "Couchbase Capella API Access Key",
          "description_kind": "markdown",
          "required": true
        },
        "secret_key": {
          "type": "string",
          "description": "Couchbase Capella API Secret Key",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "couchbasecapella_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "ID of the Cluster",
            "description_kind": "markdown",
            "required": true
          },
          "conflict_resolution": {
            "type": "string",
            "description": "Conflict resolution for bucket",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "memory_quota": {
            "type": "number",
            "description": "Bucket Memory quota in Mb",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Bucket",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage Couchbase Capella Buckets",
        "description_kind": "markdown"
      }
    },
    "couchbasecapella_database_user": {
      "version": 0,
      "block": {
        "attributes": {
          "all_bucket_access": {
            "type": "string",
            "description": "Define all bucket access for the Database User",
            "description_kind": "markdown",
            "optional": true
          },
          "cluster_id": {
            "type": "string",
            "description": "ID of the Cluster",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "Password for the Database User",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "username": {
            "type": "string",
            "description": "Username for the Database User",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "buckets": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "bucket_access": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "bucket_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Define bucket access level for the Database User",
              "description_kind": "markdown"
            }
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Manage Couchbase Capella Database Users",
        "description_kind": "markdown"
      }
    },
    "couchbasecapella_hosted_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "A description for the Cluster",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the Cluster",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Cluster",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "ID of the Project the Cluster is contained in",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "place": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "single_az": {
                  "type": "bool",
                  "description": "A boolean for if the Cluster has a single Availability Zone",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "block_types": {
                "hosted": {
                  "nesting_mode": "set",
                  "block": {
                    "attributes": {
                      "cidr": {
                        "type": "string",
                        "description": "CIDR block",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "provider": {
                        "type": "string",
                        "description": "The name of the cloud provider where the cluster will be deployed",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "region": {
                        "type": "string",
                        "description": "A valid region for the Cloud Provider",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "description": "The environment of the hosted cluster",
                    "description_kind": "markdown"
                  },
                  "min_items": 1
                }
              },
              "description": "The place where the Cluster is deployed",
              "description_kind": "markdown"
            },
            "min_items": 1
          },
          "servers": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "compute": {
                  "type": "string",
                  "description": "Compute instance type",
                  "description_kind": "markdown",
                  "required": true
                },
                "services": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Couchbase Services",
                  "description_kind": "markdown",
                  "required": true
                },
                "size": {
                  "type": "number",
                  "description": "Number of nodes",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "block_types": {
                "storage": {
                  "nesting_mode": "set",
                  "block": {
                    "attributes": {
                      "iops": {
                        "type": "number",
                        "description": "IOPS",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "storage_size": {
                        "type": "number",
                        "description": "Storage size in Gb",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "storage_type": {
                        "type": "string",
                        "description": "Storage type",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "description": "Configuration for storage",
                    "description_kind": "markdown"
                  },
                  "min_items": 1
                }
              },
              "description": "Configuration of the servers in Cluster",
              "description_kind": "markdown"
            },
            "min_items": 1
          },
          "support_package": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "support_package_type": {
                  "type": "string",
                  "description": "The Support Package type of the cluster",
                  "description_kind": "markdown",
                  "required": true
                },
                "timezone": {
                  "type": "string",
                  "description": "The Timezone of the Support Package",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "Support Package for the Cluster",
              "description_kind": "markdown"
            },
            "min_items": 1
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Manage Couchbase Capella hosted clusters.",
        "description_kind": "markdown"
      }
    },
    "couchbasecapella_project": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the Project",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Project",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage Couchbase Projects.",
        "description_kind": "markdown"
      }
    },
    "couchbasecapella_vpc_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "cloud_id": {
            "type": "string",
            "description": "ID of the Cloud the Cluster will be deployed in",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the Cluster",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Cluster",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "ID of the Project",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "servers": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "services": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Couchbase Services",
                  "description_kind": "markdown",
                  "required": true
                },
                "size": {
                  "type": "number",
                  "description": "Number of nodes",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "block_types": {
                "aws": {
                  "nesting_mode": "set",
                  "block": {
                    "attributes": {
                      "ebs_size_gib": {
                        "type": "number",
                        "description": "Aws volume size (Gb)",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "instance_size": {
                        "type": "string",
                        "description": "Aws instance",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "description": "Aws configuration",
                    "description_kind": "markdown"
                  }
                },
                "azure": {
                  "nesting_mode": "set",
                  "block": {
                    "attributes": {
                      "instance_size": {
                        "type": "string",
                        "description": "Azure instance",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "volume_type": {
                        "type": "string",
                        "description": "Azure volume size (Gb)",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "description": "Azure configuration",
                    "description_kind": "markdown"
                  }
                }
              },
              "description": "Server Configuration of the Cluster",
              "description_kind": "markdown"
            },
            "min_items": 1
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Manage Couchbase Capella vpc clusters.",
        "description_kind": "markdown"
      }
    }
  }
}
