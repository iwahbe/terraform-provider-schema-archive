{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "Host URL for OpenCGA REST API, e.g. https://opencga.mycompany.com",
          "description_kind": "plain",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "Password for OpenCGA login. Recommended to be set via OPENCGA_PASSWORD env var.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Username for OpenCGA login, must be admin user. May also be set via OPENCGA_USERNAME env var.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "opencga_file": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Directory path, this does not have to be the absolute path if a root is configured. e.g. sample/, /genomes/sample",
            "description_kind": "plain",
            "required": true
          },
          "study": {
            "type": "string",
            "description": "The `id` of the study this file is associated with.",
            "description_kind": "plain",
            "optional": true
          },
          "uri": {
            "type": "string",
            "description": "File absolute path (URI), e.g. /genomes/sample/A00001.cram",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "opencga_project": {
      "version": 0,
      "block": {
        "attributes": {
          "alias": {
            "type": "string",
            "description": "Project alias. Do not supply the `null@` prefix seen in created resources. This will be added by OpenCGA automatically",
            "description_kind": "plain",
            "required": true
          },
          "assembly": {
            "type": "string",
            "description": "Reference genome assembly name. i.e. GRCh38",
            "description_kind": "plain",
            "required": true
          },
          "check_description": {
            "type": "bool",
            "description": "If true the description content will be checked against the state",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Long name for the project, spaces are allowed",
            "description_kind": "plain",
            "required": true
          },
          "scientific_name": {
            "type": "string",
            "description": "Usually this is `Homo Sapiens`",
            "description_kind": "plain",
            "required": true
          },
          "taxonomy_code": {
            "type": "number",
            "description": "Usually this is `9606`",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "opencga_study": {
      "version": 0,
      "block": {
        "attributes": {
          "alias": {
            "type": "string",
            "description": "Study alias name",
            "description_kind": "plain",
            "required": true
          },
          "check_description": {
            "type": "bool",
            "description": "If true the description content will be checked against the state",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Study long name",
            "description_kind": "plain",
            "required": true
          },
          "project": {
            "type": "string",
            "description": "The `id` of the project this study is associated with.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "opencga_study_acl": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "member": {
            "type": "string",
            "description": "This can be a user name or group id.",
            "description_kind": "plain",
            "required": true
          },
          "permissions": {
            "type": "string",
            "description": "Comma separated list of OpenCGA permissions. Refer to OpenCGA docs for allowed values.",
            "description_kind": "plain",
            "optional": true
          },
          "study": {
            "type": "string",
            "description": "The id of the study that this ACL should be attached to.",
            "description_kind": "plain",
            "required": true
          },
          "template": {
            "type": "string",
            "description": "Preset permissions, can be one of: admin, analyst, view_only.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "opencga_study_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Group name",
            "description_kind": "plain",
            "required": true
          },
          "study": {
            "type": "string",
            "description": "The study that this group belongs to",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "opencga_variableset": {
      "version": 0,
      "block": {
        "attributes": {
          "check_description": {
            "type": "bool",
            "description": "If true the description content will be checked against the state",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Description, can be left blank",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Variable Set name",
            "description_kind": "plain",
            "required": true
          },
          "study": {
            "type": "string",
            "description": "The study that this variable set belongs to",
            "description_kind": "plain",
            "optional": true
          },
          "unique": {
            "type": "bool",
            "description": "True if there can only be 1 instance of this attached to a record item. False to allow for multiple instances.",
            "description_kind": "plain",
            "required": true
          },
          "variables": {
            "type": "string",
            "description": "Json content representing the variables in this variable set. Json definitions can be read directly from the GelReportModels repo.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "opencga_project": {
      "version": 0,
      "block": {
        "attributes": {
          "alias": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "assembly": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "id_filter": {
            "type": "number",
            "description": "A project id to limit the search",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name_filter": {
            "type": "string",
            "description": "A project name to limit the search",
            "description_kind": "plain",
            "optional": true
          },
          "scientific_name": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "taxonomy_code": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Use this data source to get a single Project for use in other resources",
        "description_kind": "plain"
      }
    },
    "opencga_projects": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id_filter": {
            "type": "number",
            "description": "A project id to limit the search",
            "description_kind": "plain",
            "optional": true
          },
          "name_filter": {
            "type": "string",
            "description": "A project name to limit the search",
            "description_kind": "plain",
            "optional": true
          },
          "projects": {
            "type": [
              "list",
              [
                "object",
                {
                  "alias": "string",
                  "assembly": "string",
                  "description": "string",
                  "id": "number",
                  "name": "string",
                  "scientific_name": "string",
                  "taxonomy_code": "number"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Use this data source to list several existing Projects for use in other resources",
        "description_kind": "plain"
      }
    },
    "opencga_studies": {
      "version": 0,
      "block": {
        "attributes": {
          "alias_filter": {
            "type": "string",
            "description": "A study alias to limit the search",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id_filter": {
            "type": "number",
            "description": "A study id to limit the search",
            "description_kind": "plain",
            "optional": true
          },
          "project": {
            "type": "string",
            "description": "A project id or alias to limit the search",
            "description_kind": "plain",
            "optional": true
          },
          "studies": {
            "type": [
              "list",
              [
                "object",
                {
                  "alias": "string",
                  "description": "string",
                  "id": "number",
                  "name": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Use this data source to list several existing Studies for use in other resources",
        "description_kind": "plain"
      }
    },
    "opencga_variablesets": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "study": {
            "type": "string",
            "description": "A study id or name to limit the search",
            "description_kind": "plain",
            "required": true
          },
          "variable_sets": {
            "type": [
              "list",
              [
                "object",
                {
                  "description": "string",
                  "id": "number",
                  "name": "string",
                  "unique": "bool",
                  "variables": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Use this data source to list several existing VariableSets for use in other resources",
        "description_kind": "plain"
      }
    }
  }
}
