{
  "provider": {
    "version": 0,
    "block": {
      "description": "The download Terraform provider allows you to download a file from an http website.",
      "description_kind": "markdown"
    }
  },
  "data_source_schemas": {
    "download_file": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "output_base64sha256": {
            "type": "string",
            "description": "Base64 Encoded SHA256 checksum of output file",
            "description_kind": "markdown",
            "computed": true
          },
          "output_file": {
            "type": "string",
            "description": "File name to write content",
            "description_kind": "markdown",
            "required": true
          },
          "output_md5": {
            "type": "string",
            "description": "MD5 of output file",
            "description_kind": "markdown",
            "computed": true
          },
          "output_sha": {
            "type": "string",
            "description": "SHA1 checksum of output file",
            "description_kind": "markdown",
            "computed": true
          },
          "output_sha256": {
            "type": "string",
            "description": "SHA256 checksum of output file",
            "description_kind": "markdown",
            "computed": true
          },
          "output_size": {
            "type": "number",
            "description": "File size of output file",
            "description_kind": "markdown",
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "URL to download",
            "description_kind": "markdown",
            "required": true
          },
          "verify_md5": {
            "type": "string",
            "description": "MD5 checksum to verify",
            "description_kind": "markdown",
            "optional": true
          },
          "verify_sha": {
            "type": "string",
            "description": "SHA1 checksum to verify",
            "description_kind": "markdown",
            "optional": true
          },
          "verify_sha256": {
            "type": "string",
            "description": "SHA256 checksum to verify",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Downloads a file from a website using the supplied URL.",
        "description_kind": "markdown"
      }
    }
  },
  "functions": {
    "file": {
      "description": "Downloads a file from a given URL and returns the filename.",
      "summary": "Downloads a file, returning the filename.",
      "return_type": "string",
      "parameters": [
        {
          "name": "url",
          "description": "URL to download",
          "type": "string"
        },
        {
          "name": "filename",
          "description": "Name of the filename for the contents.",
          "type": "string"
        }
      ]
    }
  }
}
