{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "hostname": {
          "type": "string",
          "description": "The hostname of the Palo Alto",
          "description_kind": "plain",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "The password of the Palo Alto",
          "description_kind": "plain",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "The username of the Palo Alto",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "excpanos_netflow": {
      "version": 0,
      "block": {
        "attributes": {
          "active_timeout": {
            "type": "number",
            "description": "Minutes before a flow is considered inactive",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The administrative Netflow's name",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "server": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "hostname": {
                  "type": "string",
                  "description": "The hostname of the server",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the server",
                  "description_kind": "plain",
                  "required": true
                },
                "port": {
                  "type": "number",
                  "description": "The port of the server",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "The server to send the netflow",
              "description_kind": "plain"
            },
            "min_items": 1
          },
          "template_refresh_rate": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "minutes": {
                  "type": "number",
                  "description": "Minutes beetwen each refresh",
                  "description_kind": "plain",
                  "optional": true
                },
                "paquets": {
                  "type": "number",
                  "description": "Seconds beetwen each refresh",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Netflow template refresh rate",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "excpanos_tag": {
      "version": 0,
      "block": {
        "attributes": {
          "color": {
            "type": "string",
            "description": "The administrative tag's color",
            "description_kind": "plain",
            "required": true
          },
          "comments": {
            "type": "string",
            "description": "The administrative tag's comment",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The administrative tag's name",
            "description_kind": "plain",
            "required": true
          },
          "vsys": {
            "type": "string",
            "description": "The administrative tag's vsys",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
