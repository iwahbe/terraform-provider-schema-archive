                  "sensitive": true
                },
                "port": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "username": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "warpgate_target_roles": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Id of the target in warpgate",
            "description_kind": "markdown",
            "required": true
          },
          "role_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of id roles'",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "warpgate_user": {
      "version": 0,
      "block": {
        "attributes": {
          "credentials": {
            "nested_type": {
              "attributes": {
                "email": {
                  "type": "string",
                  "description": "The email of the user in the sso system. Only for kind: `Sso`",
                  "description_kind": "markdown",
                  "optional": true
                },
                "hash": {
                  "type": "string",
                  "description": "The hashed password. Only for kind: `Password`",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                },
                "kind": {
                  "type": "string",
                  "description": "The credential type. Valid values are:\n\t- `Sso` requires: `email` and `provider`.\n\t- `Totp` requires: `totp_key`.\n\t- `Password` requires: `hash`.\n\t- `PublicKey` requires: `public_key`.\n",
                  "description_kind": "markdown",
                  "required": true
                },
                "provider": {
                  "type": "string",
                  "description": "The sso provider name defined in the configuration file. Only for kind: `Sso`",
                  "description_kind": "markdown",
                  "optional": true
                },
                "public_key": {
                  "type": "string",
                  "description": "The ssh public key that the user uses to connect via ssh. Only for kind: `PublicKey`",
                  "description_kind": "plain",
                  "optional": true
                },
                "totp_key": {
                  "type": [
                    "list",
                    "number"
                  ],
                  "description": "The totp secret key as array of uint8. Only for kind: `Totp`",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "set"
            },
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Id of the user in warpgate",
            "description_kind": "markdown",
            "computed": true
          },
          "roles": {
            "type": [
              "set",
              "string"
            ],
            "description": "The list of roles that the user belong to. To assign a new role to the user refer to [user_roles](user_roles.md) ",
            "description_kind": "markdown",
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "The username of the user.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "warpgate_user_roles": {
      "version": 0,
