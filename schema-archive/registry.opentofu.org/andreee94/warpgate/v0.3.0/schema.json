{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "The hostname of the warpgate server",
          "description_kind": "plain",
          "optional": true
        },
        "insecure_skip_verify": {
          "type": "bool",
          "description": "If to skip the verification of the tls certificate (For self signed certificates)",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The password to login to the warpgate server",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "port": {
          "type": "number",
          "description": "The hostname of the warpgate server",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "The username to login to the warpgate server",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "warpgate_http_target": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_roles": {
            "type": [
              "set",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Id of the http target in warpgate",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The username of the user.",
            "description_kind": "markdown",
            "required": true
          },
          "options": {
            "nested_type": {
              "attributes": {
                "external_host": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "headers": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "tls": {
                  "nested_type": {
                    "attributes": {
                      "mode": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "verify": {
                        "type": "bool",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "required": true
                },
                "url": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "warpgate_role": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Id of the role in warpgate",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
