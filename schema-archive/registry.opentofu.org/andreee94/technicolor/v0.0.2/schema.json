{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "The hostname of the Technicolor router",
          "description_kind": "plain",
          "required": true
        },
        "password": {
          "type": "string",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "port": {
          "type": "number",
          "description": "The port of the Technicolor router (Default: 80)",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "technicolor_port_forwarded_list": {
      "version": 0,
      "block": {
        "attributes": {
          "ports": {
            "nested_type": {
              "attributes": {
                "enabled": {
                  "type": "bool",
