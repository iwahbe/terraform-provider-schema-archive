                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "index": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "lan_ip": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "lan_mac": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "lan_port": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "protocol": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "wan_port": {
                  "type": "number",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
