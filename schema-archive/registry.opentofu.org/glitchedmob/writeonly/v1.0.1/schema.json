{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "writeonly_data": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Unique identifier.",
            "description_kind": "markdown",
            "computed": true
          },
          "input_wo": {
            "type": "string",
            "description": "Write-only input that accepts ephemeral values. The value is stored in `output`.",
            "description_kind": "markdown",
            "optional": true
          },
          "input_wo_version": {
            "type": "number",
            "description": "When changed, triggers re-capture of the input_wo value.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "output": {
            "type": "string",
            "description": "The captured value from input_wo.",
            "description_kind": "markdown",
            "computed": true
          },
          "triggers_replace": {
            "type": [
              "list",
              "string"
            ],
            "description": "Forces replacement when value changes.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "A resource that mimics terraform_data with write-only input support.",
        "description_kind": "markdown"
      }
    }
  }
}
