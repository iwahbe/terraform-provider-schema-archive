{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "Okteto API Token - Can also be configured by setting environment variable with name 'OKTETO_API_TOKEB'",
          "description_kind": "markdown",
          "optional": true
        },
        "namespace": {
          "type": "string",
          "description": "Okteto Namespace",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "okteto_pipeline": {
      "version": 0,
      "block": {
        "attributes": {
          "branch": {
            "type": "string",
            "description": "Branch",
            "description_kind": "markdown",
            "required": true
          },
          "deployments": {
            "nested_type": {
              "attributes": {
                "endpoints": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "set"
            },
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Pipeline identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name",
            "description_kind": "markdown",
            "required": true
          },
          "repo_url": {
            "type": "string",
            "description": "RepoURL",
            "description_kind": "markdown",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Status",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Pipeline resource",
        "description_kind": "markdown"
      }
    },
    "okteto_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Secret identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Value",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Secret resource",
        "description_kind": "markdown"
      }
    }
  }
}
