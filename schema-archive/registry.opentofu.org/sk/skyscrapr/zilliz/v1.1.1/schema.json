{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Zilliz API Key",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "cloud_region_id": {
          "type": "string",
          "description": "Zilliz Cloud Region Id",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "zilliz_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_name": {
            "type": "string",
            "description": "The name of the cluster to be created. It is a string of no more than 32 characters.",
            "description_kind": "markdown",
            "required": true
          },
          "cluster_type": {
            "type": "string",
            "description": "The type of CU associated with the cluster. Possible values are Performance-optimized and Capacity-optimized.",
            "description_kind": "markdown",
            "computed": true
          },
          "connect_address": {
            "type": "string",
            "description": "The public endpoint of the cluster. You can connect to the cluster using this endpoint from the public network.",
            "description_kind": "markdown",
            "computed": true
          },
          "create_time": {
            "type": "string",
            "description": "The time at which the cluster has been created.",
            "description_kind": "markdown",
            "computed": true
          },
          "cu_size": {
            "type": "number",
            "description": "The size of the CU to be used for the created cluster. It is an integer from 1 to 256.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "cu_type": {
            "type": "string",
            "description": "The type of the CU used for the Zilliz Cloud cluster to be created. Available options are Performance-optimized, Capacity-optimized, and Cost-optimized. This parameter defaults to Performance-optimized. The value defaults to Performance-optimized.",
            "description_kind": "markdown",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "An optional description about the cluster.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Cluster identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "The password of the cluster user generated by default. It will not be displayed again, so note it down and securely store it.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "plan": {
            "type": "string",
            "description": "The plan tier of the Zilliz Cloud service. Available options are Standard and Enterprise.",
            "description_kind": "markdown",
            "optional": true
          },
          "private_link_address": {
            "type": "string",
            "description": "The private endpoint of the cluster. You can set up a private link to allow your VPS in the same cloud region to access your cluster.",
            "description_kind": "markdown",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "The ID of the project where the cluster is to be created.",
            "description_kind": "markdown",
            "required": true
          },
          "prompt": {
            "type": "string",
            "description": "The statement indicating that this operation succeeds.",
            "description_kind": "markdown",
            "computed": true
          },
          "region_id": {
            "type": "string",
            "description": "The ID of the region where the cluster exists.",
            "description_kind": "markdown",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "The current status of the cluster. Possible values are INITIALIZING, RUNNING, SUSPENDING, and RESUMING.",
            "description_kind": "markdown",
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "The name of the cluster user generated by default.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "Timeout defaults to 5 mins. Accepts a string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "Timeout defaults to 5 mins. Accepts a string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Cluster resource. If 'plan', 'cu_size' and 'cu-type' are specified, then a dedicated cluster is created. Otherwise a serverless cluster in created.",
        "description_kind": "markdown"
      }
    }
  },
