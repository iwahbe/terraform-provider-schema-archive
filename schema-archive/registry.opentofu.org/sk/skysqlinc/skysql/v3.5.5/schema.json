    "skysql_config": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_restart": {
            "type": "bool",
            "description": "Whether to allow configuration values that require a service restart. When `false` (the default), setting any variable that has `requires_restart = true` in the DPS parameter catalog will be rejected both client-side (before the API call) and server-side (by DPS). Set to `true` to permit restart-causing variables. The parameter is forwarded to DPS as `?allow_restart=true` on config value API calls.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier for the configuration object.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the configuration object. Must be unique within the organization.",
            "description_kind": "markdown",
            "required": true
          },
          "topology": {
            "type": "string",
            "description": "The topology name (e.g. `es-single`, `es-replica`, `galera`). Determines which server variables are available.",
            "description_kind": "markdown",
            "required": true
          },
          "topology_id": {
            "type": "string",
            "description": "The resolved topology UUID.",
            "description_kind": "markdown",
            "computed": true
          },
          "values": {
            "type": [
              "map",
              "string"
            ],
            "description": "A map of MariaDB server variable names to their values (e.g. `max_connections = \"500\"`).",
            "description_kind": "markdown",
            "optional": true
          },
          "version": {
            "type": "string",
            "description": "The MariaDB server version (e.g. `10.6.7-3-1`). Must match an available version for the topology.",
            "description_kind": "markdown",
            "required": true
          },
          "version_id": {
            "type": "string",
            "description": "The resolved version UUID.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Creates and manages a custom configuration object in SkySQL.\n\nA configuration object holds MariaDB server variable overrides that can be applied to one or more services. Use the `values` attribute to set server variables by name.\n\nSupported topologies: `es-single` (standalone), `es-replica` (primary with replicas), `galera` (Galera cluster).",
        "description_kind": "markdown"
      }
    },
    "skysql_service": {
      "version": 2,
      "block": {
        "attributes": {
          "allow_list": {
            "nested_type": {
              "attributes": {
                "comment": {
                  "type": "string",
                  "description": "A comment to describe the IP address",
                  "description_kind": "plain",
                  "optional": true
                },
                "ip": {
                  "type": "string",
                  "description": "The IP address to allow access to the service. The IP must be in a valid CIDR format",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The list of IP addresses with comments to allow access to the service",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "architecture": {
            "type": "string",
            "description": "The architecture of the service. Valid values are: amd64 or arm64",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "availability_zone": {
            "type": "string",
            "description": "The availability zone of the service",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "cloud_provider": {
            "type": "string",
            "description": "The cloud provider to create the service in. Valid values are: aws or gcp",
            "description_kind": "plain",
            "required": true
          },
          "config_id": {
            "type": "string",
            "description": "The ID of a custom configuration object to apply to this service. The configuration must match the service topology and version. Requires `wait_for_creation = true` when set during service creation.\n\n**Update behavior:**\n- **Set or change** `config_id` \u2192 applies the new configuration to the service via `POST /services/{id}/config`.\n- **Remove** `config_id` \u2192 reverts the service to its default configuration via `DELETE /services/{id}/config`.\n- If the service already has the specified config applied (e.g. after import), the operation is a no-op.",
            "description_kind": "markdown",
            "optional": true
          },
          "deletion_protection": {
            "type": "bool",
            "description": "Whether to enable deletion protection. Valid values are: true or false. Default is true",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "endpoint_allowed_accounts": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of cloud accounts (aws, azure, or gcp projects) that are allowed to access the service. Works only with `privateconnect` endpoint mechanism",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "endpoint_mechanism": {
            "type": "string",
            "description": "The endpoint mechanism to use. Valid values are: privateconnect or nlb",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "endpoint_service": {
            "type": "string",
            "description": "The endpoint service name of the service, when mechanism is a privateconnect.",
            "description_kind": "plain",
            "computed": true
          },
          "fqdn": {
            "type": "string",
            "description": "The fully qualified domain name of the service. The FQDN is only available when the service is in the ready state",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the service",
            "description_kind": "plain",
            "computed": true
          },
          "is_active": {
            "type": "bool",
            "description": "Whether the service is active",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "maxscale_nodes": {
            "type": "number",
            "description": "The number of MaxScale nodes",
            "description_kind": "plain",
            "optional": true
          },
          "maxscale_size": {
            "type": "string",
            "description": "The size of the MaxScale nodes. Valid values are: sky-2x4, sky-2x8 etc",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the service",
            "description_kind": "plain",
            "required": true
          },
          "nodes": {
            "type": "number",
            "description": "The number of nodes",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "nosql_enabled": {
            "type": "bool",
            "description": "Whether to enable NoSQL. Valid values are: true or false",
            "description_kind": "plain",
            "optional": true
          },
          "primary_host": {
            "type": "string",
            "description": "The primary host of the service",
            "description_kind": "plain",
            "optional": true
          },
          "project_id": {
            "type": "string",
            "description": "The ID of the project to create the service in",
            "description_kind": "plain",
            "optional": true
          },
          "region": {
            "type": "string",
            "description": "The region to create the service in. Value should be valid for a specific cloud provider",
            "description_kind": "plain",
            "required": true
          },
          "replication_enabled": {
            "type": "bool",
            "description": "Whether to enable global replication. Valid values are: true or false. Works for xpand-direct topology only",
            "description_kind": "plain",
            "optional": true
          },
          "service_type": {
            "type": "string",
            "description": "The type of service to create. Valid values are: analytical or transactional",
            "description_kind": "plain",
            "required": true
          },
          "size": {
            "type": "string",
            "description": "The size of the service. Valid values are: sky-2x4, sky-2x8 etc",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ssl_enabled": {
            "type": "bool",
            "description": "Whether to enable SSL. Valid values are: true or false",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "storage": {
            "type": "number",
            "description": "The storage size in GB. Valid values are: 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tags": {
            "type": [
              "map",
              "string"
            ],
            "description": "User-defined tags for the service. Use tags.name to set a display name (the API sets this to the service name by default on creation). Only the tag keys you specify here are tracked in Terraform state; any server-injected tags are ignored.",
            "description_kind": "plain",
            "optional": true
          },
          "topology": {
            "type": "string",
            "description": "The topology of the service. Valid values are: standalone, masterslave, es-single, es-replica, galera, and serverless-standalone",
            "description_kind": "plain",
            "required": true
          },
          "version": {
            "type": "string",
            "description": "The software version",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "volume_iops": {
            "type": "number",
            "description": "The volume IOPS. This is only applicable for AWS",
            "description_kind": "plain",
            "optional": true
          },
          "volume_throughput": {
            "type": "number",
            "description": "The volume Throughput. This is only applicable for AWS",
            "description_kind": "plain",
            "optional": true
          },
          "volume_type": {
            "type": "string",
            "description": "The volume type. Valid values are: gp3 and io1. This is only applicable for AWS",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "wait_for_creation": {
            "type": "bool",
            "description": "Whether to wait for the service to be created. Valid values are: true or false",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "wait_for_deletion": {
            "type": "bool",
            "description": "Whether to wait for the service to be deleted. Valid values are: true or false",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "wait_for_update": {
            "type": "bool",
            "description": "Whether to wait for the service to be updated. Valid values are: true or false",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Creates and manages a service in SkySQL",
        "description_kind": "plain"
      }
    }
  },
