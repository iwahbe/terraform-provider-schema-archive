{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "MKE API Endpoint address with schema; e.g. https://my.mke.com",
          "description_kind": "markdown",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "MKE API user password",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "unsafe_ssl_client": {
          "type": "bool",
          "description": "Bypass SSL validation for hte API server. Use only for development systems",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "MKE API username",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "mke_clientbundle": {
      "version": 0,
      "block": {
        "attributes": {
          "ca_cert": {
            "type": "string",
            "description": "MKE Server CA certificate",
            "description_kind": "markdown",
            "computed": true
          },
          "client_cert": {
            "type": "string",
            "description": "MKE Client certificate for the user",
            "description_kind": "markdown",
            "computed": true
          },
          "docker_host": {
            "type": "string",
            "description": "MKE Docker swarm endpoint",
            "description_kind": "markdown",
            "computed": true
          },
          "docker_skiptlsverify": {
            "type": "bool",
            "description": "MKE Docker endpoint TLS should not be verified",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique ID",
            "description_kind": "markdown",
            "computed": true
          },
          "kube_host": {
            "type": "string",
            "description": "MKE Kubernetes API host endpoint",
            "description_kind": "markdown",
            "computed": true
          },
          "kube_skiptlsverify": {
            "type": "bool",
            "description": "MKE Kubernetes endpoint TLS should not be verified",
            "description_kind": "markdown",
            "computed": true
          },
          "kube_yaml": {
            "type": "string",
            "description": "MKE Kubernetes API client configuration yaml file",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "label": {
            "type": "string",
            "description": "Label used for the client bundle",
            "description_kind": "markdown",
            "required": true
          },
          "orchestrator": {
            "type": "string",
            "description": "Stack Orchestrator for the MKE instance, either 'docker' for docker-swarm, 'kubernetes', or 'all'",
            "description_kind": "markdown",
            "computed": true
          },
          "private_key": {
            "type": "string",
            "description": "MKE Private key for the user",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "public_key": {
            "type": "string",
            "description": "MKE Public key for the user",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Client Bundle resource for access to MKE api/kubernetes/docker-swarm features.",
        "description_kind": "markdown"
      }
    },
    "mke_user": {
      "version": 0,
      "block": {
        "attributes": {
          "full_name": {
            "type": "string",
            "description": "The full name of the user",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "is_active": {
            "type": "bool",
            "description": "Is the user active",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "is_admin": {
            "type": "bool",
            "description": "Is the user an admin",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the user",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "The password of the user",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "User resource",
        "description_kind": "markdown"
      }
    }
  }
}
