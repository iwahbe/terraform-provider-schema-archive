{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "server_url": {
          "type": "string",
          "description": "Server URL (defaults to http://localhost:9090)",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "SnowMirror API: This document is a guide which will walk you through SnowMirror REST API. \nThe purpose of the REST API is to allow developers to integrate SnowMirror with other applications.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "snowmirror_setting": {
      "version": 0,
      "block": {
        "attributes": {
          "options": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Parsed as JSON.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Setting Resource",
        "description_kind": "markdown"
      }
    },
    "snowmirror_synchronization": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "true - synchronization is active and can be scheduled to synchronize data from ServiceNow\nfalse - synchronization is deactivated and cannot be scheduled to synchronize data from ServiceNowNow          ",
            "description_kind": "markdown",
            "optional": true
          },
          "allow_inherited_columns": {
            "type": "bool",
            "description": "SnowMirror checks if columns exist in ServiceNow. If this flag is set to true,",
            "description_kind": "plain",
            "optional": true
          },
          "auto_schema_update": {
            "type": "bool",
            "description": "Configures how to check for schema changes in ServiceNow.\n\nEnabled (true) - whenever a synchronization is executed, SnowMirror checks for schema changes in ServiceNow. Automatically adds, updates (data type, max. length of a column) and removes columns. If a new column is added SnowMirror clears the mirror table and downloads all records from scratch.\nEnabled (no truncation) (ENABLED_WITHOUT_TRUNCATION) - the same as Enabled option. It handles new columns differently, though. If a new column is added SnowMirror does not clear the mirror table. Instead, it creates the column and populates it with a default value (which is defined in ServiceNow).\n",
            "description_kind": "markdown",
            "optional": true
          },
          "columns": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true
          },
          "columns_to_exclude": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true
          },
          "delete_strategy": {
            "type": "string",
            "description": "must be one of [\"AUDIT\", \"TRUNCATE\", \"DIFF\", \"NONE\"]",
            "description_kind": "plain",
            "optional": true
          },
          "encoded_query": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "full_load_scheduler": {
            "nested_type": {
              "attributes": {
                "begin_date": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "execution_type": {
                  "type": "string",
                  "description": "must be one of [\"CLEAN_AND_SYNCHRONIZE\", \"DIFFERENTIAL.\"]",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "must be one of [\"MANUALLY\", \"DAILY\", \"WEEKLY\", \"PERIODICALLY\", \"CRON\"]",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "Sync ID",
            "description_kind": "plain",
            "computed": true
          },
          "mirror_table": {
            "type": "string",
            "description": "Name of the table in mirror database where the data will be migrated.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the synchronization.",
            "description_kind": "plain",
            "required": true
          },
          "reference_field_type": {
            "type": "string",
            "description": "Defines how to synchronize reference field types.",
            "description_kind": "plain",
            "optional": true
          },
          "run_immediately": {
            "type": "bool",
            "description": "Determines whether initial synchronization should be done",
            "description_kind": "plain",
            "optional": true
          },
          "scheduler": {
            "nested_type": {
              "attributes": {
                "begin_date": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "must be one of [\"MANUALLY\", \"DAILY\", \"WEEKLY\", \"PERIODICALLY\", \"CRON\"]\nSpecifies when the incremental load synchronization will run",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          },
          "scheduler_priority": {
            "type": "string",
            "description": "must be one of [\"HIGHEST\", \"HIGH\", \"NORMAL\", \"LOW\", \"LOWEST\"]",
            "description_kind": "plain",
            "optional": true
          },
          "table": {
            "type": "string",
            "description": "Name of the table in ServiceNow.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "view": {
            "type": "string",
            "description": "Name of the view in ServiceNow.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Synchronization Resource",
        "description_kind": "markdown"
      }
    }
  },
