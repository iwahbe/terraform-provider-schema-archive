{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "token": {
          "type": "string",
          "description": "Application token to communicate with the Discord Application API. Can be a bot token or an OAuth Bearer token",
          "description_kind": "plain",
          "required": true
        }
      },
      "description": "Interact with Discord's Application API",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "discord-application_command": {
      "version": 0,
      "block": {
        "attributes": {
          "application_id": {
            "type": "string",
            "description": "The application ID that the command belongs to",
            "description_kind": "plain",
            "required": true
          },
          "command_id": {
            "type": "string",
            "description": "The ID of the command",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description of the command - displayed in discord",
            "description_kind": "plain",
            "required": true
          },
          "last_updated": {
            "type": "string",
            "description": "The last time the command was updated",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the command - matches the command a user would type in discord",
            "description_kind": "plain",
            "required": true
          },
          "options": {
            "nested_type": {
              "attributes": {
                "choices": {
                  "nested_type": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "The choice's name",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value": {
                        "type": "string",
                        "description": "The choice's value",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "The choices for the option",
                  "description_kind": "plain",
                  "optional": true
                },
                "description": {
                  "type": "string",
                  "description": "The option's description",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "The option's name / value",
                  "description_kind": "plain",
                  "required": true
                },
                "required": {
                  "type": "bool",
                  "description": "Whether the option is required",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "number",
                  "description": "The type of command - see discord application API documentation for more info. Currently restricted to types 1, 3, 4, 5, and 10",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The options for the command",
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "number",
            "description": "The type of command - see discord application API documentation for more info",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Discord application command",
        "description_kind": "markdown"
      }
    },
    "discord-application_interactions_endpoint": {
      "version": 0,
      "block": {
        "attributes": {
          "application_id": {
            "type": "string",
            "description": "The ID of the application to update",
            "description_kind": "plain",
            "required": true
          },
          "interactions_endpoint_url": {
            "type": "string",
            "description": "The URL to set as the interactions endpoint URL. Note: the API will attempt to call the provided url so the endpoint must exist and be reachable",
            "description_kind": "plain",
            "required": true
          },
          "last_updated": {
            "type": "string",
            "description": "The last time the application was updated",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Sets the discord application's interactions endpoint. Only one can be set per application",
        "description_kind": "markdown"
      }
    }
  }
}
