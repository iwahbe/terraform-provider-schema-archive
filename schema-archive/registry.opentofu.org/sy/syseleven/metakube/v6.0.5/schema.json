{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "debug": {
          "type": "bool",
          "description": "Run debug mode.",
          "description_kind": "plain",
          "optional": true
        },
        "development": {
          "type": "bool",
          "description": "Run development mode.",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "The hostname of MetaKube API (in form of URI)",
          "description_kind": "plain",
          "optional": true
        },
        "log_path": {
          "type": "string",
          "description": "Path to store logs",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The MetaKube authentication token",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "token_path": {
          "type": "string",
          "description": "Path to the MetaKube authentication token, defaults to ~/.metakube/auth",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "metakube_cluster": {
      "version": 2,
      "block": {
        "attributes": {
          "creation_timestamp": {
            "type": "string",
            "description": "Creation timestamp",
            "description_kind": "plain",
            "computed": true
          },
          "dc_name": {
            "type": "string",
            "description": "Data center name",
            "description_kind": "plain",
            "required": true
          },
          "deletion_timestamp": {
            "type": "string",
            "description": "Deletion timestamp",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Cluster identifier",
            "description_kind": "plain",
            "computed": true
          },
          "kube_config": {
            "type": "string",
            "description": "Kubeconfig for the cluster",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "kube_login_kube_config": {
            "type": "string",
            "description": "Kubelogin Kubeconfig for the cluster",
            "description_kind": "plain",
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Labels added to cluster",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Cluster name",
            "description_kind": "plain",
            "required": true
          },
          "oidc_kube_config": {
            "type": "string",
            "description": "OIDC Kubeconfig for the cluster",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "project_id": {
            "type": "string",
            "description": "Reference project identifier",
            "description_kind": "plain",
            "required": true
          },
          "spec": {
            "nested_type": {
              "attributes": {
                "audit_logging": {
                  "type": "bool",
                  "description": "Whether to enable audit logging or not",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "cloud": {
                  "nested_type": {
                    "attributes": {
                      "openstack": {
                        "nested_type": {
                          "attributes": {
                            "application_credentials": {
                              "nested_type": {
                                "attributes": {
                                  "id": {
                                    "type": "string",
                                    "description": "Openstack application credentials ID",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true
                                  },
                                  "secret": {
                                    "type": "string",
                                    "description": "Openstack application credentials secret",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true,
                                    "sensitive": true
                                  }
                                },
                                "nesting_mode": "single"
                              },
                              "description_kind": "plain",
                              "optional": true
                            },
                            "floating_ip_pool": {
                              "type": "string",
                              "description": "The floating ip pool used by all worker nodes to receive a public ip",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "network": {
                              "type": "string",
                              "description": "When specified, all worker nodes will be attached to this network. If not specified, a network, subnet & router will be created.",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "security_group": {
                              "type": "string",
                              "description": "When specified, all worker nodes will be attached to this security group. If not specified, a security group will be created",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "server_group_id": {
                              "type": "string",
                              "description": "Server group to use for all machines within a cluster",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "subnet_cidr": {
                              "type": "string",
                              "description": "Change this to configure a different internal IP range for Nodes. Default: 192.168.1.0/24",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "subnet_id": {
                              "type": "string",
                              "description": "When specified, all worker nodes will be attached to this subnet of specified network. If not specified, a network, subnet & router will be created.",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "user_credentials": {
                              "nested_type": {
                                "attributes": {
                                  "password": {
                                    "type": "string",
                                    "description": "The openstack account's password",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true,
                                    "sensitive": true
                                  },
                                  "project_id": {
                                    "type": "string",
                                    "description": "The id of openstack project",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true
                                  },
                                  "project_name": {
                                    "type": "string",
                                    "description": "The name of openstack project",
                                    "description_kind": "plain",
                                    "deprecated": true,
                                    "optional": true,
                                    "computed": true
                                  },
                                  "username": {
                                    "type": "string",
                                    "description": "The openstack account's username",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true,
                                    "sensitive": true
                                  }
                                },
                                "nesting_mode": "single"
                              },
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description": "OpenStack cluster specification",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Cloud provider specification",
                  "description_kind": "plain",
                  "required": true
                },
                "cni_plugin": {
                  "nested_type": {
                    "attributes": {
                      "cilium": {
                        "nested_type": {
                          "attributes": {
                            "clustermesh": {
                              "nested_type": {
                                "attributes": {
                                  "cluster_id": {
                                    "type": "number",
                                    "description": "Set cilium cluster ID",
                                    "description_kind": "plain",
                                    "optional": true
                                  },
                                  "enable": {
                                    "type": "bool",
                                    "description": "Enale clustermesh",
                                    "description_kind": "plain",
                                    "optional": true
                                  },
                                  "ipv4_native_routing_cidr": {
                                    "type": "string",
                                    "description": "Set ipv4 native routing cidr",
                                    "description_kind": "plain",
                                    "optional": true
                                  }
                                },
                                "nesting_mode": "single"
                              },
                              "description_kind": "plain",
                              "optional": true
                            },
                            "enable_hubble": {
                              "type": "bool",
                              "description": "Enable Hubble relay",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "enable_l7_proxy": {
                              "type": "bool",
                              "description": "Enable L7 Proxy",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description": "Cilium clustermesh",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "type": {
                        "type": "string",
                        "description": "Define the type of CNI plugin. Defaults to canal if not specified.",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Contains the spec of the CNI plugin used by the Cluster. Defaults to canal if not specified.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "enable_ssh_agent": {
                  "type": "bool",
                  "description": "SSH Agent as a daemon running on each node that can manage ssh keys. Disable it if you want to manage keys manually",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "ip_family": {
                  "type": "string",
                  "description": "Represents IP address family to use for the Cluster",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "pod_node_selector": {
                  "type": "bool",
                  "description": "Configure PodNodeSelector admission plugin at the apiserver",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "pod_security_policy": {
                  "type": "bool",
                  "description": "Pod security policies allow detailed authorization of pod creation and updates",
                  "description_kind": "plain",
                  "deprecated": true,
                  "optional": true,
                  "computed": true
                },
                "pods_cidr": {
                  "type": "string",
                  "description": "Internal IP range for Pods",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "services_cidr": {
                  "type": "string",
                  "description": "Internal IP range for ClusterIP Services",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "syseleven_auth": {
                  "nested_type": {
                    "attributes": {
                      "iam_authentication": {
                        "type": "bool",
                        "description": "Enable Authentication against Syseleven IAM system",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "realm": {
                        "type": "string",
                        "description": "Realm name",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Configuration of SysEleven Login over OpenID Connect to authenticate against this cluster",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "update_window": {
                  "nested_type": {
                    "attributes": {
                      "length": {
                        "type": "string",
                        "description": "Node reboot window duration",
                        "description_kind": "plain",
                        "required": true
                      },
                      "start": {
                        "type": "string",
                        "description": "Node reboot window start time",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Flatcar nodes reboot window",
                  "description_kind": "plain",
                  "optional": true
                },
                "version": {
                  "type": "string",
                  "description": "Cloud orchestrator version, either Kubernetes or OpenShift",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Cluster specification",
            "description_kind": "plain",
            "required": true
          },
          "sshkeys": {
            "type": [
              "set",
              "string"
            ],
            "description": "SSH keys attached to nodes",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Cluster resource in MetaKube",
        "description_kind": "plain"
      }
    },
    "metakube_cluster_role_binding": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "The id of the cluster resource belongs to",
            "description_kind": "plain",
            "required": true
          },
          "cluster_role_name": {
            "type": "string",
            "description": "The name of the cluster role to bind to",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The id of the cluster role binding resource",
            "description_kind": "plain",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "The id of the project resource belongs to",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "subject": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "kind": {
                  "type": "string",
                  "description": "Can be either 'user' or 'group'",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "Subject name",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Users and groups to bind for",
              "description_kind": "plain"
            }
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "metakube_maintenance_cron_job": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster that maintenance cron job belongs to",
            "description_kind": "plain",
            "required": true
          },
          "creation_timestamp": {
            "type": "string",
            "description": "Creation timestamp",
            "description_kind": "plain",
            "computed": true
          },
          "deletion_timestamp": {
            "type": "string",
            "description": "Deletion timestamp",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The id of the maintenance cron job resource",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Maintenance cron job name",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Reference project identifier",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "spec": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "schedule": {
                  "type": "string",
                  "description": "A schedule in cron format",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "maintenance_job_template": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "rollback": {
                        "type": "bool",
                        "description": "Indicates whether the maintenance done should be rolled back",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "type": {
                        "type": "string",
                        "description": "Defines the type of maintenance that should be run",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "block_types": {
                      "options": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "options": {
                              "type": [
                                "map",
                                "string"
                              ],
                              "description": "Map of string keys and values that can be used to set certain options for the given maintenance type.",
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "description": "Options for the maintenance type",
                          "description_kind": "plain"
                        }
                      }
                    },
                    "description": "MaintenanceJob template specification",
                    "description_kind": "plain"
                  }
                }
              },
              "description": "Maintenance cron job specification",
              "description_kind": "plain"
            }
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "metakube_node_deployment": {
      "version": 2,
      "block": {
        "attributes": {
          "cluster_id": {
            "type": "string",
            "description": "Cluster that node deployment belongs to",
            "description_kind": "plain",
            "required": true
          },
          "creation_timestamp": {
            "type": "string",
            "description": "Creation timestamp",
            "description_kind": "plain",
            "computed": true
          },
          "deletion_timestamp": {
            "type": "string",
            "description": "Deletion timestamp",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the node deployment",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Node deployment name",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Project the cluster belongs to",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "spec": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "max_replicas": {
                  "type": "number",
                  "description": "Maximum number of replicas to scale up",
                  "description_kind": "plain",
                  "optional": true
                },
                "min_replicas": {
                  "type": "number",
                  "description": "Minimum number of replicas to downscale",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "replicas": {
                  "type": "number",
                  "description": "Number of replicas",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "block_types": {
                "template": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "all_labels": {
                        "type": [
                          "map",
                          "string"
                        ],
                        "description": "All labels on the node deployment, including user-specified labels and system-managed labels (system/cluster, system/project, etc.) added by the server.",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "labels": {
                        "type": [
                          "map",
                          "string"
                        ],
                        "description": "Map of string keys and values that can be used to organize and categorize (scope and select) objects. It will be applied to Nodes allowing users run their apps on specific Node using labelSelector. Note: The server may add additional system labels (system/cluster, system/project) which are available in the `all_labels` attribute.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "machine_annotations": {
                        "type": [
                          "map",
                          "string"
                        ],
                        "description": "Map of annotations to set on machine objects.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "node_annotations": {
                        "type": [
                          "map",
                          "string"
                        ],
                        "description": "Map of annotations to set on nodes.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "block_types": {
                      "cloud": {
                        "nesting_mode": "list",
                        "block": {
                          "block_types": {
                            "openstack": {
                              "nesting_mode": "list",
                              "block": {
                                "attributes": {
                                  "disk_size": {
                                    "type": "number",
                                    "description": "If set, the rootDisk will be a cinder volume of that size in GiB. If unset, the rootDisk will be ephemeral nova root storage and its size will be derived from the flavor",
                                    "description_kind": "plain",
                                    "optional": true
                                  },
                                  "flavor": {
                                    "type": "string",
                                    "description": "Instance type",
                                    "description_kind": "plain",
                                    "required": true
                                  },
                                  "image": {
                                    "type": "string",
                                    "description": "Image to use",
                                    "description_kind": "plain",
                                    "required": true
                                  },
                                  "instance_ready_check_period": {
                                    "type": "string",
                                    "description": "Specifies how often should the controller check if instance is ready before timing out",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true
                                  },
                                  "instance_ready_check_timeout": {
                                    "type": "string",
                                    "description": "Specifies how long should the controller check if instance is ready before timing out",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true
                                  },
                                  "server_group_id": {
                                    "type": "string",
                                    "description": "Specifies the ID of the server group for nodes in the nodes deployment. Defaults to the cluster setting",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true
                                  },
                                  "tags": {
                                    "type": [
                                      "map",
                                      "string"
                                    ],
                                    "description": "Additional instance tags. Keys matching reserved prefix patterns are ignored in this attribute.",
                                    "description_kind": "plain",
                                    "optional": true,
                                    "computed": true
                                  },
