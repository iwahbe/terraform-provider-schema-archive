{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "auth_method": {
          "type": "string",
          "description": "Hypercore Computing authentication method; can also be set with `HC_AUTH_METHOD` environment variable. It can be set to `oidc` or `local` (default).",
          "description_kind": "markdown",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "Hypercore Computing host URI; can also be set with `HC_HOST` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Hypercore Computing password; can also be set with `HC_PASSWORD` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "timeout": {
          "type": "number",
          "description": "Hypercore Computing request timeout; can also be set with `HC_TIMEOUT` environment variable. Default is set to `60.0` seconds.",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Hypercore Computing username; can also be set with `HC_USERNAME` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Terraform Provider for [Scale Computing](https://www.scalecomputing.com/) [HyperCore](https://www.scalecomputing.com/sc-hypercore) product.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "hypercore_disk": {
      "version": 0,
      "block": {
        "attributes": {
          "flash_priority": {
            "type": "number",
            "description": "SSD tiering priority factor for block placement. If not provided, it will default to `4`, unless imported, in which case the disk's current flash priority will be taken into account and can then be modified. This can be any **positive** value between (including) `0` and `11`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Disk identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "iso_uuid": {
            "type": "string",
            "description": "ISO UUID we want to attach to the disk, only available with disk type `IDE_CDROM`.",
            "description_kind": "markdown",
            "optional": true
          },
          "size": {
            "type": "number",
            "description": "Disk size in `GB`. Must be larger than the current size of the disk if specified.",
            "description_kind": "markdown",
            "optional": true
          },
          "slot": {
            "type": "number",
            "description": "Disk slot number. Will not do anything if the disk already exists, since HC3 doesn't change disk slots to existing disks.",
            "description_kind": "markdown",
            "computed": true
          },
          "source_virtual_disk_id": {
            "type": "string",
            "description": "UUID of the virtual disk to use to clone and attach to the VM.",
            "description_kind": "markdown",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Disk type. Can be: `IDE_DISK`, `IDE_CDROM`, `SCSI_DISK`, `VIRTIO_DISK`, `IDE_FLOPPY`, `NVRAM`, `VTPM`",
            "description_kind": "markdown",
            "optional": true
          },
          "vm_uuid": {
            "type": "string",
            "description": "VM UUID.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Hypercore disk resource to manage VM disks. <br><br>To use this resource, it's recommended to set the environment variable `TF_CLI_ARGS_apply=\"-parallelism=1\"` or pass the `-parallelism` parameter to the `terraform apply`.<br><br> Removing disk from a running VM is (often) not possible. In this case it is required to shutdown the VM before disk removal.",
        "description_kind": "markdown"
      }
    },
    "hypercore_iso": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ISO identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Desired name of the ISO to upload. ISO name must end with '.iso'.",
            "description_kind": "markdown",
            "required": true
          },
          "source_url": {
            "type": "string",
            "description": "Source URL from where to fetch that disk from. URL can start with: `http://`, `https://`, `file:///`",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Hypercore ISO resource to manage ISO images. <br><br>To use this resource, it's recommended to set the environment variable `TF_CLI_ARGS_apply=\"-parallelism=1\"` or pass the `-parallelism` parameter to the `terraform apply`.",
        "description_kind": "markdown"
      }
    },
    "hypercore_nic": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "NIC identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "mac_address": {
            "type": "string",
            "description": "NIC MAC address.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "NIC type. Can be: `VIRTIO`, `INTEL_E1000`, `RTL8139`",
            "description_kind": "markdown",
            "required": true
          },
          "vlan": {
            "type": "number",
            "description": "NIC VLAN.",
            "description_kind": "markdown",
            "required": true
          },
          "vm_uuid": {
            "type": "string",
            "description": "VM UUID.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Hypercore NIC resource to manage VM NICs. <br><br>To use this resource, it's recommended to set the environment variable `TF_CLI_ARGS_apply=\"-parallelism=1\"` or pass the `-parallelism` parameter to the `terraform apply`.",
        "description_kind": "markdown"
      }
    },
    "hypercore_virtual_disk": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Virtual disk identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Desired name of the virtual disk to upload.",
            "description_kind": "markdown",
            "required": true
          },
          "source_url": {
            "type": "string",
            "description": "Source URL from where to fetch that disk from. URL can start with: `http://`, `https://`, `file:///`",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Hypercore virtual disk resource to manage VM virtual disks",
        "description_kind": "markdown"
      }
    },
    "hypercore_vm": {
      "version": 0,
      "block": {
        "attributes": {
          "affinity_strategy": {
            "nested_type": {
              "attributes": {
                "backup_node_uuid": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "preferred_node_uuid": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "strict_affinity": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "clone": {
            "nested_type": {
              "attributes": {
                "meta_data": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "preserve_mac_address": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "source_vm_uuid": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "user_data": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Clone options if the VM is being created as a clone. The `source_vm_uuid` is the UUID of the VM used for cloning, <br>`user_data` and `meta_data` are used for the cloud init data.",
            "description_kind": "markdown",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Description of this VM",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "HypercoreVM identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "import": {
            "nested_type": {
              "attributes": {
                "file_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "http_uri": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "password": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "path": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "server": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "username": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Options for importing a VM through a SMB server or some other HTTP location. <br>Use server, username, password for SMB or http_uri for some other HTTP location. Parameters path and file_name are always **required**",
            "description_kind": "markdown",
            "optional": true
          },
          "memory": {
            "type": "number",
            "description": "Memory (RAM) size in `MiB`: If the cloned VM was already created <br>and it's memory was modified, the cloned VM will be rebooted (either gracefully or forcefully)",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of this VM",
            "description_kind": "markdown",
            "required": true
          },
          "snapshot_schedule_uuid": {
            "type": "string",
            "description": "UUID of the snapshot schedule to create automatic snapshots",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of tags to create this VM in",
            "description_kind": "markdown",
            "optional": true
          },
          "vcpu": {
            "type": "number",
            "description": "Number of CPUs on this VM. If the cloned VM was already created and it's <br>`VCPU` was modified, the cloned VM will be rebooted (either gracefully or forcefully)",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "HypercoreVM resource to create a VM from a template VM\n\nA running VM might need to shutdown to apply required changes.\nIn this case first a nice ACPI shutdown is tried.\nIf the VM does not stop, a force shutdown is tried.\nIn both cases the provider waits up to HC_VM_SHUTDOWN_TIMEOUT seconds for the VM to shutdown.\nHC_VM_SHUTDOWN_TIMEOUT dafault value is 300 seconds.\nHC_VM_SHUTDOWN_TIMEOUT can be changed via environ.\n\nThe provider will currently try to shutdown VM only before VM delete.",
        "description_kind": "markdown"
      }
    },
    "hypercore_vm_boot_order": {
      "version": 0,
      "block": {
        "attributes": {
          "boot_devices": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of UUIDs of disks and NICs, in the order that they will boot",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Boot order identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "vm_uuid": {
            "type": "string",
            "description": "VM UUID of which we want to set the boot order.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Hypercore VM boot order resource to manage VM boot devices' order",
        "description_kind": "markdown"
      }
    },
    "hypercore_vm_power_state": {
      "version": 0,
      "block": {
        "attributes": {
          "force_shutoff": {
            "type": "bool",
            "description": "Set to `true` if you want to put the VM into the `SHUTOFF` state by force. This option will only be taken into account when `state` is set to `SHUTOFF`. Default is `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Power state identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "state": {
            "type": "string",
            "description": "Desired power state of the VM. Can be: `SHUTOFF`, `RUNNING`, `PAUSED`",
            "description_kind": "markdown",
            "required": true
          },
          "vm": {
            "nested_type": {
              "attributes": {
                "affinity_strategy": {
                  "type": [
                    "object",
                    {
                      "backup_node_uuid": "string",
                      "preferred_node_uuid": "string",
                      "strict_affinity": "bool"
                    }
                  ],
                  "description": "VM node affinity.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "description": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "disks": {
                  "nested_type": {
                    "attributes": {
                      "size": {
                        "type": "number",
                        "description": "size",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "slot": {
                        "type": "number",
                        "description": "slot",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "type": {
                        "type": "string",
                        "description": "type",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "uuid": {
                        "type": "string",
                        "description": "UUID",
                        "description_kind": "markdown",
                        "computed": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "List of disks",
                  "description_kind": "markdown",
                  "computed": true
                },
                "memory": {
                  "type": "number",
                  "description": "Memory (RAM) size in MiB",
                  "description_kind": "markdown",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "nics": {
                  "nested_type": {
                    "attributes": {
                      "ipv4_addresses": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "IPv4 addresses",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "mac_address": {
                        "type": "string",
                        "description": "MAC address",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "type": {
                        "type": "string",
                        "description": "type",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "uuid": {
                        "type": "string",
                        "description": "UUID",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "vlan": {
                        "type": "number",
                        "description": "vlan",
                        "description_kind": "markdown",
                        "computed": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "List of NICs",
                  "description_kind": "markdown",
                  "computed": true
                },
                "power_state": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "snapshot_schedule_uuid": {
                  "type": "string",
                  "description": "UUID of the applied snapshot schedule for creating automated snapshots",
                  "description_kind": "markdown",
                  "computed": true
                },
                "tags": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "uuid": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "vcpu": {
                  "type": "number",
                  "description": "Number of CPUs",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "VM details.",
            "description_kind": "markdown",
            "computed": true
          },
          "vm_uuid": {
            "type": "string",
            "description": "VM UUID of which we want to set the power state.",
            "description_kind": "markdown",
            "required": true
          },
          "wait_for_guest_net_timeout": {
            "type": "number",
            "description": "Set to non-zero value to wait on guest OS to report guest IP address to hypervisor.<br>The guest OS needs to have guest tools installed (qemu-guest-agent).",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Hypercore disk resource to manage VM disks",
        "description_kind": "markdown"
      }
    },
    "hypercore_vm_replication": {
      "version": 0,
      "block": {
        "attributes": {
          "connection_uuid": {
            "type": "string",
            "description": "Remote connection UUID",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "enable": {
            "type": "bool",
            "description": "Enable or disable replication",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Replication identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Human-readable label describing the replication purpose",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "target_vm_uuid": {
            "type": "string",
            "description": "Remote target VM UUID",
            "description_kind": "markdown",
            "computed": true
          },
          "vm_uuid": {
            "type": "string",
            "description": "VM UUID of which we want to make a replication",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Hypercore VM replication resource to manage VM boot devices' order",
        "description_kind": "markdown"
      }
    },
    "hypercore_vm_snapshot": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "VM snapshot identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Snapshot label.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Snapshot type. Can be: USER, AUTOMATED, SUPPORT",
            "description_kind": "markdown",
            "computed": true
          },
          "vm_uuid": {
            "type": "string",
            "description": "VM UUID of which we want to create a snapshot.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Hypercore VM snapshot resource to manage VM snapshots",
        "description_kind": "markdown"
      }
    },
    "hypercore_vm_snapshot_schedule": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Snapshot schedule identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Snapshot schedule name.",
            "description_kind": "markdown",
            "required": true
          },
          "rules": {
            "nested_type": {
              "attributes": {
                "frequency": {
                  "type": "string",
                  "description": "Frequency based on RFC-2445 (FREQ=MINUTELY;INTERVAL=5)",
                  "description_kind": "markdown",
                  "required": true
                },
                "local_retention_seconds": {
                  "type": "number",
                  "description": "Number of seconds before snapshots are removed",
                  "description_kind": "markdown",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "Rule name",
                  "description_kind": "markdown",
                  "required": true
                },
                "remote_retention_seconds": {
                  "type": "number",
                  "description": "Number of seconds before snapshots are removed. If not set, it'll be the same as `local_retention_seconds`",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "start_timestamp": {
                  "type": "string",
                  "description": "Local timezone timestamp (2010-01-01 00:00:00) of when a snapshot is to be taken",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Scheduled snapshot rules.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Hypercore VM snapshot schedule resource to manage VM snapshots",
        "description_kind": "markdown"
      }
    }
  },
