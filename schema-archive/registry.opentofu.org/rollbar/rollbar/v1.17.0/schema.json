          "optional": true
        },
        "project_api_key": {
          "type": "string",
          "description": "Rollbar API authentication token (project level). Value will be sourced from environment variable `ROLLBAR_PROJECT_API_KEY` if set.",
          "description_kind": "plain",
          "optional": true
