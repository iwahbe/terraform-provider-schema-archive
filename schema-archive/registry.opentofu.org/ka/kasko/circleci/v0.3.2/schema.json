{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "Token to use to authenticate to CircleCI.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "circleci_project": {
      "version": 0,
      "block": {
        "attributes": {
          "account": {
            "type": "string",
            "description": "This is the GitHub or Bitbucket project account (organization) name for the target project (not your personal GitHub or Bitbucket username).",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "project": {
            "type": "string",
            "description": "This is the GitHub or Bitbucket project (repository) name.",
            "description_kind": "plain",
            "required": true
          },
          "vcs_type": {
            "type": "string",
            "description": "Version control system type your project uses.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "variable": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
