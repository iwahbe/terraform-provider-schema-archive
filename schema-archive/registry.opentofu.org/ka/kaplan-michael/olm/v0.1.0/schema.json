{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "ca_certificate": {
          "type": "string",
          "description": "Kubernetes API server CA certificate",
          "description_kind": "markdown",
          "optional": true
        },
        "client_certificate": {
          "type": "string",
          "description": "Kubernetes API server client certificate",
          "description_kind": "markdown",
          "optional": true
        },
        "client_key": {
          "type": "string",
          "description": "Kubernetes API server client key",
          "description_kind": "markdown",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "Kubernetes API server host",
          "description_kind": "markdown",
          "optional": true
        },
        "kubeconfig": {
          "type": "string",
          "description": "Kubeconfig raw file",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "olm_v0_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the OLM resource",
            "description_kind": "markdown",
            "computed": true
          },
          "namespace": {
            "type": "string",
            "description": "The namespace where to install olm",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "version": {
            "type": "string",
            "description": "OLM version to install v0 only",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Resource for managing Kubernetes namespaces",
        "description_kind": "markdown"
      }
    },
    "olm_v0_operator": {
      "version": 0,
      "block": {
        "attributes": {
          "channel": {
            "type": "string",
            "description": "The update channel to use for the Operator",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the Operator",
            "description_kind": "markdown",
            "computed": true
          },
          "install_plan_approval": {
            "type": "string",
            "description": "The update approval strategy for the Operator install default is AutomaticValid values are Automatic, Manual, but if you set Manual, the provider will not be able to install",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the Operator",
            "description_kind": "markdown",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "The namespace where to install the Operator",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "source": {
            "type": "string",
            "description": "The source catalog of the Operator",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "source_namespace": {
            "type": "string",
            "description": "The namespace where the Operator source catalog is installed",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Resource for managing Kubernetes namespaces",
        "description_kind": "markdown"
      }
    }
  }
