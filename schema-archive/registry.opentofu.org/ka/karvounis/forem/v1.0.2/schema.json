{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API key to be able to communicate with the FOREM API. Environment variable: `FOREM_API_KEY`.",
          "description_kind": "markdown",
          "required": true
        },
        "host": {
          "type": "string",
          "description": "Host of the FOREM API. Environment variable: `FOREM_HOST`. Defaults to: `https://dev.to/api`.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "forem_article": {
      "version": 0,
      "block": {
        "attributes": {
          "body_markdown": {
            "type": "string",
            "description": "The body of the article in Markdown format.",
            "description_kind": "markdown",
            "required": true
          },
          "canonical_url": {
            "type": "string",
            "description": "Canonical URL of the article.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "comments_count": {
            "type": "number",
            "description": "Number of comments.",
            "description_kind": "markdown",
            "computed": true
          },
          "cover_image": {
            "type": "string",
            "description": "URL of the cover image of the article.",
            "description_kind": "markdown",
            "optional": true
          },
          "created_at": {
            "type": "string",
            "description": "When the listing was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Article description.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "flare_tag": {
            "type": [
              "map",
              "string"
            ],
            "description": "Flare tag object of the article.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ID of the article.",
            "description_kind": "markdown",
            "computed": true
          },
          "organization": {
            "type": [
              "map",
              "string"
            ],
            "description": "Organization object of the article.",
            "description_kind": "markdown",
            "computed": true
          },
          "organization_id": {
            "type": "number",
            "description": "Only users belonging to an organization can assign the article to it.",
            "description_kind": "markdown",
            "optional": true
          },
          "page_views_count": {
            "type": "number",
            "description": "Number of views.",
            "description_kind": "markdown",
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Path of the article URL.",
            "description_kind": "markdown",
            "computed": true
          },
          "positive_reactions_count": {
            "type": "number",
            "description": "Number of positive reactions.",
            "description_kind": "markdown",
            "computed": true
          },
          "public_reactions_count": {
            "type": "number",
            "description": "Number of public reactions.",
            "description_kind": "markdown",
            "computed": true
          },
          "published": {
            "type": "bool",
            "description": "Set to `true` to create a published article. Defaults to: `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "published_at": {
            "type": "string",
            "description": "When the article was published.",
            "description_kind": "markdown",
            "computed": true
          },
          "published_timestamp": {
            "type": "string",
            "description": "When the article was published.",
            "description_kind": "markdown",
            "computed": true
          },
          "reading_time_minutes": {
            "type": "number",
            "description": "Article reading time in minutes.",
            "description_kind": "markdown",
            "computed": true
          },
          "series": {
            "type": "string",
            "description": "Article series name. All articles belonging to the same series need to have the same name in this parameter.",
            "description_kind": "markdown",
            "optional": true
          },
          "slug": {
            "type": "string",
            "description": "Slug of the article.",
            "description_kind": "markdown",
            "computed": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of tags related to the article. Maximum items: `4`.",
            "description_kind": "markdown",
            "optional": true
          },
          "title": {
            "type": "string",
            "description": "Title of the article.",
            "description_kind": "markdown",
            "required": true
          },
          "updated_at": {
            "type": "string",
            "description": "When the listing was updated.",
            "description_kind": "markdown",
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "Full article URL.",
            "description_kind": "markdown",
            "computed": true
          },
          "user": {
            "type": [
              "map",
              "string"
            ],
            "description": "User object of the article.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "`forem_article` resource creates and updates a particular article.\n\n## API Docs\n\n- https://developers.forem.com/api#operation/createArticle\n- https://developers.forem.com/api#operation/updateArticle",
        "description_kind": "markdown"
      }
    },
    "forem_listing": {
      "version": 0,
      "block": {
        "attributes": {
          "action": {
            "type": "string",
            "description": "Set it to `draft` to create an unpublished listing.",
            "description_kind": "markdown",
            "optional": true
          },
          "body_markdown": {
            "type": "string",
            "description": "The body of the listing in Markdown format.",
            "description_kind": "markdown",
            "required": true
          },
          "category": {
            "type": "string",
            "description": "The category that the listing belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "contact_via_connect": {
            "type": "bool",
            "description": "True if users are allowed to contact the listing's owner via DEV connect, false otherwise. Defaults to: `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "created_at": {
            "type": "string",
            "description": "When the listing was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "expires_at": {
            "type": "string",
            "description": "Date and time of expiration.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the listing.",
            "description_kind": "markdown",
            "computed": true
          },
          "location": {
            "type": "string",
            "description": "Geographical area or city for the listing.",
            "description_kind": "markdown",
            "optional": true
          },
          "organization": {
            "type": [
              "map",
              "string"
            ],
            "description": "Organization object of the listing.",
            "description_kind": "markdown",
            "computed": true
          },
          "organization_id": {
            "type": "number",
            "description": "The id of the organization the user is creating the listing for. Only users belonging to an organization can assign the listing to it.",
            "description_kind": "markdown",
            "optional": true
          },
          "published": {
            "type": "bool",
            "description": "Whether the listing is published or not.",
            "description_kind": "markdown",
            "computed": true
          },
          "slug": {
            "type": "string",
            "description": "Slug of the listing.",
            "description_kind": "markdown",
            "computed": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of tags related to the listing. Maximum items: `8`.",
            "description_kind": "markdown",
            "optional": true
          },
          "title": {
            "type": "string",
            "description": "Title of the listing.",
            "description_kind": "markdown",
            "required": true
          },
          "updated_at": {
            "type": "string",
            "description": "When the listing was updated.",
            "description_kind": "markdown",
            "computed": true
          },
          "user": {
            "type": [
              "map",
              "string"
            ],
            "description": "User object of the listing.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "`forem_listing` resource creates and updates a particular listing. A listing is a classified ad that users create on Forem. They can be related to conference announcements, job offers, mentorships, upcoming events and more.\n\n## API Docs\n\n- https://developers.forem.com/api#operation/createListing\n- https://developers.forem.com/api#operation/updateListing",
        "description_kind": "markdown"
      }
    }
  },
