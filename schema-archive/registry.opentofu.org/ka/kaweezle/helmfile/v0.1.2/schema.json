{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "additional_plugins": {
          "nested_type": {
            "attributes": {
              "name": {
                "type": "string",
                "description": "Name of the helm plugin.",
                "description_kind": "markdown",
                "required": true
              },
              "repo": {
                "type": "string",
                "description": "The URL of the plugin repository.",
                "description_kind": "markdown",
                "required": true
              },
              "version": {
                "type": "string",
                "description": "Version of the plugin",
                "description_kind": "markdown",
                "required": true
              }
            },
            "nesting_mode": "list"
          },
          "description": "List of additional helm plugins to install.",
          "description_kind": "markdown",
          "optional": true
        },
        "default_args": {
          "type": [
            "list",
            "string"
          ],
          "description": "List of default arguments to pass to every helmfile command.",
          "description_kind": "markdown",
          "optional": true
        },
        "disable_force_update": {
          "type": "bool",
          "description": "do not force helm repos to update when executing \"helm repo add\"",
          "description_kind": "markdown",
          "optional": true
        },
        "enforce_plugin_verification": {
          "type": "bool",
          "description": "enforce helm plugin verification when installing missing plugins",
          "description_kind": "markdown",
          "optional": true
        },
        "env_vars": {
          "type": [
            "map",
            "string"
          ],
          "description": "Environment variables to set for helmfile operations.",
          "description_kind": "markdown",
          "optional": true
        },
        "environment": {
          "type": "string",
          "description": "Specify the environment name. Defaults to 'default'.",
          "description_kind": "markdown",
          "optional": true
        },
        "helm_binary_path": {
          "type": "string",
          "description": "Path to the helm binary. If not set, the provider will look for 'helm' in the system PATH.",
          "description_kind": "markdown",
          "optional": true
        },
        "helm_oci_plain_http": {
          "type": "bool",
          "description": "allow using plain HTTP when pulling charts from OCI registries",
          "description_kind": "markdown",
          "optional": true
        },
        "kubeconfig": {
          "type": "string",
          "description": "Use a particular kubeconfig file.",
          "description_kind": "markdown",
          "optional": true
        },
        "kustomize_binary_path": {
          "type": "string",
          "description": "Path to the kustomize binary. If not set, the provider will look for 'kustomize' in the system PATH.",
          "description_kind": "markdown",
          "optional": true
        },
        "log_level": {
          "type": "string",
          "description": "Set log level for helmfile operations. Valid values are: trace, debug, info, warn, error. Default is info.",
          "description_kind": "markdown",
          "optional": true
        },
        "perform_init": {
          "type": "bool",
          "description": "Whether to run 'helmfile init' before applying any helmfile operations.",
          "description_kind": "markdown",
          "optional": true
        },
        "skip_deps": {
          "type": "bool",
          "description": "skip running \"helm repo update\" and \"helm dependency build\"",
          "description_kind": "markdown",
          "optional": true
        },
        "skip_refresh": {
          "type": "bool",
          "description": "skip running 'helmfile repos' before applying any helmfile operations.",
          "description_kind": "markdown",
          "optional": true
        },
        "strip_args_values_on_exit_error": {
          "type": "bool",
          "description": "Strip the potential secret values of the helm command args contained in a helmfile error message (default true)",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Helmfile provider configures the Helmfile CLI tool for managing Helm charts deployments.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "helmfile_release": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_no_matching_release": {
            "type": "bool",
            "description": "Do not exit with an error code if the provided selector has no matching releases.",
            "description_kind": "markdown",
            "optional": true
          },
          "args": {
            "type": [
              "list",
              "string"
            ],
            "description": "Pass args to helm exec.",
            "description_kind": "markdown",
            "optional": true
          },
          "cascade": {
            "type": "string",
            "description": "Pass cascade to helm exec, default: background.",
            "description_kind": "markdown",
            "optional": true
          },
          "chart": {
            "type": "string",
            "description": "Set chart. Uses the chart set in release by default.",
            "description_kind": "markdown",
            "optional": true
          },
          "concurrency": {
            "type": "number",
            "description": "Maximum number of concurrent helm processes to run, 0 is unlimited.",
            "description_kind": "markdown",
            "optional": true
          },
          "context": {
            "type": "number",
            "description": "Output NUM lines of context around changes.",
            "description_kind": "markdown",
            "optional": true
          },
          "debug": {
            "type": "bool",
            "description": "Enable verbose output for Helm and set log-level to debug.",
            "description_kind": "markdown",
            "optional": true
          },
          "destroy": {
            "nested_type": {
              "attributes": {
                "cascade": {
                  "type": "string",
                  "description": "'--cascade' to helm delete, available values: background, foreground, or orphan, default: background",
                  "description_kind": "markdown",
                  "optional": true
                },
                "concurrency": {
                  "type": "number",
                  "description": "do not force helm repos to update when executing \"helm repo add\"",
                  "description_kind": "markdown",
                  "optional": true
                },
                "skip_charts": {
                  "type": "bool",
                  "description": "makes Destroy skip `withPreparedCharts`",
                  "description_kind": "markdown",
                  "optional": true
                },
                "timeout": {
                  "type": "number",
                  "description": "adds --timeout to helm uninstall commands",
                  "description_kind": "markdown",
                  "optional": true
                },
                "wait": {
                  "type": "bool",
                  "description": "adds --wait to helm uninstall commands",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Destroy configuration",
            "description_kind": "markdown",
            "optional": true
          },
          "detailed_exitcode": {
            "type": "bool",
            "description": "Return a non-zero exit code 2 instead of 0 when there were changes detected AND the changes are synced successfully.",
            "description_kind": "markdown",
            "optional": true
          },
          "diff_args": {
            "type": "string",
            "description": "Pass args to helm helm-diff.",
            "description_kind": "markdown",
            "optional": true
          },
          "enforce_needs_are_installed": {
            "type": "bool",
            "description": "When using --selector/-l, enforce that the selected releases' needs are also installed.",
            "description_kind": "markdown",
            "optional": true
          },
          "env_vars": {
            "type": [
              "map",
              "string"
            ],
            "description": "Environment variables to set for helmfile operations.",
            "description_kind": "markdown",
            "optional": true
          },
          "environment": {
            "type": "string",
            "description": "Specify the environment name. Defaults to 'default'.",
            "description_kind": "markdown",
            "optional": true
          },
          "file_or_path": {
            "type": "string",
            "description": "The path to the helmfile.yaml file or directory containing helmfile.yaml files.",
            "description_kind": "markdown",
            "required": true
          },
          "hide_notes": {
            "type": "bool",
            "description": "Add --hide-notes flag to helm.",
            "description_kind": "markdown",
            "optional": true
          },
          "include_needs": {
            "type": "bool",
            "description": "Automatically include releases from the target release's 'needs' when --selector/-l flag is provided.",
            "description_kind": "markdown",
            "optional": true
          },
          "include_tests": {
            "type": "bool",
            "description": "Enable the diffing of the helm test hooks.",
            "description_kind": "markdown",
            "optional": true
          },
          "include_transitive_needs": {
            "type": "bool",
            "description": "Like --include-needs, but also includes transitive needs (needs of needs).",
            "description_kind": "markdown",
            "optional": true
          },
          "kube_context": {
            "type": "string",
            "description": "Set kubectl context. Uses current context by default.",
            "description_kind": "markdown",
            "optional": true
          },
          "kubeconfig": {
            "type": "string",
            "description": "Use a particular kubeconfig file.",
            "description_kind": "markdown",
            "optional": true
          },
          "log_level": {
            "type": "string",
            "description": "Set log level, default info.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the Helm release.",
            "description_kind": "markdown",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "Set namespace. Uses the namespace set in the context by default.",
            "description_kind": "markdown",
            "optional": true
          },
          "no_hooks": {
            "type": "bool",
            "description": "Do not diff changes made by hooks.",
            "description_kind": "markdown",
            "optional": true
          },
          "output": {
            "type": "string",
            "description": "Output format for diff plugin.",
            "description_kind": "markdown",
            "optional": true
          },
          "overrides": {
            "nested_type": {
              "attributes": {
                "disable_force_update": {
                  "type": "bool",
                  "description": "do not force helm repos to update when executing \"helm repo add\"",
                  "description_kind": "markdown",
                  "optional": true
                },
                "enforce_plugin_verification": {
                  "type": "bool",
                  "description": "Enforce plugin verification for Helm.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "helm_binary_path": {
                  "type": "string",
                  "description": "Path to the helm binary. If not set, the provider will look for 'helm' in the system PATH.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "helm_oci_plain_http": {
                  "type": "bool",
                  "description": "allow using plain HTTP when pulling charts from OCI registries",
                  "description_kind": "markdown",
                  "optional": true
                },
                "kustomize_binary_path": {
                  "type": "string",
                  "description": "Path to the kustomize binary. If not set, the provider will look for 'kustomize' in the system PATH.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "skip_deps": {
                  "type": "bool",
                  "description": "skip running \"helm repo update\" and \"helm dependency build\"",
                  "description_kind": "markdown",
                  "optional": true
                },
                "skip_refresh": {
                  "type": "bool",
                  "description": "skip running 'helmfile repos' before applying any helmfile operations.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "strip_args_values_on_exit_error": {
                  "type": "bool",
                  "description": "Strip the potential secret values of the helm command args contained in a helmfile error message (default true)",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Provider override attributes",
            "description_kind": "markdown",
            "optional": true
          },
          "post_renderer": {
            "type": "string",
            "description": "Pass --post-renderer to 'helm template' or 'helm upgrade --install'.",
            "description_kind": "markdown",
            "optional": true
          },
          "post_renderer_args": {
            "type": [
              "list",
              "string"
            ],
            "description": "Pass --post-renderer-args to 'helm template' or 'helm upgrade --install'.",
            "description_kind": "markdown",
            "optional": true
          },
          "releases_list": {
            "nested_type": {
              "attributes": {
                "chart": {
                  "type": "string",
                  "description": "The chart of the Helm release.",
                  "description_kind": "markdown",
                  "required": true
                },
                "enabled": {
                  "type": "bool",
                  "description": "Is the Helm release enabled.",
                  "description_kind": "markdown",
                  "required": true
                },
                "installed": {
                  "type": "bool",
                  "description": "Is the Helm release to be installed.",
                  "description_kind": "markdown",
                  "required": true
                },
                "labels": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "The labels of the Helm release.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the Helm release.",
                  "description_kind": "markdown",
                  "required": true
                },
                "namespace": {
                  "type": "string",
                  "description": "The namespace of the Helm release.",
                  "description_kind": "markdown",
                  "required": true
                },
                "version": {
                  "type": "string",
                  "description": "The version of the Helm release.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of releases",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "reset_values": {
            "type": "bool",
            "description": "Override helmDefaults.reuseValues 'helm upgrade --install --reset-values'.",
            "description_kind": "markdown",
            "optional": true
          },
          "reuse_values": {
            "type": "bool",
            "description": "Override helmDefaults.reuseValues 'helm upgrade --install --reuse-values'.",
            "description_kind": "markdown",
            "optional": true
          },
          "selectors": {
            "type": [
              "list",
              "string"
            ],
            "description": "Only run using the releases that match labels. Labels can take the form of foo=bar or foo!=bar.",
            "description_kind": "markdown",
            "optional": true
          },
          "set": {
            "type": [
              "list",
              "string"
            ],
            "description": "Additional values to be merged into the helm command --set flag.",
            "description_kind": "markdown",
            "optional": true
          },
          "sha256_checksum": {
            "type": "string",
            "description": "The SHA256 checksum of the Helmfile release.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "show_secrets": {
            "type": "bool",
            "description": "Do not redact secret values in the diff output. Should be used for debug purpose only.",
            "description_kind": "markdown",
            "optional": true
          },
          "skip_cleanup": {
            "type": "bool",
            "description": "Stop cleaning up temporary values generated by helmfile and helm-secrets. Useful for debugging.",
            "description_kind": "markdown",
            "optional": true
          },
          "skip_crds": {
            "type": "bool",
            "description": "If set, no CRDs will be installed on sync. By default, CRDs are installed if not already present.",
            "description_kind": "markdown",
            "optional": true
          },
          "skip_diff_on_install": {
            "type": "bool",
            "description": "Skips running helm-diff on releases being newly installed on this apply.",
            "description_kind": "markdown",
            "optional": true
          },
          "skip_needs": {
            "type": "bool",
            "description": "Do not automatically include releases from the target release's 'needs' when --selector/-l flag is provided.",
            "description_kind": "markdown",
            "optional": true
          },
          "skip_schema_validation": {
            "type": "bool",
            "description": "Pass --skip-schema-validation to 'helm template' or 'helm upgrade --install'.",
            "description_kind": "markdown",
            "optional": true
          },
          "state_values_files": {
            "type": [
              "list",
              "string"
            ],
            "description": "Specify state values in a YAML file. Used to override .Values within the helmfile template.",
            "description_kind": "markdown",
            "optional": true
          },
          "state_values_set": {
            "type": [
              "map",
              "string"
            ],
            "description": "Set state values on the command line. Used to override .Values within the helmfile template.",
            "description_kind": "markdown",
            "optional": true
          },
          "state_values_set_string": {
            "type": [
              "list",
              "string"
            ],
            "description": "Set state STRING values on the command line. Used to override .Values within the helmfile template.",
            "description_kind": "markdown",
            "optional": true
          },
          "strip_trailing_cr": {
            "type": "bool",
            "description": "Strip trailing carriage return on input.",
            "description_kind": "markdown",
            "optional": true
          },
          "suppress": {
            "type": [
              "list",
              "string"
            ],
            "description": "Suppress specified Kubernetes objects in the diff output. Can be provided multiple times.",
            "description_kind": "markdown",
            "optional": true
          },
          "suppress_diff": {
            "type": "bool",
            "description": "Suppress diff in the output. Usable in new installs.",
            "description_kind": "markdown",
            "optional": true
          },
          "suppress_output_line_regex": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of regex patterns to suppress output lines from the diff output.",
            "description_kind": "markdown",
            "optional": true
          },
          "suppress_secrets": {
            "type": "bool",
            "description": "Suppress secrets in the diff output. Highly recommended to specify on CI/CD use-cases.",
            "description_kind": "markdown",
            "optional": true
          },
          "sync_args": {
            "type": "string",
            "description": "Pass args to helm upgrade.",
            "description_kind": "markdown",
            "optional": true
          },
          "sync_release_labels": {
            "type": "bool",
            "description": "Sync release labels to the target release.",
            "description_kind": "markdown",
            "optional": true
          },
          "take_ownership": {
            "type": "bool",
            "description": "Add --take-ownership flag to helm.",
            "description_kind": "markdown",
            "optional": true
          },
          "validate": {
            "type": "bool",
            "description": "Validate your manifests against the Kubernetes cluster you are currently pointing at.",
            "description_kind": "markdown",
            "optional": true
          },
          "values": {
            "type": [
              "list",
              "string"
            ],
            "description": "Additional value files to be merged into the helm command --values flag.",
            "description_kind": "markdown",
            "optional": true
          },
          "wait": {
            "type": "bool",
            "description": "Override helmDefaults.wait setting 'helm upgrade --install --wait'.",
            "description_kind": "markdown",
            "optional": true
          },
          "wait_for_jobs": {
            "type": "bool",
            "description": "Override helmDefaults.waitForJobs setting 'helm upgrade --install --wait-for-jobs'.",
            "description_kind": "markdown",
            "optional": true
          },
          "wait_retries": {
            "type": "number",
            "description": "Override helmDefaults.waitRetries setting 'helm upgrade --install --wait --wait-retries'.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages a Helm release defined in a Helmfile.",
        "description_kind": "plain"
      }
    }
  }
}
