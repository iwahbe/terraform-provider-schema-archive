    "imagefactory_template": {
      "version": 0,
      "block": {
        "attributes": {
          "cloud_provider": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "distribution_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "state": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "config": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "cloud_account_ids": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "disable_cyclical_rebuilds": {
                  "type": "bool",
                  "description": "Disable cyclical rebuilds. Cyclical rebuilds are rebuilds that are triggered automatically by ImageFactory when the source image is updated or when there are security updates available for the packages installed in the image. If cyclical rebuilds are disabled, the template will not be rebuilt automatically and the user will have to trigger the rebuild manually. Default value is set to false.",
                  "description_kind": "plain",
                  "optional": true
                },
                "scope": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "block_types": {
                "aws": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "custom_image_name": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "ebs_volume_type": {
                        "type": "string",
                        "description": "The type of the EBS volume of primary block device. Available types are `gp2`, `gp3`. If not specified, volume type is used from the source image.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "kms_key_id": {
                        "type": "string",
                        "description": "The ID of the AWS KMS key that is used to encrypt the destination snapshot of the copied image. To allow use of this key, onboarded master role `ImageFactoryMasterRole` must have permission to use the key. You can use key ID, key ARN, alias name, or alias ARN.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "region": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "block_types": {
                      "additional_ebs_volumes": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "device_name": {
                              "type": "string",
                              "description": "Device name for the EBS volume. Available names for Linux are `/dev/sd[b-z]`, for Windows `xvd[b-z]`",
                              "description_kind": "plain",
                              "required": true
                            },
                            "size": {
                              "type": "number",
                              "description": "EBS volume size between 1 and 10 GB.",
                              "description_kind": "plain",
                              "required": true
                            },
                            "volume_type": {
                              "type": "string",
                              "description": "The type of the EBS volume. Available types are `gp2`, `gp3`. If not specified, `gp2` is used by default.",
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "description_kind": "plain"
                        },
                        "max_items": 10
                      }
                    },
                    "description_kind": "plain"
                  }
                },
                "azure": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "create_managed_image": {
                        "type": "bool",
                        "description": "Enable to create an additional legacy managed image, apart from the default image that will be created in Azure Compute Gallery.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "disable_vhd_cleanup": {
                        "type": "bool",
                        "description": "VHD cleanup is a process that removes the VHD files that are created during the image build process. If VHD cleanup is disabled, the VHD files will not be removed and will remain in the storage account. Default value is set to false.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "enable_nvme_controller": {
                        "type": "bool",
                        "description": "Enable NVMe controller for the image.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "eol_date_option": {
                        "type": "bool",
                        "description": "Default value is set to true",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "exclude_from_latest": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "replica_regions": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description_kind": "plain",
                        "optional": true
                      },
                      "trusted_launch": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "block_types": {
                      "additional_data_disks": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "size": {
                              "type": "number",
                              "description": "Data disk size between 1 and 10 GB.",
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "description_kind": "plain"
                        },
                        "max_items": 10
                      },
                      "additional_signatures": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "variable_name": {
                              "type": "string",
                              "description": "The name of the Customer Variable that is used to store the UEFI key.",
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "description": "Additional UEFI keys that are used to validate the boot loader. This feature allows you to bind UEFI keys for driver/kernel modules that are signed by using a private key that's owned by third-party vendors.",
                          "description_kind": "plain"
                        }
                      },
                      "vm_image_definition": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "name": {
                              "type": "string",
                              "description_kind": "plain",
                              "required": true
                            },
                            "offer": {
                              "type": "string",
                              "description_kind": "plain",
                              "required": true
                            },
                            "sku": {
                              "type": "string",
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "description_kind": "plain"
                        }
                      }
                    },
                    "description_kind": "plain"
                  }
                },
                "build_components": {
