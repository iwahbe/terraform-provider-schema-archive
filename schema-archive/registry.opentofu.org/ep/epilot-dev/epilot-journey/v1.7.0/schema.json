          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "server_url": {
          "type": "string",
          "description": "Server URL (defaults to https://journey-config.sls.epilot.io)",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Journey API: API to configure journeys",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "epilot-journey_journey": {
      "version": 0,
      "block": {
        "attributes": {
          "brand_id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "context_schema": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier for the context schema item",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "is_required": {
                  "type": "bool",
                  "description": "Indicates if a value is expected to be provided",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "param_key": {
                  "type": "string",
                  "description": "Expected key to be received in the context. Not Null",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "should_load_entity": {
                  "type": "bool",
                  "description": "If type is not text, we can instruct the journey to fetch the entity id we receive as value",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "Type of the parameter. It could be either an entity slug, or a text. Not Null",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "design": {
            "nested_type": {
              "attributes": {
                "design_tokens": {
                  "nested_type": {
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "logo_url": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "theme": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "journey_id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "journey_type": {
            "type": "string",
            "description": "Journey Template",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "logics": {
            "type": "string",
            "description": "Parsed as JSON.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "logics_v4": {
            "type": "string",
            "description": "Parsed as JSON.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "manifest": {
            "type": [
              "list",
              "string"
            ],
            "description": "Manifest/Blueprint ID used to create/update the entity",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "protected": {
            "type": "bool",
            "description": "If true, journey is displayed in read-only mode",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "protected_editable": {
            "type": [
              "list",
              "string"
            ],
            "description": "Whitelist of paths that remain editable when the journey is protected. Supports wildcard patterns (e.g. steps/*/blocks/**).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "rules": {
            "nested_type": {
              "attributes": {
                "source": {
                  "type": "string",
                  "description": "Not Null",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "source_type": {
                  "type": "string",
                  "description": "Not Null; must be one of [\"journey\", \"step\", \"block\"]",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "target": {
                  "type": "string",
                  "description": "Not Null",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "Not Null; must be one of [\"inject\", \"injectWithKey\"]",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "settings": {
            "nested_type": {
              "attributes": {
                "access_mode": {
                  "type": "string",
                  "description": "must be one of [\"PUBLIC\", \"PRIVATE\"]",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "address_suggestions_country_code": {
                  "type": "string",
                  "description": "Country code for address format (e.g. DE, AT, CH, LU)",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "address_suggestions_enable_auto_complete": {
                  "type": "bool",
                  "description": "Whether address auto-complete is enabled",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "address_suggestions_enable_free_text": {
                  "type": "bool",
                  "description": "Whether free text input is allowed when auto-complete is on",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "address_suggestions_file_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "address_suggestions_file_url": {
                  "type": "string",
                  "description": "@deprecated Use addressSuggestionsFileId instead",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "address_suggestions_source": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Sources for address auto-complete (e.g. deutschePostService, customAddressesFile)",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "description": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "design_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "embed_options": {
                  "nested_type": {
                    "attributes": {
                      "button": {
                        "nested_type": {
                          "attributes": {
                            "align": {
                              "type": "string",
                              "description": "must be one of [\"left\", \"center\", \"right\"]",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            },
                            "text": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true,
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "lang": {
                        "type": "string",
                        "description": "must be one of [\"de\", \"en\", \"fr\"]",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "mode": {
                        "type": "string",
                        "description": "must be one of [\"full-screen\", \"inline\"]",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "scroll_to_top": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "top_bar": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      },
                      "width": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "enable_dark_mode": {
                  "type": "bool",
                  "description": "If true, the journey shows an icon to toggle dark mode",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "entity_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "entity_tags": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "file_purposes": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "is_active": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "mappings_automation_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "public_token": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "runtime_entities": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "safe_mode_automation": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "targeted_customer": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "template_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "third_party_cookies": {
                  "type": "bool",
                  "description": "If false, third-party cookies are disabled to comply with GDPR regulations without asking for consent.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "use_new_design": {
                  "type": "bool",
                  "description": "This property is deprecated and will be removed in a future version",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "steps": {
            "type": "string",
            "description": "Parsed as JSON.",
            "description_kind": "plain",
            "required": true
          },
          "validation_rules": {
            "type": "string",
            "description": "Parsed as JSON.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Journey Resource",
        "description_kind": "markdown"
      }
    }
