{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "helloasso_azure_pat": {
      "version": 0,
      "block": {
        "attributes": {
          "app_client_id": {
            "type": "string",
            "description": "Client ID of registered app",
            "description_kind": "markdown",
            "required": true
          },
          "app_client_secret": {
            "type": "string",
            "description": "WIP (not supported): Client secret of registered app (to be set if is_app_registration_public=false)",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "authority": {
            "type": "string",
            "description": "AzureAD authority URL",
            "description_kind": "markdown",
            "required": true
          },
          "az_cli_switch_private_app_public": {
            "type": "bool",
            "description": "This is a dirty workaround to be able to use confidential app with public flow\n\t\t\t\t\t\t\t\t\t\tto be used with 'is_app_registration_public = true'\n\t\t\t\t\t\t\t\t\t\tif true, we will call local AZ CLI to switch app public while getting token, after put back to private\n\t\t\t\t\t\t\t\t\t\tdefault: false",
            "description_kind": "markdown",
            "optional": true
          },
          "az_cli_switch_private_app_public_wait_delay": {
            "type": "number",
            "description": "When 'az_cli_switch_private_app_public = true' delay to wait for change propagation before acquiring token, (default: 7)",
            "description_kind": "markdown",
            "optional": true
          },
          "azure_devops_password": {
            "type": "string",
            "description": "Password of Azure Devops user",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "azure_devops_pat_endpoint": {
            "type": "string",
            "description": "API endpoint to manage PATs",
            "description_kind": "markdown",
            "required": true
          },
          "azure_devops_pat_scopes": {
            "type": "string",
            "description": "Scopes of PAT token separated by a whitespace, see https://github.com/MicrosoftDocs/azure-devops-docs/blob/main/docs/integrate/includes/scopes.md",
            "description_kind": "markdown",
            "required": true
          },
          "azure_devops_user": {
            "type": "string",
            "description": "Username of Azure Devops user",
            "description_kind": "markdown",
            "required": true
          },
          "is_app_registration_public": {
            "type": "bool",
            "description": "Is app registration managing authent public or confidential, if false need to set 'app_client_secret'\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tWarning WIP: must be 'true' as confidential app is not supported for now",
            "description_kind": "markdown",
            "optional": true
          },
          "pat": {
            "type": "string",
            "description": "PAT token",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "pat_id": {
            "type": "string",
            "description": "PAT ID",
            "description_kind": "markdown",
            "computed": true
          },
          "pat_name": {
            "type": "string",
            "description": "Name of PAT to create",
            "description_kind": "markdown",
            "required": true
          },
          "rotate_when_changed": {
            "type": "string",
            "description": "Arbitrary map of values that, when changed, will trigger rotation of the PAT",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Example resource",
        "description_kind": "markdown"
      }
    }
  }
}
