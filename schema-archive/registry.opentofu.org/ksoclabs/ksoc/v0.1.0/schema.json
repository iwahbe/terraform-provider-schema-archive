{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key_id": {
          "type": "string",
          "description": "Ksoc Customer Access ID",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "ksoc_api_url": {
          "type": "string",
          "description": "Ksoc API to target. Defaults to https://api.ksoc.com",
          "description_kind": "markdown",
          "optional": true
        },
        "secret_key": {
          "type": "string",
          "description": "Ksoc Customer Secret Key",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ksoc_aws_register": {
      "version": 0,
      "block": {
        "attributes": {
          "api_path": {
            "type": "string",
            "description": "Target of the API path",
            "description_kind": "markdown",
            "computed": true
          },
          "aws_account_id": {
            "type": "string",
            "description": "Ksoc Customer AWS account ID",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ksoc_assumed_role_arn": {
            "type": "string",
            "description": "Ksoc Role to Trust",
            "description_kind": "markdown",
            "required": true
          },
          "ksoc_registered": {
            "type": "bool",
            "description": "Target of the API path",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Register AWS account with Ksoc",
        "description_kind": "markdown"
      }
    },
    "ksoc_azure_register": {
      "version": 0,
      "block": {
        "attributes": {
          "api_path": {
            "type": "string",
            "description": "Target of the API path",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ksoc_registered": {
            "type": "bool",
            "description": "Target of the API path",
            "description_kind": "markdown",
            "computed": true
          },
          "subscription_id": {
            "type": "string",
            "description": "Subscription ID to use",
            "description_kind": "markdown",
            "required": true
          },
          "tenant_id": {
            "type": "string",
            "description": "Azure Tenant to use when gathering resources",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Register Azure Subscription and Tenant with Ksoc",
        "description_kind": "markdown"
      }
    }
  }
}
