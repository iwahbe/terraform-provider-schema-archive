{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Lambda API key to use",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "lambdalabs_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "file_system_names": {
            "type": [
              "list",
              "string"
            ],
            "description": "Names of the file systems to attach to the instances. Currently, only one (if any) file system may be specified.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "id of the instance",
            "description_kind": "plain",
            "computed": true
          },
          "instance_type_name": {
            "type": "string",
            "description": "Name of an instance type",
            "description_kind": "plain",
            "required": true
          },
          "ip": {
            "type": "string",
            "description": "ip address of the instance",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "User-provided name for the instance",
            "description_kind": "plain",
            "optional": true
          },
          "region_name": {
            "type": "string",
            "description": "Short name of a region",
            "description_kind": "plain",
            "required": true
          },
          "ssh_key_names": {
            "type": [
              "list",
              "string"
            ],
            "description": "Names of the SSH keys to allow access to the instances. Currently, exactly one SSH key must be specified.",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "description of the instance",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Instance resource",
        "description_kind": "markdown"
      }
    },
    "lambdalabs_sshkey": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Unique Identifier (ID) of an SSH key.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the SSH key.",
            "description_kind": "markdown",
            "required": true
          },
          "private_key": {
            "type": "string",
            "description": "Private key for the SSH key. Only returned when generating a new key pair.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "public_key": {
            "type": "string",
            "description": "Public key for the ssk key.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          }
        },
        "description": "Example resource",
        "description_kind": "markdown"
      }
    }
  }
