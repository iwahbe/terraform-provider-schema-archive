{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "baseurl": {
          "type": "string",
          "description": "GoDaddy Base Url(defaults to production).",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "key": {
          "type": "string",
          "description": "GoDaddy API Key.",
          "description_kind": "plain",
          "required": true
        },
        "secret": {
          "type": "string",
          "description": "GoDaddy API Secret.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description": "The godaddy domain provider is used to interact with the godaddy to manage domains from it. The provider needs to be configured with the proper credentials before it can be used.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "st-godaddy_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "auto_renew_years": {
            "type": "number",
            "description": "Number of years to register and renew. The default is `1`. A value of less than `0` means that the domain will never be auto renewed.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "contact": {
            "type": "string",
            "description": "Contact info in json format",
            "description_kind": "plain",
            "required": true
          },
          "domain": {
            "type": "string",
            "description": "Domain name to manage in NameCheap",
            "description_kind": "plain",
            "required": true
          },
          "min_days_remaining": {
            "type": "number",
            "description": "The minimum amount of days remaining on the expiration of a domain before a renewal is attempted. The default is `30`. A value of less than `0` means that the domain will never be renewed.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manage a domain in Godaddy",
        "description_kind": "plain"
      }
    }
  }
}
