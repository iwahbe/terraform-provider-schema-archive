{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "file": {
          "type": "string",
          "description": "Path to the file to store IPAM state in",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ipam_allocation": {
      "version": 0,
      "block": {
        "attributes": {
          "cidr": {
            "type": "string",
            "description": "Allocation CIDR",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Allocation identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "pool_id": {
            "type": "string",
            "description": "Pool identifier",
            "description_kind": "markdown",
            "required": true
          },
          "size": {
            "type": "number",
            "description": "Size of allocation",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "An IPAM Allocation represents an sub-ranges from previously defined IP Pool",
        "description_kind": "markdown"
      }
    },
    "ipam_pool": {
      "version": 0,
      "block": {
        "attributes": {
          "cidr": {
            "type": "string",
            "description": "CIDR to allocate from",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Pool identifier",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "An IPAM Pool represents an IP address range that sub-ranges can be allocated from",
        "description_kind": "markdown"
      }
    }
  }
}
