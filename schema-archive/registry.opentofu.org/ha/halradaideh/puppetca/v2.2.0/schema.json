{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "ca": {
          "type": "string",
          "description": "Puppet CA certificate",
          "description_kind": "plain",
          "optional": true
        },
        "cert": {
          "type": "string",
          "description": "Certificate to authenticate against Puppet CA",
          "description_kind": "plain",
          "optional": true
        },
        "key": {
          "type": "string",
          "description": "Private key to authenticate against Puppet CA",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "url": {
          "type": "string",
          "description": "URL of the Puppet CA",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "puppetca_certificate": {
      "version": 1,
      "block": {
        "attributes": {
          "cert": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "csr": {
            "type": "string",
            "description": "Certificate Signing Request (CSR) to be submitted to the Puppet server.",
            "description_kind": "plain",
            "optional": true
          },
          "env": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "sign": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "usedby": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours). Setting a timeout for a Delete operation is only applicable if changes are saved into state before the destroy operation occurs.",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
