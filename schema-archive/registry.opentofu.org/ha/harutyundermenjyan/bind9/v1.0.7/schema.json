            "type": "bool",
            "description": "Whether DNSSEC is enabled",
            "description_kind": "plain",
            "computed": true
          },
          "file": {
            "type": "string",
            "description": "Zone file path (auto-generated if not specified)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Zone identifier (same as name)",
            "description_kind": "plain",
            "computed": true
          },
          "loaded": {
            "type": "bool",
            "description": "Whether zone is loaded",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Zone name (e.g., example.com)",
            "description_kind": "plain",
            "required": true
          },
          "nameservers": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of authoritative nameservers",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "notify": {
            "type": "bool",
            "description": "Send NOTIFY to slaves on zone changes",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ns_addresses": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map of nameserver names to IP addresses for glue records (e.g., {\"ns1\" = \"192.168.1.1\"})",
            "description_kind": "plain",
            "optional": true
          },
          "serial": {
            "type": "number",
            "description": "Current zone serial number",
            "description_kind": "plain",
            "computed": true
          },
          "soa_expire": {
            "type": "number",
            "description": "SOA expire time in seconds",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "soa_minimum": {
            "type": "number",
            "description": "SOA minimum/negative TTL in seconds",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "soa_mname": {
            "type": "string",
            "description": "Primary nameserver for SOA record",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "soa_refresh": {
            "type": "number",
            "description": "SOA refresh interval in seconds",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "soa_retry": {
            "type": "number",
            "description": "SOA retry interval in seconds",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "soa_rname": {
            "type": "string",
            "description": "Responsible person email for SOA (use . instead of @)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Zone type: master, slave, forward, stub",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "\nManages a DNS zone on a BIND9 server.\n\n## Example Usage\n\n### Master Zone\n\n```hcl\nresource \"bind9_zone\" \"example\" {\n  name = \"example.com\"\n  type = \"master\"\n  \n  soa_mname  = \"ns1.example.com\"\n  soa_rname  = \"hostmaster.example.com\"\n  default_ttl = 3600\n  \n  nameservers = [\n    \"ns1.example.com\",\n    \"ns2.example.com\",\n  ]\n  \n  allow_transfer = [\"192.168.1.0/24\"]\n  notify = true\n}\n```\n\n### Slave Zone\n\n```hcl\nresource \"bind9_zone\" \"slave\" {\n  name = \"example.com\"\n  type = \"slave\"\n  \n  # Masters would be configured in BIND9 directly\n}\n```\n",
        "description_kind": "markdown"
      }
    }
  },
