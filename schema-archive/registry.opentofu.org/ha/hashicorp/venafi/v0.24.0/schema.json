{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_token": {
          "type": "string",
          "description": "Access token for CyberArk Certificate Manager, Self-Hosted, user should use this for authentication",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "api_key": {
          "type": "string",
          "description": "API key for CyberArk Certificate Manager, SaaS. Example: 142231b7-cvb0-412e-886b-6aeght0bc93d",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "client_id": {
          "type": "string",
          "description": "application that will be using the token",
          "description_kind": "plain",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "Client Secret for CyberArk Certificate Manager, Self-Hosted or Palo Alto Networks Next-Gen Trust Security (NGTS)",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "dev_mode": {
          "type": "bool",
          "description": "When set to true, the resulting certificate will be issued by an ephemeral, no trust CA rather than enrolling using CyberArk Certificate Manager, SaaS or CyberArk Certificate Manager, Self-Hosted. Useful for development and testing",
          "description_kind": "plain",
          "optional": true
        },
        "external_jwt": {
          "type": "string",
          "description": "JWT of the identity provider associated to the CyberArk Certificate Manager, SaaS service account that is granting the access token",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "p12_cert_data": {
          "type": "string",
          "description": "Base64 encoded PKCS#12 keystore containing a client certificate, private key, and chain certificates to authenticate to CyberArk Certificate Manager, Self-Hosted",
          "description_kind": "plain",
          "optional": true
        },
        "p12_cert_filename": {
          "type": "string",
          "description": "Filename of PKCS#12 keystore containing a client certificate, private key, and chain certificates to authenticate to CyberArk Certificate Manager, Self-Hosted",
          "description_kind": "plain",
          "optional": true
        },
        "p12_cert_password": {
          "type": "string",
          "description": "Password for the PKCS#12 keystore declared in p12_cert / p12_cert_data",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "skip_retirement": {
          "type": "bool",
          "description": "When true, certificates will not be retired on CyberArk platforms when terraform destroy is run. Default is false",
          "description_kind": "plain",
          "optional": true
        },
        "token_url": {
          "type": "string",
          "description": "Endpoint URL to request new CyberArk Certificate Manager, SaaS access tokens",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "tpp_password": {
          "type": "string",
          "description": "Password for WebSDK user. Example: password",
          "description_kind": "plain",
          "deprecated": true,
          "optional": true,
          "sensitive": true
        },
        "tpp_username": {
          "type": "string",
          "description": "WebSDK user for CyberArk Certificate Manager, Self-Hosted. Example: admin",
          "description_kind": "plain",
          "deprecated": true,
          "optional": true
        },
        "trust_bundle": {
          "type": "string",
          "description": "Use to specify a PEM-formatted file that contains certificates to be trust anchors for all communications with the CyberArk Web Service.\nExample:\n  trust_bundle = \"${file(\"chain.pem\")}\"",
          "description_kind": "plain",
          "optional": true
        },
        "tsg_id": {
          "type": "string",
          "description": "The Palo Alto Networks Next-Gen Trust Security (NGTS) TSG ID to use when issuing a token. Only used if platform is detected as 'ngts'",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "The CyberArk Platform URL. Example: https://cmsh.cyberark.example/vedsdk",
          "description_kind": "plain",
          "optional": true
        },
        "zone": {
          "type": "string",
          "description": "DN of the CyberArk Certificate Manager, Self-Hosted policy folder or name of the CyberArk Certificate Manager, SaaS application plus issuing template alias. \nExample for CyberArk Certificate Manager, Self-Hosted: testPolicy\\\\vault\nExample for CyberArk Certificate Manager, SaaS: myApp\\\\Default",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "venafi_certificate": {
      "version": 0,
      "block": {
        "attributes": {
          "algorithm": {
            "type": "string",
            "description": "Key encryption algorithm. RSA or ECDSA. RSA is default",
            "description_kind": "plain",
            "optional": true
          },
          "certificate": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "certificate_dn": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "certificate_id": {
            "type": "string",
            "description": "ID of the issued certificate",
            "description_kind": "plain",
            "computed": true
          },
          "chain": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "common_name": {
            "type": "string",
            "description": "Common name of the certificate",
            "description_kind": "plain",
            "required": true
          },
          "country": {
            "type": "string",
            "description": "Country of the certificate (C)",
            "description_kind": "plain",
            "optional": true
          },
          "csr_origin": {
            "type": "string",
            "description": "Origin of the CSR. One of local or service. Local: The CSR will be generated locally and sent over for certificate issuance. Service: The CSR will be generated and managed by the CyberArk platform. Default is local",
            "description_kind": "plain",
            "optional": true
          },
          "csr_pem": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "custom_fields": {
            "type": [
              "map",
              "string"
            ],
            "description": "Data map in the form key=\"value1|value2|...|valueN\", to be added to the certificate",
            "description_kind": "plain",
            "optional": true
          },
          "ecdsa_curve": {
            "type": "string",
            "description": "ECDSA curve to use when generating a key",
            "description_kind": "plain",
            "optional": true
          },
          "expiration_window": {
            "type": "number",
            "description": "Number of hours before the certificates expiry when a new certificate will be generated",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "issuer_hint": {
            "type": "string",
            "description": "Indicate the target issuer to enable valid days with CyberArk Platform. Supported values are DigiCert, Entrust, and Microsoft",
            "description_kind": "plain",
            "optional": true
          },
          "key_password": {
            "type": "string",
            "description": "Password for the private key",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "locality": {
            "type": "string",
            "description": "Locality/City of the certificate (L)",
            "description_kind": "plain",
            "optional": true
          },
          "nickname": {
            "type": "string",
            "description": "Use to specify a name for the new certificate object that will be created and placed in a policy. Only valid for CyberArk Certificate Manager, Self-Hosted",
            "description_kind": "plain",
            "optional": true
          },
          "organization": {
            "type": "string",
            "description": "Organization of the certificate (O)",
            "description_kind": "plain",
            "optional": true
          },
          "organizational_units": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of Organizational Units of the certificate (OU)",
            "description_kind": "plain",
            "optional": true
          },
          "pkcs12": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "private_key_pem": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "renew_required": {
            "type": "bool",
            "description": "Indicates the certificate should be reissued. This means the resource will destroyed and recreated",
            "description_kind": "plain",
            "optional": true
          },
          "rsa_bits": {
            "type": "number",
            "description": "Number of bits to use when generating an RSA key",
            "description_kind": "plain",
            "optional": true
          },
          "san_dns": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of DNS names to use as subjects of the certificate",
            "description_kind": "plain",
            "optional": true
          },
          "san_email": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of email addresses to use as subjects of the certificate",
            "description_kind": "plain",
            "optional": true
          },
          "san_ip": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of IP addresses to use as subjects of the certificate",
            "description_kind": "plain",
            "optional": true
          },
          "san_uri": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of Uniform Resource Identifiers (URIs) to use as subjects of the certificate",
            "description_kind": "plain",
            "optional": true
          },
          "state": {
            "type": "string",
            "description": "State of the certificate (S)",
            "description_kind": "plain",
            "optional": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of Certificate Tags defined in CyberArk Certificate Manager, SaaS.",
            "description_kind": "plain",
            "optional": true
          },
          "valid_days": {
            "type": "number",
            "description": "The desired validity time for the certificate, in days",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "venafi_cloud_keystore_installation": {
      "version": 0,
      "block": {
        "attributes": {
          "arn": {
            "type": "string",
            "description": "ARN of the certificate in AWS. Only used when provisioning for ACM keystore",
            "description_kind": "plain",
            "optional": true
          },
          "certificate_id": {
            "type": "string",
            "description": "ID of the certificate to be provisioned to the cloud keystore",
            "description_kind": "plain",
            "required": true
          },
          "cloud_certificate_id": {
            "type": "string",
            "description": "ID of the certificate after it has been provisioned to the cloud keystore",
            "description_kind": "plain",
            "computed": true
          },
          "cloud_certificate_metadata": {
            "type": [
              "map",
              "string"
            ],
            "description": "Metadata of the certificate after it has been provisioned to the cloud keystore",
            "description_kind": "plain",
            "computed": true
          },
          "cloud_certificate_name": {
            "type": "string",
            "description": "Name the certificate will be identified as in the cloud keystore. Only used when provisioning for AKV and GCM keystores",
            "description_kind": "plain",
            "optional": true
          },
          "cloud_keystore_id": {
            "type": "string",
            "description": "ID of the cloud keystore where the certificate will be provisioned",
            "description_kind": "plain",
            "required": true
          },
          "gcm_cert_scope": {
            "type": "string",
            "description": "Certificate scope of the certificate in Google Cloud. Only used when provisioning for GCM keystore",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "venafi_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "policy_specification": {
            "type": "string",
            "description": "policy specification",
            "description_kind": "plain",
            "optional": true
          },
          "zone": {
            "type": "string",
            "description": "zone name",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "venafi_ssh_certificate": {
      "version": 0,
      "block": {
        "attributes": {
          "certificate": {
            "type": "string",
            "description": "The SSH Certificate",
            "description_kind": "plain",
            "computed": true
          },
          "certificate_type": {
            "type": "string",
            "description": "Certificate type, server or client",
            "description_kind": "plain",
            "computed": true
          },
          "destination_address": {
            "type": [
              "list",
              "string"
            ],
            "description": "The address (FQDN/hostname/IP/CIDR) of the destination host where the certificate will be used to authenticate to",
            "description_kind": "plain",
            "optional": true
          },
          "extension": {
            "type": [
              "list",
              "string"
            ],
            "description": "The requested certificate extensions.",
            "description_kind": "plain",
            "optional": true
          },
          "folder": {
            "type": "string",
            "description": "The DN of the policy folder where the certificate object will be created",
            "description_kind": "plain",
            "optional": true
          },
          "force_command": {
            "type": "string",
            "description": "The requested force command.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "key_id": {
            "type": "string",
            "description": "The identifier of the requested certificate",
            "description_kind": "plain",
            "required": true
          },
          "key_passphrase": {
            "type": "string",
            "description": "Passphrase for encrypting the private key",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "key_size": {
            "type": "number",
            "description": "The key size bits, they will be used for creating keypair",
            "description_kind": "plain",
            "optional": true
          },
          "object_name": {
            "type": "string",
            "description": "The friendly name for the certificate object.",
            "description_kind": "plain",
            "optional": true
          },
          "principal": {
            "type": [
              "list",
              "string"
            ],
            "description": "The requested principals.",
            "description_kind": "plain",
            "deprecated": true,
            "optional": true
          },
          "principals": {
            "type": [
              "list",
              "string"
            ],
            "description": "The requested principals.",
            "description_kind": "plain",
            "optional": true
          },
          "private_key": {
            "type": "string",
            "description": "Private key",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "public_key": {
            "type": "string",
            "description": "Public key that will be used to generate the certificate",
            "description_kind": "plain",
            "optional": true
          },
          "public_key_fingerprint": {
            "type": "string",
            "description": "Public key fingerprint SHA256",
            "description_kind": "plain",
            "computed": true
          },
          "public_key_method": {
            "type": "string",
            "description": "If the public key will be: file provided or local, service generated",
            "description_kind": "plain",
            "optional": true
          },
          "serial": {
            "type": "string",
            "description": "Serial number",
            "description_kind": "plain",
            "computed": true
          },
          "signing_ca": {
            "type": "string",
            "description": "CA fingerprint SHA256",
            "description_kind": "plain",
            "computed": true
          },
          "source_address": {
            "type": [
              "list",
              "string"
            ],
            "description": "The requested source addresses as list of IP/CIDR",
            "description_kind": "plain",
            "optional": true
          },
          "template": {
            "type": "string",
            "description": "The certificate issuing template",
            "description_kind": "plain",
            "required": true
          },
          "valid_from": {
            "type": "string",
            "description": "Valid from",
            "description_kind": "plain",
            "computed": true
          },
          "valid_hours": {
            "type": "number",
            "description": "How much time the requester wants to have the certificate valid, the format is hours",
            "description_kind": "plain",
            "optional": true
          },
          "valid_to": {
            "type": "string",
            "description": "Valid to",
            "description_kind": "plain",
            "computed": true
          },
          "windows": {
            "type": "bool",
            "description": "If the line endings of service's private key will end on MS windows format",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "venafi_ssh_config": {
      "version": 0,
      "block": {
        "attributes": {
          "ca_public_key": {
            "type": "string",
            "description": "The template's CA PublicKey",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "principals": {
            "type": [
              "list",
              "string"
            ],
            "description": "The requested principals.",
            "description_kind": "plain",
            "computed": true
          },
          "template": {
            "type": "string",
            "description": "The certificate issuing template",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "venafi_cloud_keystore": {
      "version": 0,
      "block": {
        "attributes": {
          "cloud_provider_id": {
            "type": "string",
            "description": "ID of the parent Cloud Provider the keystore belongs to",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "machine_identities_count": {
            "type": "number",
            "description": "Number of machine identities associated with the Cloud Keystore",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Cloud Keystore to look for",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of the Cloud Keystore",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "venafi_cloud_provider": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "keystores_count": {
            "type": "number",
            "description": "Number of keystores associated with the Cloud Provider",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Cloud Provider to look for",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Status of the Cloud Provider",
            "description_kind": "plain",
            "computed": true
          },
          "status_details": {
            "type": "string",
            "description": "Details of the Cloud Provider status, if any",
            "description_kind": "plain",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Type of the Cloud Provider",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
