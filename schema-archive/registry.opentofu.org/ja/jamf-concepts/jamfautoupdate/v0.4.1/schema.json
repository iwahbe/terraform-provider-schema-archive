{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "definitions_file": {
          "type": "string",
          "description": "Path to a local JSON file containing definitions. Mutually exclusive with definitions_url.",
          "description_kind": "markdown",
          "optional": true
        },
        "definitions_url": {
          "type": "string",
          "description": "The baseURL of the Definitions API. Mutually exclusive with definitions_file.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Provides metadata for software titles sourced from [Jamf Auto Update](https://datajar.co.uk/products/jamf-auto-update/) using a private API. Intended for internal use within the Jamf organization.",
      "description_kind": "markdown"
    }
  },
  "data_source_schemas": {
    "jamfautoupdate_titles": {
      "version": 0,
      "block": {
        "attributes": {
          "timeouts": {
            "nested_type": {
              "attributes": {
                "read": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          },
          "title_names": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of specific title names to retrieve.",
            "description_kind": "markdown",
            "optional": true
          },
          "titles": {
            "nested_type": {
              "attributes": {
                "app_bundle_id": {
                  "type": "string",
                  "description": "The application bundle identifier",
                  "description_kind": "markdown",
                  "computed": true
                },
                "content_filter_profile": {
                  "type": "string",
                  "description": "Content filter profile data",
                  "description_kind": "markdown",
                  "computed": true
                },
                "extension_attribute": {
                  "type": "string",
                  "description": "Extension attribute data",
                  "description_kind": "markdown",
                  "computed": true
                },
                "icon_base64": {
                  "type": "string",
                  "description": "The icon in base64 format",
                  "description_kind": "markdown",
                  "computed": true
                },
                "kernel_extension_profile": {
                  "type": "string",
                  "description": "Kernel extension profile data",
                  "description_kind": "markdown",
                  "computed": true
                },
                "managed_login_items_profile": {
                  "type": "string",
                  "description": "Managed login items profile data",
                  "description_kind": "markdown",
                  "computed": true
                },
                "maximum_os": {
                  "type": "string",
                  "description": "Maximum OS version supported",
                  "description_kind": "markdown",
                  "computed": true
                },
                "minimum_os": {
                  "type": "string",
                  "description": "Minimum OS version required",
                  "description_kind": "markdown",
                  "computed": true
                },
                "notifications_profile": {
                  "type": "string",
                  "description": "Notifications profile data",
                  "description_kind": "markdown",
                  "computed": true
                },
                "pppcp_profile": {
                  "type": "string",
                  "description": "PPPCP profile data",
                  "description_kind": "markdown",
                  "computed": true
                },
                "screen_recording_profile": {
                  "type": "string",
                  "description": "Screen recording profile data",
                  "description_kind": "markdown",
                  "computed": true
                },
                "system_extension_profile": {
                  "type": "string",
                  "description": "System extension profile data",
                  "description_kind": "markdown",
                  "computed": true
                },
                "title_description": {
                  "type": "string",
                  "description": "The description of the title",
                  "description_kind": "markdown",
                  "computed": true
                },
                "title_display_name": {
                  "type": "string",
                  "description": "The display name of the title",
                  "description_kind": "markdown",
                  "computed": true
                },
                "title_name": {
                  "type": "string",
                  "description": "The name of the title",
                  "description_kind": "markdown",
                  "computed": true
                },
                "title_version": {
                  "type": "string",
                  "description": "The version of the title",
                  "description_kind": "markdown",
                  "computed": true
                },
                "uninstall_icon_base64": {
                  "type": "string",
                  "description": "The uninstall icon in base64 format",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of titles and their details",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Fetches information about Jamf Auto Update titles. Available titles are shown in the [Jamf Auto Update Catalog Browser](https://support.datajar.co.uk/hc/en-us/articles/4409234438161-Jamf-Auto-Update-Catalog-Browser-User-Guide)",
        "description_kind": "plain"
      }
    }
  }
}
