{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The API key used for authentication, generated at Organization > Settings > API in Jamf School. Can also be set with the `JAMFSCHOOL_API_KEY` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "network_id": {
          "type": "string",
          "description": "The Network ID used for API authentication, found at Devices > Enroll Device(s) in Jamf School. Can also be set with the `JAMFSCHOOL_NETWORK_ID` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "The base URL of your Jamf School instance (e.g. `https://myschool.jamfcloud.com`). Can also be set with the `JAMFSCHOOL_URL` environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "The Jamf School provider allows you to manage resources in Jamf School.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "jamfschool_app": {
      "version": 0,
      "block": {
        "attributes": {
          "adam_id": {
            "type": "number",
