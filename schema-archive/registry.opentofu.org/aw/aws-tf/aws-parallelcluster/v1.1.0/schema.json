            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ComputeFleetStatus identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "last_status_update_time": {
            "type": "string",
            "description": "The timestamp that represents the last status update time.",
            "description_kind": "markdown",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "The AWS Region that the cluster is in.",
            "description_kind": "markdown",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "The compute fleet status.",
            "description_kind": "markdown",
            "computed": true
          },
          "status_request": {
            "type": "string",
            "description": "The compute fleet status.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Update the status of the cluster compute fleet.",
        "description_kind": "markdown"
      }
    },
