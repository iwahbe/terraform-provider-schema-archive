{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_name": {
          "type": "string",
          "description": "The name of the ParallelCluster API. Used to retrieve the api endpoint if not given. Defaults to ParallelCluster.",
          "description_kind": "markdown",
          "optional": true
        },
        "api_stack_name": {
          "type": "string",
          "description": "The ParallelCluster cloudformation stack arn containing the endpoint and role outputs.",
          "description_kind": "markdown",
          "optional": true
        },
        "aws_key": {
          "type": "string",
          "description": "The aws key used for deploying resources and query data sources.",
          "description_kind": "markdown",
          "optional": true
        },
        "aws_secret": {
          "type": "string",
          "description": "The aws secret used for deploying resources and query data sources.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "The endpoint of the ParallelCluster API. If unset will be autodetected.",
          "description_kind": "markdown",
          "optional": true
        },
        "profile": {
          "type": "string",
          "description": "The aws profile used for deploying resources and query data sources.",
          "description_kind": "markdown",
          "optional": true
        },
        "region": {
          "type": "string",
          "description": "The region used for deploying resources and query data sources.",
          "description_kind": "markdown",
          "optional": true
        },
        "role_arn": {
          "type": "string",
          "description": "The role used for deploying resources and query data sources.",
          "description_kind": "markdown",
          "optional": true
        },
        "use_user_role": {
          "type": "bool",
          "description": "Whether or not to use the user role exported by the ParallelCluster cloudformation stack. Either set this to true, supply a `role_arn` or set neither.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "\nAWS ParallelCluster is an AWS supported open source cluster management tool that helps you to deploy and manage high performance computing (HPC) clusters in the AWS Cloud. It automatically sets up the required compute resources, scheduler, and shared filesystem. You can use AWS ParallelCluster with AWS Batch and Slurm schedulers.\n\nWith AWS ParallelCluster, you can quickly build and deploy proof of concept and production HPC compute environments. You can also build and deploy a high level workflow on top of AWS ParallelCluster, such as a genomics portal that automates an entire DNA sequencing workflow.\n    ",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "aws-parallelcluster_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "cloudformation_stack_arn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the main CloudFormation stack.",
            "description_kind": "markdown",
            "computed": true
          },
          "cloudformation_stack_status": {
            "type": "string",
            "description": "Status of the cloudformation stack.",
            "description_kind": "markdown",
            "computed": true
          },
          "cluster_configuration": {
            "type": "string",
            "description": "The cluster configuration as a YAML document.",
            "description_kind": "markdown",
            "required": true
          },
          "cluster_name": {
            "type": "string",
            "description": "The name of the cluster to create. The name must start with an alphabetical character. The name can have up to 60 characters. If Slurm accounting is enabled, the name can have up to 40 characters.",
            "description_kind": "markdown",
            "required": true
          },
          "cluster_status": {
            "type": "string",
            "description": "Status of the cluster.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Cluster identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "The AWS Region that the cluster is in.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "rollback_on_failure": {
            "type": "bool",
            "description": "If set to true, cluster stack rollback occurs if the cluster fails to create. The default is true.",
            "description_kind": "markdown",
            "optional": true
          },
          "suppress_validators": {
            "type": [
              "list",
              "string"
            ],
            "description": "Identify one or more configuration validators to suppress.",
            "description_kind": "markdown",
            "optional": true
          },
          "validation_failure_level": {
            "type": "string",
            "description": "The minimum validation level that causes cluster create to fail. The default is ERROR.",
            "description_kind": "markdown",
            "optional": true
          },
          "version": {
            "type": "string",
            "description": "The AWS ParallelCluster version that's used to create the cluster.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Create a managed cluster in an AWS Region.",
        "description_kind": "markdown"
      }
    },
    "aws-parallelcluster_compute_fleet_status": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_name": {
            "type": "string",
