            "description_kind": "markdown",
            "required": true
          },
          "image_id": {
            "type": "string",
            "description": "Id of the Image that will be built.",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "The AWS Region that the image is in.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "rollback_on_failure": {
            "type": "bool",
            "description": "If set to true, image stack rollback occurs if the image fails to create. The default is true.",
            "description_kind": "markdown",
            "optional": true
          },
          "suppress_validators": {
            "type": [
              "list",
              "string"
            ],
            "description": "Identify one or more configuration validators to suppress.",
            "description_kind": "markdown",
            "optional": true
          },
          "validation_failure_level": {
            "type": "string",
            "description": "The minimum validation level that causes image create to fail. The default is ERROR.",
            "description_kind": "markdown",
            "optional": true
          },
          "version": {
            "type": "string",
            "description": "The AWS ParallelImage version that's used to create the image.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Create a custom AWS ParallelCluster image in an AWS Region.",
        "description_kind": "markdown"
      }
    }
  },
