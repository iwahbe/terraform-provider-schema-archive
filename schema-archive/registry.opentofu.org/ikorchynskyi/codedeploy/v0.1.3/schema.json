{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "region": {
          "type": "string",
          "description": "AWS region",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "codedeploy_deployment": {
      "version": 0,
      "block": {
        "attributes": {
          "application_name": {
            "type": "string",
            "description": "Name of the CodeDeploy application",
            "description_kind": "plain",
            "required": true
          },
          "auto_rollback_enabled": {
            "type": "bool",
            "description": "Indicates whether a failed deployment should be rolled back",
            "description_kind": "plain",
            "optional": true
          },
          "deployment_group_name": {
            "type": "string",
            "description": "Name of the CodeDeploy deployment group",
            "description_kind": "plain",
            "required": true
          },
          "deployment_status": {
            "type": "string",
            "description": "Status of the deployment",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "revision": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "revision_type": {
                  "type": "string",
                  "description": "Type of the revision",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "appspec_content": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "content": {
                        "type": "string",
                        "description": "The YAML-formatted or JSON-formatted revision string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "sha256": {
                        "type": "string",
                        "description": "The SHA256 hash value of the revision content",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "description": "AppSpec location details for the revision",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                },
                "github_location": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "commit_id": {
                        "type": "string",
                        "description": "Commit ID of the revision",
                        "description_kind": "plain",
                        "required": true
                      },
                      "repository": {
                        "type": "string",
                        "description": "Name of the GitHub repository",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "GitHub location details for the revision",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                },
                "s3_location": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "bucket": {
                        "type": "string",
                        "description": "Name of the S3 bucket",
                        "description_kind": "plain",
                        "required": true
                      },
                      "bundle_type": {
                        "type": "string",
                        "description": "Type of the revision bundle",
                        "description_kind": "plain",
                        "required": true
                      },
                      "key": {
                        "type": "string",
                        "description": "Key of the S3 object",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "S3 location details for the revision",
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description": "Revision details for the deployment",
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
