{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "domain": {
          "type": "string",
          "description": "Zitadel instance domain (e.g., 'zitadel.example.com'). Can also be set via ZITACTL_DOMAIN environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "service_account_key": {
          "type": "string",
          "description": "Service account key as a **__decoded__ JSON string**. Can also be set via ZITACTL_SERVICE_ACCOUNT_KEY environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "skip_tls_verification": {
          "type": "bool",
          "description": "Skip TLS verification (e.g. when using self-signed certificates). Can also be set via ZITACTL_SKIP_TLS_VERIFICATION environment variable. Note: this ensures, that invalid HTTPS certificates are tolerated.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "zitactl_application_oidc": {
      "version": 0,
      "block": {
        "attributes": {
          "access_token_role_assertion": {
            "type": "bool",
            "description": "Access token role assertion",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "access_token_type": {
            "type": "string",
            "description": "Access token type, supported values: OIDC_TOKEN_TYPE_BEARER, OIDC_TOKEN_TYPE_JWT",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "additional_origins": {
            "type": [
              "list",
              "string"
            ],
            "description": "Additional origins",
            "description_kind": "markdown",
            "optional": true
          },
          "app_type": {
            "type": "string",
            "description": "App type, supported values: OIDC_APP_TYPE_WEB, OIDC_APP_TYPE_USER_AGENT, OIDC_APP_TYPE_NATIVE",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "auth_method_type": {
            "type": "string",
            "description": "Auth method type, supported values: OIDC_AUTH_METHOD_TYPE_BASIC, OIDC_AUTH_METHOD_TYPE_POST, OIDC_AUTH_METHOD_TYPE_NONE, OIDC_AUTH_METHOD_TYPE_PRIVATE_KEY_JWT",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "client_id": {
            "type": "string",
            "description": "Generated client ID",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "client_secret": {
            "type": "string",
            "description": "Generated client secret",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "clock_skew": {
            "type": "string",
            "description": "Clock skew",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "dev_mode": {
            "type": "bool",
            "description": "Dev mode (can be set by the user, will set to `false` otherwise",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "grant_types": {
            "type": [
              "list",
              "string"
            ],
            "description": "Grant types, supported values: OIDC_GRANT_TYPE_AUTHORIZATION_CODE, OIDC_GRANT_TYPE_IMPLICIT, OIDC_GRANT_TYPE_REFRESH_TOKEN, OIDC_GRANT_TYPE_DEVICE_CODE, OIDC_GRANT_TYPE_TOKEN_EXCHANGE",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of this resource",
            "description_kind": "markdown",
            "computed": true
          },
          "id_token_role_assertion": {
            "type": "bool",
            "description": "ID token role assertion",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id_token_userinfo_assertion": {
            "type": "bool",
            "description": "ID token userinfo assertion",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the application",
            "description_kind": "markdown",
            "required": true
          },
          "post_logout_redirect_uris": {
            "type": [
              "list",
              "string"
            ],
            "description": "Post logout redirect URIs",
            "description_kind": "markdown",
            "optional": true
          },
          "project_id": {
            "type": "string",
            "description": "ID of the project",
            "description_kind": "markdown",
            "required": true
          },
          "redirect_uris": {
            "type": [
              "list",
              "string"
            ],
            "description": "Redirect URIs",
            "description_kind": "markdown",
            "required": true
          },
          "response_types": {
            "type": [
              "list",
              "string"
            ],
            "description": "Response types, supported values: OIDC_RESPONSE_TYPE_CODE, OIDC_RESPONSE_TYPE_ID_TOKEN, OIDC_RESPONSE_TYPE_ID_TOKEN_TOKEN",
            "description_kind": "markdown",
            "required": true
          },
          "skip_native_app_success_page": {
            "type": "bool",
            "description": "Skip the successful login page on native apps and directly redirect the user to the callback",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "version": {
            "type": "string",
            "description": "Version, supported values: OIDC_VERSION_1_0",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a ZITADEL OIDC Application",
        "description_kind": "markdown"
      }
    },
    "zitactl_project": {
      "version": 0,
      "block": {
        "attributes": {
          "has_project_check": {
            "type": "bool",
            "description": "ZITADEL checks if the org of the user has permission to this project",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of this resource",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the project",
            "description_kind": "markdown",
            "required": true
          },
          "org_id": {
            "type": "string",
            "description": "ID of the organization",
            "description_kind": "markdown",
            "required": true
          },
          "private_labeling_setting": {
            "type": "string",
            "description": "Defines from where the private labeling should be triggered, supported values: PRIVATE_LABELING_SETTING_UNSPECIFIED, PRIVATE_LABELING_SETTING_ENFORCE_PROJECT_RESOURCE_OWNER_POLICY, PRIVATE_LABELING_SETTING_ALLOW_LOGIN_USER_RESOURCE_OWNER_POLICY",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "project_role_assertion": {
            "type": "bool",
            "description": "Describes if roles of user should be added in token",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "project_role_check": {
            "type": "bool",
            "description": "ZITADEL checks if the user has at least one role on this project",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "state": {
            "type": "string",
            "description": "State of the project",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manages a ZITADEL project",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "zitactl_orgs": {
      "version": 0,
      "block": {
        "attributes": {
          "ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of organization IDs matching the given name",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the organization to search for",
            "description_kind": "markdown",
            "required": true
          },
          "name_method": {
            "type": "string",
            "description": "Method for querying orgs by name",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Datasource representing organizations in ZITADEL.\n\nOrganizations are the highest level after the instance and contain several \nother resources including policies if the configuration differs from the \ndefault policies on the instance.",
        "description_kind": "markdown"
      }
    }
  }
}
