{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "log_ssh_commands": {
          "type": "bool",
          "description": "Print SSH commands with ERROR level",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_cert": {
          "type": "string",
          "description": "Certificate (private key) to use. Default: ~/.ssh/id_rsa\n  \n  Supported formats:\n  - `file:/a` or `/a` or `./a` or `~/a` - use provided value as path to certificate file\n  - `env:ABCD` or `$ABCD` - use env var ABCD\n  - `raw:----...` or `----...` - use provided value as raw certificate",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_host": {
          "type": "string",
          "description": "Host to connect to",
          "description_kind": "plain",
          "required": true
        },
        "ssh_host_key": {
          "type": "string",
          "description": "Host public key to use. By default key from ~/.ssh/known_hosts will be used.\n  To get public keys for your ssh_host, run `ssh-keyscan <ssh_host>`.\n  Must be set for usage within Terraform Cloud.",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_port": {
          "type": "number",
          "description": "Port to connect to. Default: 22",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_skip_host_key_check": {
          "type": "bool",
          "description": "Skip the host key check. Insecure, should not be used in production. Default: false",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_user": {
          "type": "string",
          "description": "Username to use. Default: dokku",
          "description_kind": "plain",
          "optional": true
        },
        "upload_app_name": {
          "type": "string",
          "description": "This attribute is used to upload local files to remote server using storage.local_directory attribute.\n  App name to use for local file synchronization. Default: storage-sync\n  \n  Since dokku don't allow to upload files directly, workaround is used.\n  Algorithm is:\n  1. Create helper dokku application, using name provided in this attribute plus random string to prevent conflicts with simultaneous uploads\n  2. Mount desired remote directory as /mnt\n  3. Deploy \"busybox\" docker image to app\n  4. [on host side] Create tar archive for local_directory and encode it using base64\n  5. Connect to app using \"dokku enter\" and use a bunch of echo-s to make file \"tmp.tar.base64\"\n  6. When file is completely uploaded - decode and un-tar it to /mnt\n  7. Delete helper dokku application\n  \n  See details in description to \"upload_app_name\" attribute.",
          "description_kind": "plain",
          "optional": true
        },
        "upload_split_bytes": {
          "type": "number",
          "description": "This attribute is used to upload local files to remote server using storage.local_directory attribute.\n  Number of bytes to split uploaded base64-encoded tar archive. See details in description to \"upload_app_name\" attribute. Default: 256\n  \n  Due to limited length of commands we can't use one echo to copy entire file.\n  So we need to split file into parts no larger than upload_split_bytes.\n  Don't use big values because if length of command exceed the limit all operation will hang out.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with dokku",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dokku_app": {
      "version": 0,
      "block": {
        "attributes": {
          "app_name": {
            "type": "string",
            "description": "Name of application to manage",
            "description_kind": "plain",
            "required": true
          },
          "checks": {
            "nested_type": {
              "attributes": {
                "status": {
                  "type": "string",
                  "description": "Checks status. Default: enabled",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Checks setup for app",
            "description_kind": "plain",
            "optional": true
          },
          "config": {
            "type": [
              "map",
              "string"
            ],
            "description": "Config (env vars) for app",
            "description_kind": "plain",
            "optional": true
          },
          "deploy": {
            "nested_type": {
              "attributes": {
                "allow_rebuild": {
                  "type": "bool",
                  "description": "Allow to run ps:rebuild for app if same docker_image provided second time",
                  "description_kind": "plain",
                  "optional": true
                },
                "archive_type": {
                  "type": "string",
                  "description": "Type of archive to deploy. Allowed values: tar, tar.gz, zip",
                  "description_kind": "plain",
                  "optional": true
                },
                "archive_url": {
                  "type": "string",
                  "description": "URL of archive to delpoy from. Login and password will not be used",
                  "description_kind": "plain",
                  "optional": true
                },
                "docker_image": {
                  "type": "string",
                  "description": "Docker image to deploy from. If login and password is provided then it will be used to sign in to docker registry.",
                  "description_kind": "plain",
                  "optional": true
                },
                "git_repository": {
                  "type": "string",
                  "description": "Git repository to deploy from. If login and password is provided then it will be used to sign in to repository.",
                  "description_kind": "plain",
                  "optional": true
                },
                "git_repository_ref": {
                  "type": "string",
                  "description": "Ref of git repository to deploy from",
                  "description_kind": "plain",
                  "optional": true
                },
                "login": {
                  "type": "string",
                  "description": "Login to use for deployment",
                  "description_kind": "plain",
                  "optional": true
                },
                "password": {
                  "type": "string",
                  "description": "Password to use for deployment",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "type": {
                  "type": "string",
                  "description": "Type of deploy to use. Allowed values: archive, docker_image, git_repository",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Deploy setup for app",
            "description_kind": "plain",
            "optional": true
          },
          "docker_options": {
            "nested_type": {
              "attributes": {
                "phase": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "Phase to apply docker-options to. Allowed values: build, deploy, run",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "map"
            },
            "description": "Docker options for app. Keys are options",
            "description_kind": "plain",
            "optional": true
          },
          "domains": {
            "type": [
              "set",
              "string"
            ],
            "description": "Domains setup for app",
            "description_kind": "plain",
            "optional": true
          },
          "networks": {
            "nested_type": {
              "attributes": {
                "attach_post_create": {
                  "type": "string",
                  "description": "Name of network to use as attach-post-create",
                  "description_kind": "plain",
                  "optional": true
                },
                "attach_post_deploy": {
                  "type": "string",
                  "description": "Name of network to use as attach-post-deploy",
                  "description_kind": "plain",
                  "optional": true
                },
                "initial_network": {
                  "type": "string",
                  "description": "Name of network to use as initial-network",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Network setup for app",
            "description_kind": "plain",
            "optional": true
          },
          "ports": {
            "nested_type": {
              "attributes": {
                "container_port": {
                  "type": "string",
                  "description": "Port inside container to proxy",
                  "description_kind": "plain",
                  "required": true
                },
                "scheme": {
                  "type": "string",
                  "description": "Scheme to use. Allowed values: http, https",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "map"
            },
            "description": "Ports setup for app. Keys are host ports",
            "description_kind": "plain",
            "optional": true
          },
          "proxy_ports": {
            "nested_type": {
              "attributes": {
                "container_port": {
                  "type": "string",
                  "description": "Port inside container to proxy",
                  "description_kind": "plain",
                  "required": true
                },
                "scheme": {
                  "type": "string",
                  "description": "Scheme to use. Allowed values: http, https",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "map"
            },
            "description": "DEPRECATED. Use \"ports\" instead.\n\nProxy ports setup for app. Keys are host ports.",
            "description_kind": "plain",
            "optional": true
          },
          "storage": {
            "nested_type": {
              "attributes": {
                "local_directory": {
                  "type": "string",
                  "description": "Uploads local directory to host (always, without checking is it changed)\n  \n  Should not be used for uploading large files, because it is slow.\n  Also see upload_* attributes in provider configuration.",
                  "description_kind": "plain",
                  "optional": true
                },
                "mount_path": {
                  "type": "string",
                  "description": "Path inside container to mount to",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "map"
            },
            "description": "Persistent storage setup for app. Keys are storage names or absolute paths to host directories",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "dokku app\n  https://dokku.com/docs/deployment/application-management/",
        "description_kind": "plain"
      }
    },
