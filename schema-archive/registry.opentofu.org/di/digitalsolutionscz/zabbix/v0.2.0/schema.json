{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_password": {
          "type": "string",
          "description": "Zabbix API password (used with 'api_user').",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "api_token": {
          "type": "string",
          "description": "Zabbix API token. Mutually exclusive with 'api_user' and 'api_password'.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "api_user": {
          "type": "string",
          "description": "Zabbix API username (used with 'api_password').",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "Full URL to Zabbix API endpoint (e.g. https://example.com/zabbix/api_jsonrpc.php).",
          "description_kind": "plain",
          "required": true
        },
        "skip_ssl_verify": {
          "type": "bool",
          "description": "Skip SSL certificate verification.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "zabbix_discovery": {
      "version": 0,
      "block": {
        "attributes": {
          "concurrency_max": {
            "type": "number",
            "description": "Max concurrent checks. Default is 1.",
            "description_kind": "plain",
            "optional": true
          },
          "delay": {
            "type": "string",
            "description": "Delay between checks, in seconds (as string). Default is '3600'.",
            "description_kind": "plain",
            "optional": true
          },
          "error": {
            "type": "string",
            "description": "Error text if there have been any problems executing the discovery rule (read-only).",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "iprange": {
            "type": "string",
            "description": "IP range to scan, e.g. 192.168.1.1-255.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the discovery rule.",
            "description_kind": "plain",
            "required": true
          },
          "proxyid": {
            "type": "string",
            "description": "ID of the proxy used for discovery.",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "number",
            "description": "Rule status. 0=enabled, 1=disabled.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "dchecks": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "key_": {
                  "type": "string",
                  "description": "Item key for the check.",
                  "description_kind": "plain",
                  "required": true
                },
                "ports": {
                  "type": "string",
                  "description": "Port(s) to use.",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "number",
                  "description": "Check type, e.g. 9=Zabbix agent.",
                  "description_kind": "plain",
                  "required": true
                },
                "uniq": {
                  "type": "number",
                  "description": "Uniqueness flag (0 or 1).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "List of discovery checks for this rule.",
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "zabbix_host": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Description of the host.",
            "description_kind": "plain",
            "optional": true
          },
          "host": {
            "type": "string",
            "description": "Technical name of the host.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "inventory": {
            "type": [
              "map",
              "string"
            ],
            "description": "Host inventory properties.",
            "description_kind": "plain",
            "optional": true
          },
          "inventory_mode": {
            "type": "number",
            "description_kind": "plain",
            "optional": true
          },
          "monitored_by": {
            "type": "number",
            "description": "Source monitoring the host. 0=Zabbix server, 1=Proxy, 2=Proxy group.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Visible name of the host. Defaults to `host` if not set.",
            "description_kind": "plain",
            "optional": true
          },
          "proxy_groupid": {
            "type": "number",
            "description": "ID of the proxy group monitoring the host.",
            "description_kind": "plain",
            "optional": true
          },
          "proxyid": {
            "type": "number",
            "description": "ID of the proxy monitoring the host.",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "number",
            "description": "Status of the host. 0=enabled, 1=disabled.",
            "description_kind": "plain",
            "optional": true
          },
          "tls_accept": {
            "type": "number",
            "description": "TLS accept mode. 1=No encryption, 2=PSK, 4=certificate.",
            "description_kind": "plain",
            "optional": true
          },
          "tls_connect": {
            "type": "number",
            "description": "TLS connection mode. 1=No encryption, 2=PSK, 4=certificate.",
            "description_kind": "plain",
            "optional": true
          },
          "tls_psk": {
            "type": "string",
            "description": "Pre-shared key value for PSK encryption (write-only).",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "tls_psk_identity": {
            "type": "string",
            "description": "Pre-shared key identity for PSK encryption.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "groups": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "groupid": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Host groups to assign.",
              "description_kind": "plain"
            },
            "min_items": 1
          },
          "interfaces": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "details": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "dns": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "ip": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "main": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "port": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "useip": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "List of host interfaces.",
              "description_kind": "plain"
            },
            "min_items": 1
          },
          "macros": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "macro": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "User macros.",
              "description_kind": "plain"
            }
          },
          "tags": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "tag": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Host tags.",
              "description_kind": "plain"
            }
          },
          "templates": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "templateid": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Templates to link.",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
