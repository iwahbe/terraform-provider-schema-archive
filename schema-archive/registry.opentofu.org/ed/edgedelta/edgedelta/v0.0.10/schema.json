{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_endpoint": {
          "type": "string",
          "description": "API base URL",
          "description_kind": "plain",
          "optional": true
        },
        "api_secret": {
          "type": "string",
          "description": "API secret",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "org_id": {
          "type": "string",
          "description": "Unique organization ID",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "edgedelta_config": {
      "version": 1,
      "block": {
        "attributes": {
          "auto_deploy": {
            "type": "bool",
            "description": "Automatically deploy the config after saving. If false, only saves the config.",
            "description_kind": "plain",
            "optional": true
          },
          "cluster_name": {
            "type": "string",
            "description": "Cluster name for grouping pipelines",
            "description_kind": "plain",
            "optional": true
          },
          "conf_id": {
            "type": "string",
            "description": "Unique configuration ID",
            "description_kind": "plain",
            "optional": true
          },
          "config_content": {
            "type": "string",
            "description": "Configuration file data",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Description of the pipeline",
            "description_kind": "plain",
            "optional": true
          },
          "environment": {
            "type": "string",
            "description": "Environment where the pipeline will be deployed (Kubernetes, Linux, Windows, MacOS, Docker)",
            "description_kind": "plain",
            "required": true
          },
          "fleet_subtype": {
            "type": "string",
            "description": "Fleet subtype (Edge, Coordinator, Gateway). Required when environment is Kubernetes and fleet_type is Edge.",
            "description_kind": "plain",
            "optional": true
          },
          "fleet_type": {
            "type": "string",
            "description": "Fleet type (Edge, Cloud). Defaults to Edge.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tag": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "edgedelta_dashboard": {
      "version": 1,
      "block": {
        "attributes": {
          "created": {
            "type": "string",
            "description": "UTC timestamp of dashboard creation.",
            "description_kind": "plain",
            "computed": true
          },
          "creator": {
            "type": "string",
            "description": "User ID who created the dashboard.",
            "description_kind": "plain",
            "computed": true
          },
          "dashboard_id": {
            "type": "string",
            "description": "Unique identifier for the dashboard.",
            "description_kind": "plain",
            "computed": true
          },
          "dashboard_name": {
            "type": "string",
            "description": "Name of the dashboard.",
            "description_kind": "plain",
            "required": true
          },
          "definition": {
            "type": "string",
            "description": "Full dashboard definition as a JSON string. Can include 'definition', 'resource_accesses', and 'sharing_security_settings' fields. Use file() to load from a JSON file.",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Description of the dashboard.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "Searchable tags for the dashboard.",
            "description_kind": "plain",
            "optional": true
          },
          "updated": {
            "type": "string",
            "description": "UTC timestamp of last update.",
            "description_kind": "plain",
            "computed": true
          },
          "updater": {
            "type": "string",
            "description": "User ID who last updated the dashboard.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages an EdgeDelta dashboard resource.",
        "description_kind": "plain"
      }
    }
  }
}
