{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "account_name": {
          "type": "string",
          "description": "Your account name in Spacelift. Used to construct the API URL if api_url is not specified. Can also be set with the TF_VAR_spacelift_account_name or spacelift_account_name environment variables.",
          "description_kind": "plain",
          "optional": true
        },
        "api_token": {
          "type": "string",
          "description": "The SpaceLift API token. Can also be set with the SPACELIFT_API_TOKEN environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "api_url": {
          "type": "string",
          "description": "The SpaceLift API URL. If not specified, it will be constructed using the account_name.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with SpaceLift Stack Outputs.",
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "spaceliftoutput_stack_output": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Identifier of the data source.",
            "description_kind": "plain",
            "computed": true
          },
          "last_check": {
            "type": "string",
            "description": "The timestamp of the last check.",
            "description_kind": "plain",
            "computed": true
          },
          "output_name": {
            "type": "string",
            "description": "The name of the output to retrieve.",
            "description_kind": "plain",
            "required": true
          },
          "stack_id": {
            "type": "string",
            "description": "The ID of the SpaceLift stack.",
            "description_kind": "plain",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "The value of the specified output.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieves a single output from a SpaceLift stack.",
        "description_kind": "plain"
      }
    },
    "spaceliftoutput_stack_outputs": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Identifier of the data source.",
            "description_kind": "plain",
            "computed": true
          },
          "last_check": {
            "type": "string",
            "description": "The timestamp of the last check.",
            "description_kind": "plain",
            "computed": true
          },
          "outputs": {
            "type": [
              "map",
              "string"
            ],
            "description": "The outputs of the SpaceLift stack.",
            "description_kind": "plain",
            "computed": true
          },
          "stack_id": {
            "type": "string",
            "description": "The ID of the SpaceLift stack.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Retrieves all outputs from a SpaceLift stack.",
        "description_kind": "plain"
      }
    }
  }
}
