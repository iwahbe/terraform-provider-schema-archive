{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "github_api_base_url": {
          "type": "string",
          "description": "Optional override for the GitHub API base URL (default: `https://api.github.com`). Can also be set with the `GITHUB_API_BASE_URL` environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "github_api_version": {
          "type": "string",
          "description": "Optional override for the GitHub API version header (default: `2022-11-28`). Can also be set with the `GITHUB_API_VERSION` environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "github_token": {
          "type": "string",
          "description": "GitHub classic personal access token for enterprise team APIs. Can also be set with the `GITHUB_TOKEN` environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The GitHub Enterprise provider manages enterprise teams and SCIM integrations.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "githubenterprise_enterprise_team": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Team creation timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The team description.",
            "description_kind": "plain",
            "optional": true
          },
          "enterprise": {
            "type": "string",
            "description": "The enterprise slug.",
            "description_kind": "plain",
            "required": true
          },
          "group_id": {
            "type": "string",
            "description": "Optional IdP group ID used to manage membership for the enterprise team.",
            "description_kind": "plain",
            "optional": true
          },
          "html_url": {
            "type": "string",
            "description": "Web URL for the enterprise team.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique ID of the enterprise team.",
            "description_kind": "plain",
            "computed": true
          },
          "members_url": {
            "type": "string",
            "description": "API URL for team members.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the team.",
            "description_kind": "plain",
            "required": true
          },
          "organization_selection_type": {
            "type": "string",
            "description": "Specifies which organizations in the enterprise should have access to this team. Allowed values: `disabled`, `selected`, `all`.",
            "description_kind": "plain",
            "optional": true
          },
          "organization_slugs": {
            "type": [
              "set",
              "string"
            ],
            "description": "Optional organization slugs to assign when `organization_selection_type` is `selected`.",
            "description_kind": "plain",
            "optional": true
          },
          "slug": {
            "type": "string",
            "description": "The team slug.",
            "description_kind": "plain",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "Team update timestamp.",
            "description_kind": "plain",
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "API URL for the enterprise team.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a GitHub enterprise team.",
        "description_kind": "plain"
      }
    },
    "githubenterprise_enterprise_team_member": {
      "version": 0,
      "block": {
        "attributes": {
          "enterprise": {
            "type": "string",
            "description": "The enterprise slug.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Composite ID of the team membership.",
            "description_kind": "plain",
            "computed": true
          },
          "team_slug": {
            "type": "string",
            "description": "The enterprise team slug or ID.",
            "description_kind": "plain",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "The GitHub username.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a single GitHub enterprise team membership.",
        "description_kind": "plain"
      }
    },
    "githubenterprise_enterprise_team_members": {
      "version": 0,
      "block": {
        "attributes": {
          "enterprise": {
            "type": "string",
            "description": "The enterprise slug.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Composite ID of the team membership set.",
            "description_kind": "plain",
            "computed": true
          },
          "team_slug": {
            "type": "string",
            "description": "The enterprise team slug or ID.",
            "description_kind": "plain",
            "required": true
          },
          "usernames": {
            "type": [
              "set",
              "string"
            ],
            "description": "GitHub usernames to ensure are members of the enterprise team.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages enterprise team membership in bulk.",
        "description_kind": "plain"
      }
    },
    "githubenterprise_enterprise_team_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "enterprise": {
            "type": "string",
            "description": "The enterprise slug.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Composite ID of the assignment.",
            "description_kind": "plain",
            "computed": true
          },
          "organization": {
            "type": "string",
            "description": "The organization slug.",
            "description_kind": "plain",
            "required": true
          },
          "team_slug": {
            "type": "string",
            "description": "The enterprise team slug or ID.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages an organization assignment for a GitHub enterprise team.",
        "description_kind": "plain"
      }
