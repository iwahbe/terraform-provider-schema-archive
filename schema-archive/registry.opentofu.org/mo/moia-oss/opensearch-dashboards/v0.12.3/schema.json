{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "The Opensearch base url",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "disable_authentication": {
          "type": "bool",
          "description": "In all production environments, authentication is expected but with this flag it can be disabled for example for the purpose of local testing",
          "description_kind": "plain",
          "optional": true
        },
        "path_prefix": {
          "type": "string",
          "description": "prefix to be prepended to any path. The default is '/_dashboards' to prevent breaking change since this is needed for AWS Opensearch on which this provider was first used. You will want to set this to an empty string for development on a local Opensearch for example",
          "description_kind": "plain",
          "optional": true
        },
        "sync_index_pattern_fields": {
          "type": "bool",
          "description": "Usually in index-patterns the fields are automatically generated from the matched indices. If you instead explicitly want to track index-pattern-fields with terraform, set this value to true.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "opensearch_default_index_pattern": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "index_pattern_id": {
            "type": "string",
            "description": "The unique identifier of the index pattern.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "The default index pattern defines the default index pattern.",
        "description_kind": "plain"
      }
    },
    "opensearch_saved_object": {
      "version": 0,
      "block": {
        "attributes": {
          "attributes": {
            "type": "string",
            "description": "Attributes of the saved object.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "obj_id": {
            "type": "string",
            "description": "ID of the saved object.",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of the saved object.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "references": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "References of the saved object.",
              "description_kind": "plain"
            }
          }
        },
        "description": "Manages saved objects in OpenSearch Dashboards.",
        "description_kind": "plain"
      }
    }
  }
}
