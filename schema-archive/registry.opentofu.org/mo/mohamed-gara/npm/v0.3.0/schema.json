{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description": "The password to use for authentication. The password should be defined with the TERRAFORM_PROVIDER_NPM_PASSWORD environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "url": {
          "type": "string",
          "description": "The npm registry URL. The value can be defined using the TERRAFORM_PROVIDER_NPM_URL environment variable.",
          "description_kind": "markdown",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "The username to use for authentication. The username should be defined with the TERRAFORM_PROVIDER_NPM_USERNAME environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "npm_package": {
      "version": 0,
      "block": {
        "attributes": {
          "files": {
            "type": [
              "list",
              [
                "object",
                {
                  "absolute_path": "string",
                  "mime_type": "string"
                }
              ]
            ],
            "description": "Package files",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Package name",
            "description_kind": "markdown",
            "required": true
          },
          "version": {
            "type": "string",
            "description": "Package version",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "A data source to download a package from an npm registry and access to its file list (using the files attribute).",
        "description_kind": "markdown"
      }
    }
  }
}
