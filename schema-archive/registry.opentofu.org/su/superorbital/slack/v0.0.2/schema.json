                  "description": "An array of workspace IDs that are in the Enterprise Grid organization.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "An object containing info related to an Enterprise Grid user.",
            "description_kind": "plain",
            "computed": true
          },
