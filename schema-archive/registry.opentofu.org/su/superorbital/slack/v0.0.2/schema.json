            "description_kind": "plain",
            "computed": true
          },
          "updated": {
            "type": "string",
            "description": "A Unix timestamp indicating when the user object was last updated.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetch a user.",
        "description_kind": "plain"
