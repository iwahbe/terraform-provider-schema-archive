                  "description_kind": "plain",
                  "computed": true
                },
                "image_72": {
                  "type": "string",
                  "description": "Contains the URL for the 72-pixel square ratio, web-viewable images (GIFs, JPEGs, or PNGs) that represent a user's profile picture.",
                  "description_kind": "plain",
                  "computed": true
                },
                "image_original": {
                  "type": "string",
