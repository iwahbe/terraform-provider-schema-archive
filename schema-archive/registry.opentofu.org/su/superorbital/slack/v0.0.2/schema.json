                  "computed": true
                },
                "enterprise_name": {
                  "type": "string",
                  "description": "A display name for the Enterprise Grid organization.",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "This user's ID - some Grid users have a kind of dual identity \u2014 a local, workspace-centric user ID as well as a Grid-wise user ID, called the Enterprise user ID.",
                  "description_kind": "plain",
                  "computed": true
                },
                "is_admin": {
                  "type": "bool",
                  "description": "Indicates whether the user is an Admin of the Enterprise Grid organization.",
                  "description_kind": "plain",
                  "computed": true
                },
                "is_owner": {
                  "type": "bool",
                  "description": "Indicates whether the user is an Owner of the Enterprise Grid organization.",
                  "description_kind": "plain",
                  "computed": true
                },
                "teams": {
                  "type": [
                    "list",
                    "string"
