{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "kea_server_address": {
          "type": "string",
          "description": "IP or FQDN of host which serves Kea Control Agent API",
          "description_kind": "plain",
          "required": true
        },
        "kea_server_configfile": {
          "type": "string",
          "description": "Path to Kea DHCP4 server config (on server, required for config-write command)",
          "description_kind": "plain",
          "required": true
        },
        "kea_server_password": {
          "type": "string",
          "description": "HTTP basic auth password (if configured)",
          "description_kind": "plain",
          "optional": true
        },
        "kea_server_username": {
          "type": "string",
          "description": "HTTP basic auth username (if configured)",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "kea-dhcp4_host_lease": {
      "version": 0,
      "block": {
        "attributes": {
          "boot_file_name": {
            "type": "string",
            "description": "(Optional) Path to boot file on TFTP server",
            "description_kind": "plain",
            "optional": true
          },
          "client_classes": {
            "type": [
              "list",
              "string"
            ],
            "description": "(Optional) List of client classes to apply",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ip_address": {
            "type": "string",
            "description": "ip address to assign for mac",
            "description_kind": "plain",
            "required": true
          },
          "mac_address": {
            "type": "string",
            "description": "mac address in lower-case",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "lease_name in lowercase",
            "description_kind": "plain",
            "required": true
          },
          "next_server": {
            "type": "string",
            "description": "(Optional) TFTP server to boot from",
            "description_kind": "plain",
            "optional": true
          },
          "server_hostname": {
            "type": "string",
            "description": "(Optional) TFTP server hostname",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "option_data": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "always_send": {
                  "type": "bool",
                  "description": "(Optional) Force sending this DHCP option",
                  "description_kind": "plain",
                  "optional": true
                },
                "code": {
                  "type": "number",
                  "description": "(Optional) DHCP option code",
                  "description_kind": "plain",
                  "optional": true
                },
                "csv_format": {
                  "type": "bool",
                  "description": "(Optional) Set to true if data is specified in hex format",
                  "description_kind": "plain",
                  "optional": true
                },
                "data": {
                  "type": "string",
                  "description": "DHCP option data",
                  "description_kind": "plain",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "(Optional) DHCP option name",
                  "description_kind": "plain",
                  "optional": true
                },
                "space": {
                  "type": "string",
                  "description": "(Optional) DHCP space identifier, default is dhcp4",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "(Optional) List of custom DHCP options for host",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
