{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "ca_cert": {
          "type": "string",
          "description": "File that contains the CA certificate that signed the opensearch servers' certificates. Can alternatively be set with the OPENSEARCH_CACERT environment variable. Can also be omitted.",
          "description_kind": "markdown",
          "optional": true
        },
        "client_cert": {
          "type": "string",
          "description": "File that contains the client certificate used to authentify the user. Can alternatively be set with the OPENSEARCH_CERT environment variable. Can be omitted if password authentication is used.",
          "description_kind": "markdown",
          "optional": true
        },
        "client_key": {
          "type": "string",
          "description": "File that contains the client encryption key used to authentify the user. Can alternatively be set with the OPENSEARCH_KEY environment variable. Can be omitted if password authentication is used.",
          "description_kind": "markdown",
          "optional": true
        },
        "connection_timeout": {
          "type": "string",
          "description": "Timeout to establish the opensearch servers connection in golang duration format. Defaults to 10 seconds.",
          "description_kind": "markdown",
          "optional": true
        },
        "endpoints": {
          "type": "string",
          "description": "Endpoints of the opensearch servers. The entry of each server should follow the http|https://ip:port format and be coma separated. Can alternatively be set with the OPENSEARCH_ENDPOINTS environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password of the opensearch user that will be used to access opensearch. Can alternatively be set with the OPENSEARCH_PASSWORD environment variable. Can also be omitted if tls certificate authentication will be used instead.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "request_timeout": {
          "type": "string",
          "description": "Timeout for individual requests the provider makes on the opensearch servers in golang duration format. Defaults to 10 seconds.",
          "description_kind": "markdown",
          "optional": true
        },
        "retries": {
          "type": "number",
          "description": "Number of times operations that result in retriable errors should be re-attempted. Defaults to 10.",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Name of the opensearch user that will be used to access opensearch. Can alternatively be set with the OPENSEARCH_USERNAME environment variable. Can also be omitted if tls certificate authentication will be used instead as the username will be infered from the certificate.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "opensearch_ism_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "default_state": {
            "type": "string",
            "description": "Default states that indices will have.",
            "description_kind": "markdown",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Description for the policy.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "policy_id": {
            "type": "string",
            "description": "Unique identifier for the policy.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "ism_template": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "index_patterns": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "Indexes to include with wildcard support.",
                  "description_kind": "markdown",
                  "required": true
                },
                "priority": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Match of the indices to apply the policy on.",
              "description_kind": "markdown"
            }
          },
          "states": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Name of the state.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "block_types": {
                "actions": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "action": {
                        "type": "string",
                        "description": "The action to execute. Currently supports: read_only, read_write, replica_count, open, close, delete, index_priority",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "index_priority": {
                        "type": "number",
                        "description": "Priority to set for the index if the action is index_priority",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "replica_count": {
                        "type": "number",
                        "description": "Replicat count to set for the index if the action is replica_count",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "timeout": {
                        "type": "string",
                        "description": "Time limit to perform the action",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "block_types": {
                      "retry": {
                        "nesting_mode": "set",
                        "block": {
                          "attributes": {
                            "backoff": {
                              "type": "string",
                              "description": "Backoff policy when retrying. Can be: Exponential, Constant and Linear",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "count": {
                              "type": "number",
                              "description": "Number of retries",
                              "description_kind": "markdown",
                              "required": true
                            },
                            "delay": {
                              "type": "string",
                              "description": "Base time to wait between retries",
                              "description_kind": "markdown",
                              "optional": true
                            }
                          },
                          "description": "Retry policy when the action fails",
                          "description_kind": "markdown"
                        },
                        "max_items": 1
                      }
                    },
                    "description": "Actions that should be run when an index reach the state.",
                    "description_kind": "markdown"
                  }
                },
                "transitions": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "state_name": {
                        "type": "string",
                        "description": "Name of the state to transition to.",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "block_types": {
                      "conditions": {
                        "nesting_mode": "set",
                        "block": {
                          "attributes": {
                            "min_doc_count": {
                              "type": "number",
                              "description": "Minimum number of documents after which the index will transition.",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "min_index_age": {
                              "type": "string",
                              "description": "Minimum age at which the index will transition.",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "min_size": {
                              "type": "string",
                              "description": "Minimum size (not counting replication) after which the index will transition.",
                              "description_kind": "markdown",
                              "optional": true
                            }
                          },
                          "description": "Conditions that trigger the state change.",
                          "description_kind": "markdown"
                        },
                        "min_items": 1,
                        "max_items": 1
                      }
                    },
                    "description": "Transition specifications for when an index should transition to another state.",
                    "description_kind": "markdown"
                  }
                }
              },
              "description": "Permissions for index access the role has.",
              "description_kind": "markdown"
            },
            "min_items": 1
          }
        },
        "description": "Opensearch ism policy. Not all the options supported by the api are supported by the provider at this time.",
        "description_kind": "markdown"
      }
    },
    "opensearch_role": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster_permissions": {
            "type": [
              "set",
              "string"
            ],
            "description": "Permissions for cluster wide actions the role has.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the role.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "block_types": {
          "index_permissions": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "allowed_actions": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "document_level_security": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "field_level_security": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "index_patterns": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "masked_fields": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Permissions for index access the role has.",
              "description_kind": "markdown"
            }
          },
          "tenant_permissions": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "allowed_actions": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                },
                "tenant_patterns": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Permissions for tenant access the role has.",
              "description_kind": "markdown"
            }
          }
        },
        "description": "Opensearch role.",
        "description_kind": "markdown"
      }
    },
    "opensearch_role_mapping": {
      "version": 0,
      "block": {
        "attributes": {
          "backend_roles": {
            "type": [
              "set",
              "string"
            ],
            "description": "Backend roles to map to the role.",
            "description_kind": "markdown",
            "optional": true
          },
          "hosts": {
            "type": [
              "set",
              "string"
            ],
            "description": "Hosts to map to the role.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "Role that things should be mapped to.",
            "description_kind": "markdown",
            "required": true
          },
          "users": {
            "type": [
              "set",
              "string"
            ],
            "description": "Users to map to the role.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Opensearch role mapping to map backend roles, users and hosts to a given role.",
        "description_kind": "markdown"
      }
    },
    "opensearch_user": {
      "version": 0,
      "block": {
        "attributes": {
          "backend_roles": {
            "type": [
              "set",
              "string"
            ],
            "description": "Custom roles to assign to the user.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "opendistro_security_roles": {
            "type": [
              "set",
              "string"
            ],
            "description": "Prebuilt security roles to assign to the user.",
            "description_kind": "markdown",
            "optional": true
          },
          "password": {
            "type": "string",
            "description": "Password of the user.",
            "description_kind": "markdown",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "Username of the user.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Opensearch user.",
        "description_kind": "markdown"
      }
    }
  }
}
