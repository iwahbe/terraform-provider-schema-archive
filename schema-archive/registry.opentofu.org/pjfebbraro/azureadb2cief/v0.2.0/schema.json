{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "client_id": {
          "type": "string",
          "description": "The Client ID which should be used for service principal authentication",
          "description_kind": "markdown",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "The application password to use when authenticating as a Service Principal using a Client Secret",
          "description_kind": "markdown",
          "optional": true
        },
        "tenant_id": {
          "type": "string",
          "description": "The Tenant ID which should be used. Works with all authentication methods except Managed Identity",
          "description_kind": "markdown",
          "optional": true
        },
        "use_cli": {
          "type": "bool",
          "description": "Allow Azure CLI to be used for Authentication",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "azureadb2cief_trust_framework_key_set": {
      "version": 1,
      "block": {
        "attributes": {
          "exp": {
            "type": "number",
            "description": "Expiration date, this value is a NumericDate as defined in RFC 7519.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "k": {
            "type": "string",
            "description": "The optional secret value to upload.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "kty": {
            "type": "string",
            "description": "Specifies the key encryption type.  Valid values are 'rsa' and 'oct'",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the key set.  The name must begin with B2C_1A_",
            "description_kind": "markdown",
            "required": true
          },
          "nbf": {
            "type": "number",
            "description": "Not valid before date, this value is a NumericDate as defined in RFC 7519.",
            "description_kind": "markdown",
            "optional": true
          },
          "use": {
            "type": "string",
            "description": "Specifies if the key use is signature or encryption.  Valid values are 'sig' or 'enc'.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "azureadb2cief_trust_framework_policy": {
      "version": 1,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the policy.  The name must begin with B2C_1A_",
            "description_kind": "markdown",
            "required": true
          },
          "policy": {
            "type": "string",
            "description": "The policy XML",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "azureadb2cief_client_config": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "tenant_id": {
            "type": "string",
            "description": "The tenant ID of the authenticated principal",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
