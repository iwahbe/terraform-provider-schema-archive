{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "The API token to use for API requests.",
          "description_kind": "markdown",
          "required": true
        },
        "endpoint": {
          "type": "string",
          "description": "The endpoint to use for API requests.",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "virtfusion_build": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "bool",
            "description": "Server Email",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description": "Server Hostname",
            "description_kind": "markdown",
            "optional": true
          },
          "ipv6": {
            "type": "bool",
            "description": "Server IPv6",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Server Name",
            "description_kind": "markdown",
            "required": true
          },
          "osid": {
            "type": "number",
            "description": "Server Operating System ID",
            "description_kind": "markdown",
            "required": true
          },
          "server_id": {
            "type": "number",
            "description": "Server ID",
            "description_kind": "markdown",
            "required": true
          },
          "ssh_keys": {
            "type": [
              "list",
              "number"
            ],
            "description": "Server SSH Keys IDs",
            "description_kind": "markdown",
            "optional": true
          },
          "vnc": {
            "type": "bool",
            "description": "Server VNC",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Virtfusion Server Build Resource",
        "description_kind": "markdown"
      }
    },
    "virtfusion_server": {
      "version": 0,
      "block": {
        "attributes": {
          "cores": {
            "type": "number",
            "description": "How many cores to allocate. Omit to use the default core count from the package.",
            "description_kind": "markdown",
            "optional": true
          },
          "hypervisor_id": {
            "type": "number",
            "description": "Hypervisor Group ID",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "Server ID",
            "description_kind": "markdown",
            "computed": true
          },
          "inbound_network_speed": {
            "type": "number",
            "description": "Inbound network speed in kB/s. Omit to use the default inbound network speed from the package.",
            "description_kind": "markdown",
            "optional": true
          },
          "ipv4": {
            "type": "number",
            "description": "IPv4 Addresses to assign. Omit to use the default of 1 IPv4.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "memory": {
            "type": "number",
            "description": "How much memory to allocate in MB. Omit to use the default memory size from the package.",
            "description_kind": "markdown",
            "optional": true
          },
          "network_profile": {
            "type": "number",
            "description": "Network profile ID. Omit to use the default network profile from the package.",
            "description_kind": "markdown",
            "optional": true
          },
          "outbound_network_speed": {
            "type": "number",
            "description": "Outbound network speed in kB/s. Omit to use the default outbound network speed from the package.",
            "description_kind": "markdown",
            "optional": true
          },
          "package_id": {
            "type": "number",
            "description": "Package ID",
            "description_kind": "markdown",
            "required": true
          },
          "storage": {
            "type": "number",
            "description": "Primary storage size in GB. Omit to use the default storage size from the package.",
            "description_kind": "markdown",
            "optional": true
          },
          "storage_profile": {
            "type": "number",
            "description": "Storage profile ID. Omit to use the default storage profile from the package.",
            "description_kind": "markdown",
            "optional": true
          },
          "traffic": {
            "type": "number",
            "description": "How much traffic to allocate in GB. Omit to use the default traffic size from the package. 0=Unlimited",
            "description_kind": "markdown",
            "optional": true
          },
          "user_id": {
            "type": "number",
            "description": "User ID",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Virtfusion Server Resource",
        "description_kind": "markdown"
      }
    },
    "virtfusion_ssh": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "number",
            "description": "SSH Key ID",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Key Name",
            "description_kind": "plain",
            "required": true
          },
          "public_key": {
            "type": "string",
            "description": "Public Key",
            "description_kind": "plain",
            "required": true
          },
          "user_id": {
            "type": "number",
            "description": "User ID",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Virtfusion SSH Resource",
        "description_kind": "markdown"
      }
    }
  }
}
