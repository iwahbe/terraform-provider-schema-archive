{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API Key for the VyOS HTTP API",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "endpoint": {
          "type": "string",
          "description": "Endpoint of the VyOS HTTP API",
          "description_kind": "markdown",
          "optional": true
        },
        "save_file": {
          "type": "string",
          "description": "Remote file path to save the config too.",
          "description_kind": "markdown",
          "optional": true
        },
        "skip_saving": {
          "type": "bool",
          "description": "Set to true to skip saving the config to disk.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "vyos_config": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Configuration identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Configuration path",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "JSON configuration for the path",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Configuration Resource",
        "description_kind": "markdown"
      }
    }
  }
}
