{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description": "Password for basic auth (env: PASSWORD).",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "server": {
          "type": "string",
          "description": "URL of the Grantory server (http:// or https://) used for every API interaction. Defaults to http://localhost:8080 when SSH transport is not configured.",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_address": {
          "type": "string",
          "description": "SSH target address in host:port format for unix-socket transport mode.",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_agent_socket_path": {
          "type": "string",
          "description": "Optional path to SSH agent unix socket (overrides SSH_AUTH_SOCK).",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_bastion_address": {
          "type": "string",
          "description": "Optional bastion SSH address in host:port format.",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_bastion_private_key_path": {
          "type": "string",
          "description": "Optional bastion private key path (defaults to ssh_private_key_path).",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_bastion_user": {
          "type": "string",
          "description": "Optional bastion SSH username (defaults to ssh_user).",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_insecure_host_key": {
          "type": "bool",
          "description": "Disable SSH host key validation (not recommended for production).",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_known_hosts_path": {
          "type": "string",
          "description": "Path to OpenSSH known_hosts file for SSH host key validation (used for target and bastion).",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_private_key_path": {
          "type": "string",
          "description": "Path to the SSH private key file used for unix-socket transport mode.",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_socket_path": {
          "type": "string",
          "description": "Remote unix socket path on the SSH target host.",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_timeout_seconds": {
          "type": "number",
          "description": "SSH dial and handshake timeout in seconds.",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_use_agent": {
          "type": "bool",
          "description": "Enable SSH agent authentication (reads from SSH_AUTH_SOCK by default).",
          "description_kind": "plain",
          "optional": true
        },
        "ssh_user": {
          "type": "string",
          "description": "SSH username for unix-socket transport mode.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Bearer token for API requests (env: TOKEN).",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "user": {
          "type": "string",
          "description": "Username for basic auth (env: USER).",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
