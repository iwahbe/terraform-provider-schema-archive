          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "The username for API operations.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ametnes_location": {
      "version": 0,
      "block": {
        "attributes": {
          "code": {
            "type": "string",
            "description": "An easy identifier of the data service location. A combination of the `name` and `code` must be unique.",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Description of the location.",
            "description_kind": "plain",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "`true` if this location is enabled and can have resources created in it.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "location": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the data service location.",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "The status of the data service location. This can be `OFFLINE` or `ONLINE`",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "\nCreates and manages an Ametnes Data Service location.\n",
        "description_kind": "plain"
      }
    },
