            "required": true
          },
          "resource_id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "\nCreates and manages a network access resource. Depending on your kubernetes cluster, this resource may be a load balancer or an object that manages a set of NodePort(s).\n",
        "description_kind": "plain"
