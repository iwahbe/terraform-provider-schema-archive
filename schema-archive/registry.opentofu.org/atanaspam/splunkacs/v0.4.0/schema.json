{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "deployment_name": {
          "type": "string",
          "description": "The URL prefix of your Splunk Cloud Platform deployment (e.g. csms-2io6tw-47150). Can be set via the `SPLUNK_DEPLOYMENT_NAME` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The JWT authentication token you create in Splunk Cloud Platform. Can be set via the `SPLUNK_AUTH_TOKEN` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Splunk Admin Config Service (ACS) provider can interact with the resources supported by the Splunk Admin Config Service. The provider needs to be configured with the proper credentials before it can be used. It requires terraform version 1.0 or later.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "splunkacs_hec_token": {
      "version": 0,
      "block": {
        "attributes": {
          "allowed_indexes": {
            "type": [
              "set",
              "string"
            ],
            "description": "The indexes the HEC Token is allowed to publish data to.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "default_host": {
            "type": "string",
            "description": "The default Splunk host associated with th HEC Token.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "default_index": {
            "type": "string",
            "description": "The default index associated with the HEC Token.",
            "description_kind": "markdown",
            "required": true
          },
          "default_source": {
            "type": "string",
            "description": "The default source value assigned to the data from the HEC Token.",
            "description_kind": "markdown",
            "optional": true
          },
          "default_sourcetype": {
            "type": "string",
            "description": "The default sourcetype assigned to the data from the HEC Token.",
            "description_kind": "markdown",
            "optional": true
          },
          "disabled": {
            "type": "bool",
            "description": "The state of the HEC token.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "ID of the HEC token.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the HEC token.",
            "description_kind": "markdown",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "The token value.",
            "description_kind": "markdown",
            "computed": true
          },
          "use_ack": {
            "type": "bool",
            "description": "Is indexer acknoldegment enabled for the HEC token.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Creates a Http Event Collector Token",
        "description_kind": "markdown"
      }
    },
    "splunkacs_index": {
      "version": 0,
      "block": {
        "attributes": {
          "data_type": {
            "type": "string",
            "description": "The type of data the index holds. Possible values: `event` or `metric`.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the Index.",
            "description_kind": "markdown",
            "computed": true
          },
          "max_data_size_mb": {
            "type": "number",
            "description": "The maximum size of the index in megabytes.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the Index.",
            "description_kind": "markdown",
            "required": true
          },
          "searchable_days": {
            "type": "number",
            "description": "Number of days the index is searchable.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "total_event_count": {
            "type": "string",
            "description": "The total number of events in the index.",
            "description_kind": "markdown",
            "computed": true
          },
          "total_raw_size_mb": {
            "type": "string",
            "description": "The total amount of raw data in the index in megabytes.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Creates a Splunk Index",
        "description_kind": "markdown"
      }
    }
  },
