{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "The host for the PostHog API. **Default** `app.posthog.com`",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The token used to authenticate with PostHog.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "posthog_project": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "number",
            "description": "Identifier of the project.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the project.",
            "description_kind": "markdown",
            "required": true
          },
          "organization_id": {
            "type": "string",
            "description": "Identifier of the organization the project belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "API token of the project.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "PostHog project.",
        "description_kind": "markdown"
      }
    }
  }
}
