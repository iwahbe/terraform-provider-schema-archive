      "attributes": {
        "api_key": {
          "type": "string",
          "description": "GoDaddy API Key. Can also be set via GODADDY_API_KEY environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "api_secret": {
          "type": "string",
          "description": "GoDaddy API Secret. Can also be set via GODADDY_API_SECRET environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "environment": {
          "type": "string",
          "description": "GoDaddy API environment. Valid values are 'production' (default) and 'test'. Can also be set via GODADDY_ENVIRONMENT environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Terraform provider for managing GoDaddy domains and DNS records.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "godaddy_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_overwrite": {
            "type": "bool",
            "description": "Allow overwriting existing DNS records with the same type and name. When set to true, if a DNS record with the same domain, type, and name already exists, it will be replaced with the new configuration. When false (default), creation will fail if a conflicting record exists. This is useful for migrating existing DNS records to Terraform management.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "data": {
            "type": "string",
            "description": "The value of the record. Format varies by record type:\n- A: IPv4 address (e.g., 192.0.2.1)\n- AAAA: IPv6 address (e.g., 2001:db8::1)\n- CNAME: Target domain name (e.g., example.com)\n- MX: Mail server hostname (e.g., mail.example.com)\n- TXT: Text content (e.g., 'v=spf1 include:_spf.google.com ~all')\n- SRV: Target hostname (e.g., target.example.com)\n- CAA: CAA record format (e.g., '0 issue letsencrypt.org')\n- NS: Nameserver hostname (e.g., ns1.example.com)",
            "description_kind": "markdown",
            "required": true
          },
          "domain": {
            "type": "string",
            "description": "The domain name to add the record to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier for the DNS record.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The subdomain name for the record. Use @ for the root domain.",
            "description_kind": "markdown",
            "required": true
          },
          "port": {
            "type": "number",
            "description": "Port number for SRV records (1-65535).",
            "description_kind": "markdown",
            "optional": true
          },
          "priority": {
            "type": "number",
            "description": "Priority for MX, SRV, NAPTR, and URI records (0-65535). Lower values have higher priority.",
            "description_kind": "markdown",
            "optional": true
          },
          "protocol": {
            "type": "string",
            "description": "Protocol for SRV records (e.g., _tcp, _udp). Must start with underscore.",
            "description_kind": "markdown",
            "optional": true
          },
          "service": {
            "type": "string",
            "description": "Service name for SRV records (e.g., _sip, _http). Must start with underscore.",
            "description_kind": "markdown",
            "optional": true
          },
          "ttl": {
            "type": "number",
            "description": "Time to live in seconds (minimum 600, maximum 2592000).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The DNS record type. Supported types: A, AAAA, CAA, CNAME, MX, NS, PTR, SOA, SRV, TXT, DS, SSHFP, TLSA, LOC, NAPTR, URI, CERT, DNAME.",
            "description_kind": "markdown",
            "required": true
          },
          "weight": {
            "type": "number",
            "description": "Weight for SRV and URI records (0-65535). Used for load balancing among records with the same priority.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages a DNS record for a GoDaddy domain.",
        "description_kind": "markdown"
      }
    },
