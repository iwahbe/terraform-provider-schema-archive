    "elasticsearch_api_key": {
      "version": 0,
      "block": {
        "attributes": {
          "api_key": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "expiration": {
            "type": "string",
            "description": "Expiration time for the API key. By default, API keys never expire.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Specifies the name for this API key.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "role_descriptors": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "cluster": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "A list of cluster privileges. \n\t\t\tThese privileges define the cluster level actions that users with this role are able to execute.",
                  "description_kind": "plain",
                  "required": true
                },
                "metadata": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "Optional meta-data. Within the metadata object, keys that begin with _ are reserved for system usage.",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the role.",
                  "description_kind": "plain",
                  "required": true
                },
                "run_as": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "A list of users that the owners of this role can impersonate. \n\t\t\tFor more information, see https://www.elastic.co/guide/en/elasticsearch/reference/current/run-as-privilege.html",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "block_types": {
                "applications": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "The name of the application to which this entry applies",
                        "description_kind": "plain",
                        "required": true
                      },
                      "privileges": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "A list of strings, where each element is the name of an application privilege or action.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "resources": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "A list resources to which the privileges are applied.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "A list of application privilege entries.",
                    "description_kind": "plain"
                  }
                },
                "indices": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "allow_restricted_indices": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "names": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "A list of indices (or index name patterns) to which the permissions in this entry apply.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "privileges": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "The index level privileges that the owners of the role have on the specified indices.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "query": {
                        "type": "string",
                        "description": "\n\t\t\tA search query that defines the documents the owners of the role have read access to. \n\t\t\tA document within the specified indices must match this query in order for it to be accessible by the owners of the role.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "block_types": {
                      "field_security": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "grant": {
                              "type": [
                                "list",
                                "string"
                              ],
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "description": "The document fields that the owners of the role have read access to. \n\t\t\tFor more information, see https://www.elastic.co/guide/en/elasticsearch/reference/current/field-and-document-access-control.html",
                          "description_kind": "plain"
                        },
                        "max_items": 1
                      }
                    },
                    "description": "A list of indices permissions entries.",
                    "description_kind": "plain"
                  }
                }
              },
              "description": "An array of role descriptors for this API key. \n\t\t\tThis parameter is optional. When it is not specified or is an empty array, \n\t\t\tthen the API key will have a point in time snapshot of permissions of the authenticated user. \n\t\t\tIf you supply role descriptors then the resultant permissions would be an intersection of \n\t\t\tAPI keys permissions and authenticated user\u2019s permissions thereby limiting the access scope for API keys.\n\t\t\tThe structure of role descriptor is the same as the request for create role API. \n\t\t\tFor more details, see https://www.elastic.co/guide/en/elasticsearch/reference/current/security-api-put-role.html.",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
