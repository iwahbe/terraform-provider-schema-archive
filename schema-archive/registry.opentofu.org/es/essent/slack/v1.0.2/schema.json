{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "slack_token": {
          "type": "string",
          "description": "The Slack token used for API authentication. It can be provided in the provider block or via the `SLACK_TOKEN` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Slack provider allows you to manage Slack resources. Use it to create, read, update, and delete Slack entities.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "slack_usergroup": {
      "version": 0,
      "block": {
        "attributes": {
          "channels": {
            "type": [
              "list",
              "string"
            ],
            "description": "Channels shared by the user group.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "handle": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "prevent_conflicts": {
            "type": "bool",
            "description": "If true, the plan fails if there's an enabled user group with the same name or handle.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "users": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of user IDs in the user group.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a Slack user group.\n\nThis resource requires the following scopes:\n\n- usergroups:write\n- usergroups:read",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "slack_all_usergroups": {
      "version": 0,
      "block": {
        "attributes": {
          "total_usergroups": {
            "type": "number",
            "description": "Total number of user groups retrieved.",
            "description_kind": "plain",
            "computed": true
          },
          "usergroups": {
            "nested_type": {
              "attributes": {
                "channels": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Channels shared by the user group.",
                  "description_kind": "plain",
                  "computed": true
                },
                "description": {
                  "type": "string",
                  "description": "Description of the user group.",
                  "description_kind": "plain",
                  "computed": true
                },
                "handle": {
                  "type": "string",
                  "description": "Handle of the user group (unique identifier).",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "User group's Slack ID.",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the user group.",
                  "description_kind": "plain",
                  "computed": true
                },
                "users": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of user IDs in the user group.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of Slack user groups.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieve a list of all Slack user groups.\n\nThis datasource requires the following scopes:\n\n- usergroups:read",
        "description_kind": "markdown"
      }
    },
    "slack_all_users": {
      "version": 0,
      "block": {
        "attributes": {
          "total_users": {
            "type": "number",
            "description": "Number of users returned.",
            "description_kind": "plain",
            "computed": true
          },
          "users": {
            "nested_type": {
              "attributes": {
                "email": {
                  "type": "string",
                  "description": "User's email address.",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "User's Slack ID.",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "User's name.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of activated and non-bot Slack users.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Retrieve a list of all activated and non-bot Slack users.\n\nThis datasource requires the following scopes:\n\n- users:read",
        "description_kind": "markdown"
      }
    },
    "slack_conversation": {
      "version": 0,
      "block": {
        "attributes": {
          "channel_id": {
            "type": "string",
            "description": "The Slack channel ID to look up.",
            "description_kind": "markdown",
            "required": true
          },
          "created": {
            "type": "number",
            "description": "UNIX timestamp when the channel was created.",
            "description_kind": "markdown",
            "computed": true
          },
          "creator": {
            "type": "string",
            "description": "User ID of the channel creator.",
            "description_kind": "markdown",
            "computed": true
          },
          "is_archived": {
            "type": "bool",
            "description": "True if the channel is archived.",
            "description_kind": "markdown",
            "computed": true
          },
          "is_ext_shared": {
            "type": "bool",
            "description": "True if the channel is externally shared.",
            "description_kind": "markdown",
            "computed": true
          },
          "is_general": {
            "type": "bool",
            "description": "True if this is the #general channel.",
            "description_kind": "markdown",
            "computed": true
          },
          "is_org_shared": {
            "type": "bool",
            "description": "True if the channel is shared across the org.",
            "description_kind": "markdown",
            "computed": true
          },
          "is_shared": {
            "type": "bool",
            "description": "True if the channel is shared.",
            "description_kind": "markdown",
            "computed": true
          },
          "purpose": {
            "type": "string",
            "description": "The channel purpose.",
            "description_kind": "markdown",
            "computed": true
          },
          "topic": {
            "type": "string",
            "description": "The channel topic.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieve information about a Slack conversation by its ID.\n\nThis datasource requires the following scopes:\n\n- channels:read (public channels)\n- groups:read (private channels)\n- im:read (optional)\n- mpim:read (optional)",
        "description_kind": "markdown"
      }
    },
    "slack_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "Email of the user to look up.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Slack user ID to look up.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "User's name.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieve Slack user information. Either 'id' or 'email' must be specified, but not both.\n\nThis datasource requires the following scopes:\n\n- users:read.email\n- users:read",
        "description_kind": "markdown"
      }
    }
  }
}
