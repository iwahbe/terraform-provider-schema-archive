{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "URL for the ECK API.  Can also be supplied as the environment variable `ECK_HOST`.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password for the ECK API.  Can also be supplied as the environment variable `ECK_PASSWORD`.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "project": {
          "type": "string",
          "description": "OpenStack Project UUID for the ECK API.  Can also be supplied as the environment variable `ECK_PROJECT`.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Username for the ECK API.  Can also be supplied as the environment variable `ECK_USERNAME`.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "eck_cluster": {
      "version": 0,
      "block": {
        "attributes": {
          "applicationbundle": {
            "type": "string",
            "description": "The version of the bundled components in the cluster.  See https://docs.eschercloud.ai/Kubernetes/Reference/compatibility_matrix for details.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "clusterfeatures": {
            "nested_type": {
              "attributes": {
                "autoscaling": {
                  "type": "bool",
                  "description": "Enables Cluster Autoscaler, required for autoscaling workload pools.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "dashboard": {
                  "type": "bool",
                  "description": "Whether to enable the Kubernetes Dashboard.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "ingress": {
                  "type": "bool",
                  "description": "Whether to deploy an Ingress Controller (NGINX).",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "longhorn": {
                  "type": "bool",
                  "description": "Whether to enable Longhorn for persistent storage, which includes support for RWX.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "prometheus": {
                  "type": "bool",
                  "description": "Whether to enable the Prometheus Operator for monitoring.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Extra features allowing management of additional Kubernetes features that are considered standard.",
            "description_kind": "plain",
            "optional": true
          },
          "clusternetwork": {
            "nested_type": {
              "attributes": {
                "dnsnameservers": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "A list of DNS nameservers used by the OS.",
                  "description_kind": "plain",
                  "optional": true
                },
                "nodeprefix": {
                  "type": "string",
                  "description": "The CIDR-formatted IP address range to be used by Nodes in the cluster.",
                  "description_kind": "plain",
                  "optional": true
                },
                "podprefix": {
                  "type": "string",
                  "description": "The CIDR-formatted IP address range to be used by Pods in the cluster.",
                  "description_kind": "plain",
                  "optional": true
                },
                "serviceprefix": {
                  "type": "string",
                  "description": "The CIDR-formatted IP address range to be used by Services in the cluster.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "required": true
          },
          "clusteropenstack": {
            "nested_type": {
              "attributes": {
                "computeaz": {
                  "type": "string",
                  "description": "OpenStack Compute Availability Zone. Defaults to `nova`.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "externalnetworkid": {
                  "type": "string",
                  "description": "UUID of the external network.",
                  "description_kind": "plain",
                  "optional": true
                },
                "sshkey": {
                  "type": "string",
                  "description": "SSH key associated with the instance.",
                  "description_kind": "plain",
                  "optional": true
                },
                "volumeaz": {
                  "type": "string",
                  "description": "OpenStack Cinder Availability Zone. Defaults to `nova`.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          },
          "controlplane": {
            "nested_type": {
              "attributes": {
                "disk": {
                  "type": "number",
                  "description": "Whether to use a dedicated persistent volume for control plane nodes. It is recommended to leave this unchecked, as ephemeral storage provides higher performance for Kubernetes' etcd database. If left unset, the default ephemeral storage size of 20GB is used.",
                  "description_kind": "plain",
                  "optional": true
                },
                "flavor": {
                  "type": "string",
                  "description": "The flavor (size) of the machine.",
                  "description_kind": "plain",
                  "required": true
                },
                "image": {
                  "type": "string",
                  "description": "Which OS image to use.  Must be a verified and signed ECK image",
                  "description_kind": "plain",
                  "required": true
                },
                "replicas": {
                  "type": "number",
                  "description": "How many replicas to provision in a control plane.  Must be an odd number, 3 is recommended.",
                  "description_kind": "plain",
                  "required": true
                },
                "version": {
                  "type": "string",
                  "description": "The version of Kubernetes.  Must match the version bundled with the OS image.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "required": true
          },
          "eckcp": {
            "type": "string",
            "description": "The associated ECK Control Plane for the cluster.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "kubeconfig": {
            "type": "string",
            "description": "The kubeconfig for the cluster.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the ECK cluster.",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "The provisioning status of the cluster.",
            "description_kind": "plain",
            "computed": true
          },
          "wait": {
            "type": "bool",
            "description": "Whether to wait for the cluster to be provisioned",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "workloadnodepools": {
            "nested_type": {
              "attributes": {
                "autoscaling": {
                  "nested_type": {
                    "attributes": {
                      "maximum": {
                        "type": "number",
                        "description": "Maximum number of nodes in this pool.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "minimum": {
                        "type": "number",
                        "description": "Minimum number of nodes in this pool.",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Configuration options for the autoscaler.",
                  "description_kind": "plain",
                  "optional": true
                },
                "disk": {
                  "type": "number",
                  "description": "Size of disk for the node.  Defaults to 50GiB.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "flavor": {
                  "type": "string",
                  "description": "OpenStack flavor (size) for nodes in this pool.",
                  "description_kind": "plain",
                  "required": true
                },
                "image": {
                  "type": "string",
                  "description": "Operating system image to use.  Must be a valid and signed ECK image.",
                  "description_kind": "plain",
                  "required": true
                },
                "labels": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "A map of Kubernetes labels to be applied to each node in the pool.",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the workload pool.",
                  "description_kind": "plain",
                  "required": true
                },
                "replicas": {
                  "type": "number",
                  "description": "How many replicas in this workload pool.",
                  "description_kind": "plain",
                  "required": true
                },
                "version": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "eck_controlplane": {
      "version": 0,
      "block": {
        "attributes": {
          "applicationbundle": {
            "nested_type": {
              "attributes": {
                "autoupgrade": {
                  "type": "bool",
                  "description": "Whether automatic upgrades of the ECK Control Plane are enabled. If enabled, perform upgrades randomly from Monday-Friday 00:00-07:00 UTC.",
                  "description_kind": "plain",
                  "required": true
                },
                "version": {
                  "type": "string",
                  "description": "The version of the ECK Control Plane. Defaults to 1.4.0.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the ECK Control Plane.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
