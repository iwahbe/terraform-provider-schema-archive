      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ipaddr": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "mac": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "subnet": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "iris_dhcp_subnet": {
