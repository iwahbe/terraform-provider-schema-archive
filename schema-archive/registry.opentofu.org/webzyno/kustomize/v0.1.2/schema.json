            "description_kind": "plain",
            "computed": true
          },
          "images": {
            "nested_type": {
              "attributes": {
                "digest": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "new_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "new_tag": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "images is a list of (image name, new name, new tag or digest) for changing image names, tags or digests. This can also be achieved with a patch, but this operator is simpler to specify.",
            "description_kind": "plain",
            "optional": true
          },
          "labels": {
            "nested_type": {
              "attributes": {
                "fields": {
                  "nested_type": {
                    "attributes": {
                      "create": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "group": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "kind": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "path": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "version": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "fields completely specifies a kustomizable field in a k8s API object. It helps define the operands of transformations",
                  "description_kind": "plain",
                  "optional": true
                },
                "include_selectors": {
                  "type": "bool",
                  "description": "include_selectors inidicates should transformer include the fieldSpecs for selectors",
                  "description_kind": "plain",
                  "optional": true
                },
                "include_templates": {
                  "type": "bool",
                  "description": "include_templates inidicates should transformer include the template labels",
                  "description_kind": "plain",
                  "optional": true
                },
                "pairs": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "pairs contains the key-value pairs for labels to add",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "labels to add to all objects but not selectors",
            "description_kind": "plain",
            "optional": true
          },
          "name_prefix": {
            "type": "string",
            "description": "name_prefix will prefix the names of all resources mentioned in the kustomization file including generated configmaps and secrets",
            "description_kind": "plain",
            "optional": true
          },
          "name_suffix": {
            "type": "string",
            "description": "name_suffix will suffix the names of all resources mentioned in the kustomization file including generated configmaps and secrets",
            "description_kind": "plain",
            "optional": true
          },
          "namespace": {
            "type": "string",
            "description": "namespace to add to all objects",
            "description_kind": "plain",
            "optional": true
          },
          "openapi": {
            "type": [
              "map",
              "string"
            ],
            "description": "openapi contains information about what kubernetes schema to use",
            "description_kind": "plain",
            "optional": true
          },
          "patches": {
            "nested_type": {
              "attributes": {
                "patch": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "path": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "target": {
                  "nested_type": {
                    "attributes": {
                      "annotation_selector": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "group": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "kind": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "label_selector": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "name": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "namespace": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "version": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Refers to a Kubernetes object that the patch will be applied to. It must refer to a Kubernetes resource under the purview of this kustomization",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Apply a patch to multiple resources",
            "description_kind": "plain",
            "optional": true
          },
          "replacements": {
            "nested_type": {
              "attributes": {
                "path": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "source": {
                  "nested_type": {
                    "attributes": {
                      "field_path": {
                        "type": "string",
                        "description": "The structured path to the source value",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "group": {
                        "type": "string",
                        "description": "The group of the referent",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "kind": {
                        "type": "string",
                        "description": "The kind of the referent",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "name": {
                        "type": "string",
                        "description": "The name of the referent",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "namespace": {
                        "type": "string",
                        "description": "The namespace of the referent",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "options": {
                        "nested_type": {
                          "attributes": {
                            "create": {
                              "type": "bool",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "delimiter": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "index": {
                              "type": "number",
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true
                      },
                      "version": {
                        "type": "string",
                        "description": "The version of the referent",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "The source of the value",
                  "description_kind": "plain",
                  "optional": true
                },
                "targets": {
                  "nested_type": {
                    "attributes": {
                      "field_paths": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "The structured path(s) to the target nodes",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "options": {
                        "nested_type": {
                          "attributes": {
                            "create": {
                              "type": "bool",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "delimiter": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "index": {
                              "type": "number",
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true
                      },
                      "reject": {
                        "nested_type": {
                          "attributes": {
                            "group": {
                              "type": "string",
                              "description": "The group of the referent",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "kind": {
                              "type": "string",
                              "description": "The kind of the referent",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "name": {
                              "type": "string",
                              "description": "The name of the referent",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "namespace": {
                              "type": "string",
                              "description": "The namespace of the referent",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "version": {
                              "type": "string",
                              "description": "The version of the referent",
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description": "Exclude objects that match this",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "select": {
                        "nested_type": {
                          "attributes": {
                            "group": {
                              "type": "string",
                              "description": "The group of the referent",
                              "description_kind": "plain",
