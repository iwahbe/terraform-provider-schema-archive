{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "server": {
          "type": "string",
          "description": "Woodpecker CI server url. It must be provided, but\n\t\t\t\t\tcan also be sourced from the WOODPECKER_TOKEN environment\n\t\t\t\t\tvariable.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Woodpecker CI API token (can be found on /user\n\t\t\t\t\tas \\\"Your Personal Token\\\"). It must be provided, but\n\t\t\t\t\tcan also be sourced from the WOODPECKER_TOKEN environment\n\t\t\t\t\tvariable.",
          "description_kind": "plain",
          "optional": true
        },
        "verify": {
          "type": "bool",
          "description": "Whether to verify SSL certificates when \n\t\t\t\t\tinteracting with Woodpecker CI. It can also be sourced\n\t\t\t\t\tfrom the WOODPECKER_TOKEN environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "A Terraform provider for configuring the [Woodpecker CI](https://woodpecker-ci.org/) engine.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "woodpecker_organization_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "events": {
            "type": [
              "set",
              "string"
            ],
            "description": "One or more event types where secret is available (one of push, tag, pull_request, deployment, cron, manual)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "images": {
            "type": [
              "set",
              "string"
            ],
            "description": "List of images where this secret is available, leave empty to allow all images",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Secret Name",
            "description_kind": "plain",
            "required": true
          },
          "owner": {
            "type": "string",
            "description": "Organization name",
            "description_kind": "plain",
            "required": true
          },
          "plugins_only": {
            "type": "bool",
            "description": "Whether secret is only available for plugins",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "value": {
            "type": "string",
            "description": "Secret Value",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Provides a organization secret. For more \n\t\tinformation see [Woodpecker CI's documentation](https://woodpecker-ci.org/docs/usage/secrets)",
        "description_kind": "markdown"
      }
    },
    "woodpecker_repository": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_pull": {
            "type": "bool",
