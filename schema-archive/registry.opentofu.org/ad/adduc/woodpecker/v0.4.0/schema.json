            "optional": true,
            "computed": true
          },
          "is_trusted": {
            "type": "bool",
            "description": "If true, underlying pipeline containers get access to escalated capabilities like mounting volumes.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "Kind of repository (e.g. git)",
            "description_kind": "plain",
            "computed": true
