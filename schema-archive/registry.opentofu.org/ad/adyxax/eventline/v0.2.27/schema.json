    "eventline_jobs": {
      "version": 0,
      "block": {
        "attributes": {
          "elements": {
            "nested_type": {
              "attributes": {
                "disabled": {
                  "type": "bool",
                  "description": "Whether the job is disabled or not.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "The identifier of the job.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "spec": {
                  "nested_type": {
                    "attributes": {
                      "concurrent": {
                        "type": "bool",
                        "description": "Whether to allow concurrent executions for this job or not.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "description": {
                        "type": "string",
                        "description": "A textual description of the job.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "environment": {
                        "type": [
                          "map",
                          "string"
                        ],
                        "description": "A set of environment variables mapping names to values to be defined during job execution.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "identities": {
                        "type": [
                          "set",
                          "string"
                        ],
                        "description": "Set of eventline identities names to inject during job execution.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "name": {
                        "type": "string",
                        "description": "The name of the job.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "parameters": {
                        "nested_type": {
                          "attributes": {
                            "description": {
                              "type": "string",
                              "description": "A textual description of the parameter.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "environment": {
                              "type": "string",
                              "description": "The name of an environment variable to be used to inject the value of this parameter during execution.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "name": {
                              "type": "string",
                              "description": "The name of the parameter.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "type": {
                              "type": "string",
                              "description": "The type of the parameter. The following types are supported:\n  - number: Either an integer or an IEEE 754 double precision floating point value.\n  - integer: An integer.\n  - string: A character string.\n  - boolean: A boolean.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "values": {
                              "type": [
                                "list",
                                "string"
                              ],
                              "description": "For parameters of type string, the list of valid values.",
                              "description_kind": "markdown",
                              "computed": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description_kind": "plain",
                        "computed": true
                      },
                      "retention": {
                        "type": "number",
                        "description": "The number of days after which past executions of this job will be deleted. This value override the global job_retention setting.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "runner": {
                        "nested_type": {
                          "attributes": {
                            "identity": {
                              "type": "string",
                              "description": "The name of an identity to use for runners which require authentication. For example the ssh runner needs an identity to initiate an ssh connection.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "name": {
                              "type": "string",
                              "description": "The name of the runner.",
                              "description_kind": "markdown",
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description": "The specification of the runner used to execute the job.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "steps": {
                        "nested_type": {
                          "attributes": {
                            "code": {
                              "type": "string",
                              "description": "The fragment of code to execute for this step.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "command": {
                              "nested_type": {
                                "attributes": {
                                  "arguments": {
                                    "type": [
                                      "list",
                                      "string"
                                    ],
                                    "description": "The list of arguments to pass to the command.",
                                    "description_kind": "markdown",
                                    "computed": true
                                  },
                                  "name": {
                                    "type": "string",
                                    "description": "The name of the command.",
                                    "description_kind": "markdown",
                                    "computed": true
                                  }
                                },
                                "nesting_mode": "single"
                              },
                              "description": "The command to execute for this step.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "label": {
                              "type": "string",
                              "description": "A short description of the step which will be displayed on the web interface.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "script": {
                              "nested_type": {
                                "attributes": {
                                  "arguments": {
                                    "type": [
                                      "list",
                                      "string"
                                    ],
                                    "description": "The list of arguments to pass to the script.",
                                    "description_kind": "markdown",
                                    "computed": true
                                  },
                                  "content": {
                                    "type": "string",
                                    "description": "The script file contents.",
                                    "description_kind": "markdown",
                                    "computed": true
                                  },
                                  "path": {
                                    "type": "string",
                                    "description": "The path of the script file relative to the job file.",
                                    "description_kind": "markdown",
                                    "computed": true
                                  }
                                },
                                "nesting_mode": "single"
                              },
                              "description": "The command to execute for this step.",
                              "description_kind": "markdown",
                              "computed": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description": "A list of steps which will be executed sequentially.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "trigger": {
                        "nested_type": {
                          "attributes": {
                            "event": {
                              "type": "string",
                              "description": "The event to react to formatted as <connector>/<event>.",
                              "description_kind": "markdown",
                              "computed": true
                            },
                            "identity": {
                              "type": "string",
                              "description": "The name of an identity to use for events which require authentication. For example the github/push event needs an identity to create the GitHub hook used to listen to push events.",
                              "description_kind": "markdown",
                              "computed": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description": "The specification of a trigger indicating when to execute the job.",
                        "description_kind": "markdown",
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "The specification of the job.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The list of jobs.",
            "description_kind": "markdown",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "The identifier of the project the jobs are part of.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Use this data source to retrieve information about existing eventline jobs.",
        "description_kind": "markdown"
      }
    },
    "eventline_project": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The identifier of the project.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the project.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Use this data source to retrieve information about an existing eventline project from its name.",
        "description_kind": "markdown"
      }
    },
