              "attributes": {
                "id": {
                  "type": "string",
                  "description": "The identifier of the project.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the project.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The list of projects.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Use this data source to retrieve information about existing eventline projects.",
        "description_kind": "markdown"
      }
    }
  }
