{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "The base API url. Default is production https://api.paypal.com, but you can set it to the sandbox URL",
          "description_kind": "plain",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "Your PayPal OAuth Client ID. You can get this from your developer dashboard https://developer.paypal.com/developer/applications",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "client_secret": {
          "type": "string",
          "description": "Your PayPal OAuth Client Secret. You can get this from your developer dashboard https://developer.paypal.com/developer/applications",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "paypal_catalog_product": {
      "version": 0,
      "block": {
        "attributes": {
          "category": {
            "type": "string",
            "description": "A product category from the following list: https://developer.paypal.com/api/catalog-products/v1/#products_get",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "The description of the product",
            "description_kind": "plain",
            "optional": true
          },
          "home_url": {
            "type": "string",
            "description": "A URL to product information",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "image_url": {
            "type": "string",
            "description": "An externally hosted image of the product",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the product",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "A product type. One of: physical,digital,service",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "paypal_notification_webhook": {
      "version": 0,
      "block": {
        "attributes": {
          "event_types": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of event types",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "The URL that Paypal will send notifications to",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "paypal_subscription_plan": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "The drescription of the subscription plan",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the subscription plan",
            "description_kind": "plain",
            "required": true
          },
          "product_id": {
            "type": "string",
            "description": "The ID of the product this plan is for",
            "description_kind": "plain",
            "required": true
          },
          "quantity_supported": {
            "type": "bool",
            "description": "Indicates whether you can subscribe to this plan by providing a quantity for the goods or service",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "The status of the subscription plan",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "billing_cycle": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "sequence": {
                  "type": "number",
                  "description": "The order in which this cycle is to run among other billing cycles. For example, a trial billing cycle has a sequence of 1 while a regular billing cycle has a sequence of 2, so that trial cycle runs before the regular cycle.",
                  "description_kind": "plain",
                  "required": true
                },
                "tenure_type": {
                  "type": "string",
                  "description": "One of: regular,trial",
                  "description_kind": "plain",
                  "required": true
                },
                "total_cycles": {
                  "type": "number",
                  "description": "he number of times this billing cycle gets executed. Trial billing cycles can only be executed a finite number of times (value between 1 and 999 for total_cycles). Regular billing cycles can be executed infinite times (value of 0 for total_cycles) or a finite number of times (value between 1 and 999 for total_cycles).",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "frequency": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "interval_count": {
                        "type": "number",
                        "description": "The number of intervals after which a subscriber is billed. For example, if the interval_unit is DAY with an interval_count of 2, the subscription is billed once every two days.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "interval_unit": {
                        "type": "string",
                        "description": "One of: day,week,month,year",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "min_items": 1,
                  "max_items": 1
                },
                "pricing_scheme": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "version": {
                        "type": "number",
                        "description_kind": "plain",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "block_types": {
                      "fixed_price": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "currency_code": {
                              "type": "string",
                              "description": "The three-character ISO-4217 currency code",
                              "description_kind": "plain",
                              "required": true
                            },
                            "value": {
                              "type": "string",
                              "description": "More info: https://developer.paypal.com/docs/api/payments.billing-plans/v1/#definition-currency",
                              "description_kind": "plain",
                              "required": true
                            }
                          },
                          "description_kind": "plain"
                        },
                        "min_items": 1,
                        "max_items": 1
                      }
                    },
                    "description_kind": "plain"
                  },
                  "min_items": 1,
                  "max_items": 1
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 3
          },
          "payment_preferences": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "auto_bill_outstanding": {
                  "type": "bool",
                  "description": "Indicates whether to automatically bill the outstanding amount in the next billing cycle.",
                  "description_kind": "plain",
                  "required": true
                },
                "payment_failure_threshold": {
                  "type": "number",
                  "description": "The maximum number of payment failures before a subscription is suspended. For example, if payment_failure_threshold is 2, the subscription automatically updates to the SUSPEND state if two consecutive payments fail.",
                  "description_kind": "plain",
                  "required": true
                },
                "setup_fee_failure_action": {
                  "type": "string",
                  "description": "One of: continue,cancel",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "setup_fee": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "currency_code": {
                        "type": "string",
                        "description": "The three-character ISO-4217 currency code",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value": {
                        "type": "string",
                        "description": "More info: https://developer.paypal.com/docs/api/payments.billing-plans/v1/#definition-currency",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "min_items": 1,
                  "max_items": 1
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          },
          "taxes": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "inclusive": {
                  "type": "bool",
                  "description_kind": "plain",
                  "required": true
                },
                "percentage": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
