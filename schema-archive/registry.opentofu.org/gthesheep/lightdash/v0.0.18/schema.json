{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description": "Password for your Lightdash account",
          "description_kind": "plain",
          "optional": true
        },
        "personal_access_token": {
          "type": "string",
          "description": "Personal Access Token for your Lightdash account",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "URL for your Lightdash instance",
          "description_kind": "plain",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "Username for your Lightdash account",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "lightdash_project": {
      "version": 0,
      "block": {
        "attributes": {
          "databricks_connection_catalog": {
            "type": "string",
            "description": "Databricks - Catalog name for connection",
            "description_kind": "plain",
            "optional": true
          },
          "databricks_connection_http_path": {
            "type": "string",
            "description": "Databricks - HTTP path for connection",
            "description_kind": "plain",
            "optional": true
          },
          "databricks_connection_personal_access_token": {
            "type": "string",
            "description": "Databricks - Personal access token for connection",
            "description_kind": "plain",
            "optional": true
          },
          "databricks_connection_schema": {
            "type": "string",
            "description": "Databricks - Schema name for connection",
            "description_kind": "plain",
            "optional": true
          },
          "databricks_connection_server_host_name": {
            "type": "string",
            "description": "Databricks - Server host name for connection",
            "description_kind": "plain",
            "optional": true
          },
          "dbt_connection_branch": {
            "type": "string",
            "description": "Branch to use, default 'main'",
            "description_kind": "plain",
            "optional": true
          },
          "dbt_connection_host_domain": {
            "type": "string",
            "description": "Host domain of the repo, default 'github.com'",
            "description_kind": "plain",
            "optional": true
          },
          "dbt_connection_personal_access_token": {
            "type": "string",
            "description": "Personal access token to authenticate with Git provider",
            "description_kind": "plain",
            "optional": true
          },
          "dbt_connection_project_sub_path": {
            "type": "string",
            "description": "Sub path to find the project in the repo, default '/'",
            "description_kind": "plain",
            "optional": true
          },
          "dbt_connection_repository": {
            "type": "string",
            "description": "Repository name in <org>/<repo> format",
            "description_kind": "plain",
            "required": true
          },
          "dbt_connection_type": {
            "type": "string",
            "description": "dbt project connection type, currently only support 'github', which is the default",
            "description_kind": "plain",
            "optional": true
          },
          "dbt_version": {
            "type": "string",
            "description": "dbt version, defaults to v1.8",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Project name",
            "description_kind": "plain",
            "required": true
          },
          "organization_uuid": {
            "type": "string",
            "description": "UUID of the organization to create the project in",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "type": {
            "type": "string",
            "description": "Type of project to create, either DEFAULT or DEVELOPMENT",
            "description_kind": "plain",
            "required": true
          },
          "warehouse_connection_account": {
            "type": "string",
            "description": "Snowflake - Account identifier, including region/ cloud path",
            "description_kind": "plain",
            "optional": true
          },
          "warehouse_connection_client_session_keep_alive": {
            "type": "bool",
            "description": "Snowflake - Client session keep alive param, default `false`",
            "description_kind": "plain",
            "optional": true
          },
          "warehouse_connection_database": {
            "type": "string",
            "description": "Snowflake - Database to connect to",
            "description_kind": "plain",
            "optional": true
          },
          "warehouse_connection_role": {
            "type": "string",
            "description": "Snowflake - Role to connect to the warehouse with",
            "description_kind": "plain",
            "optional": true
          },
          "warehouse_connection_schema": {
            "type": "string",
            "description": "Snowflake - Schema to connect to, default 'PUBLIC'",
            "description_kind": "plain",
            "optional": true
          },
          "warehouse_connection_threads": {
            "type": "number",
            "description": "Snowflake - Number of threads to use, default `1`",
            "description_kind": "plain",
            "optional": true
          },
          "warehouse_connection_type": {
            "type": "string",
            "description": "Type of warehouse to connect to, must be one of 'snowflake' or 'databricks', 'snowflake' is the default",
            "description_kind": "plain",
            "optional": true
          },
          "warehouse_connection_warehouse": {
            "type": "string",
            "description": "Snowflake - Warehouse to use",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "lightdash_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "User email address to send invite link to",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "invite_code": {
            "type": "string",
            "description": "Original invite code for the user",
            "description_kind": "plain",
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "Type of role for the user, one of viewer/ editor/ admin",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "lightdash_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Given name for organizatiom",
            "description_kind": "plain",
            "computed": true
          },
          "organization_uuid": {
            "type": "string",
            "description": "UUID of the organization",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
