{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_token": {
          "type": "string",
          "description": "FortiPAM API user access token",
          "description_kind": "plain",
          "required": true
        },
        "base_url": {
          "type": "string",
          "description": "FortiPAM server URL https://192.168.1.99",
          "description_kind": "plain",
          "required": true
        },
        "verify_ssl": {
          "type": "bool",
          "description": "FortiPAM API require verify SSL",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "fortipam_resource_folder": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "folder name under parent folder",
            "description_kind": "plain",
            "required": true
          },
          "parent": {
            "type": "string",
            "description": "full folder path to the parent folder\te.g. public_folder/local",
            "description_kind": "plain",
            "required": true
          },
          "path": {
            "type": "string",
            "description": "full path to the folder",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "fortipam_resource_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "secret name under path",
            "description_kind": "plain",
            "required": true
          },
          "path": {
            "type": "string",
            "description": "full folder path to the secret\te.g. public_folder/local",
            "description_kind": "plain",
            "required": true
          },
          "template": {
            "type": "string",
            "description": "secret template name",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "fields": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Secret field info",
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "fortipam_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "field": {
            "type": "string",
            "description": "the field to extract from the secret based on name",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "secret name under path",
            "description_kind": "plain",
            "required": true
          },
          "path": {
            "type": "string",
            "description": "full folder path to the secret\te.g. public_folder/local",
            "description_kind": "plain",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "the value of the field of the secret",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
