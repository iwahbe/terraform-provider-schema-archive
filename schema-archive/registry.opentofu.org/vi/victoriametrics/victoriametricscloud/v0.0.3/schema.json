{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API key for VictoriaMetrics Cloud authentication. Can also be set via VMCLOUD_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "base_url": {
          "type": "string",
          "description": "Base URL for VictoriaMetrics Cloud API. Defaults to https://api.victoriametrics.cloud. Can also be set via VMCLOUD_BASE_URL environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Terraform provider for managing VictoriaMetrics Cloud resources.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "victoriametricscloud_access_token": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "Timestamp of token creation.",
            "description_kind": "plain",
            "computed": true
          },
          "created_by": {
            "type": "string",
            "description": "Email of the user who created the token.",
            "description_kind": "plain",
            "computed": true
          },
          "deployment_id": {
            "type": "string",
            "description": "ID of the deployment this token belongs to.",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the access token.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier of the access token.",
            "description_kind": "plain",
            "computed": true
          },
          "last_used_at": {
            "type": "string",
            "description": "Timestamp of last token usage (within the last 7 days).",
            "description_kind": "plain",
            "computed": true
          },
          "secret": {
            "type": "string",
            "description": "Secret value of the access token. Only available after creation.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "tenant_id": {
            "type": "string",
            "description": "Optional tenant ID for cluster deployments (format: accountID or accountID:projectID).",
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "Access mode of the token. Valid values: 'r' (read-only), 'w' (write-only), 'rw' (read-write).",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages an access token for a VictoriaMetrics Cloud deployment.",
        "description_kind": "plain"
      }
    },
    "victoriametricscloud_deployment": {
      "version": 0,
      "block": {
        "attributes": {
          "access_endpoint": {
            "type": "string",
            "description": "API endpoint URL for the deployment.",
            "description_kind": "plain",
            "computed": true
          },
          "cloud_provider": {
            "type": "string",
            "description": "Cloud provider for the deployment. Valid values: 'aws'.",
            "description_kind": "plain",
            "required": true
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp of deployment creation.",
            "description_kind": "plain",
            "computed": true
          },
          "deduplication": {
            "type": "number",
            "description": "Deduplication window for the deployment.",
            "description_kind": "plain",
            "required": true
          },
          "deduplication_unit": {
            "type": "string",
            "description": "Deduplication window unit. Valid values: 'ms' (milliseconds), 's' (seconds).",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier of the deployment.",
            "description_kind": "plain",
            "computed": true
          },
          "insert_flags": {
            "type": [
              "list",
              "string"
            ],
            "description": "Custom command-line flags for the vminsert component.",
            "description_kind": "plain",
            "optional": true
          },
          "maintenance_window": {
            "type": "string",
            "description": "Maintenance window for the deployment. Valid values: 'Sat-Sun 3-4am', 'Mon-Fri 4-5am'.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Human-readable name of the deployment.",
            "description_kind": "plain",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "Region of the deployment in the cloud provider.",
            "description_kind": "plain",
            "required": true
          },
          "retention": {
            "type": "number",
            "description": "Retention period for metrics.",
            "description_kind": "plain",
            "required": true
          },
          "retention_unit": {
            "type": "string",
            "description": "Retention period unit. Valid values: 'd' (days), 'm' (months).",
            "description_kind": "plain",
            "required": true
          },
          "select_flags": {
            "type": [
              "list",
              "string"
            ],
            "description": "Custom command-line flags for the vmselect component.",
            "description_kind": "plain",
            "optional": true
          },
          "single_flags": {
            "type": [
              "list",
              "string"
            ],
            "description": "Custom command-line flags for the vmsingle component.",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "Current status of the deployment.",
            "description_kind": "plain",
            "computed": true
          },
          "storage_flags": {
            "type": [
              "list",
              "string"
            ],
            "description": "Custom command-line flags for the vmstorage component.",
            "description_kind": "plain",
            "optional": true
          },
          "storage_size": {
            "type": "number",
            "description": "Storage size in units specified in storage_size_unit.",
            "description_kind": "plain",
            "required": true
          },
          "storage_size_unit": {
            "type": "string",
            "description": "Storage size unit. Valid values: 'GB', 'TB'.",
            "description_kind": "plain",
            "required": true
          },
          "tier": {
            "type": "number",
            "description": "Tier identifier for the deployment.",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of the deployment. Valid values: 'single_node', 'cluster'.",
            "description_kind": "plain",
            "required": true
          },
          "version": {
            "type": "string",
            "description": "Version of VictoriaMetrics used in the deployment.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a VictoriaMetrics Cloud deployment.",
        "description_kind": "plain"
      }
    },
    "victoriametricscloud_rule_file": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "YAML content of the alerting or recording rules file.",
            "description_kind": "plain",
            "required": true
          },
          "deployment_id": {
            "type": "string",
            "description": "ID of the deployment this rule file belongs to.",
            "description_kind": "plain",
            "required": true
          },
          "file_name": {
            "type": "string",
            "description": "Name of the rule file (e.g., 'alerting-rules.yaml').",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Composite identifier in format 'deployment_id/file_name'.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages an alerting or recording rules file for a VictoriaMetrics Cloud deployment.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "victoriametricscloud_cloud_providers": {
      "version": 0,
      "block": {
        "attributes": {
          "cloud_providers": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier of the cloud provider.",
                  "description_kind": "plain",
                  "computed": true
                },
                "url": {
                  "type": "string",
                  "description": "URL to the cloud provider website.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
