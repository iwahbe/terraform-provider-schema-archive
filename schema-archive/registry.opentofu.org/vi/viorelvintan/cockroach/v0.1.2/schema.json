{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "dns": {
          "type": "string",
          "description": "DNS to access cockroachdb, if kubeconfig is specified this is optional",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The password of the user used to access the database",
          "description_kind": "markdown",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "The username used to access the database",
          "description_kind": "markdown",
          "required": true
        }
      },
      "block_types": {
        "kube_config": {
          "nesting_mode": "list",
          "block": {
            "attributes": {
              "kube_config_path": {
                "type": "string",
                "description": "Full path to a Kubernetes config",
                "description_kind": "markdown",
                "optional": true
              },
              "namespace": {
                "type": "string",
                "description": "Kubernetes namespace where HC Vault is run",
                "description_kind": "markdown",
                "optional": true
              },
              "remote_port": {
                "type": "string",
                "description": "Remote service port to forward",
                "description_kind": "markdown",
                "optional": true
              },
              "service_name": {
                "type": "string",
                "description": "Kubernetes service name of Vault",
                "description_kind": "markdown",
                "optional": true
              }
            },
            "description_kind": "plain"
          }
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "cockroach_database": {
      "version": 0,
      "block": {
        "attributes": {
          "encoding": {
            "type": "string",
            "description": "Encoding to set to the database. (Optional argument, do not specify if not required)",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "local_port": {
            "type": "string",
            "description": "Local port to be used for port-forward. (default is 26258), use different port to avoid same port opening.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the database.",
            "description_kind": "markdown",
            "required": true
          },
          "owner": {
            "type": "string",
            "description": "Owner of the database.",
            "description_kind": "markdown",
            "optional": true
          },
          "primary_region": {
            "type": "string",
            "description": "Primary region of the database. (Optional argument, do not specify if not required)",
            "description_kind": "markdown",
            "optional": true
          },
          "regions": {
            "type": [
              "list",
              "string"
            ],
            "description": "Regions where the database is created. (Optional argument, do not specify if not required)",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Resource used to create a new database in a CockroachDB cluster.",
        "description_kind": "markdown"
      }
    },
    "cockroach_database_backup": {
      "version": 0,
      "block": {
        "attributes": {
          "backup_full": {
            "type": "string",
            "description": "Run full backup crontab",
            "description_kind": "markdown",
            "optional": true
          },
          "backup_options": {
            "type": [
              "list",
              "string"
            ],
            "description": "The options to be used when setting up the scheduler",
            "description_kind": "markdown",
            "optional": true
          },
          "backup_path": {
            "type": "string",
            "description": "The path where to save the backup, can be an s3 bucket.",
            "description_kind": "markdown",
            "required": true
          },
          "backup_recurring": {
            "type": "string",
            "description": "Backup reccuring attribute.",
            "description_kind": "markdown",
            "optional": true
          },
          "database_name": {
            "type": "string",
            "description": "Name of the database where to run the backup.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "local_port": {
            "type": "string",
            "description": "Local port to be used for port-forward. (default is 26258), use different port to avoid same port opening.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the scheduler.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Resource used to create a scheduler for a database backup job in a CockroachDB cluster.",
        "description_kind": "markdown"
      }
    },
    "cockroach_user": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "is_admin": {
            "type": "bool",
            "description": "True if the user is admin or false otherwise.",
            "description_kind": "markdown",
            "optional": true
          },
          "local_port": {
            "type": "string",
            "description": "Local port to be used for port-forward. (default is 26257), use different port to avoid same port opening.",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Password of the user to create.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "roles": {
            "type": "string",
            "description": "Roles to attach to the created user.",
            "description_kind": "markdown",
            "optional": true
          },
          "username": {
            "type": "string",
            "description": "Name of the user to create.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Resource used to create a new user inside Cockroachdb cluster, and to attach required roles to the user.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "cockroach_database": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "local_port": {
            "type": "string",
            "description": "Local port to be used for port-forward. (default is 26259), use different port to avoid same port opening.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the database.",
            "description_kind": "markdown",
            "required": true
          },
          "owner": {
            "type": "string",
            "description": "Owner of the database.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Sample data source in the Terraform provider scaffolding.",
        "description_kind": "markdown"
      }
    }
  }
}
