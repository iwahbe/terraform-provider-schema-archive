          },
          "secret_key": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "subuser": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "user": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "radosgw_subuser": {
      "version": 0,
      "block": {
        "attributes": {
          "access": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "subuser": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "user_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
