{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "apipath": {
          "type": "string",
          "description": "The URL path for the Todo server API (e.g. '/'). May also be provided via TODO_APIPATH environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "The FQDN or IP address for the Todo server (e.g. '127.0.0.1'). May also be provided via TODO_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "port": {
          "type": "string",
          "description": "The port for the Todo server (e.g. '8080'). May also be provided via TODO_PORT environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "schema": {
          "type": "string",
          "description": "The URL schema for the Todo server (e.g. 'http'). May also be provided via TODO_SCHEMA environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interface with the Todo API server (github.com/spkane/todo-for-terraform)",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "todo_todo": {
      "version": 0,
      "block": {
        "attributes": {
          "completed": {
            "type": "bool",
            "description": "The completed status for the todo.",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "The description for the todo.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "The unique identifier for the todo.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manage a todo.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "todo_todo": {
      "version": 0,
      "block": {
        "attributes": {
          "completed": {
            "type": "bool",
            "description": "The completed status for the todo.",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description for the todo.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "The unique identifier for the todo.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Fetch a todo.",
        "description_kind": "plain"
      }
    }
  }
}
