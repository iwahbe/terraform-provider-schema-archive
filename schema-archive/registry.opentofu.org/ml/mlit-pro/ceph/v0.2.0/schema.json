{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "ca_cert": {
          "type": "string",
          "description": "PEM-encoded CA certificate bundle used to verify the dashboard's TLS certificate. When set, it replaces the system certificate pool. May also be set with the `CEPH_CA_CERT` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "Base URL of the Ceph Manager Dashboard, e.g. `https://ceph-mgr.example.local:8443`. May also be set with the `CEPH_ENDPOINT` environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "insecure": {
          "type": "bool",
          "description": "Skip TLS certificate verification. Intended for development against self-signed certificates; mutually exclusive with `ca_cert`. May also be set with the `CEPH_INSECURE` environment variable. Defaults to `false`.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Dashboard password used to authenticate. May also be set with the `CEPH_PASSWORD` environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Dashboard username used to authenticate. May also be set with the `CEPH_USERNAME` environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Manages a Ceph cluster through the Ceph Manager Dashboard REST API.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ceph_cluster_user": {
      "version": 0,
      "block": {
        "attributes": {
          "capabilities": {
            "type": [
              "map",
              "string"
            ],
            "description": "Capabilities keyed by daemon type, e.g. `{ mon = \"allow r\", osd = \"allow rwx pool=rbd\" }`. Updates overwrite all existing capabilities.",
            "description_kind": "markdown",
            "required": true
          },
          "entity": {
            "type": "string",
            "description": "CephX entity name, e.g. `client.terraform`. Changing this forces a new user.",
            "description_kind": "markdown",
            "required": true
          },
          "key": {
            "type": "string",
            "description": "CephX secret key for the entity.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "keyring": {
            "type": "string",
            "description": "Full keyring text for the entity, suitable for writing to a keyring file. Includes the capability lines, so it changes when capabilities change.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manages a CephX cluster user (a `ceph auth` entity) and its capabilities.",
        "description_kind": "markdown"
      }
    },
    "ceph_pool": {
      "version": 0,
      "block": {
        "attributes": {
          "application_metadata": {
            "type": [
              "set",
              "string"
            ],
            "description": "Applications enabled on the pool, e.g. [\"rbd\"], [\"cephfs\"], [\"rgw\"].",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "crush_rule": {
            "type": "string",
            "description": "CRUSH rule name. Defaults to the cluster's default rule for the pool type.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "erasure_code_profile": {
            "type": "string",
            "description": "Erasure code profile name. Required for erasure pools, forbidden for replicated pools. Changing this forces a new pool.",
            "description_kind": "plain",
            "optional": true
          },
          "min_size": {
            "type": "number",
            "description": "Minimum number of replicas required for I/O (replicated pools).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Pool name. Renaming is applied in place (the pool is not recreated).",
            "description_kind": "plain",
            "required": true
          },
          "pg_autoscale_mode": {
            "type": "string",
            "description": "Placement group autoscale mode: on, warn, or off.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "pg_num": {
            "type": "number",
            "description": "Number of placement groups. With `pg_autoscale_mode = \"on\"`, Ceph may change this, causing drift; set autoscale `\"off\"` to manage it precisely.",
            "description_kind": "markdown",
            "required": true
          },
          "pool_id": {
            "type": "number",
            "description": "Numeric pool identifier assigned by Ceph.",
            "description_kind": "plain",
            "computed": true
          },
          "pool_type": {
            "type": "string",
            "description": "Pool type: replicated or erasure. Changing this forces a new pool.",
            "description_kind": "plain",
            "required": true
          },
          "quota_max_bytes": {
            "type": "number",
            "description": "Maximum bytes quota (0 = unlimited).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "quota_max_objects": {
            "type": "number",
            "description": "Maximum objects quota (0 = unlimited).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "size": {
            "type": "number",
            "description": "Number of replicas (replicated pools).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a Ceph pool.",
        "description_kind": "plain"
      }
    },
    "ceph_role": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Human-readable description of the role.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Role name. Changing this forces a new role.",
            "description_kind": "plain",
            "required": true
          },
          "scopes_permissions": {
            "type": [
              "map",
              [
                "set",
                "string"
              ]
            ],
            "description": "Permissions keyed by security scope, e.g. `{ pool = [\"read\", \"update\"], monitor = [\"read\"] }`. Valid permissions are `create`, `delete`, `read`, `update`.",
            "description_kind": "markdown",
            "required": true
          },
          "system": {
            "type": "bool",
            "description": "Whether the role is a built-in system role.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a custom Ceph Dashboard RBAC role and its scope permissions.\n\n~> **Warning:** Built-in roles (e.g. `administrator`, `read-only`) are system roles and cannot be managed by this resource. Removing permissions from a role the provider's account depends on can lock the provider out.",
        "description_kind": "markdown"
      }
    },
    "ceph_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "Email address of the user.",
            "description_kind": "plain",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether the user is enabled. Defaults to true.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_update": {
            "type": "number",
            "description": "Unix timestamp of the user's last update.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Full name of the user.",
            "description_kind": "plain",
            "optional": true
          },
          "password": {
            "type": "string",
            "description": "User password. Write-only: the API never returns it, so changes made outside Terraform are not detected.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "pwd_expiration_date": {
            "type": "number",
            "description": "Password expiration date as a Unix timestamp. Unset means no expiration.",
            "description_kind": "plain",
            "optional": true
          },
          "pwd_update_required": {
            "type": "bool",
            "description": "Whether the user must change their password on next login. Defaults to false.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "roles": {
            "type": [
              "set",
              "string"
            ],
            "description": "Dashboard role names granted to the user, e.g. [\"administrator\"].",
            "description_kind": "plain",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "Dashboard username. Changing this forces a new user.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Ceph Dashboard user account (RBAC) and its roles.\n\n~> **Warning:** Managing the same dashboard account the provider authenticates as can lock the provider out (e.g. by disabling it, removing its administrator role, or deleting it). Manage a separate account for Terraform.",
        "description_kind": "markdown"
      }
    }
  },
