            "computed": true
          },
          "template_id": {
            "type": "string",
            "description": "The template ID for the item.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Sitecore item using the Authoring API.",
        "description_kind": "plain"
      }
    },
