{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "client_id": {
          "type": "string",
          "description": "The client ID for SitecoreAI Edge authentication. Can also be specified with env var SITECORE_EDGE_CLIENT_ID.",
          "description_kind": "plain",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "The client secret for SitecoreAI Edge authentication. Can also be specified with env var SITECORE_EDGE_CLIENT_SECRET.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "use_cli": {
          "type": "bool",
          "description": "Use Sitecore CLI authentication (uses .sitecore/user.json file)",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with SitecoreAI Experience Edge",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "sitecoreedge_settings": {
      "version": 0,
      "block": {
        "attributes": {
          "content_cache_auto_clear": {
            "type": "bool",
            "description": "Whether to auto-clear content cache",
            "description_kind": "plain",
            "optional": true
          },
          "content_cache_ttl": {
            "type": "string",
            "description": "Content cache TTL (e.g., 04:00:00)",
            "description_kind": "plain",
            "optional": true
          },
          "media_cache_auto_clear": {
            "type": "bool",
            "description": "Whether to auto-clear media cache",
            "description_kind": "plain",
            "optional": true
          },
          "media_cache_ttl": {
            "type": "string",
            "description": "Media cache TTL (e.g., 04:00:00)",
            "description_kind": "plain",
            "optional": true
          },
          "tenant_cache_auto_clear": {
            "type": "bool",
            "description": "Whether to auto-clear tenant cache",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages Sitecore Edge settings",
        "description_kind": "plain"
      }
    },
    "sitecoreedge_token": {
      "version": 0,
      "block": {
        "attributes": {
          "created": {
            "type": "string",
            "description": "When the token was created",
            "description_kind": "plain",
            "computed": true
          },
          "created_by": {
            "type": "string",
            "description": "The user who created the token",
            "description_kind": "plain",
            "optional": true
          },
          "hash": {
            "type": "string",
            "description": "The unique hash identifier of the token",
            "description_kind": "plain",
            "computed": true
          },
          "is_revoked": {
            "type": "bool",
            "description": "Whether the token is revoked",
            "description_kind": "plain",
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "The label/name of the token",
            "description_kind": "plain",
            "required": true
          },
          "scopes": {
            "type": [
              "list",
              "string"
            ],
            "description": "The scopes/permissions for the token",
            "description_kind": "plain",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "The actual token value (sensitive - only available after creation)",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manages a Sitecore Edge API token",
        "description_kind": "plain"
      }
    },
    "sitecoreedge_webhook": {
      "version": 0,
      "block": {
        "attributes": {
          "body": {
            "type": "string",
            "description": "The body to post when making the web request. Only populated if ExecutionMode is OnEnd.",
            "description_kind": "plain",
            "optional": true
          },
          "body_include": {
            "type": "string",
            "description": "Additional JSON object to include in the body of the webhook request. Only populated if ExecutionMode is OnUpdate. This field must be a valid JSON object. Use jsonencode({}) to create the string.",
            "description_kind": "plain",
            "optional": true
          },
          "created_by": {
            "type": "string",
            "description": "The name of the user who created the webhook.",
            "description_kind": "plain",
            "optional": true
          },
          "disabled": {
            "type": "bool",
            "description": "Whether the webhook is disabled",
            "description_kind": "plain",
            "optional": true
          },
          "execution_mode": {
            "type": "string",
            "description": "Determines how the webhook is executed. Must be one of the following options: OnEnd, OnUpdate.",
            "description_kind": "plain",
            "required": true
          },
          "headers": {
            "type": [
              "map",
              "string"
            ],
            "description": "Custom headers to send when making the web request. Commonly used for authentication.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the webhook",
            "description_kind": "plain",
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Describes the purpose of the webhook.",
            "description_kind": "plain",
            "required": true
          },
          "method": {
            "type": "string",
            "description": "The HTTP method to use when making the web request. Must be GET or POST.",
            "description_kind": "plain",
            "required": true
          },
          "uri": {
            "type": "string",
            "description": "The URI of the webhook endpoint",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Sitecore Edge webhook",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "sitecoreedge_tenant": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Dummy ID for the datasource",
            "description_kind": "plain",
            "computed": true
          },
          "tenant_id": {
            "type": "string",
            "description": "The tenant ID",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Gets the tenant ID for Sitecore Edge",
        "description_kind": "plain"
      }
    }
  }
}
