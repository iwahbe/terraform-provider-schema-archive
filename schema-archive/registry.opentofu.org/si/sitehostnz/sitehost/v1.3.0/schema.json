{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_endpoint": {
          "type": "string",
          "description": "The HTTP(S) API address of the SiteHost API to use.",
          "description_kind": "plain",
          "optional": true
        },
        "api_key": {
          "type": "string",
          "description": "The API Key that allows you access to your SiteHost account.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "client_id": {
          "type": "string",
          "description": "The client identifier that allows you access to your SiteHost account.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "sitehost_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "change_date": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "The base domain",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The subdomain",
            "description_kind": "plain",
            "required": true
          },
          "priority": {
            "type": "number",
            "description": "The priority type",
            "description_kind": "plain",
            "optional": true
          },
          "record": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "The record type",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "sitehost_dns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The domain name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "sitehost_server": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "An Image ID to deploy the Disk from. The complete list of images ID you can see in our official documentation.",
            "description_kind": "plain",
            "required": true
          },
          "ips": {
            "type": [
              "list",
              "string"
            ],
            "description": "Each Server is assigned a single public IPv4 address upon creation.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "The SiteHost's label is for display purposes only.",
            "description_kind": "plain",
            "required": true
          },
          "location": {
            "type": "string",
            "description": "This is the location where the Server was deployed. This cannot be changed without opening a support ticket.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The `name` is the ID and is provided for a Server.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "The password that will be assigned to the 'root' user account.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "product_code": {
            "type": "string",
            "description": "The product code of the server to be deployed, determining the price and size.",
            "description_kind": "plain",
            "required": true
          },
          "securitygroups": {
            "type": [
              "list",
              "string"
            ],
            "description": "The security groups which this server uses.",
            "description_kind": "plain",
            "optional": true
          },
          "ssh_keys": {
            "type": [
              "list",
              "string"
            ],
            "description": "A list of SSH public keys to deploy for the root user on the newly created Server.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "sitehost_server_firewall": {
      "version": 0,
      "block": {
        "attributes": {
          "groups": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of security group names to apply to the server's firewall (in order).",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "server": {
            "type": "string",
            "description": "The name of the server to manage firewall rules for.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "sitehost_server_security_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "The label for the Security Group.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The name of the Security Group.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "rules_in": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "action": {
                  "type": "string",
                  "description": "The action for this inbound rule. The following values are accepted: ACCEPT, DROP, REJECT.",
                  "description_kind": "plain",
                  "required": true
                },
                "dest_port": {
                  "type": "string",
                  "description": "The destination port for this inbound rule.",
                  "description_kind": "plain",
                  "required": true
                },
                "enabled": {
                  "type": "bool",
                  "description": "Whether this inbound rule is enabled or not.",
                  "description_kind": "plain",
                  "optional": true
                },
                "protocol": {
                  "type": "string",
                  "description": "The protocol for this inbound rule. The following values are accepted: tcp, udp.",
                  "description_kind": "plain",
                  "required": true
                },
                "src_ip": {
                  "type": "string",
                  "description": "The source IP address for this inbound rule. This can either be a standalone IP or CIDR range.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "The inbound rules which the security group follows.",
              "description_kind": "plain"
            }
          },
          "rules_out": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "action": {
                  "type": "string",
                  "description": "The action for this outbound rule. The following values are accepted: ACCEPT, DROP, REJECT.",
                  "description_kind": "plain",
                  "required": true
                },
                "dest_ip": {
                  "type": "string",
                  "description": "The destination IP address for this outbound rule. This can either be a standalone IP or CIDR range.",
                  "description_kind": "plain",
                  "required": true
                },
                "dest_port": {
                  "type": "string",
                  "description": "The destination port for this outbound rule.",
                  "description_kind": "plain",
                  "required": true
                },
                "enabled": {
                  "type": "bool",
                  "description": "Whether this outbound rule is enabled or not.",
                  "description_kind": "plain",
                  "optional": true
                },
                "protocol": {
                  "type": "string",
                  "description": "The protocol for this outbound rule. The following values are accepted: tcp, udp.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "The outbound rules which the security group follows.",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "sitehost_ssh_key": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "The `content` is the contents of the public key.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "custom_image_access": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "date_added": {
            "type": "string",
            "description": "The `date_added` is the date/time when the SSH Key was added.",
            "description_kind": "plain",
            "computed": true
          },
          "date_updated": {
            "type": "string",
            "description": "The `date_updated` is the date/time when the SSH Key was updated.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The `id` is the ID of the SSH Key within SiteHost's systems.",
            "description_kind": "plain",
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "The `label` is the name of the SSH Key, and is displayed in CP.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
