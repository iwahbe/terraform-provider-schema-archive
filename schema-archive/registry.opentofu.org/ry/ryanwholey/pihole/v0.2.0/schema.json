{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "Experimental: Pi-hole API token. Conflicts with `password`.",
          "description_kind": "plain",
          "optional": true
        },
        "ca_file": {
          "type": "string",
          "description": "CA file to connect to Pi-hole with TLS",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The admin password used to login to the admin dashboard. Conflicts with `api_token`.",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "URL where Pi-hole is deployed",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "pihole_ad_blocker_status": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Whether to enable the Pi-hole ad blocker",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "pihole_cname_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Domain to create a CNAME record for",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "target": {
            "type": "string",
            "description": "Value of the CNAME record where traffic will be directed to from the configured domain value",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Pi-hole CNAME record",
        "description_kind": "plain"
      }
    },
    "pihole_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "DNS record domain",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ip": {
            "type": "string",
            "description": "IP address to route traffic to from the DNS record domain",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a Pi-hole DNS record",
        "description_kind": "plain"
      }
    },
    "pihole_group": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Group description",
            "description_kind": "plain",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether to enable the group",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Group name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A construct to associate clients with allow/deny lists and/or adlists",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "pihole_cname_records": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "records": {
            "type": [
              "set",
              [
                "object",
                {
                  "domain": "string",
                  "target": "string"
                }
              ]
            ],
            "description": "List of CNAME Pi-hole records",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "pihole_dns_records": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "records": {
            "type": [
              "set",
              [
                "object",
                {
                  "domain": "string",
                  "ip": "string"
                }
              ]
            ],
            "description": "List of Pi-hole DNS records",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "pihole_domains": {
      "version": 0,
      "block": {
        "attributes": {
          "domains": {
            "type": [
              "set",
              [
                "object",
                {
                  "comment": "string",
                  "domain": "string",
                  "enabled": "bool",
                  "group_ids": [
                    "list",
                    "number"
                  ],
                  "id": "number",
                  "type": "string",
                  "wildcard": "bool"
                }
              ]
            ],
            "description": "Domains ",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Filter on allowed or denied domains. Must be either 'allow' or 'deny'.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "pihole_groups": {
      "version": 0,
      "block": {
        "attributes": {
          "groups": {
            "type": [
              "set",
              [
                "object",
                {
                  "description": "string",
                  "enabled": "bool",
                  "id": "number",
                  "name": "string"
                }
              ]
            ],
            "description": "List of groups to manage client lists and block lists",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
