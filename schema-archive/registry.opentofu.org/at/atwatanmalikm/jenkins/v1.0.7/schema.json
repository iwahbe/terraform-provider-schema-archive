    "jenkins_credential_username": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "A human readable description of the credentials being stored.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "The domain store to place the credentials into. If not set will default to the global credentials store.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "folder": {
            "type": "string",
            "description": "The folder namespace to store the credentials in. If not set will default to global Jenkins credentials.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The full canonical job path, e.g. `/job/job-name`",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the credentials being created. This maps to the ID property within Jenkins, and cannot be changed once set.",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "The password to be associated with the credentials. If empty then the password property will become unmanaged and expected to be set manually within Jenkins. If set then the password will be updated only upon changes -- if the password is set manually within Jenkins then it will not reconcile this drift until the next time the password property is changed.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "scope": {
            "type": "string",
            "description": "The visibility of the credentials to Jenkins agents. This must be set to either \"GLOBAL\" or \"SYSTEM\". If not set will default to \"GLOBAL\".",
            "description_kind": "markdown",
            "computed": true
          },
          "username": {
            "type": "string",
            "description": "The username to be associated with the credentials.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "\nManages a username credential within Jenkins. This username may then be referenced within jobs that are created.\n\n~> The \"password\" property may leave plain-text passwords in your state file. If using the property to manage the password in Terraform, ensure that your state file is properly secured and encrypted at rest.",
        "description_kind": "markdown"
      }
    },
