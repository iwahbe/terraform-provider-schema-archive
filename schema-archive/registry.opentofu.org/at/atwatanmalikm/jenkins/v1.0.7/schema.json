            "sensitive": true
          },
          "client_id": {
            "type": "string",
            "description": "The client id (application id) of the Azure Service Principal.",
            "description_kind": "plain",
            "required": true
          },
          "client_secret": {
            "type": "string",
            "description": "The client secret of the Azure Service Principal. Cannot be used with certificate_id.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
