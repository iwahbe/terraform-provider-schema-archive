{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "cluster": {
          "type": "string",
          "description": "CockroachDB cluster id.",
          "description_kind": "markdown",
          "optional": true
        },
        "database": {
          "type": "string",
          "description": "CockroachDB database name to connect to.",
          "description_kind": "markdown",
          "required": true
        },
        "host": {
          "type": "string",
          "description": "CockroachDB server address",
          "description_kind": "markdown",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "CockroachDB password to connect with.",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "port": {
          "type": "number",
          "description": "CockroachDB server port Defaults to `26257`.",
          "description_kind": "markdown",
          "optional": true
        },
        "sslmode": {
          "type": "string",
          "description": "CockroachDB SSL mode to use. Defaults to `verify-full`.",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "CockroachDB username to connect with.",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "cockroachdb_database": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the database.",
            "description_kind": "markdown",
            "required": true
          },
          "owner": {
            "type": "string",
            "description": "Owner of the database.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Database in a CockroachDB cluster.",
        "description_kind": "markdown"
      }
    },
    "cockroachdb_grant": {
      "version": 0,
      "block": {
        "attributes": {
          "force_recreate": {
            "type": "bool",
            "description": "Refresh/reset all role grants on every update. Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "object_type": {
            "type": "string",
            "description": "Object type. Must be one of the following: database, schema, table.",
            "description_kind": "markdown",
            "required": true
          },
          "objects": {
            "type": [
              "list",
              "string"
            ],
            "description": "Objects to grant privileges on.",
            "description_kind": "markdown",
            "required": true
          },
          "privileges": {
            "type": [
              "list",
              "string"
            ],
            "description": "Privileges to grant.",
            "description_kind": "markdown",
            "required": true
          },
          "role": {
            "type": "string",
            "description": "Target role Name.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "The GRANT statement controls each role or user's SQL privileges for interacting with specific databases, schemas, tables, or user-defined types.",
        "description_kind": "markdown"
      }
    },
    "cockroachdb_grant_role": {
      "version": 0,
      "block": {
        "attributes": {
          "grant_role": {
            "type": "string",
            "description": "The role to grant.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "User or role name to grant role to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Grant role membership.",
        "description_kind": "markdown"
      }
    },
    "cockroachdb_role": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "login": {
            "type": "bool",
            "description": "Allow role to login. Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Role / User name.",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Role password Defaults to `NULL`.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Roles are groups containing any number of roles and users as members. You can assign privileges to roles, and all members of the role (regardless of whether if they are direct or indirect members) will inherit the role's privileges.",
        "description_kind": "markdown"
      }
    }
  }
}
