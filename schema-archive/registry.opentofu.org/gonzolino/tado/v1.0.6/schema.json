            "description": "Latitude used for Geofencing.",
            "description_kind": "markdown",
            "computed": true
          },
          "geolocation_long": {
            "type": "number",
            "description": "Longitude used for Geofencing.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Home ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the home.",
            "description_kind": "markdown",
            "required": true
          },
          "temperature_unit": {
            "type": "string",
            "description": "Temperature unit used in the home. Either 'Celsius' or 'Fahrenheit'.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "A tado home holds all tado devices and heating zones. The home data source provides information such as contact details, address, etc.",
        "description_kind": "markdown"
      }
    },
    "tado_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "dazzle_mode_enabled": {
            "type": "bool",
            "description": "If Dazzle Mode is enabled, tado devices in the zone will show an animation when settings are changed via Manual Control.",
            "description_kind": "markdown",
            "computed": true
          },
          "early_start": {
            "type": "bool",
