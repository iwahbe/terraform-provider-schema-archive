{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description": "Tado Password. Can be set via environment variable `TADO_PASSWORD`.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Tado username. Can be set via environment variable `TADO_USERNAME`.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "\nThe Tado provider is used to manage your Tado home.\n\nWhile not everything is supported yet, the provider is able to manage heating schedules and settings such as geofencing.\n",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "tado_geofencing": {
      "version": 0,
      "block": {
        "attributes": {
          "home_name": {
            "type": "string",
            "description": "Name of the home this geofencing resource belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of this geofencing resource. This should match the home_name.",
            "description_kind": "markdown",
            "computed": true
          },
          "presence": {
            "type": "string",
            "description": "Whether somebody is present in the home. Can be one of 'auto', 'home' or 'away'.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Controls geofencing of a home.",
        "description_kind": "markdown"
      }
    },
