{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "PowerDNS API key for authentication. Can be set via environment variable `POWERDNS_API_KEY`.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "server_url": {
          "type": "string",
          "description": "PowerDNS server URL. Can be set via environment variable `POWERDNS_SERVER_URL`.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "The PowerDNS provider allows modifying zone content and metadata using the PowerDNS API.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "powerdns_recordset": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "State ID for the record set (only needed for internal technical purposes).",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name for record set (e.g. \"www.powerdns.com.\")",
            "description_kind": "markdown",
            "required": true
          },
          "records": {
            "type": [
              "list",
              "string"
            ],
            "description": "All records in this record set.",
            "description_kind": "markdown",
            "required": true
          },
          "server_id": {
            "type": "string",
            "description": "The id of the server.",
            "description_kind": "markdown",
            "required": true
          },
          "ttl": {
            "type": "number",
            "description": "DNS TTL of the records, in seconds.",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of this record (e.g. \"A\", \"PTR\", \"MX\").",
            "description_kind": "markdown",
            "required": true
          },
          "zone_id": {
            "type": "string",
            "description": "ID of the zone this record set belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "PowerDNS Zone",
        "description_kind": "markdown"
      }
    },
    "powerdns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Opaque zone id, assigned by the server.",
            "description_kind": "markdown",
            "computed": true
          },
          "kind": {
            "type": "string",
            "description": "Zone kind, one of \"Native\", \"Master\", \"Slave\".",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of the zone (e.g. \"example.com.\") MUST have a trailing dot.",
            "description_kind": "markdown",
            "required": true
          },
          "server_id": {
            "type": "string",
            "description": "The id of the server.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "PowerDNS Zone",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "powerdns_recordset": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "State ID for the record set (only needed for internal technical purposes).",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name for record set (e.g. \"www.powerdns.com.\")",
            "description_kind": "markdown",
            "required": true
          },
          "records": {
            "type": [
              "list",
              "string"
            ],
            "description": "All records in this record set.",
            "description_kind": "markdown",
            "computed": true
          },
          "server_id": {
            "type": "string",
            "description": "The id of the server.",
            "description_kind": "markdown",
            "required": true
          },
          "ttl": {
            "type": "number",
            "description": " DNS TTL of the records, in seconds.",
            "description_kind": "markdown",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Type of this record (e.g. \"A\", \"PTR\", \"MX\"). Required if record name is not unique.",
            "description_kind": "markdown",
            "required": true
          },
          "zone_id": {
            "type": "string",
            "description": "ID of the zone this record set belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "PowerDNS Resource Record Set",
        "description_kind": "markdown"
      }
    },
    "powerdns_zone": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
