{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "Gqldenring GQL Endpoint e.g. https://example.com/query, may also be set with the GQLDENRING_ENDPOINT envar.",
          "description_kind": "plain",
          "optional": true
        },
        "status_endpoint": {
          "type": "string",
          "description": "Gqldenring status Endpoint e.g. https://example.com/health, may also be set with the GQLDENRING_STATUS_ENDPOINT envar.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with Gqldenring",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "gqldenring_weapon": {
      "version": 0,
      "block": {
        "attributes": {
          "custom": {
            "type": "bool",
            "description": "Whether the weapon is custom.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID (uuid) of the weapon.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the weapon.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage a weapon.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "gqldenring_weapons": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Used for unit testing this datasource.",
            "description_kind": "plain",
            "computed": true
          },
          "weapons": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "The ID (uuid) of the weapon.",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The name of the weapon.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches a list of Weapons.",
        "description_kind": "plain"
      }
    }
  }
}
