{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API key to use in order to authenticated against updown.io API.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "updown_check": {
      "version": 0,
      "block": {
        "attributes": {
          "alias": {
            "type": "string",
            "description": "Human readable name.",
            "description_kind": "plain",
            "optional": true
          },
          "apdex_t": {
            "type": "number",
            "description": "APDEX threshold in seconds (0.125, 0.25, 0.5, 1.0 or 2.0).",
            "description_kind": "plain",
            "optional": true
          },
          "custom_headers": {
            "type": [
              "map",
              "string"
            ],
            "description": "The HTTP headers you want in requests.",
            "description_kind": "plain",
            "optional": true
          },
          "disabled_locations": {
            "type": [
              "set",
              "string"
            ],
            "description": "Disabled monitoring locations. It's a lsit of abbreviated location names.",
            "description_kind": "plain",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "Is the check enabled (true or false).",
            "description_kind": "plain",
            "optional": true
          },
          "http_body": {
            "type": "string",
            "description": "Request body for POST/PUT/PATCH requests. Only for http/https checks.",
            "description_kind": "plain",
            "optional": true
          },
          "http_verb": {
            "type": "string",
            "description": "HTTP method (GET/HEAD, POST, PUT, PATCH, DELETE, OPTIONS). Only for http/https checks.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "mute_until": {
            "type": "string",
            "description": "Mute notifications until given time, accepts a time, 'recovery' or 'forever'.",
            "description_kind": "plain",
            "optional": true
          },
          "period": {
            "type": "number",
            "description": "Interval in seconds (15, 30, 60, 120, 300, 600, 1800 or 3600).",
            "description_kind": "plain",
            "optional": true
          },
          "published": {
            "type": "bool",
            "description": "Shall the status page be public (true or false).",
            "description_kind": "plain",
            "optional": true
          },
          "recipients": {
            "type": [
              "set",
              "string"
            ],
            "description": "Selected alert recipients. It's an array of recipient IDs you can get from the recipients API.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "string_match": {
            "type": "string",
            "description": "Search for this string in the page.",
            "description_kind": "plain",
            "optional": true
          },
          "type": {
            "type": "string",
            "description": "The type of check (http, https, icmp, tcp, tcps). Inferred from URL scheme if not specified.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "url": {
            "type": "string",
            "description": "The URL you want to monitor.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "`updown_check` defines a check",
        "description_kind": "plain"
      }
    },
    "updown_recipient": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Type of recipient ('email', 'sms', 'webhook' or 'slack_compatible' only). The other integrations (slack, telegram, zapier, statuspage, etc.) require the web UI to setup.",
            "description_kind": "plain",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "The recipient value (email address, phone number or URL)",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "`updown_recipient` defines a recipient",
        "description_kind": "plain"
      }
    },
    "updown_status_page": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key": {
            "type": "string",
            "description": "Access key for protected pages (defaults to a random string if unset).",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "checks": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of checks to show in the page (order is respected).",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Description text (displayed below the name, supports newlines and links).",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the status page.",
            "description_kind": "plain",
            "optional": true
          },
          "url": {
            "type": "string",
            "description": "The URL of the status page.",
            "description_kind": "plain",
            "computed": true
          },
          "visibility": {
            "type": "string",
            "description": "Page visibility: 'public', 'protected', or 'private'.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "`updown_status_page` defines a status page",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "updown_nodes": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ipv4": {
            "type": [
              "list",
              "string"
            ],
            "description": "Ipv4 addresses list of the nodes.",
            "description_kind": "plain",
            "computed": true
          },
          "ipv6": {
            "type": [
              "list",
              "string"
            ],
            "description": "Ipv6 addresses list or the nodes.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "`updown_nodes` data source can be used to retrieve the IP addresses of their servers.",
        "description_kind": "plain"
      }
    }
  }
}
