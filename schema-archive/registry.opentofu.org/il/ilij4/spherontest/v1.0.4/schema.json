{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "token": {
          "type": "string",
          "description": "Spheron access token. If left empty provide SPHERON_TOKEN env variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Interface with the Spheron API.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "spherontest_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Id of the domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "instance_id": {
            "type": "string",
            "description": "The id of an instance to which to attach the domain.",
            "description_kind": "markdown",
            "required": true
          },
          "instance_port": {
            "type": "number",
            "description": "Container port of the instnace to whict to attach the domain.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The domain name",
            "description_kind": "markdown",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of the domain. Available options are domain and subdomain.",
            "description_kind": "markdown",
            "required": true
          },
          "verified": {
            "type": "bool",
            "description": "Is veriffied. True means that the domain is verified and that it will start serving the content",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Instance domain resource",
        "description_kind": "markdown"
      }
    },
    "spherontest_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "args": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of params for docker CMD command.",
            "description_kind": "markdown",
            "optional": true
          },
          "cluster_name": {
            "type": "string",
            "description": "The name of the cluster.",
            "description_kind": "markdown",
            "required": true
          },
          "commands": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of executables for docker CMD command.",
            "description_kind": "markdown",
            "optional": true
          },
          "cpu": {
            "type": "string",
            "description": "Instance CPU. Value cannot exceed 1024GB",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "env": {
            "nested_type": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "Environment variable key.",
                  "description_kind": "markdown",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "Environment variable value.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "The list of environmetnt variables.",
            "description_kind": "markdown",
            "optional": true
          },
          "env_secret": {
            "nested_type": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "Environment variable key.",
                  "description_kind": "markdown",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "Environment variable value.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "The list of secret environmetnt variables.",
            "description_kind": "markdown",
            "optional": true
          },
          "health_check": {
            "nested_type": {
              "attributes": {
                "path": {
                  "type": "string",
                  "description": "Path on which health check should be done.",
                  "description_kind": "markdown",
                  "required": true
                },
                "port": {
                  "type": "number",
                  "description": "Instance container path on which health check should be done.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Path and container port on which health check should be done.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Id of the instance.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "The docker image to deploy. Currently only public dockerhub images are supported.",
            "description_kind": "markdown",
            "required": true
          },
          "machine_image": {
            "type": "string",
            "description": "Machine image name which should be used for deploying instance.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "memory": {
            "type": "string",
            "description": "Instance Memory in GB.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "persistent_storage": {
            "nested_type": {
              "attributes": {
                "class": {
                  "type": "string",
                  "description": "Storage class. Available classes are HDD, SSD and NVMe",
                  "description_kind": "markdown",
                  "required": true
                },
                "mount_point": {
                  "type": "string",
                  "description": "Attachement point used fot attaching persistent storage.",
                  "description_kind": "markdown",
                  "required": true
                },
                "size": {
                  "type": "number",
                  "description": "Persistent storage in GB. Value cannot exceed 1024GB",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Persistent storage that will be attached to the instance.",
            "description_kind": "markdown",
            "optional": true
          },
          "ports": {
            "nested_type": {
              "attributes": {
                "container_port": {
                  "type": "number",
                  "description": "Container port that will be exposed.",
                  "description_kind": "markdown",
                  "required": true
                },
                "exposed_port": {
                  "type": "number",
                  "description": "The port container port will be exposed to. Currently only posible to expose to port 80. Leave empty to map to random value. Exposed port will be know and available for use after the deployment.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The list of port mappings",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "Region to which to deploy instance.",
            "description_kind": "markdown",
            "required": true
          },
          "replicas": {
            "type": "number",
            "description": "Number of instance replicas.",
            "description_kind": "markdown",
            "required": true
          },
          "storage": {
            "type": "number",
            "description": "Instance storage in GB. Value cannot exceed 1024GB",
            "description_kind": "markdown",
            "required": true
          },
          "tag": {
            "type": "string",
            "description": "The tag of docker image.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Instnce resource",
        "description_kind": "markdown"
      }
    },
    "spherontest_marketplace_instance": {
      "version": 0,
      "block": {
        "attributes": {
          "cpu": {
            "type": "string",
            "description": "Instance CPU. Value cannot exceed 1024GB",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "env": {
            "nested_type": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "Environment variable key.",
                  "description_kind": "markdown",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "Environment variable value.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "The list of environmetnt variables. NOTE: Some marketplace apps have required env variables that must be provided.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Id or the instance.",
            "description_kind": "markdown",
            "computed": true
          },
          "machine_image": {
            "type": "string",
            "description": "Machine image name which should be used for deploying instance.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "memory": {
            "type": "string",
            "description": "Instance Memory in GB.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the marketplace app.",
            "description_kind": "markdown",
            "required": true
          },
          "persistent_storage": {
            "nested_type": {
              "attributes": {
                "class": {
                  "type": "string",
                  "description": "Storage class. Available classes are HDD, SSD and NVMe",
                  "description_kind": "markdown",
                  "required": true
                },
                "mount_point": {
                  "type": "string",
                  "description": "Attachement point used fot attaching persistent storage.",
                  "description_kind": "markdown",
                  "required": true
                },
                "size": {
                  "type": "number",
                  "description": "Persistent storage in GB. Value cannot exceed 1024GB",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Persistent storage that will be attached to the instance.",
            "description_kind": "markdown",
            "optional": true
          },
          "ports": {
            "nested_type": {
              "attributes": {
                "container_port": {
                  "type": "number",
                  "description": "Container port that will be exposed.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "exposed_port": {
                  "type": "number",
                  "description": "The port container port will be exposed to. Exposed port will be know and available for use after the deployment.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The list of port mappings",
            "description_kind": "markdown",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Region to which to deploy instance.",
            "description_kind": "markdown",
            "required": true
          },
          "replicas": {
            "type": "number",
            "description": "Number of instance replicas.",
            "description_kind": "markdown",
            "required": true
          },
          "storage": {
            "type": "number",
            "description": "Instance storage in GB. Value cannot exceed 1024GB",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Instnce resource",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "spherontest_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Organization identifier.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Organization name.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Organization data source..",
        "description_kind": "markdown"
      }
    }
  }
}
