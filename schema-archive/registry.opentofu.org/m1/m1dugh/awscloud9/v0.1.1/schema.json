          "description_kind": "markdown",
          "optional": true
        },
        "region": {
          "type": "string",
          "description": "The AWS region to use the provider for, if not provided, extracted from `AWS_REGION` env variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "awscloud9_environment_membership": {
