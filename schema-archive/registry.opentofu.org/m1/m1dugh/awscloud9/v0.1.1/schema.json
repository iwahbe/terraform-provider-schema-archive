            "computed": true
          },
          "port": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "tags": {
            "type": [
              "map",
              "string"
            ],
            "description": "A list of tags to attach",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Creates a cloud 9 SSH environment",
        "description_kind": "markdown"
      }
    }
