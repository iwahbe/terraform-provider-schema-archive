            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp when the credentials were created",
            "description_kind": "markdown",
            "computed": true
          },
          "docker_config_json": {
            "type": "string",
            "description": "Docker config.json content for authentication",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "ecr_repo": {
            "type": "string",
            "description": "ECR repository URL",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the registry credentials",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "AWS region for ECR",
            "description_kind": "markdown",
            "optional": true
          },
          "scaleway_domain": {
            "type": "string",
            "description": "Scaleway registry domain",
            "description_kind": "markdown",
            "optional": true
          },
          "scaleway_uuid": {
            "type": "string",
            "description": "Scaleway namespace UUID",
            "description_kind": "markdown",
            "optional": true
          },
          "secret_access_key": {
            "type": "string",
            "description": "AWS Secret Access Key for ECR authentication",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "service_account_key": {
            "type": "string",
            "description": "Service account key JSON for GCR authentication",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "type": {
            "type": "string",
            "description": "Type of registry: 'dockerhub', 'gcr', 'ghcr', 'ecr', 'scaleway', etc.",
            "description_kind": "markdown",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "Username for registry authentication (for DockerHub, GHCR, etc.)",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          }
        },
        "description": "Manages container registry credentials for accessing private container registries",
        "description_kind": "markdown"
      }
    },
