                }
              },
              "nesting_mode": "single"
            },
            "description": "Storage information",
            "description_kind": "markdown",
            "computed": true
          },
          "volumes": {
            "nested_type": {
              "attributes": {
                "location": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "size": {
                  "type": "number",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Volumes to create and attach to the instance",
            "description_kind": "markdown",
            "optional": true
          }
