{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "Verda API Base URL. Defaults to https://api.verda.com/v1. Can also be set via VERDA_BASE_URL environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "Verda OAuth2 Client ID. Can also be set via VERDA_CLIENT_ID environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "Verda OAuth2 Client Secret. Can also be set via VERDA_CLIENT_SECRET environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "verda_container": {
      "version": 0,
      "block": {
        "attributes": {
          "compute": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "GPU type (e.g., 'H100', 'A100')",
                  "description_kind": "markdown",
                  "required": true
                },
                "size": {
                  "type": "number",
                  "description": "Number of GPUs",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Compute resources for the deployment",
            "description_kind": "markdown",
            "required": true
          },
          "container_registry_settings": {
            "nested_type": {
              "attributes": {
                "credentials": {
                  "type": "string",
                  "description": "Name of the registry credentials resource",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "is_private": {
                  "type": "string",
                  "description": "Whether the registry is private ('true' or 'false')",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Container registry authentication settings",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "containers": {
            "nested_type": {
              "attributes": {
                "entrypoint_overrides": {
                  "nested_type": {
                    "attributes": {
                      "cmd": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Custom command array",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "enabled": {
                        "type": "bool",
                        "description": "Whether to override the entrypoint",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "entrypoint": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Custom entrypoint array (e.g., [\"/bin/sh\", \"-c\"])",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Override container entrypoint and command",
                  "description_kind": "markdown",
                  "optional": true
                },
                "env": {
                  "nested_type": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "Name of the environment variable",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "type": {
                        "type": "string",
                        "description": "Type of environment variable ('plain' or 'secret')",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "value_or_reference_to_secret": {
                        "type": "string",
                        "description": "Value for plain env vars or secret name for secret env vars",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "Environment variables",
                  "description_kind": "markdown",
                  "optional": true
                },
                "exposed_port": {
                  "type": "number",
                  "description": "Port exposed by the container",
                  "description_kind": "markdown",
                  "required": true
                },
                "healthcheck": {
                  "nested_type": {
                    "attributes": {
                      "enabled": {
                        "type": "string",
                        "description": "Whether healthcheck is enabled ('true' or 'false')",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "path": {
                        "type": "string",
                        "description": "Path for healthcheck",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "port": {
                        "type": "string",
                        "description": "Port for healthcheck",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Healthcheck configuration",
                  "description_kind": "markdown",
                  "optional": true
                },
                "image": {
                  "type": "string",
                  "description": "Container image (e.g., 'nginx:latest')",
                  "description_kind": "markdown",
                  "required": true
                },
                "volume_mounts": {
                  "nested_type": {
                    "attributes": {
                      "mount_path": {
                        "type": "string",
                        "description": "Path where volume will be mounted in container",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "secret_name": {
                        "type": "string",
                        "description": "Name of secret (required for type='secret')",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "size_in_mb": {
                        "type": "number",
                        "description": "Size in MB (optional for type='scratch' or 'memory')",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "type": {
                        "type": "string",
                        "description": "Type of volume ('scratch', 'memory', 'secret', 'shared')",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "volume_id": {
                        "type": "string",
                        "description": "Volume ID (required for type='shared')",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "Volume mounts for the container",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of containers in the deployment",
            "description_kind": "markdown",
            "required": true
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp when the deployment was created",
            "description_kind": "markdown",
            "computed": true
          },
          "endpoint_base_url": {
            "type": "string",
            "description": "Base URL for the deployment endpoint",
            "description_kind": "markdown",
            "computed": true
          },
          "is_spot": {
            "type": "bool",
            "description": "Whether to use spot instances (defaults to false)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the container deployment",
            "description_kind": "markdown",
            "required": true
          },
          "scaling": {
            "nested_type": {
              "attributes": {
                "concurrent_requests_per_replica": {
                  "type": "number",
                  "description": "Maximum concurrent requests per replica",
                  "description_kind": "markdown",
                  "required": true
                },
                "deadline_seconds": {
                  "type": "number",
                  "description": "Request deadline in seconds",
                  "description_kind": "markdown",
                  "optional": true
                },
                "max_replica_count": {
                  "type": "number",
                  "description": "Maximum number of replicas",
                  "description_kind": "markdown",
                  "required": true
                },
                "min_replica_count": {
                  "type": "number",
                  "description": "Minimum number of replicas",
                  "description_kind": "markdown",
                  "required": true
                },
                "queue_load": {
                  "nested_type": {
                    "attributes": {
                      "threshold": {
                        "type": "number",
                        "description": "Queue load threshold for scaling",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Queue load trigger configuration",
                  "description_kind": "markdown",
                  "required": true
                },
                "queue_message_ttl_seconds": {
                  "type": "number",
                  "description": "Queue message TTL in seconds",
                  "description_kind": "markdown",
                  "required": true
                },
                "scale_down_policy": {
                  "nested_type": {
                    "attributes": {
                      "delay_seconds": {
                        "type": "number",
                        "description": "Delay in seconds before scaling down",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Scale down policy configuration",
                  "description_kind": "markdown",
                  "required": true
                },
                "scale_up_policy": {
                  "nested_type": {
                    "attributes": {
                      "delay_seconds": {
                        "type": "number",
                        "description": "Delay in seconds before scaling up",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Scale up policy configuration",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Scaling configuration for the deployment",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages a Verda container deployment for serverless workloads",
        "description_kind": "markdown"
      }
    },
    "verda_container_registry_credentials": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key_id": {
            "type": "string",
