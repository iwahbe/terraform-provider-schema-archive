{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "client_timeout": {
          "type": "number",
          "description": "HTTP Timeout in seconds when communicating with Weka API.",
          "description_kind": "markdown",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "URL to weka endpoint, should be the base url with the api root path, e.g http://weka/api/v2. Can be set via WEKA_ENDPOINT",
          "description_kind": "markdown",
          "required": true
        },
        "org": {
          "type": "string",
          "description": "Org the user belongs to in Weka, usually 'root'. Can be set via environment variable WEKA_ORG",
          "description_kind": "markdown",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "Weka Password to use to log into Weka. Can be set via environment variable WEKA_PASSWORD",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Weka Username to use to log into Weka. Can be set via environment variable WEKA_USERNAME",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "weka_filesystem": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_no_kms": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "auth_required": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "encrypted": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true
          },
          "group_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "obs_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "ssd_capacity_gb": {
            "type": "number",
            "description": "SSD capacity in gigabytes, defined as 1000000000 bytes",
            "description_kind": "markdown",
            "optional": true
          },
          "tiered": {
            "type": "bool",
            "description_kind": "plain",
            "required": true
          },
          "total_capacity_gb": {
            "type": "number",
            "description": "total capacity in gigabytes, defined as 1000000000 bytes",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages filesystems within Weka. Caveats: creating and manging a tiered file system with mulitple OBS buckets is currently not supported. A filesystems cannot be switched between tiered and non-tiered. OBS names cannot be changed. Gigabytes are defined as 1000000000 bytes",
        "description_kind": "markdown"
      }
    },
    "weka_filesystem_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "start_demote": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          },
          "target_ssd_retention": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "weka_kms": {
      "version": 0,
      "block": {
        "attributes": {
          "base_url": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "ca_cert_pem": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "client_cert_pem": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "client_key_pem": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "key_uid": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "master_key_name": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "server_endpoint": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "token": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "use_vault": {
            "type": "bool",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage KMS resource within Weka. Note: Weka API does not provide a read API for KMS configuration, as such a KMS configuration cannot be imported nor will remote changes be detected.",
        "description_kind": "markdown"
      }
    },
    "weka_s3_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "anonymous_policy_name": {
            "type": "string",
            "description": "Name of policy to apply for anonymous access. Must be one of: none, download, upload or public.",
            "description_kind": "markdown",
            "optional": true
          },
          "bucket_name": {
            "type": "string",
            "description": "bucket name. renaming a bucket will result in delete & recreate",
            "description_kind": "markdown",
            "required": true
          },
          "existing_path": {
            "type": "string",
            "description": "The Weka API does not provide a mechanism to update the existing path, updating this value will delete the bucket and create a new one.",
            "description_kind": "markdown",
            "optional": true
          },
          "fs_uid": {
            "type": "string",
            "description": "The Weka API does not provide a mechanism to update the FS of a bucket, updating this value will delete the bucket and create a new one.",
            "description_kind": "markdown",
            "required": true
          },
          "hard_quota": {
            "type": "string",
            "description": "Storage quota, for example '1MB', cannot be used when existing_path is set",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages S3 Buckets in Weka.",
        "description_kind": "markdown"
      }
    },
    "weka_s3_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "policy_file_content": {
            "type": "string",
            "description": "JSON string containing S3 policy document.",
            "description_kind": "markdown",
            "required": true
          },
          "policy_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "weka_user": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "posix_gid": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "posix_uid": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "Must be one of: ClusterAdmin, OrgAdmin, ReadOnly, Regular or S3",
            "description_kind": "markdown",
            "required": true
          },
          "username": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages users in Weka. Module will detect if a user or a user's role changes remotely, but other changes will not be detected.",
        "description_kind": "markdown"
      }
    },
    "weka_user_s3_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "s3_policy_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "username": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Resource manages mapping an s3 policy name to a user.",
        "description_kind": "markdown"
      }
    }
  }
}
