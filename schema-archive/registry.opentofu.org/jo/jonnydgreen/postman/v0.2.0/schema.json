{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API Key for the Postman API. May also be provided via POSTMAN_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "postman_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "created_at": {
            "type": "string",
            "description": "The date and time at which the environment was created.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The environment's ID.",
            "description_kind": "plain",
            "computed": true
          },
          "is_public": {
            "type": "bool",
            "description": "If true, the environment is public.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The environment's name.",
            "description_kind": "plain",
            "required": true
          },
          "owner": {
            "type": "string",
            "description": "The environment owner's ID.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "The date and time at which the environment was last updated.",
            "description_kind": "plain",
            "computed": true
          },
          "values": {
            "nested_type": {
              "attributes": {
                "enabled": {
                  "type": "bool",
                  "description": "If true, the value is enabled. Default: `true`",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "key": {
                  "type": "string",
                  "description": "The environment value's key.",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description": "The environment value's key. Valid values: default|secret|any. Default: `default`",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "value": {
                  "type": "string",
                  "description": "The environment value's value.",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "The environment's values. If defined, existing values will be overridden. This can be bypassed through the use of lifecycle.ignore_changes.",
            "description_kind": "plain",
            "optional": true
          },
          "workspace": {
            "type": "string",
            "description": "The environment's workspace ID. If not specified, the default workspace is used.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "The resource `postman_environment` creates a Postman Environment.",
        "description_kind": "plain"
      }
    },
