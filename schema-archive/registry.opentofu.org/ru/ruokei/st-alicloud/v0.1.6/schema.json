                  "description_kind": "plain",
                  "required": true
                },
                "sms_notice": {
                  "type": "bool",
                  "description": "Whether to configure SMS notification. Valid values: true, false.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "description": "The alert notification methods. See the following Block alert_config.",
              "description_kind": "plain"
            }
          }
