{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "app_id": {
          "type": "string",
          "description": "Violet App Id. If provided VIOLET_APP_ID environment variable will be used.",
          "description_kind": "plain",
          "optional": true
        },
        "app_secret": {
          "type": "string",
          "description": "Violet App Secret. If provided VIOLET_APP_SECRET environment variable will be used.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "password": {
          "type": "string",
          "description": "Violet user password. If provided VIOLET_PASSWORD environment variable will be used.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "sandbox": {
          "type": "bool",
          "description": "Use Violet sandbox environment",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Violet user username. If provided VIOLET_USERNAME environment variable will be used.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Manage Violet webhooks",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "violet_webhook": {
      "version": 0,
      "block": {
        "attributes": {
          "app_id": {
            "type": "number",
            "description": "App Id of application this webhook belongs to",
            "description_kind": "plain",
            "computed": true
          },
          "date_created": {
            "type": "string",
            "description": "Creation date of webhook",
            "description_kind": "plain",
            "computed": true
          },
          "date_last_modified": {
            "type": "string",
            "description": "Date of last modification of the webhook",
            "description_kind": "plain",
            "computed": true
          },
          "event": {
            "type": "string",
            "description": "Event webhook will be subscribed to",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "Webhook id",
            "description_kind": "plain",
            "computed": true
          },
          "remote_endpoint": {
            "type": "string",
            "description": "Endpoint that webhook will be publishing to",
            "description_kind": "plain",
            "required": true
          },
          "status": {
            "type": "string",
            "description": "Status of webhook",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Resource to manage Violet webhook",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "violet_webhook": {
      "version": 0,
