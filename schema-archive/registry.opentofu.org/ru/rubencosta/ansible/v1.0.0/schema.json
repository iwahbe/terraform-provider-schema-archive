{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ansible_playbook": {
      "version": 0,
      "block": {
        "attributes": {
          "ansible_playbook_binary": {
            "type": "string",
            "description": "Path to ansible-playbook executable (binary).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ansible_playbook_stderr": {
            "type": "string",
            "description": "An ansible-playbook CLI stderr output.",
            "description_kind": "plain",
            "computed": true
          },
          "ansible_playbook_stdout": {
            "type": "string",
            "description": "An ansible-playbook CLI stdout output.",
            "description_kind": "plain",
            "computed": true
          },
          "check_mode": {
            "type": "bool",
            "description": "If 'true', playbook execution won't make any changes but only change predictions will be made.",
            "description_kind": "plain",
            "optional": true
          },
          "cmd": {
            "type": "string",
            "description": "The command used to run ansible-playbook",
            "description_kind": "plain",
            "computed": true
          },
          "diff_mode": {
            "type": "bool",
            "description": "If 'true', when changing (small) files and templates, differences in those files will be shown. Recommended usage with 'check_mode'.",
            "description_kind": "plain",
            "optional": true
          },
          "extra_vars": {
            "type": "string",
            "description": "A string of json or yaml encoded map of additional variables as: { var-1 = {key-1 = value-1, key-2 = value-2, ... }, ... }.",
            "description_kind": "plain",
            "optional": true
          },
          "force_handlers": {
            "type": "bool",
            "description": "If 'true', run handlers even if a task fails.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "ignore_playbook_failure": {
            "type": "bool",
            "description": "This parameter is good for testing. Set to 'true' if the desired playbook is meant to fail, but still want the resource to run successfully.",
            "description_kind": "plain",
            "optional": true
          },
          "inventory_groups": {
            "nested_type": {
              "attributes": {
                "children": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of group names.",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the host.",
                  "description_kind": "plain",
                  "required": true
                },
                "variables": {
                  "type": "string",
                  "description": "yaml encoded map of variables.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true
          },
          "inventory_hosts": {
            "nested_type": {
              "attributes": {
                "groups": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of group names.",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the host.",
                  "description_kind": "plain",
                  "required": true
                },
                "variables": {
                  "type": "string",
                  "description": "yaml encoded map of variables.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "required": true
          },
          "playbook": {
            "type": "string",
            "description": "Path to ansible playbook.",
            "description_kind": "plain",
            "required": true
          },
          "replayable": {
            "type": "bool",
            "description": "If 'true', the playbook will be executed on every 'terraform apply' and with that, the resource will be recreated. If 'false', the playbook will be executed only on the first 'terraform apply'. Note, that if set to 'true', when doing 'terraform destroy', it might not show in the destroy output, even though the resource still gets destroyed.",
            "description_kind": "plain",
            "optional": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of tags of plays and tasks to run.",
            "description_kind": "plain",
            "optional": true
          },
          "temp_inventory_dir": {
            "type": "string",
            "description": "Path to created temporary inventory dir.",
            "description_kind": "plain",
            "computed": true
          },
          "verbosity": {
            "type": "number",
            "description": "A verbosity level between 0 and 6. Set ansible 'verbose' parameter, which causes Ansible to print more debug messages. The higher the 'verbosity', the more debug details will be printed.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
