{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "Zabbix API token. Takes precedence when set.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "insecure_skip_tls": {
          "type": "bool",
          "description": "Skip TLS verification.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Zabbix password (when api_token is not set).",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "timeout_seconds": {
          "type": "number",
          "description": "HTTP timeout in seconds (default: 30).",
          "description_kind": "markdown",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "Zabbix API URL, e.g. https://zabbix.example.com/api_jsonrpc.php",
          "description_kind": "markdown",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "Zabbix username (when api_token is not set).",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "OpenTofu/Terraform provider for the Zabbix API (JSON-RPC).",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "zabbix_action": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Whether the action is enabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "esc_period": {
            "type": "string",
            "description": "Minimum interval between notifications (e.g. \"1h\", \"60s\").",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "host_group_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "If set, action runs only when the trigger's host belongs to one of these host groups (e.g. Videoprojecteur Lampe, Videoprojecteur Laser).",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "message": {
            "type": "string",
            "description": "Email body. Supports Zabbix macros.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Action name (e.g. \"Envoyer mail en cas de probl\u00e8me\").",
            "description_kind": "markdown",
            "required": true
          },
          "subject": {
            "type": "string",
            "description": "Email subject. Supports macros: {TRIGGER.NAME}, {HOST.NAME}, {EVENT.STATUS}, etc.",
            "description_kind": "markdown",
            "required": true
          },
          "trigger_name_like": {
            "type": [
              "set",
              "string"
            ],
            "description": "If set, action runs only when trigger name (description) contains any of these strings (e.g. [\"Lampe\", \"Laser\"] for Videoprojecteur Lampe/Laser).",
            "description_kind": "markdown",
            "optional": true
          },
          "user_group_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "IDs of user groups to notify (e.g. Zabbix administrators). Use data source or variable.",
            "description_kind": "markdown",
            "required": true
          },
          "user_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "Optional: IDs of specific users to notify in addition to user groups (e.g. fst-audiovisuel).",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Zabbix trigger action: send notifications (e.g. email) when a trigger fires (problem).",
        "description_kind": "markdown"
      }
    },
    "zabbix_host": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Whether the host is enabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "host_group_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "Host group IDs.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "host_group_names": {
            "type": [
              "set",
              "string"
            ],
            "description": "Host group names. Alternative to host_group_ids.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Internal Zabbix ID.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Host technical name (`host`).",
            "description_kind": "markdown",
            "required": true
          },
          "tags": {
            "type": [
              "map",
              "string"
            ],
            "description": "Tags map (tag => value).",
            "description_kind": "markdown",
            "optional": true
          },
          "template_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "Linked template IDs.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "template_names": {
            "type": [
              "set",
              "string"
            ],
            "description": "Template names. Alternative to template_ids.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "visible_name": {
            "type": "string",
            "description": "Visible name (`name`) in Zabbix.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "interfaces": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "dns": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "ip": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "main": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "port": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "type": {
                  "type": "number",
                  "description": "1=Agent, 2=SNMP, 3=IPMI, 4=JMX.",
                  "description_kind": "markdown",
                  "required": true
                },
                "use_ip": {
                  "type": "bool",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "block_types": {
                "snmp_details": {
                  "nesting_mode": "single",
                  "block": {
                    "attributes": {
                      "community": {
                        "type": "string",
                        "description": "SNMP v1/v2c community.",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "version": {
                        "type": "number",
                        "description": "SNMP version (2 supported).",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "description": "SNMP details (v2 supported). Used mainly with type=2.",
                    "description_kind": "markdown"
                  }
                }
              },
              "description": "Host interfaces.",
              "description_kind": "markdown"
            }
          }
        },
        "description": "Zabbix host resource.",
        "description_kind": "markdown"
      }
    },
    "zabbix_host_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Zabbix host group resource.",
        "description_kind": "markdown"
      }
    },
    "zabbix_item": {
      "version": 0,
      "block": {
        "attributes": {
          "delay": {
            "type": "string",
            "description": "Update interval (e.g. 10m, 60s).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "delay_flex": {
            "type": "string",
            "description": "Flexible interval, e.g. 50s;1-7,00:00-24:00 (50s Mon-Sun 24/7).",
            "description_kind": "markdown",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether the item is enabled.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "history": {
            "type": "string",
            "description": "History storage period (e.g. 90d).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "host_id": {
            "type": "string",
            "description": "ID of the host or template to attach the item to. Changing this forces recreation.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "Item key (e.g. epson.lamp.hours, agent.ping, icmpping).",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Item name (e.g. Lamp time, ICMP ping).",
            "description_kind": "markdown",
            "required": true
          },
          "snmp_oid": {
            "type": "string",
            "description": "SNMP OID. Required only for SNMP types (1, 2, 3).",
            "description_kind": "markdown",
            "optional": true
          },
          "trends": {
            "type": "string",
            "description": "Trends storage period (e.g. 365d).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "number",
            "description": "Item type (Zabbix 6.4): 0=Zabbix agent, 2=Zabbix trapper, 5=Simple check, 7=Zabbix agent (active), 20=SNMP agent. Changing this forces recreation.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "units": {
            "type": "string",
            "description": "Display units (e.g. !h for hours).",
            "description_kind": "markdown",
            "optional": true
          },
          "value_type": {
            "type": "number",
            "description": "Value type: 0=float, 1=string, 2=log, 3=unsigned, 4=text.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Zabbix item resource (collection element). Supports Zabbix agent (0), SNMP (1,2,3), simple check (5), etc.",
        "description_kind": "markdown"
      }
    },
    "zabbix_template": {
      "version": 0,
      "block": {
        "attributes": {
          "host": {
            "type": "string",
            "description": "Internal template name.",
            "description_kind": "markdown",
            "required": true
          },
          "host_group_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "Group IDs to attach the template to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "macros": {
            "type": [
              "map",
              "string"
            ],
            "description": "User macros for the template (e.g. `{\"{$SNMP_COMMUNITY}\" = \"public\"}`).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Visible template name.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Zabbix template resource.",
        "description_kind": "markdown"
      }
    },
    "zabbix_trigger": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "enabled": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "expression": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "priority": {
            "type": "string",
            "description": "0..5 (0 not classified, 5 disaster).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Zabbix trigger resource.",
        "description_kind": "markdown"
      }
    },
    "zabbix_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "Email address for notifications (adds Email media to the user).",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Display name.",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "User password. Omit or leave empty to create a user without password (e.g. notification-only); on update, leave unchanged by not setting this attribute.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "role_id": {
            "type": "string",
            "description": "Role: 1=User, 2=Admin, 3=Super admin.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "user_group_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "IDs of user groups this user belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "Login name.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Zabbix user (e.g. for receiving notifications by email).",
        "description_kind": "markdown"
      }
    },
    "zabbix_user_group": {
      "version": 0,
      "block": {
        "attributes": {
          "host_group_read_ids": {
            "type": [
              "set",
              "string"
            ],
            "description": "IDs of host groups to grant Read permission (\"Autorisation de l'h\u00f4te\" in Zabbix UI).",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the user group.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Zabbix user group (e.g. for notification recipients).",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "zabbix_user_group": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "User group ID (usrgrpid).",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Exact name of the user group.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Look up a Zabbix user group by name (e.g. built-in \"No access to the frontend\").",
        "description_kind": "markdown"
      }
    }
  }
}
