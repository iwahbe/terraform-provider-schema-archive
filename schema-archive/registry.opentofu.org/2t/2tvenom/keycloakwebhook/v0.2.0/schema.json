{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "additional_headers": {
          "type": [
            "map",
            "string"
          ],
          "description_kind": "plain",
          "optional": true
        },
        "base_path": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "client_secret": {
          "type": "string",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "client_timeout": {
          "type": "number",
          "description": "Timeout (in seconds) of the Keycloak client",
          "description_kind": "plain",
          "optional": true
        },
        "initial_login": {
          "type": "bool",
          "description": "Whether or not to login to Keycloak instance on provider initialization",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "realm": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "red_hat_sso": {
          "type": "bool",
          "description": "When true, the provider will treat the Keycloak instance as a Red Hat SSO server, specifically when parsing the version returned from the /serverinfo API endpoint.",
          "description_kind": "plain",
          "optional": true
        },
        "root_ca_certificate": {
          "type": "string",
          "description": "Allows x509 calls using an unknown CA certificate (for development purposes)",
          "description_kind": "plain",
          "optional": true
        },
        "tls_insecure_skip_verify": {
          "type": "bool",
          "description": "Allows ignoring insecure certificates when set to true. Defaults to false. Disabling security check is dangerous and should be avoided.",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "The base URL of the Keycloak instance, before `/auth`",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Provider for keycloak webhooks https://github.com/p2-inc/keycloak-events. Provider configuration fully compatibly with keycloak provider https://github.com/mrparkers/terraform-provider-keycloak",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "keycloakwebhook_webhook": {
      "version": 0,
      "block": {
        "attributes": {
          "items": {
            "nested_type": {
              "attributes": {
                "created_at": {
                  "type": "string",
                  "description": "Creation date",
                  "description_kind": "plain",
                  "computed": true
                },
                "created_by": {
                  "type": "string",
                  "description": "Creator ID",
                  "description_kind": "plain",
                  "computed": true
                },
                "enabled": {
                  "type": "bool",
                  "description": "Enable/disable webhook",
                  "description_kind": "plain",
                  "required": true
                },
                "event_types": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of events. [Source](https://phasetwo.io/docs/audit-logs/admin/#resource-types)",
                  "description_kind": "plain",
                  "required": true
                },
                "id": {
                  "type": "string",
                  "description": "Webhook internal ID",
                  "description_kind": "plain",
                  "computed": true
                },
                "secret": {
                  "type": "string",
                  "description": "Secret for generating webhook signature. [Source code](https://github.com/p2-inc/keycloak-events/blob/777425be8fe8f9f072b620917f6036f0242d5641/src/main/java/io/phasetwo/keycloak/events/HttpSenderEventListenerProvider.java#L108)",
                  "description_kind": "plain",
                  "required": true,
                  "sensitive": true
                },
                "url": {
                  "type": "string",
                  "description": "Destination URL",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "required": true
          },
          "realm": {
            "type": "string",
            "description": "Realm name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Create webhook",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "keycloakwebhook_webhooks": {
      "version": 0,
      "block": {
        "attributes": {
          "realm": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "webhooks": {
            "nested_type": {
              "attributes": {
                "created_at": {
                  "type": "string",
                  "description": "Creation date",
                  "description_kind": "plain",
                  "computed": true
                },
                "created_by": {
                  "type": "string",
                  "description": "Creator ID",
                  "description_kind": "plain",
                  "computed": true
                },
                "enabled": {
                  "type": "bool",
                  "description": "Enable/disable webhook",
                  "description_kind": "plain",
                  "computed": true
                },
                "event_types": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of events. [Source](https://phasetwo.io/docs/audit-logs/admin/#resource-types)",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Webhook internal ID",
                  "description_kind": "plain",
                  "computed": true
                },
                "url": {
                  "type": "string",
                  "description": "Destination URL",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Datasource for receiving webhook list",
        "description_kind": "plain"
      }
    }
  }
}
