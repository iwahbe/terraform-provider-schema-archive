{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "sealedsecret_raw_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "certificate": {
            "type": "string",
            "description": "Public certificate to use for sealing secret.",
            "description_kind": "plain",
            "required": true
          },
          "encrypted_value": {
            "type": "string",
            "description": "Encrypted secret value",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the sealed secret",
            "description_kind": "plain",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "If present, the namespace scope for this request",
            "description_kind": "plain",
            "required": true
          },
          "scope": {
            "type": "string",
            "description": "Set the scope of the sealed secret: strict, namespace-wide, cluster-wide (defaults to strict).",
            "description_kind": "plain",
            "optional": true
          },
          "value": {
            "type": "string",
            "description": "Secret value to seal.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          }
        },
        "description": "`sealedsecret_raw_secret` creates a sealed secret from `value` input. The encrypted value is available as `encrypted_value`. This is not marked as sensitive as it is encrypted and can therefore safely be passed around.",
        "description_kind": "plain"
      }
    },
    "sealedsecret_raw_secrets": {
      "version": 0,
      "block": {
        "attributes": {
          "certificate": {
            "type": "string",
            "description": "Public certificate to use for sealing secret.",
            "description_kind": "plain",
            "required": true
          },
          "encrypted_values": {
            "type": [
              "map",
              "string"
            ],
            "description": "Encrypted secret values",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the sealed secret",
            "description_kind": "plain",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "If present, the namespace scope for this request",
            "description_kind": "plain",
            "required": true
          },
          "scope": {
            "type": "string",
            "description": "Set the scope of the sealed secret: strict, namespace-wide, cluster-wide (defaults to strict).",
            "description_kind": "plain",
            "optional": true
          },
          "values": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map of secret values to seal.",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          }
        },
        "description": "`sealedsecret_raw_secrets` creates a sealed secret for a map of inputs. This is a convenient resource to encrypt many secrets since it is not possible to iterate over sensitive values. Values are available as `encrypted_values`. This is not marked as sensitive as it is encrypted and can therefore safely be passed around and iterated over.",
        "description_kind": "plain"
      }
    }
  }
}
