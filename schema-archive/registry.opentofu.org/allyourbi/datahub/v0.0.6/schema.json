{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "Base URL for the datahub api, like: https://api.datahub.allyourbi.nl",
          "description_kind": "plain",
          "optional": true
        },
        "client_id": {
          "type": "string",
          "description": "Client ID for the Datahub Engine API. May also be provided via DATAHUB_CLIENT_ID environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "Client Secret for the Datahub Engine API. May also be provided via DATAHUB_CLIENT_SECRET environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Interact with Datahub.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "datahub_client": {
      "version": 0,
      "block": {
        "attributes": {
          "client_id": {
            "type": "string",
            "description": "ID of the client.",
            "description_kind": "plain",
            "computed": true
          },
          "client_secret": {
            "type": "string",
            "description": "Secret of the client.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "customer_code": {
            "type": "string",
            "description": "Customer code for the client.",
            "description_kind": "plain",
            "required": true
          },
          "customer_name": {
            "type": "string",
            "description": "Name of the client.",
            "description_kind": "plain",
            "required": true
          },
          "expiration_date": {
            "type": "string",
            "description": "Expiration date of the client.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages an AYBI Datahub Client.",
        "description_kind": "plain"
      }
    },
    "datahub_init_run": {
      "version": 0,
      "block": {
        "attributes": {
          "command": {
            "type": [
              "list",
              "string"
            ],
            "description": "Command to be executed in the container as a list of arguments",
            "description_kind": "plain",
            "optional": true
          },
          "environment": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "image": {
            "type": "string",
            "description": "Docker image for the job",
            "description_kind": "plain",
            "required": true
          },
          "job_id": {
            "type": "string",
            "description": "Numeric identifier of the created job",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the InitRun, needs to be unique for the current client",
            "description_kind": "plain",
            "required": true
          },
          "run_id": {
            "type": "string",
            "description": "Numeric identifier of the init run.",
            "description_kind": "plain",
            "computed": true
          },
          "secrets": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "status": {
            "type": "string",
            "description": "Status of the init run can be either OK or FAILED",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages the execution of an initialisation script",
        "description_kind": "plain"
      }
    },
    "datahub_job": {
      "version": 0,
      "block": {
        "attributes": {
          "command": {
            "type": [
              "list",
              "string"
            ],
            "description": "Command to be executed in the container as a list of arguments",
            "description_kind": "plain",
            "optional": true
          },
          "environment": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "image": {
            "type": "string",
            "description": "Docker image for the job",
            "description_kind": "plain",
            "required": true
          },
          "job_id": {
            "type": "string",
            "description": "Numeric identifier of the job.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the Job, needs to be unique for the current client",
            "description_kind": "plain",
            "required": true
          },
          "oauth": {
            "nested_type": {
              "attributes": {
                "application": {
                  "type": "string",
                  "description": "the application to connect to like 'exact_online'",
                  "description_kind": "plain",
                  "required": true
                },
                "authorization_url": {
                  "type": "string",
                  "description": "the full url to start the authorization",
                  "description_kind": "plain",
                  "required": true
                },
                "config_prefix": {
                  "type": "string",
                  "description": "the prefix for the configuration variables returned from the token response like 'EXACT_ONLINE_",
                  "description_kind": "plain",
                  "required": true
                },
                "flow": {
                  "type": "string",
                  "description": "the oauth flow type like authorization_code",
                  "description_kind": "plain",
                  "required": true
                },
                "scope": {
                  "type": "string",
                  "description": "additional scopes to set for the token request",
                  "description_kind": "plain",
                  "optional": true
                },
                "token_url": {
                  "type": "string",
                  "description": "the full URL to fetch the token from",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The OAuth config for logging into external service",
            "description_kind": "plain",
            "optional": true
          },
          "runner": {
            "type": "string",
            "description": "Name of the runner to use for this job",
            "description_kind": "plain",
            "optional": true
          },
          "secrets": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          },
          "type": {
            "type": "string",
            "description": "Job type: Full or Incremental",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages an AYBI Datahub Engine job.",
        "description_kind": "plain"
      }
    },
    "datahub_runner": {
      "version": 0,
      "block": {
        "attributes": {
          "bootstrap_token": {
            "type": "string",
            "description": "Bootstrap token returned when the runner is created.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "certificate_expiry": {
            "type": "string",
            "description": "Timestamp when the runner certificate expires.",
            "description_kind": "plain",
            "computed": true
          },
          "client_id": {
            "type": "string",
            "description": "Identifier of the client that owns the runner.",
            "description_kind": "plain",
            "computed": true
          },
          "display_name": {
            "type": "string",
            "description": "Display name of the runner.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "fingerprint": {
            "type": "string",
            "description": "Certificate fingerprint for the runner.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the runner.",
            "description_kind": "plain",
            "computed": true
          },
          "is_global": {
            "type": "bool",
            "description": "Whether the runner is global.",
            "description_kind": "plain",
            "computed": true
          },
          "last_health_ping": {
            "type": "string",
            "description": "Timestamp of the last runner health ping.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the runner. Must be unique for the current client.",
            "description_kind": "plain",
            "required": true
          },
          "registered_at": {
            "type": "string",
            "description": "Timestamp when the runner was registered.",
            "description_kind": "plain",
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Status of the runner.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a Datahub runner.",
        "description_kind": "plain"
      }
    },
    "datahub_runner_bootstrap_token": {
      "version": 0,
      "block": {
        "attributes": {
          "bootstrap_token": {
            "type": "string",
            "description": "New bootstrap token returned after regeneration.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the runner whose bootstrap token was regenerated.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the runner.",
            "description_kind": "plain",
            "computed": true
          },
          "runner_id": {
            "type": "string",
            "description": "UUID or name of the runner to reset the bootstrap token for.",
            "description_kind": "plain",
            "required": true
          },
          "triggers": {
            "type": [
              "map",
              "string"
            ],
            "description": "Arbitrary map of values that, when changed, force bootstrap token regeneration.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Rotates the bootstrap token for a Datahub runner. Replacing this resource invalidates existing runner certificates and requires the runner to bootstrap again.",
        "description_kind": "plain"
      }
    },
    "datahub_schedule": {
      "version": 0,
      "block": {
        "attributes": {
          "backfill": {
            "type": "bool",
            "description": "Whether to backfill missed runs. Default is false.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "bindings": {
            "nested_type": {
              "attributes": {
                "command": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Command to override for this job binding.",
                  "description_kind": "plain",
                  "optional": true
                },
                "environment": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "Environment variables to override for this job binding.",
                  "description_kind": "plain",
                  "optional": true
                },
                "job_id": {
                  "type": "string",
                  "description": "ID of the job to bind to this schedule.",
                  "description_kind": "plain",
                  "required": true
                },
                "secrets": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "Secrets to override for this job binding.",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of job bindings for this schedule.",
            "description_kind": "plain",
            "required": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether the schedule is enabled. Default is true.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "end_at": {
            "type": "string",
            "description": "End date/time of the schedule in RFC3339 format.",
            "description_kind": "plain",
            "optional": true
          },
          "maximum_drift": {
            "type": "number",
            "description": "Maximum drift in seconds. Default is 0.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "schedule": {
            "type": "string",
            "description": "Cron expression for the schedule.",
            "description_kind": "plain",
            "required": true
          },
          "schedule_id": {
            "type": "string",
            "description": "Identifier of the schedule.",
            "description_kind": "plain",
            "computed": true
          },
          "start_at": {
            "type": "string",
            "description": "Start date/time of the schedule in RFC3339 format.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages a Datahub schedule.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "datahub_oauth_url": {
      "version": 0,
      "block": {
        "attributes": {
          "job_id": {
            "type": "string",
            "description": "Placeholder identifier attribute.",
            "description_kind": "plain",
            "required": true
          },
          "redirect": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches an OAuth URL for starting the OAuth flow",
        "description_kind": "plain"
      }
    },
    "datahub_runners": {
      "version": 0,
      "block": {
        "attributes": {
          "runners": {
            "nested_type": {
              "attributes": {
                "certificate_expiry": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "client_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "display_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "is_global": {
                  "type": "bool",
                  "description_kind": "plain",
                  "computed": true
                },
                "last_health_ping": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "registered_at": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "status": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of runners returned by the Datahub API.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches Datahub runners.",
        "description_kind": "plain"
      }
    }
  }
}
