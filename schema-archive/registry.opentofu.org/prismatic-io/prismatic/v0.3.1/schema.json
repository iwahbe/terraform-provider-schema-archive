{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "refresh_token": {
          "type": "string",
          "description": "A [refresh token to use for headless authentication](https://prismatic.io/docs/cli/bash-scripting/#headless-prism-usage-for-cicd-pipelines) to the Prismatic API.",
          "description_kind": "plain",
          "optional": true
        },
        "tenant_id": {
          "type": "string",
          "description": "The [tenant ID to authenticate against](https://prismatic.io/docs/cli/bash-scripting/#headless-prism-usage-for-cicd-pipelines) when a refresh token grants access to multiple tenants. If omitted, it is left out of the token exchange.",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "An [access token obtained with Prism CLI](https://prismatic.io/docs/cli/prism/#metoken) of Prismatic API calls.",
          "description_kind": "plain",
          "deprecated": true,
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "URL of the Prismatic stack to communicate with. Defaults to the value of the `PRISMATIC_URL` environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "prismatic_component": {
      "version": 0,
      "block": {
        "attributes": {
          "bundle_directory": {
            "type": "string",
            "description": "Bundled directory. Reference the results of the 'Component Bundle' data source.",
            "description_kind": "plain",
            "required": true
          },
          "bundle_path": {
            "type": "string",
            "description": "Bundle path. Reference the results of the 'Component Bundle' data source.",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "The description of the Component",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the Component",
            "description_kind": "plain",
            "computed": true
          },
          "key": {
            "type": "string",
            "description": "The key of the Component",
            "description_kind": "plain",
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "The label of the Component",
            "description_kind": "plain",
            "computed": true
          },
          "signature": {
            "type": "string",
            "description": "Bundle signature. Reference the results of the 'Component Bundle' data source.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Publish a Component to Prismatic. Use the 'Component Bundle' data source to generate the bundle",
        "description_kind": "plain"
      }
    },
    "prismatic_integration": {
      "version": 0,
      "block": {
        "attributes": {
          "definition": {
            "type": "string",
            "description": "The YAML definition of the Integration",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "The description of the Integration",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the Integration",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the Integration",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Import Integrations into Prismatic using YAML definitions.",
        "description_kind": "plain"
      }
    },
    "prismatic_organization_signing_key": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the signing key",
            "description_kind": "plain",
            "computed": true
          },
          "imported": {
            "type": "bool",
            "description": "Indicates if signing key was imported or generated",
            "description_kind": "plain",
            "computed": true
          },
          "issued_at": {
            "type": "string",
            "description": "Timestamp of when the signing key was issued",
            "description_kind": "plain",
            "computed": true
          },
          "public_key": {
            "type": "string",
            "description": "Public key to import",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Import a public key into the Organization's Signing Keys",
        "description_kind": "plain"
      }
    },
    "prismatic_organization_user": {
      "version": 0,
      "block": {
        "attributes": {
          "avatar_url": {
            "type": "string",
            "description": "The URL of the user's avatar image.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "The timestamp when the user was created.",
            "description_kind": "plain",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "The email address of the user. Changing this will recreate the user.",
            "description_kind": "plain",
            "required": true
          },
          "external_id": {
            "type": "string",
            "description": "An external ID for mapping to external systems.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the user.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the user.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "phone": {
            "type": "string",
            "description": "The phone number of the user in E.164 format (e.g., +14155552671). Must start with '+' followed by 7-15 digits.",
            "description_kind": "plain",
            "optional": true
          },
          "role": {
            "type": "string",
            "description": "The ID of the role to assign to the user.",
            "description_kind": "plain",
            "required": true
          },
          "updated_at": {
            "type": "string",
            "description": "The timestamp when the user was last updated.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manage Organization Users in Prismatic.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "prismatic_authenticated_user": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "The email address of the authenticated user.",
            "description_kind": "plain",
            "computed": true
          },
          "external_id": {
            "type": "string",
            "description": "The external identifier of the authenticated user.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the authenticated user.",
            "description_kind": "plain",
            "computed": true
          },
          "org_id": {
            "type": "string",
            "description": "The unique identifier of the organization the authenticated user belongs to.",
            "description_kind": "plain",
            "computed": true
          },
          "org_name": {
            "type": "string",
            "description": "The name of the organization the authenticated user belongs to.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Data source to retrieve information about the currently authenticated user and the organization they belong to.",
        "description_kind": "plain"
      }
    },
    "prismatic_component_bundle": {
      "version": 0,
      "block": {
        "attributes": {
          "bundle_directory": {
            "type": "string",
            "description": "Directory to bundle",
            "description_kind": "plain",
            "required": true
          },
          "bundle_path": {
            "type": "string",
            "description": "Destination of the generated bundle",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "signature": {
            "type": "string",
            "description": "Signature of the bundle for detecting redundant publishes",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Generates a component bundle suitable for publishing",
        "description_kind": "plain"
      }
    },
    "prismatic_components": {
      "version": 0,
      "block": {
        "attributes": {
          "components": {
            "type": [
              "list",
              [
                "object",
                {
                  "component_description": "string",
                  "component_id": "string",
                  "component_key": "string",
                  "component_label": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Data source to list Prismatic components",
        "description_kind": "plain"
      }
    },
    "prismatic_integrations": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "integrations": {
            "type": [
              "list",
              [
                "object",
                {
                  "integration_definition": "string",
                  "integration_id": "string",
                  "integration_name": "string"
                }
              ]
            ],
            "description": "Data source to list Prismatic Integrations",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "prismatic_organization_roles": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "roles": {
            "type": [
              "list",
              [
                "object",
                {
                  "description": "string",
                  "id": "string",
                  "level": "number",
                  "name": "string"
                }
              ]
            ],
            "description": "List of organization roles available in Prismatic.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Data source to list Prismatic Organization Roles.",
        "description_kind": "plain"
      }
    },
    "prismatic_organization_signing_key": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The ID of the signing key to fetch.",
            "description_kind": "plain",
            "required": true
          },
          "imported": {
            "type": "bool",
            "description": "Indicates if the signing key was imported or generated",
            "description_kind": "plain",
            "computed": true
          },
          "issued_at": {
            "type": "string",
            "description": "The timestamp the signing key was issued at",
            "description_kind": "plain",
            "computed": true
          },
          "public_key": {
            "type": "string",
            "description": "The public key of the signing key",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Data source to retrieve an Organization's signing key",
        "description_kind": "plain"
      }
    },
    "prismatic_users": {
      "version": 0,
      "block": {
        "attributes": {
          "customer_is_null": {
            "type": "bool",
            "description": "Filter for users where customer is NULL. When true (default), returns only Organization users. When false, returns Customer users.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "users": {
            "type": [
              "list",
              [
                "object",
                {
                  "avatar_url": "string",
                  "created_at": "string",
                  "email": "string",
                  "external_id": "string",
                  "id": "string",
                  "name": "string",
                  "phone": "string",
                  "role_id": "string",
                  "role_name": "string",
                  "updated_at": "string"
                }
              ]
            ],
            "description": "List of users in Prismatic.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Data source to list Prismatic Users.",
        "description_kind": "plain"
      }
    }
  }
}
