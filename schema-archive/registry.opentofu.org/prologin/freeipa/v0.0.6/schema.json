{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "server": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "user": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "freeipa_group": {
      "version": 0,
      "block": {
        "attributes": {
          "cn": {
            "type": "string",
            "description": "Group name",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "First name",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manage FreeIPA groups",
        "description_kind": "plain"
      }
    },
    "freeipa_group_membership": {
      "version": 0,
      "block": {
        "attributes": {
          "group": {
            "type": "string",
            "description": "Group name (CN)",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "manager": {
            "type": "bool",
            "description": "The member is a manager of the group (connot be used with type service)",
            "description_kind": "plain",
            "optional": true
          },
          "member": {
            "type": "string",
            "description": "Member identifier",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Member type (must be one of \"user\", \"group\" or \"service\")",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manage FreeIPA group membership",
        "description_kind": "plain"
      }
    },
    "freeipa_idp": {
      "version": 0,
      "block": {
        "attributes": {
          "authendpoint": {
            "type": "string",
            "description": "OAuth 2.0 authorization endpoint",
            "description_kind": "plain",
            "required": true
          },
          "clientid": {
            "type": "string",
            "description": "Client ID",
            "description_kind": "plain",
            "required": true
          },
          "clientsecret": {
            "type": "string",
            "description": "Client secret",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "cn": {
            "type": "string",
            "description": "Identity Provider server name",
            "description_kind": "plain",
            "required": true
          },
          "devauthendpoint": {
            "type": "string",
            "description": "Device authorization endpoint",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "issuerurl": {
            "type": "string",
            "description": "OIDC URL",
            "description_kind": "plain",
            "optional": true
          },
          "keysendpoint": {
            "type": "string",
            "description": "JWKS endpoint",
            "description_kind": "plain",
            "required": true
          },
          "scope": {
            "type": "string",
            "description": "Scope (space separated)",
            "description_kind": "plain",
            "optional": true
          },
          "sub": {
            "type": "string",
            "description": "External IdP user identifier attribute",
            "description_kind": "plain",
            "optional": true
          },
          "tokenendpoint": {
            "type": "string",
            "description": "Token endpoint",
            "description_kind": "plain",
            "required": true
          },
          "userinfoendpoint": {
            "type": "string",
            "description": "User information endpoint",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage FreeIPA IDP (Identity Provider)",
        "description_kind": "plain"
      }
    },
    "freeipa_service": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "krbcanonicalname": {
            "type": "string",
            "description": "Service canonical name (in the form of service/host_fqdn)",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage FreeIPA services",
        "description_kind": "plain"
      }
    },
    "freeipa_user": {
      "version": 0,
      "block": {
        "attributes": {
          "givenname": {
            "type": "string",
            "description": "First name",
            "description_kind": "plain",
            "required": true
          },
          "homedirectory": {
            "type": "string",
            "description": "Home directory\nIf not specified, the default home directory will be used.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "krbpasswordexpiration": {
            "type": "string",
            "description": "Password expiration date (in RFC3339 format)\nIf not specified, the password will be immediately expired. This follows the default behavior of the API.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "mail": {
            "type": [
              "list",
              "string"
            ],
            "description": "Email addresses\nIf not specified, no email will be set. Note that this DOES NOT follows the API default behavior (that would have been to create UID@REALM email by default).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "User password",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "sn": {
            "type": "string",
            "description": "Last name",
            "description_kind": "plain",
            "required": true
          },
          "uid": {
            "type": "string",
            "description": "User UID (login)",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manage FreeIPA users",
        "description_kind": "plain"
      }
    }
  }
}
