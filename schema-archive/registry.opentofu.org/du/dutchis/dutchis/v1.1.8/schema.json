{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "dutchis_api_token": {
          "type": "string",
          "description": "API Secret",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "dutchis_log_enable": {
          "type": "bool",
          "description": "Enable provider logging to get DutchIS API logs",
          "description_kind": "plain",
          "optional": true
        },
        "dutchis_log_file": {
          "type": "string",
          "description": "Write logs to this specific file",
          "description_kind": "plain",
          "optional": true
        },
        "dutchis_log_levels": {
          "type": [
            "map",
            "string"
          ],
          "description": "Configure the logging level to display; trace, debug, info, warn, etc",
          "description_kind": "plain",
          "required": true
        },
        "dutchis_parallel": {
          "type": "number",
          "description": "Maximum number of parallel requests to the DutchIS API",
          "description_kind": "plain",
          "required": true
        },
        "dutchis_team_uuid": {
          "type": "string",
          "description": "Team UUID to which to deploy to.",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dutchis_virtualserver": {
      "version": 0,
      "block": {
        "attributes": {
          "class": {
            "type": "string",
            "description": "The Performance class of the virtual server",
            "description_kind": "plain",
            "required": true
          },
          "cores": {
            "type": "number",
            "description": "The amount of cores to assign to the virtual server",
            "description_kind": "plain",
            "required": true
          },
          "disk": {
            "type": "number",
            "description": "The amount of storage space in GB to assign to the virtual server",
            "description_kind": "plain",
            "required": true
          },
          "hostname": {
            "type": "string",
            "description": "The virtual server hostname",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "memory": {
            "type": "number",
            "description": "The amount of memory in GB to assign to the virtual server",
            "description_kind": "plain",
            "required": true
          },
          "network": {
            "type": "number",
            "description": "The network speed in Gbps for this virtual server",
            "description_kind": "plain",
            "required": true
          },
          "os": {
            "type": "string",
            "description": "OS id of the virtual server",
            "description_kind": "plain",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "The password of the default user",
            "description_kind": "plain",
            "required": true
          },
          "sshkeys": {
            "type": [
              "list",
              "string"
            ],
            "description": "Provide the UUID's of ssh keys or provide a ssh key in openssh format.",
            "description_kind": "plain",
            "required": true
          },
          "username": {
            "type": "string",
            "description": "The username of the virtual server. This is ignored on Windows servers",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "default": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "read": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
