{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "pm_api_token": {
          "type": "string",
          "description": "API Token",
          "description_kind": "plain",
          "optional": true
        },
        "pm_api_url": {
          "type": "string",
          "description": "https://host.fqdn/vm/v3",
          "description_kind": "plain",
          "required": true
        },
        "pm_dangerously_ignore_unknown_attributes": {
          "type": "bool",
          "description": "By default this provider will exit if an unknown attribute is found. This is to prevent the accidential destruction of VMs or Data when something in the VMmanager 6 API has changed/updated and is not confirmed to work with this provider. Set this to true at your own risk. It may allow you to proceed in cases when the provider refuses to work, but be aware of the danger in doing so.",
          "description_kind": "plain",
          "optional": true
        },
        "pm_debug": {
          "type": "bool",
          "description": "Enable or disable the verbose debug output from VMmanager 6 api",
          "description_kind": "plain",
          "optional": true
        },
        "pm_email": {
          "type": "string",
          "description": "Email e.g. admin@example.com",
          "description_kind": "plain",
          "optional": true
        },
        "pm_log_enable": {
          "type": "bool",
          "description": "Enable provider logging to get VMmanager API logs",
          "description_kind": "plain",
          "optional": true
        },
        "pm_log_file": {
          "type": "string",
          "description": "Write logs to this specific file",
          "description_kind": "plain",
          "optional": true
        },
        "pm_log_levels": {
          "type": [
            "map",
            "string"
          ],
          "description": "Configure the logging level to display; trace, debug, info, warn, etc",
          "description_kind": "plain",
          "optional": true
        },
        "pm_parallel": {
          "type": "number",
          "description_kind": "plain",
          "optional": true
        },
        "pm_password": {
          "type": "string",
          "description": "Password to authenticate into vmmanager6",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "pm_timeout": {
          "type": "number",
          "description": "How much second to wait for operations for both provider and api-client, default is 300s",
          "description_kind": "plain",
          "optional": true
        },
        "pm_tls_insecure": {
          "type": "bool",
          "description": "By default, every TLS connection is verified to be secure. This option allows terraform to proceed and operate on servers considered insecure. For example if you're connecting to a remote host and you do not have the CA cert that issued the VMmanager 6 api url's certificate.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "vmmanager6_account": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "User log in to VMmanager by email",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "User password",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "role": {
            "type": "string",
            "description": "User role, must be @admin or @advanced_user or @user",
            "description_kind": "plain",
            "optional": true
          },
          "state": {
            "type": "string",
            "description": "Internal - user state",
            "description_kind": "plain",
            "computed": true
          }
        },
        "block_types": {
          "ssh_keys": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "id": {
                  "type": "number",
                  "description": "id of public ssh key",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "name of public ssh key",
                  "description_kind": "plain",
                  "required": true
                },
                "ssh_pub_key": {
                  "type": "string",
                  "description": "public ssh key",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "Set of public ssh keys for account",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "vmmanager6_network": {
      "version": 0,
      "block": {
        "attributes": {
          "desc": {
            "type": "string",
            "description": "Network Description",
            "description_kind": "plain",
            "optional": true
          },
          "gateway": {
            "type": "string",
            "description": "Ip address of gateway",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "network": {
            "type": "string",
            "description": "Ipv4 or Ipv6 Network in CIDR format",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "vmmanager6_pool": {
      "version": 0,
      "block": {
        "attributes": {
          "cluster": {
            "type": "number",
            "description": "id of Cluster where need to enable pool",
            "description_kind": "plain",
            "optional": true
          },
          "desc": {
            "type": "string",
            "description": "Pool Description",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "pool": {
            "type": "string",
            "description": "Ipv4 or Ipv6 Network in CIDR format",
            "description_kind": "plain",
            "required": true
          },
          "ranges": {
            "type": [
              "list",
              "string"
            ],
            "description": "Range of ips in pool. Format: 192.168.0.1 or 192.168.0.1-192.168.0.10 or 192.168.0.0/24",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "vmmanager6_vm_qemu": {
      "version": 0,
      "block": {
        "attributes": {
          "account": {
            "type": "number",
            "description": "VMmanager user id",
            "description_kind": "plain",
            "optional": true
          },
          "anti_spoofing": {
            "type": "bool",
            "description": "Anti spoofing",
            "description_kind": "plain",
            "optional": true
          },
          "cluster": {
            "type": "number",
            "description": "VMmanager 6 cluster id",
            "description_kind": "plain",
            "optional": true
          },
          "cores": {
            "type": "number",
            "description": "Number of vCPU's for VM",
            "description_kind": "plain",
            "optional": true
          },
          "cpu_mode": {
            "type": "string",
            "description": "Cpu mode. Can be default, host-model, host-passthrough",
            "description_kind": "plain",
            "optional": true
          },
          "desc": {
            "type": "string",
            "description": "The VM description",
            "description_kind": "plain",
            "optional": true
          },
          "disk": {
            "type": "number",
            "description": "Disk Size of VM in Megabytes",
            "description_kind": "plain",
            "optional": true
          },
          "disk_id": {
            "type": "number",
            "description": "Internal variable. Main disk ID of VM",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "Domain for VM's ip addresses and hostname",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ip_addresses": {
            "type": [
              "list",
              [
                "object",
                {
                  "addr": "string",
                  "domain": "string",
                  "family": "number",
                  "gateway": "string",
                  "id": "number",
                  "mask": "string",
                  "netid": "number"
                }
              ]
            ],
            "description": "Internal. List of vms ip addresses",
            "description_kind": "plain",
            "computed": true
          },
          "ipv4_number": {
            "type": "number",
            "description": "Number of ipv4 addresses",
            "description_kind": "plain",
            "optional": true
          },
          "ipv4_pools": {
            "type": [
              "list",
              "number"
            ],
            "description": "VMmanager ip pools, to use for ip assignment",
            "description_kind": "plain",
            "optional": true
          },
          "memory": {
            "type": "number",
            "description": "RAM Size of VM in Megabytes",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The VM name",
            "description_kind": "plain",
            "required": true
          },
          "node": {
            "type": "number",
            "description": "VMmanager 6 node id",
            "description_kind": "plain",
            "optional": true
          },
          "os": {
            "type": "number",
            "description": "VMmanager 6 template id",
            "description_kind": "plain",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Password for VM",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "preset": {
            "type": "number",
            "description": "id of VM preset. Preset will overwrite your cpu/mem/disk settings",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "custom_interfaces": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "bridge": {
                  "type": "string",
                  "description": "Bridge name for interface",
                  "description_kind": "plain",
                  "optional": true
                },
                "ip_count": {
                  "type": "number",
                  "description": "How many ips add to this interface from ip_pool",
                  "description_kind": "plain",
                  "optional": true
                },
                "ip_name": {
                  "type": "string",
                  "description": "Ip address to apply",
                  "description_kind": "plain",
                  "optional": true
                },
                "ippool": {
                  "type": "number",
                  "description": "Pool of ip addresses to apply",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "You can set some ip address manually (use ip_name) or using pool id (ip_pool)",
              "description_kind": "plain"
            }
          },
          "recipes": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "recipe": {
                  "type": "number",
                  "description": "id of recipe",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "recipe_params": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "param name",
                        "description_kind": "plain",
                        "required": true
                      },
                      "value": {
                        "type": "string",
                        "description": "param value",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description": "Array of recipe params",
                    "description_kind": "plain"
                  }
                }
              },
              "description": "Array of recipes and params",
              "description_kind": "plain"
            }
          },
          "vxlan": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "id": {
                  "type": "number",
                  "description": "id of VxLAN",
                  "description_kind": "plain",
                  "required": true
                },
                "ipnet": {
                  "type": "number",
                  "description": "id of network inside VxLAN",
                  "description_kind": "plain",
                  "required": true
                },
                "ipv4_number": {
                  "type": "number",
                  "description": "How many ips from VxLAN needed",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Use vxlan to create VM in local network without public ips, or mix it with custom_interfaces",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
    "vmmanager6_vxlan": {
      "version": 0,
      "block": {
        "attributes": {
          "account": {
            "type": "number",
            "description": "Account for VxLAN",
            "description_kind": "plain",
            "required": true
          },
          "clusters": {
            "type": [
              "list",
              "number"
            ],
            "description": "Array of clusters id, where this VxLAN will work",
            "description_kind": "plain",
            "required": true
          },
          "comment": {
            "type": "string",
            "description": "VxLAN Description",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ippool": {
            "type": "number",
            "description": "id of Ip pool, can be used for vm creation",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of VxLAN",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "ipnets": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "gateway": {
                  "type": "string",
                  "description": "Gateway for this network",
                  "description_kind": "plain",
                  "required": true
                },
                "id": {
                  "type": "number",
                  "description": "Id of network inside VxLAN",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "IPv4 range in CIDR format",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "List of networks, that need to be added to VxLAN",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
