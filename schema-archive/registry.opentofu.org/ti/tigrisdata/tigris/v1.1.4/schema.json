{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "access_key": {
          "type": "string",
          "description": "The access key. It can also be sourced from the AWS_ACCESS_KEY_ID environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "The endpoint for the Tigris object storage service.",
          "description_kind": "plain",
          "optional": true
        },
        "secret_key": {
          "type": "string",
          "description": "The secret key. It can also be sourced from the AWS_SECRET_ACCESS_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "tigris_bucket": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
            "description": "The name of the Tigris bucket.",
            "description_kind": "plain",
            "required": true
          },
          "default_storage_tier": {
            "type": "string",
            "description": "The default storage tier for objects in the bucket: STANDARD, STANDARD_IA, GLACIER, or GLACIER_IR.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "enable_snapshot": {
            "type": "bool",
            "description": "Enable snapshots for this bucket. Cannot be changed after creation.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "block_types": {
          "location": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "regions": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "The region codes. For multi: usa or eur. For single/dual: specific region codes like sjc, iad, ams, etc.",
                  "description_kind": "plain",
                  "optional": true
                },
                "type": {
                  "type": "string",
                  "description": "The location type: global, multi, dual, or single.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description": "The location configuration for the bucket. Controls data placement and replication.",
              "description_kind": "plain"
            },
            "max_items": 1
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "read": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Provides a Tigris bucket resource. This can be used to create and manage Tigris buckets.",
        "description_kind": "plain"
      }
    },
    "tigris_bucket_fork": {
      "version": 0,
      "block": {
        "attributes": {
          "bucket": {
            "type": "string",
