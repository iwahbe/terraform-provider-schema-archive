                  "optional": true
                },
                "update": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description": "Provides a Tigris bucket public access configuration resource.",
        "description_kind": "plain"
      }
    },
