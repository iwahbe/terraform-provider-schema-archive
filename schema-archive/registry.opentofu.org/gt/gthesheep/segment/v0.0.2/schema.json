{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_url": {
          "type": "string",
          "description": "Base Api URL to use, i.e. https://eu1.api.segmentapis.com if your Segment account is hosted in the EU",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Public API token for your Segment account",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "segment_destination": {
      "version": 0,
      "block": {
        "attributes": {
          "destination_slug": {
            "type": "string",
            "description": "Slug for the destination, from a list",
            "description_kind": "plain",
            "required": true
          },
          "enabled": {
            "type": "bool",
            "description": "Flag for whether or not the destination is enabled",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Descriptive name for the destination",
            "description_kind": "plain",
            "required": true
          },
          "settings": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map containing settings for the destination, currently all values must be provided as strings",
            "description_kind": "plain",
            "required": true
          },
          "source_id": {
            "type": "string",
            "description": "Identifier of the source to connect this destination to",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "segment_source": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Flag for whether or not the source is enabled",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Descriptive name for the source",
            "description_kind": "plain",
            "required": true
          },
          "slug": {
            "type": "string",
            "description": "Slug for the source, lower case",
            "description_kind": "plain",
            "required": true
          },
          "source_slug": {
            "type": "string",
            "description": "Slug for the source, from a list",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "settings": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "forwarding_blocked_events_to": {
                  "type": "string",
                  "description": "SourceId to forward blocked events to.",
                  "description_kind": "plain",
                  "optional": true
                },
                "forwarding_violations_to": {
                  "type": "string",
                  "description": "SourceId to forward violations to.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "block_types": {
                "group": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "allow_traits_on_violations": {
                        "type": "bool",
                        "description": "Enable to allow identify traits on violations.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "allow_unplanned_traits": {
                        "type": "bool",
                        "description": "Enable to allow unplanned identify traits.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "common_event_on_violations": {
                        "type": "string",
                        "description": "The common track event on violations.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "min_items": 1
                },
                "identify": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "allow_traits_on_violations": {
                        "type": "bool",
                        "description": "Enable to allow identify traits on violations.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "allow_unplanned_traits": {
                        "type": "bool",
                        "description": "Enable to allow unplanned identify traits.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "common_event_on_violations": {
                        "type": "string",
                        "description": "The common track event on violations.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "min_items": 1
                },
                "track": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "allow_event_on_violations": {
                        "type": "bool",
                        "description": "Allow track event on violations.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "allow_properties_on_violations": {
                        "type": "bool",
                        "description": "Enable to allow track properties on violations.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "allow_unplanned_event_properties": {
                        "type": "bool",
                        "description": "Enable to allow unplanned track event properties.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "allow_unplanned_events": {
                        "type": "bool",
                        "description": "Enable to allow unplanned track events.",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "common_event_on_violations": {
                        "type": "string",
                        "description": "The common track event on violations.",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  }
                }
              },
              "description": "Map containing settings for the source",
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "segment_warehouse": {
      "version": 0,
      "block": {
        "attributes": {
          "enabled": {
            "type": "bool",
            "description": "Flag for whether or not the warehouse is enabled",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Descriptive name for the warehouse",
            "description_kind": "plain",
            "required": true
          },
          "warehouse_slug": {
            "type": "string",
            "description": "Slug for the warehouse, from a list",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "settings": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "ciphertext": {
                  "type": "string",
                  "description": "Ciphertext for the warehouse",
                  "description_kind": "plain",
                  "computed": true
                },
                "database": {
                  "type": "string",
                  "description": "Database for the warehouse",
                  "description_kind": "plain",
                  "optional": true
                },
                "hostname": {
                  "type": "string",
                  "description": "Hostname for the warehouse",
                  "description_kind": "plain",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "Warehouse name gets stored in the settings after creation",
                  "description_kind": "plain",
                  "computed": true
                },
                "password": {
                  "type": "string",
                  "description": "Password for the warehouse, can't be imported, and beware of storing in the state file!",
                  "description_kind": "plain",
                  "optional": true,
                  "sensitive": true
                },
                "port": {
                  "type": "number",
                  "description": "Port for the warehouse",
                  "description_kind": "plain",
                  "optional": true
                },
                "username": {
                  "type": "string",
                  "description": "Username for the warehouse",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Map containing settings for the warehouse",
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
