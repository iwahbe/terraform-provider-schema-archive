{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "synology_file": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "Contents of the file",
            "description_kind": "plain",
            "required": true
          },
          "filename": {
            "type": "string",
            "description": "The filename including path",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "synology_folder": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "Path of the folder",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "synology_vmm_guest": {
      "version": 0,
      "block": {
        "attributes": {
          "autorun": {
            "type": "number",
            "description": "Optional. 0: off 1: last state 2: on",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Optional. The description of the guest.",
            "description_kind": "plain",
            "optional": true
          },
          "guest_id": {
            "type": "string",
            "description": "The guest name",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "guest_name": {
            "type": "string",
            "description": "The guest name",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "poweron": {
            "type": "bool",
            "description": "Optional. Default VM is not powered on.",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "The guest status. (running/shutdown/inaccessiblen/booting/shutting_down/moving/stor_migrating/creating/importing/preparing/ha_standby/unknown/crashed/undefined",
            "description_kind": "plain",
            "computed": true
          },
          "storage_id": {
            "type": "string",
            "description": "Optional. The id of storage where the guest resides. Note: At least storage_id or storage_name should be given.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "storage_name": {
            "type": "string",
            "description": "Optional. The name of storage where the guest resides. Note: At least storage_id or storage_name should be given.",
            "description_kind": "plain",
            "optional": true
          },
          "vcpu_num": {
            "type": "number",
            "description": "Optional. The vCPU number",
            "description_kind": "plain",
            "optional": true
          },
          "vram_size": {
            "type": "number",
            "description": "Optional. The memory size in MB",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "vdisks": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "controller": {
                  "type": "number",
                  "description": "1: VirtIO 2: IDE 3: SATA",
                  "description_kind": "plain",
                  "computed": true
                },
                "create_type": {
                  "type": "number",
                  "description": "0: Create an empty vDisk, 1: Clone an existing image",
                  "description_kind": "plain",
                  "required": true
                },
                "image_id": {
                  "type": "string",
                  "description": "Optional. If create_type is 1, at least image_id or image_name should be given. The id of the image that is to be cloned. Note: Image type should be disk.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "image_name": {
                  "type": "string",
                  "description": "Optional. If create_type is 1, at least image_id or image_name should be given. The name of the image that is to be cloned. Note: Image type should be disk.",
                  "description_kind": "plain",
                  "optional": true
                },
                "unmap": {
                  "type": "bool",
                  "description": "Determine whether to enable space reclamation.",
                  "description_kind": "plain",
                  "computed": true
                },
                "vdisk_id": {
                  "type": "string",
                  "description": "The id of this vDisk.",
                  "description_kind": "plain",
                  "computed": true
                },
                "vdisk_size": {
                  "type": "number",
                  "description": "Optional. If create_type is 0, this field must be set. The created vDisk size in MB.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1
          },
          "vnics": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "mac": {
                  "type": "string",
                  "description": "Optional. MAC address. If not specified, a MAC address of this vNIC will be randomly generated.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "model": {
                  "type": "number",
                  "description": "1: VirtIO 2: e1000 3: rtl8139",
                  "description_kind": "plain",
                  "computed": true
                },
                "network_id": {
                  "type": "string",
                  "description": "Optional. Connected network group id. At least network_id or network_name should be given. Note: network_id can be an empty string to represent not being connected.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "network_name": {
                  "type": "string",
                  "description": "Optional. Connected network group name. At least network_id or network_name should be given.",
                  "description_kind": "plain",
                  "optional": true
                },
                "vnic_id": {
                  "type": "string",
                  "description": "The id of this vNIC.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "synology_vmm_guest": {
      "version": 0,
      "block": {
        "attributes": {
          "auto_run": {
            "type": "number",
            "description": "0: off 1: last state 2: on",
            "description_kind": "plain",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description of the guest.",
            "description_kind": "plain",
            "computed": true
          },
          "guest_id": {
            "type": "string",
            "description": "The id of this guest.",
            "description_kind": "plain",
            "computed": true
          },
          "guest_name": {
            "type": "string",
            "description": "The name of this guest",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "The guest status. (running/shutdown/inaccessiblen/booting/shutting_down/moving/stor_migrating/creating/importing/preparing/ha_standby/unknown/crashed/undefined",
            "description_kind": "plain",
            "computed": true
          },
          "storage_id": {
            "type": "string",
            "description": "The id of storage where the guest resides.",
            "description_kind": "plain",
            "computed": true
          },
          "storage_name": {
            "type": "string",
            "description": "The name of storage where the guest resides.",
            "description_kind": "plain",
            "computed": true
          },
          "vcpu_num": {
            "type": "number",
            "description": "The number of vCPU.",
            "description_kind": "plain",
            "computed": true
          },
          "vdisks": {
            "type": [
              "list",
              [
                "object",
                {
                  "controller": "number",
                  "unmap": "bool",
                  "vdisk_id": "string",
                  "vdisk_size": "number"
                }
              ]
