      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "networks": {
            "type": [
              "list",
              [
                "object",
                {
                  "network_id": "string",
                  "network_name": "string"
                }
              ]
            ],
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "synology_vmm_guest_storage": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
