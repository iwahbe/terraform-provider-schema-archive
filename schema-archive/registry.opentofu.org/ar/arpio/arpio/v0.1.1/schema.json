{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "account_id": {
          "type": "string",
          "description": "Arpio account that protects and recovers stateful resources",
          "description_kind": "plain",
          "required": true
        },
        "api_key_id": {
          "type": "string",
          "description": "ID of the Arpio API key authorized to access the specified Arpio account",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "api_key_secret": {
          "type": "string",
          "description": "Secret for the Arpio API key authorized to access the specified Arpio account",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "api_url": {
          "type": "string",
          "description": "URL of the Arpio API",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "arpio_app": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "notification_emails": {
            "type": [
              "list",
              "string"
            ],
            "description": "Email address of Arpio users who wish to receive notification emails",
            "description_kind": "plain",
            "optional": true
          },
          "primary_account_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "primary_region": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "recovery_account_id": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "recovery_region": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "rpo": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "resources": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "arns": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "ARNs of stateful resources that Arpio should protect",
                  "description_kind": "plain",
                  "optional": true
                },
                "tags": {
                  "type": [
                    "map",
                    "string"
                  ],
                  "description": "Tags matching stateful resources that Arpio should protect",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Specifies rules for matching resources to protect",
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "arpio_recovery_point": {
      "version": 0,
      "block": {
        "attributes": {
          "app_id": {
            "type": "string",
            "description": "ID of the Arpio application resource the recovery point was created for",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "primary_account_id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "primary_region": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "recovery_account_id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "recovery_region": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "timeout": {
            "type": "string",
            "description": "Duration to wait for a matching recovery point to exist",
            "description_kind": "plain",
            "optional": true
          },
          "timestamp": {
            "type": "string",
            "description": "Point in time to find the nearest existing recovery point (RFC 3339 format)",
            "description_kind": "plain",
            "optional": true
          },
          "timestamp_min": {
            "type": "string",
            "description": "Select only recovery points created on or after this point in time (RFC 3339 format)",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Identifies an Arpio recovery point that can be used to recover stateful resources",
        "description_kind": "plain"
      }
    }
  }
}
