{
  "provider": {
    "version": 0,
    "block": {
      "description": "Interact with the iTunes Search API: https://performance-partners.apple.com/search-api",
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "itunessearchapi_content": {
      "version": 0,
      "block": {
        "attributes": {
          "amg_album_ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of AMG album IDs for lookup requests.",
            "description_kind": "markdown",
            "optional": true
          },
          "amg_artist_ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of AMG artist IDs for lookup requests.",
            "description_kind": "markdown",
            "optional": true
          },
          "amg_video_ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of AMG video IDs for lookup requests.",
            "description_kind": "markdown",
            "optional": true
          },
          "app_store_urls": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of App Store URLs. Mutually exclusive with all other selectors.",
            "description_kind": "markdown",
            "optional": true
          },
          "attribute": {
            "type": "string",
            "description": "Search attribute that constrains which field Apple matches against your term (for example, songTerm, albumTerm, titleTerm).",
            "description_kind": "markdown",
            "optional": true
          },
          "bundle_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of application bundle IDs for lookup requests.",
            "description_kind": "markdown",
            "optional": true
          },
          "callback": {
            "type": "string",
            "description": "Optional JavaScript callback name for JSONP search responses. Terraform automatically unwraps the callback when decoding.",
            "description_kind": "markdown",
            "optional": true
          },
          "country": {
            "type": "string",
            "description": "ISO 2-letter country code (lowercase). See http://en.wikipedia.org/wiki/ISO_3166-1_alpha-2 for a list of ISO Country Codes.",
            "description_kind": "markdown",
            "optional": true
          },
          "entity": {
            "type": "string",
            "description": "The type of results you want returned, relative to the specified media type. Supported values: 'movieArtist', 'movie', 'podcastAuthor', 'podcast', 'podcastEpisode', 'musicArtist', 'musicTrack', 'album', 'musicVideo', 'mix', 'song', 'audiobookAuthor', 'audiobook', 'shortFilmArtist', 'shortFilm', 'tvEpisode', 'tvSeason', 'software', 'iPadSoftware', 'desktopSoftware', 'ebook', 'allArtist', 'allTrack'. See the iTunes Search API documentation for more details.",
            "description_kind": "markdown",
            "optional": true
          },
          "explicit": {
            "type": "bool",
            "description": "Whether to include explicit content in search results. Defaults to true when unset.",
            "description_kind": "markdown",
            "optional": true
          },
          "ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of iTunes IDs to look up specific content. Mutually exclusive with all other selectors.",
            "description_kind": "markdown",
            "optional": true
          },
          "isbns": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of ISBN codes for lookup requests.",
            "description_kind": "markdown",
            "optional": true
          },
          "lang": {
            "type": "string",
            "description": "Language for the returned results (en_us or ja_jp).",
            "description_kind": "markdown",
            "optional": true
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of results to return. For lookups, this overrides the provider-managed defaults when you need to limit nested collections (for example, top 5 albums per artist). Valid range is 1-200.",
            "description_kind": "markdown",
            "optional": true
          },
          "media": {
            "type": "string",
            "description": "Media type, defaults to 'all'. Supported values: 'movie', 'podcast', 'music', 'musicVideo', 'audiobook', 'shortFilm', 'tvShow', 'software', 'ebook', 'all'. See the iTunes Search API documentation for more details.",
            "description_kind": "markdown",
            "optional": true
          },
          "offset": {
            "type": "number",
            "description": "Result offset for paginating term-based searches.",
            "description_kind": "markdown",
            "optional": true
          },
          "results": {
            "nested_type": {
              "attributes": {
                "artist_view_url": {
                  "type": "string",
                  "description": "URL to artist view.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "artwork_base64": {
                  "type": "string",
                  "description": "Base64-encoded artwork image.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "artwork_url": {
                  "type": "string",
                  "description": "Artwork URL.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "average_rating": {
                  "type": "number",
                  "description": "Average user rating.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "bundle_id": {
                  "type": "string",
                  "description": "Bundle ID for apps.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "currency": {
                  "type": "string",
                  "description": "Currency code.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "description": {
                  "type": "string",
                  "description": "Description of the content.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "file_size_bytes": {
                  "type": "string",
                  "description": "File size in bytes.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "formatted_price": {
                  "type": "string",
                  "description": "Formatted price string.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "genres": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of genres.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "kind": {
                  "type": "string",
                  "description": "Kind of content (e.g., software, ebook).",
                  "description_kind": "markdown",
                  "computed": true
                },
                "languages": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of supported languages.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "minimum_os_version": {
                  "type": "string",
                  "description": "Minimum OS version required.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "price": {
                  "type": "number",
                  "description": "Price.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "primary_genre": {
                  "type": "string",
                  "description": "Primary genre.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "rating_count": {
                  "type": "number",
                  "description": "Number of ratings.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "release_date": {
                  "type": "string",
                  "description": "Release date.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "seller_name": {
                  "type": "string",
                  "description": "Name of the seller.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "supported_devices": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of supported devices.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "track_id": {
                  "type": "number",
                  "description": "iTunes track ID.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "track_name": {
                  "type": "string",
                  "description": "Name of the track.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "track_view_url": {
                  "type": "string",
                  "description": "URL to track view.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "version": {
                  "type": "string",
                  "description": "Current version.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of content search results.",
            "description_kind": "markdown",
            "computed": true
          },
          "sort": {
            "type": "string",
            "description": "Sort order for lookup results when supported by the API (amg_artist_ids lookups). Allowed values: popular, recent.",
            "description_kind": "markdown",
            "optional": true
          },
          "term": {
            "type": "string",
            "description": "Search term (e.g. app name). Mutually exclusive with lookup identifiers.",
            "description_kind": "markdown",
            "optional": true
          },
          "timeouts": {
            "nested_type": {
              "attributes": {
                "read": {
                  "type": "string",
                  "description": "A string that can be [parsed as a duration](https://pkg.go.dev/time#ParseDuration) consisting of numbers and unit suffixes, such as \"30s\" or \"2h45m\". Valid time units are \"s\" (seconds), \"m\" (minutes), \"h\" (hours).",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description_kind": "plain",
            "optional": true
          },
          "upcs": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of UPC/EAN codes for lookup requests.",
            "description_kind": "markdown",
            "optional": true
          },
          "version": {
            "type": "number",
            "description": "Search result key version to request from Apple (1 or 2).",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Search for, or lookup content in the iTunes Store.",
        "description_kind": "markdown"
      }
    }
  }
}
