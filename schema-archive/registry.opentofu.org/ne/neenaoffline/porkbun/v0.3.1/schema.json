{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Porkbun API key. Can also be set via the PORKBUN_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "secret_api_key": {
          "type": "string",
          "description": "Porkbun Secret API key. Can also be set via the PORKBUN_SECRET_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Interact with Porkbun DNS API.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "porkbun_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "The answer content for the record.",
            "description_kind": "plain",
            "required": true
          },
          "domain": {
            "type": "string",
            "description": "The domain name for the DNS record (e.g., example.com).",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the DNS record.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The subdomain for the record, not including the domain itself. Leave empty for root domain. Use * for wildcard.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "notes": {
            "type": "string",
            "description": "Notes for the DNS record.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "prio": {
            "type": "string",
            "description": "The priority of the record for those that support it (e.g., MX, SRV).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ttl": {
            "type": "string",
            "description": "The time to live in seconds for the record. Minimum and default is 600.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The type of DNS record. Valid types are: A, MX, CNAME, ALIAS, TXT, NS, AAAA, SRV, TLSA, CAA, HTTPS, SVCB.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a DNS record in Porkbun.",
        "description_kind": "plain"
      }
    },
    "porkbun_domain_nameservers": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The domain name to configure name servers for (e.g., example.com).",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The domain name (used as identifier).",
            "description_kind": "plain",
            "computed": true
          },
          "nameservers": {
            "type": [
              "set",
              "string"
            ],
            "description": "Set of name servers for the domain. If you want to use Porkbun's name servers, use: curitiba.ns.porkbun.com, fortaleza.ns.porkbun.com, maceio.ns.porkbun.com, salvador.ns.porkbun.com",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages the name servers for a domain in Porkbun.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "porkbun_dns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "content": {
            "type": "string",
            "description": "The answer content for the record.",
            "description_kind": "plain",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "The domain name for the DNS record (e.g., example.com).",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the DNS record.",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "The subdomain for the record.",
            "description_kind": "plain",
            "computed": true
          },
          "notes": {
            "type": "string",
            "description": "Notes for the DNS record.",
            "description_kind": "plain",
            "computed": true
          },
          "prio": {
            "type": "string",
            "description": "The priority of the record.",
            "description_kind": "plain",
            "computed": true
          },
          "ttl": {
            "type": "string",
            "description": "The time to live in seconds for the record.",
            "description_kind": "plain",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "The type of DNS record.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches a DNS record from Porkbun.",
        "description_kind": "plain"
      }
    }
  }
}
