{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_base_url": {
          "type": "string",
          "description": "the base URL for API request",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "an API access token generated by the Travis CI command line client: `travis token`",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "travis_cron": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Whether the cron is active.",
            "description_kind": "plain",
            "computed": true
          },
          "branch": {
            "type": "string",
            "description": "The branch to which this cron job belongs.",
            "description_kind": "plain",
            "required": true
          },
          "created_at": {
            "type": "string",
            "description": "When the cron was created.",
            "description_kind": "plain",
            "computed": true
          },
          "dont_run_if_recent_build_exists": {
            "type": "bool",
            "description": "Whether a cron build should run if there has been a build on this branch in the last 24 hours.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "interval": {
            "type": "string",
            "description": "Interval at which this cron runs. Can be daily, weekly, or monthly.",
            "description_kind": "plain",
            "required": true
          },
          "last_run": {
            "type": "string",
            "description": "When the cron ran last.",
            "description_kind": "plain",
            "computed": true
          },
          "next_run": {
            "type": "string",
            "description": "When the cron is scheduled to run next.",
            "description_kind": "plain",
            "computed": true
          },
          "repository_id": {
            "type": "number",
            "description": "Value uniquely identifying the repository.",
            "description_kind": "plain",
            "optional": true
          },
          "repository_slug": {
            "type": "string",
            "description": "Same as {repository.owner.name}/{repository.name}.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "The `travis_cron` resource creates a cron job for a branch.",
        "description_kind": "plain"
      }
    },
    "travis_env_var": {
      "version": 0,
      "block": {
        "attributes": {
          "branch": {
            "type": "string",
            "description": "The env_var's branch.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The environment variable name, e.g. FOO.",
            "description_kind": "plain",
            "required": true
          },
          "public": {
            "type": "bool",
            "description": "Whether this environment variable should be publicly visible or not.",
            "description_kind": "plain",
            "computed": true
          },
          "public_value": {
            "type": "string",
            "description": "The environment variable's value, e.g. bar.",
            "description_kind": "plain",
            "optional": true
          },
          "repository_id": {
            "type": "number",
            "description": "Value uniquely identifying the repository.",
            "description_kind": "plain",
            "optional": true
          },
          "repository_slug": {
            "type": "string",
            "description": "Same as {repository.owner.name}/{repository.name}.",
            "description_kind": "plain",
            "optional": true
          },
          "value": {
            "type": "string",
            "description": "The environment variable's value, e.g. bar.",
            "description_kind": "plain",
            "optional": true,
            "sensitive": true
          }
        },
        "description": "The `travis_env_var` resource can create an environment variable.",
        "description_kind": "plain"
      }
    },
    "travis_key_pair": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "A text description of this key pair.",
            "description_kind": "plain",
            "required": true
          },
          "fingerprint": {
            "type": "string",
            "description": "Fingerprint of the RSA key",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "public_key": {
            "type": "string",
            "description": "The public key.",
            "description_kind": "plain",
            "computed": true
          },
          "repository_id": {
            "type": "number",
            "description": "Value uniquely identifying the repository.",
            "description_kind": "plain",
            "optional": true
          },
          "repository_slug": {
            "type": "string",
            "description": "Same as {repository.owner.name}/{repository.name}.",
            "description_kind": "plain",
            "optional": true
          },
          "value": {
            "type": "string",
            "description": "The private key",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          }
        },
        "description": "The `travis_key_pair` resource manages an RSA key pair for a repo.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "travis_user": {
      "version": 0,
      "block": {
        "attributes": {
          "avatar_url": {
            "type": "string",
            "description": "Avatar URL set on GitHub.",
            "description_kind": "plain",
            "computed": true
          },
          "education": {
            "type": "bool",
            "description": "Whether or not the user has an education account.",
            "description_kind": "plain",
            "computed": true
          },
          "emails": {
            "type": [
              "set",
              "string"
            ],
            "description": "The user's emails.",
            "description_kind": "plain",
            "computed": true
          },
          "github_id": {
            "type": "number",
            "description": "ID set on GitHub.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "include": {
            "type": [
              "set",
              "string"
            ],
            "description": "Include additional attributes. To know available values, see https://developer.travis-ci.com/resource/user.",
            "description_kind": "plain",
            "optional": true
          },
          "is_syncing": {
            "type": "bool",
            "description": "Whether or not the user is currently being synced with Github.",
            "description_kind": "plain",
            "computed": true
          },
          "login": {
            "type": "string",
            "description": "Login set on GitHub.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name set on GitHub.",
            "description_kind": "plain",
            "computed": true
          },
          "repositories": {
            "type": [
              "set",
              [
                "object",
                {
                  "id": "number",
                  "name": "string",
                  "slug": "string"
                }
              ]
            ],
            "description": "Repositories belonging to this user.",
            "description_kind": "plain",
            "computed": true
          },
          "synced_at": {
            "type": "string",
            "description": "The last time the user was synced with GitHub.",
            "description_kind": "plain",
            "computed": true
          },
          "user_id": {
            "type": "number",
            "description": "Value uniquely identifying the user. If not set, get the current user.",
            "description_kind": "plain",
            "optional": true
          },
          "wait_sync": {
            "type": "bool",
            "description": "If true, exec sync user API and wait.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Use this data source to get the user resource.",
        "description_kind": "plain"
      }
    }
  }
}
