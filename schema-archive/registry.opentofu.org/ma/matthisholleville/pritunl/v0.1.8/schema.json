{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "connection_check": {
          "type": "bool",
          "description_kind": "plain",
          "optional": true
        },
        "insecure": {
          "type": "bool",
          "description_kind": "plain",
          "optional": true
        },
        "secret": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "url": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "pritunl_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the resource, also acts as it's unique ID",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "pritunl_route": {
      "version": 0,
      "block": {
        "attributes": {
          "comment": {
            "type": "string",
            "description": "Comment for route",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "nat": {
            "type": "bool",
            "description": "NAT vpn traffic destined to this network",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "network": {
            "type": "string",
            "description": "Network address with subnet to route",
            "description_kind": "plain",
            "required": true
          },
          "server_id": {
            "type": "string",
            "description": "The id of the server",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "pritunl_server": {
      "version": 0,
      "block": {
        "attributes": {
          "allowed_devices": {
            "type": "string",
            "description": "Device types permitted to connect to server.",
            "description_kind": "plain",
            "optional": true
          },
          "bind_address": {
            "type": "string",
            "description": "Network address for the private network that will be created for clients. This network cannot conflict with any existing local networks",
            "description_kind": "plain",
            "optional": true
          },
          "block_outside_dns": {
            "type": "bool",
            "description": "Block outside DNS on Windows clients.",
            "description_kind": "plain",
            "optional": true
          },
          "cipher": {
            "type": "string",
            "description": "The cipher for the server",
            "description_kind": "plain",
            "optional": true
          },
          "debug": {
            "type": "bool",
            "description": "Show server debugging information in output.",
            "description_kind": "plain",
            "optional": true
          },
          "dh_param_bits": {
            "type": "number",
            "description": "Size of DH parameters",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "dns_mapping": {
            "type": "bool",
            "description": "Map the vpn clients ip address to the .vpn domain such as example_user.example_org.vpn This will conflict with the DNS port if systemd-resolve is running.",
            "description_kind": "plain",
            "optional": true
          },
          "dns_servers": {
            "type": [
              "list",
              "string"
            ],
            "description": "Enter list of groups to allow connections from. Names are case sensitive. If empty all groups will able to connect",
            "description_kind": "plain",
            "optional": true
          },
          "groups": {
            "type": [
              "list",
              "string"
            ],
            "description": "Enter list of groups to allow connections from. Names are case sensitive. If empty all groups will able to connect",
            "description_kind": "plain",
            "optional": true
          },
          "hash": {
            "type": "string",
            "description": "The hash for the server",
            "description_kind": "plain",
            "optional": true
          },
          "host_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of attached hosts to the server",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "inactive_timeout": {
            "type": "number",
            "description": "Disconnects users after the specified number of seconds of inactivity.",
            "description_kind": "plain",
            "optional": true
          },
          "inter_client": {
            "type": "bool",
            "description": "Enable inter-client routing across hosts.",
            "description_kind": "plain",
            "optional": true
          },
          "ipv6": {
            "type": "bool",
            "description": "Enables IPv6 on server, requires IPv6 network interface",
            "description_kind": "plain",
            "optional": true
          },
          "link_ping_interval": {
            "type": "number",
            "description": "Time in between pings used when multiple users have the same network link to failover to another user when one network link fails.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "link_ping_timeout": {
            "type": "number",
            "description": "Optional, ping timeout used when multiple users have the same network link to failover to another user when one network link fails..",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "max_clients": {
            "type": "number",
            "description": "Maximum number of clients connected to a server or to each server replica.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "max_devices": {
            "type": "number",
            "description": "Maximum number of devices per client connected to a server.",
            "description_kind": "plain",
            "optional": true
          },
          "mss_fix": {
            "type": "number",
            "description": "MSS fix value",
            "description_kind": "plain",
            "optional": true
          },
          "multi_device": {
            "type": "bool",
            "description": "Allow users to connect with multiple devices concurrently.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the server",
            "description_kind": "plain",
            "required": true
          },
          "network": {
            "type": "string",
            "description": "Network address for the private network that will be created for clients. This network cannot conflict with any existing local networks",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "network_end": {
            "type": "string",
            "description": "Ending network address for the bridged VPN client IP addresses. Must be in the subnet of the server network.",
            "description_kind": "plain",
            "optional": true
          },
          "network_mode": {
            "type": "string",
            "description": "Sets network mode. Bridged mode is not recommended using it will impact performance and client support will be limited.",
            "description_kind": "plain",
            "optional": true
          },
          "network_start": {
            "type": "string",
            "description": "Starting network address for the bridged VPN client IP addresses. Must be in the subnet of the server network.",
            "description_kind": "plain",
            "optional": true
          },
          "network_wg": {
            "type": "string",
            "description": "Network address for the private network that will be created for clients. This network cannot conflict with any existing local networks",
            "description_kind": "plain",
            "optional": true
          },
          "organization_ids": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of attached organizations to the server.",
            "description_kind": "plain",
            "optional": true
          },
          "otp_auth": {
            "type": "bool",
            "description": "Enables two-step authentication using Google Authenticator. Verification code is entered as the user password when connecting",
            "description_kind": "plain",
            "optional": true
          },
          "ping_interval": {
            "type": "number",
            "description": "Interval to ping client",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ping_timeout": {
            "type": "number",
            "description": "Timeout for client ping. Must be greater then ping interval",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "port": {
            "type": "number",
            "description": "The port for the server",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "port_wg": {
            "type": "number",
            "description": "Network address for the private network that will be created for clients. This network cannot conflict with any existing local networks",
            "description_kind": "plain",
            "optional": true
          },
          "pre_connect_msg": {
            "type": "string",
            "description": "Messages that will be shown after connect to the server",
            "description_kind": "plain",
            "optional": true
          },
          "protocol": {
            "type": "string",
            "description": "The protocol for the server",
            "description_kind": "plain",
            "optional": true
          },
          "replica_count": {
            "type": "number",
            "description": "Replicate server across multiple hosts.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "restrict_routes": {
            "type": "bool",
            "description": "Prevent traffic from networks not specified in the servers routes from being tunneled over the vpn.",
            "description_kind": "plain",
            "optional": true
          },
          "search_domain": {
            "type": "string",
            "description": "DNS search domain for clients. Separate multiple search domains by a comma.",
            "description_kind": "plain",
            "optional": true
          },
          "session_timeout": {
            "type": "number",
            "description": "Disconnect users after the specified number of seconds.",
            "description_kind": "plain",
            "optional": true
          },
          "status": {
            "type": "string",
            "description": "The status of the server",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "vxlan": {
            "type": "bool",
            "description": "Use VXLan for routing client-to-client traffic with replicated servers.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "pritunl_host": {
      "version": 0,
      "block": {
        "attributes": {
          "hostname": {
            "type": "string",
            "description": "Hostname",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Use this data source to get information about the Pritunl hosts.",
        "description_kind": "plain"
      }
    },
    "pritunl_route": {
      "version": 0,
      "block": {
        "attributes": {
          "comment": {
            "type": "string",
            "description": "Comment associated with the route.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "nat": {
            "type": "bool",
            "description": "Indicates if NAT is enabled for this route.",
            "description_kind": "plain",
            "computed": true
          },
          "network": {
            "type": "string",
            "description": "Network of the route.",
            "description_kind": "plain",
            "required": true
          },
          "server_id": {
            "type": "string",
            "description": "ID of the server in which the route is configured.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Use this data source to get information about a specific route in a Pritunl server.",
        "description_kind": "plain"
      }
    },
    "pritunl_server": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "server_name": {
            "type": "string",
            "description": "Server name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Use this data source to get information about the Pritunl server.",
        "description_kind": "plain"
      }
    }
  }
}
