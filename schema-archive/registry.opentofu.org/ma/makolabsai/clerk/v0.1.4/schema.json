{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "platform_api_key": {
          "type": "string",
          "description": "The Clerk Platform API key for workspace-level operations. Can also be set via the CLERK_PLATFORM_API_KEY environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Clerk provider enables managing Clerk authentication platform resources via Terraform.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "clerk_application": {
      "version": 0,
      "block": {
        "attributes": {
          "deletion_protection": {
            "type": "bool",
            "description": "Whether deletion protection is enabled. When true, the application cannot be destroyed. Set to false before destroying. Defaults to true.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "dev_instance_id": {
            "type": "string",
            "description": "The instance ID for the development environment.",
            "description_kind": "plain",
            "computed": true
          },
          "dev_publishable_key": {
            "type": "string",
            "description": "The publishable key for the development instance.",
            "description_kind": "plain",
            "computed": true
          },
          "dev_secret_key": {
            "type": "string",
            "description": "The secret key for the development instance.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "domain": {
            "type": "string",
            "description": "The domain for the application. Only set at creation time.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "environment_types": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of environment types to create instances for (e.g., development, production). Only set at creation time.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the Clerk application.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the application.",
            "description_kind": "plain",
            "required": true
          },
          "prod_instance_id": {
            "type": "string",
            "description": "The instance ID for the production environment.",
            "description_kind": "plain",
            "computed": true
          },
          "prod_publishable_key": {
            "type": "string",
            "description": "The publishable key for the production instance.",
            "description_kind": "plain",
            "computed": true
          },
          "prod_secret_key": {
            "type": "string",
            "description": "The secret key for the production instance.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "template": {
            "type": "string",
            "description": "Application template (e.g., b2b-saas, b2c-saas, waitlist). Only set at creation time.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages a Clerk application. Each application can have multiple instances (development, production) with distinct user pools.",
        "description_kind": "plain"
      }
    },
    "clerk_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "application_id": {
            "type": "string",
            "description": "The Clerk application ID this environment belongs to.",
            "description_kind": "plain",
            "required": true
          },
          "clerk_js_version": {
            "type": "string",
            "description": "Specific Clerk.js version for hosted account pages. Empty string removes pinned version.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "development_origin": {
            "type": "string",
            "description": "Origin URL for development instances to fix third-party cookie issues.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "enhanced_email_deliverability": {
            "type": "bool",
            "description": "Whether Clerk sends OTP emails via shared domain (Postmark) in production.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "environment": {
            "type": "string",
            "description": "The environment type: \"development\" or \"production\".",
            "description_kind": "plain",
            "required": true
          },
          "hibp": {
            "type": "bool",
            "description": "Whether Have I Been Pwned password checking is enabled.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Composite identifier: {application_id}/{environment}.",
            "description_kind": "plain",
            "computed": true
          },
          "organization_settings": {
            "nested_type": {
              "attributes": {
                "admin_delete_enabled": {
                  "type": "bool",
                  "description": "Whether organization admins can delete the organization.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "creator_role_id": {
                  "type": "string",
                  "description": "Role ID assigned to organization creators.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "domains_default_role_id": {
                  "type": "string",
                  "description": "Default role ID for domain-enrolled members.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "domains_enabled": {
                  "type": "bool",
                  "description": "Whether organization domains are enabled.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "domains_enrollment_modes": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Enrollment modes for organization domains.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "enabled": {
                  "type": "bool",
                  "description": "Whether organizations are enabled.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "max_allowed_memberships": {
                  "type": "number",
                  "description": "Maximum number of memberships per organization.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Organization feature settings for the instance.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "restrictions": {
            "nested_type": {
              "attributes": {
                "allowlist": {
                  "type": "bool",
                  "description": "Whether the allowlist is enabled.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "block_disposable_email_domains": {
                  "type": "bool",
                  "description": "Whether disposable email domains are blocked.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "block_email_subaddresses": {
                  "type": "bool",
                  "description": "Whether email subaddresses (user+tag@domain.com) are blocked.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "blocklist": {
                  "type": "bool",
                  "description": "Whether the blocklist is enabled.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "ignore_dots_for_gmail_addresses": {
                  "type": "bool",
                  "description": "Whether dots are ignored in Gmail addresses for uniqueness checks.",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Instance restriction settings for email validation and access control.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "support_email": {
            "type": "string",
            "description": "Contact email displayed to users needing support.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "test_mode": {
            "type": "bool",
            "description": "Whether test mode is enabled. Defaults to true for development instances.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "url_based_session_syncing": {
            "type": "bool",
            "description": "Whether URL-based session syncing is enabled (replaces third-party cookies in dev).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Configures a Clerk instance's settings (development or production). The instance is auto-created by Clerk when the application is created; this resource manages its configuration. Note: Authentication strategies (email/password/OAuth/MFA) are only configurable via the Clerk Dashboard.",
        "description_kind": "plain"
      }
    },
    "clerk_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "admin_delete_enabled": {
            "type": "bool",
            "description": "Whether organization admins can delete the organization.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "application_id": {
            "type": "string",
            "description": "The Clerk application ID this organization belongs to.",
            "description_kind": "plain",
            "required": true
          },
          "created_at": {
            "type": "number",
            "description": "Unix timestamp of when the organization was created.",
            "description_kind": "plain",
            "computed": true
          },
          "environment": {
            "type": "string",
            "description": "The environment type: \"development\" or \"production\".",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the Clerk organization.",
            "description_kind": "plain",
            "computed": true
          },
          "max_allowed_memberships": {
            "type": "number",
            "description": "Maximum number of memberships allowed in the organization. 0 means unlimited.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the organization.",
            "description_kind": "plain",
            "required": true
          },
          "slug": {
            "type": "string",
            "description": "URL-friendly identifier for the organization. Auto-generated from name if not provided.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "updated_at": {
            "type": "number",
            "description": "Unix timestamp of when the organization was last updated.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages a Clerk organization within a specific application environment. Organizations represent tenants or teams that group users together.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "clerk_application": {
      "version": 0,
      "block": {
        "attributes": {
          "dev_instance_id": {
            "type": "string",
            "description": "The instance ID for the development environment.",
            "description_kind": "plain",
            "computed": true
          },
          "dev_publishable_key": {
            "type": "string",
            "description": "The publishable key for the development instance.",
            "description_kind": "plain",
            "computed": true
          },
          "dev_secret_key": {
            "type": "string",
            "description": "The secret key for the development instance.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description": "The unique identifier of the Clerk application.",
            "description_kind": "plain",
            "required": true
          },
          "prod_instance_id": {
            "type": "string",
            "description": "The instance ID for the production environment.",
            "description_kind": "plain",
            "computed": true
          },
          "prod_publishable_key": {
            "type": "string",
            "description": "The publishable key for the production instance.",
            "description_kind": "plain",
            "computed": true
          },
          "prod_secret_key": {
            "type": "string",
            "description": "The secret key for the production instance.",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Look up an existing Clerk application by its ID.",
        "description_kind": "plain"
      }
    },
    "clerk_organization": {
      "version": 0,
      "block": {
        "attributes": {
          "admin_delete_enabled": {
            "type": "bool",
            "description": "Whether organization admins can delete the organization.",
            "description_kind": "plain",
            "computed": true
          },
          "application_id": {
            "type": "string",
            "description": "The Clerk application ID the organization belongs to.",
            "description_kind": "plain",
            "required": true
          },
          "created_at": {
            "type": "number",
            "description": "Unix timestamp of when the organization was created.",
            "description_kind": "plain",
            "computed": true
          },
          "environment": {
            "type": "string",
            "description": "The environment type: \"development\" or \"production\".",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The organization ID to look up. Exactly one of id or slug must be specified.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "max_allowed_memberships": {
            "type": "number",
            "description": "Maximum number of memberships allowed in the organization.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the organization.",
            "description_kind": "plain",
            "computed": true
          },
          "slug": {
            "type": "string",
            "description": "The organization slug to look up. Exactly one of id or slug must be specified.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Look up an existing Clerk organization by ID or slug.",
        "description_kind": "plain"
      }
    }
  }
}
