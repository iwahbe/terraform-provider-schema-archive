{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "email": {
          "type": "string",
          "description": "Email to login to Beeswax API. May also be provided via BEESWAX_USERNAME environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "URI for Beeswax API. May also be provided via BEESWAX_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password to login to Beeswax API. May also be provided via BEESWAX_PASSWORD environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "beeswax_role": {
      "version": 0,
      "block": {
        "attributes": {
          "archived": {
            "type": "bool",
            "description": "Archived roles cannot add new users",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Unique ID of the role",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the role",
            "description_kind": "plain",
            "required": true
          },
          "notes": {
            "type": "string",
            "description": "Free-form notes of up to 255 characters.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "parent_role_id": {
            "type": "number",
            "description": "The system role that determines which default permissions will be inherited",
            "description_kind": "plain",
            "required": true
          },
          "permissions": {
            "nested_type": {
              "attributes": {
                "object_type": {
                  "type": "string",
                  "description": "The name of the resource, e.g. \"advertiser\" (note, these are singular)",
                  "description_kind": "plain",
                  "required": true
                },
                "permission": {
                  "type": "number",
                  "description": "4-bit integer determining Read (1), Create (2), Update (4) and Delete (8) rights for the resource. If a Permission is set to 1, the Role can only Read that type of object. If set to 3, the Role can Read and Create the object (1+2). When a Permission is set to 15 the Role has full rights to the object (1+2+4+8), if set to zero the Role has no rights.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Object containing resource-level permissions for this Role",
            "description_kind": "plain",
            "required": true
          },
          "report_ids": {
            "type": [
              "list",
              "number"
            ],
            "description": "List of IDs of reports users associated with this role should be able to access. A list of reports may be queried using /reporting/reports.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "shared_across_accounts": {
            "type": "bool",
            "description": "A role that can be shared across accounts, which can be enabled by all-accounts users.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "beeswax_user": {
      "version": 0,
      "block": {
        "attributes": {
          "account_group_ids": {
            "type": [
              "list",
              "number"
            ],
            "description_kind": "plain",
            "required": true
          },
          "account_id": {
            "type": "number",
            "description_kind": "plain",
            "optional": true
          },
          "active": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "all_account_access": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "email": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "first_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "number",
            "description_kind": "plain",
            "computed": true
          },
          "last_name": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "role_id": {
            "type": "number",
            "description_kind": "plain",
            "required": true
          },
          "super_user": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
