{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "address": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "das_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "file": {
            "type": "string",
            "description": "system name",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "path": {
            "type": "string",
            "description": "system name",
            "description_kind": "plain",
            "required": true
          },
          "policy": {
            "type": "string",
            "description": "system name",
            "description_kind": "plain",
            "required": true
          },
          "system": {
            "type": "string",
            "description": "system name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "das_system": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "system name",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "system type e.g. kubernetes",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "decision_mapping": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "block_types": {
                "allowed": {
                  "nesting_mode": "set",
                  "block": {
                    "attributes": {
                      "expected": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "negated": {
                        "type": "bool",
                        "description": "when set to true, decision is Allowed when the mapped property IS NOT equal to the expected value",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "path": {
                        "type": "string",
                        "description": "dot-separated decision property path",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "max_items": 1
                },
                "columns": {
                  "nesting_mode": "set",
                  "block": {
                    "attributes": {
                      "key": {
                        "type": "string",
                        "description": "column key (also the search key)",
                        "description_kind": "plain",
                        "required": true
                      },
                      "path": {
                        "type": "string",
                        "description": "dot-separated decision property path",
                        "description_kind": "plain",
                        "required": true
                      },
                      "type": {
                        "type": "string",
                        "description": "column type: one of \"string\", \"boolean\", \"date\", \"integer\", \"float\"",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "description_kind": "plain"
                  }
                },
                "reason": {
                  "nesting_mode": "set",
                  "block": {
                    "attributes": {
                      "path": {
                        "type": "string",
                        "description": "dot-separated decision property path",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "description_kind": "plain"
                  },
                  "max_items": 1
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
