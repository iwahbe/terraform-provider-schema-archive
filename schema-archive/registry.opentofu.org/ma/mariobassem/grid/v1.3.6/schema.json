                  "optional": true
                },
                "ygg_ip": {
                  "type": "string",
                  "description": "Allocated Yggdrasil IP",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          },
          "workers": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "computedip": {
                  "type": "string",
                  "description": "The reserved public ip",
                  "description_kind": "markdown",
                  "computed": true
                },
                "computedip6": {
                  "type": "string",
                  "description": "The reserved public ipv6",
                  "description_kind": "markdown",
                  "computed": true
                },
                "cpu": {
                  "type": "number",
                  "description": "Number of VCPUs",
                  "description_kind": "markdown",
                  "required": true
                },
                "disk_size": {
                  "type": "number",
                  "description": "Data disk size in GBs",
                  "description_kind": "markdown",
                  "required": true
                },
                "flist": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "flist_checksum": {
                  "type": "string",
                  "description": "if present, the flist is rejected if it has a different hash. the flist hash can be found by append",
                  "description_kind": "markdown",
