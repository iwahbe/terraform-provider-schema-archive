{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "Api key for access to Mailosaur. You can use env var MAILOSAUR_API_KEY for set this attribute",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Provider for resource management in Mailosaur",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "mailosaur_server": {
      "version": 0,
      "block": {
        "attributes": {
          "email": {
            "type": "string",
            "description": "Email address for the server",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Id of virtual server",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of virtual server",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Password for use with SMTP and POP3",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Virtual server",
        "description_kind": "markdown"
      }
    }
  }
}
