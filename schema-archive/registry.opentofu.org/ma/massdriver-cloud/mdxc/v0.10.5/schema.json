{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "aws": {
          "nested_type": {
            "attributes": {
              "external_id": {
                "type": "string",
                "description": "A unique identifier that might be required when you assume a role in another account.",
                "description_kind": "plain",
                "required": true,
                "sensitive": true
              },
              "region": {
                "type": "string",
                "description": "The region where AWS operations will take place.",
                "description_kind": "plain",
                "required": true
              },
              "role_arn": {
                "type": "string",
                "description": "ARN of AWS Role to assume",
                "description_kind": "plain",
                "required": true,
                "sensitive": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "Credentials for AWS Cloud",
          "description_kind": "plain",
          "optional": true
        },
        "azure": {
          "nested_type": {
            "attributes": {
              "client_id": {
                "type": "string",
                "description": "Azure Client ID",
                "description_kind": "plain",
                "required": true
              },
              "client_secret": {
                "type": "string",
                "description": "Azure Client Secret",
                "description_kind": "plain",
                "required": true,
                "sensitive": true
              },
              "subscription_id": {
                "type": "string",
                "description": "Azure Subscription ID",
                "description_kind": "plain",
                "required": true,
                "sensitive": true
              },
              "tenant_id": {
                "type": "string",
                "description": "Azure Tenant ID",
                "description_kind": "plain",
                "required": true,
                "sensitive": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "Credentials for Azure Cloud. See how to authenticate through Service Principal in the [Azure docs](https://registry.terraform.io/providers/hashicorp/azurerm/latest/docs/guides/service_principal_client_secret#creating-a-service-principal)",
          "description_kind": "plain",
          "optional": true
        },
        "gcp": {
          "nested_type": {
            "attributes": {
              "credentials": {
                "type": "string",
                "description": "Either the path to or the contents of a service account key file in JSON format.",
                "description_kind": "plain",
                "required": true,
                "sensitive": true
              },
              "project": {
                "type": "string",
                "description": "The GCP project to manage resources in.",
                "description_kind": "plain",
                "required": true
              }
            },
            "nesting_mode": "single"
          },
          "description": "Credentials for Google Cloud. See how to authenticate through Service Principals in the [Google docs](https://cloud.google.com/compute/docs/authentication)",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Terraform provider to resource across multiple clouds.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "mdxc_application_identity": {
      "version": 0,
      "block": {
        "attributes": {
          "aws_application_identity": {
            "nested_type": {
              "attributes": {
                "iam_role_arn": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "AWS IAM role configuration",
            "description_kind": "plain",
            "computed": true
          },
          "aws_configuration": {
            "nested_type": {
              "attributes": {
                "assume_role_policy": {
                  "type": "string",
                  "description": "The AWS IAM role assume role policy. Required if provisioning into AWS",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "AWS IAM role configuration",
            "description_kind": "plain",
            "optional": true
          },
          "azure_application_identity": {
            "nested_type": {
              "attributes": {
                "client_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "resource_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                },
                "tenant_id": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Azure Managed Identity configuration",
            "description_kind": "plain",
            "computed": true
          },
          "azure_configuration": {
            "nested_type": {
              "attributes": {
                "kubernetes": {
                  "nested_type": {
                    "attributes": {
                      "namespace": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "oidc_issuer_url": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "service_account_name": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Kubernetes configuration",
                  "description_kind": "plain",
                  "optional": true
                },
                "location": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "resource_group_name": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Azure Managed Identity configuration",
            "description_kind": "plain",
            "optional": true
          },
          "cloud": {
            "type": "string",
            "description": "The cloud the application identity was provisioned into (value will be `aws`, `azure` or `gcp`)",
            "description_kind": "markdown",
            "computed": true
          },
          "gcp_application_identity": {
            "nested_type": {
              "attributes": {
                "service_account_email": {
                  "type": "string",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "GCP Service Account configuration",
            "description_kind": "plain",
            "computed": true
          },
          "gcp_configuration": {
            "nested_type": {
              "attributes": {
                "kubernetes": {
                  "nested_type": {
                    "attributes": {
                      "namespace": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      },
                      "service_account_name": {
                        "type": "string",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Kubernetes configuration",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "GCP service account configuration",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Cloud specific identifier of the application identity",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the IAM entity in the respective cloud (AWS IAM Role, GCP Service Account, Azure Application)",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A cross-cloud application identity resource (AWS IAM Role, GCP Service Account, Azure Application)",
        "description_kind": "markdown"
      }
    },
    "mdxc_application_permission": {
      "version": 0,
      "block": {
        "attributes": {
          "application_identity_id": {
            "type": "string",
            "description": "The ID of the Application Permission resource",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Cloud specific identifier of the application Permission",
            "description_kind": "markdown",
            "computed": true
          },
          "permission": {
            "nested_type": {
              "attributes": {
                "condition": {
                  "type": "string",
                  "description": "An GCP IAM Condition for a given role binding",
                  "description_kind": "plain",
                  "optional": true
                },
                "policy_arn": {
                  "type": "string",
                  "description": "AWS IAM policy ARN to associate with the application identity",
                  "description_kind": "plain",
                  "optional": true
                },
                "role": {
                  "type": "string",
                  "description": "The Azure or GCP built-in IAM role to bind to the application identity",
                  "description_kind": "plain",
                  "optional": true
                },
                "scope": {
                  "type": "string",
                  "description": "The scope at which the Azure Role Assignment applies to",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Permission definition to assign application identity",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "A cross-cloud application Permission resource (AWS IAM Role, GCP Service Account, Azure Application)",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "mdxc_cloud": {
      "version": 0,
      "block": {
        "attributes": {
          "cloud": {
            "type": "string",
            "description": "The currently configured cloud (aws, gcp, azure, etc)",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the underlying cloud scope. For AWS, it will be the account ID, for GCP it will be the project ID, for Azure it will be the subcription ID.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "A utility data source to get the provider's currently configured cloud",
        "description_kind": "markdown"
      }
    }
  }
}
