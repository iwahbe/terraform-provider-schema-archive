{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "server": {
          "type": "string",
          "description": "The Drone servers url, It must be provided, but can also be sourced from the `DRONE_SERVER` environment variable.",
          "description_kind": "markdown",
          "required": true
        },
        "token": {
          "type": "string",
          "description": "The Drone servers api token, It must be provided, but can also be sourced from the `DRONE_TOKEN` environment variable.",
          "description_kind": "markdown",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "drone_cron": {
      "version": 0,
      "block": {
        "attributes": {
          "branch": {
            "type": "string",
            "description": "The branch to run this cron job on. Defaults to `master`.",
            "description_kind": "markdown",
            "optional": true
          },
          "disabled": {
            "type": "bool",
            "description": "Indicate if the cron should be disabled.",
            "description_kind": "markdown",
            "optional": true
          },
          "event": {
            "type": "string",
            "description": "The event for this cron job. Only allowed value is `push`.",
            "description_kind": "markdown",
            "required": true
          },
          "expr": {
            "type": "string",
            "description": "The cron interval. Allowed values are `@daily`, `@weekly`, `@monthly`, and `@yearly`. Defaults to `@monthly`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The string representation of the cron.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Cron job name",
            "description_kind": "markdown",
            "required": true
          },
          "repository": {
            "type": "string",
            "description": "Repository name",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage a repository cron job.",
        "description_kind": "markdown"
      }
    },
    "drone_orgsecret": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_on_pull_request": {
            "type": "bool",
            "description": "Allow retrieving the secret on pull requests.",
            "description_kind": "markdown",
            "optional": true
          },
          "allow_push_on_pull_request": {
            "type": "bool",
            "description": "Allow retrieving the secret for push on pull requests",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The string representation of the organization secret.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Secret name",
            "description_kind": "markdown",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "Organization name",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Secret value",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Manage a org secret.",
        "description_kind": "markdown"
      }
    },
    "drone_repo": {
      "version": 0,
      "block": {
        "attributes": {
          "cancel_pulls": {
            "type": "bool",
            "description": "Automatically cancel pending pull request builds",
            "description_kind": "markdown",
            "optional": true
          },
          "cancel_push": {
            "type": "bool",
            "description": "Automatically cancel pending push builds",
            "description_kind": "markdown",
            "optional": true
          },
          "cancel_running": {
            "type": "bool",
            "description": "Automatically cancel running builds if newer commit pushed",
            "description_kind": "markdown",
            "optional": true
          },
          "configuration": {
            "type": "string",
            "description": "Drone Configuration file Defaults to `.drone.yml`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The string representation of the repository.",
            "description_kind": "markdown",
            "computed": true
          },
          "ignore_forks": {
            "type": "bool",
            "description": "Disable build for pull requests",
            "description_kind": "markdown",
            "optional": true
          },
          "ignore_pulls": {
            "type": "bool",
            "description": "Disable build for forks",
            "description_kind": "markdown",
            "optional": true
          },
          "protected": {
            "type": "bool",
            "description": "Repository is protected",
            "description_kind": "markdown",
            "optional": true
          },
          "repository": {
            "type": "string",
            "description": "Repository name",
            "description_kind": "markdown",
            "required": true
          },
          "timeout": {
            "type": "number",
            "description": "Build execution timeout in minutes Defaults to `60`.",
            "description_kind": "markdown",
            "optional": true
          },
          "trusted": {
            "type": "bool",
            "description": "Repository is trusted",
            "description_kind": "markdown",
            "optional": true
          },
          "visibility": {
            "type": "string",
            "description": "Repository visibility Defaults to `private`.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Activate and configure a repository.",
        "description_kind": "markdown"
      }
    },
    "drone_secret": {
      "version": 0,
      "block": {
        "attributes": {
          "allow_on_pull_request": {
            "type": "bool",
            "description": "Allow retrieving the secret on pull requests",
            "description_kind": "markdown",
            "optional": true
          },
          "allow_push_on_pull_request": {
            "type": "bool",
            "description": "Allow retrieving the secret for push on pull requests",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The string representation of the secret.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Secret name",
            "description_kind": "markdown",
            "required": true
          },
          "repository": {
            "type": "string",
            "description": "Repository name",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Secret value",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Manage a repository secret.",
        "description_kind": "markdown"
      }
    },
    "drone_template": {
      "version": 0,
      "block": {
        "attributes": {
          "data": {
            "type": "string",
            "description": "Template content",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The string representation of the organization secret.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Template name, it should end with one of the supported extensions (`yaml`, `json`, `jsonnet` or `starlark`)",
            "description_kind": "markdown",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "Organization name",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manage a template.",
        "description_kind": "markdown"
      }
    },
    "drone_user": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Is the user active?",
            "description_kind": "markdown",
            "required": true
          },
          "admin": {
            "type": "bool",
            "description": "Is the user an admin?",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The string representation of the user.",
            "description_kind": "markdown",
            "computed": true
          },
          "login": {
            "type": "string",
            "description": "Login name",
            "description_kind": "markdown",
            "required": true
          },
          "machine": {
            "type": "bool",
            "description": "Is the user a machine? Defaults to `false`.",
            "description_kind": "markdown",
            "optional": true
          },
          "token": {
            "type": "string",
            "description": "The user's access token",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Manage a user.",
        "description_kind": "markdown"
      }
    }
  },
