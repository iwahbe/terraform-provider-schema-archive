  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "base_url": {
          "type": "string",
          "description": "The Gitea Base API URL",
          "description_kind": "plain",
          "optional": true
        },
        "cacert_file": {
          "type": "string",
          "description": "A file containing the ca certificate to use in case ssl certificate is not from a standard chain",
          "description_kind": "plain",
          "optional": true
        },
        "insecure": {
          "type": "bool",
          "description": "Disable SSL verification of API calls",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password in case of using basic auth",
          "description_kind": "plain",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "The application token used to connect to Gitea.",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username in case of using basic auth",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
