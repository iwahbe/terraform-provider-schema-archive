{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "magnolia_git_config": {
      "version": 0,
      "block": {
        "attributes": {
          "git_clone_url": {
            "type": "string",
            "description": "User SSH URl to be clone",
            "description_kind": "plain",
            "required": true
          },
          "git_provider": {
            "type": "string",
            "description": "Git provider can be GITHUB, BITBUCKET or BITBUCKET_CLOUD ",
            "description_kind": "plain",
            "required": true
          },
          "git_secret": {
            "type": "string",
            "description": "Secret generated to be injected in the user git repository",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "public_key": {
            "type": "string",
            "description": "Magnolia Public Key to interact whit",
            "description_kind": "plain",
            "computed": true
          },
          "subscription_id": {
            "type": "string",
            "description": "ID of the magnolia subscription",
            "description_kind": "plain",
            "required": true
          },
          "webhook_url": {
            "type": "string",
            "description": "Webhook URL generated to be injected in the user git repository",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Sample resource in the Terraform provider scaffolding.",
        "description_kind": "plain"
      }
    },
    "magnolia_subscription": {
      "version": 0,
      "block": {
        "attributes": {
          "alias": {
            "type": "string",
            "description": "Subscription Alias",
            "description_kind": "plain",
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "email",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Subscription Id",
            "description_kind": "plain",
            "computed": true
          },
          "password": {
            "type": "string",
            "description": "password",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Resource for Magnolia Subscription",
        "description_kind": "plain"
      }
    }
  }
}
