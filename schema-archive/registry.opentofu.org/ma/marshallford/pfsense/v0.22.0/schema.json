            "type": "string",
            "description": "Last updated.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Reload firewall filter.\n\nRequired Privileges: `WebCfg - Status: Filter Reload Status`",
        "description_kind": "markdown",
        "deprecated": true
      }
    },
    "pfsense_firewall_ip_alias": {
      "version": 0,
      "block": {
        "attributes": {
          "apply": {
            "type": "bool",
            "description": "Apply change, defaults to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "For administrative reference (not parsed).",
            "description_kind": "plain",
            "optional": true
          },
          "entries": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "For administrative reference (not parsed).",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                },
                "ip": {
                  "type": "string",
                  "description": "Hosts must be specified by their IP address or fully qualified domain name (FQDN). Networks are specified in CIDR format.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Host(s) or network(s).",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of IP alias.",
            "description_kind": "plain",
            "required": true
          },
          "type": {
            "type": "string",
            "description": "Type of alias. Options: `host`, `network`.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Firewall IP [alias](https://docs.netgate.com/pfsense/en/latest/firewall/aliases.html), defines a group of hosts and/or networks. Aliases can be referenced by firewall rules, port forwards, outbound NAT rules, and other places in the firewall.\n\nRequired Privileges:\n* Create: `WebCfg - Diagnostics: Command`, `WebCfg - Firewall: Alias: Edit`\n* Read: `WebCfg - Diagnostics: Command`\n* Update: `WebCfg - Diagnostics: Command`, `WebCfg - Firewall: Alias: Edit`\n* Delete: `WebCfg - Diagnostics: Command`, `WebCfg - Firewall: Aliases`",
        "description_kind": "markdown"
      }
    },
