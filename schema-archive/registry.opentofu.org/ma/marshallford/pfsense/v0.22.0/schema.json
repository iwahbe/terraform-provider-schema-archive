{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "concurrent_writes": {
          "type": "bool",
          "description": "Enable concurrent pfSense configuration writes. Be aware that pfSense's XML configuration system does not support write operations at scale, which can lead to overwrites and unexpected behavior. Defaults to `false`.",
          "description_kind": "markdown",
          "optional": true
        },
        "max_attempts": {
          "type": "number",
          "description": "Maximum number of attempts (only applicable for retryable errors), defaults to `3`.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "pfSense administration password.",
          "description_kind": "plain",
          "required": true,
          "sensitive": true
        },
        "tls_skip_verify": {
          "type": "bool",
          "description": "Skip verification of TLS certificates, defaults to `false`.",
          "description_kind": "markdown",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "pfSense administration URL, defaults to `https://192.168.1.1`.",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "pfSense administration username, defaults to `admin`.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description": "Interact with [pfSense](https://www.pfsense.org/) firewall/router.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "pfsense_dhcpv4_apply": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "UUID for DHCPv4 apply.",
            "description_kind": "plain",
            "computed": true
          },
          "interface": {
            "type": "string",
            "description": "Network interface.",
            "description_kind": "plain",
            "required": true
          },
          "last_updated": {
            "type": "string",
            "description": "Last updated.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Apply DHCPv4 configuration.\n\nRequired Privileges: `WebCfg - Services: DHCP Server`",
        "description_kind": "markdown",
        "deprecated": true
      }
    },
    "pfsense_dhcpv4_staticmapping": {
      "version": 0,
      "block": {
        "attributes": {
          "apply": {
            "type": "bool",
            "description": "Apply change, defaults to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "arp_table_static_entry": {
            "type": "bool",
            "description": "Create an ARP Table Static Entry for this MAC & IP Address pair., defaults to `false`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "client_identifier": {
            "type": "string",
            "description": "Identifier to match based on the value sent by the client (RFC 2132).",
            "description_kind": "plain",
            "optional": true
          },
          "default_lease_time": {
            "type": "string",
            "description": "Default lease time for clients that do not ask for a specific lease expiration time.",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "For administrative reference (not parsed).",
            "description_kind": "plain",
            "optional": true
          },
          "dns_servers": {
            "type": [
              "list",
              "string"
            ],
            "description": "DNS (Domain Name System) servers provided to the client.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "domain_name": {
            "type": "string",
            "description": "Domain name passed to the client to form its fully qualified hostname.",
            "description_kind": "plain",
            "optional": true
          },
          "domain_search_list": {
            "type": [
              "list",
              "string"
            ],
            "description": "DNS search domains that are provided to the client.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "gateway": {
            "type": "string",
            "description": "IPv4 gateway address.",
            "description_kind": "plain",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description": "Name of the host, without the domain part.",
            "description_kind": "plain",
            "optional": true
          },
          "interface": {
            "type": "string",
            "description": "Network interface. Each interface has its own separate DHCP configuration (including static mappings).",
            "description_kind": "plain",
            "required": true
          },
          "ip_address": {
            "type": "string",
            "description": "IPv4 address to assign this client. Address must be outside of any defined pools. If no IPv4 address is given, one will be dynamically allocated from a pool.",
            "description_kind": "plain",
            "optional": true
          },
          "mac_address": {
            "type": "string",
            "description": "MAC address of the client to match.",
            "description_kind": "plain",
            "required": true
          },
          "maximum_lease_time": {
            "type": "string",
            "description": "Maximum lease time for clients that ask for a specific lease expiration time.",
            "description_kind": "plain",
            "optional": true
          },
          "wins_servers": {
            "type": [
              "list",
              "string"
            ],
            "description": "WINS (Windows Internet Name Service) servers provided to the client.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "DHCPv4 [static mapping](https://docs.netgate.com/pfsense/en/latest/services/dhcp/ipv4.html#static-mappings). Static mappings express a preference for which IP address will be assigned to a given client based on its MAC address. In a network where unknown clients are denied, this also serves as a list of known clients which are allowed to receive leases or have static ARP entries.\n\nRequired Privileges:\n* Create: `WebCfg - Diagnostics: Command`, `WebCfg - Services: DHCP Server: Edit static mapping`\n* Read: `WebCfg - Diagnostics: Command`\n* Update: `WebCfg - Diagnostics: Command`, `WebCfg - Services: DHCP Server: Edit static mapping`\n* Delete: `WebCfg - Diagnostics: Command`, `WebCfg - Services: DHCP Server`",
        "description_kind": "markdown"
      }
    },
    "pfsense_dnsresolver_apply": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "UUID for DNS resolver apply.",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Last updated.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Apply DNS resolver configuration.\n\nRequired Privileges: `WebCfg - Services: DNS Resolver`",
        "description_kind": "markdown",
        "deprecated": true
      }
    },
    "pfsense_dnsresolver_configfile": {
      "version": 0,
      "block": {
        "attributes": {
          "apply": {
            "type": "bool",
            "description": "Apply change, defaults to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "content": {
            "type": "string",
            "description": "Contents of file. Must specify Unbound clause(s). Comments start with `#` and last to the end of line.",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of config file.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "DNS resolver (Unbound) [config file](https://man.freebsd.org/cgi/man.cgi?unbound.conf). **Prerequisite**: Must add the directive `include-toplevel: /var/unbound/conf.d/*` to the DNS resolver custom options input. **Use with caution**, content is not checked/validated.\n\nRequired Privileges:\n* Create: `WebCfg - Diagnostics: Command`, `WebCfg - Diagnostics: Edit File`\n* Read: `WebCfg - Diagnostics: Command`\n* Update: `WebCfg - Diagnostics: Command`, `WebCfg - Diagnostics: Edit File`\n* Delete: `WebCfg - Diagnostics: Command`, `WebCfg - Diagnostics: Edit File`",
        "description_kind": "markdown"
      }
    },
    "pfsense_dnsresolver_domainoverride": {
      "version": 0,
      "block": {
        "attributes": {
          "apply": {
            "type": "bool",
            "description": "Apply change, defaults to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "For administrative reference (not parsed).",
            "description_kind": "plain",
            "optional": true
          },
          "domain": {
            "type": "string",
            "description": "Domain whose lookups will be directed to a user-specified DNS lookup server.",
            "description_kind": "plain",
            "required": true
          },
          "ip_address": {
            "type": "string",
            "description": "IPv4 or IPv6 address (including port) of the authoritative DNS server for this domain.",
            "description_kind": "plain",
            "required": true
          },
          "tls_hostname": {
            "type": "string",
            "description": "A TLS hostname used to verify the server certificate when performing TLS Queries.",
            "description_kind": "plain",
            "optional": true
          },
          "tls_queries": {
            "type": "bool",
            "description": "Queries to all DNS servers for this domain will be sent using SSL/TLS, defaults to `false`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "DNS resolver [domain override](https://docs.netgate.com/pfsense/en/latest/services/dns/resolver-domain-overrides.html). Domain for which the resolver's standard DNS lookup process should be overridden and a different (non-standard) lookup server should be queried instead.\n\nRequired Privileges:\n* Create: `WebCfg - Diagnostics: Command`, `WebCfg - Services: DNS Resolver: Edit Domain Override`\n* Read: `WebCfg - Diagnostics: Command`\n* Update: `WebCfg - Diagnostics: Command`, `WebCfg - Services: DNS Resolver: Edit Domain Override`\n* Delete: `WebCfg - Diagnostics: Command`, `WebCfg - Services: DNS Resolver`",
        "description_kind": "markdown"
      }
    },
    "pfsense_dnsresolver_hostoverride": {
      "version": 0,
      "block": {
        "attributes": {
          "aliases": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "For administrative reference (not parsed).",
                  "description_kind": "plain",
                  "optional": true
                },
                "domain": {
                  "type": "string",
                  "description": "Parent domain of the host.",
                  "description_kind": "plain",
                  "required": true
                },
                "host": {
                  "type": "string",
                  "description": "Name of the host, without the domain part.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of additional names for this host.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "apply": {
            "type": "bool",
            "description": "Apply change, defaults to `true`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "For administrative reference (not parsed).",
            "description_kind": "plain",
            "optional": true
          },
          "domain": {
            "type": "string",
            "description": "Parent domain of the host.",
            "description_kind": "plain",
            "required": true
          },
          "fqdn": {
            "type": "string",
            "description": "Fully qualified domain name of host.",
            "description_kind": "plain",
            "computed": true
          },
          "host": {
            "type": "string",
            "description": "Name of the host, without the domain part.",
            "description_kind": "plain",
            "optional": true
          },
          "ip_addresses": {
            "type": [
              "list",
              "string"
            ],
            "description": "IPv4 or IPv6 addresses to be returned for the host.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "DNS resolver [host override](https://docs.netgate.com/pfsense/en/latest/services/dns/resolver-host-overrides.html). Host for which the resolver's standard DNS lookup process should be overridden and a specific IPv4 or IPv6 address should automatically be returned by the resolver.\n\nRequired Privileges:\n* Create: `WebCfg - Diagnostics: Command`, `WebCfg - Services: DNS Resolver: Edit host`\n* Read: `WebCfg - Diagnostics: Command`\n* Update: `WebCfg - Diagnostics: Command`, `WebCfg - Services: DNS Resolver: Edit host`\n* Delete: `WebCfg - Diagnostics: Command`, `WebCfg - Services: DNS Resolver`",
        "description_kind": "markdown"
      }
    },
    "pfsense_execute_php_command": {
      "version": 0,
      "block": {
        "attributes": {
          "command": {
            "type": "string",
            "description": "PHP command.",
            "description_kind": "plain",
            "required": true
          },
          "destroy_command": {
            "type": "string",
            "description": "PHP command to run on destroy.",
            "description_kind": "plain",
            "optional": true
          },
          "result": {
            "type": "dynamic",
            "description": "Result of command.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "[Execute PHP command](https://docs.netgate.com/pfsense/en/latest/diagnostics/command-prompt.html#php-execute). The command must print exactly one valid JSON value.\n\nRequired Privileges: `WebCfg - Diagnostics: Command`",
        "description_kind": "markdown"
      }
    },
    "pfsense_firewall_filter_reload": {
      "version": 0,
      "block": {
