{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "command_prefix": {
          "type": "string",
          "description": "Can be used to prefix all ssh commands issued on the target host. For example, a command_prefix of 'sudo' can be used to elevate privileges on the target host, assuming password-less is configured for the user",
          "description_kind": "markdown",
          "optional": true
        },
        "host": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "key": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "key_passphrase": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "key_path": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "port": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "user": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "zfs_filesystem": {
      "version": 0,
      "block": {
        "attributes": {
          "gid": {
            "type": "number",
            "description": "Set group of the mountpoint. Must be a valid gid",
            "description_kind": "markdown",
            "optional": true
          },
          "group": {
            "type": "string",
            "description": "Set group of the mountpoint. Must be a valid group name",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "mountpoint": {
            "type": "string",
            "description": "Mountpoint of the filesystem.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the ZFS filesystem.",
            "description_kind": "markdown",
            "required": true
          },
          "owner": {
            "type": "string",
            "description": "Set owner of the mountpoint. Must be a valid username",
            "description_kind": "markdown",
            "optional": true
          },
          "properties": {
            "type": [
              "map",
              "string"
            ],
            "description": "Formatted versions of all zfs properties.",
            "description_kind": "markdown",
            "computed": true
          },
          "property_mode": {
            "type": "string",
            "description": "\n\t\tWhich properties to manage.\n\n\t\t\"defined\" means only manage the properties explicitly defined in the resource. This is the default.\n\n\t\t\"native\" means manage all native zfs properties, but leave user properties alone (see man zfsprops for more info\n\t\tabout these types of properties). This means all properties that aren't defined in the terraform resource but that\n\t\tare explicitly overridden on the zfs resource will be set back to inherit from their parent/the default.\n\n\t\t\"all\" is like \"native\", but also includes user properties. Be careful when removing/altering properties you don't\n\t\trecognize as some tools might use user properties to track information important for that tool to work properly\n\t\twith a given resource.\n\n\t\tNote that some properties don't have a default that they can be compared/reset to (notably most of the zpool\n\t\tproperties). These properties will only ever be managed when explicitly defined, and will be left as they are when\n\t\tthey stop being defined.\n\t",
            "description_kind": "markdown",
            "optional": true
          },
          "raw_properties": {
            "type": [
              "map",
              "string"
            ],
            "description": "Parseable versions of all zfs properties.",
            "description_kind": "markdown",
            "computed": true
          },
          "uid": {
            "type": "number",
            "description": "Set owner of the mountpoint. Must be a valid uid",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "block_types": {
          "property": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "The name of the property to configure",
                  "description_kind": "markdown",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "Value of the property",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "description": "Propert(y/ies) to set",
              "description_kind": "markdown"
            }
          }
        },
        "description": "zfs filesystem resource.",
        "description_kind": "markdown"
      }
    },
