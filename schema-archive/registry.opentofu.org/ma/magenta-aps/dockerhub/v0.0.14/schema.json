{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "password": {
          "type": "string",
          "description": "Password for authentication.",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username for authentication.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "dockerhub_group": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Group description.",
            "description_kind": "plain",
            "optional": true
          },
          "group_id": {
            "type": "number",
            "description": "Group ID.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "The provider specific id of the group.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Group name.",
            "description_kind": "plain",
            "required": true
          },
          "organisation": {
            "type": "string",
            "description": "The organisation name.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages an organization group",
        "description_kind": "plain"
      }
    },
    "dockerhub_repository": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "Repository name.",
            "description_kind": "plain",
            "optional": true
          },
          "full_description": {
            "type": "string",
            "description": "Repository name.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The namespace/name of the repository.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Repository name.",
            "description_kind": "plain",
            "required": true
          },
          "namespace": {
            "type": "string",
            "description": "Repository namespace.",
            "description_kind": "plain",
            "required": true
          },
          "private": {
            "type": "bool",
            "description": "Is the repository private.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages an image repository",
        "description_kind": "plain"
      }
    },
    "dockerhub_repositorygroup": {
      "version": 0,
      "block": {
        "attributes": {
          "group": {
            "type": "number",
            "description": "The group to add.",
            "description_kind": "plain",
            "required": true
          },
          "groupname": {
            "type": "string",
            "description": "The group to add.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The provider specific id of the repository group.",
            "description_kind": "plain",
            "computed": true
          },
          "permission": {
            "type": "string",
            "description": "The permission to assign the group. One of 'read', 'write' and 'admin'.",
            "description_kind": "plain",
            "optional": true
          },
          "repository": {
            "type": "string",
            "description": "The repository path.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages an organization group / repository permission binding",
        "description_kind": "plain"
      }
    },
    "dockerhub_token": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "The UUID of the token.",
            "description_kind": "plain",
            "computed": true
          },
          "label": {
            "type": "string",
            "description": "Token label.",
            "description_kind": "plain",
            "required": true
          },
          "scopes": {
            "type": [
              "set",
              "string"
            ],
            "description": "Permissions e.g. 'repo:admin'",
            "description_kind": "plain",
            "required": true
          },
          "token": {
            "type": "string",
            "description": "Token to use as password",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Manages a personal access token (for uploading repository images)",
        "description_kind": "plain"
      }
    }
  }
}
