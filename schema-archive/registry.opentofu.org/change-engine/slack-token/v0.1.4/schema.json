            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "refresh_token": {
            "type": "string",
            "description": "Current refresh token.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true,
            "sensitive": true
          },
          "token": {
            "type": "string",
            "description": "Current API token.",
