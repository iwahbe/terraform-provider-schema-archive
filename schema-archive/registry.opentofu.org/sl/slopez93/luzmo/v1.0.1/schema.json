{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "api_token": {
          "type": "string",
          "description_kind": "plain",
          "required": true
        },
        "api_url": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        },
        "api_version": {
          "type": "string",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "luzmo_account": {
      "version": 0,
      "block": {
        "attributes": {
          "active": {
            "type": "bool",
            "description": "Indicates whether queries may be sent to this database or plugin connection.",
            "description_kind": "plain",
            "optional": true
          },
          "cache": {
            "type": "number",
            "description": "Number of seconds queries to this data connector are cached in Luzmo's caching layer. Use 0 to disable caching.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "datasets_meta_sync_enabled": {
            "type": "bool",
            "description": "Indicates whether automatic metadata sync is enabled for all connection datasets with meta_sync_inherit=true.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "datasets_meta_sync_interval": {
            "type": "number",
            "description": " Metadata sync interval in hours for connection datasets with meta_sync_inherit=true.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description of the account.",
            "description_kind": "plain",
            "required": true
          },
          "host": {
            "type": "string",
            "description": "Endpoint of this account. For relational database connections, this corresponds to the hostname of the database.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "String identifier of the order.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the account.",
            "description_kind": "plain",
            "required": true
          },
          "port": {
            "type": "string",
            "description": "Port of this connection. For relational database connections, this corresponds to the port of the database.",
            "description_kind": "plain",
            "optional": true
          },
          "provider_name": {
            "type": "string",
            "description": "The slug of your own plugin or one of a database.",
            "description_kind": "plain",
            "required": true
          },
          "scope": {
            "type": "string",
            "description": "Provider-specific description of services used.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages a account.",
        "description_kind": "plain"
      }
    },
    "luzmo_dashboard": {
      "version": 0,
      "block": {
        "attributes": {
          "contents": {
            "type": "string",
            "description": "The contents of the dashboard.",
            "description_kind": "plain",
            "required": true
          },
          "css": {
            "type": "string",
            "description": "The css of the dashboard.",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "The description of the dashboard.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Numeric identifier of the order.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the dashboard.",
            "description_kind": "plain",
            "required": true
          },
          "subtitle": {
            "type": "string",
            "description": "The description of the dashboard.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a dashboard.",
        "description_kind": "plain"
      }
    },
    "luzmo_dataset": {
      "version": 0,
      "block": {
        "attributes": {
          "cache": {
            "type": "number",
            "description": "Number of seconds queries to this data connector are cached in Luzmo's caching layer. Use 0 to disable caching.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "dataset_id": {
            "type": "string",
            "description": "The dataset id.",
