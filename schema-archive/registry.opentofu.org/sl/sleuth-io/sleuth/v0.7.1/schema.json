{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The Sleuth organization's Api key",
          "description_kind": "markdown",
          "optional": true
        },
        "baseurl": {
          "type": "string",
          "description": "Ignore this, as it is only used by Sleuth developers",
          "description_kind": "markdown",
          "optional": true
        },
        "timeout": {
          "type": "number",
          "description": "Timeout in seconds of Sleuth API responses",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "sleuth_code_change_source": {
      "version": 0,
      "block": {
        "attributes": {
          "auto_tracking_delay": {
            "type": "number",
            "description": "The delay to add to a deployment event",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "build_mappings": {
            "nested_type": {
              "attributes": {
                "build_name": {
                  "type": "string",
                  "description": "The remote build or pipeline name",
                  "description_kind": "markdown",
                  "required": true
                },
                "environment_slug": {
                  "type": "string",
                  "description": "The environment slug",
                  "description_kind": "markdown",
                  "required": true
                },
                "integration_slug": {
                  "type": "string",
                  "description": "IntegrationAuthentication slug used",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "is_custom": {
                  "type": "bool",
                  "description": "Whether this is a custom build mapping or not. This needs to be set to true if a build name or job name isn't visible in Sleuth. Defaults to false",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "job_name": {
                  "type": "string",
                  "description": "The job or stage within the build or pipeline, if supported",
                  "description_kind": "markdown",
                  "optional": true
                },
                "match_branch_to_environment": {
                  "type": "bool",
                  "description": "Whether only builds performed on the branch mapped from the environment are tracked or not. Basically if you only want Sleuth to find builds that were triggeredby a change on the branch that is configured for the environment, set this to false. Defaults to true",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "project_key": {
                  "type": "string",
                  "description": "The build project key. If both project_key and project_name are provided, project_key takes precedence.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "project_name": {
                  "type": "string",
                  "description": "The build project name. If both project_key and project_name are provided, project_key takes precedence.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "provider": {
                  "type": "string",
                  "description": "The build provider. Options: AZURE, BITBUCKET_PIPELINES, BUILDKITE, CIRCLECI, GITHUB, GITLAB, JENKINS",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Build mappings of the code change source. They must be ordered by environment_slug ascending to avoid Terraform plan changes.",
            "description_kind": "markdown",
            "optional": true
          },
          "collect_impact": {
            "type": "bool",
            "description": "Whether to collect impact for its deploys",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "deploy_tracking_type": {
            "type": "string",
            "description": "How to track deploys. Valid choices are build, manual, auto_pr, auto_tag, auto_push",
            "description_kind": "markdown",
            "required": true
          },
          "environment_mappings": {
            "nested_type": {
              "attributes": {
                "branch": {
                  "type": "string",
                  "description": "The repository branch name for the environment",
                  "description_kind": "markdown",
                  "required": true
                },
                "environment_slug": {
                  "type": "string",
                  "description": "The environment slug for mapping",
                  "description_kind": "markdown",
                  "required": true
                },
                "id": {
                  "type": "string",
                  "description": "Computed ID",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Environment mappings of the code change source. They must be ordered by environment_slug ascending to avoid Terraform plan changes.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "include_in_dashboard": {
            "type": "bool",
            "description": "Whether to include deploys from this change source in the metrics dashboard",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Code change source name",
            "description_kind": "markdown",
            "required": true
          },
          "notify_in_slack": {
            "type": "bool",
            "description": "Whether to send Slack notifications for deploys or not",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "path_prefix": {
            "type": "string",
            "description": "What code source path to limit this deployment to. Useful for monorepos. Must be used with the [jsonencode()](https://developer.hashicorp.com/terraform/language/functions/jsonencode) function to specify the paths to include and/or exclude respectively. (see example above)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "project_slug": {
            "type": "string",
            "description": "The slug of the project that this code change source belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "repository": {
            "nested_type": {
              "attributes": {
                "integration_slug": {
                  "type": "string",
                  "description": "IntegrationAuthentication slug used",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "The repository name",
                  "description_kind": "markdown",
                  "required": true
                },
                "owner": {
                  "type": "string",
                  "description": "The repository owner, usually the organization or user name",
                  "description_kind": "markdown",
                  "required": true
                },
                "project_uid": {
                  "type": "string",
                  "description": "Project UID, required only for AZURE provider. You can obtain data from [API](https://learn.microsoft.com/en-us/rest/api/azure/devops/git/repositories/list?view=azure-devops-rest-6.0&tabs=HTTP)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "provider": {
                  "type": "string",
                  "description": "The repository provider, options: AZURE, BITBUCKET, CUSTOM_GIT, GITHUB, GITHUB_ENTERPRISE, GITLAB",
                  "description_kind": "markdown",
                  "required": true
                },
                "repo_uid": {
                  "type": "string",
                  "description": "Repository UID, required only for AZURE provider. You can obtain data from [API](https://learn.microsoft.com/en-us/rest/api/azure/devops/git/repositories/list?view=azure-devops-rest-6.0&tabs=HTTP)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "url": {
                  "type": "string",
                  "description": "The repository URL, used for links",
                  "description_kind": "markdown",
                  "required": true
                },
                "webhook": {
                  "nested_type": {
                    "attributes": {
                      "secret": {
                        "type": "string",
                        "description": "Webhook secret to present in payloads sent to the webhook URL",
                        "description_kind": "markdown",
                        "computed": true,
                        "sensitive": true
                      },
                      "url": {
                        "type": "string",
                        "description": "Webhook URL",
                        "description_kind": "markdown",
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Webhook configuration for registering deploys from code integrations in read-only mode",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Repository details",
            "description_kind": "plain",
            "required": true
          },
          "slug": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Sleuth code change source.",
        "description_kind": "markdown"
      }
    },
    "sleuth_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "color": {
            "type": "string",
            "description": "The color for the UI",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Environment description",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Environment name",
            "description_kind": "markdown",
            "required": true
          },
          "project_slug": {
            "type": "string",
            "description": "The project for this environment",
            "description_kind": "markdown",
            "required": true
          },
          "slug": {
            "type": "string",
            "description": "Environment slug",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Environment resource.",
        "description_kind": "plain"
      }
    },
    "sleuth_error_impact_source": {
      "version": 0,
      "block": {
        "attributes": {
          "environment_slug": {
            "type": "string",
            "description": "The slug of the environment that this error impact source belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "error_environment": {
            "type": "string",
            "description": "The environment of the integration provider",
            "description_kind": "markdown",
            "required": true
          },
          "error_org_key": {
            "type": "string",
            "description": "The organization key of the integration provider",
            "description_kind": "markdown",
            "required": true
          },
          "error_project_key": {
            "type": "string",
            "description": "The project key of the integration provider",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "integration_slug": {
            "type": "string",
            "description": "The integration slug",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "manually_set_health_threshold": {
            "type": "number",
            "description": "The manually set threshold to start marking failed values",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Error impact source name",
            "description_kind": "markdown",
            "required": true
          },
          "project_slug": {
            "type": "string",
            "description": "The slug of the project that this error impact source belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "provider_type": {
            "type": "string",
            "description": "Integration provider type",
            "description_kind": "markdown",
            "required": true
          },
          "slug": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Sleuth error impact source.",
        "description_kind": "markdown"
      }
    },
    "sleuth_incident_impact_source": {
      "version": 0,
      "block": {
        "attributes": {
          "blameless_input": {
            "nested_type": {
              "attributes": {
                "integration_slug": {
                  "type": "string",
                  "description": "Blameless IntegrationAuthentication slug from app",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_severity_threshold": {
                  "type": "string",
                  "description": "Incidents with matching or lower severities will be considered a failure in Sleuth",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_types": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "The types of incidents to the monitors should track",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Blameless input",
            "description_kind": "markdown",
            "optional": true
          },
          "clubhouse_input": {
            "nested_type": {
              "attributes": {
                "integration_slug": {
                  "type": "string",
                  "description": "IntegrationAuthentication slug used",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_query": {
                  "type": "string",
                  "description": "Need help finding query expression? See the [documentation](https://help.shortcut.com/hc/en-us/articles/360000046646-Searching-in-Shortcut-Using-Search-Operators) for more information.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Clubhouse input",
            "description_kind": "markdown",
            "optional": true
          },
          "datadog_input": {
            "nested_type": {
              "attributes": {
                "integration_slug": {
                  "type": "string",
                  "description": "DataDog IntegrationAuthentication slug from app",
                  "description_kind": "plain",
                  "optional": true
                },
                "query": {
                  "type": "string",
                  "description": "The query to scope the monitors to track. If you are using a custom facet you would need to add @ to the beginning of the facet name. If empty, all monitors in Datadog will be matched regardless of environment or service.\nSee [DataDog documentation](https://docs.datadoghq.com/monitors/manage/search/) for more information.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "remote_priority_threshold": {
                  "type": "string",
                  "description": "Monitor states with matching or higher priorities will be considered a failure in Sleuth.\nOptions: ALL, P1, P2, P3, P4, P5. Defaults to ALL",
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "DataDog input",
            "description_kind": "markdown",
            "optional": true
          },
          "environment_name": {
            "type": "string",
            "description": "Impact source environment name",
            "description_kind": "markdown",
            "required": true
          },
          "firehydrant_input": {
            "nested_type": {
              "attributes": {
                "remote_environments": {
                  "type": "string",
                  "description": "The environment defined in FireHydrant to monitor",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_mitigated_is_healthy": {
                  "type": "bool",
                  "description": "If true, incident considered to have ended once reaching mitigated Milestone or it is resolved",
                  "description_kind": "markdown",
                  "computed": true
                },
                "remote_services": {
                  "type": "string",
                  "description": "The service defined in FireHydrant to monitor",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "FireHydrant input",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "jira_input": {
            "nested_type": {
              "attributes": {
                "integration_slug": {
                  "type": "string",
                  "description": "JIRA IntegrationAuthentication slug from app",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_jql": {
                  "type": "string",
                  "description": "JIRA active incidents issues JQL",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "JIRA input",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Impact source name",
            "description_kind": "markdown",
            "required": true
          },
          "opsgenie_input": {
            "nested_type": {
              "attributes": {
                "integration_slug": {
                  "type": "string",
                  "description": "The slug for the integration",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_alert_tags": {
                  "type": "string",
                  "description": "Optionally filter by alert tags",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_incident_tags": {
                  "type": "string",
                  "description": "Optionally filter by incident tags",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_priority_threshold": {
                  "type": "string",
                  "description": "Monitor states with matching or higher priorities will be considered a failure in Sleuth",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "remote_service": {
                  "type": "string",
                  "description": "Only taken into consideration when using OpsGenie Incidents. This value should be the Unique ID of the OpsGenie service.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_use_alerts": {
                  "type": "bool",
                  "description": "Use OpsGenie Alerts instead of Incidents",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "OpsGenie input",
            "description_kind": "markdown",
            "optional": true
          },
          "pagerduty_input": {
            "nested_type": {
              "attributes": {
                "integration_slug": {
                  "type": "string",
                  "description": "IntegrationAuthentication slug used",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_services": {
                  "type": "string",
                  "description": "List of remote services, empty string means all",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "remote_urgency": {
                  "type": "string",
                  "description": "PagerDuty remote urgency, options: HIGH, LOW, ANY",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "PagerDuty input",
            "description_kind": "markdown",
            "optional": true
          },
          "project_slug": {
            "type": "string",
            "description": "The slug of the project that this incident impact source belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "provider_name": {
            "type": "string",
            "description": "Impact source provider in lowercase (options: pagerduty, datadog, jira, blameless, statuspage, opsgenie, firehydrant, clubhouse, rootly)",
            "description_kind": "markdown",
            "required": true
          },
          "rootly_input": {
            "nested_type": {
              "attributes": {
                "integration_slug": {
                  "type": "string",
                  "description": "IntegrationAuthentication slug used",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_environment": {
                  "type": "string",
                  "description": "Environment ID (environments are defined within Rootly)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_incident_type": {
                  "type": "string",
                  "description": "Incident type ID (incident types are defined within Rootly)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_service": {
                  "type": "string",
                  "description": "Service ID (services are defined within Rootly)",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_severity": {
                  "type": "string",
                  "description": "Rootly\u2019s severity values are configurable, but ultimately they always map to 4 levels: ALL, CRITICAL, HIGH, MEDIUM and LOW. Check out your current [severities configuration in Rootly](https://rootly.com/account/severities).",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_team": {
                  "type": "string",
                  "description": "Team ID (teams are defined within Rootly)",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Rootly input",
            "description_kind": "markdown",
            "optional": true
          },
          "slug": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "statuspage_input": {
            "nested_type": {
              "attributes": {
                "ignore_maintenance_incidents": {
                  "type": "bool",
                  "description": "Option to ignore maintenance incidents",
                  "description_kind": "markdown",
                  "optional": true
                },
                "integration_slug": {
                  "type": "string",
                  "description": "Statuspage IntegrationAuthentication slug from app",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_component": {
                  "type": "string",
                  "description": "Statuspage component the incident impact source should monitor",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_impact": {
                  "type": "string",
                  "description": "Incidents with matching or lower severities will be considered a failure in Sleuth",
                  "description_kind": "markdown",
                  "optional": true
                },
                "remote_page": {
                  "type": "string",
                  "description": "Statuspage page the incident impact source should monitor",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Statuspage input",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Sleuth incident impact source.",
        "description_kind": "markdown"
      }
    },
    "sleuth_metric_impact_source": {
      "version": 0,
      "block": {
        "attributes": {
