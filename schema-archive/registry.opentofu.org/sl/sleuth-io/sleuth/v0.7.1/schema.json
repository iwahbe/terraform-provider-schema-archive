          "manually_set_health_threshold": {
            "type": "number",
            "description": "The manually set threshold to start marking failed values",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Impact source name",
            "description_kind": "markdown",
            "required": true
          },
          "project_slug": {
            "type": "string",
            "description": "The slug of the project that this metric impact source belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "provider_type": {
            "type": "string",
            "description": "Integration provider type",
            "description_kind": "markdown",
            "required": true
          },
          "query": {
            "type": "string",
            "description": "The metric query",
            "description_kind": "markdown",
            "required": true
          },
          "slug": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Sleuth metric impact source.",
        "description_kind": "markdown"
      }
    },
    "sleuth_project": {
      "version": 0,
      "block": {
        "attributes": {
          "build_provider": {
            "type": "string",
            "description": "Where to find builds related to changes",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "change_failure_rate_boundary": {
            "type": "string",
            "description": "The health rating at which point it will be considered a failure",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "change_lead_time_issue_states": {
            "type": [
              "set",
              "number"
            ],
            "description": "Issue state IDs used for start definition (only used if change_lead_time_start_definition is ISSUE or FIRST_EVENT.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
