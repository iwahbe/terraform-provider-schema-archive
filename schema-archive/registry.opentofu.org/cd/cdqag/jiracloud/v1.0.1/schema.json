{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "The Jira Cloud API token to authenticate with.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "host": {
          "type": "string",
          "description": "The hostname of the Jira Cloud instance, e.g. `https://example.atlassian.net`.",
          "description_kind": "markdown",
          "optional": true
        },
        "user_email": {
          "type": "string",
          "description": "The user's email to authenticate with.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "jiracloud_component": {
      "version": 0,
      "block": {
        "attributes": {
          "assignee_type": {
            "type": "string",
            "description": "The assignee type of the Jira component.Valid values are `PROJECT_DEFAULT`, `COMPONENT_LEAD`, `PROJECT_LEAD`, `UNASSIGNED`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "The description of the Jira component.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "lead": {
            "type": "string",
            "description": "The lead of the Jira component represented by their Jira account ID.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the Jira component.",
            "description_kind": "markdown",
            "required": true
          },
          "project": {
            "type": "string",
            "description": "The Jira project key that the component belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Jira Component Data Source",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "jiracloud_component": {
      "version": 0,
      "block": {
        "attributes": {
          "description": {
            "type": "string",
            "description": "The description of the Jira component.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "lead": {
            "type": "string",
            "description": "The lead of the Jira component represented by their Jira account ID.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the Jira component.",
            "description_kind": "markdown",
            "required": true
          },
          "project": {
            "type": "string",
            "description": "The Jira project key that the component belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Jira Component Data Source",
        "description_kind": "markdown"
      }
    }
  }
}
