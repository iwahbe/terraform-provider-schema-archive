{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_endpoint": {
          "type": "string",
          "description": "Cisco Secure Access API endpoint. Optional custom endpoint for the API.",
          "description_kind": "plain",
          "optional": true
        },
        "key_id": {
          "type": "string",
          "description": "Cisco Secure Access API Key ID. Can also be set via the CISCOSECUREACCESS_KEY_ID environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "key_secret": {
          "type": "string",
          "description": "Cisco Secure Access API Key Secret. Can also be set via the CISCOSECUREACCESS_KEY_SECRET environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Terraform Provider for Cisco Secure Access",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ciscosecureaccess_access_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "action": {
            "type": "string",
            "description": "Action taken on matched traffic ('allow' or 'block'). Defaults to 'block'",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "client_posture_profile_id": {
            "type": "number",
            "description": "ID of posture profile for client-based access",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Description for access policy",
            "description_kind": "plain",
            "optional": true
          },
          "destination_list_ids": {
            "type": [
              "set",
              "number"
            ],
            "description": "Secure Access IDs of matching destination list",
            "description_kind": "plain",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether or not to enable access policy. Defaults to false",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Unique ID of access policy",
            "description_kind": "plain",
            "computed": true
          },
          "log_level": {
            "type": "string",
            "description": "Level of logging to perform on traffic matching access policy",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of access policy",
            "description_kind": "plain",
            "required": true
          },
          "priority": {
            "type": "number",
            "description": "Priority at which to create rule (ascending)",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "private_destination_types": {
            "type": [
              "set",
              "string"
            ],
            "description": "Wildcard destination types allowing access to resources (eg. [\"private_apps\"]",
            "description_kind": "plain",
            "optional": true
          },
          "private_resource_ids": {
            "type": [
              "set",
              "number"
            ],
            "description": "Secure Access IDs of matching private resource",
            "description_kind": "plain",
            "optional": true
          },
          "public_destination_types": {
            "type": [
              "set",
              "string"
            ],
            "description": "Wildcard destination types allowing access to public destinations (eg. [\"internet\"]",
            "description_kind": "plain",
            "optional": true
          },
          "source_ids": {
            "type": [
              "set",
              "number"
            ],
            "description": "Source Secure Access IDs of matching resource",
            "description_kind": "plain",
            "optional": true
          },
          "source_types": {
            "type": [
              "set",
              "string"
            ],
            "description": "Wildcard source types allowing access to resource (eg. [\"directory_users\", \"networks\"])",
            "description_kind": "plain",
            "optional": true
          },
          "traffic_type": {
            "type": "string",
            "description": "Traffic type to define rule scope ('PRIVATE_NETWORK' or 'PUBLIC_INTERNET'). Defaults to 'PRIVATE_NETWORK'",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          }
        },
        "description": "Access Policy rule, currently support private access rules only",
        "description_kind": "plain"
      }
    },
    "ciscosecureaccess_destination_list": {
      "version": 0,
      "block": {
        "attributes": {
          "destinations": {
            "nested_type": {
              "attributes": {
                "comment": {
                  "type": "string",
                  "description": "Description of destination",
                  "description_kind": "plain",
                  "optional": true
                },
                "destination": {
                  "type": "string",
                  "description": "A domain, url, or IP.",
                  "description_kind": "plain",
                  "required": true
                },
                "id": {
                  "type": "string",
                  "description": "Unique identifier for destination",
                  "description_kind": "plain",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "The type of the destination ('domain', 'url', 'ipv4')",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "List of destinations to include in the list",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "number",
            "description": "Unique identifier for destination list",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of destination list",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "ciscosecureaccess_global_settings": {
      "version": 0,
      "block": {
        "attributes": {
          "enable_global_decryption": {
            "type": "bool",
            "description": "Enable IPS decryption in the global default rules",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "global_ips_profile_id": {
            "type": "number",
            "description": "IPS profile ID applied as part of global default rules",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for the global settings resource",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manage global default rule settings for Cisco Secure Access",
        "description_kind": "plain"
      }
    },
    "ciscosecureaccess_network_tunnel_group": {
      "version": 0,
      "block": {
        "attributes": {
          "device_type": {
            "type": "string",
            "description": "Type of device used to terminate network tunnel group",
            "description_kind": "plain",
            "required": true
          },
          "hubs": {
            "nested_type": {
              "attributes": {
                "auth_id": {
                  "type": "string",
                  "description": "IPSec authentication ID used for connecting to remote hub",
                  "description_kind": "plain",
                  "computed": true
                },
                "datacenter": {
                  "nested_type": {
                    "attributes": {
                      "ip": {
                        "type": "string",
                        "description": "External IP of datacenter where hub is located",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "name": {
                        "type": "string",
                        "description": "Name of datacenter where hub is located",
                        "description_kind": "plain",
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Datacenter information for hub",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Unique ID of remote hub",
                  "description_kind": "plain",
                  "computed": true
                },
                "is_primary": {
                  "type": "bool",
                  "description": "Whether or not hub is designated as 'primary'",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Remote connection endpoints for connecting network tunnel group",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Unique ID of network tunnel group",
            "description_kind": "plain",
            "computed": true
          },
          "identifier_prefix": {
            "type": "string",
            "description": "Prefix for tunnel authentication ID",
            "description_kind": "plain",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "Name of network tunnel group",
            "description_kind": "plain",
            "required": true
          },
          "network_cidrs": {
            "type": [
              "list",
              "string"
            ],
            "description": "Inside Network CIDR addresses of network tunnel group",
            "description_kind": "plain",
            "optional": true
          },
          "preshared_key": {
            "type": "string",
            "description": "Secret preshared key used to authenticate network tunnel group",
            "description_kind": "plain",
            "required": true,
            "sensitive": true
          },
          "region": {
            "type": "string",
            "description": "Deployment region of network tunnel group",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Cisco Secure Access Network Tunnel Group resource, currently supports static routes only",
        "description_kind": "plain"
      }
    },
    "ciscosecureaccess_private_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "access_types": {
            "type": [
              "set",
              "string"
            ],
            "description": "Access types for private resource",
            "description_kind": "plain",
            "required": true
          },
          "addresses": {
            "nested_type": {
              "attributes": {
                "addresses": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "One list of addresses for the private resource",
                  "description_kind": "plain",
                  "optional": true
                },
                "traffic_selector": {
                  "nested_type": {
                    "attributes": {
                      "ports": {
                        "type": "string",
                        "description": "Port numbers for this traffic selector",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "protocol": {
                        "type": "string",
                        "description": "Protocols for this traffic selector",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "set"
                  },
                  "description": "Protocol/port pairs for this list of addresses",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "set"
            },
            "description": "List of address/protocol pairs for the private resource",
            "description_kind": "plain",
            "optional": true
          },
          "certificate_id": {
            "type": "number",
            "description": "Object ID of certificate to use for decrypting traffic",
            "description_kind": "plain",
            "optional": true
          },
          "client_reachable_addresses": {
            "type": [
              "set",
              "string"
            ],
            "description": "Addresses allowed for client-based access",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Description of private resource",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Unique ID of private resource",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of private resource",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "ciscosecureaccess_resource_connector_agent": {
      "version": 0,
      "block": {
        "attributes": {
          "confirmed": {
            "type": "bool",
            "description": "Whether or not to confirm resource connector",
            "description_kind": "plain",
            "optional": true
          },
          "enabled": {
            "type": "bool",
            "description": "Whether or not to enable resource connector",
            "description_kind": "plain",
            "optional": true
          },
          "hostname": {
            "type": "string",
            "description": "Hostname of resource connector agent",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "number",
            "description": "Unique ID of resource connector agent",
            "description_kind": "plain",
            "computed": true
          },
          "instance_id": {
            "type": "string",
            "description": "Instance ID of resource connector agent",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "status": {
            "type": "string",
            "description": "Status of resource connector agent",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Resource Connector Agent deployment, currently managing AWS resource connectors",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "ciscosecureaccess_group": {
      "version": 0,
      "block": {
        "attributes": {
          "filter": {
            "type": "string",
            "description": "Filter string used to search for groups",
            "description_kind": "plain",
            "required": true
          },
          "groups": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "number",
                  "description": "Unique ID of group",
                  "description_kind": "plain",
                  "computed": true
                },
                "label": {
                  "type": "string",
                  "description": "Name of group",
                  "description_kind": "plain",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "Type of group",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of Cisco Secure Access groups corresponding to filter",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Data source for retrieving Cisco Secure Access groups",
        "description_kind": "plain"
      }
    },
    "ciscosecureaccess_identity": {
      "version": 0,
      "block": {
        "attributes": {
          "filter": {
            "type": "string",
            "description": "Filter string used to search for identities",
            "description_kind": "plain",
            "required": true
          },
          "identities": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "number",
                  "description": "Unique ID of identity",
                  "description_kind": "plain",
                  "computed": true
                },
                "label": {
                  "type": "string",
                  "description": "Name of identity",
                  "description_kind": "plain",
                  "computed": true
                },
                "type": {
                  "type": "string",
                  "description": "Type of identity",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of Cisco Secure Access identities corresponding to filter",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Data source for retrieving Cisco Secure Access identities",
        "description_kind": "plain"
      }
    },
    "ciscosecureaccess_resource_connector": {
      "version": 0,
      "block": {
        "attributes": {
          "filter": {
            "type": [
              "map",
              "string"
            ],
            "description": "Filter criteria for retrieving resource connector groups (e.g., {\"name\": \"example\"})",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Internal ID of resource connector group list",
            "description_kind": "plain",
            "computed": true
          },
          "resource_connector_groups": {
            "nested_type": {
              "attributes": {
                "connectors_count": {
                  "type": "number",
                  "description": "Number of resource connectors in group",
                  "description_kind": "plain",
                  "computed": true
                },
                "environment": {
                  "type": "string",
                  "description": "Environment in which resource connector group is provisioned",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Unique ID of resource connector group",
                  "description_kind": "plain",
                  "computed": true
                },
                "key_expires_at": {
                  "type": "string",
                  "description": "Time at which resource connector group provisioning key next expires",
                  "description_kind": "plain",
                  "computed": true
                },
                "location": {
                  "type": "string",
                  "description": "Location where resource connector group is provisioned",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of resource connector group",
                  "description_kind": "plain",
                  "computed": true
                },
                "provisioning_key": {
                  "type": "string",
                  "description": "Provisioning key for adding resource connectors to group",
                  "description_kind": "plain",
                  "computed": true,
                  "sensitive": true
                },
                "status": {
                  "type": "string",
                  "description": "Status of resource connector group",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Datasource for a list of Resource Connector Groups",
        "description_kind": "plain"
      }
    }
  }
}
