{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "insecure": {
          "type": "bool",
          "description": "Allow insecure HTTPS client. This can also be set as the NSO_INSECURE environment variable. Defaults to `true`.",
          "description_kind": "markdown",
          "optional": true
        },
        "instances": {
          "nested_type": {
            "attributes": {
              "name": {
                "type": "string",
                "description": "Instance name.",
                "description_kind": "markdown",
                "required": true
              },
              "url": {
                "type": "string",
                "description": "URL of the Cisco NSO instance.",
                "description_kind": "markdown",
                "required": true
              }
            },
            "nesting_mode": "list"
          },
          "description": "This can be used to manage a list of instances from a single provider. All instances must use the same credentials. Each resource and data source has an optional attribute named `instance`, which can then select an instance by its name from this list.",
          "description_kind": "markdown",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password for the NSO instance. This can also be set as the NSO_PASSWORD environment variable.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "retries": {
          "type": "number",
          "description": "Number of retries for RESTCONF API calls. This can also be set as the NSO_RETRIES environment variable. Defaults to `1`.",
          "description_kind": "markdown",
          "optional": true
        },
        "url": {
          "type": "string",
          "description": "URL of the Cisco NSO instance. Optionally a port can be added with `:12345`. The default port is `443`. This can also be set as the NSO_URL environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "Username for the NSO instance. This can also be set as the NSO_USERNAME environment variable.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "nso_device": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "IP address or host name for the management interface on the device.",
            "description_kind": "markdown",
            "optional": true
          },
          "admin_state": {
            "type": "string",
            "description": "Administrative state.\n  - Choices: `locked`, `unlocked`, `southbound-locked`, `config-locked`, `call-home`",
            "description_kind": "markdown",
            "optional": true
          },
          "authgroup": {
            "type": "string",
            "description": "The authentication credentials used when connecting to this managed device.",
            "description_kind": "markdown",
            "optional": true
          },
          "cli_ned_id": {
            "type": "string",
            "description": "CLI NED ID.",
            "description_kind": "markdown",
            "optional": true
          },
          "generic_ned_id": {
            "type": "string",
            "description": "Generic NED ID.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The RESTCONF path.",
            "description_kind": "markdown",
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "An instance name from the provider configuration.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "A string uniquely identifying the managed device.",
            "description_kind": "markdown",
            "required": true
          },
          "netconf_net_id": {
            "type": "string",
            "description": "NETCONF NED ID.",
            "description_kind": "markdown",
            "optional": true
          },
          "port": {
            "type": "number",
            "description": "Port for the management interface on the device. If this leaf is not configured, NCS will use a default value based on the type of device. For example, a NETCONF device uses port 830, a CLI device over SSH uses port 22, and an SNMP device uses port 161.\n  - Range: `0`-`65535`",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "This resource can manage the Device configuration.",
        "description_kind": "markdown"
      }
    },
    "nso_device_config": {
      "version": 0,
      "block": {
        "attributes": {
          "attributes": {
            "type": [
              "map",
              "string"
            ],
            "description": "Map of key-value pairs which represents the YANG leafs and its values.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "delete": {
            "type": "bool",
            "description": "Delete object during destroy operation. Default value is `true`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "device": {
            "type": "string",
            "description": "An NSO device name.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "The RESTCONF path.",
            "description_kind": "markdown",
            "computed": true
          },
          "instance": {
            "type": "string",
            "description": "An instance name from the provider configuration.",
            "description_kind": "markdown",
            "optional": true
          },
          "lists": {
            "nested_type": {
              "attributes": {
                "items": {
                  "type": [
                    "list",
                    [
                      "map",
                      "string"
                    ]
                  ],
                  "description": "List of maps of key-value pairs which represents the YANG leafs and its values.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "key": {
                  "type": "string",
                  "description": "YANG list key attribute. In case of multiple keys, those should be separated by a comma (`,`).",
                  "description_kind": "markdown",
                  "optional": true
                },
                "name": {
                  "type": "string",
                  "description": "YANG list name.",
                  "description_kind": "markdown",
                  "required": true
                },
                "values": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "YANG leaf-list values.",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "YANG lists.",
            "description_kind": "markdown",
            "optional": true
          },
          "path": {
            "type": "string",
            "description": "A RESTCONF path.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Manages a config part of an NSO device.",
        "description_kind": "markdown"
      }
    },
    "nso_device_group": {
      "version": 0,
      "block": {
        "attributes": {
          "device_groups": {
            "type": [
              "list",
              "string"
            ],
