              "nesting_mode": "list"
            },
            "description": "YANG lists.",
            "description_kind": "markdown",
            "optional": true
          },
          "path": {
            "type": "string",
            "description": "A RESTCONF path.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Manages NSO configuration via RESTCONF calls. This resource manages part of a YANG model. It is able to read the state and therefore reconcile configuration drift.",
        "description_kind": "markdown"
      }
    }
