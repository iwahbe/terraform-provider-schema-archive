{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "client_id": {
          "type": "string",
          "description": "ClientID of the AppDynamics API Client, this can also be set as the APPDYNAMICS_CLIENT_ID environment variable. To be used with login mode service_principal.",
          "description_kind": "markdown",
          "optional": true
        },
        "client_secret": {
          "type": "string",
          "description": "ClientSecret of the AppDynamics API Client. This can also be set as the APPDYNAMICS_CLIENT_SECRET environment variable. To be used with login mode service_principal.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "login_mode": {
          "type": "string",
          "description": "Mode of login. Possible values are: service_principal, browser and headless. This can also be set as the APPDYNAMICS_LOGIN_MODE environment variable.",
          "description_kind": "markdown",
          "required": true
        },
        "password": {
          "type": "string",
          "description": "Password to login to the AppDynamics Platform. This can also be set as the APPDYNAMICS_PASSWORD environment variable. To be used with login mode headless.",
          "description_kind": "markdown",
          "optional": true
        },
        "save_token": {
          "type": "bool",
          "description": "Whether or not to store the access token acquired by login mode browser and headless. This is for convenience and if you store the token, it would not prompt you to login again until it expires. This can also be set as the APPDYNAMICS_SAVE_TOKEN environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "tenant_name": {
          "type": "string",
          "description": "Tenant name of the AppDynamics Platform. This can also be set as the APPDYNAMICS_TENANT_NAME environment variable.",
          "description_kind": "markdown",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "Username to login to the AppDynamics Platform. This can also be set as the APPDYNAMICS_USERNAME environment variable. To be used with login mode headless.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "appdynamicscloud_access_client_app": {
      "version": 1,
      "block": {
        "attributes": {
          "auth_type": {
            "type": "string",
            "description": "Supported authentication methods used to request OAuth tokens: `client_secret_basic` - The client credentials will be sent in the authorization header `client_secret_post` - The client credentials will be sent in the request body.",
            "description_kind": "markdown",
            "required": true
          },
          "client_secret": {
            "type": "string",
            "description": "The client's secret, used to authenticate during an oAuth token request",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "created_at": {
            "type": "string",
            "description": "The RFC3339 timestamp when the client was created",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "A user provided description of the client.",
            "description_kind": "markdown",
            "required": true
          },
          "display_name": {
            "type": "string",
            "description": "The display name for the client.",
            "description_kind": "markdown",
            "required": true
          },
          "has_rotated_secrets": {
            "type": "bool",
            "description": "Indicates if the client has rotated secrets. Rotated client secrets can be revoked.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "revoke_now": {
            "type": "bool",
            "description": "Revokes all the rotated client secrets of the specified client. Defaults to false. Please note that this cannot be used along with rotate_secret. If you wish to rotate the secret to a newer version and revoke the current one immediately, use the `revoke_previous_secret_in` and set it to `now`",
            "description_kind": "markdown",
            "optional": true
          },
          "revoke_previous_secret_in": {
            "type": "string",
            "description": "Time duration of how long the previous secret should be active for. Acceptable values are `NOW`, `1D`, `3D`, `7D` and `30D`. Must be set when rotating a secret with rotate_secret.",
            "description_kind": "markdown",
            "optional": true
          },
          "rotate_secret": {
            "type": "bool",
            "description": "Rotates the client secret of the specified service client. Defaults to false.",
            "description_kind": "markdown",
            "optional": true
          },
          "rotated_secret_expires_at": {
            "type": "string",
            "description": "The RFC3339 timestamp when the rotated client secret will expire.",
            "description_kind": "markdown",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "The RFC3339 timestamp when the client was last updated.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "appdynamicscloud_connection_aws": {
      "version": 1,
      "block": {
        "attributes": {
          "configuration_details_service_default": {
            "type": "bool",
            "description": "Whether default services are present in configuration details",
            "description_kind": "markdown",
            "computed": true
          },
          "configuration_id": {
            "type": "string",
            "description": "The Configuration ID of the Connection",
            "description_kind": "markdown",
            "computed": true
          },
          "created_at": {
            "type": "string",
            "description": "The RFC3339 timestamp",
            "description_kind": "markdown",
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Description for this connection or configuration",
            "description_kind": "markdown",
            "optional": true
          },
          "display_name": {
            "type": "string",
            "description": "Name of the connection or configuration",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "state": {
            "type": "string",
            "description": "Connection state. Value which can be given: [ \"ACTIVE\", \"INACTIVE\" ]. All possible values: [ \"INACTIVE\", \"ACTIVE\", \"PENDING CONFIGURATION\", \"INCOMPLETE\", \"CONFIGURED\", \"INSUFFICIENT LICENSE\", \"ERROR\", \"WARNING\", \"CRITICAL\" ]",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "state_message": {
            "type": "string",
            "description": "Connection state message",
            "description_kind": "markdown",
            "computed": true
          },
          "updated_at": {
            "type": "string",
            "description": "The RFC3339 timestamp",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "block_types": {
          "configuration_details": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "regions": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "Geographic locations used to fetch metrics",
                  "description_kind": "markdown",
                  "optional": true
                },
                "tag_filter": {
                  "type": "string",
                  "description": "Expression for filtering resources to be monitored, based on tags. Example: (tags(env) = 'prod' || tags(env) = 'production')) && tags(project) = 'cloudcollectors'",
                  "description_kind": "markdown",
                  "optional": true
                }
              },
              "block_types": {
                "import_tags": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "enabled": {
                        "type": "bool",
                        "description": "It is true by default. Tags will be imported for all the resources that are being monitored by default",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "excluded_keys": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "Array of tag keys that need to be excluded from being imported. It can be set only when enabled is true",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "description": "Configuration for importing tags of resources that are being monitored",
                    "description_kind": "markdown"
                  },
                  "max_items": 1
                },
                "polling": {
                  "nesting_mode": "list",
                  "block": {
                    "attributes": {
                      "interval": {
                        "type": "number",
                        "description": "The default polling interval is five (5) minutes",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "unit": {
                        "type": "string",
                        "description": "The unit of polling interval, currently only support 'minute'. Defaults to the same",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "description": "How often the selected connection is polled for information",
                    "description_kind": "markdown"
                  },
                  "max_items": 1
                },
                "services": {
                  "nesting_mode": "set",
                  "block": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "Service name for which we will fetch metrics",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "tag_filter": {
                        "type": "string",
                        "description": "Expression for filtering resources to be monitored, based on tags. Example: (tags(env) = 'prod' || tags(env) = 'production')) && tags(project) = 'cloudcollectors'",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "block_types": {
                      "import_tags": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "enabled": {
                              "type": "bool",
                              "description": "It is true by default. Tags will be imported for all the resources that are being monitored by default",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "excluded_keys": {
                              "type": [
                                "list",
                                "string"
                              ],
                              "description": "Array of tag keys that need to be excluded from being imported. It can be set only when enabled is true",
                              "description_kind": "markdown",
                              "optional": true
                            }
                          },
                          "description": "Configuration for importing tags of resources that are being monitored",
                          "description_kind": "markdown"
                        },
                        "max_items": 1
                      },
                      "polling": {
                        "nesting_mode": "list",
                        "block": {
                          "attributes": {
                            "interval": {
                              "type": "number",
                              "description": "The default polling interval is five (5) minutes",
                              "description_kind": "markdown",
                              "optional": true
                            },
                            "unit": {
                              "type": "string",
                              "description": "The unit of polling interval, currently only support 'minute'. Defaults to the same",
                              "description_kind": "markdown",
                              "optional": true
                            }
                          },
                          "description": "How often the selected connection is polled for information",
                          "description_kind": "markdown"
                        },
                        "max_items": 1
                      }
                    },
                    "description": "Services for which we will fetch metrics",
                    "description_kind": "markdown"
                  }
                }
              },
              "description": "The Configuration Details for the Connection",
              "description_kind": "markdown"
            },
            "max_items": 1
          },
          "connection_details": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "access_key_id": {
                  "type": "string",
                  "description": "AWS Access keys are long-term credentials for an AWS IAM user, or account root user. The access key ID is one of two access keys needed to authenticate to AWS. The other is a secret access key. You need access keys to make programmatic calls using the AWS CLI, AWS Tools, or PowerShell.",
                  "description_kind": "markdown",
                  "optional": true
                },
                "access_type": {
                  "type": "string",
                  "description": "Connection type discriminator, supported types are `role_delegation` and `access_key`.",
                  "description_kind": "markdown",
                  "required": true
                },
                "account_id": {
                  "type": "string",
                  "description": "AWS Account ID provided by the user",
                  "description_kind": "markdown",
                  "optional": true
                },
                "appdynamics_aws_account_id": {
                  "type": "string",
                  "description": "AppDynamics AWS Account ID. Delegates a user to an Identity Access Management (IAM) role in AWS. The AWS IAM role provides AppDynamics access to resources.\n\t\t\t\t\t\thttps://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_create_for-user_externalid.html",
                  "description_kind": "markdown",
                  "computed": true
                },
                "aws_account_id": {
                  "type": "string",
                  "description": "AWS Account ID fetched by the server",
                  "description_kind": "markdown",
                  "computed": true
                },
                "external_id": {
                  "type": "string",
                  "description": "Returns an external ID for AWS role delegation connections \n\t\t\t\t\t\thttps://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_create_for-user_externalid.html",
                  "description_kind": "markdown",
                  "computed": true
                },
                "role_name": {
                  "type": "string",
                  "description": "Role name for AWS iam role",
                  "description_kind": "markdown",
                  "computed": true
                },
                "secret_access_key": {
                  "type": "string",
                  "description": "The secret access key is one of two access keys needed to authenticate to AWS. The other is an access key ID. The secret access key is only available once, when you create it. Download the generated secret access key and save in a secure location. If the secret access key is lost or deleted, you must create a new one. You need access keys to make programmatic calls using the AWS CLI, AWS Tools, or PowerShell.",
                  "description_kind": "markdown",
                  "optional": true,
                  "sensitive": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    },
    "appdynamicscloud_connection_aws_role_attachment": {
      "version": 1,
