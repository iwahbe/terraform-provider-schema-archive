            "description_kind": "markdown",
            "optional": true
          },
          "email_whitelist": {
            "type": [
              "list",
              "string"
            ],
            "description": "The list of email addresses to add to the whitelist.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "email_whitelist_enabled": {
            "type": "bool",
            "description": "Allow whitelisting access based on email address. Requires SMTP to be setup.",
