                "value": {
                  "type": "string",
                  "description": "Header value.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of headers to set when forwarding requests.",
            "description_kind": "markdown",
            "optional": true
          },
          "host_header": {
            "type": "string",
            "description": "Set a custom host header to set for requests.",
            "description_kind": "markdown",
            "optional": true
          },
          "http": {
            "type": "bool",
            "description": "Whether the resource is an HTTP resource.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "The ID of the resource.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "The name of the resource.",
            "description_kind": "markdown",
            "required": true
          },
          "nice_id": {
            "type": "string",
            "description": "The unique, human-readable ID of the resource.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "org_id": {
            "type": "string",
            "description": "The ID of the organization.",
            "description_kind": "markdown",
            "required": true
          },
          "post_auth_path": {
            "type": "string",
            "description": "The HTTP path of the resource to shared. Requires `http` to be true.",
            "description_kind": "markdown",
            "optional": true
          },
          "protocol": {
            "type": "string",
            "description": "The protocol of the resource (tcp or udp).",
            "description_kind": "markdown",
            "required": true
          },
          "proxy_port": {
            "type": "number",
            "description": "The port to proxy if `http` is false",
            "description_kind": "markdown",
            "optional": true
          },
          "proxy_protocol": {
            "type": "bool",
            "description": "Enable the proxy protocol.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "proxy_protocol_version": {
            "type": "number",
            "description": "Version 1 is text-based and widely supported. Version 2 is binary and more efficient but less compatible. Make sure servers transport is added to dynamic config.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "ssl": {
            "type": "bool",
            "description": "Enable SSL for the resource.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "sso": {
            "type": "bool",
            "description": "Allow Pangolin SSO auth.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "sticky_session": {
            "type": "bool",
            "description": "Whether or not to enable sticky sessions. Requires `http` to be true.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "subdomain": {
            "type": "string",
