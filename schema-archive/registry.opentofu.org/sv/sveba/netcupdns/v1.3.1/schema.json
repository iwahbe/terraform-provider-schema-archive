{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "customer_number": {
          "type": "string",
          "description": "Netcup customer number. Alternative defined by env `NETCUP_CUSTOMER_NUMBER`",
          "description_kind": "markdown",
          "optional": true
        },
        "key": {
          "type": "string",
          "description": "Netcup CCP API key. Alternative defined by env `NETCUP_API_KEY`",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        },
        "password": {
          "type": "string",
          "description": "Netcup CCP API password. Alternative defined by env `NETCUP_API_PASSWORD`",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "The Netcup-DNS provider provides possibility to modify Netcup-DNS records",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "netcupdns_record": {
      "version": 0,
      "block": {
        "attributes": {
          "destination": {
            "type": "string",
            "description": "Target of the record.",
            "description_kind": "plain",
            "required": true
          },
          "domainname": {
            "type": "string",
            "description": "Domainname of the record.",
            "description_kind": "plain",
            "required": true
          },
          "hostname": {
            "type": "string",
            "description": "Name of the record. Use '@' for root of domain.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique ID of the record. Provided from Netcup-API",
            "description_kind": "plain",
            "computed": true
          },
          "priority": {
            "type": "string",
            "description": "Required for MX records.",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Type of Record like A or MX.",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Represents a DNS-Record. See [Netcup-API](https://ccp.netcup.net/run/webservice/servers/endpoint.php#Dnsrecord)",
        "description_kind": "markdown"
      }
    }
  }
}
