{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "API Token to access DoiT API. May also be provided by DOIT_API_TOKEN environment variable. Refer to https://developer.doit.com/docs/start",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "customer_context": {
          "type": "string",
          "description": "Customer context. May also be provided by DOIT_CUSTOMER_CONTEXT environment variable. This field is requiered just for DoiT employees ",
          "description_kind": "plain",
          "optional": true
        },
        "host": {
          "type": "string",
          "description": "URI for DoiT API. May also be provided via DOIT_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "doit-console_attribution": {
      "version": 0,
      "block": {
        "attributes": {
          "components": {
            "nested_type": {
              "attributes": {
                "key": {
                  "type": "string",
                  "description": "Key of the type to validate",
                  "description_kind": "plain",
                  "required": true
                },
                "type": {
                  "type": "string",
                  "description": "Type of the component (Standard, Labels, Google Kubernetes Engin, Tags etc. )",
                  "description_kind": "plain",
                  "required": true
                },
                "values": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "Value of the key to validate",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of Attributions filters",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Description of the attribution",
            "description_kind": "plain",
            "optional": true
          },
          "formula": {
            "type": "string",
            "description": "Attribution formula (A is first component, B is second component, C is third component, etc.)",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Numeric identifier of the attribution",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update ofthe attribution group.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the attribution",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "doit-console_attribution_group": {
      "version": 0,
      "block": {
        "attributes": {
          "attributions": {
            "type": [
              "list",
              "string"
            ],
            "description": "list of the attributions IDs",
            "description_kind": "plain",
            "required": true
          },
          "description": {
            "type": "string",
            "description": "Description of the attribution group",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Numeric identifier of the attribution group",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update ofthe attribution group.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the attribution group",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "doit-console_report": {
      "version": 0,
      "block": {
        "attributes": {
          "config": {
            "nested_type": {
              "attributes": {
                "advanced_analysis": {
                  "nested_type": {
                    "attributes": {
                      "forecast": {
                        "type": "bool",
                        "description": "Advanced analysis toggles. Each of these can be set independently",
                        "description_kind": "plain",
                        "required": true
                      },
                      "not_trending": {
                        "type": "bool",
                        "description_kind": "plain",
                        "required": true
                      },
                      "trending_down": {
                        "type": "bool",
                        "description_kind": "plain",
                        "required": true
                      },
                      "trending_up": {
                        "type": "bool",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "required": true
                },
                "aggregation": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "currency": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "dimensions": {
                  "nested_type": {
                    "attributes": {
                      "id": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "type": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "display_values": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "filters": {
                  "nested_type": {
                    "attributes": {
                      "id": {
                        "type": "string",
                        "description": "What field we are filtering on",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "inverse": {
                        "type": "bool",
                        "description": "If set, exclude the values",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "type": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "values": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "What values to filter on or exclude",
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "The filters to use in this report",
                  "description_kind": "plain",
                  "optional": true
                },
                "group": {
                  "nested_type": {
                    "attributes": {
                      "id": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "limit": {
                        "nested_type": {
                          "attributes": {
                            "metric": {
                              "nested_type": {
                                "attributes": {
                                  "type": {
                                    "type": "string",
                                    "description_kind": "plain",
                                    "optional": true
                                  },
                                  "value": {
                                    "type": "string",
                                    "description_kind": "plain",
                                    "optional": true
                                  }
                                },
                                "nesting_mode": "single"
                              },
                              "description_kind": "plain",
                              "optional": true
                            },
                            "sort": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "value": {
                              "type": "number",
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true
                      },
                      "type": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "The groups to use in the report.",
                  "description_kind": "plain",
                  "optional": true
                },
                "include_promotional_credits": {
                  "type": "bool",
                  "description": "Whether to include credits or not. If set, the report must use time interval \u201cmonth\u201d/\u201dquarter\u201d/\u201dyear\u201d",
                  "description_kind": "plain",
                  "required": true
                },
                "layout": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "metric": {
                  "nested_type": {
                    "attributes": {
                      "type": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "value": {
                        "type": "string",
                        "description": "For basic metrics the value can be one of: [\"cost\", \"usage\", \"savings\" \nIf using custom metrics, the value must refer to an existing custom or calculated metric id ",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "metric_filter": {
                  "nested_type": {
                    "attributes": {
                      "metric": {
                        "nested_type": {
                          "attributes": {
                            "type": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "value": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true
                      },
                      "operator": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "values": {
                        "type": [
                          "list",
                          "number"
                        ],
                        "description_kind": "plain",
                        "required": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                },
                "splits": {
                  "nested_type": {
                    "attributes": {
                      "id": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "include_origin": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "mode": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "origin": {
                        "nested_type": {
                          "attributes": {
                            "id": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "type": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "nesting_mode": "single"
                        },
                        "description_kind": "plain",
                        "optional": true
                      },
                      "targets": {
                        "nested_type": {
                          "attributes": {
                            "id": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true
                            },
                            "type": {
                              "type": "string",
                              "description_kind": "plain",
                              "optional": true
                            }
                          },
                          "nesting_mode": "list"
                        },
                        "description_kind": "plain",
                        "optional": true
                      },
                      "type": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "The splits to use in the report.",
                  "description_kind": "plain",
                  "optional": true
                },
                "time_interval": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "time_range": {
                  "nested_type": {
                    "attributes": {
                      "amount": {
                        "type": "number",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "include_current": {
                        "type": "bool",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "mode": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      },
                      "unit": {
                        "type": "string",
                        "description_kind": "plain",
                        "optional": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Report configuration",
            "description_kind": "plain",
            "optional": true
          },
          "description": {
            "type": "string",
            "description": "Report description",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Report id",
            "description_kind": "plain",
            "computed": true
          },
          "last_updated": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Report name",
            "description_kind": "plain",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
