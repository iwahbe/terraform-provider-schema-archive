{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_token": {
          "type": "string",
          "description": "The API token to authenticate with the Hava API. This takes precedence over the 'HAVA_TOKEN' environment variable.",
          "description_kind": "markdown",
          "optional": true
        },
        "endpoint": {
          "type": "string",
          "description": "Which API endpoint to connect to. This is primarily used to support self-hosted users that does not use the default SaaS API endpoints",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "hava_source_aws_car_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "external_id": {
            "type": "string",
            "description": "The external ID used by AWS for additional security when assuming the role",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the source",
            "description_kind": "markdown",
            "required": true
          },
          "role_arn": {
            "type": "string",
            "description": "The ARN of the role that hava will assume to access the AWS Account",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "state": {
            "type": "string",
            "description": "State of the Source",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "A Source in Hava using an AWS cross-account role to authenticate to the AWS account that will be imported.",
        "description_kind": "markdown"
      }
    },
    "hava_source_aws_key_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "access_key": {
            "type": "string",
            "description": "The aws access key id of the account that will be used to access the source for import",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the source",
            "description_kind": "markdown",
            "required": true
          },
          "secret_key": {
            "type": "string",
            "description": "The aws secret key of the account that will be used to access the source for import",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "state": {
            "type": "string",
            "description": "State of the Source",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "A Source in Hava using AWS access key id and secret key to authenticate to the AWS account that will be imported.",
        "description_kind": "markdown"
      }
    },
    "hava_source_azure_credentials_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "client_id": {
            "type": "string",
            "description": "The id of client that will be used to access the source for import",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the source",
            "description_kind": "markdown",
            "required": true
          },
          "secret_key": {
            "type": "string",
            "description": "The azure secret key of the client that will be used to access the source for import",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "state": {
            "type": "string",
            "description": "State of the Source",
            "description_kind": "markdown",
            "computed": true
          },
          "subscription_id": {
            "type": "string",
            "description": "The id of the azure subscription that will be accessed to import the data",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "tenant_id": {
            "type": "string",
            "description": "The id of the azure tenant that will be accessed to import the data",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "A Source in Hava using an Azure service principal to authenticate to the Azure subscription that will be imported.",
        "description_kind": "markdown"
      }
    },
    "hava_source_gcp_sa_credentials_resource": {
      "version": 0,
      "block": {
        "attributes": {
          "encoded_file": {
            "type": "string",
            "description": "Base64 encoded json Service Account credentials file content",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Display name of the source",
            "description_kind": "markdown",
            "required": true
          },
          "state": {
            "type": "string",
            "description": "State of the Source",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "A Source in Hava using an Google service account to authenticate to the GCP project that will be imported.",
        "description_kind": "markdown"
      }
    }
  }
}
