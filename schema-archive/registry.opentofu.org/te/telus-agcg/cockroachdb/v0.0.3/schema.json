{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "Cockroach host name",
          "description_kind": "plain",
          "required": true
        },
        "port": {
          "type": "number",
          "description": "Cockroach port number",
          "description_kind": "plain",
          "required": true
        },
        "sslconfig": {
          "type": [
            "object",
            {
              "cert": "string",
              "key": "string",
              "mode": "string",
              "rootcert": "string"
            }
          ],
          "description": "Cockroach SSL config",
          "description_kind": "plain",
          "required": true
        },
        "user": {
          "type": "string",
          "description": "Cockroach user name",
          "description_kind": "plain",
          "required": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "cockroachdb_database": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the database",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the database",
            "description_kind": "plain",
            "required": true
          },
          "owner": {
            "type": "string",
            "description": "Owner of the database",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages a database.",
        "description_kind": "plain"
      }
    },
    "cockroachdb_grant": {
      "version": 0,
      "block": {
        "attributes": {
          "database": {
            "type": "string",
            "description": "Target database name",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "ID of the grant",
            "description_kind": "plain",
            "computed": true
          },
          "object_type": {
            "type": "string",
            "description": "Object type. Must be one of the following:  database, schema, or table",
            "description_kind": "plain",
            "required": true
          },
          "objects": {
            "type": [
              "list",
              "string"
            ],
            "description": "Objects to grant privileges on",
            "description_kind": "plain",
            "optional": true
          },
          "privileges": {
            "type": [
              "list",
              "string"
            ],
            "description": "Privileges to grant",
            "description_kind": "plain",
            "required": true
          },
          "role": {
            "type": "string",
            "description": "Target role name",
            "description_kind": "plain",
            "required": true
          },
          "schema": {
            "type": "string",
            "description": "Target schema name",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages a grant.",
        "description_kind": "plain"
      }
    },
    "cockroachdb_grant_role": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "ID of the grant_role",
            "description_kind": "plain",
            "computed": true
          },
          "role": {
            "type": "string",
            "description": "Role to grant",
            "description_kind": "plain",
            "optional": true
          },
          "user": {
            "type": "string",
            "description": "User or role to grant to",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Manages a grant role.",
        "description_kind": "plain"
      }
    },
    "cockroachdb_role": {
      "version": 0,
      "block": {
        "attributes": {
          "create_database": {
            "type": "bool",
            "description": "Defines a role's ability to execute CREATE DATABASE. Default value is false.",
            "description_kind": "plain",
            "optional": true
          },
          "create_role": {
            "type": "bool",
            "description": "Defines a role's ability to execute CREATE ROLE. A role with this privilege can also alter and drop other roles. Default value is false.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the role (it's really just the name because they have to be unique)",
            "description_kind": "plain",
            "computed": true
          },
          "login": {
            "type": "bool",
            "description": "Defines whether role is allowed to log in. Roles without this attribute are useful for managing database privileges, but are not users in the usual sense of the word. Default value is false.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "The name of the role. Must be unique on the CockroachDb server instance where it is configured.",
            "description_kind": "plain",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Sets the role's password. Setting a password creates a user that's able to log in",
            "description_kind": "plain",
            "optional": true
          }
        },
        "description": "Manages a role.",
        "description_kind": "plain"
      }
    }
  }
}
