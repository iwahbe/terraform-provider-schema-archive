{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "token": {
          "type": "string",
          "description": "The token used to authenticate with Neon.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "neon_branch": {
      "version": 0,
      "block": {
        "attributes": {
          "endpoint": {
            "nested_type": {
              "attributes": {
                "compute_provisioner": {
                  "type": "string",
                  "description": "Provisioner of the endpoint.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "host": {
                  "type": "string",
                  "description": "Host of the endpoint.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Identifier of the endpoint.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "max_cu": {
                  "type": "number",
                  "description": "Maximum number of compute units for the endpoint. **Default** `0.25`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "min_cu": {
                  "type": "number",
                  "description": "Minimum number of compute units for the endpoint. **Default** `0.25`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "suspend_timeout": {
                  "type": "number",
                  "description": "Suspend timeout of the endpoint. **Default** `0`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Read-write compute endpoint settings of the branch.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "ID of the branch.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the branch.",
            "description_kind": "markdown",
            "required": true
          },
          "parent_id": {
            "type": "string",
            "description": "ID of the parent branch. Defaults to the default branch.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Project the branch belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "protected": {
            "type": "bool",
            "description": "Whether the branch is protected. **Default** `false`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Neon branch. Please use `neon_project` to create default branch.",
        "description_kind": "markdown"
      }
    },
    "neon_database": {
      "version": 0,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch the database belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "number",
            "description": "ID of the database.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the database.",
            "description_kind": "markdown",
            "required": true
          },
          "owner_name": {
            "type": "string",
            "description": "Name of the database owner.",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "Project the database belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Neon database.",
        "description_kind": "markdown"
      }
    },
    "neon_endpoint": {
      "version": 0,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch the endpoint belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "compute_provisioner": {
            "type": "string",
            "description": "Provisioner of the endpoint.",
            "description_kind": "markdown",
            "computed": true
          },
          "host": {
            "type": "string",
            "description": "Host of the endpoint.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the endpoint.",
            "description_kind": "markdown",
            "computed": true
          },
          "max_cu": {
            "type": "number",
            "description": "Maximum number of compute units for the endpoint. **Default** `0.25`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "min_cu": {
            "type": "number",
            "description": "Minimum number of compute units for the endpoint. **Default** `0.25`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Project the endpoint belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "suspend_timeout": {
            "type": "number",
            "description": "Suspend timeout of the endpoint. **Default** `0`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "Type of the endpoint.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Neon endpoint. This creates `read_only` endpoints. Please use `neon_branch` to create the `read_write` endpoint.",
        "description_kind": "markdown"
      }
    },
    "neon_project": {
      "version": 0,
      "block": {
        "attributes": {
          "allowed_ips": {
            "nested_type": {
              "attributes": {
                "ips": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description": "List of IP addresses allowed to connect to the project endpoints.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "protected_branches_only": {
                  "type": "bool",
                  "description": "Whether restriction applies only to protected branches. **Default** `false`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Allowed IP restriction settings for the project endpoints.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "branch": {
            "nested_type": {
              "attributes": {
                "endpoint": {
                  "nested_type": {
                    "attributes": {
                      "compute_provisioner": {
                        "type": "string",
                        "description": "Provisioner of the endpoint.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "host": {
                        "type": "string",
                        "description": "Host of the endpoint.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "id": {
                        "type": "string",
                        "description": "Identifier of the endpoint.",
                        "description_kind": "markdown",
                        "computed": true
                      },
                      "max_cu": {
                        "type": "number",
                        "description": "Maximum number of compute units for the endpoint. **Default** `0.25`.",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "min_cu": {
                        "type": "number",
                        "description": "Minimum number of compute units for the endpoint. **Default** `0.25`.",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "suspend_timeout": {
                        "type": "number",
                        "description": "Suspend timeout of the endpoint. **Default** `0`.",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Read-write compute endpoint settings of the branch.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "id": {
                  "type": "string",
                  "description": "Identifier of the branch.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the branch.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "protected": {
                  "type": "bool",
                  "description": "Whether the branch is protected. **Default** `false`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Default branch settings of the project.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "history_retention": {
            "type": "number",
            "description": "PITR history retention period of the project in seconds. **Default** `86400` (1 day).",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the project.",
            "description_kind": "markdown",
            "computed": true
          },
          "logical_replication": {
            "type": "bool",
            "description": "Whether logical replication is enabled for the project endpoints. Cannot be switched off once turned on. **Default** `false`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the project.",
            "description_kind": "markdown",
            "required": true
          },
          "org_id": {
            "type": "string",
            "description": "Organization of the project.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "pg_version": {
            "type": "number",
            "description": "PostgreSQL version of the project. **Default** `15`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "platform_id": {
            "type": "string",
            "description": "Platform of the project.",
            "description_kind": "markdown",
            "computed": true
          },
          "region_id": {
            "type": "string",
            "description": "Region of the project.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Neon project.",
        "description_kind": "markdown"
      }
    },
    "neon_role": {
      "version": 0,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch the role belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the role.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the role.",
            "description_kind": "markdown",
            "required": true
          },
          "password": {
            "type": "string",
            "description": "Password of the role.",
            "description_kind": "markdown",
            "computed": true,
            "sensitive": true
          },
          "project_id": {
            "type": "string",
            "description": "Project the role belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "protected": {
            "type": "bool",
            "description": "Whether the role is protected.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Neon role.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "neon_connection_uri": {
      "version": 0,
      "block": {
        "attributes": {
          "branch_id": {
            "type": "string",
            "description": "Branch to retrieve the connection URI for. Defaults to the project's default branch.",
            "description_kind": "markdown",
            "optional": true
          },
          "database_name": {
            "type": "string",
            "description": "Name of the database.",
            "description_kind": "markdown",
            "required": true
          },
          "endpoint_id": {
            "type": "string",
            "description": "Endpoint to retrieve the connection URI for. Defaults to the banch's read-write endpoint.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for the connection URI data source.",
            "description_kind": "markdown",
            "computed": true
          },
          "pooled_uri": {
            "type": "string",
            "description": "Pooled connection URI.",
            "description_kind": "markdown",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Project to retrieve the connection URI for.",
            "description_kind": "markdown",
            "required": true
          },
          "role_name": {
            "type": "string",
            "description": "Name of the role.",
            "description_kind": "markdown",
            "required": true
          },
          "uri": {
            "type": "string",
            "description": "Normal connection URI.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Retrieves normal and pooled connection URIs for a Neon database and role.",
        "description_kind": "markdown"
      }
    }
  }
}
