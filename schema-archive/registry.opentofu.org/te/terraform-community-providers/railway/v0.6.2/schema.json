{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "token": {
          "type": "string",
          "description": "The token used to authenticate with Railway.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "railway_custom_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "dns_record_value": {
            "type": "string",
            "description": "DNS record value of the custom domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "domain": {
            "type": "string",
            "description": "Custom domain.",
            "description_kind": "markdown",
            "required": true
          },
          "environment_id": {
            "type": "string",
            "description": "Identifier of the environment the custom domain belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "host_label": {
            "type": "string",
            "description": "Host label of the custom domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the custom domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Identifier of the project the custom domain belongs to.",
            "description_kind": "markdown",
            "computed": true
          },
          "service_id": {
            "type": "string",
            "description": "Identifier of the service the custom domain belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "target_port": {
            "type": "number",
            "description": "Target port of the service for the custom domain.",
            "description_kind": "markdown",
            "optional": true
          },
          "verification_host_label": {
            "type": "string",
            "description": "DNS host label for custom domain verification",
            "description_kind": "markdown",
            "computed": true
          },
          "verification_record_value": {
            "type": "string",
            "description": "DNS record value for custom domain verification",
            "description_kind": "markdown",
            "computed": true
          },
          "zone": {
            "type": "string",
            "description": "Zone of the custom domain.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Railway custom domain.",
        "description_kind": "markdown"
      }
    },
    "railway_environment": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Identifier of the environment.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the environment.",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "Identifier of the project the environment belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Railway environment.",
        "description_kind": "markdown"
      }
    },
    "railway_project": {
      "version": 0,
      "block": {
        "attributes": {
          "default_environment": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Identifier of the default environment.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the default environment.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Default environment of the project. When multiple exist, the oldest is considered.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Description of the project.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "has_pr_deploys": {
            "type": "bool",
            "description": "Whether the project has PR deploys enabled. **Default** `false`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the project.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the project.",
            "description_kind": "markdown",
            "required": true
          },
          "private": {
            "type": "bool",
            "description": "Privacy of the project. **Default** `true`.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "workspace_id": {
            "type": "string",
            "description": "Identifier of the workspace the project belongs to. Required if the railway token has access to multiple workspaces.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Railway project.",
        "description_kind": "markdown"
      }
    },
    "railway_service": {
      "version": 0,
      "block": {
        "attributes": {
          "config_path": {
            "type": "string",
            "description": "Path to the Railway config file. Conflicts with `source_image`.",
            "description_kind": "markdown",
            "optional": true
          },
          "cron_schedule": {
            "type": "string",
            "description": "Cron schedule of the service. Only allowed when total number of replicas across all regions is `1`.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the service.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the service.",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "Identifier of the project the service belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "regions": {
            "nested_type": {
              "attributes": {
                "num_replicas": {
                  "type": "number",
                  "description": "Number of replicas to deploy. **Default** `1`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "region": {
                  "type": "string",
                  "description": "Region to deploy in.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Regions with replicas to deploy service in.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "root_directory": {
            "type": "string",
            "description": "Directory to user for the service. Conflicts with `source_image`.",
            "description_kind": "markdown",
            "optional": true
          },
          "source_image": {
            "type": "string",
            "description": "Source image of the service. Conflicts with `source_repo`, `source_repo_branch`, `root_directory` and `config_path`.",
            "description_kind": "markdown",
            "optional": true
          },
          "source_image_registry_password": {
            "type": "string",
            "description": "Private Docker registry credentials.",
            "description_kind": "markdown",
            "optional": true,
            "sensitive": true
          },
          "source_image_registry_username": {
            "type": "string",
            "description": "Private Docker registry credentials.",
            "description_kind": "markdown",
            "optional": true
          },
          "source_repo": {
            "type": "string",
            "description": "Source repository of the service. Conflicts with `source_image`.",
            "description_kind": "markdown",
            "optional": true
          },
          "source_repo_branch": {
            "type": "string",
            "description": "Source repository branch to be used with `source_repo`. Must be specified if `source_repo` is specified.",
            "description_kind": "markdown",
            "optional": true
          },
          "volume": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "string",
                  "description": "Identifier of the volume.",
                  "description_kind": "markdown",
                  "computed": true
                },
                "mount_path": {
                  "type": "string",
                  "description": "Mount path of the volume.",
                  "description_kind": "markdown",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "Name of the volume.",
                  "description_kind": "markdown",
                  "required": true
                },
                "size": {
                  "type": "number",
                  "description": "Size of the volume in MB.",
                  "description_kind": "markdown",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Volume connected to the service.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Railway service.\n\n> \u26a0\ufe0f **NOTE:** All the other settings not specified here are recommended to be specified in the Railway config file.",
        "description_kind": "markdown"
      }
    },
    "railway_service_domain": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "Full domain of the service domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "environment_id": {
            "type": "string",
            "description": "Identifier of the environment the service domain belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the service domain.",
            "description_kind": "markdown",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Identifier of the project the service domain belongs to.",
            "description_kind": "markdown",
            "computed": true
          },
          "service_id": {
            "type": "string",
            "description": "Identifier of the service the service domain belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "subdomain": {
            "type": "string",
            "description": "Subdomain of the service domain.",
            "description_kind": "markdown",
            "required": true
          },
          "suffix": {
            "type": "string",
            "description": "Suffix of the service domain.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Railway service domain.",
        "description_kind": "markdown"
      }
    },
    "railway_shared_variable": {
      "version": 0,
      "block": {
        "attributes": {
          "environment_id": {
            "type": "string",
            "description": "Identifier of the environment the variable belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the variable.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the variable.",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "Identifier of the project the variable belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Value of the variable.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Railway shared variable.",
        "description_kind": "markdown"
      }
    },
    "railway_tcp_proxy": {
      "version": 0,
      "block": {
        "attributes": {
          "application_port": {
            "type": "number",
            "description": "Port of the application the TCP proxy points to.",
            "description_kind": "markdown",
            "required": true
          },
          "domain": {
            "type": "string",
            "description": "Domain of the TCP proxy.",
            "description_kind": "markdown",
            "computed": true
          },
          "environment_id": {
            "type": "string",
            "description": "Identifier of the environment the TCP proxy belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the TCP proxy.",
            "description_kind": "markdown",
            "computed": true
          },
          "proxy_port": {
            "type": "number",
            "description": "Port of the TCP proxy.",
            "description_kind": "markdown",
            "computed": true
          },
          "service_id": {
            "type": "string",
            "description": "Identifier of the service the TCP proxy belongs to.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Railway TCP proxy.",
        "description_kind": "markdown"
      }
    },
    "railway_variable": {
      "version": 0,
      "block": {
        "attributes": {
          "environment_id": {
            "type": "string",
            "description": "Identifier of the environment the variable belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the variable.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the variable.",
            "description_kind": "markdown",
            "required": true
          },
          "project_id": {
            "type": "string",
            "description": "Identifier of the project the variable belongs to.",
            "description_kind": "markdown",
            "computed": true
          },
          "service_id": {
            "type": "string",
            "description": "Identifier of the service the variable belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Value of the variable.",
            "description_kind": "markdown",
            "required": true,
            "sensitive": true
          }
        },
        "description": "Railway variable. Any changes in collection triggers service redeployment.",
        "description_kind": "markdown"
      }
    },
    "railway_variable_collection": {
      "version": 0,
      "block": {
        "attributes": {
          "environment_id": {
            "type": "string",
            "description": "Identifier of the environment the variable collection belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the variable collection.",
            "description_kind": "markdown",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Identifier of the project the variable collection belongs to.",
            "description_kind": "markdown",
            "computed": true
          },
          "service_id": {
            "type": "string",
            "description": "Identifier of the service the variable collection belongs to.",
            "description_kind": "markdown",
            "required": true
          },
          "variables": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Name of the variable.",
                  "description_kind": "markdown",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "Value of the variable.",
                  "description_kind": "markdown",
                  "required": true,
                  "sensitive": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Collection of variables.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Railway variable collection. Group of variables managed as a whole. Any changes in collection triggers service redeployment.",
        "description_kind": "markdown"
      }
    }
  }
}
