{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "token": {
          "type": "string",
          "description": "The token used to authenticate with Depot.",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "depot_project": {
      "version": 0,
      "block": {
        "attributes": {
          "cache": {
            "nested_type": {
              "attributes": {
                "expiry": {
                  "type": "number",
                  "description": "Number of days to keep the cache for. **Default** `14`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                },
                "size": {
                  "type": "number",
                  "description": "Number of bytes to keep in the cache in GB. **Default** `50`.",
                  "description_kind": "markdown",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Cache policy of the project.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the project.",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the project.",
            "description_kind": "markdown",
            "required": true
          },
          "organization_id": {
            "type": "string",
            "description": "Identifier of the organization.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Region of the project.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Depot project.",
        "description_kind": "markdown"
      }
    },
    "depot_trust_policy": {
      "version": 0,
      "block": {
        "attributes": {
          "buildkite": {
            "nested_type": {
              "attributes": {
                "organization": {
                  "type": "string",
                  "description": "Buildkite organization slug.",
                  "description_kind": "markdown",
                  "required": true
                },
                "pipeline": {
                  "type": "string",
                  "description": "Buildkite pipeline slug.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Buildkite provider settings for the trust policy.",
            "description_kind": "markdown",
            "optional": true
          },
          "circleci": {
            "nested_type": {
              "attributes": {
                "organization": {
                  "type": "string",
                  "description": "CircleCI organization uuid.",
                  "description_kind": "markdown",
                  "required": true
                },
                "project": {
                  "type": "string",
                  "description": "CircleCI project uuid.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "CircleCI provider settings for the trust policy.",
            "description_kind": "markdown",
            "optional": true
          },
          "github": {
            "nested_type": {
              "attributes": {
                "owner": {
                  "type": "string",
                  "description": "GitHub owner name.",
                  "description_kind": "markdown",
                  "required": true
                },
                "repository": {
                  "type": "string",
                  "description": "GitHub repository name.",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "GitHub provider settings for the trust policy.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Identifier of the trust policy.",
            "description_kind": "markdown",
            "computed": true
          },
          "project_id": {
            "type": "string",
            "description": "Identifier of the project for the trust policy.",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Depot trust policy.",
        "description_kind": "markdown"
      }
    }
  }
}
