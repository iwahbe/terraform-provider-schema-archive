{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "API Key Used to connect to the JumpCloud API",
          "description_kind": "markdown",
          "required": true,
          "sensitive": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "jumpcloud_ad": {
      "version": 0,
      "block": {
        "attributes": {
          "domain": {
            "type": "string",
            "description": "The Active Directory Domain (eg DC=mydomain,DC=com}",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Resource ID (Computed / Read-Only)",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Active Directory",
        "description_kind": "markdown"
      }
    },
    "jumpcloud_devicegroup": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Resource ID (Computed / Read-Only)",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name for the Device Group",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description": "Device Group",
        "description_kind": "markdown"
      }
    },
    "jumpcloud_usergroup": {
      "version": 0,
      "block": {
        "attributes": {
          "auto": {
            "type": "bool",
            "description": "Whether users matching member-query-filters should be automatically added to the user-group",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "description": {
            "type": "string",
            "description": "Description for the User Group",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "email": {
            "type": "string",
            "description": "E-Mail Address for the User Group (Mailing List Group)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Resource ID (Computed / Read-Only)",
            "description_kind": "markdown",
            "computed": true
          },
          "ldap": {
            "nested_type": {
              "attributes": {
                "groups": {
                  "nested_type": {
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "The LDAP Group Name",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description_kind": "plain",
                  "optional": true,
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "List of LDAP Groups the user-group is mapped to",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "member_queries": {
            "nested_type": {
              "attributes": {
                "query": {
                  "nested_type": {
                    "attributes": {
                      "field": {
                        "type": "string",
                        "description": "The name of the field to query",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "operator": {
                        "type": "string",
                        "description": "The operator to use for the query",
                        "description_kind": "markdown",
                        "required": true
                      },
                      "value": {
                        "type": "string",
                        "description": "The value for the filter expression",
                        "description_kind": "markdown",
                        "required": true
                      }
                    },
                    "nesting_mode": "map"
                  },
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "Query using a sequence of field filters.",
            "description_kind": "markdown",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name for the User Group",
            "description_kind": "markdown",
            "required": true
          },
          "notify": {
            "type": "bool",
            "description": "Whether to send notifications for new member suggestions that match member-query-filters",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "posix": {
            "nested_type": {
              "attributes": {
                "id": {
                  "type": "number",
                  "description": "The posix group id",
                  "description_kind": "markdown",
                  "required": true
                },
                "name": {
                  "type": "string",
                  "description": "The posix group name",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of POSIX Groups the user-group is mapped to",
            "description_kind": "markdown",
            "optional": true
          },
          "properties": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "The property name",
                  "description_kind": "markdown",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "The property value",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of attribute properties to set on the user-group",
            "description_kind": "markdown",
            "optional": true
          },
          "radius": {
            "nested_type": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "The reply name",
                  "description_kind": "markdown",
                  "required": true
                },
                "value": {
                  "type": "string",
                  "description": "The reply value",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of RADIUS Replies to associate with the user-group",
            "description_kind": "markdown",
            "optional": true
          },
          "samba": {
            "type": "bool",
            "description": "Whether samba propogation is enabled for this user-group",
            "description_kind": "markdown",
            "optional": true
          },
          "sudo": {
            "nested_type": {
              "attributes": {
                "enabled": {
                  "type": "bool",
                  "description": "Whether this user-group will allowed to use sudo",
                  "description_kind": "markdown",
                  "required": true
                },
                "passwordless": {
                  "type": "bool",
                  "description": "Whether members of this user-group will be able to use sudo without entering a password",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "Sudo configuration for the user-group",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "JumpCloud User Group",
        "description_kind": "markdown"
      }
    }
  }
}
