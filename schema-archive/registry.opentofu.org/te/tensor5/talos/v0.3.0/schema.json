{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "talos_bootstrap": {
      "version": 0,
      "block": {
        "attributes": {
          "client_certificate": {
            "type": "string",
            "description": "PEM-encoded client certificate for TLS authentication.",
            "description_kind": "markdown",
            "computed": true
          },
          "client_key": {
            "type": "string",
            "description": "PEM-encoded client certificate key for TLS authentication.",
            "description_kind": "markdown",
            "computed": true
          },
          "cluster_ca_certificate": {
            "type": "string",
            "description": "PEM-encoded root certificates bundle for TLS authentication.",
            "description_kind": "markdown",
            "computed": true
          },
          "endpoint": {
            "type": "string",
            "description": "Address of Talos node handling the request.",
            "description_kind": "markdown",
            "required": true
          },
          "machine_ca": {
            "type": "string",
            "description": "PEM-encoded root certificates bundle for TLS authentication.",
            "description_kind": "markdown",
            "required": true
          },
          "machine_crt": {
            "type": "string",
            "description": "PEM-encoded client certificate for TLS authentication.",
            "description_kind": "markdown",
            "required": true
          },
          "machine_key": {
            "type": "string",
            "description": "PEM-encoded client certificate key for TLS authentication.",
            "description_kind": "markdown",
            "required": true
          },
          "raw": {
            "type": "string",
            "description": "Content of kubeconfig file.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Bootstrap a Talos cluster and download kubeconfig.",
        "description_kind": "markdown"
      }
    },
    "talos_gen_config": {
      "version": 0,
      "block": {
        "attributes": {
          "additional_sans": {
            "type": [
              "list",
              "string"
            ],
            "description": "Additional Subject-Alt-Names for the APIServer certificate.",
            "description_kind": "markdown",
            "optional": true
          },
          "cluster_endpoint": {
            "type": "string",
            "description": "Cluster endpoint.",
            "description_kind": "markdown",
            "required": true
          },
          "cluster_name": {
            "type": "string",
            "description": "Cluster name.",
            "description_kind": "markdown",
            "required": true
          },
          "config_patch": {
            "type": [
              "list",
              "string"
            ],
            "description": "Patch generated machineconfigs (applied to all node types).",
            "description_kind": "markdown",
            "optional": true
          },
          "config_patch_control_plane": {
            "type": [
              "list",
              "string"
            ],
            "description": "Patch generated machineconfigs (applied to 'init' and 'controlplane' types).",
            "description_kind": "markdown",
            "optional": true
          },
          "config_patch_worker": {
            "type": [
              "list",
              "string"
            ],
            "description": "Patch generated machineconfigs (applied to 'worker' type).",
            "description_kind": "markdown",
            "optional": true
          },
          "control_plane_config": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "dns_domain": {
            "type": "string",
            "description": "The dns domain to use for cluster.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "install_disk": {
            "type": "string",
            "description": "The disk to install to.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "install_image": {
            "type": "string",
            "description": "The image used to perform an installation.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "kubernetes_version": {
            "type": "string",
            "description": "Desired kubernetes version to run (default \"1.25.1\").",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "persist": {
            "type": "bool",
            "description": "The desired persist value for configs.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "registry_mirrors": {
            "type": [
              "map",
              "string"
            ],
            "description": "List of registry mirrors to use in format: <registry host>=<mirror URL>.",
            "description_kind": "markdown",
            "optional": true
          },
          "talos_config": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          },
          "talos_version": {
            "type": "string",
            "description": "The desired Talos version to generate config for (backwards compatibility, e.g. v0.8).",
            "description_kind": "markdown",
            "optional": true
          },
          "with_cluster_discovery": {
            "type": "bool",
            "description": "Enable cluster discovery feature.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "with_kubespan": {
            "type": "bool",
            "description": "Enable KubeSpan feature.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "worker_config": {
            "type": "string",
            "description_kind": "plain",
            "computed": true,
            "sensitive": true
          }
        },
        "description": "Generates a configuration for Talos cluster.",
        "description_kind": "markdown"
      }
    }
  },
  "data_source_schemas": {
    "talos_kubeconfig": {
      "version": 0,
      "block": {
        "attributes": {
          "client_certificate": {
            "type": "string",
            "description": "PEM-encoded client certificate for TLS authentication.",
            "description_kind": "markdown",
            "computed": true
          },
          "client_key": {
            "type": "string",
            "description": "PEM-encoded client certificate key for TLS authentication.",
            "description_kind": "markdown",
            "computed": true
          },
          "cluster_ca_certificate": {
            "type": "string",
            "description": "PEM-encoded root certificates bundle for TLS authentication.",
            "description_kind": "markdown",
            "computed": true
          },
          "endpoint": {
            "type": "string",
            "description": "Address of Talos node handling the request.",
            "description_kind": "markdown",
            "required": true
          },
          "machine_ca": {
            "type": "string",
            "description": "PEM-encoded root certificates bundle for TLS authentication.",
            "description_kind": "markdown",
            "required": true
          },
          "machine_crt": {
            "type": "string",
            "description": "PEM-encoded client certificate for TLS authentication.",
            "description_kind": "markdown",
            "required": true
          },
          "machine_key": {
            "type": "string",
            "description": "PEM-encoded client certificate key for TLS authentication.",
            "description_kind": "markdown",
            "required": true
          },
          "raw": {
            "type": "string",
            "description": "Content of kubeconfig file.",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Download the kubeconfig information from a Talos node.",
        "description_kind": "markdown"
      }
    }
  }
}
