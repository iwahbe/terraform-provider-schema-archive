{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "organization_id": {
          "type": "string",
          "description": "Productive.io organization ID. May also be set via `PRODUCTIVE_ORGANIZATION_ID`.",
          "description_kind": "markdown",
          "optional": true
        },
        "token": {
          "type": "string",
          "description": "Productive.io API token. May also be set via `PRODUCTIVE_TOKEN`.",
          "description_kind": "markdown",
          "optional": true,
          "sensitive": true
        }
      },
      "description": "Provider for managing resources in [Productive.io](https://productive.io). Credentials can be supplied via the provider block or through the `PRODUCTIVE_TOKEN` and `PRODUCTIVE_ORGANIZATION_ID` environment variables.",
      "description_kind": "markdown"
    }
  },
  "resource_schemas": {
    "productive_person": {
      "version": 0,
      "block": {
        "attributes": {
          "avatar_url": {
            "type": "string",
            "description": "URL of the person's avatar thumbnail.",
            "description_kind": "markdown",
            "computed": true
          },
          "company_id": {
            "type": "number",
            "description": "ID of the associated company.",
            "description_kind": "markdown",
            "optional": true
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp when the person was created (ISO 8601).",
            "description_kind": "markdown",
            "computed": true
          },
          "custom_role_id": {
            "type": "number",
            "description": "ID of the custom permission role.",
            "description_kind": "markdown",
            "optional": true
          },
          "email": {
            "type": "string",
            "description": "Email address of the person.",
            "description_kind": "markdown",
            "required": true
          },
          "first_name": {
            "type": "string",
            "description": "First name of the person.",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier of the person.",
            "description_kind": "markdown",
            "computed": true
          },
          "invited_at": {
            "type": "string",
            "description": "Timestamp when the invitation was sent (ISO 8601), or null.",
            "description_kind": "markdown",
            "computed": true
          },
          "is_user": {
            "type": "bool",
            "description": "Whether this person has a login account.",
            "description_kind": "markdown",
            "computed": true
          },
          "last_name": {
            "type": "string",
            "description": "Last name of the person.",
            "description_kind": "markdown",
            "required": true
          },
          "last_seen_at": {
            "type": "string",
            "description": "Timestamp of the person's last activity (ISO 8601), or null.",
            "description_kind": "markdown",
            "computed": true
          },
          "manager_id": {
            "type": "number",
            "description": "ID of the direct manager (person).",
            "description_kind": "markdown",
            "optional": true
          },
          "nickname": {
            "type": "string",
            "description": "Preferred display name.",
            "description_kind": "markdown",
            "optional": true
          },
          "role_id": {
            "type": "number",
            "description": "Built-in role ID (e.g. 1 = admin).",
            "description_kind": "markdown",
            "optional": true
          },
          "status": {
            "type": "number",
            "description": "Person status: 1 = active, 2 = deactivated.",
            "description_kind": "markdown",
            "computed": true
          },
          "subsidiary_id": {
            "type": "number",
            "description": "ID of the subsidiary/workplace.",
            "description_kind": "markdown",
            "optional": true
          },
          "tag_list": {
            "type": "string",
            "description": "Comma-separated list of tags.",
            "description_kind": "markdown",
            "optional": true
          },
          "time_tracking_policy_id": {
            "type": "number",
            "description": "ID of the time tracking policy.",
            "description_kind": "markdown",
            "optional": true
          },
          "timesheet_submission_disabled": {
            "type": "bool",
            "description": "Whether timesheet submission is disabled for this person.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "title": {
            "type": "string",
            "description": "Job title of the person.",
            "description_kind": "markdown",
            "optional": true
          },
          "two_factor_auth": {
            "type": "bool",
            "description": "Whether two-factor authentication is enabled.",
            "description_kind": "markdown",
            "computed": true
          },
          "virtual": {
            "type": "bool",
            "description": "Whether this is a virtual/placeholder record.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          }
        },
        "description": "Manages a person (user) in Productive.io. Because Productive.io has no hard-delete endpoint, destroying this resource archives the person.",
        "description_kind": "markdown"
      }
    }
  }
}
