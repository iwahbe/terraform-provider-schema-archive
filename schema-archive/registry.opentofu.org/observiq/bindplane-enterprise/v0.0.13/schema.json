{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "api_key": {
          "type": "string",
          "description": "The endpoint used to connect to the BindPlane OP instance.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "The password used for authenticating to the BindPlane OP instance.",
          "description_kind": "plain",
          "optional": true
        },
        "remote_url": {
          "type": "string",
          "description": "The endpoint used to connect to the BindPlane OP instance.",
          "description_kind": "plain",
          "optional": true
        },
        "tls_certificate": {
          "type": "string",
          "description": "File path to the x509 PEM client TLS certificate, required when the BindPlane OP instance is configured for mutual TLS.",
          "description_kind": "plain",
          "optional": true
        },
        "tls_certificate_authority": {
          "type": "string",
          "description": "File path to the x509 PEM certificate authority file used for verifying the BindPlane OP instance's TLS certificate. Not required if your workstation already trusts the certificate authority through your operating system's trust store.",
          "description_kind": "plain",
          "optional": true
        },
        "tls_private_key": {
          "type": "string",
          "description": "File path to the x509 PEM client private key, required when the BindPlane OP instance is configured for mutual TLS.",
          "description_kind": "plain",
          "optional": true
        },
        "username": {
          "type": "string",
          "description": "The username used for authenticating to the BindPlane OP instance.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "bindplane_configuration": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Key value pairs which will be added to the configuration as labels.",
            "description_kind": "plain",
            "optional": true
          },
          "match_labels": {
            "type": [
              "map",
              "string"
            ],
            "description": "Labels that BindPlane OP uses to determine which agents the configuration should apply to. This value is computed by Terraform and is not user configurable.",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the configuration.",
            "description_kind": "plain",
            "required": true
          },
          "platform": {
            "type": "string",
            "description": "The platform the configuration is for.",
            "description_kind": "plain",
            "required": true
          },
          "rollout": {
            "type": "bool",
            "description": "Whether or not to trigger a rollout automatically when a configuration is updated. When set to true, BindPlane OP will automatically roll out the configuration change to managed agents.",
            "description_kind": "plain",
            "required": true
          }
        },
        "block_types": {
          "destination": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Name of the destination to attach.",
                  "description_kind": "plain",
                  "required": true
                },
                "processors": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "List of processor names to attach to the destination.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Destination name and list of processor names to attach to the configuration. This option can be configured one or many times.",
              "description_kind": "plain"
            }
          },
          "source": {
            "nesting_mode": "list",
            "block": {
              "attributes": {
                "name": {
                  "type": "string",
                  "description": "Name of the source to attach.",
                  "description_kind": "plain",
                  "required": true
                },
                "processors": {
                  "type": [
                    "set",
                    "string"
                  ],
                  "description": "List of processor names to attach to the source.",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description": "Source name and list of processor names to attach to the configuration. This option can be configured one or many times.",
              "description_kind": "plain"
            }
          },
          "timeouts": {
            "nesting_mode": "single",
            "block": {
              "attributes": {
                "create": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "delete": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                },
                "read": {
                  "type": "string",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            }
          }
        },
        "description_kind": "plain"
      }
    },
