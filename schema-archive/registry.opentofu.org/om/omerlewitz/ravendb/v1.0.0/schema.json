{
  "provider": {
    "version": 0,
    "block": {
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "ravendb_server": {
      "version": 0,
      "block": {
        "attributes": {
          "assets": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "cluster_setup_zip": {
            "type": "string",
            "description": "This zip file path generated from either RavenDB setup wizard or from RavenDB RVN tool.",
            "description_kind": "plain",
            "optional": true
          },
          "database": {
            "type": "string",
            "description": "The database name to check whether he is alive or not.",
            "description_kind": "plain",
            "optional": true
          },
          "hosts": {
            "type": [
              "list",
              "string"
            ],
            "description": "The hostnames (or ip addresses) of the nodes that terraform will use to setup the RavenDB cluster.",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "license": {
            "type": "string",
            "description": "The license that will be used for the setup of the RavenDB cluster.",
            "description_kind": "plain",
            "required": true
          },
          "nodes": {
            "type": [
              "list",
              [
                "object",
                {
                  "assets": [
                    "map",
                    "string"
                  ],
                  "certificate_holder": "string",
                  "failed": "bool",
                  "host": "string",
                  "http_url": "string",
                  "license": "string",
                  "settings": [
                    "map",
                    "string"
                  ],
                  "tcp_url": "string",
                  "unsecured": "bool",
                  "version": "string"
                }
              ]
            ],
            "description": "The state of all the nodes in the RavenDB cluster.",
            "description_kind": "plain",
            "computed": true
          },
          "settings_override": {
            "type": [
              "map",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "unsecured": {
            "type": "bool",
            "description": "Whatever to allow to run RavenDB in unsecured mode. This is ***NOT*** recommended!",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
          "package": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "arch": {
                  "type": "string",
                  "description": "Operating system architecture name - amd64, arm64, arm32",
                  "description_kind": "plain",
                  "optional": true
                },
                "version": {
                  "type": "string",
                  "description": "The RavenDB version to use for the cluster.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          },
          "ssh": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "pem": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                },
                "user": {
                  "type": "string",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          },
          "url": {
            "nesting_mode": "set",
            "block": {
              "attributes": {
                "http_port": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                },
                "list": {
                  "type": [
                    "list",
                    "string"
                  ],
                  "description_kind": "plain",
                  "required": true
                },
                "tcp_port": {
                  "type": "number",
                  "description_kind": "plain",
                  "optional": true
                }
              },
              "description_kind": "plain"
            },
            "min_items": 1,
            "max_items": 1
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
