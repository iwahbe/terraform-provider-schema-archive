{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "fly_api_token": {
          "type": "string",
          "description": "fly.io api token. If not set checks env for FLY_API_TOKEN",
          "description_kind": "markdown",
          "optional": true
        },
        "fly_http_endpoint": {
          "type": "string",
          "description": "Where the provider should look to find the fly http endpoint",
          "description_kind": "markdown",
          "optional": true
        }
      },
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "fly_app": {
      "version": 0,
      "block": {
        "attributes": {
          "app_url": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "assign_shared_ip_address": {
            "type": "bool",
            "description": "Assign a shared ipv4 address to the app. Note that depending on conditions an app may get a shared ip automatically.",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of application",
            "description_kind": "markdown",
            "required": true
          },
          "org": {
            "type": "string",
            "description": "The name of the organization to generate the app in, ex: `personal` (your initial org)",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "org_id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "shared_ip_address": {
            "type": "string",
            "description": "A shared ipv4 address, automatically attached in certain conditions or if explicitly requested",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "fly_cert": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "The App this resource will be created in",
            "description_kind": "markdown",
            "required": true
          },
          "check": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "dns_validation_hostname": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "dns_validation_instructions": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "dns_validation_target": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "A fly-generated ID",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description": "Fly certificate resource",
        "description_kind": "markdown"
      }
    },
    "fly_ip": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "Empty if using `shared_v4`",
            "description_kind": "markdown",
            "computed": true
          },
          "app": {
            "type": "string",
            "description": "The App this resource will be created in",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "A fly-generated ID",
            "description_kind": "markdown",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Fly region, ex `ord`, `sin`, `mad`",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "One of the following values (by regex): `^(v4|v6|private_v6)$`",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    },
    "fly_machine": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "The App this resource will be created in",
            "description_kind": "markdown",
            "required": true
          },
          "auto_destroy": {
            "type": "bool",
            "description": "Optional boolean telling the Machine to destroy itself once it's complete",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "cmd": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "cpu_type": {
            "type": "string",
            "description": "Which machine flavor, ex: `shared`",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "cpus": {
            "type": "number",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "entrypoint": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "env": {
            "type": [
              "map",
              "string"
            ],
            "description": "Keys and values must be strings",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "exec": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "A fly-generated ID",
            "description_kind": "markdown",
            "computed": true
          },
          "image": {
            "type": "string",
            "description": "Protocol-less docker image, ex: `registry.fly.io/myapp:mytag`",
            "description_kind": "markdown",
            "required": true
          },
          "memory": {
            "type": "number",
            "description": "Amount of memory in MB. `256`, `512`, `1024`, ...",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "mounts": {
            "nested_type": {
              "attributes": {
                "path": {
                  "type": "string",
                  "description": "Path for volume to be mounted on vm, ex: `/data`",
                  "description_kind": "markdown",
                  "required": true
                },
                "volume": {
                  "type": "string",
                  "description": "ID of volume",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "A user-provided identifier",
            "description_kind": "markdown",
            "optional": true,
            "computed": true
          },
          "private_ip": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Fly region, ex `ord`, `sin`, `mad`",
            "description_kind": "markdown",
            "required": true
          },
          "services": {
            "nested_type": {
              "attributes": {
                "internal_port": {
                  "type": "number",
                  "description": "Port the machine listens on",
                  "description_kind": "markdown",
                  "required": true
                },
                "ports": {
                  "nested_type": {
                    "attributes": {
                      "end_port": {
                        "type": "number",
                        "description": "For a port range, the last port to listen on",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "force_https": {
                        "type": "bool",
                        "description": "Automatically redirect to HTTPS on \"http\" handler",
                        "description_kind": "markdown",
                        "optional": true,
                        "computed": true
                      },
                      "handlers": {
                        "type": [
                          "list",
                          "string"
                        ],
                        "description": "How the edge should process requests; ex empty, or `tls` to attach app's certificate",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "port": {
                        "type": "number",
                        "description": "Mapped external port number, either `port` or `start_port` and `end_port` must be set.",
                        "description_kind": "markdown",
                        "optional": true
                      },
                      "start_port": {
                        "type": "number",
                        "description": "For a port range, the first port to listen on.",
                        "description_kind": "markdown",
                        "optional": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "How the port is exposed",
                  "description_kind": "markdown",
                  "required": true
                },
                "protocol": {
                  "type": "string",
                  "description": "`udp` or `tcp`",
                  "description_kind": "markdown",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description_kind": "plain",
            "optional": true
          }
        },
        "description_kind": "plain"
      }
    },
    "fly_volume": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "The App this resource will be created in",
            "description_kind": "markdown",
            "required": true
          },
          "encrypted": {
            "type": "bool",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "A fly-generated ID",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "A user-provided identifier",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "Fly region, ex `ord`, `sin`, `mad`",
            "description_kind": "markdown",
            "required": true
          },
          "size": {
            "type": "number",
            "description": "Size of volume in GB",
            "description_kind": "markdown",
            "required": true
          }
        },
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "fly_app": {
      "version": 0,
      "block": {
        "attributes": {
          "appurl": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "currentrelease": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "deployed": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "healthchecks": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "ipaddresses": {
            "type": [
              "list",
              "string"
            ],
            "description_kind": "plain",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of app",
            "description_kind": "markdown",
            "required": true
          },
          "sharedipaddress": {
            "type": "string",
            "description": "A shared ipv4 address, automatically attached in certain conditions or if explicitly requested",
            "description_kind": "markdown",
            "computed": true
          },
          "status": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "fly_cert": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "The App this resource will be created in",
            "description_kind": "markdown",
            "required": true
          },
          "check": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "dns_validation_hostname": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "dns_validation_instructions": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "dns_validation_target": {
            "type": "string",
            "description_kind": "plain",
            "computed": true
          },
          "hostname": {
            "type": "string",
            "description_kind": "plain",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "A fly-generated ID",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "fly_ip": {
      "version": 0,
      "block": {
        "attributes": {
          "address": {
            "type": "string",
            "description": "Empty if using `shared_v4`",
            "description_kind": "markdown",
            "computed": true
          },
          "app": {
            "type": "string",
            "description": "The App this resource will be created in",
            "description_kind": "markdown",
            "required": true
          },
          "id": {
            "type": "string",
            "description": "A fly-generated ID",
            "description_kind": "markdown",
            "required": true
          },
          "region": {
            "type": "string",
            "description": "Fly region, ex `ord`, `sin`, `mad`",
            "description_kind": "markdown",
            "computed": true
          },
          "type": {
            "type": "string",
            "description": "`v4`, `v6`, or `private_v6`",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    },
    "fly_volume": {
      "version": 0,
      "block": {
        "attributes": {
          "app": {
            "type": "string",
            "description": "The App this resource will be created in",
            "description_kind": "markdown",
            "required": true
          },
          "encrypted": {
            "type": "bool",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "A fly-generated ID",
            "description_kind": "markdown",
            "required": true
          },
          "name": {
            "type": "string",
            "description": "A user-provided identifier",
            "description_kind": "markdown",
            "computed": true
          },
          "region": {
            "type": "string",
            "description": "Fly region, ex `ord`, `sin`, `mad`",
            "description_kind": "markdown",
            "computed": true
          },
          "size": {
            "type": "number",
            "description": "Size of volume in GB",
            "description_kind": "markdown",
            "computed": true
          }
        },
        "description_kind": "plain"
      }
    }
  }
}
