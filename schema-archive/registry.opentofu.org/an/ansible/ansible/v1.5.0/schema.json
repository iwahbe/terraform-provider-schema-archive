  "resource_schemas": {
    "ansible_group": {
      "version": 1,
      "block": {
        "attributes": {
          "children": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of group children.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the group (same as name).",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the group.",
            "description_kind": "markdown",
            "required": true
          },
          "variables": {
            "type": "dynamic",
            "description": "Map of variables. Supports any HCL type including strings, numbers, booleans, lists, and maps.",
            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Ansible group resource. Stores group information in Terraform state for use by the Ansible cloud.terraform inventory plugin.",
        "description_kind": "markdown"
      }
    },
    "ansible_host": {
      "version": 1,
      "block": {
        "attributes": {
          "groups": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of group names.",
            "description_kind": "markdown",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "The ID of the host (same as name).",
            "description_kind": "markdown",
            "computed": true
          },
          "name": {
            "type": "string",
            "description": "Name of the host.",
            "description_kind": "markdown",
            "required": true
          },
          "variables": {
            "type": "dynamic",
