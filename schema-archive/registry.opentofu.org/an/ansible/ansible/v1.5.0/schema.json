            "description_kind": "markdown",
            "optional": true
          }
        },
        "description": "Ansible host resource. Stores host information in Terraform state for use by the Ansible cloud.terraform inventory plugin.",
        "description_kind": "markdown"
      }
    },
    "ansible_playbook": {
      "version": 0,
      "block": {
        "attributes": {
          "ansible_playbook_binary": {
            "type": "string",
            "description": "Path to ansible-playbook executable (binary).",
            "description_kind": "plain",
            "optional": true
          },
          "ansible_playbook_stderr": {
            "type": "string",
            "description": "An ansible-playbook CLI stderr output.",
            "description_kind": "plain",
            "computed": true
          },
          "ansible_playbook_stdout": {
            "type": "string",
            "description": "An ansible-playbook CLI stdout output.",
            "description_kind": "plain",
            "computed": true
          },
          "args": {
            "type": [
              "list",
              "string"
            ],
            "description": "Used to build arguments to run Ansible playbook with.",
            "description_kind": "plain",
            "computed": true
          },
          "check_mode": {
            "type": "bool",
            "description": "If 'true', playbook execution won't make any changes but only change predictions will be made.",
            "description_kind": "plain",
            "optional": true
          },
          "diff_mode": {
            "type": "bool",
            "description": "If 'true', when changing (small) files and templates, differences in those files will be shown. Recommended usage with 'check_mode'.",
            "description_kind": "plain",
            "optional": true
          },
          "extra_vars": {
            "type": [
              "map",
              "string"
            ],
            "description": "A map of additional variables as: { key-1 = value-1, key-2 = value-2, ... }.",
            "description_kind": "plain",
            "optional": true
          },
          "force_handlers": {
            "type": "bool",
            "description": "If 'true', run handlers even if a task fails.",
            "description_kind": "plain",
            "optional": true
          },
          "groups": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of desired groups of hosts on which the playbook will be executed.",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description_kind": "plain",
            "optional": true,
            "computed": true
          },
          "ignore_playbook_failure": {
            "type": "bool",
            "description": "This parameter is good for testing. Set to 'true' if the desired playbook is meant to fail, but still want the resource to run successfully.",
            "description_kind": "plain",
            "optional": true
          },
          "limit": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of hosts to include in playbook execution.",
            "description_kind": "plain",
            "optional": true
          },
          "name": {
            "type": "string",
            "description": "Name of the desired host on which the playbook will be executed.",
            "description_kind": "plain",
            "required": true
          },
          "playbook": {
            "type": "string",
            "description": "Path to ansible playbook.",
            "description_kind": "plain",
            "required": true
          },
          "replayable": {
            "type": "bool",
            "description": "If 'true', the playbook will be executed on every 'terraform apply' and with that, the resource will be recreated. If 'false', the playbook will be executed only on the first 'terraform apply'. Note, that if set to 'true', when doing 'terraform destroy', it might not show in the destroy output, even though the resource still gets destroyed.",
            "description_kind": "plain",
            "optional": true
          },
          "tags": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of tags of plays and tasks to run.",
            "description_kind": "plain",
            "optional": true
          },
          "temp_inventory_file": {
            "type": "string",
            "description": "Path to created temporary inventory file.",
            "description_kind": "plain",
            "computed": true
          },
          "var_files": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of variable files.",
            "description_kind": "plain",
            "optional": true
          },
          "vault_files": {
            "type": [
              "list",
              "string"
            ],
            "description": "List of vault files.",
            "description_kind": "plain",
            "optional": true
          },
          "vault_id": {
            "type": "string",
            "description": "ID of the desired vault(s).",
            "description_kind": "plain",
            "optional": true
          },
          "vault_password_file": {
            "type": "string",
            "description": "Path to a vault password file.",
            "description_kind": "plain",
            "optional": true
          },
          "verbosity": {
            "type": "number",
            "description": "A verbosity level between 0 and 6. Set ansible 'verbose' parameter, which causes Ansible to print more debug messages. The higher the 'verbosity', the more debug details will be printed.",
            "description_kind": "plain",
            "optional": true
          }
        },
        "block_types": {
