{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "endpoint": {
          "type": "string",
          "description": "The REST API endpoint to use for reading data (default: https://the-office.fly.dev)",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with theOffice API",
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "theoffice_connections": {
      "version": 0,
      "block": {
        "attributes": {
          "connections": {
            "nested_type": {
              "attributes": {
                "episode": {
                  "type": "number",
                  "description": "The episode the connection, i.e. dialogue between characters, occurred in.",
                  "description_kind": "plain",
                  "computed": true
                },
                "episode_name": {
                  "type": "string",
                  "description": "The name of the episode the connection, i.e. dialogue between characters, occurred in.",
                  "description_kind": "plain",
                  "computed": true
                },
                "links": {
                  "nested_type": {
                    "attributes": {
                      "source": {
                        "type": "string",
                        "description": "The name of the source character.",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "target": {
                        "type": "string",
                        "description": "The name of the target character.",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "value": {
                        "type": "number",
                        "description": "The value of the link.",
                        "description_kind": "plain",
                        "computed": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "The list of links between characters",
                  "description_kind": "plain",
                  "computed": true
                },
                "nodes": {
                  "nested_type": {
                    "attributes": {
                      "id": {
                        "type": "string",
                        "description": "The name of the target character.",
                        "description_kind": "plain",
                        "computed": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "The list of nodes i.e. characters in the episode",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of character connections",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Placeholder identifier attribute.",
            "description_kind": "plain",
            "computed": true
          },
          "season": {
            "type": "number",
            "description": "Season number to filter results by",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Fetches a list of character connections",
        "description_kind": "markdown"
      }
    },
    "theoffice_quotes": {
      "version": 0,
      "block": {
        "attributes": {
          "episode": {
            "type": "number",
            "description": "Episode number to filter results by",
            "description_kind": "plain",
            "optional": true
          },
          "id": {
            "type": "string",
            "description": "Placeholder identifier attribute.",
            "description_kind": "plain",
            "computed": true
          },
          "quotes": {
            "nested_type": {
              "attributes": {
                "character": {
                  "type": "string",
                  "description": "The character who said the quote.",
                  "description_kind": "plain",
                  "computed": true
                },
                "episode": {
                  "type": "number",
                  "description": "The episode the quote occurred in.",
                  "description_kind": "plain",
                  "computed": true
                },
                "episode_name": {
                  "type": "string",
                  "description": "The name of the episode the quote occurred in.",
                  "description_kind": "plain",
                  "computed": true
                },
                "quote": {
                  "type": "string",
                  "description": "The quote as a string",
                  "description_kind": "plain",
                  "computed": true
                },
                "scene": {
                  "type": "number",
                  "description": "The scene the quote occurred in.",
                  "description_kind": "plain",
                  "computed": true
                },
                "season": {
                  "type": "number",
                  "description": "The season the quote occurred in.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of quotes",
            "description_kind": "plain",
            "computed": true
          },
          "season": {
            "type": "number",
            "description": "Season number to filter results by",
            "description_kind": "plain",
            "required": true
          }
        },
        "description": "Fetches a list of quotes",
        "description_kind": "markdown"
      }
    }
  }
}
