{
  "provider": {
    "version": 0,
    "block": {
      "attributes": {
        "host": {
          "type": "string",
          "description": "URI for HashiCups API. May also be provided via HASHICUPS_HOST environment variable.",
          "description_kind": "plain",
          "optional": true
        },
        "password": {
          "type": "string",
          "description": "Password for HashiCups API. May also be provided via HASHICUPS_PASSWORD environment variable.",
          "description_kind": "plain",
          "optional": true,
          "sensitive": true
        },
        "username": {
          "type": "string",
          "description": "Username for HashiCups API. May also be provided via HASHICUPS_USERNAME environment variable.",
          "description_kind": "plain",
          "optional": true
        }
      },
      "description": "Interact with HashiCups.",
      "description_kind": "plain"
    }
  },
  "resource_schemas": {
    "hashicups_order": {
      "version": 0,
      "block": {
        "attributes": {
          "id": {
            "type": "string",
            "description": "Numeric identifier of the order.",
            "description_kind": "plain",
            "computed": true
          },
          "items": {
            "nested_type": {
              "attributes": {
                "coffee": {
                  "nested_type": {
                    "attributes": {
                      "description": {
                        "type": "string",
                        "description": "Product description of the coffee.",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "id": {
                        "type": "number",
                        "description": "Numeric identifier of the coffee.",
                        "description_kind": "plain",
                        "required": true
                      },
                      "image": {
                        "type": "string",
                        "description": "URI for an image of the coffee.",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "name": {
                        "type": "string",
                        "description": "Product name of the coffee.",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "price": {
                        "type": "number",
                        "description": "Suggested cost of the coffee.",
                        "description_kind": "plain",
                        "computed": true
                      },
                      "teaser": {
                        "type": "string",
                        "description": "Fun tagline for the coffee.",
                        "description_kind": "plain",
                        "computed": true
                      }
                    },
                    "nesting_mode": "single"
                  },
                  "description": "Coffee item in the order.",
                  "description_kind": "plain",
                  "required": true
                },
                "quantity": {
                  "type": "number",
                  "description": "Count of this item in the order.",
                  "description_kind": "plain",
                  "required": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of items in the order.",
            "description_kind": "plain",
            "required": true
          },
          "last_updated": {
            "type": "string",
            "description": "Timestamp of the last Terraform update of the order.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Manages an order.",
        "description_kind": "plain"
      }
    }
  },
  "data_source_schemas": {
    "hashicups_coffees": {
      "version": 0,
      "block": {
        "attributes": {
          "coffees": {
            "nested_type": {
              "attributes": {
                "description": {
                  "type": "string",
                  "description": "Product description of the coffee.",
                  "description_kind": "plain",
                  "computed": true
                },
                "id": {
                  "type": "number",
                  "description": "Numeric identifier of the coffee.",
                  "description_kind": "plain",
                  "computed": true
                },
                "image": {
                  "type": "string",
                  "description": "URI for an image of the coffee.",
                  "description_kind": "plain",
                  "computed": true
                },
                "ingredients": {
                  "nested_type": {
                    "attributes": {
                      "id": {
                        "type": "number",
                        "description": "Numeric identifier of the coffee ingredient.",
                        "description_kind": "plain",
                        "computed": true
                      }
                    },
                    "nesting_mode": "list"
                  },
                  "description": "List of ingredients in the coffee.",
                  "description_kind": "plain",
                  "computed": true
                },
                "name": {
                  "type": "string",
                  "description": "Product name of the coffee.",
                  "description_kind": "plain",
                  "computed": true
                },
                "price": {
                  "type": "number",
                  "description": "Suggested cost of the coffee.",
                  "description_kind": "plain",
                  "computed": true
                },
                "teaser": {
                  "type": "string",
                  "description": "Fun tagline for the coffee.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "list"
            },
            "description": "List of coffees.",
            "description_kind": "plain",
            "computed": true
          },
          "id": {
            "type": "string",
            "description": "Placeholder identifier attribute.",
            "description_kind": "plain",
            "computed": true
          }
        },
        "description": "Fetches the list of coffees.",
        "description_kind": "plain"
      }
    }
  }
}
