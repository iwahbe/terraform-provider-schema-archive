            "computed": true
          }
        },
        "description": "Parses and sorts a list of semver strings.",
        "description_kind": "plain"
      }
    }
  },
  "functions": {
    "compare": {
      "description": "Returns comparison results as integer\n    <ul>\n    <li><code>-1</code> if smaller</li>\n    <li><code>0</code> if equals</li>\n    <li><code>1</code> if greater</li>\n    <li><code>99</code> if error</li>\n    </ul>\n    <br>~> **NOTE:** Versions are compared by X.Y.Z. Build metadata is ignored. Prerelease is\n    lower than the version without a prerelease. Compare always takes into account\n    prereleases. See [Masterminds/semver](https://github.com/Masterminds/semver).",
      "summary": "Returns comparison results as integer",
      "return_type": "number",
      "parameters": [
        {
          "name": "version_a",
          "description": "Semver string version used as base for comparison",
          "type": "string"
        },
        {
          "name": "version_b",
          "description": "Semver string version to compare to `version_a`",
          "type": "string"
        }
      ]
    },
    "constrained": {
      "description": "Checks whether semver is within constrain, returns a boolean",
      "summary": "Checks whether semver is within constrain, returns a boolean",
      "return_type": "bool",
      "parameters": [
        {
          "name": "version",
          "description": "Semver string version used as base for comparison",
          "type": "string"
        },
        {
          "name": "constraint",
          "description": "Constraint string",
          "type": "string"
        }
      ]
    },
    "equals": {
      "description": "Checks the equality of two semvers strings, returns a boolean.\n\t\t<br><br>~> **NOTE:** Versions are compared by X.Y.Z. Build metadata is ignored. Prerelease is\n    lower than the version without a prerelease. Compare always takes into account\n    prereleases. See [Masterminds/semver](https://github.com/Masterminds/semver).",
      "summary": "Checks the equality of two semvers strings, returns a boolean",
      "return_type": "bool",
      "parameters": [
        {
          "name": "version_a",
          "description": "Semver string version used as base for comparison",
          "type": "string"
        },
        {
          "name": "version_b",
          "description": "Semver string version to compare to `version_a`",
          "type": "string"
        }
      ]
    },
    "pick": {
      "description": "Returns semver from list of semvers according to constraint",
      "summary": "Returns semver from list of semvers according to constraint",
      "return_type": [
        "list",
        "string"
      ],
      "parameters": [
        {
          "name": "versions",
          "description": "List of semver strings",
          "type": [
            "list",
            "string"
          ]
        },
        {
          "name": "constraint",
          "description": "Semver constraint",
          "type": "string"
        }
      ]
    },
    "sort": {
      "description": "Returns sorted and deduped list of semver strings",
      "summary": "Returns sorted list of semver strings",
      "return_type": [
        "list",
        "string"
      ],
      "parameters": [
        {
          "name": "versions",
          "description": "List of semver strings",
          "type": [
            "list",
            "string"
          ]
        }
      ]
    }
  }
}
