{
  "provider": {
    "version": 0,
    "block": {
      "description": "Implements `semvers_list` data source, `compare`, `constrained`, `equals`, `sort` and `pick` provider function. All functionality is based on `github.com/Masterminds/semver/v3`. Usage of provider functions requires Terraform version 1.8 and above.",
      "description_kind": "plain"
    }
  },
  "data_source_schemas": {
    "semvers_list": {
      "version": 0,
      "block": {
        "attributes": {
          "first": {
            "nested_type": {
              "attributes": {
                "major": {
                  "type": "number",
                  "description": "Major version.",
                  "description_kind": "plain",
                  "computed": true
                },
                "metadata": {
                  "type": "string",
                  "description": "Metadata of the version.",
                  "description_kind": "plain",
                  "computed": true
                },
                "minor": {
                  "type": "number",
                  "description": "Minor version.",
                  "description_kind": "plain",
                  "computed": true
                },
                "original": {
                  "type": "string",
                  "description": "Original version string.",
                  "description_kind": "plain",
                  "computed": true
                },
                "patch": {
                  "type": "number",
                  "description": "Patch version.",
                  "description_kind": "plain",
                  "computed": true
                },
                "prerelease": {
                  "type": "string",
                  "description": "Pre-release version identifier.",
                  "description_kind": "plain",
                  "computed": true
                },
                "version": {
                  "type": "string",
                  "description": "Parsed version string.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The first / lowest version object in the list.",
            "description_kind": "plain",
            "computed": true
          },
          "last": {
            "nested_type": {
              "attributes": {
                "major": {
                  "type": "number",
                  "description": "Major version.",
                  "description_kind": "plain",
                  "computed": true
                },
                "metadata": {
                  "type": "string",
                  "description": "Metadata of the version.",
                  "description_kind": "plain",
                  "computed": true
                },
                "minor": {
                  "type": "number",
                  "description": "Minor version.",
                  "description_kind": "plain",
                  "computed": true
                },
                "original": {
                  "type": "string",
                  "description": "Original version string.",
                  "description_kind": "plain",
                  "computed": true
                },
                "patch": {
                  "type": "number",
                  "description": "Patch version.",
                  "description_kind": "plain",
                  "computed": true
                },
                "prerelease": {
                  "type": "string",
                  "description": "Pre-release version identifier.",
                  "description_kind": "plain",
                  "computed": true
                },
                "version": {
                  "type": "string",
                  "description": "Parsed version string.",
                  "description_kind": "plain",
                  "computed": true
                }
              },
              "nesting_mode": "single"
            },
            "description": "The last / highest version object in the list.",
            "description_kind": "plain",
            "computed": true
          },
          "list": {
            "type": [
              "list",
              "string"
            ],
            "description": "Original list of semver strings.",
            "description_kind": "plain",
            "required": true
          },
          "sorted_versions": {
            "nested_type": {
              "attributes": {
                "major": {
                  "type": "number",
                  "description": "Major version.",
                  "description_kind": "plain",
                  "computed": true
                },
                "metadata": {
                  "type": "string",
                  "description": "Metadata of the version.",
                  "description_kind": "plain",
